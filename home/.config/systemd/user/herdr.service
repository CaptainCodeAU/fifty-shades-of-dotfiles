# herdr headless server as a systemd USER service (Linux / WSL2).
#
# The Linux counterpart of `brew services start herdr` on macOS. Stowed to
# ~/.config/systemd/user/herdr.service; install.sh enables it (see
# _post_stow_herdr_systemd_service) and reports it in the prerequisites summary.
#
# Why a service at all: every hand-started `herdr server` inherits the launching
# shell's environment. That shell had already shown the dotfiles welcome banner
# and exported the once-only flags (_ONBOARDING_COMPLETE, _WELCOME_MESSAGE_SHOWN),
# so every pane the server spawned skipped the banner. A foreground server also
# dies with the SSH session that started it. systemd gives a clean environment,
# crash-restart, and (with `loginctl enable-linger`) survival across logout.
#
# PATH is set explicitly because the user manager's default PATH has no
# ~/.local/bin (where install.sh puts the pinned binary) and no /usr/lib/wsl/lib
# (where WSL keeps nvidia-smi, used by the tab-bar GPU status command that runs
# inside this server).
#
# Restart=on-failure plus a start limit: a second server refuses the socket and
# exits 1 ("herdr server is already running"). A bare `Restart=always` would
# relaunch that forever, which is exactly the respawn loop docs/HERDR.md warns
# about for the Homebrew keep_alive service. Five tries in two minutes, then stop.

[Unit]
Description=herdr headless terminal server
Documentation=https://herdr.dev/llms.txt
After=default.target
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
ExecStart=%h/.local/bin/herdr server
ExecReload=%h/.local/bin/herdr server reload-config
Environment=PATH=%h/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/usr/lib/wsl/lib
Environment=HOME=%h
Restart=on-failure
RestartSec=10
KillMode=mixed
TimeoutStopSec=20

[Install]
WantedBy=default.target
