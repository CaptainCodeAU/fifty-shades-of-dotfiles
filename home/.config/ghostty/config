# =============================================================================
#  Ghostty settings (fifty-shades-of-dotfiles: home/.config/ghostty/config,
#  stowed to ~/.config/ghostty/config)
# =============================================================================
# Added 2026-10-15 (Gavin, dotfiles-main Q13: 1): Ghostty runs BESIDE iTerm2,
# which stays as the fallback. Every value below is copied from the iTerm2
# default profile "Default (old) red" as read from its live settings that day,
# so herdr looks and behaves the same in either terminal.
#
# `ghostty +validate-config` checks this file; `ghostty +show-config --default
# --docs` lists every setting with its documentation. Ghostty reloads this file
# with cmd+shift+, (no restart needed for most settings).

# --- Font --------------------------------------------------------------------
# iTerm2: MesloLGS NF 12 (the Powerlevel10k font), with FiraCode Nerd Font
# Mono 12 for non-ASCII. Ghostty tries each font-family in order for a glyph
# the one before lacks, which is what iTerm2's non-ASCII font did.
# Kept after a trial (Q14, 15 Oct): JetBrainsMono Nerd Font Mono (option 1)
# was tried first; Gavin went back to the iTerm2 fonts (option 5). The
# difference he saw was in the drawing, not the font: see font-thicken and
# adjust-cell-height below.
# A blind test of five fonts (15 to 17 Oct) changed nothing: GeistMono, IosevkaTerm,
# JetBrainsMono, MonoLisa and MesloLGS, shown as A to E; Gavin kept MesloLGS NF.
# 18 Oct: Gavin switched every font-family line off (kept below, commented, so any
# can come back), so Ghostty draws with its built-in default font (JetBrains Mono,
# per Ghostty's docs; `ghostty +show-config --default` shows font-family empty).
# font-thicken is off too, and adjust-cell-width 7% and alpha-blending linear are
# new; the size stays 12. Gavin called it finished the same evening.
# Reference: https://ghostty.org/docs/config/reference

# font-family = MesloLGS NF
# font-family = MesloLGS Nerd Font Mono
# font-family = FiraCode Nerd Font Mono
font-family = JetBrainsMono Nerd Font Mono
# font-family = Iosevka Term
# font-size = 12

# Text looked thin and faint beside iTerm2 (Gavin's side-by-side, 15 Oct).
# iTerm2 draws with macOS font smoothing, which thickens every stroke a
# little; Ghostty leaves it off unless font-thicken is set.
# font-thicken = true

# Rows were shorter than iTerm2's with the same font (Gavin's side-by-side,
# 15 Oct): over the same rows, about 15 px each against 16 px, while the
# column width was identical (the banner's ==== rule measured 545 px in both).
# The squashed rows read as narrower letters. 6% taller cells closes the gap.
# adjust-cell-height = 6%

# Setup (once)
font-size = 12
# Draw fonts with a thicker stroke (macOS only)
# font-thicken = true
# Strength of thickening when `font-thicken` is enabled
# font-thicken-strength = 255
# https://ghostty.org/docs/config/reference#adjust-cell-height
adjust-cell-width = 7%
adjust-cell-height = 6%
# native / linear / linear-corrected (`linear` is same as gamma correction)
alpha-blending = linear
adjust-cursor-thickness = 0
adjust-cursor-height = 100%


# 1a. Baseline (Powerlevel10k build)
# font-family = MesloLGS NF


# window-padding-x = 8
# window-padding-y = 0
# window-padding-balance = true
# confirm-close-surface = false
# copy-on-select = clipboard
# background-opacity = 0.85
# background-blur-radius = 20


# --- Colours -----------------------------------------------------------------
# Started as iTerm2's "Default (old) red" (15 Oct). iTerm2 is no longer used
# (18 Oct), so the palette is now tuned for this background, not for matching
# iTerm2.
# Colours are read as sRGB (Ghostty's default). window-colorspace =
# display-p3 was tried on 15 Oct and dropped the same evening: it applies to
# every colour, including the 24-bit ones programs send, so Claude Code's
# blue came out duller (Gavin's side-by-side).
background = #170d0d
# #cccccc and #dddddd were tried on 15 Oct; once bold text was white
# (bold-color below), they left too little gap between plain and bold text
# (Gavin).
foreground = #bbbbbb
# Bold default-colour text is white, and bold palette colours use their
# bright versions. A colour here does both: "this color will always be used
# for the default bold text color. It will set the rest of the bold colors to
# bright" (Ghostty's own docs, 1.3.1).
bold-color = #ffffff
cursor-color = #bbbbbb
selection-background = #b5d5ff
selection-foreground = #000000

# Palette, 18 Oct: slots that read below the contrast targets against
# #170d0d were lightened, keeping their hue. Targets (WCAG contrast ratio):
# 4.5 for normal colours, 6 for bright ones, about 3.5 for 8 (grey, used for
# dim text such as shell autosuggestions). Changed slots, to go back:
#   slot  new      ratio   old      ratio
#    1    #e53935  4.5     #bb0000  2.8   red
#    4    #3d74ff  4.7     #0240d2  2.4   blue
#    5    #d23cd2  4.8     #bb00bb  3.5   magenta
#    8    #6c6c6c  3.6     #555555  2.6   grey (bright black)
#   12    #8484ff  6.1     #5555ff  3.8   bright blue
# Slot 0 stays #000000 (1.1): programs mostly use it as a background, where
# darker than the window is the intended look.
palette = 0=#000000
palette = 1=#e53935
palette = 2=#00bb00
palette = 3=#bbbb00
palette = 4=#3d74ff
palette = 5=#d23cd2
palette = 6=#00bbbb
palette = 7=#bbbbbb
palette = 8=#6c6c6c
palette = 9=#ff5555
palette = 10=#55ff55
palette = 11=#ffff55
palette = 12=#8484ff
palette = 13=#ff55ff
palette = 14=#55ffff
palette = 15=#ffffff

# minimum-contrast is left at its default (1, no effect). Higher values were
# tried and shifted colours (Gavin); the palette above lifts the low ones
# instead.

# iTerm2: transparency 0.05 with blur.
background-opacity = 0.95
background-blur = true

# --- Window ------------------------------------------------------------------
# maximize = true
window-width = 492
window-height = 102

# iTerm2: every new window and tab starts in ~/CODE/CaptainCodeAU ("Custom
# Directory: Yes"), not in the folder of the tab it came from.
working-directory = ~/CODE/CaptainCodeAU
window-inherit-working-directory = false
tab-inherit-working-directory = false

# --- Keyboard ----------------------------------------------------------------
# Option acts as Alt, on both sides. In iTerm2 only some profiles did this, and
# where Option typed a character instead, herdr's ctrl+alt keys never arrived
# (home/.config/herdr/config.toml, "FUNCTION KEYS"). One setting here covers
# every window.
macos-option-as-alt = true

# cmd+left / cmd+right switch Ghostty tabs, as they do in iTerm2. Ghostty's
# defaults send ctrl+A / ctrl+E (start and end of line) instead; a cat -v on
# 16 Oct showed ^A for cmd+left, and the Ghostty tabs never switched.
# Ghostty's own cmd+shift+[ / ] and ctrl+tab still switch tabs too.
keybind = super+arrow_left=previous_tab
keybind = super+arrow_right=next_tab

# cmd+option+p opens herdr's prompt palette in one press (Gavin, 19 Oct,
# dotfiles-main Q72: 1). It sends herdr's own palette key, ctrl+alt+p, as the
# kitty keyboard protocol writes it (ESC [ 112 ; 7 u: p, with ctrl+alt as
# modifier 7). The first try typed the prefix as a NUL byte then p
# (text:\x00p) and did nothing when Gavin pressed it, 19 Oct. cmd+shift+p
# is Ghostty's own command palette (`ghostty +list-keybinds --default`).
keybind = super+alt+p=csi:112;7u

# --- Clipboard and selection -------------------------------------------------
# A plain drag inside herdr is herdr's (or Claude Code's) own selection, and
# they copy it themselves through OSC 52, so programs must be allowed to write
# the clipboard (iTerm2: "Applications in terminal may access clipboard").
# Reading it stays "ask". A drag Ghostty itself owns (hold shift to get past
# herdr's mouse capture, as option-drag did in iTerm2) copies to the clipboard,
# as iTerm2's "Copy to pasteboard on selection" did.
clipboard-write = allow
clipboard-read = ask
copy-on-select = clipboard

# Opening a file, folder or web address: cmd+shift+click, not iTerm2's
# cmd+click. Inside herdr, shift gets the click past herdr's mouse capture;
# then Ghostty underlines and opens it (Gavin, 16 Oct: "just like iTerm").

# --- Shell integration -------------------------------------------------------
# ssh-env: an ssh from a plain Ghostty shell sends TERM=xterm-256color, since
# the other machines lack Ghostty's own xterm-ghostty description.
# ssh-terminfo (which installs that description on the far machine) is left
# off: it writes to machines this file does not own.
shell-integration-features = ssh-env

# --- Updates -----------------------------------------------------------------
# No update checks from inside the app, the same rule as herdr's phone-home
# guards. Updates come through Homebrew: the cask is marked auto_updates, so
# a plain `brew upgrade` skips it; `brew upgrade --cask --greedy ghostty`
# takes it.
auto-update = off
