# ==============================================================================
#  Global Git Configuration (generic / shareable)
# ==============================================================================
# This is a public-safe template managed by GNU Stow. Personal info (name,
# email, signing keys) lives in a separate private file that is NOT committed:
#
#   ~/.gitconfig.private
#
# Create it with:
#   [user]
#       name = Your Name
#       email = you@example.com
#
# SSH-Only Authentication
# -----------------------
# This system enforces SSH-only authentication for GitHub. HTTPS credential
# helpers have been intentionally removed. All HTTPS GitHub URLs for YOUR
# accounts are rewritten to SSH via scoped [url] insteadOf rules in
# ~/.gitconfig.private. Third-party URLs (Homebrew, open-source repos)
# stay on HTTPS and work without authentication.
#
#   [url "<your-ssh-host-alias>:<YourGitHubUsername>/"]
#       insteadOf = https://github.com/<YourGitHubUsername>/
#   [url "<your-ssh-host-alias>:"]
#       insteadOf = https://gist.github.com/<YourGitHubUsername>/
#
# Per-account git identities live alongside their SSH keys in ~/.ssh/
# and are loaded via includeIf rules in ~/.gitconfig.private.
# See ~/.gitconfig.private for the full account setup and instructions.
#
# WARNING: Running `gh auth login` or `gh auth setup-git` will silently
# re-add HTTPS credential helpers to this file. If that happens, remove
# the [credential "https://github.com"] and [credential "https://gist..."]
# sections that get added.
#
# The [include] below loads it automatically. The file is protected by
# .gitignore_global so it will never be accidentally committed.

# Credential helpers: disabled on purpose. An empty helper value resets the
# helper list, neutralising any inherited helper (e.g. osxkeychain from Xcode's
# system gitconfig) so a stray HTTPS git auth can never silently cache a token
# in the Keychain. Reinforces the SSH-only posture above (added 2026-06-20
# after a leftover gho_ OAuth token was found cached by git-credential-osxkeychain).
#
# ORDER IS LOAD-BEARING: this reset MUST stay ABOVE the [include] below.
# git reads config top to bottom, and a blank helper value clears every helper
# collected so far -- INCLUDING url-scoped ones like [credential
# "https://github.com"]. ~/.gitconfig.private pulls in ~/.gitconfig-githubagent,
# which registers the GitHub App credential helper for https://github.com. While
# this block sat BELOW the include, that helper was silently wiped and git fell
# back to prompting for a password on every push (hit 2026-09-13 on a real push
# to CaptainCodeAU/say2). Proved with a marker helper: it ran with the reset
# above it, and never ran with the reset below it. Same helper, one variable.
# `git config --get-all credential.https://github.com.helper` still PRINTS the
# helper in the broken order, so that command cannot detect this -- only an
# actual credential fill can.
[credential]
	helper =

[include]
	path = ~/.gitconfig.private

[color]
	ui = auto

[init]
	defaultbranch = master

[pull]
	ff = only

[push]
	autoSetupRemote = true

[core]
	excludesfile = ~/.gitignore_global
	editor = cursor --wait

[filter "lfs"]
	process = git-lfs filter-process
	required = true
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f

[diff]
	colorMoved = default

[merge]
	conflictstyle = diff3

[rerere]
	enabled = true
