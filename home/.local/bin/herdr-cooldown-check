#!/usr/bin/env -S uv run python3
# /// script
# requires-python = ">=3.10"
# dependencies = []
# ///
#
# ============================================================================
#  herdr-cooldown-check -- is a herdr upgrade eligible under the cooldown?
# ============================================================================
#
# WHY
# ---
# This estate never adopts a release on the day it ships: pnpm has
# minimumReleaseAge, bun has .bunfig.toml minimumReleaseAge, uv has
# UV_EXCLUDE_NEWER, GitHub Actions are SHA-pinned. herdr has no such knob --
# it ships a self-updater (`herdr update`) plus TWO default-on background
# calls to herdr.dev, so left alone it is the one tool in the estate that can
# change underneath us with zero delay.
#
# This tool restores the cooldown gate for herdr the only way that works for a
# Homebrew-managed binary: keep the formula PINNED, and report when the newest
# upstream release has aged past the cooldown. On macOS, install.sh's own
# _preflight_herdr_bump_check reads this tool's --json output and performs the
# unpin/upgrade/re-pin automatically once ELIGIBLE -- this tool itself stays
# read-only regardless (see SAFETY below); it never acts on its own findings.
#
# WHAT IT CHECKS (5 subjects)
#   1. homebrew-lag informational only: is Homebrew's current formula version
#                    behind GitHub's absolute newest tag? (see GATING CANDIDATE)
#   2. version     installed herdr vs the gating candidate (see below)
#   3. cooldown    age of the gating candidate vs HERDR_COOLDOWN_DAYS (default 7)
#   4. pin         is the Homebrew formula pinned (so `brew upgrade` can't take it)
#   5. phone-home  are update.version_check / update.manifest_check disabled
#
# GATING CANDIDATE -- the version cooldown is actually checked against
#   For a brew install, this is whatever `brew upgrade herdr` would ACTUALLY
#   install right now (`brew info herdr --json=v2`), not GitHub's absolute
#   newest tag. Homebrew-core only moves the formula when a maintainer bumps
#   it, which lags behind upstream releases by an unpredictable amount --
#   gating against GitHub's latest instead of what Homebrew can deliver was a
#   real bug: it held back an upgrade that would only ever fetch an OLDER,
#   already-eligible version anyway. For a direct (Linux/WSL) install there is
#   no such intermediary, so GitHub's absolute latest IS the candidate there.
#
# WHY PIN RATHER THAN TRUST THE CHANNEL
#   herdr's own `update.channel` only gates stable-vs-preview, not age, and
#   upstream states Homebrew installs ignore `herdr update` entirely. So the
#   binary can only move when Homebrew moves it -- and `brew pin` is the single
#   switch that stops a routine `brew upgrade` from doing that silently.
#
# WHY update.manifest_check MATTERS
#   It is NOT a version check. It fetches agent-detection manifests from
#   herdr.dev at runtime and reloads them into the RUNNING server -- remote
#   behaviour change, no pin, no cooldown. Disable it and run
#   `herdr server update-agent-manifests` deliberately instead.
#
# DATA SOURCE
#   GitHub's releases endpoints, which already exclude prereleases (so the
#   daily `preview-*` tags can never be proposed):
#     GET https://api.github.com/repos/herdrdev/herdr/releases/latest
#     GET https://api.github.com/repos/herdrdev/herdr/releases/tags/<tag>
#   plus `brew info herdr --json=v2` for brew installs (local, no network).
#   Unauthenticated (60 req/h/IP is ample at a 6h cache). $GH_TOKEN is used
#   when present purely to raise that ceiling.
#
# SAFETY
#   Read-only. Never installs, unpins, upgrades or edits config. It prints the
#   command it thinks you want and stops. Any failure degrades to SKIPPED,
#   never to a false ELIGIBLE.
#
# USAGE
#   herdr-cooldown-check [options]
#     --cooldown-days N  age gate in days (default: $HERDR_COOLDOWN_DAYS or 7)
#     --timeout SEC      per-network-call timeout (default: 8)
#     --quiet            print only actionable + SKIPPED lines
#     --json             emit a JSON report instead of the table
#
# EXIT CODES
#   0  nothing actionable (current, or held by cooldown, or skipped)
#   1  an upgrade is ELIGIBLE, or a guard (pin / phone-home) is not in place
# ============================================================================

from __future__ import annotations

import argparse
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
import urllib.error
import urllib.request
from datetime import datetime, timezone

REPO = "herdrdev/herdr"  # ogulcancelik/herdr still redirects here, but this is canonical
LATEST_URL = f"https://api.github.com/repos/{REPO}/releases/latest"
CONFIG_PATH = os.path.expanduser("~/.config/herdr/config.toml")

CLEAN, ACTION, SKIP = "OK", "ACTION", "SKIPPED"


def run(cmd: list[str], timeout: int = 10) -> tuple[int, str]:
    """Run a command, returning (rc, stdout). Never raises."""
    try:
        p = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
        return p.returncode, (p.stdout or "").strip()
    except (OSError, subprocess.SubprocessError):
        return 127, ""


def semver(text: str) -> tuple[int, ...] | None:
    m = re.search(r"(\d+)\.(\d+)\.(\d+)", text or "")
    return tuple(int(g) for g in m.groups()) if m else None


def installed_version() -> tuple[tuple[int, ...] | None, str]:
    """(parsed version, raw string). Absent herdr yields (None, '')."""
    if not shutil.which("herdr"):
        return None, ""
    _, out = run(["herdr", "--version"])
    return semver(out), out


def install_method() -> str:
    """'brew', 'direct' or 'absent' -- decides which advice is even valid."""
    if not shutil.which("herdr"):
        return "absent"
    if shutil.which("brew"):
        rc, out = run(["brew", "list", "--versions", "herdr"], timeout=20)
        if rc == 0 and out:
            return "brew"
    return "direct"


def homebrew_stable_version(timeout: int) -> str | None:
    """The version `brew upgrade herdr` would ACTUALLY install right now, or
    None on any failure. This is NOT necessarily GitHub's newest release --
    Homebrew-core only moves the herdr formula when a maintainer notices and
    bumps it, which lags behind upstream releases by an unpredictable amount.
    Gating cooldown against GitHub's /releases/latest instead of this was a
    real bug: it can hold back a `brew upgrade` that would only ever fetch an
    OLDER, long-since-eligible version anyway, because the version being
    gated (GitHub's absolute latest) isn't even the one Homebrew can deliver."""
    rc, out = run(["brew", "info", "herdr", "--json=v2"], timeout=timeout)
    if rc != 0 or not out:
        return None
    try:
        data = json.loads(out)
        return data["formulae"][0]["versions"]["stable"]
    except (ValueError, KeyError, IndexError, TypeError):
        return None


def pin_path(prefix: str | None = None) -> str:
    """Where Homebrew records a pin. A symlink here means pinned."""
    pre = prefix or os.environ.get("HOMEBREW_PREFIX") or "/opt/homebrew"
    return os.path.join(pre, "var", "homebrew", "pinned", "herdr")


def brew_pinned(prefix: str | None = None) -> bool | None:
    """True/False, or None when the answer is genuinely unknown.

    Reads the pin marker directly -- same path the welcome banner and
    install.sh use, so all three surfaces agree and none pays for a `brew`
    subprocess. Falls back to `brew list --pinned` only when the prefix
    cannot be located at all.
    """
    pre = prefix or os.environ.get("HOMEBREW_PREFIX") or "/opt/homebrew"
    if os.path.isdir(os.path.join(pre, "var", "homebrew")):
        return os.path.lexists(pin_path(pre))
    if not shutil.which("brew"):
        return None
    rc, out = run(["brew", "list", "--pinned"], timeout=20)
    if rc != 0:
        return None
    return "herdr" in out.split()


def parse_phone_home(body: str) -> dict[str, bool | None]:
    """Pure: extract the update.* booleans from config text.

    None means the key is absent, which is NOT the same as false -- the
    upstream default is true, so silence must read as 'still enabled'.
    """
    state: dict[str, bool | None] = {"version_check": None, "manifest_check": None}
    for key in state:
        m = re.search(rf"^\s*{key}\s*=\s*(true|false)\s*$", body, re.M)
        if m:
            state[key] = m.group(1) == "true"
    return state


def phone_home_state(path: str | None = None) -> dict[str, bool | None]:
    try:
        with open(path or CONFIG_PATH, encoding="utf-8") as fh:
            return parse_phone_home(fh.read())
    except OSError:
        return parse_phone_home("")


def version_verdict(have, want, age_days: float, gate: float) -> str:
    """Pure: CURRENT | HELD | ELIGIBLE | UNKNOWN. The whole cooldown rule."""
    if have is None or want is None:
        return "UNKNOWN"
    if have >= want:
        return "CURRENT"
    return "HELD" if age_days < gate else "ELIGIBLE"


def self_test() -> list[str]:
    """Prove the detectors still DETECT. Returns a list of failure descriptions.

    WHY THIS RUNS EVERY TIME
    ------------------------
    A guard that can only ever print OK is decoration. The honest way to trust
    a green result is to know the same code goes red when it should -- and the
    only way to know that continuously is to check it continuously, rather than
    asking a human to unpin the formula now and then and eyeball the output.

    These assertions drive the SAME pure functions the real run uses
    (`parse_phone_home`, `version_verdict`, `brew_pinned`), so a refactor that
    breaks detection fails here instead of silently reporting all-clear
    forever. Cost is microseconds: no network, no subprocess, no state touched.
    """
    fails: list[str] = []

    def check(label: str, got, expected):
        if got != expected:
            fails.append(f"{label}: expected {expected!r}, got {got!r}")

    # Phone-home detector: explicit false is the only safe state. A missing key
    # must read as None (upstream default true), never as "fine".
    check("phone-home reads false",
          parse_phone_home("[update]\nversion_check = false\nmanifest_check = false\n"),
          {"version_check": False, "manifest_check": False})
    check("phone-home reads true",
          parse_phone_home("[update]\nversion_check = true\nmanifest_check = true\n"),
          {"version_check": True, "manifest_check": True})
    check("phone-home treats absent as unset",
          parse_phone_home("[update]\nchannel = \"stable\"\n"),
          {"version_check": None, "manifest_check": None})

    # Cooldown rule: the gate must hold a fresh release and release an aged one.
    check("cooldown holds a fresh release",
          version_verdict((0, 7, 0), (0, 7, 5), 1.0, 3.0), "HELD")
    check("cooldown releases an aged one",
          version_verdict((0, 7, 0), (0, 7, 5), 7.0, 3.0), "ELIGIBLE")
    check("cooldown sees current as current",
          version_verdict((0, 7, 5), (0, 7, 5), 7.0, 3.0), "CURRENT")
    check("cooldown refuses to guess",
          version_verdict(None, (0, 7, 5), 7.0, 3.0), "UNKNOWN")

    # Pin detector: drive it against a synthetic Homebrew prefix, so we prove
    # it goes BOTH ways without touching the real pin. This is the assertion
    # that replaces unpinning the formula by hand and eyeballing the output.
    with tempfile.TemporaryDirectory(prefix="herdr-selftest-") as tmp:
        pinned_dir = os.path.join(tmp, "var", "homebrew", "pinned")
        os.makedirs(pinned_dir, exist_ok=True)
        check("pin detector reports UNPINNED when the marker is absent",
              brew_pinned(prefix=tmp), False)
        with open(os.path.join(pinned_dir, "herdr"), "w", encoding="utf-8") as fh:
            fh.write("")
        check("pin detector reports PINNED when the marker is present",
              brew_pinned(prefix=tmp), True)

    return fails


def latest_release(timeout: int) -> tuple[str, datetime] | None:
    """Newest NON-prerelease tag and its publish time, or None on any failure."""
    req = urllib.request.Request(
        LATEST_URL,
        headers={
            "Accept": "application/vnd.github+json",
            "User-Agent": "herdr-cooldown-check",
        },
    )
    token = os.environ.get("GH_TOKEN") or os.environ.get("GITHUB_TOKEN")
    if token:
        req.add_header("Authorization", f"Bearer {token}")
    try:
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            data = json.loads(resp.read().decode("utf-8"))
    except (urllib.error.URLError, OSError, ValueError, json.JSONDecodeError):
        return None
    tag = data.get("tag_name")
    published = data.get("published_at")
    if not tag or not published:
        return None
    try:
        when = datetime.fromisoformat(published.replace("Z", "+00:00"))
    except ValueError:
        return None
    return tag, when


def release_by_tag(tag: str, timeout: int) -> datetime | None:
    """Publish time for one specific tag (e.g. "v0.8.0"), or None on failure.
    Same shape as latest_release() but for a version we already know the name
    of, instead of "whatever GitHub currently calls newest"."""
    req = urllib.request.Request(
        f"https://api.github.com/repos/{REPO}/releases/tags/{tag}",
        headers={
            "Accept": "application/vnd.github+json",
            "User-Agent": "herdr-cooldown-check",
        },
    )
    token = os.environ.get("GH_TOKEN") or os.environ.get("GITHUB_TOKEN")
    if token:
        req.add_header("Authorization", f"Bearer {token}")
    try:
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            data = json.loads(resp.read().decode("utf-8"))
    except (urllib.error.URLError, OSError, ValueError, json.JSONDecodeError):
        return None
    published = data.get("published_at")
    if not published:
        return None
    try:
        return datetime.fromisoformat(published.replace("Z", "+00:00"))
    except ValueError:
        return None


def main() -> int:
    ap = argparse.ArgumentParser(add_help=True)
    ap.add_argument("--cooldown-days", type=float,
                    default=float(os.environ.get("HERDR_COOLDOWN_DAYS", "7")))
    ap.add_argument("--timeout", type=int, default=8)
    ap.add_argument("--quiet", action="store_true")
    ap.add_argument("--json", dest="as_json", action="store_true")
    args = ap.parse_args()

    method = install_method()
    have, raw = installed_version()
    report: dict[str, object] = {
        "install_method": method,
        "installed": ".".join(map(str, have)) if have else None,
        "cooldown_days": args.cooldown_days,
    }
    rows: list[tuple[str, str, str]] = []
    actionable = False

    # Self-test FIRST. If the detectors no longer detect, every line below is
    # worthless and a green report would be a lie -- so say so loudly instead.
    broken = self_test()
    report["self_test"] = "pass" if not broken else broken
    for failure in broken:
        actionable = True
        rows.append(("self-test", ACTION,
                     f"DETECTOR BROKEN — {failure} — the checks below cannot be trusted"))

    if method == "absent":
        rows.append(("version", SKIP, "herdr is not installed — nothing to gate"))
        emit(args, rows, report)
        return 1 if actionable else 0

    rel = latest_release(args.timeout)
    if rel is None:
        rows.append(("version", SKIP, "could not reach the GitHub releases API"))
    else:
        upstream_tag, upstream_published = rel
        report["upstream_latest"] = upstream_tag
        report["upstream_latest_published"] = upstream_published.isoformat()

        # The GATING candidate: for brew, this is whatever `brew upgrade herdr`
        # would ACTUALLY install right now, which can lag well behind GitHub's
        # newest tag (Homebrew-core only moves when a maintainer bumps the
        # formula). Gating against GitHub's absolute latest instead was a real
        # bug -- it can hold back an upgrade that would only ever fetch an
        # older, long-since-eligible version anyway. Non-brew installs have no
        # such intermediary, so GitHub's latest IS the candidate there.
        tag, published = upstream_tag, upstream_published
        if method == "brew":
            brew_ver = homebrew_stable_version(args.timeout)
            if brew_ver is not None and semver(brew_ver) != semver(upstream_tag):
                brew_tag = f"v{brew_ver}"
                brew_published = release_by_tag(brew_tag, args.timeout)
                if brew_published is not None:
                    tag, published = brew_tag, brew_published
                    rows.append(("homebrew-lag", SKIP,
                                 f"Homebrew offers {brew_tag}; GitHub's newest is "
                                 f"{upstream_tag} but isn't packaged yet"))

        want = semver(tag)
        age_days = (datetime.now(timezone.utc) - published).total_seconds() / 86400
        report["latest"] = tag
        report["latest_published"] = published.isoformat()
        report["latest_age_days"] = round(age_days, 2)

        verdict = version_verdict(have, want, age_days, args.cooldown_days)
        report["verdict"] = verdict

        if want is None:
            rows.append(("version", SKIP, f"could not parse upstream tag {tag!r}"))
        elif have is None:
            rows.append(("version", SKIP, f"could not parse `herdr --version` ({raw!r})"))
        elif verdict == "CURRENT":
            rows.append(("version", CLEAN,
                         f"installed {'.'.join(map(str, have))} is current ({tag})"))
        elif verdict == "HELD":
            left = args.cooldown_days - age_days
            rows.append(("cooldown", CLEAN,
                         f"{tag} HELD by cooldown — {left:.1f}d of "
                         f"{args.cooldown_days:g}d remaining"))
        else:
            actionable = True
            if method == "brew":
                fix = "brew unpin herdr && brew upgrade herdr && brew pin herdr"
            else:
                fix = (f"download {tag} from github.com/{REPO}/releases "
                       f"(direct install — `herdr update` ignores the cooldown)")
            rows.append(("cooldown", ACTION,
                         f"{tag} ELIGIBLE — released {age_days:.1f}d ago — {fix}"))

    if method == "brew":
        pinned = brew_pinned()
        report["brew_pinned"] = pinned
        if pinned is None:
            rows.append(("pin", SKIP, "Homebrew could not report pin state"))
        elif pinned:
            rows.append(("pin", CLEAN, "formula is pinned — `brew upgrade` cannot move it"))
        else:
            actionable = True
            rows.append(("pin", ACTION,
                         "formula NOT pinned — a routine `brew upgrade` bypasses "
                         "the cooldown — run `brew pin herdr`"))

    phone = phone_home_state()
    report["phone_home"] = phone
    for key, label in (("version_check", "background version check"),
                       ("manifest_check", "remote agent-manifest fetch")):
        val = phone[key]
        if val is False:
            rows.append(("phone-home", CLEAN, f"update.{key} = false ({label} off)"))
        else:
            actionable = True
            shown = "unset (upstream default: true)" if val is None else "true"
            rows.append(("phone-home", ACTION,
                         f"update.{key} is {shown} — {label} still live — "
                         f"set it to false in {CONFIG_PATH}"))

    emit(args, rows, report)
    return 1 if actionable else 0


def emit(args, rows, report) -> None:
    report["subjects"] = [{"subject": s, "state": st, "detail": d} for s, st, d in rows]
    if args.as_json:
        print(json.dumps(report, indent=2))
        return
    for subject, state, detail in rows:
        if args.quiet and state == CLEAN:
            continue
        print(f"  {state:<7} {subject:<10} {detail}")
    if not args.quiet:
        n = sum(1 for _, st, _ in rows if st == ACTION)
        print(f"  {'—' * 3} {n} actionable, {len(rows)} checked")


if __name__ == "__main__":
    sys.exit(main())
