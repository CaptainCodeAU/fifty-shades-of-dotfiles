#!/usr/bin/env bash
# open-items -- what is still open, scoped to the project you are standing in.
#
# WHY THIS EXISTS. `~/.claude/MEMORY/WORK/` was ONE drawer for the whole machine, so
# every session saw every project's items. Gavin ruled it per-project on 2026-09-18
# (D-20260918-02): items live under their project, every item NAMES its project, and
# the machine-wide view is DERIVED by script and never maintained by hand.
#
# WHERE THE DRAWER LIVES (D-20260919-03, executed 2026-09-19). Each repo's drawer is
# `~/.claude/projects/<key>/memory/WORK/OPEN.md`, inside the harness memory dir that
# Claude Code already keeps for that repo. `<key>` is the repo's toplevel path with
# every `/`, `.` and `_` turned into `-` -- the harness's own encoding, verified
# against live keys on 2026-09-19 (`/Users/x/.claude` -> `-Users-x--claude`,
# `Tax_Bhencho` -> `Tax-Bhencho`; see the reference_claude_code_path_encoding memory).
# The encoding is LOSSY, so a key is never decoded back into a path: the current
# repo is matched FORWARD from its toplevel, and `--all` reads each drawer's own
# `project:` field for its name.
#
# Why that directory and not the old machine-wide one: the old tree was unversioned
# and, per LifeOS's own SystemUserBoundary doc, a "root-level orphan; migrate". The
# harness memory dir is versioned in dot-claude. Inside it, `WORK/` is the per-project
# work tree LifeOS's harvester already walks -- and deliberately ignores, because it
# opens only `<slug>/ISA.md` at phase complete|learn. A loose `OPEN.md` at the WORK
# root is therefore recognised as territory and never harvested as content. Never
# put a drawer file loose in `memory/` itself (that level IS scanned flat) and never
# nest it as `memory/MEMORY/WORK/` (the global `MEMORY/` ignore rule would un-version
# it).
#
# Research folders (`ci-watch-observability/` and friends) sit BESIDE `OPEN.md` under
# `WORK/`, so a `holds-in:` value is a path relative to the drawer.
#
# WHY A TOOL AND NOT JUST A FOLDER LAYOUT. What gets an item IN FRONT of Gavin is
# the SessionStart hook, not the file. A list he has to remember to type is a list he
# will not see. So this tool is the query layer, and `--session` is the surface that
# actually speaks.
#
# THE BLOCK FORMAT IS BORROWED, NOT INVENTED. It is DECISIONS.md's shape, which
# `decided` already parses with one awk pass.
#
# THE DESIGN POINT, borrowed from census and decided: AN EMPTY RESULT IS THE ANSWER
# THAT LIES. "No open items" reads identically to "the drawer was never found" and to
# "this project has no drawer yet". Those are three different facts and this tool
# says which one it means, every time, with the denominator attached.
#
# There is deliberately NO derived INDEX.md any more (dropped 2026-09-19). `--all` IS
# the machine-wide view, computed live on every call, so it cannot go stale the way a
# file regenerated by hand does. Nothing read the file.
#
# Item format -- one block per item:
#
#   ## W-20260918-01 -- short title
#
#   project: fifty-shades-of-dotfiles
#   status: open
#   size: small
#   holds-in: ci-watch-observability/NEXT.md
#
#   Body prose. Everything until the next `## W-` heading.
#
# `status:` is open | done | decided | dropped. Only `open` is reported by default.
#
# Usage:
#   open-items                    open items for the CURRENT repo
#   open-items --all              open items for every repo that has a drawer
#   open-items --project <name>   a named project (matched on its `project:` field)
#   open-items --closed           include done/decided/dropped as well
#   open-items --projects         list the drawers found, with their paths
#   open-items --where            print the current repo's drawer path (exists or not)
#   open-items --selftest         prove every arm before trusting it
#   open-items --help
#
# Exit: 0 items found  ·  1 none found (not an error)  ·  2 REFUSED -- the projects
# root or the repo's memory dir is missing, which is NOT "nothing is open".

set -uo pipefail

PROJECTS="${OPEN_ITEMS_PROJECTS_DIR:-$HOME/.claude/projects}"

refuse(){ printf 'open-items: REFUSED -- %s\n' "$1" >&2; exit 2; }
usage(){ sed -n '2,72p' "$0" | sed 's/^# \{0,1\}//'; }

# The repo you are standing in: the MAIN worktree's toplevel, resolved through
# --git-common-dir. Not the cwd basename (that is a subdirectory half the time), and
# not a linked worktree's own toplevel (a worktree's projects key has no memory dir;
# measured 2026-09-18 by /refresh: 29 worktree keys, 0 with one).
current_repo(){
  local gcd
  gcd="$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null)" || return 1
  [ -n "$gcd" ] || return 1
  dirname "$gcd"
}

encode_key(){ printf '%s' "$1" | sed 's#[/._]#-#g'; }

# The drawer file for a repo path. Printed whether or not it exists.
drawer_for(){ printf '%s/%s/memory/WORK/OPEN.md' "$PROJECTS" "$(encode_key "$1")"; }

# Every drawer on the machine. A glob rather than find, because a memory dir may be a
# SYMLINK (dot-claude's is, into lifeos-private) and find does not follow those.
all_drawers(){
  local f
  for f in "$PROJECTS"/*/memory/WORK/OPEN.md; do [ -f "$f" ] && printf '%s\n' "$f"; done
}

# A drawer's project name: its first `project:` line, else the `# <name> -- open items`
# header, else the encoded key. Keys are lossy, so the file is the authority.
name_of(){
  local f="$1" n
  n="$(sed -n 's/^project:[[:space:]]*//p' "$f" 2>/dev/null | head -1)"
  [ -n "$n" ] || n="$(sed -n '1s/^# \(.*\) -- open items$/\1/p' "$f" 2>/dev/null)"
  [ -n "$n" ] || n="$(basename "$(dirname "$(dirname "$(dirname "$f")")")")"
  printf '%s' "$n"
}

drawer_named(){                 # drawer_named <project> -> path, or rc=1
  local f
  while IFS= read -r f; do
    [ -n "$f" ] || continue
    [ "$(name_of "$f")" = "$1" ] && { printf '%s' "$f"; return 0; }
  done < <(all_drawers)
  return 1
}

# Count blocks across every drawer. This is the DENOMINATOR, printed on every path
# including the misses, so a zero can never be mistaken for "the tool looked and the
# drawer was full of nothing".
count_all_blocks(){
  local n=0 f
  while IFS= read -r f; do
    [ -n "$f" ] || continue
    n=$(( n + $(grep -c '^## W-' "$f" 2>/dev/null || echo 0) ))
  done < <(all_drawers)
  printf '%s' "$n"
}
count_drawers(){ all_drawers | wc -l | tr -d ' '; }
drawer_names(){ local f; while IFS= read -r f; do [ -n "$f" ] && name_of "$f"; printf ' '; done < <(all_drawers); }

# Print blocks from one file, filtered by status. One awk pass, and deliberately NO
# \x01 record separator: BSD awk (this machine's) does not honour \x escapes.
blocks_from(){
  local f="$1" want_closed="$2"
  [ -f "$f" ] || return 1
  awk -v want_closed="$want_closed" '
    function flush(b,   st) {
      if (b == "") return
      st = "open"
      if (match(b, /\nstatus:[ \t]*[A-Za-z]+/))
        { st = substr(b, RSTART, RLENGTH); sub(/.*status:[ \t]*/, "", st) }
      if (want_closed == "1" || st == "open") { printf "%s", b; matched++ }
    }
    /^## W-/ { flush(block); block = $0 "\n"; next }
    { if (block != "") block = block $0 "\n" }
    END { flush(block); exit (matched > 0 ? 0 : 1) }
  ' "$f"
}

report(){                       # report <label> <file...>
  local label="$1"; shift
  local total hits any=1 f
  total="$(count_all_blocks)"
  for f in "$@"; do
    hits="$(blocks_from "$f" "$WANT_CLOSED")" && { printf '%s' "$hits"; any=0; }
  done
  if [ "$any" -eq 0 ]; then
    printf '\nopen-items: %s. %s item(s) exist across %s drawer(s).\n' \
           "$label" "$total" "$(count_drawers)"
    return 0
  fi
  # THE MISS PATH SAYS WHAT IT LOOKED AT. A bare "none" here would read identically
  # to a drawer that was never opened, which is the whole failure this tool guards.
  printf 'open-items: nothing open for %s.\n' "$label" >&2
  printf 'open-items: searched %s item(s) across %s drawer(s): %s\n' \
         "$total" "$(count_drawers)" "$(drawer_names)" >&2
  printf 'open-items: a miss is not the same as "nothing is open" -- it can also mean this project has no drawer yet.\n' >&2
  return 1
}

WANT_CLOSED=0
ARGS=()
for a in "$@"; do
  case "$a" in
    --closed) WANT_CLOSED=1 ;;
    *) ARGS+=("$a") ;;
  esac
done
set -- ${ARGS[@]+"${ARGS[@]}"}      # bash 3.2: a bare "${a[@]}" on an empty array is unbound under set -u

case "${1:-}" in
  -h|--help)  usage; exit 0 ;;
  --selftest) exec "$(dirname "$0")/open-items-selftest" ;;
esac

# `--session` is EXEMPT from this guard, deliberately. Every other entry point should
# refuse loudly when the projects root is missing, because silence there would report
# the absence of a filesystem as the absence of work. The session surface is the one
# place where that trade flips: it runs before the user sees a prompt, so a refusal
# there is noise in their face at the worst moment, and `open-items` proper is one
# word away.
[ -d "$PROJECTS" ] || [ "${1:-}" = --session ] \
  || refuse "no projects root at $PROJECTS (set OPEN_ITEMS_PROJECTS_DIR to point elsewhere)"

case "${1:-}" in
  # THE SESSION-START SURFACE. Deliberately SILENT when there is nothing open, and
  # deliberately not a separate script. Silence here is not the count-and-absence
  # trap, it is the opposite of it -- a line that prints every session regardless
  # becomes wallpaper. Anyone who wants the denominator runs `open-items`.
  #
  # It exits 0 on EVERY path including a missing drawer. A session start must never
  # be blocked or noisied by this; if something is wrong, the full command says so.
  --session)
    repo="$(current_repo)" || exit 0
    f="$(drawer_for "$repo")"
    [ -f "$f" ] || exit 0
    titles="$(blocks_from "$f" 0 2>/dev/null | grep '^## W-' | sed 's/^## [^ ]* -- /   · /')"
    [ -n "$titles" ] || exit 0
    n="$(printf '%s\n' "$titles" | wc -l | tr -d ' ')"
    printf '\033[1mOpen items\033[0m \033[2m(%s in %s -- `open-items` for detail)\033[0m\n' "$n" "$(name_of "$f")"
    printf '\033[2m%s\033[0m\n' "$titles"
    exit 0 ;;
  --where)
    repo="$(current_repo)" || refuse "not inside a git repo, so there is no current project"
    f="$(drawer_for "$repo")"
    printf '%s\n' "$f"
    [ -f "$f" ] && exit 0
    printf 'open-items: (does not exist yet)\n' >&2; exit 1 ;;
  --projects)
    n="$(count_drawers)"
    [ "$n" -gt 0 ] || { printf 'open-items: no drawers under %s/*/memory/WORK/\n' "$PROJECTS" >&2; exit 1; }
    while IFS= read -r f; do [ -n "$f" ] && printf '%s\t%s\n' "$(name_of "$f")" "$f"; done < <(all_drawers)
    printf '\nopen-items: %s drawer(s), %s item(s) total.\n' "$n" "$(count_all_blocks)" ;;
  --all)
    files=(); while IFS= read -r f; do [ -n "$f" ] && files+=("$f"); done < <(all_drawers)
    [ "${#files[@]}" -gt 0 ] || refuse "no drawers under $PROJECTS/*/memory/WORK/ -- nothing could have been searched"
    report "every project" "${files[@]}" ;;
  --project)
    [ -n "${2:-}" ] || { printf 'usage: open-items --project <name>\n' >&2; exit 2; }
    f="$(drawer_named "$2")" || f=""
    report "$2" "${f:-/nonexistent}" ;;
  '')
    repo="$(current_repo)" || refuse "not inside a git repo, so there is no current project -- use --project <name> or --all"
    f="$(drawer_for "$repo")"
    # A repo with NO harness memory dir at all is a different fact from a repo whose
    # memory dir has no drawer yet. The first means the key resolved to nothing the
    # harness has ever written, which is worth refusing on: either the repo has never
    # had a session, or the key was computed wrong. The second is an ordinary miss.
    [ -d "$(dirname "$(dirname "$f")")" ] \
      || refuse "no harness memory dir for $repo at $(dirname "$(dirname "$f")") -- the key may be wrong, or this repo has never had a session"
    report "$(basename "$repo")" "$f" ;;
  *) printf 'open-items: unknown arg "%s" (try --help)\n' "$1" >&2; exit 2 ;;
esac
