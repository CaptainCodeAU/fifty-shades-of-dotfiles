#!/usr/bin/env zsh
# ============================================================================
#  herdr-type-livetest -- drive a THROWAWAY Claude Code session through every
#                         herdr-type scenario and log what really happened
# ============================================================================
#
# Give it a pane that holds a fresh, disposable Claude Code session in bypass
# mode (on this estate: `engage-worker tab <purpose>`). It types setup prompts
# into that session (question boxes, a permission prompt, a plan), cycles its
# permission mode with shift+tab and back, opens one plain shell pane beside it
# and closes that pane again. It never touches any other pane.
#
# usage: herdr-type-livetest <pane-id> [--log FILE] [--only NAME,...] [--long N]
#   --long N   characters for the long-text scenario (default 100000; it costs
#              context: 250,049 characters took a session to 56%)
# Output: one line per scenario, PASS/FAIL and the evidence; the same as TSV in
# --log (default $TMPDIR/herdr-type-livetest.tsv). Exit 0 only if all passed.
# ============================================================================
emulate -L zsh
setopt pipefail
HT=${0:A:h}/herdr-type
P=$1; shift || { print -u2 "usage: herdr-type-livetest <pane-id> [--log FILE] [--only a,b] [--long N]"; exit 2 }
LOG=${TMPDIR:-/tmp}/herdr-type-livetest.tsv; ONLY=""; LONG=100000
while (( $# )); do
  case $1 in
    --log) (( $# >= 2 )) || { print -u2 "--log needs a value"; exit 2 }; LOG=$2; shift 2 ;;
    --only) (( $# >= 2 )) || { print -u2 "--only needs a value"; exit 2 }; ONLY=$2; shift 2 ;;
    --long) (( $# >= 2 )) || { print -u2 "--long needs a value"; exit 2 }; LONG=$2; shift 2 ;;
    *) print -u2 "unknown option $1"; exit 2 ;;
  esac
done
WORK=$(mktemp -d "${TMPDIR:-/tmp}/herdr-type-livetest.XXXXXX")
TX=$($HT state $P | jq -r .transcript)
[[ -f $TX ]] || { print -u2 "no transcript for $P"; exit 2 }
print -r -- $'time\tscenario\tresult\tevidence' > $LOG
pass=0 fail=0

now() { date "+%-I:%M:%S %p" }
result() {  # name PASS|FAIL evidence
  print -r -- "$(now)  $2  $1: $3"
  print -r -- "$(now)"$'\t'"$1"$'\t'"$2"$'\t'"$3" >> $LOG
  if [[ $2 == PASS ]]; then (( ++pass )); else (( ++fail )); fi
  return 0  # (( x++ )) is "false" when x was 0; never let a count decide a branch
}
want() { [[ -z $ONLY || ",$ONLY," == *",$1,"* ]] }
st() { $HT state $P | jq -r .state }
waitstate() {  # regex timeout-seconds -> 0 when the state matches
  local end=$(( SECONDS + $2 )) s
  while (( SECONDS < end )); do
    s=$(st); [[ $s =~ $1 ]] && return 0; sleep 1
  done
  print -u2 "  (waited $2 s for /$1/, state is $s)"; return 1
}
idle() { waitstate '^prompt-(empty|draft)$' ${1:-90} }
setup() { $HT send $P "$1" --enter >/dev/null 2>&1 }
last_user() { jq -rs '[.[] | select(.type=="user") | .message.content | if type=="string" then . else (map(select(.type=="text") | .text) | join("\n")) end | select(length>0)] | last' $TX }
last_result() { jq -rs '[.[] | select(.type=="user") | .message.content | if type=="array" then (map(select(.type=="tool_result") | (.content|tostring)) | join("\n")) else empty end | select(length>0)] | last' $TX }
cycle_to() {  # mode label as shown on the status line: "manual mode", "plan mode", "bypass permissions"
  local i
  for i in 1 2 3 4 5 6; do
    herdr pane read $P --source visible --lines 4 2>/dev/null | grep -q "$1 on" && return 0
    herdr pane send-keys $P shift+tab >/dev/null; sleep 1
  done
  herdr pane read $P --source visible --lines 4 2>/dev/null | grep -q "$1 on"
}
box() {  # open an AskUserQuestion box from a spec sentence
  setup "LT: use the AskUserQuestion tool ONCE: $1 Do nothing else."
  waitstate '^question-' 60
}

idle 60 || { print -u2 "session is not idle at the prompt"; exit 2 }

if want empty; then
  out=$($HT send $P "LT-empty: reply with only the word ok1" --enter --verify --json 2>&1 | tail -1)
  [[ $out == *'"verify": "exact'* ]] && result empty PASS "verified exact" || result empty FAIL "$out"
  idle
fi

if want draft-end; then
  herdr pane send-text $P 'DRAFTX ' >/dev/null; sleep 0.5
  $HT send $P "LT-draft-end: reply with only the word ok2" --enter --verify >/dev/null 2>&1
  u=$(last_user); [[ $u == "DRAFTX LT-draft-end"* ]] && result draft-end PASS "delivered: $u" || result draft-end FAIL "delivered: $u"
  idle
fi

if want draft-start; then
  herdr pane send-text $P ' TAILDRAFT' >/dev/null; sleep 0.5
  $HT send $P "LT-draft-start: reply with only the word ok3." --at start --enter --verify >/dev/null 2>&1
  u=$(last_user); [[ $u == "LT-draft-start: reply with only the word ok3. TAILDRAFT" ]] && result draft-start PASS "delivered: $u" || result draft-start FAIL "delivered: $u"
  idle
fi

if want slash-menu; then
  herdr pane send-text $P '/con' >/dev/null; sleep 1
  s1=$(st)
  $HT send $P "LT-menu text" >/dev/null 2>&1; sleep 1
  d=$($HT state $P | jq -r .draft)
  [[ $s1 == prompt-menu && $d == "/con LT-menu text" ]] && result slash-menu PASS "state was $s1; box now '$d' (not sent)" || result slash-menu FAIL "state $s1; box '$d'"
  herdr pane send-keys $P ctrl+e ctrl+u >/dev/null; sleep 0.5
fi

if want busy; then
  setup "LT-busy-setup: run this exact bash command in the foreground: perl -e 'select(undef,undef,undef,20)' ; then reply with only the word enod"
  waitstate '^busy$' 30
  s1=$(st)
  $HT send $P "LT-busy: reply with only the word ysub" --enter >/dev/null 2>&1
  sleep 30; idle
  q=$(jq -rs '[.[] | select(.attachment.type=="queued_command") | .attachment.prompt | tostring] | last' $TX)
  [[ $s1 == busy && $q == *"LT-busy"* ]] && result busy PASS "state was busy; queued and delivered: $q" || result busy FAIL "state $s1; queued: $q"
fi

if want multiline; then
  print -rn -- $'LT-multiline line 1: reply with only the number of lines in this message.\nline 2\nline 3\nline 4\nline 5' > $WORK/ml.txt
  out=$($HT send $P -f $WORK/ml.txt --enter --verify --json 2>&1 | tail -1)
  [[ $out == *'"verify": "exact'* ]] && result multiline PASS "5 lines, verified exact" || result multiline FAIL "$out"
  idle
fi

if want unicode; then
  print -rn -- $'LT-unicode: reply with only ok4. Café, naïve, 日本語, Ελληνικά, 🍕👍🏽, 🇦🇺, 👨‍👩‍👧, tab\there, zero​width.' > $WORK/uni.txt
  out=$($HT send $P -f $WORK/uni.txt --enter --verify --json 2>&1 | tail -1)
  u=$(last_user)
  [[ $out == *'"verify": "exact'* && $u == *"tab    here"* && $u == *"zerowidth"* ]] && result unicode PASS "exact after cleaning (tab -> 4 spaces, U+200B dropped)" || result unicode FAIL "$out"
  idle
fi

if want box-safety; then
  box '"Pick a fruit" with options Apple, Pear, Plum.' && {
    $HT send $P "2 bananas" --raw >/dev/null 2>&1; sleep 2
    s2=$(st)
    [[ $s2 == question-single ]] && result box-safety PASS "raw typing of '2 bananas' left the box open" || result box-safety FAIL "state after raw typing: $s2"
    herdr pane send-keys $P esc >/dev/null; idle
  } || result box-safety FAIL "box did not open"
fi

if want question-single; then
  box '"Pick a fruit" with options Apple, Pear, Plum.' && {
    out=$($HT send $P "a mango, typed by herdr-type" --enter --verify --json 2>&1 | tail -1)
    r=$(last_result)
    [[ $out == *'"verify": "contained'* && $r == *"a mango, typed by herdr-type"* ]] && result question-single PASS "answer: ${r[1,90]}" || result question-single FAIL "$out / $r"
    idle
  } || result question-single FAIL "box did not open"
fi

if want question-two-options; then
  box '"Pick a drink" with options Tea, Coffee (exactly two options).' && {
    plan=$($HT send $P "a hot chocolate" --dry-run 2>&1 | tail -1)
    out=$($HT send $P "a hot chocolate" --enter --verify --json 2>&1 | tail -1)
    r=$(last_result)
    [[ $plan == *'digit:3'* && $r == *"a hot chocolate"* ]] && result question-two-options PASS "pressed 3 (not 4), answer: ${r[1,80]}" || result question-two-options FAIL "plan $plan / $r"
    idle
  } || result question-two-options FAIL "box did not open"
fi

if want question-multi; then
  box 'with multiSelect true, "Pick toppings" with options Cheese, Olives, Basil.' && {
    s1=$(st)
    out=$($HT send $P "extra chilli" --submit --verify --json 2>&1 | tail -1)
    r=$(last_result)
    [[ $s1 == question-multi && $r == *"extra chilli"* ]] && result question-multi PASS "answer: ${r[1,80]}" || result question-multi FAIL "state $s1 / $out / $r"
    idle
  } || result question-multi FAIL "box did not open"
fi

if want question-two; then
  box 'with TWO questions: "Pick a fruit" (Apple, Pear) and "Pick a drink" (Tea, Coffee).' && {
    $HT send $P "a ripe fig" --enter >/dev/null 2>&1; sleep 1.5
    $HT send $P "a cold brew" --enter >/dev/null 2>&1; sleep 1.5
    s3=$(st)
    herdr pane send-keys $P enter >/dev/null; sleep 6
    r=$(last_result)
    [[ $s3 == question-review && $r == *"a ripe fig"* && $r == *"a cold brew"* ]] && result question-two PASS "review screen reached; answer: ${r[1,100]}" || result question-two FAIL "state before submit $s3 / $r"
    idle
  } || result question-two FAIL "box did not open"
fi

if want where-prompt-esc; then
  box '"Pick a colour" with options Red, Blue.' && {
    $HT send $P "LT-esc" --where prompt >/dev/null 2>&1; rc=$?
    herdr pane send-keys $P esc >/dev/null; idle
    out=$($HT send $P "LT-after-esc: reply with only the word ok5" --enter --verify --json 2>&1 | tail -1)
    [[ $rc == 4 && $out == *'"verify": "exact'* ]] && result where-prompt-esc PASS "--where prompt refused in a box (exit 4); after Esc a prompt went through" || result where-prompt-esc FAIL "rc $rc / $out"
    idle
  } || result where-prompt-esc FAIL "box did not open"
fi

if want permission; then
  cycle_to "manual mode" && {
    setup "LT-perm: run this bash command: touch $WORK/perm-yes.txt"
    waitstate '^permission$' 60
    $HT send $P "note from herdr-type: thanks" >/dev/null 2>&1; rc=$?
    out=$($HT send $P "note from herdr-type: thanks" --permission yes --enter --verify --json 2>&1 | tail -1)
    sleep 3
    [[ $rc == 4 && -f $WORK/perm-yes.txt && $out == *(contained|exact)* ]] && result permission-yes PASS "no --permission: exit 4; yes + note: command ran, note delivered" || result permission-yes FAIL "rc $rc / file $([[ -f $WORK/perm-yes.txt ]] && echo yes || echo no) / $out"
    idle 30
    setup "LT-perm2: run this bash command: touch $WORK/perm-no.txt"
    waitstate '^permission$' 60
    out=$($HT send $P "stop, the test is done" --permission no --enter --verify --json 2>&1 | tail -1)
    sleep 3
    [[ ! -f $WORK/perm-no.txt && $out == *(contained|exact)* ]] && result permission-no PASS "refused, reason delivered" || result permission-no FAIL "file $([[ -f $WORK/perm-no.txt ]] && echo yes || echo no) / $out"
    idle 60
  } || result permission FAIL "could not reach manual mode"
  cycle_to "bypass permissions" || print -u2 "WARNING: could not return the session to bypass mode"
fi

if want plan; then
  cycle_to "plan mode" && {
    setup "LT-plan: make a two-step plan to create the file $WORK/plan.txt containing hello, and present it for approval right away without exploring anything."
    waitstate '^plan-approval$' 90
    out=$($HT send $P "use the word goodbye instead of hello" --enter --verify --json 2>&1 | tail -1)
    waitstate '^plan-approval$' 90
    scr=$(herdr pane read $P --source visible --lines 120 2>/dev/null)
    [[ $out == *contained* && $scr == *goodbye* && ! -f $WORK/plan.txt ]] && result plan PASS "feedback delivered; revised plan says goodbye; nothing ran" || result plan FAIL "$out"
    herdr pane send-keys $P esc >/dev/null; sleep 2
  } || result plan FAIL "could not reach plan mode"
  cycle_to "bypass permissions" || print -u2 "WARNING: could not return the session to bypass mode"
  idle 30
fi

if want shell; then
  S=$(herdr pane split $P --direction down --cwd $WORK --no-focus | jq -r .result.pane.pane_id)
  herdr pane rename $S livetest-shell >/dev/null; sleep 4
  $HT send $S "echo SHOULD_NOT_RUN" >/dev/null 2>&1; rc=$?
  print -rn -- $'echo HELD_ONE_$((6*7))\necho HELD_TWO' > $WORK/sh.txt
  $HT send $S -f $WORK/sh.txt --allow-shell >/dev/null 2>&1; sleep 1
  scr=$(herdr pane read $S --source visible --lines 20 2>/dev/null)
  [[ $rc == 4 && $scr != *HELD_ONE_42* && $scr == *"echo HELD_TWO"* ]] && result shell PASS "refused without --allow-shell (exit 4); with it, two lines held, nothing ran" || result shell FAIL "rc $rc / screen: ${scr[-200,-1]}"
  herdr pane send-keys $S ctrl+c >/dev/null; herdr pane close $S >/dev/null
fi

if want long; then
  uv run --no-project python3 -c "import sys; n=int(sys.argv[1]); w=' '.join(f'w{i}' for i in range(n)); print('LT-long: reply with only the word ok6. ' + w[:n] + ' END-LT-long', end='')" $LONG > $WORK/long.txt
  t0=$SECONDS
  out=$($HT send $P -f $WORK/long.txt --enter --verify --timeout 120 --json 2>&1 | tail -1)
  [[ $out == *'"verify": "exact'* ]] && result long PASS "$(wc -c < $WORK/long.txt | tr -d ' ') characters, verified exact, $(( SECONDS - t0 )) s with the reply" || result long FAIL "$out"
  idle 120
fi

print -r -- "herdr-type-livetest: $pass passed, $fail failed (log: $LOG)"
(( fail == 0 ))
