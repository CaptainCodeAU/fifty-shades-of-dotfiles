#!/usr/bin/env bash
# safe-rm-selftest -- regression suite for the Trash-routed deletion chain.
#
# WHY THIS EXISTS
# ---------------
# On 2026-09-04 a security review found FIVE defects in this chain in a single sitting, and
# every one of them was in the same family: the code reported an outcome it had not verified.
# Three of them were the dangerous direction -- a delete that happened, reported as one that
# had not, so nobody would think to look in the Trash.
#
#   1. `safe-rm -- -v`               said "Trashed", deleted nothing (leading dash reached
#                                    `trash` as an option; macOS `trash` exits 0 on those).
#   2. `sudo -nu root rm -rf x`      reached /bin/rm; the guard's option scanner read `root`
#                                    as the command. (Fixed in .zshrc, covered here anyway.)
#   3. `rm -rf .`                    MOVED THE WHOLE TREE and printed "They are UNCHANGED.
#                                    Nothing was deleted permanently."
#   4. `safe-rm f ./f`               trashed f and printed "nothing was deleted".
#   5. `safe-rm a locked/b`          exited 0 without touching locked/b, which existed but
#                                    could not be stat'ed through a mode-000 parent.
#
# Ad-hoc testing found them; only a committed suite keeps them found. Run this after ANY
# change to safe-rm, to home/.local/bin/rm, or to the rm()/sudo() wrappers in .zshrc.
#
# USAGE
#   safe-rm-selftest            run everything, print a summary
#   safe-rm-selftest -v         also print each command's output
#
# It works entirely inside its own mktemp directory and trashes only files it created there.
# It never touches anything outside that directory.

# Read this whole file before running any of it, so an edit saved mid-run cannot change
# the run (W-20260923-A57). A crash under it exits 127 (unbound var) or 1 (bash 3.2 syntax
# error); `selftest-whole-read --help` has the map. Do not move or reword these lines.
[ -n "${SELFTEST_WHOLE_READ-}" ] || SELFTEST_WHOLE_READ=1 exec "$BASH" -c 'shopt -u sourcepath; . "$0"' "$0" "$@"
unset SELFTEST_WHOLE_READ

set -u

VERBOSE=0
[ "${1:-}" = "-v" ] && VERBOSE=1

# Resolve the pair under test. Prefer the copies next to this script (the repo, via stow) so
# the suite tests what is checked in rather than whatever happens to win on PATH.
here=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
SAFE_RM="$here/safe-rm"
RM_SHIM="$here/rm"
[ -x "$SAFE_RM" ] || { echo "safe-rm-selftest: no safe-rm next to $0" >&2; exit 1; }

if ! command -v trash >/dev/null 2>&1 && ! command -v trash-put >/dev/null 2>&1; then
	echo "safe-rm-selftest: no trash tool installed -- cannot test the real path." >&2
	echo "  macOS: it ships at /usr/bin/trash.   Linux: apt install trash-cli" >&2
	exit 1
fi

pass=0
fail=0
ROOT=$(mktemp -d "${TMPDIR:-/tmp}/safe-rm-selftest.XXXXXX") || exit 1
# No /bin/rm anywhere in this file (W-20260929-A160; the BINDING no-real-deleter rule covers
# every script an agent runs). Fixtures stay in $TMPDIR, which the OS clears; cleanup only
# reopens anything a test locked, and every fixture folder is fresh, so nothing needs wiping.
cleanup() { chmod -R u+rwx "$ROOT" 2>/dev/null; }
trap cleanup EXIT INT TERM HUP

ok()   { pass=$((pass + 1)); printf '  \033[32mok\033[0m   %s\n' "$1"; }
bad()  { fail=$((fail + 1)); printf '  \033[31mFAIL\033[0m %s\n' "$1"; }
say()  { [ "$VERBOSE" -eq 1 ] && printf '       | %s\n' "$1"; return 0; }

# run <workdir> <command...> -- captures output in $OUT and status in $ST
run() {
	local wd="$1"; shift
	OUT=$( (CDPATH= cd -- "$wd" && "$@") 2>&1 )
	ST=$?
	[ "$VERBOSE" -eq 1 ] && [ -n "$OUT" ] && say "$OUT"
	return 0
}

newdir() { mktemp -d "$ROOT/$1.XXXXXX"; }   # fresh every call, so a repeated name never needs wiping

echo "safe-rm-selftest"
echo "  under test: $SAFE_RM"
echo

# --------------------------------------------------------------------------------------
echo "1. \".\" and \"..\" must be refused, exactly as /bin/rm refuses them"
# Regression for defect 3. Reachable with no typo at all:
#   find . -type d -exec rm -rf {} +      passes a literal "." as operand one.
for form in . ./ .. ../ sub/.. .//; do
	d=$(newdir "dot")
	mkdir -p "$d/victim/sub"
	: > "$d/victim/keep.txt"
	run "$d/victim" "$SAFE_RM" -rf "$form"
	if [ -e "$d/victim/keep.txt" ] && [ "$ST" -ne 0 ]; then
		ok "refused '$form', tree intact"
	else
		bad "'$form' -- exit=$ST, keep.txt present=$([ -e "$d/victim/keep.txt" ] && echo yes || echo NO)"
	fi
done

d=$(newdir "root")
run "$d" "$SAFE_RM" -rf /
[ "$ST" -ne 0 ] && ok "refused '/'" || bad "'/' was not refused (exit=$ST)"
echo

# --------------------------------------------------------------------------------------
echo "2. A leading-dash target must really be trashed, not silently skipped"
# Regression for defect 1. `trash` has no `--` convention and exits 0 on unknown options,
# so safe-rm rewrites these to ./NAME.
d=$(newdir "dash")
: > "$d/-v"; : > "$d/real.txt"
run "$d" "$SAFE_RM" -- -v real.txt
if [ ! -e "$d/-v" ] && [ ! -e "$d/real.txt" ] && [ "$ST" -eq 0 ]; then
	ok "'-v' and 'real.txt' both trashed"
else
	bad "leading dash -- exit=$ST, -v present=$([ -e "$d/-v" ] && echo YES || echo no)"
fi

d=$(newdir "dash2")
: > "$d/-"; : > "$d/--weird"; : > "$d/ space.txt"
run "$d" "$SAFE_RM" -- - --weird " space.txt"
if [ ! -e "$d/-" ] && [ ! -e "$d/--weird" ] && [ ! -e "$d/ space.txt" ]; then
	ok "'-', '--weird' and ' space.txt' trashed"
else
	bad "hostile names survived (exit=$ST)"
fi

d=$(newdir "dashdir")
mkdir -p "$d/-dir"; : > "$d/-dir/f"
run "$d" "$SAFE_RM" -rf -- -dir
[ ! -e "$d/-dir" ] && ok "'-dir' directory trashed with --" || bad "'-dir' survived (exit=$ST)"
echo

# --------------------------------------------------------------------------------------
echo "3. A delete that HAPPENED must never be reported as one that did not"
# Regression for defect 4. Both shapes are everyday: a glob overlapping an explicit
# argument, and a directory named alongside something inside it. `trash` fails on the
# second operand (already gone with the first) and exits non-zero.
d=$(newdir "dup")
: > "$d/f"
run "$d" "$SAFE_RM" f ./f
if [ ! -e "$d/f" ] && [ "$ST" -eq 0 ]; then
	ok "'f ./f' trashed and reported success"
else
	bad "'f ./f' -- exit=$ST, f present=$([ -e "$d/f" ] && echo YES || echo no)"
fi
case "$OUT" in
	*"nothing was deleted"*) bad "'f ./f' still claims 'nothing was deleted'" ;;
	*) ok "no false 'nothing was deleted' claim" ;;
esac

d=$(newdir "nested")
mkdir -p "$d/build/cache"; : > "$d/build/app.bin"
run "$d" "$SAFE_RM" -r build build/cache
if [ ! -e "$d/build" ] && [ "$ST" -eq 0 ]; then
	ok "'build build/cache' trashed and reported success"
else
	bad "'build build/cache' -- exit=$ST"
fi
echo

# --------------------------------------------------------------------------------------
echo "4. A file that cannot be seen must never be reported as deleted"
# Regression for defect 5. `[ -e ]` and `[ -L ]` are both false when a parent is not
# searchable, which is indistinguishable from "absent" -- so safe-rm refuses rather than
# resolving the ambiguity toward silent success.
d=$(newdir "perm")
mkdir -p "$d/locked"; : > "$d/visible.txt"; : > "$d/locked/hidden.txt"
chmod 000 "$d/locked"
run "$d" "$SAFE_RM" visible.txt locked/hidden.txt
chmod 755 "$d/locked" 2>/dev/null
if [ "$ST" -ne 0 ] && [ -e "$d/locked/hidden.txt" ]; then
	ok "refused an unstattable target instead of claiming success"
else
	bad "unstattable target -- exit=$ST (expected non-zero and a refusal)"
fi
echo

# --------------------------------------------------------------------------------------
echo "5. A trash tool that lies must be caught"
# The general defence: every report comes from re-checking the targets, never from the
# tool's exit status, which has now been measured wrong in both directions.
d=$(newdir "liar")
mkdir -p "$d/bin"
printf '#!/bin/sh\nexit 0\n' > "$d/bin/trash"
chmod +x "$d/bin/trash"
: > "$d/x.txt"
OUT=$( (CDPATH= cd -- "$d" && PATH="$d/bin:/usr/bin:/bin" "$SAFE_RM" x.txt) 2>&1 ); ST=$?
[ "$VERBOSE" -eq 1 ] && say "$OUT"
if [ "$ST" -ne 0 ] && [ -e "$d/x.txt" ]; then
	ok "caught a trash tool that exits 0 without acting"
else
	bad "lying trash tool went undetected (exit=$ST)"
fi
echo

# --------------------------------------------------------------------------------------
echo "6. Ordinary deletes must still work, and rm -f semantics must hold"
d=$(newdir "normal")
: > "$d/file.txt"; mkdir -p "$d/dir/sub"; : > "$d/dir/sub/deep.txt"
run "$d" "$SAFE_RM" file.txt
[ ! -e "$d/file.txt" ] && [ "$ST" -eq 0 ] && ok "plain file trashed" || bad "plain file (exit=$ST)"
run "$d" "$SAFE_RM" -rf dir
[ ! -e "$d/dir" ] && [ "$ST" -eq 0 ] && ok "directory tree trashed" || bad "directory tree (exit=$ST)"
run "$d" "$SAFE_RM" -f does-not-exist
[ "$ST" -eq 0 ] && ok "missing target is a silent success (rm -f semantics)" \
                || bad "missing target returned $ST, breaks every 'rm -f *.aux' in a Makefile"
run "$d" "$SAFE_RM"
[ "$ST" -ne 0 ] && ok "no arguments is a usage error" || bad "no arguments returned 0"
echo

# --------------------------------------------------------------------------------------
if [ -x "$RM_SHIM" ]; then
	echo "7. The PATH shim: scripts, and rm's own directory rule"
	d=$(newdir "shim")
	mkdir -p "$d/bin"
	cp "$SAFE_RM" "$d/bin/safe-rm"
	cp "$RM_SHIM" "$d/bin/rm"
	# safe-rm runs the trash-guard BESIDE it (2026-09-29) and refuses without one, so the
	# copy needs its guard too. trash-guard-selftest proves the rules themselves.
	cp "$here/trash-guard" "$d/bin/trash-guard"
	mkdir -p "$d/tree/sub"; : > "$d/tree/f"

	printf '#!/bin/bash\nrm -rf "$1"\n' > "$d/script.bash"
	chmod +x "$d/script.bash"
	PATH="$d/bin:/usr/bin:/bin" "$d/script.bash" "$d/tree" >/dev/null 2>&1
	[ ! -e "$d/tree" ] && ok "a #!/bin/bash script's rm -rf reached the shim" \
	                   || bad "shim not reached from a bash script"

	# Real rm refuses a directory without -r. `trash` has no such rule, so the shim has to
	# keep it -- otherwise a typo'd `rm build` takes the whole tree.
	mkdir -p "$d/keepme"; : > "$d/keepme/x"
	OUT=$(PATH="$d/bin:/usr/bin:/bin" "$d/bin/rm" "$d/keepme" 2>&1); ST=$?
	[ "$VERBOSE" -eq 1 ] && say "$OUT"
	[ -e "$d/keepme" ] && [ "$ST" -ne 0 ] && ok "shim refuses a directory without -r" \
	                                      || bad "shim removed a directory without -r (exit=$ST)"

	# --preserve-root contains an 'r' and must NOT be read as recursive.
	mkdir -p "$d/keepme2"; : > "$d/keepme2/x"
	OUT=$(PATH="$d/bin:/usr/bin:/bin" "$d/bin/rm" --preserve-root "$d/keepme2" 2>&1); ST=$?
	[ -e "$d/keepme2" ] && ok "'--preserve-root' not mistaken for recursive" \
	                    || bad "'--preserve-root' was read as recursive"

	# W-20260929-A125: the shim must run the safe-rm BESIDE it, never a PATH lookup. Ubuntu's
	# unrelated safe-rm package wraps /bin/rm and deletes permanently. Plant a fake safe-rm
	# first on PATH, keep the shim's own dir OFF PATH (the mlbox case), call the shim by path.
	mkdir -p "$d/foreign"
	printf '#!/bin/sh\n: > "%s/foreign-ran"\nexit 0\n' "$d" > "$d/foreign/safe-rm"
	chmod +x "$d/foreign/safe-rm"
	: > "$d/planted.txt"
	OUT=$(PATH="$d/foreign:/usr/bin:/bin" "$d/bin/rm" "$d/planted.txt" 2>&1); ST=$?
	[ "$VERBOSE" -eq 1 ] && say "$OUT"
	[ ! -e "$d/foreign-ran" ] && [ ! -e "$d/planted.txt" ] && [ "$ST" -eq 0 ] \
		&& ok "a foreign safe-rm first on PATH is never run; the sibling trashed the file" \
		|| bad "foreign safe-rm ran=$([ -e "$d/foreign-ran" ] && echo yes || echo no) target-left=$([ -e "$d/planted.txt" ] && echo yes || echo no) exit=$ST"

	# And with NO sibling safe-rm, the shim must refuse, even though a safe-rm is on PATH.
	mkdir -p "$d/lonely"
	cp "$RM_SHIM" "$d/lonely/rm"
	: > "$d/lonely.txt"
	OUT=$(PATH="$d/foreign:/usr/bin:/bin" "$d/lonely/rm" "$d/lonely.txt" 2>&1); ST=$?
	[ "$VERBOSE" -eq 1 ] && say "$OUT"
	[ -e "$d/lonely.txt" ] && [ "$ST" -ne 0 ] && [ ! -e "$d/foreign-ran" ] \
		&& ok "no sibling safe-rm: the shim refuses and runs nothing else" \
		|| bad "no sibling safe-rm: exit=$ST target-left=$([ -e "$d/lonely.txt" ] && echo yes || echo no)"

	# SAFE_RM_OFF is REMOVED (Gavin, 2026-09-29, W-20260929-A164): set, rm must still go to
	# safe-rm, never /bin/rm. Checked in two steps so a regression can never run a permanent
	# delete here: first the shim's CODE must hold no line that runs /bin/rm (comments aside);
	# only then is it run, against a stub safe-rm that logs its call and deletes nothing.
	# code lines only: comments and echo/printf messages may name /bin/rm; REAL_RM was its variable
	realrm=$(grep -v -e '^[[:space:]]*#' -e '^[[:space:]]*\(echo\|printf\) ' "$RM_SHIM" | grep -c -e '/bin/rm' -e 'REAL_RM')
	if [ "$realrm" -eq 0 ] && grep -q '^[[:space:]]*#.*/bin/rm' "$RM_SHIM"; then
		ok "the shim's code runs no /bin/rm (control: its comments do mention /bin/rm)"
		mkdir -p "$d/offbin"
		cp "$RM_SHIM" "$d/offbin/rm"
		printf '#!/bin/sh\nprintf "%%s\\n" "$@" > "%s/offbin/called"\nexit 0\n' "$d" > "$d/offbin/safe-rm"
		chmod +x "$d/offbin/rm" "$d/offbin/safe-rm"
		touch "$d/perm.txt"
		OUT=$(PATH="$d/offbin:/usr/bin:/bin" SAFE_RM_OFF=1 "$d/offbin/rm" -f "$d/perm.txt" 2>&1); ST=$?
		[ -e "$d/perm.txt" ] && grep -qx "$d/perm.txt" "$d/offbin/called" 2>/dev/null && [[ $OUT == *'SAFE_RM_OFF was removed'* ]] \
			&& ok "SAFE_RM_OFF=1 is ignored: rm still hands the file to safe-rm, and says so" \
			|| bad "SAFE_RM_OFF=1: file-present=$([ -e "$d/perm.txt" ] && echo yes || echo NO) safe-rm-called=$([ -e "$d/offbin/called" ] && echo yes || echo no) out=$OUT"
	else
		bad "the shim's code runs /bin/rm on $realrm line(s): SAFE_RM_OFF or another bypass is back. NOT run, because it would be a permanent delete"
	fi
	echo
fi

# --------------------------------------------------------------------------------------
echo "8. Hostile and awkward names must behave, and the guards must not over-fire"
# The `.`/`..` guard is a pattern match, so the risk runs both ways: it must catch the real
# thing and must NOT catch an ordinary dotfile. `.git` matching would be quietly disastrous.
d=$(newdir "names")
for n in .hidden ..foo .... .git a..b ...; do : > "$d/$n"; done
overfired=""
for n in .hidden ..foo .... .git a..b ...; do
	run "$d" "$SAFE_RM" -q -- "$n"
	[ -e "$d/$n" ] && overfired="${overfired} $n"
done
[ -z "$overfired" ] && ok "dot-guard does not over-fire on .hidden .git .... a..b" \
                    || bad "dot-guard wrongly refused:${overfired}"

# A name containing a newline is the classic way to break a shell script's bookkeeping.
d=$(newdir "newline")
printf 'x' > "$d/new
line.txt"
run "$d" "$SAFE_RM" -q -- "new
line.txt"
[ ! -e "$d/new
line.txt" ] && ok "a filename containing a newline is trashed" \
             || bad "newline filename survived"

# Glob metacharacters as literal name characters, not as a pattern.
d=$(newdir "globchars")
: > "$d/star*.txt"; : > "$d/q?.txt"; : > "$d/br[ack].txt"
run "$d" "$SAFE_RM" -q -- 'star*.txt' 'q?.txt' 'br[ack].txt'
if [ ! -e "$d/star*.txt" ] && [ ! -e "$d/q?.txt" ] && [ ! -e "$d/br[ack].txt" ]; then
	ok "glob metacharacters in a name are treated literally"
else
	bad "a name with * ? or [ ] survived"
fi

# argv is rotated through "$@" three times in this script. If that ever drops or reorders an
# operand, it will show up at volume long before it shows up with two targets.
d=$(newdir "many")
n=0
while [ "$n" -lt 200 ]; do n=$((n + 1)); : > "$d/f$n"; done
( CDPATH= cd -- "$d" && "$SAFE_RM" -q -- f* ) >/dev/null 2>&1
left=$(find "$d" -type f | wc -l | tr -d ' ')
[ "$left" = "0" ] && ok "200 targets in one call, none dropped by argv rotation" \
                  || bad "$left of 200 targets were dropped"

# A file literally named `--`, and a dangling symlink (-e is false, -L is true).
d=$(newdir "edge")
: > "$d/--"
ln -s /nonexistent-target-xyz "$d/dangling"
run "$d" "$SAFE_RM" -q -- --
[ ! -e "$d/--" ] && ok "a file named '--' is trashed" || bad "'--' survived"
run "$d" "$SAFE_RM" -q dangling
[ ! -L "$d/dangling" ] && ok "a dangling symlink is trashed" || bad "dangling symlink survived"

# Removing a symlink must remove the LINK, never follow it into the directory.
d=$(newdir "symdir")
mkdir -p "$d/realdir"; : > "$d/realdir/inside.txt"
ln -s realdir "$d/link"
run "$d" "$SAFE_RM" -q link
if [ -e "$d/realdir/inside.txt" ] && [ ! -L "$d/link" ]; then
	ok "trashing a symlink-to-directory removes the link, not the target"
else
	bad "symlink-to-directory: target contents present=$([ -e "$d/realdir/inside.txt" ] && echo yes || echo NO)"
fi
echo

# --------------------------------------------------------------------------------------
echo "9. Catastrophic targets must be refused, contents must stay deletable"
# `rm -rf ~` is refused by nothing on stock macOS. These assertions run against a FAKE
# \$HOME inside the temp directory -- never the real one -- so a regression in the guard
# cannot destroy the machine while testing the guard.
FH="$ROOT/fakehome"   # $ROOT is a fresh mktemp folder, so this never exists yet
mkdir -p "$FH/Documents/keep" "$FH/CODE/proj/dist" "$FH/Downloads/folder"
: > "$FH/Documents/keep/a.txt"
: > "$FH/CODE/proj/dist/bundle.js"
: > "$FH/Downloads/folder/x"
ln -s "$FH" "$ROOT/homelink"

blocked() { # blocked <label> <target>
	OUT=$(HOME="$FH" "$SAFE_RM" -rf "$2" 2>&1); ST=$?
	[ "$VERBOSE" -eq 1 ] && say "$OUT"
	[ "$ST" -ne 0 ] && ok "refused $1" || bad "$1 was NOT refused (exit=$ST)"
}
allowed() { # allowed <label> <target>
	OUT=$(HOME="$FH" "$SAFE_RM" -rf "$2" 2>&1); ST=$?
	[ "$VERBOSE" -eq 1 ] && say "$OUT"
	[ "$ST" -eq 0 ] && ok "still allows $1" || bad "$1 was wrongly refused (exit=$ST)"
}

blocked "\$HOME itself"                  "$FH"
blocked "\$HOME with a trailing slash"   "$FH/"
blocked "~/Documents"                    "$FH/Documents"
blocked "~/Downloads"                    "$FH/Downloads"
blocked "a relative path resolving to \$HOME" "$FH/CODE/../../fakehome"
blocked "a symlink to \$HOME followed with /"  "$ROOT/homelink/"

# The principle is containers, not contents. If these break, the guard is too aggressive
# and people will route around it, which protects nothing.
allowed "a deep project directory"       "$FH/CODE/proj/dist"
allowed "a folder inside ~/Downloads"    "$FH/Downloads/folder"
allowed "removing the symlink itself"    "$ROOT/homelink"

if [ -d "$FH" ] && [ -e "$FH/Documents/keep/a.txt" ]; then
	ok "fake home and its Documents survived every attempt"
else
	bad "the fake home was damaged -- the guard leaks"
fi

# The system list is absolute, so assert on the classification rather than by invoking
# safe-rm at a real system path. A stub trash proves nothing ever reaches the tool.
mkdir -p "$ROOT/stubbin"
printf '#!/bin/sh\necho called >> "%s/stub.log"\nexit 0\n' "$ROOT" > "$ROOT/stubbin/trash"
chmod +x "$ROOT/stubbin/trash"
: > "$ROOT/stub.log"
sysfail=""
for p in / /Users /Applications /System /Library /usr /etc /var /Volumes; do
	OUT=$(PATH="$ROOT/stubbin:/usr/bin:/bin" "$SAFE_RM" -rf "$p" 2>&1); ST=$?
	[ "$ST" -eq 0 ] && sysfail="${sysfail} $p"
done
if [ -z "$sysfail" ] && [ ! -s "$ROOT/stub.log" ]; then
	ok "system directories refused, and the trash tool was never invoked"
else
	bad "system directories not refused:${sysfail} (stub called: $([ -s "$ROOT/stub.log" ] && echo YES || echo no))"
fi
echo

# --------------------------------------------------------------------------------------
echo "10. Sweeping a guarded folder must be refused; single deletes must not"
# `rm -rf ~/Downloads/*` is the same loss as `rm -rf ~/Downloads` by another route. The glob
# never reaches safe-rm -- the shell expands it first -- so the sweep is recognised from its
# shape: two or more direct children of a guarded folder in one call.
SH="$ROOT/sweephome"
seed_sweep() {
	# Re-creates whatever an ALLOW sweep moved to the Trash; mkdir -p and : > are idempotent,
	# and no arm adds files, so the tree after a reseed equals a fresh one without wiping it.
	for sd in Downloads Desktop Documents CODE Pictures; do mkdir -p "$SH/$sd"; done
	for sd in Downloads Desktop Documents CODE; do
		for nm in one two three; do mkdir -p "$SH/$sd/$nm"; : > "$SH/$sd/$nm/data.txt"; done
	done
	mkdir -p "$SH/CODE/proj/dist"; : > "$SH/CODE/proj/dist/a.js"; : > "$SH/CODE/proj/dist/b.js"
	mkdir -p "$SH/Pictures/album"; : > "$SH/Pictures/album/p.jpg"
}
sweep() { # sweep BLOCK|ALLOW <label> <targets...>
	local want="$1" label="$2"
	shift 2   # shift-lint: ok sweep helper, fixed arity, not a loop
	seed_sweep
	OUT=$(HOME="$SH" "$SAFE_RM" -rf "$@" 2>&1); ST=$?
	[ "$VERBOSE" -eq 1 ] && say "$OUT"
	if [ "$want" = BLOCK ] && [ "$ST" -ne 0 ]; then ok "refuses $label"
	elif [ "$want" = ALLOW ] && [ "$ST" -eq 0 ]; then ok "still allows $label"
	else bad "$label -- want=$want got exit=$ST"; fi
}

seed_sweep
sweep BLOCK "rm -rf ~/Downloads/*" "$SH"/Downloads/*
sweep BLOCK "rm -rf ~/Desktop/*"   "$SH"/Desktop/*
sweep BLOCK "rm -rf ~/Documents/*" "$SH"/Documents/*
sweep BLOCK "rm -rf ~/CODE/*"      "$SH"/CODE/*
sweep BLOCK "two children named explicitly" "$SH/CODE/one" "$SH/CODE/two"
sweep BLOCK "the same sweep with trailing slashes" "$SH/Downloads/one/" "$SH/Downloads/two/"

# Deleting ONE thing on purpose has to keep working, or the guard gets routed around.
sweep ALLOW "a single file from ~/Downloads" "$SH/Downloads/one"
sweep ALLOW "a single project in ~/CODE"     "$SH/CODE/one"
sweep ALLOW "build output deeper inside ~/CODE" "$SH"/CODE/proj/dist/*
sweep ALLOW "a sweep of an UNguarded folder"    "$SH"/Pictures/*
echo

# --------------------------------------------------------------------------------------
printf 'pass=%d fail=%d\n' "$pass" "$fail"
[ "$fail" -eq 0 ] || exit 1
