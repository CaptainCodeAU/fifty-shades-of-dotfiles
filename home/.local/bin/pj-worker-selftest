run start cr --cleanroom
check "S13 --cleanroom: rc 0, reported as not pj and not guarded" '[ "$RC" -eq 0 ] && [ "$(j ".pj, .guarded, .cleanroom")" = "false false true " ]'
check "S13b it launches command claude with no settings and no MCP, and NO bypass flag" \
  'l="$(grep "^pane run w3X:p4W .*claude" "$FAKE/calls")"; has "$l" "command claude --setting-sources '"''"' --strict-mcp-config" && ! has "$l" dangerously && ! has "$l" bypass'
check "S13c it says UNGUARDED BY DESIGN" 'has "$ERR" "UNGUARDED BY DESIGN"'
check "S13d a fresh folder under the clean root, and the start is logged as cleanroom" \
  'd="$(j .cwd)"; d="${d% }"; case "$d" in "$H/.cache/claude-clean/"*-cr) [ -d "$d" ];; *) false;; esac && grep -q "kind=cleanroom name=cr .*result=unguarded" "$STATE/workers.log"'
check "S13e its session name is the caller's project, marked cleanroom" 'grep -q "CLAUDE_CODE_SESSION_NAME=fifty-shades-of-dotfiles-cleanroom-cr command claude" "$FAKE/calls"'
new_world; lists; start_happy
run start cr --cleanroom
check "S13f a clean room counts toward the caller's project cap: refused at 4, rc 6" '[ "$RC" -eq 6 ] && has "$ERR" "project cap: 4 of 4"'
new_world room; lists; run start cr --cleanroom --profile scratch
check "S13g --cleanroom with --profile is refused, rc 2" '[ "$RC" -eq 2 ] && has "$ERR" "cleanroom takes no"'
new_world room; lists; run start Bad_Name
