#!/usr/bin/env zsh
# pj-worker-selftest -- pj-worker is retired (7 Oct 2026, engage #1106): engage-worker took
# over start, verify, prompt, list and count. This proves the note: every argument shape exits 2
# with one line naming engage-worker, and runs nothing (fake herdr, ps, pj, claude, engage and
# engage-worker first on PATH record any call). The old 800-line suite is in git history.
set -u
SELF="${0:A}"; PJW="${PJ_WORKER:-${SELF:h}/pj-worker}"
root="$(mktemp -d "${TMPDIR:-/tmp}/pj-worker-retired.XXXXXX")" || exit 1
trap '/usr/bin/trash "$root" >/dev/null 2>&1' EXIT   # clean through the Trash
mkdir -p "$root/bin"
for t in herdr ps pj claude engage engage-worker; do
  print -r -- "#!/bin/sh
echo $t >> \"$root/calls\"; exit 0" > "$root/bin/$t"; chmod +x "$root/bin/$t"
done
pass=0 fail=0
for args in "" "start a59 --cwd /tmp" "start cr --cleanroom" "verify w1:p2" "prompt w1:p2 hello" "list" "count --json" "count --check" "--selftest" "--help"; do
  out="$(PATH="$root/bin:/usr/bin:/bin" "$PJW" ${=args} 2>&1)"; rc=$?
  if [[ $rc -eq 2 && "$out" == "pj-worker is retired. Type engage-worker." && ! -s "$root/calls" ]]; then
    pass=$((pass + 1)); print -r -- "  ok   [${args:-no args}] rc 2, one line naming engage-worker, nothing run"
  else
    fail=$((fail + 1)); print -r -- "  FAIL [${args:-no args}] rc=$rc out=${out[1,160]} calls=$(cat "$root/calls" 2>/dev/null | tr '\n' ' ')"
    : > "$root/calls"
  fi
done
print -r -- "pj-worker retired selftest: $pass passed, $fail failed"
(( fail == 0 ))
