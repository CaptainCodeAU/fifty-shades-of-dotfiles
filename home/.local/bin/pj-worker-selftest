new_world; verify_fixture; CCD="@H@/.claude-elsewhere" psenv 36921 w3X:p4Q fifty-shades-of-dotfiles-a59-pjworker
run verify w3X:p4Q
check "V17 a default-profile worker with CLAUDE_CONFIG_DIR set: rc 1, named" '[ "$RC" -eq 1 ] && has "$(failures)" "CLAUDE_CONFIG_DIR"'
new_world; verify_fixture; : > "$FAKE/ps/env.36921"
run verify w3X:p4Q
check "V18 an unreadable environment (no HOME in it): rc 2, never a pass or a fail" '[ "$RC" -eq 2 ] && has "$ERR" "environment"'
new_world "" unlinked; verify_fixture; mv "$SESS/36921.json" "$H/.claude-scratch/sessions/"
run verify w3X:p4Q
check "V19 a worker registered in another profile's own (unlinked) sessions dir is found: rc 0" '[ "$RC" -eq 0 ]'
new_world; verify_fixture; agent_get_json w3X:p4Q $S_PW working | sed 's/"agent":"claude","agent_session"/"agent":"codex","agent_session"/' | resp agent_get_w3X:p4Q 1 0
run verify w3X:p4Q
check "V20 an agent that is not claude: rc 1, named" '[ "$RC" -eq 1 ] && has "$(failures)" "not claude"'

# ================================================================== COUNT
echo "--- count"
new_world; lists
run count --cwd "$REPO" --json
check "C1 the live world: project 4 (conductor + 3 worktree workers), machine 5" '[ "$RC" -eq 0 ] && [ "$(j ".project.count, .machine.count")" = "4 5 " ]'
check "C1b registry and ps agree (5 and 5), no disagreement flagged" '[ "$(j ".machine.registry, .machine.ps, .machine.disagree")" = "5 5 false " ]'
check "C1c account is 'not measured' and null, never 0" '[ "$(j ".account.status, (.account.count|tostring)")" = "not measured null " ]'
check "C1d at 4 in the project start is not allowed, and the refusal names the project cap" '[ "$(j .start_allowed)" = "false " ] && has "$(j .refusal)" "project cap: 4 of 4"'
check "C1e the machine cap alone would allow it (5 < 8)" '[ "$(j .machine.count)" = "5 " ] && ! has "$(j .refusal)" "machine cap"'
check "C1f the three worktree sessions count toward their repo" '[ "$(j "[.project.sessions[] | select(.cwd | test(\"/.worktree/\"))] | length")" = "3 " ]'
run count --cwd "$REPO" --check
check "C2 count --check at the project cap: rc 6" '[ "$RC" -eq 6 ]'
run count --cwd "$SWITCH" --check
check "C3 claude-switcher's project (1 live) with the machine at 5: rc 0" '[ "$RC" -eq 0 ]'
new_world; lists
for p in 50001 50002; do mkdir -p "$ROOT/code/other$p"; reg "$SESS" $p "0000$p-aaaa-bbbb-cccc-000000000000" "$ROOT/code/other$p" "other$p-main" "$T_W"; psrow $p claude "$T_W"; done
run count --cwd "$SWITCH" --json
check "C4 machine 7 live: start allowed from a project with room" '[ "$(j ".machine.count, .start_allowed")" = "7 true " ]'
mkdir -p "$ROOT/code/other50003"; reg "$SESS" 50003 "000050003-aaaa-bbbb-cccc-000000000000" "$ROOT/code/other50003" other50003-main "$T_W"; psrow 50003 claude "$T_W"
run count --cwd "$SWITCH" --json
check "C4b machine 8 live: refused by the MACHINE cap though the project has room" \
  '[ "$(j ".machine.count, .project.count, .start_allowed")" = "8 1 false " ] && has "$(j .refusal)" "machine cap: 8 of 8"'
new_world; lists; psrow 60606 claude "$T_W"
run count --cwd "$SWITCH" --json
check "C5 ps 6 vs registry 5: disagreement flagged, 6 compared, the ps-only pid named" \
  '[ "$(j ".machine.registry, .machine.ps, .machine.count, .machine.disagree, (.machine.ps_only_pids|join(\",\"))")" = "5 6 6 true 60606 " ]'
# the conductor's `claude agents --json` trap (a background session, no process behind it):
# its sessionId as a registry file whose pid is gone must not count, and claude is never run
new_world; lists
reg "$SESS" 70707 895d55a9-14c6-4199-829d-e1a369df279b "$REPO" "verify obsolete agent definitions" "Wed Sep  9 01:02:43 2026"
run count --cwd "$REPO" --json
check "C6 the background session with no process (claude agents' trap) does not count: machine 5" '[ "$(j .machine.count)" = "5 " ] && [ ! -e "$FAKE/claude.calls" ]'
# rule (b): cwd OUTSIDE the repo, pane in this project's workspace
new_world room; mkdir -p "$H/.cache/claude-clean/20260924-180000-cr"
reg "$SESS" 80808 cccccccc-1111-2222-3333-444444444444 "$H/.cache/claude-clean/20260924-180000-cr" fifty-shades-of-dotfiles-cleanroom-cr "$T_W"; psrow 80808 claude "$T_W"
lists '{"agent":"claude","agent_session":{"value":"cccccccc-1111-2222-3333-444444444444"},"agent_status":"idle","pane_id":"w3X:p4Z","workspace_id":"w3X"}'
run count --cwd "$REPO" --json
