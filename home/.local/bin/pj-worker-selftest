  '[ "$(j .project.count)" = "4 " ] && [ "$(j ".project.sessions[] | select(.pid==80808) | .why")" = "workspace w3X " ]'
run count --cwd "$SWITCH" --json
check "C7b the same session does not count for claude-switcher (its workspace is w42)" '[ "$(j .project.count)" = "1 " ]'
new_world room; lists '{"agent":"claude","agent_session":{"value":null},"agent_status":"idle","pane_id":"w3X:p50","workspace_id":"w3X"}'
run count --cwd "$REPO" --json
check "C8 a claude herdr agent in the workspace with no registry entry yet COUNTS (unregistered)" \
  '[ "$(j .project.count)" = "4 " ] && [ "$(j "[.project.sessions[] | select(.pid==null)] | length")" = "1 " ]'
new_world; touch "$FAKE/SANDBOX"
run count --cwd "$REPO" --json
check "C9 herdr refused: count still measures registry and ps (rc 0) and says the workspace rule is unmeasured" \
  '[ "$RC" -eq 0 ] && has "$(j .workspace_rule)" "unmeasured" && has "$(j .workspace_rule)" "sandbox"'
run count --cwd "$SWITCH" --check
check "C9b count --check refuses to call that allowed: rc 2, the workspace rule named" '[ "$RC" -eq 2 ] && has "$ERR" "workspace rule"'
new_world; lists; touch "$FAKE/SANDBOX_PS"
