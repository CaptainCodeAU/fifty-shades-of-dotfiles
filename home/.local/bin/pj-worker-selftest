  'has "$OUT" "4 of 4 live" && has "$OUT" "a59-paneguard  pid 36920" && has "$OUT" "machine: 5 of 8" && has "$OUT" "account: not measured"'

# ================================================================== START
echo "--- start"
new_session(){  # the session the launch will start: staged, and brought to life by the fake's `pane run`
  mkdir -p "$FAKE/stage"
  reg "$FAKE/stage" 41000 dddddddd-1111-2222-3333-555555555555 "$REPO/.worktree/a59-pjworker" fifty-shades-of-dotfiles-main-a59-pjworker "Thu Sep 24 08:10:00 2026"
  printf '%5d   501 claude\n' 41000 > "$FAKE/stage/A"; printf '%5d %s    \n' 41000 "Thu Sep 24 08:10:00 2026" > "$FAKE/stage/lstart"
  psenv 41000 w3X:p4W fifty-shades-of-dotfiles-main-a59-pjworker "${1:-}"
  printf 'ts=2026-09-24T18:10:03+1000 session=dddddddd-1111-2222-3333-555555555555 project=x profile=default config_dir=default tty=t shell_start=x zshrc_mtime=x result=ok\n' > "$FAKE/stage/log"
  process_info_json w3X:p4W 41000 "${1:-$ARGV_PJ}" | resp pane_process-info_w3X:p4W 1 0
}
start_happy(){  # herdr's answers for a clean split launch
  printf '%s\n' "$NOTFOUND" | resp agent_get_a59-pjworker 1 1
  printf '%s\n' "$SPLIT" | resp pane_split 1 0
  printf '%s\n' "$WAIT_OK" | resp pane_wait-output_w3X:p4W 1 0
  printf '%s\n' "$NOTFOUND" | resp agent_get_w3X:p4W 1 1
  agent_get_json w3X:p4W null idle | resp agent_get_w3X:p4W 2 0
  agent_get_json w3X:p4W dddddddd-1111-2222-3333-555555555555 idle | resp agent_get_w3X:p4W 3 0
}
WT="$REPO/.worktree/a59-pjworker"
new_world room; lists; start_happy; new_session
run start a59-pjworker --cwd "$WT"
check "S1 a clean split start: rc 0, verified pj" '[ "$RC" -eq 0 ] && [ "$(j .result)" = "pass " ]'
check "S1b the name is READ from the registry, and not doubled (worktree a59-pjworker + name a59-pjworker)" '[ "$(j .session_name)" = "fifty-shades-of-dotfiles-main-a59-pjworker " ]'
check "S1c the launch line: cd to --cwd, the chosen name, pj --profile default" \
  'grep -qxF "pane run w3X:p4W  builtin cd -- $WT && CLAUDE_CODE_SESSION_NAME=fifty-shades-of-dotfiles-main-a59-pjworker pj --profile default" "$FAKE/calls"'
check "S1d the handshake line never contains its own sentinel (only printf joins it)" \
  'l="$(grep "^pane run w3X:p4W .*PJWREADY" "$FAKE/calls")"; [ -n "$l" ] && ! has "$l" "PJWREADY-" && has "$l" "clear;"'
check "S1e split, not --pane: one split of the CALLING pane, --no-focus, --cwd" \
  'grep -qxF "pane split --pane w3X:p48 --direction right --cwd $WT --no-focus" "$FAKE/calls"'
check "S1f the herdr agent is renamed to the worker name" 'grep -qx "agent rename w3X:p4W a59-pjworker" "$FAKE/calls"'
check "S1g the name was computed in --cwd with the conductor's pj variables unset (rt1 H5)" \
  'grep -q "^cwd=$WT PJ_PROFILE=<unset> PJ_SESSION_NAME=<unset> CCSN=<unset> CCD=<unset> .*--dry-run-env\$" "$FAKE/pj.calls"'
check "S1h the start is logged with kind, name, pane, pid and result" \
  'grep -q "kind=pj name=a59-pjworker session_name=fifty-shades-of-dotfiles-main-a59-pjworker pane=w3X:p4W pid=41000 .* result=pass by=fifty-shades-of-dotfiles-main" "$STATE/workers.log"'
check "S1i the tool itself ran no claude" '[ ! -e "$FAKE/claude.calls" ]'
new_world room; lists; agent_get_json w3X:p4S $S_HOOK working a59-hook | resp agent_get_a59-hook 1 0
run start a59-hook --cwd "$REPO/.worktree/a59-hook"
check "S2 a live herdr agent already has the name: rc 7, nothing split" '[ "$RC" -eq 7 ] && [ "$(ncalls "^pane split")" = 0 ]'
new_world room; lists; start_happy
mkdir -p "$ROOT/code/elsewhere"; reg "$SESS" 42000 eeeeeeee-1111-2222-3333-666666666666 "$ROOT/code/elsewhere" fifty-shades-of-dotfiles-main-a59-pjworker "$T_W"; psrow 42000 claude "$T_W"
run start a59-pjworker --cwd "$WT"
check "S3 a live SESSION already holds the session name (rt1 H3): rc 7, nothing split, the holder named" '[ "$RC" -eq 7 ] && [ "$(ncalls "^pane split")" = 0 ] && has "$ERR" "pid 42000"'
new_world; lists; start_happy
run start a59-pjworker --cwd "$WT"
check "S4 project at 4: start refused, rc 6, nothing split or typed" '[ "$RC" -eq 6 ] && [ "$(ncalls "^pane [rs][ue]")" = 0 ]'
check "S4b the refusal names the cap, No override, and EVERY session counted (name, pid)" \
  'has "$ERR" "project cap: 4 of 4" && has "$ERR" "No override" && has "$ERR" "fifty-shades-of-dotfiles-main  pid 1610" && has "$ERR" "a59-paneguard  pid 36920" && has "$ERR" "a59-pjworker  pid 36921" && has "$ERR" "a59-hook  pid 36922"'
check "S4c the refusal is logged" 'grep -q "name=a59-pjworker result=refused-cap" "$STATE/workers.log"'
new_world room; lists; start_happy
for p in 50001 50002 50003 50004; do mkdir -p "$ROOT/code/other$p"; reg "$SESS" $p "0000$p-aaaa-bbbb-cccc-000000000000" "$ROOT/code/other$p" "other$p-main" "$T_W"; psrow $p claude "$T_W"; done
run start a59-pjworker --cwd "$WT"
check "S4d machine at 8 (project 3): refused by the machine cap, rc 6, nothing typed" '[ "$RC" -eq 6 ] && has "$ERR" "machine cap: 8 of 8" && [ "$(ncalls "^pane [rs][ue]")" = 0 ]'
new_world room; lists; start_happy; touch "$FAKE/SANDBOX"
run start a59-pjworker --cwd "$WT"
check "S5 sandboxed herdr: rc 2, never 'free', nothing split" '[ "$RC" -eq 2 ] && [ "$(ncalls "^pane split")" = 0 ]'
new_world room; lists; start_happy; touch "$FAKE/SANDBOX_PS"
run start a59-pjworker --cwd "$WT"
check "S5b sandboxed ps: rc 2 before anything is split" '[ "$RC" -eq 2 ] && [ "$(ncalls "^pane split")" = 0 ]'
new_world room; lists; start_happy; agent_get_json w3X:p4W null blocked | resp agent_get_w3X:p4W 2 0
printf '%s\n' "$TRUST_SCREEN" | resp pane_read_w3X:p4W 1 0
run start a59-pjworker --cwd "$WT"
check "S6 the new session sits at the trust dialog: rc 3, the dialog named, nothing answered" \
  '[ "$RC" -eq 3 ] && has "$ERR" "Yes, I trust this folder" && [ "$(ncalls "^pane send-keys")" = 0 ]'
new_world room; lists; start_happy; printf '%s\n' "$WAIT_TIMEOUT" | resp pane_wait-output_w3X:p4W 1 1
run start a59-pjworker --cwd "$WT"
check "S7 the pane never answered the handshake: rc 5, exactly one line typed into it" '[ "$RC" -eq 5 ] && [ "$(ncalls "^pane run w3X:p4W")" = 1 ]'
new_world room; lists; printf '%s\n' "$NOTFOUND" | resp agent_get_a59-pjworker 1 1; agent_get_json w3X:p4N $S_PW idle x | resp agent_get_w3X:p4N 1 0
run start a59-pjworker --cwd "$WT" --pane w3X:p4N
check "S8 --pane onto a pane hosting an agent: rc 8, nothing typed" '[ "$RC" -eq 8 ] && [ "$(ncalls "^pane run")" = 0 ]'
new_world room; lists; printf '%s\n' "$NOTFOUND" | resp agent_get_a59-pjworker 1 1; printf '%s\n' "$NOTFOUND" | resp agent_get_w3X:p4N 1 1
process_info_json w3X:p4N 36921 | resp pane_process-info_w3X:p4N 1 0
run start a59-pjworker --cwd "$WT" --pane w3X:p4N
check "S8b --pane with claude in the foreground (not yet an agent): rc 8, nothing typed" '[ "$RC" -eq 8 ] && [ "$(ncalls "^pane run")" = 0 ]'
new_world room; lists; printf '%s\n' "$NOTFOUND" | resp agent_get_a59-pjworker 1 1; printf '%s\n' "$NOTFOUND" | resp agent_get_w3X:p4N 1 1
printf '%s\n' "$BUSY_SHELL" | resp pane_process-info_w3X:p4N 1 0
run start a59-pjworker --cwd "$WT" --pane w3X:p4N
check "S8c --pane on a busy shell (sleep 45): rc 8, nothing typed" '[ "$RC" -eq 8 ] && [ "$(ncalls "^pane run")" = 0 ]'
new_world room; lists; start_happy; new_session
printf '%s\n' "$IDLE_SHELL" | resp pane_process-info_w3X:p4W 1 0; process_info_json w3X:p4W 41000 | resp pane_process-info_w3X:p4W 2 0
printf '%s\n' "$NOTFOUND" | resp agent_get_w3X:p4W 2 1
run start a59-pjworker --cwd "$WT" --pane w3X:p4W
check "S8d --pane on an idle shell: ctrl+c first, no split, then started and verified" \
  '[ "$RC" -eq 0 ] && grep -qx "pane send-keys w3X:p4W ctrl+c" "$FAKE/calls" && [ "$(ncalls "^pane split")" = 0 ]'
new_world room; lists; start_happy; printf '%s\n' "$IDLE_SHELL" | resp pane_process-info_w3X:p4W 1 0
printf '%s\n%s\n' "$GUARD_LINE" '~/code/fifty-shades-of-dotfiles/.worktree/a59-pjworker $' | resp pane_read_w3X:p4W 1 0
run start a59-pjworker --cwd "$WT"
check "S9 the pane guard refused the launch: rc 4, 'REFUSED BY THE PANE GUARD' named" '[ "$RC" -eq 4 ] && has "$ERR" "REFUSED BY THE PANE GUARD"'
new_world room; lists; start_happy; printf '%s\n' "$IDLE_SHELL" | resp pane_process-info_w3X:p4W 1 0
printf '%s\n' 'pj: REFUSED: pj-prompt-file printed no system-prompt file; run pj-prompt-file --selftest' | resp pane_read_w3X:p4W 1 0
run start a59-pjworker --cwd "$WT"
check "S9b control: a launch that died for another reason is NOT blamed on the guard" '[ "$RC" -eq 4 ] && ! has "$ERR" "PANE GUARD" && has "$ERR" "launch ended"'
new_world room; lists; RUN_HERDR_ENV="" run start a59-pjworker --cwd "$WT"
check "S10 outside a herdr pane: rc 2, no herdr call" '[ "$RC" -eq 2 ] && has "$ERR" "not inside a herdr pane" && [ "$(ncalls "^[ap][ga]")" = 0 ]'
new_world room; lists; start_happy; new_session "$PLAIN"; psenv 41000 w3X:p4W - "$PLAIN"
run start a59-pjworker --cwd "$WT"
check "S11 the started session verifies as NOT pj: rc 1, the pane named for closing" '[ "$RC" -eq 1 ] && has "$ERR" "herdr pane close w3X:p4W"'
new_world room; lists; start_happy; new_session; printf '%s\n' "$WAIT_OK" | resp pane_wait-output_w3X:p4W 2 0
run start a59-pjworker --cwd "$WT" --probe
check "S12 --probe: a prompt goes out and a reversed word is awaited that the prompt does not contain" \
  'p="$(grep "^agent prompt a59-pjworker" "$FAKE/calls")"; w="$(grep "^pane wait-output w3X:p4W --match eborp" "$FAKE/calls" | sed "s/.*--match \([^ ]*\).*/\1/")"; [ "$RC" -eq 0 ] && [ -n "$p" ] && [ -n "$w" ] && ! has "$p" "$w"'
new_world room; lists; start_happy; new_session; printf '%s\n' "$WAIT_TIMEOUT" | resp pane_wait-output_w3X:p4W 2 1
run start a59-pjworker --cwd "$WT" --probe
