#!/usr/bin/perl
# ============================================================================
#  speak-relay -- let a remote box press the Mac's speak keys
# ============================================================================
# Gavin, dotfiles-main Q22 (v2): 1, 2026-10-16; reworked the same night to the
# Mac-collects design (dotfiles-main Q26 / NP-2 Q4: 3).
#
# Why: a herdr key runs its command on the herdr SERVER. In a `herdr --remote`
# tab the server is codebox (Linux), so the speak keys ran speak-clipboard
# there: no Mac voice, nobody listening. Now speak-clipboard on a non-Mac box
# writes the key's words to a queue file there, and this Mac fetches them and
# speaks its own clipboard, which holds the copy (Q21: Claude in a herdr pane
# copies through the terminal, so a remote drag lands on this Mac's clipboard).
#
# How the words get here: this Mac logs in to each box with plain ssh and
# runs `tail -F` on the queue file. The box never opens anything back to the
# Mac: codebox's lockdown allows no reverse forward (Network_Plan CB D-008),
# and Gavin kept it (NP-2 Q4: 3). The first try, a port forward back to the
# Mac on 8888, was refused by codebox's sshd and is gone.
#
# What it accepts: a queue line "<epoch seconds> <words>", where the words are
# exactly one of the nine speak-key commands in home/.config/herdr/config.toml
# and the line is at most 15 s old (a stalled link must not replay a burst).
# It runs `speak-clipboard <those words>` in the background, with no shell.
# Also accepted (Gavin, dotfiles-main Q43 (v2): 1, 16 Oct): the four fixed alert
# shapes of speak-alert, matched EXACTLY by alert_args below:
#   --alert ci-red <label>             --alert ci-reminder <days> <label>
#   --alert ccw-unconfirmed            --alert ccw-reminder <days>
# (<label> 1-60 of A-Za-z0-9 . _ / @ - and space, not starting with space or -;
# <days> 1-4 digits). It runs `speak-alert <kind> <fields>` with no shell, and
# speak-alert builds the words on the Mac, so a box can never choose the text.
# Anything else is logged as refused and runs nothing.
#
#   speak-relay              run the fetcher (launchd runs it, see --install)
#   speak-relay --install    write the LaunchAgent and start it
#   speak-relay --uninstall  stop it and trash the LaunchAgent
#   speak-relay --status     is it loaded, and is each box connected
#   speak-relay --check-line WORDS   what a queue line would run; runs nothing
#
# Boxes: SPEAK_RELAY_HOSTS (space-separated ssh names), default codebox.lan.
# Log: ~/.local/state/herdr/speak-relay.log, one line per event.
# ============================================================================
use strict;
use warnings;
use POSIX ();

my $home   = $ENV{HOME} or die "speak-relay: HOME is not set\n";
my $speak  = $ENV{SPEAK_RELAY_SPEAK} || "$home/.local/bin/speak-clipboard";
my $alert  = $ENV{SPEAK_RELAY_ALERT} || "$home/.local/bin/speak-alert";
my $state  = $ENV{SPEAK_RELAY_STATE} || "$home/.local/state/herdr";
my $log    = "$state/speak-relay.log";
my @hosts  = split ' ', ($ENV{SPEAK_RELAY_HOSTS} || 'codebox.lan');
my $maxage = 15;
my $label  = 'com.captaincodeau.speak-relay';
my $plist  = "$home/Library/LaunchAgents/$label.plist";

# The queue file on the box. speak-clipboard's relay block writes the same path.
my $queue  = '~/.local/state/herdr/speak-relay.queue';

# The nine speak-key commands, word for word as config.toml runs them.
my %allowed = map { $_ => 1 } (
    '--toggle', '--skip', '--stop',
    '--set rate -20', '--set rate +20',
    '--set volume -10', '--set volume +10',
    '--notify --settings', '--reset all',
);

# speak-alert's four shapes, whole line, nothing more (speak-alert checks again).
my $LABEL = qr{[A-Za-z0-9._/\@][A-Za-z0-9._/\@ -]{0,59}};
sub alert_args {
    my ($w) = @_;
    return ('ci-red', $1)             if $w =~ /\A--alert ci-red ($LABEL)\z/;
    return ('ci-reminder', $1, $2)    if $w =~ /\A--alert ci-reminder ([0-9]{1,4}) ($LABEL)\z/;
    return ('ccw-unconfirmed')        if $w eq '--alert ccw-unconfirmed';
    return ('ccw-reminder', $1)       if $w =~ /\A--alert ccw-reminder ([0-9]{1,4})\z/;
    return ();
}

sub stamp { POSIX::strftime('%Y-%m-%dT%H:%M:%SZ', gmtime) }

sub log_line {
    my ($msg) = @_;
    if (open my $fh, '>>', $log) { print $fh stamp(), " $msg\n"; close $fh }
}

# A refused line is logged as printable text only, at most 60 characters.
sub shown {
    my ($s) = @_;
    $s =~ s/[^\x20-\x7e]/?/g;
    $s = substr($s, 0, 60) . '...' if length $s > 60;
    return "'$s'";
}

# The command that streams one box's queue. SPEAK_RELAY_FETCH replaces it in
# a test ("%h" becomes the host name); it is run with sh -c.
sub fetch_argv {
    my ($host) = @_;
    if (my $t = $ENV{SPEAK_RELAY_FETCH}) {
        (my $cmd = $t) =~ s/%h/$host/g;
        return ('/bin/sh', '-c', $cmd);
    }
    # The queue-only key (Q29: 1), used alone when it exists: no agent, so
    # the login behaves the same before and after a Mac reboot. It has no
    # passphrase; the box's authorized_keys pins it to the same tail command
    # as below, with `restrict`, so it can do nothing else (proved 16 Oct:
    # `id` through it printed nothing, the tail ran instead). With no such
    # key file, the entry's usual key (through the agent) is used.
    my ($short) = $host =~ /^([^.]+)/;
    my $key = $ENV{SPEAK_RELAY_KEY} || "$home/.ssh/$short-speak-relay";
    my @key = -r $key
        ? ('-i', $key, '-o', 'IdentitiesOnly=yes', '-o', 'IdentityAgent=none')
        : ();
    return ('ssh', '-T', '-o', 'BatchMode=yes', '-o', 'ConnectTimeout=10',
            '-o', 'ServerAliveInterval=15', '-o', 'ServerAliveCountMax=2',
            # No forwards on this login, whatever the config entry asks for.
            '-o', 'ClearAllForwardings=yes',
            @key, $host,
            "mkdir -p ~/.local/state/herdr && touch $queue && exec tail -n0 -F $queue");
}

sub speak_now {
    my ($argv, $host) = @_;
    my $pid = fork;
    return "fork: $!" unless defined $pid;
    if ($pid == 0) {
        POSIX::setsid();
        my $grand = fork;
        POSIX::_exit(0) if !defined $grand || $grand;
        open STDIN,  '<', '/dev/null';
        open STDOUT, '>', '/dev/null';
        open STDERR, '>', '/dev/null';
        # Who pressed, for speak-clipboard's log (Q35: 1).
        $ENV{SPEAK_SOURCE} = "speak-relay:$host";
        { no warnings 'exec'; exec { $argv->[0] } @$argv; }
        POSIX::_exit(127);
    }
    waitpid($pid, 0);
    return '';
}

# The program and arguments a queue line's words would run, or () to refuse.
sub plan_for {
    my ($words) = @_;
    return ($speak, split(/ /, $words)) if $allowed{$words};
    my @a = alert_args($words);
    return @a ? ($alert, @a) : ();
}

# One line from a box's queue: run it, or say why not.
sub handle {
    my ($host, $line) = @_;
    $line =~ s/\r?\n\z//;
    my ($when, $words) = $line =~ /^(\d{9,11}) (.+)$/ ? ($1, $2) : (undef, undef);
    my @argv = defined $words ? plan_for($words) : ();
    if (!@argv) {
        log_line("$host refused " . shown($line));
        return;
    }
    my $age = time - $when;
    if ($age > $maxage || $age < -$maxage) {
        log_line("$host stale '$words' (${age}s old)");
        return;
    }
    my $err = speak_now(\@argv, $host);
    log_line($err ? "$host failed '$words' ($err)" : "$host ran '$words'");
}

# Keep one fetch running per box; a dropped link is retried, slower each time
# up to a minute, and at once again after it has stayed up a while.
my $fetch_pid = 0;

sub watch_host {
    my ($host) = @_;
    my $wait = 5;
    # A stop ends this box's ssh login too, not just the watcher.
    $SIG{TERM} = sub { kill 'TERM', $fetch_pid if $fetch_pid; POSIX::_exit(0) };
    while (1) {
        my $started = time;
        my $pid = open(my $in, '-|');
        if (!defined $pid) { log_line("$host cannot fork: $!"); sleep 30; next }
        $fetch_pid = $pid if $pid;
        if ($pid == 0) {
            open STDERR, '>>', "$state/speak-relay.err";
            my @argv = fetch_argv($host);
            { no warnings 'exec'; exec { $argv[0] } @argv; }
            POSIX::_exit(127);
        }
        log_line("$host connecting (pid $pid)");
        while (my $line = <$in>) { handle($host, $line) }
        close $in;
        my $rc = $? >> 8;
        $wait = 5 if time - $started > 120;
        log_line("$host link ended (exit $rc); retrying in ${wait}s");
        sleep $wait;
        $wait = $wait * 2 > 60 ? 60 : $wait * 2;
    }
}

sub install {
    my $self = $0 =~ m{^/} ? $0 : "$home/.local/bin/speak-relay";
    my $path = "/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:$home/.local/bin";
    system('mkdir', '-p', "$home/Library/LaunchAgents", $state);
    open my $fh, '>', $plist or die "speak-relay: cannot write $plist: $!\n";
    print $fh <<"PLIST";
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key><string>$label</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/perl</string>
        <string>$self</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key><string>$path</string>
        <key>LANG</key><string>en_AU.UTF-8</string>
    </dict>
    <key>RunAtLoad</key><true/>
    <key>KeepAlive</key><true/>
    <key>ThrottleInterval</key><integer>10</integer>
    <key>StandardErrorPath</key><string>$state/speak-relay.err</string>
</dict>
</plist>
PLIST
    close $fh;
    system("launchctl bootout gui/$</$label >/dev/null 2>&1");
    if (system('launchctl', 'bootstrap', "gui/$<", $plist) != 0) {
        die "speak-relay: launchctl bootstrap failed; run it by hand to see why:\n"
          . "  launchctl bootstrap gui/$< $plist\n";
    }
    print "speak-relay: installed and started ($plist), boxes: @hosts\n";
    exit 0;
}

sub uninstall {
    system("launchctl bootout gui/$</$label >/dev/null 2>&1");
    if (-e $plist) {
        # The Trash shim by its full path: a bare 'rm' on a PATH without
        # ~/.local/bin would be the permanent deleter.
        my $trash_rm = "$home/.local/bin/rm";
        -x $trash_rm or die "speak-relay: $trash_rm (the Trash shim) is missing; trash $plist in Finder\n";
        system($trash_rm, $plist) == 0 or die "speak-relay: could not trash $plist\n";
    }
    print -e $plist ? "speak-relay: $plist is STILL there\n" : "speak-relay: stopped, LaunchAgent trashed\n";
    exit(-e $plist ? 1 : 0);
}

sub status {
    my $loaded = system("launchctl print gui/$</$label >/dev/null 2>&1") == 0;
    print 'launchd: ', ($loaded ? "loaded ($label)" : 'NOT loaded'), "\n";
    my %last;
    if (open my $fh, '<', $log) {
        while (<$fh>) { $last{$1} = $_ if /^\S+ (\S+) (?:connecting|link ended)/ }
    }
    for my $h (@hosts) {
        my $l = $last{$h} // "no record yet\n";
        print "$h: last event: $l";
    }
    exit($loaded ? 0 : 1);
}

if (@ARGV) {
    my $a = shift @ARGV;
    install()   if $a eq '--install';
    uninstall() if $a eq '--uninstall';
    status()    if $a eq '--status';
    # --check-line WORDS: what a queue line's words would run, one argument per
    # line, or "refused". Runs nothing (speak-alert-selftest uses it).
    if ($a eq '--check-line') {
        my @p = plan_for(join(' ', @ARGV));
        print @p ? join("\n", map { $_ eq $speak ? 'speak-clipboard' : $_ eq $alert ? 'speak-alert' : "[$_]" } @p) . "\n" : "refused\n";
        exit 0;
    }
    if ($a eq '--help' || $a eq '-h') {
        open my $me, '<', $0 or die; while (<$me>) { next if $. == 1; last if /^use strict/; print if s/^# ?// }
        exit 0;
    }
    die "speak-relay: unknown option '$a' (try --help)\n";
}

system('mkdir', '-p', $state);
log_line("start pid=$$ boxes=@hosts");
my %kids;
$SIG{TERM} = sub { kill 'TERM', keys %kids; exit 0 };
for my $h (@hosts) {
    my $pid = fork;
    die "speak-relay: cannot fork for $h: $!\n" unless defined $pid;
    if ($pid == 0) { watch_host($h); POSIX::_exit(0) }
    $kids{$pid} = $h;
}
# If a watcher dies, launchd restarts the whole job.
my $gone = wait;
log_line("watcher for " . ($kids{$gone} // '?') . " stopped; exiting for launchd to restart");
kill 'TERM', keys %kids;
exit 1;
