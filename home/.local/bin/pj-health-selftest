# 1c-GNU. THE SAME FACTS IN LINUX SHAPE (P8a gate Q3). procps differs from BSD ps twice, and
# both differences are silent: lstart prints "Mon Sep 21" (month first) where BSD prints
# "Mon 21 Sep", and a process with no terminal shows "?" where BSD shows "??". The old
# fixture was BSD-only, so neither could ever fail here. Same five rows, procps layout.
printf '%s\n' \
  '  501   870 pts/0    Mon Sep 21 12:32:38 2026     -zsh' \
  '  502   870 pts/1    Mon Sep 21 12:40:00 2026     zsh' \
  '  503   501 pts/0    Mon Sep 21 12:41:00 2026     /bin/zsh -c source snapshot.sh' \
  '  504     1 pts/0    Fri Sep 18 13:05:58 2026     -zsh' \
  '  505   870 ?        Fri Sep 18 13:05:58 2026     -zsh' >"$T/ps"; run
arm "GNU ps: PASS, and the SAME 2 shells counted (zsh -c, ppid 1 and the ?-tty row skipped)" has stale-shells "0 of 2 interactive zsh"
arm "GNU ps: a '?' tty is excluded exactly as BSD's '??' is" is stale-shells PASS
printf '%s\n' '  506   870 pts/3    Fri Sep 18 13:05:58 2026     -zsh' >>"$T/ps"; run
arm "GNU ps: WARN on a shell older than .zshrc" is stale-shells WARN
arm "GNU ps: the date reads the same as under BSD ps, not month-first" has stale-shells "pts/3 pid 506 since 18 Sep 13:05"
arm "GNU ps: counts 1 of 3, same as BSD" has stale-shells "1 of 3 interactive zsh"
cp "$T/ps.ok" "$T/ps"; run; arm "stale-shells back to PASS after the GNU fixture (control)" is stale-shells PASS

