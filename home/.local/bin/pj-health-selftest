arm "bin-strays says why it matters" has bin-strays "versioned nowhere"
# A tool-install link is NOT a stray: uv, bun and claude all link their binaries
# into this directory and none of them belongs in a dotfiles repo.
ln -sfn "$T/home-claude/../fake/.local/share/uv/tools/x/bin/x" "$BIN/a-tool-link"
run
arm "a ~/.local/share tool link is not counted as a stray" not_has bin-strays "a-tool-link"
gone "$BIN/a-real-file"
run
# CONTROL: with the real file gone the row must go GREEN again, and say the count
# positively. Without this, the WARN arms pass equally if the row warns always.
arm "CONTROL: bin-strays returns to PASS once the real file is gone" is bin-strays PASS
arm "CONTROL: the clean row states the count positively" has bin-strays "0 in no repo"
gone "$BIN/a-tool-link"

