#!/usr/bin/env bash
# pj-health-selftest -- prove every pj-health arm against a throwaway fixture tree.
#
# Every check gets a PASS fixture, at least one FAIL fixture where a FAIL exists, and every
# NOT MEASURED reason. The live setup is never touched: every path pj-health reads is
# redirected through its test seams (PJ_HOME, PJ_BIN_DIR, PJ_DOTFILES, PJ_LAUNCHER, PJ_TYPE_OUT,
# PJ_PS_OUT, PJ_ZSHRC_MTIME, PJ_TRANSCRIPTS_DIR, PJ_STATE_DIR) and the seams the other tools already honour
# (PJ_MACHINE_FILE, PJ_PROMPT_SOURCES, PJ_PROMPT_OUT, CLAUDE_PROJECT_SETTINGS_FILE,
# CLAUDE_HOOKS_MANIFEST). Tools pj-health shells out to are FAKES on a PATH prefix, except
# pj-prompt-file, which is the real one (it honours its own seams). The no-write arm
# hashes the fixture tree before and after, with a control that a real write changes it.
#
# Fixture paths are `pwd -P` real paths: /tmp is a symlink on macOS and git's toplevel is
# the real path (P5.2 lesson). Exit 0 all green, 1 otherwise. Nothing under ~ is read.
set -u

PASS=0; FAIL=0
ok(){ PASS=$((PASS+1)); }
bad(){ FAIL=$((FAIL+1)); echo "  FAIL: $*" >&2; }
arm(){   # arm "label" <shell test...>
  local label="$1"; shift
  if "$@"; then ok; else bad "$label"; fi
}

T="$(mktemp -d "${TMPDIR:-/tmp}/pj-health-selftest.XXXXXX")"; T="$(builtin cd "$T" && pwd -P)"
mkdir -p "$T/gone"; GN=0
gone(){ GN=$((GN+1)); command mv "$1" "$T/gone/$GN"; }   # never rm: the Trash wrapper refuses inside a sandbox
REAL_HEALTH="$(readlink -f "$(command -v pj-health)" 2>/dev/null || command -v pj-health)"
REAL_PROMPT="$(readlink -f "$(command -v pj-prompt-file)" 2>/dev/null || command -v pj-prompt-file)"
[ -x "$REAL_HEALTH" ] || { echo "pj-health not on PATH"; exit 1; }

# ----------------------------------------------------------------- fixture ----
DF="$T/dotfiles"; H="$T/home-claude"; BIN="$T/bin"; STATE="$T/state"; PROJ="$T/proj"
mkdir -p "$DF/home/.local/bin" "$DF/home/.claude/hooks" "$DF/home/.claude/pj/.claude-plugin" "$DF/home/.claude/pj/skills/wrap-up" "$DF/settings/claude" \
         "$H/pj-voice/output-styles" "$H/skills/herdr" "$H/skills/AgentRelay" "$H/skills/ISA" "$H/pj/.claude-plugin" "$H/pj/skills/wrap-up" "$H/hooks" \
         "$H/pj-global/decisions" "$H/pj-global/notes" "$H/LIFEOS/USER/CONFIG" "$H/projects" "$BIN" "$STATE/no-wrap-up" "$PROJ/.claude" "$T/cache" "$T/drawer/items"

fake(){   # fake <path> <body>   an executable that runs <body> with "$@"
  printf '#!/usr/bin/env bash\n%s\n' "$2" >"$1"; chmod +x "$1"
}
TOOLS="pj pj-launch-check pj-prompt-file pj-start-card pj-session-end pj-wrap pj-id open-items decided claude-hooks-sync claude-project-settings-render ci-watch ccw-watch pj-health"
for t in $TOOLS; do fake "$DF/home/.local/bin/$t" 'exit 0'; done
# the fake launcher: --dry-run prints the fixture argv (F3), --selftest a pass line
fake "$DF/home/.local/bin/pj" 'case "${1:-}" in --dry-run) cat "$DRYRUN_FILE"; exit $(cat "$DRYRUN_RC" 2>/dev/null || echo 0);; --selftest) echo "11 passed, 0 failed"; exit 0;; esac; exit 0'
fake "$DF/home/.local/bin/pj-launch-check" 'case "${1:-}" in --selftest) echo "20 passed, 0 failed"; exit 0;; esac; exit 0'
cp "$REAL_HEALTH" "$DF/home/.local/bin/pj-health"; cp "$REAL_PROMPT" "$DF/home/.local/bin/pj-prompt-file"; chmod +x "$DF/home/.local/bin/pj-health" "$DF/home/.local/bin/pj-prompt-file"
fake "$DF/home/.local/bin/open-items" 'case "$1" in --where) cat "$OI_WHERE_FILE" 2>/dev/null; exit 0;; esac; exit 0'
fake "$DF/home/.local/bin/decided" 'case "$1" in --list) cat "$DECIDED_LIST_FILE"; exit $(cat "$DECIDED_LIST_RC");; --homes) cat "$DECIDED_HOMES_FILE"; exit 0;; esac; exit 0'
fake "$DF/home/.local/bin/claude-hooks-sync" 'cat "$SYNC_OUT_FILE"; exit 0'
fake "$DF/home/.local/bin/claude-project-settings-render" 'cat "$RENDER_OUT_FILE"; exit $(cat "$RENDER_RC_FILE")'
for s in pj-start-card-selftest pj-session-end-selftest pj-wrap-selftest open-items-selftest decided-selftest claude-hooks-sync-selftest claude-project-settings-render-selftest ccw-watch-selftest ci-watch-selftest pj-health-selftest audit-chain-selftest; do
  fake "$DF/home/.local/bin/$s" 'echo "7 passed, 0 failed"; exit 0'
done
fake "$DF/home/.local/bin/pj-id" 'echo "all 9 arms pass"; exit 0'
for h in enforce-secret-probe.sh enforce-census.sh enforce-herdr-skill.sh mark-herdr-skill-read.sh validate-bash.sh enforce-uv.sh enforce-pnpm.sh; do
  fake "$DF/home/.claude/hooks/$h" 'echo "ALL ARMS PASS"; exit 0'
done
echo '{"name":"pj","version":"0.1.0"}' >"$DF/home/.claude/pj/.claude-plugin/plugin.json"
printf -- '---\nname: wrap-up\n---\n# wrap-up\n' >"$DF/home/.claude/pj/skills/wrap-up/SKILL.md"
for t in $TOOLS pj-start-card-selftest pj-session-end-selftest pj-wrap-selftest open-items-selftest decided-selftest claude-hooks-sync-selftest claude-project-settings-render-selftest ccw-watch-selftest ci-watch-selftest pj-health-selftest audit-chain-selftest; do
  ln -s "$DF/home/.local/bin/$t" "$BIN/$t"
done
for h in enforce-secret-probe.sh enforce-census.sh enforce-herdr-skill.sh mark-herdr-skill-read.sh validate-bash.sh enforce-uv.sh enforce-pnpm.sh; do ln -s "$DF/home/.claude/hooks/$h" "$H/hooks/$h"; done
ln -s "$DF/home/.claude/pj/.claude-plugin/plugin.json" "$H/pj/.claude-plugin/plugin.json"
ln -s "$DF/home/.claude/pj/skills/wrap-up/SKILL.md" "$H/pj/skills/wrap-up/SKILL.md"
echo "# style" >"$H/pj-voice/output-styles/pj-voice.md"
for s in herdr AgentRelay ISA; do echo "# $s" >"$H/skills/$s/SKILL.md"; done
OR="$H/LIFEOS/USER/CONFIG/OPERATIONAL_RULES.md"; RULES="$H/pj-global/RULES.md"
printf '# OPERATIONAL_RULES.md fixture\n- rule one\n' >"$OR"
{ echo "# pj-global RULES.md: fixture header line"; for i in $(seq 1 20); do echo "- pinned $i"; done; } >"$RULES"
echo "- [x](y): z" >"$H/pj-global/notes/INDEX.md"; echo "## D-20260101-01 -- x" >"$H/pj-global/decisions/D-20260101-01-x.md"
printf 'name: fixture\nletter: A\n' >"$T/machine"
printf 'project: p\nrepo: r\nended: t\nsession: s1\ntranscript: x\n\nproject: p\nrepo: r\nended: t\nsession: s2\ntranscript: y\n' >"$STATE/no-wrap-up/-tmp-proj"
# the launcher fixtures (F3): a dry-run argv, what `whence -w pj; alias pj` prints, a ps listing, a .zshrc mtime
printf '%s\n' claude --setting-sources project,local --settings "$HOME/.claude/settings.project.json" --append-system-prompt-file "$T/cache/prompt.md" \
  --plugin-dir "$HOME/.claude/skills/herdr" --plugin-dir "$HOME/.claude/skills/AgentRelay" --plugin-dir "$HOME/.claude/skills/ISA" --plugin-dir "$HOME/.claude/pj-voice" --plugin-dir "$HOME/.claude/pj" \
  --dangerously-skip-permissions --effort high >"$T/dryrun"; cp "$T/dryrun" "$T/dryrun.ok"
printf 'pj: command\n' >"$T/type-out"; cp "$T/type-out" "$T/type-out.ok"
ZMT="$(date -j -f '%Y-%m-%d %H:%M:%S' '2026-09-21 01:00:00' +%s 2>/dev/null || date -d '2026-09-21 01:00:00' +%s)"
# ps fixture: pid ppid tty lstart(5 fields) command. Two fresh panes, one `zsh -c` (skipped), one ppid-1 fork (skipped)
printf '%s\n' \
  '  501   870 ttys001  Mon 21 Sep 12:32:38 2026     -zsh' \
  '  502   870 ttys002  Mon 21 Sep 12:40:00 2026     zsh' \
  '  503   501 ttys001  Mon 21 Sep 12:41:00 2026     /bin/zsh -c source snapshot.sh' \
  '  504     1 ttys001  Fri 18 Sep 13:05:58 2026     -zsh' \
  '  505   870 ??       Fri 18 Sep 13:05:58 2026     -zsh' >"$T/ps"; cp "$T/ps" "$T/ps.ok"
printf 'ts=2026-09-21T12:34:06+1000 session=s1 project=p tty=ttys009 shell_start=2026-09-21T12:32:38 zshrc_mtime=2026-09-21T01:00:52 result=ok\nts=2026-09-21T12:50:00+1000 session=s2 project=p tty=ttys009 shell_start=2026-09-21T12:32:38 zshrc_mtime=2026-09-21T01:00:52 result=ok\n' >"$STATE/launches.log"; cp "$STATE/launches.log" "$T/launches.ok"
cat >"$DF/settings/claude/hooks.json" <<'EOF'
{"hooks":[
 {"event":"PreToolUse","matcher":"Bash","script":"enforce-secret-probe.sh","targets":["user","project"],"entry":{"type":"command","command":"$HOME/.claude/hooks/enforce-secret-probe.sh"}},
 {"event":"PreToolUse","matcher":"Bash","script":"enforce-census.sh","targets":["user","project"],"entry":{"type":"command","command":"$HOME/.claude/hooks/enforce-census.sh"}},
 {"event":"PreToolUse","matcher":"Grep","script":"enforce-census.sh","targets":["user","project"],"entry":{"type":"command","command":"$HOME/.claude/hooks/enforce-census.sh"}},
 {"event":"PreToolUse","matcher":"Bash","script":"enforce-herdr-skill.sh","targets":["user","project"],"entry":{"type":"command","command":"$HOME/.claude/hooks/enforce-herdr-skill.sh"}},
 {"event":"PostToolUse","matcher":"Skill","script":"mark-herdr-skill-read.sh","targets":["user","project"],"entry":{"type":"command","command":"$HOME/.claude/hooks/mark-herdr-skill-read.sh"}},
 {"event":"SessionStart","script":"ci-watch","script_path":"$HOME/.local/bin/ci-watch","targets":["user","project"],"entry":{"type":"command","command":"test -x \"$HOME/.local/bin/ci-watch\" && \"$HOME/.local/bin/ci-watch\" || true"}},
 {"event":"SessionStart","script":"pj-start-card","script_path":"$HOME/.local/bin/pj-start-card","targets":["project"],"entry":{"type":"command","command":"test -x \"$HOME/.local/bin/pj-start-card\" && \"$HOME/.local/bin/pj-start-card\" || true"}},
 {"event":"SessionEnd","script":"pj-session-end","script_path":"$HOME/.local/bin/pj-session-end","targets":["project"],"entry":{"type":"command","command":"test -x \"$HOME/.local/bin/pj-session-end\" && \"$HOME/.local/bin/pj-session-end\" || true"}},
 {"event":"PreToolUse","matcher":"Bash","script":"validate-bash.sh","targets":["project"],"entry":{"type":"command","command":"test -x \"$HOME/.claude/hooks/validate-bash.sh\" && \"$HOME/.claude/hooks/validate-bash.sh\" || true"}},
 {"event":"SessionStart","script":"only-user","script_path":"$HOME/.local/bin/nowhere","entry":{"type":"command","command":"$HOME/.local/bin/nowhere"}}
]}
EOF
# settings.project.json: $HOME paths point at the fixture hooks through the PJ_LAUNCHER fixture-mode rewrite
write_settings(){   # write_settings [extra-jq-filter]
  jq -n '{outputStyle:"pj-voice:pj-voice", hooks:{
    PreToolUse:[{matcher:"Bash",hooks:[{type:"command",command:"$HOME/.claude/hooks/enforce-secret-probe.sh"},{type:"command",command:"$HOME/.claude/hooks/enforce-census.sh"},{type:"command",command:"$HOME/.claude/hooks/enforce-herdr-skill.sh"},{type:"command",command:"test -x \"$HOME/.claude/hooks/validate-bash.sh\" && \"$HOME/.claude/hooks/validate-bash.sh\" || true"}]},{matcher:"Grep",hooks:[{type:"command",command:"$HOME/.claude/hooks/enforce-census.sh"}]}],
    PostToolUse:[{matcher:"Skill",hooks:[{type:"command",command:"$HOME/.claude/hooks/mark-herdr-skill-read.sh"}]}],
    SessionStart:[{hooks:[{type:"command",command:"test -x \"$HOME/.local/bin/ci-watch\" && \"$HOME/.local/bin/ci-watch\" || true"},{type:"command",command:"test -x \"$HOME/.local/bin/pj-start-card\" && \"$HOME/.local/bin/pj-start-card\" || true"}]}],
    SessionEnd:[{hooks:[{type:"command",command:"test -x \"$HOME/.local/bin/pj-session-end\" && \"$HOME/.local/bin/pj-session-end\" || true"}]}]}}' \
  | jq "${1:-.}" >"$H/settings.project.json"
}
write_settings
# project repo
git -C "$PROJ" init -q 2>/dev/null; git -C "$PROJ" -c user.name=t -c user.email=t@t commit -q --allow-empty -m init 2>/dev/null
TOP="$(git -C "$PROJ" rev-parse --show-toplevel)"; KEY="$(printf '%s' "$TOP" | sed 's#[/._]#-#g')"
mkdir -p "$H/projects/$KEY"
printf 'records: private\nhandoff: drawer:OPENING-PROMPT.md\ndecisions: drawer:decisions/\ntracker: repo:TRACK.md\n' >"$PROJ/.claude/pj-homes"
echo "# track" >"$PROJ/TRACK.md"; mkdir -p "$T/drawer/decisions"
echo '{"hooks":{"PreToolUse":[{"matcher":"Bash","hooks":[{"type":"command","command":"\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/local.sh"}]}]}}' >"$PROJ/.claude/settings.json"
echo "$T/drawer/OPEN.md" >"$T/oi-where"
echo "# view" >"$T/drawer/OPEN.md"; shasum -a 256 "$T/drawer/OPEN.md" | cut -d' ' -f1 >"$T/drawer/items/.generated.sha256"
echo "decided: 1 decision(s) searched (machine-wide 1)." >"$T/decided-list"; echo 0 >"$T/decided-list-rc"
printf 'machine-wide   folder   ~/x/decisions   (~/x)\nproject (drawer:decisions)   folder   ~/y   (declared in .claude/pj-homes)\n' >"$T/decided-homes"
printf '  + pj settings: already current.\n' >"$T/render-out"; echo 0 >"$T/render-rc"
printf '! claude-hooks-sync: x is not writable from here.\n' >"$T/sync-out"
# transcripts: newest a (interactive), then b, c, d (baseline window), plus e (sdk-cli, newest of all, must be skipped)
mk_transcript(){   # mk_transcript <file> <first_turn_tokens> [card_n] [ci_n] [rules 0|1] [plugins 0|1] [entrypoint] [snapshot 0|1]
  local f="$1" tok="$2" card="${3:-1}" ci="${4:-1}" rules="${5:-1}" plug="${6:-1}" ep="${7:-cli}" snap="${8:-1}"
  local marker; marker="$(head -1 "$RULES" | cut -c1-60)"; [ "$rules" -eq 1 ] || marker="no rules here"
  {
    echo "{\"type\":\"user\",\"entrypoint\":\"$ep\",\"message\":{\"role\":\"user\",\"content\":\"hello\"}}"
    [ "$plug" -eq 1 ] && echo '{"type":"attachment","attachment":{"type":"skill_listing","text":"herdr:herdr AgentRelay:AgentRelay ISA:ISA pj:wrap-up"}}'
    for i in $(seq 1 "$card"); do echo '{"type":"attachment","attachment":{"type":"hook_success","hookName":"SessionStart:startup","stdout":"pj start card: proj\nOpen items: 0\n"}}'; done
    for i in $(seq 1 "$ci"); do echo '{"type":"attachment","attachment":{"type":"hook_success","hookName":"SessionStart:startup","stdout":"CI watch (live)\n"}}'; done
    echo '{"type":"attachment","attachment":{"type":"output_style","style":"pj-voice:pj-voice"}}'
    [ "$snap" -eq 1 ] && jq -nc --arg m "$marker" '{type:"attachment",attachment:{type:"prompt_snapshot",systemPrompt:["harness","# OPERATIONAL_RULES.md\n- rule one\n"+$m+"\n- pinned 1"]}}'
    jq -nc --argjson t "$tok" '{type:"assistant",message:{usage:{input_tokens:2,cache_creation_input_tokens:$t,cache_read_input_tokens:0,output_tokens:10}}}'
  } >"$f"
}
mk_transcript "$H/projects/$KEY/d.jsonl" 50000; sleep 0.01
mk_transcript "$H/projects/$KEY/c.jsonl" 52000; sleep 0.01
mk_transcript "$H/projects/$KEY/b.jsonl" 54000; sleep 0.01
mk_transcript "$H/projects/$KEY/a.jsonl" 55000; sleep 0.01
mk_transcript "$H/projects/$KEY/e.jsonl" 999999 1 1 1 1 sdk-cli   # -p probe: newest, must be skipped

# commit-trailer fixture (F4). Two throwaway repos, because the row READS GIT and a
# fixture file would test the parser without testing the read. trailer_state rewrites
# the newest commit message in place; the three states are the three the row separates.
TR_A="$T/trrepo-a"; TR_B="$T/trrepo-b"
trailer_repo(){   # trailer_repo <dir>
  mkdir -p "$1"; git -C "$1" init -q -b main >/dev/null 2>&1
  git -C "$1" config user.email selftest@example.invalid; git -C "$1" config user.name selftest
  git -C "$1" config core.hooksPath /dev/null    # never the operator's own hook chain
  printf 'x\n' >"$1/f.txt"; git -C "$1" add f.txt >/dev/null 2>&1
  git -C "$1" commit -q --no-verify -m "seed" >/dev/null 2>&1
}
trailer_state(){   # trailer_state <dir> filled|empty|absent
  local m="work"
  case "$2" in
    filled) m="$m

C-Sess-Id: 11111111-2222-3333-4444-555555555555" ;;
    empty)  m="$m

C-Sess-Id:" ;;
  esac
  git -C "$1" -c core.hooksPath=/dev/null commit -q --no-verify --amend -m "$m" >/dev/null 2>&1
}
trailer_repo "$TR_A"; trailer_repo "$TR_B"
trailer_state "$TR_A" filled; trailer_state "$TR_B" filled

# ------------------------------------------------------------------ runner ----
OUT=""
run(){   # run [dir] [args...]  -> OUT holds the JSON; RC the exit code
  local dir="${1:-$PROJ}"; shift || true
  # PJ_TRAILER_REPOS_FX names the fixture repos; the literal "-" leaves the seam EMPTY,
  # so the row falls back to its own default (this repo + dot-claude) and the
  # outside-a-repo arm measures the code path a real run takes.
  local TR_SEAM="${PJ_TRAILER_REPOS_FX:-$TR_A $TR_B}"; [ "$TR_SEAM" = "-" ] && TR_SEAM=""
  OUT="$( (builtin cd "$dir" && PATH="$BIN:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin" PJ_HOME="$H" PJ_BIN_DIR="$BIN" PJ_DOTFILES="$DF" PJ_LAUNCHER="$BIN/pj" PJ_TYPE_OUT="$T/type-out" DRYRUN_FILE="$T/dryrun" DRYRUN_RC="$T/dryrun-rc" PJ_PS_OUT="$T/ps" PJ_ZSHRC_MTIME="$ZMT" PJ_TRANSCRIPTS_DIR="$H/projects" PJ_STATE_DIR="$STATE" \
      PJ_MACHINE_FILE="$T/machine" PJ_PROMPT_SOURCES="$OR:$RULES" PJ_PROMPT_OUT="$T/cache/prompt.md" \
      OI_WHERE_FILE="$T/oi-where" DECIDED_LIST_FILE="$T/decided-list" DECIDED_LIST_RC="$T/decided-list-rc" DECIDED_HOMES_FILE="$T/decided-homes" \
      RENDER_OUT_FILE="$T/render-out" RENDER_RC_FILE="$T/render-rc" SYNC_OUT_FILE="$T/sync-out" \
      PJ_TRAILER_REPOS="$TR_SEAM" \
      pj-health --json "$@" 2>"$T/stderr") )"; RC=$?
}
st(){ jq -r --arg n "$1" '.rows[] | select(.name==$n) | .state' <<<"$OUT"; }
dt(){ jq -r --arg n "$1" '.rows[] | select(.name==$n) | .detail' <<<"$OUT"; }
has(){ case "$(dt "$1")" in *"$2"*) return 0;; *) return 1;; esac; }
# `arm` runs its arguments as a command, so a bare `!` cannot be passed through.
# A negative arm needs its own word. Used by the W-20260921-A14 wrap-up arms,
# which have to show a phrase STOPPED appearing, not merely that the row is green.
not_has(){ has "$@" && return 1 || return 0; }
is(){ [ "$(st "$1")" = "$2" ]; }
NM="NOT MEASURED"

# ------------------------------------------------------------------- arms ----
echo "pj-health-selftest: fixture $T"
# 0. baseline: all PASS except the live row
run
arm "baseline parses as JSON" jq -e '.rows|length>0' <<<"$OUT" >/dev/null
for n in launcher output-style plugin-dirs prompt-file rules-cap settings-render hooks-sync hook-orphans hook-single-fire stow-links bin-strays machine-file pj-global no-wrap-up selftests launch-log stale-shells pj-homes drawer decided-store commit-trailer evidence-card evidence-ci-watch evidence-rules evidence-plugins evidence-tokens; do
  arm "baseline $n PASS (got $(st "$n"): $(dt "$n" | cut -c1-80))" is "$n" PASS
done
arm "baseline live-probe NOT MEASURED without --live" is live-probe "$NM"
arm "baseline exit 0" [ "$RC" -eq 0 ]
arm "hooks-sync notes the sandbox refusal" has hooks-sync "refused --check"
arm "no-wrap-up counts 1 project 2 records" has no-wrap-up "1 project(s) with unwrapped sessions, 2 record(s)"
arm "evidence-tokens used the median of 3 earlier transcripts" has evidence-tokens "median of 3 earlier transcripts 52002"
arm "evidence picked a.jsonl not the sdk-cli probe" has evidence-card "transcript a:"
arm "selftests present, not run" has selftests "not run"

# 1. launcher (F3)
arm "launcher PASS names the script and no alias" has launcher "is a command, no alias"
arm "launcher PASS counts 5 plugin dirs" has launcher "5 plugin dirs"
awk -v skip="$HOME/.claude/pj" '$0=="--plugin-dir"{getline v; if (v==skip) next; print; print v; next} {print}' "$T/dryrun.ok" >"$T/dryrun"; run
arm "launcher FAIL when a plugin-dir is missing from the dry-run" is launcher FAIL; arm "launcher FAIL names the dir" has launcher "plugin-dir ~/.claude/pj]"
sed "s#$T/cache/prompt.md#$H/LIFEOS/USER/CONFIG/OPERATIONAL_RULES.md#" "$T/dryrun.ok" >"$T/dryrun"; run
arm "launcher FAIL when the prompt file is not the cache (the pre-P5.4 shape)" is launcher FAIL; arm "launcher FAIL names the expected cache" has launcher "append-system-prompt-file"
cp "$T/dryrun.ok" "$T/dryrun"; echo 2 >"$T/dryrun-rc"; run; arm "launcher FAIL when pj --dry-run refuses" has launcher "dry-run rc 2"; command mv "$T/dryrun-rc" "$T/gone/dryrun-rc"
printf 'pj: alias\npj: aliased to __claude_launch claude --old-form\n' >"$T/type-out"; run
arm "launcher FAIL when pj is an alias in a fresh shell" is launcher FAIL; arm "launcher alias FAIL says it shadows the script" has launcher "shadows ~/.local/bin/pj"
printf 'pj: function\n' >"$T/type-out"; run; arm "launcher FAIL when pj is a function" has launcher "resolves to a function"
: >"$T/type-out"; run; arm "launcher NOT MEASURED when whence prints nothing" is launcher "$NM"; cp "$T/type-out.ok" "$T/type-out"
run; arm "launcher back to PASS (control)" is launcher PASS

# 1b. launch-log (F3)
arm "launch-log PASS quotes the count read" has launch-log "last 2 launches ok"
printf 'ts=2026-09-21T13:05:00+1000 session=s3 project=p tty=ttys003 shell_start=2026-09-20T11:59:29 zshrc_mtime=2026-09-21T01:00:52 result=stale:rules-file\n' >>"$STATE/launches.log"; run
arm "launch-log WARN on a stale launch" is launch-log WARN; arm "launch-log WARN names the tty and reason" has launch-log "ttys003 2026-09-21 13:05 (rules-file)"; arm "launch-log WARN counts 1 of 3" has launch-log "1 of the last 3"
printf 'ts=2026-09-21T13:06:00+1000 session=s4 project=p tty=ttys004 shell_start=unknown zshrc_mtime=2026-09-21T01:00:52 result=unmeasured:no-claude-pid\n' >>"$STATE/launches.log"; run
arm "launch-log stays WARN with an unmeasured line" is launch-log WARN
cp "$T/launches.ok" "$STATE/launches.log"; run; arm "launch-log back to PASS (control)" is launch-log PASS
