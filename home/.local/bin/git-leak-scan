#!/usr/bin/env bash
# ============================================================================
#  git-leak-scan -- pre-commit staged-diff scan for identity / secret leaks
# ============================================================================
# Scans ONLY the staged, added lines (git diff --cached), so untracked files are
# ignored until you `git add` them. Read-only; never mutates. ASCII-only,
# bash-3.2-safe (no arrays; the diff is read via process substitution so the
# match vars survive the loop).
#
# BLOCK (exit 1 -- near-certain leak, rarely legitimate in a commit):
#   - this machine's real username inside a /Users|/home path OR its -Users- encoding
#   - API tokens: gh[pousr]_..., sk-..., AKIA..., xox[baprs]-...
#   - a PEM private-key header (-----BEGIN ... PRIVATE KEY-----)
#   - phone numbers in E.164 form (+ then 8-15 digits), excluding the ranges
#     reserved for documentation and drama
# WARN (exit 0 -- surfaced, not blocked):
#   - private RFC1918 LAN IPs (configs/docs legitimately mention these, so a
#     block would just train you to always bypass)
#   - local-format AU mobile numbers (04x/05x), which collide with dates and ids
#     often enough that blocking would cry wolf
#
# Reports FILE + matched CATEGORY only -- the offending value is NEVER re-printed.
# Invoked by ~/.config/git/hooks/_audit-chain on pre-commit; the chainer fails
# open if this script is not on PATH. Bypass a block:
#   LEAK_SCAN_DISABLE=1 git commit ...        (or: git commit --no-verify)
#
# PER-REPO OPT-OUT (private repos where identity paths are legitimate content):
#   git config leakscan.disable true          # this repo, this machine only
# The knob lives in .git/config (never committed/pushed), so cloning the repo
# elsewhere re-enables the scan by default. Revoke:  git config --unset leakscan.disable
# A skip is announced on stderr (one line) so a disabled gate is never silent;
# which repos opt out is machine-local state -- recorded where set, never here.
# ============================================================================
set -uo pipefail

# --- what to scan -----------------------------------------------------------
# Bare / --cached is the HOOK path and its behaviour is unchanged: scan the
# staged diff, and an empty one still exits 0 because `git commit --allow-empty`
# is legitimate and a linter must not break it.
#
# --range / --since exist because the SAME command was written into this
# project's plan documents as an end-of-stage audit, and this project's standing
# habit is to commit constantly. At the end of a stage nothing is staged, so
# `git diff --cached | grep ...` scanned zero bytes and reported clean. It could
# not fail. A scan that quietly checks nothing is worse than no scan, because it
# looks like a pass -- so an empty RANGE is a refusal (exit 2), not a pass, the
# same way census.py refuses to report until its control token has hit.
MODE="cached"
RANGE=""
while [ $# -gt 0 ]; do
    case "$1" in
        --cached) MODE="cached"; shift ;;
        --range)  MODE="range"; RANGE="${2:-}"; shift 2 || shift ;;
        --since)  MODE="range"; RANGE="${2:-}..HEAD"; shift 2 || shift ;;
        -h|--help)
            sed -n '2,40p' "$0" | sed 's/^# \{0,1\}//'
            printf '\nUsage:\n'
            printf '  git-leak-scan                 scan the staged diff (the pre-commit path)\n'
            printf '  git-leak-scan --since <ref>   audit everything committed since <ref>\n'
            printf '  git-leak-scan --range A..B    audit an explicit range\n'
            printf '\nExit: 0 clean  1 blocked  2 refused (nothing to scan, or bad usage)\n'
            exit 0 ;;
        *) printf 'git-leak-scan: unknown option %s (try --help)\n' "$1" >&2; exit 2 ;;
    esac
done
if [ "$MODE" = "range" ] && { [ -z "$RANGE" ] || [ "$RANGE" = "..HEAD" ]; }; then
    printf 'git-leak-scan: --range/--since needs a revision (try --help)\n' >&2
    exit 2
fi

# A SKIP IS NOT A PASS WHEN SOMEBODY ASKED A QUESTION.
#
# Reported 2026-09-06 by another project's session within an hour of --since
# shipping, and reproduced here before being accepted: `git-leak-scan --since
# HEAD~7` in a repo carrying leakscan.disable announced the skip on stderr and
# exited 0 -- over a range containing a real token. An automated `... && echo
# PASS` reads the EXIT CODE, not the message. That is exactly the defect
# --since was written to kill, one commit later, in the same file.
#
# The split is the same as for an empty input, for the same reason:
#   HOOK path (bare/--cached): a disabled repo must stay committable, so a skip
#     is exit 0. Nobody asked this invocation a question; git did.
#   AUDIT path (--range/--since): the caller asked. "I did not look" is not the
#     answer "clean", so it refuses with exit 2.
skip_or_refuse() { # skip_or_refuse <reason>
    if [ "$MODE" = "range" ]; then
        printf 'git-leak-scan: REFUSING -- %s, so this audit scanned nothing.\n' "$1" >&2
        printf '  An empty scan is NOT a pass. Use a repo-appropriate scanner, or\n' >&2
        printf '  lift the opt-out for this audit if the block reasons do not apply.\n' >&2
        exit 2
    fi
    printf 'git-leak-scan: SKIPPED (%s)\n' "$1" >&2
    exit 0
}

# Explicit, deliberate bypass. ANNOUNCED, not silent.
[ -n "${LEAK_SCAN_DISABLE:-}" ] && skip_or_refuse "LEAK_SCAN_DISABLE set"
# Fail open outside a git repo.
git rev-parse --git-dir >/dev/null 2>&1 || exit 0
# Per-repo opt-out (see header): a truthy leakscan.disable in this repo's config
# skips the scan entirely. --type=bool normalizes true/1/yes/on. Announce the
# skip -- an enforced gate standing down must be observable, never silent.
[ "$(git config --type=bool --get leakscan.disable 2>/dev/null)" = "true" ] \
    && skip_or_refuse "leakscan.disable set for this repo"

user="$(id -un 2>/dev/null || echo "${USER:-}")"

# ERE fragments (used UNQUOTED with bash [[ =~ ]]). Usernames are [A-Za-z0-9._-];
# a stray '.' would over-match slightly, which only makes the guard stricter.
b_user="(/Users/${user}/|/home/${user}/|-Users-${user}-)"
b_ghtok='gh[pousr]_[A-Za-z0-9]{20,}'
b_sk='sk-[A-Za-z0-9]{20,}'
b_aws='AKIA[0-9A-Z]{16}'
b_slack='xox[baprs]-[A-Za-z0-9-]{10,}'
b_pkey='-----BEGIN [A-Z ]*PRIVATE KEY-----'
w_ip='(^|[^0-9.])(192\.168\.[0-9]{1,3}\.[0-9]{1,3}|10\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}|172\.(1[6-9]|2[0-9]|3[01])\.[0-9]{1,3}\.[0-9]{1,3})([^0-9]|$)'

# --- Phone numbers ----------------------------------------------------------
# Added after a real mobile number was nearly committed to this PUBLIC repo as a
# worked example in documentation. Nothing here caught it: the scan matched
# usernames, tokens and keys, and a phone number is none of those.
#
# BLOCK covers E.164 -- a leading '+' then 8-15 digits, separators allowed. That
# shape is rarely anything but a real number, so blocking is safe and a false
# positive is cheap to bypass.
#
# WARN covers local-format AU mobiles (04x/05x). Deliberately not a block: a bare
# 10-digit run collides with dates, ids and hashes, and a gate that cries wolf is
# a gate people learn to bypass.
#
# Numbers reserved for documentation and drama are exempt from BOTH, or this
# scanner would flag the very examples that exist so real numbers are not used:
#   AU (ACMA)  +61491570156 through +61491570165, local 0491570156 to 0491570165
#   UK (Ofcom) +447700900000 upward, +442079460000 upward
#   US (NANP)  555 01xx in any area code
#
# The separator run between digits is capped at TWO, and the exact number is
# load-bearing at both ends.
#
# A flat class like '[0-9 ().-]{6,18}' looks equivalent and is not: on a line
# reading "+61491570156 .. 165" it matches straight THROUGH the ellipsis and
# yields a 15-digit string that is in no reserved range, so the scanner blocks
# its own documentation. Found exactly that way -- this file failed to commit
# itself.
#
# But capping at ONE is too tight: a bracketed number such as
# "+61 (491) 570-156" needs two separators for " (" and again for ") ", so it
# slips through unblocked. Two admits every real formatting convention while
# still refusing to bridge across " .. " (four characters) or any prose gap.
#
# (Every number written in this file is from a reserved range -- this scanner
# blocks its own source otherwise, which is how the ONE-separator bug surfaced.)
b_phone='\+[0-9]([ ().-]{0,2}[0-9]){7,14}'
w_phone_au='(^|[^0-9])0[45][0-9]{2}[ .-]?[0-9]{3}[ .-]?[0-9]{3}([^0-9]|$)'
fiction='^\+?(61491570(15[6-9]|16[0-5])|0491570(15[6-9]|16[0-5])|447700900[0-9]{3}|442079460[0-9]{3}|1?[0-9]{3}55501[0-9]{2})$'

# Is a matched number one of the reserved documentation ranges?
#
# Strips everything that is not a digit or '+', rather than a fixed list of
# separators. The fixed list was wrong: w_phone_au's match deliberately includes
# the surrounding non-digit character, so a number written inside quotes came
# through as '"0491570156', failed the anchored fiction test, and warned about a
# reserved number -- this scanner warned on its own source. Only runs when a
# phone-shaped candidate was already found, so the fork is rare.
is_fiction() {
    _n="$(printf '%s' "$1" | tr -cd '0-9+')"
    [[ $_n =~ $fiction ]]
}

# Scan one line for a phone matching $2, skipping reserved ranges. Walks EVERY
# match rather than testing only the first, so a line holding both an example
# number and a real one is still caught. Both the block and the warn path use
# this: exempting documentation numbers from the WARNING matters just as much,
# or every commit touching these docs cries wolf.
line_has_real_phone() {
    _rest="$1"; _pat="$2"
    while [ -n "$_rest" ] && [[ $_rest =~ $_pat ]]; do
        _m="${BASH_REMATCH[0]}"
        is_fiction "$_m" || return 0
        _rest="${_rest#*"$_m"}"
    done
    return 1
}

# Collect the diff FIRST, so its emptiness can be judged before it is scanned.
# Reading it straight into the loop is what made "nothing to scan" and "nothing
# found" the same observable outcome.
# VALIDATE THE RANGE BEFORE HANDING IT TO git diff.
#
# Red-teamed 2026-09-06: the value was passed through unchecked, and git is
# happy to read it as an option or a pathspec. `--range --stat` and
# `--range sample.txt` both scanned the UNSTAGED WORKING TREE while the report
# said "range --stat". Had the working tree been clean, that is an exit 0 and a
# caller believing a range was audited. Same defect class as the empty scan: it
# looked at something other than what was asked and nothing said so.
#
# Shell injection was tested and is NOT possible -- the value is quoted
# throughout, and `--range '; echo PWNED'` never executes. This is a
# correctness and trust problem, not a code-execution one.
_valid_rev() { git rev-parse --verify --quiet "${1}^{commit}" >/dev/null 2>&1; }
if [ "$MODE" = "range" ]; then
    _bad=""
    case "$RANGE" in
        -*) _bad="it starts with '-', so git would read it as an option" ;;
    esac
    if [ -z "$_bad" ]; then
        _lhs="${RANGE%%..*}"
        _rhs="${RANGE##*..}"
        if [ "$RANGE" = "$_lhs" ]; then
            _valid_rev "$RANGE" || _bad="'$RANGE' is not a valid revision"
        else
            _valid_rev "$_lhs" || _bad="'$_lhs' is not a valid revision"
            [ -z "$_bad" ] && { _valid_rev "$_rhs" || _bad="'$_rhs' is not a valid revision"; }
        fi
    fi
    if [ -n "$_bad" ]; then
        printf 'git-leak-scan: REFUSING -- %s.\n' "$_bad" >&2
        printf '  Nothing was scanned. Pass a revision range such as <ref>..HEAD;\n' >&2
        printf '  a path or an option here would silently scan the working tree.\n' >&2
        exit 2
    fi
fi

WHAT="staged diff"
[ "$MODE" = "range" ] && WHAT="range $RANGE"

if [ "$MODE" = "range" ]; then
    diff_text="$(git diff --no-color -U0 "$RANGE" 2>/dev/null)"
else
    diff_text="$(git diff --cached --no-color -U0 2>/dev/null)"
fi

if [ -z "$diff_text" ]; then
    if [ "$MODE" = "range" ]; then
        printf 'git-leak-scan: REFUSING -- range %s is empty, so this scanned nothing.\n' "$RANGE" >&2
        printf '  An empty scan is NOT a pass. Check the revision, or the work may be\n' >&2
        printf '  somewhere else (unstaged? a different branch? already scanned?).\n' >&2
        exit 2
    fi
    # Hook path: an empty staged diff is legitimate (--allow-empty), so this
    # stays exit 0 -- but it must never be SILENT about having checked nothing.
    printf 'git-leak-scan: nothing staged -- scanned nothing (this is not an audit).\n' >&2
    printf '  To audit committed work: git-leak-scan --since <ref>\n' >&2
    exit 0
fi

block_hits=""
warn_hits=""
file="?"

# A "+++ " LINE IS ONLY A FILE HEADER IF A "--- " LINE CAME IMMEDIATELY BEFORE.
#
# Red-teamed 2026-09-06. Without that check, file CONTENT could rename the file
# in the report: a line reading "++ b/INNOCENT.txt" gains git's own '+' prefix,
# arrives as "+++ b/INNOCENT.txt", and every later hit was attributed to a file
# that does not exist. The leak was still BLOCKED -- the gate held -- but the
# report sent you to scrub the wrong file, which on a security tool is its own
# kind of failure.
#
# This is not merely an adversarial case: any document containing a diff
# snippet does it by accident, and this repo's docs are full of them.
# In real `git diff` output a "+++ b/x" header is always preceded by "--- a/x"
# (or "--- /dev/null" for a new file), and a content line never is.
prev_minus=0
while IFS= read -r line; do
    case "$line" in
        "--- "*) prev_minus=1; continue ;;
    esac
    # Only HERE is a "+++ " line a real header. A spoofed one must fall through
    # to the content scan below rather than being consumed -- swallowing it
    # would let a line be skipped entirely, which is a worse bug than the
    # mislabelling this fixes.
    if [ "$prev_minus" = 1 ]; then
        prev_minus=0
        case "$line" in
            "+++ b/"*) file="${line#+++ b/}"; continue ;;
            "+++ "*)   file="${line#+++ }";   continue ;;
        esac
    fi
    prev_minus=0
    case "$line" in
        "+"*)
            c="${line#+}"
            cat=""
            if [ -n "$user" ] && [[ $c =~ $b_user ]]; then cat="username-in-path"
            elif [[ $c =~ $b_ghtok ]]; then cat="github-token"
            elif [[ $c =~ $b_sk ]];    then cat="api-token(sk-)"
            elif [[ $c =~ $b_aws ]];   then cat="aws-access-key"
            elif [[ $c =~ $b_slack ]]; then cat="slack-token"
            elif [[ $c =~ $b_pkey ]];  then cat="private-key"
            elif line_has_real_phone "$c" "$b_phone"; then cat="phone-number(E.164)"
            fi
            if [ -n "$cat" ]; then
                block_hits="${block_hits}${file}: ${cat}
"
            fi
            if [[ $c =~ $w_ip ]]; then
                warn_hits="${warn_hits}${file}: private-LAN-IP
"
            fi
            if line_has_real_phone "$c" "$w_phone_au"; then
                warn_hits="${warn_hits}${file}: local-format-phone
"
            fi
            ;;
    esac
done < <(printf '%s\n' "$diff_text")

block_hits="$(printf '%s' "$block_hits" | grep -v '^$' | sort -u)"
warn_hits="$(printf '%s' "$warn_hits" | grep -v '^$' | sort -u)"

if [ -n "$warn_hits" ]; then
    printf 'leak-scan WARNING -- surfaced in %s (allowed, not blocked):\n' "$WHAT" >&2
    printf '%s\n' "$warn_hits" | sed 's/^/  /' >&2
fi

if [ -n "$block_hits" ]; then
    printf 'leak-scan BLOCKED -- possible identity/secret leak in %s:\n' "$WHAT" >&2
    printf '%s\n' "$block_hits" | sed 's/^/  /' >&2
    if [ "$MODE" = "range" ]; then
        printf 'value masked. This is committed history -- scrubbing needs a rewrite, not a bypass.\n' >&2
    else
        printf 'value masked. Scrub it, or bypass:  LEAK_SCAN_DISABLE=1 git commit ...  (or git commit --no-verify)\n' >&2
    fi
    exit 1
fi

exit 0
