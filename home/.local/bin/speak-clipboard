#!/usr/bin/env bash
# ============================================================================
#  speak-clipboard -- read the clipboard aloud, without reading the furniture
# ============================================================================
#
# WHY
# ---
# macOS "Speak selection" cannot see a selection made inside herdr: herdr
# captures the mouse, so the selection lives in its process memory and is never
# published to the accessibility API. The clipboard is the only bridge, since
# herdr's copy_on_select means a drag has already copied by the time you let go.
#
# But speaking the clipboard raw is unpleasant, because a terminal selection is
# not prose. It carries pane borders, Powerlevel10k prompt decoration, Nerd Font
# glyphs from the private use area, box drawing, and separator runs. A speech
# engine pronounces those -- the reported symptom was "F" and "F dash" chanted
# at the end of every line -- and the actual words get lost in the noise.
#
# So this strips the furniture before speaking. The native accessibility hotkey
# CANNOT do this: it reads the raw screen, decoration and all. That asymmetry is
# the main argument for going through the clipboard at all.
#
# WHAT THE CLEANER DOES (one perl pass, in this order, and why each)
#   * ANSI/OSC escape sequences are removed -- colour and title codes, never
#     spoken content
#   * tables (box-drawn or markdown) are re-spoken row by row, "Row 1. Source.
#     The record body... When. Any time...", every name and cell its own
#     sentence so the voice pauses between them (v4.7, 2026-09-28, Gavin's
#     call: a pause after "Row N" and after each column name). MEASURED on
#     Aaron at 420 wpm: four pauses of 276-361 ms where the run-together
#     form had none over 60 ms. See _tables in the cleaner.
#   * typographic punctuation is MAPPED, not dropped: curly quotes -> straight,
#     every Unicode dash -> hyphen, ellipsis -> "...", every space separator ->
#     space. Accented letters are decomposed and their marks removed, so "cafe"
#     with an acute and "Dvorak" with a caron both survive. Without this, "I'm"
#     with a curly apostrophe became "Im".
#   * "[[" is split into "[ [" so clipboard text cannot smuggle embedded
#     speech-engine commands like [[slnc 60000]] (a 60 s silence)
#   * everything still outside printable ASCII is dropped -- box drawing, Nerd
#     Font PUA glyphs, emoji, the middle dots p10k uses as separators
#   * runs of punctuation used as rules or padding (----, ====, ....)
#   * leading "- " / "* " list markers, blank lines, and whitespace runs, which
#     become dead air; everything is joined to one line because the engine
#     pauses on every line break (MEASURED: 20 words took 4.64 s as one line
#     and 6.98 s as ten short lines); joining here means say2 gets one clean run
#   * the result is capped at 8000 chars (~2 min of speech; stop is instant)
#
# Deliberately NOT stripped: ordinary punctuation inside sentences, code
# symbols, and paths. Those carry meaning when read aloud.
#
# Why one perl pass and not sed | tr | grep: the old pipeline was seven forks
# (~21 ms per press); this is one (~6 ms), and it also computes the SHA-256 the
# toggle rule needs, so `shasum` (a 14 ms perl script of its own) is not spawned.
# All three modules (Encode, Unicode::Normalize, Digest::SHA) are core perl.
#
# SPEED
# ----
# Default is 420 wpm, set by hand after listening to 278 wpm (1.5x) and
# finding it too slow. `say` with no -r runs at 175 wpm; 420 lands around
# 2.4x that baseline. Re-tune by listening, not by arithmetic. say2's `-r` is
# documented as the same say-compatible WPM scale, so the number carried over
# unchanged across the engine switch below.
#
# VOLUME
# ------
# Default 60 of 100 (2026-09-28, Gavin: speech a little quieter than
# everything else, without touching the system volume). It is applied by
# ffplay's -volume on the streaming path, which scales the samples linearly:
# 60 is about -4.4 dB, 50 about -6 dB (first set at 70, lowered by ear).
# It sits UNDER the system volume, so it can only make speech quieter, never
# louder. Re-tune by listening. The
# fallback paths (no ffplay, or an explicit --voice) play at plain system
# volume: say2's own --volume is a documented no-op on the siri engine.
#
# ONE PROCESS PER PRESS, DIRECT TO say2 (v4, 2026-09-10)
# --------------------------------------------------------
# History, so nobody rebuilds any of this: v1 shelled out to `say` (1 s before
# the first word, every press). v2 kept a background daemon warm to save that
# second; it saved ~0.5 s and brought a socket, a singleton race, a process
# that never exited, a lock that stopped the Mac from sleeping, and a toggle
# that silently cancelled long text because it rendered the WHOLE selection to
# a file before playing any of it (10+ s of silence on a long selection).
# v3 fixed that by hand-building a chunked pipeline in Swift
# (speak-render.swift, since deleted): split text at sentence ends, render
# sentence 1 via NSSpeechSynthesizer (~0.7 s), start playing it, render the
# rest while it plays.
#
# v4 (this) deletes that pipeline. `say2` (https://github.com/CaptainCodeAU/say2)
# reaches the same premium Aaron voice (now the "natural" tier,
# en-US:natural:male:Aaron:premium:5030 -- a better tier than NSSpeechSynthesizer
# could even reach) and already streams internally: MEASURED on this Mac
# 2026-09-10, direct playback of a 16.1 s / ~120-word paragraph
# (`say2 -v ... "$text"`, no -o) took 16.7 s wall-clock total -- about 0.65 s of
# overhead before/around the speech, not 0.65 s PLUS a multi-second render-first
# wait. Rendering that same paragraph to a file first (`-o`, the old chunked
# design's approach) took 5.0 s before any audio could start -- proof the old
# problem is real, but proof say2's own direct-play mode already solves it, so
# building a second chunker on top of it would just be solving it twice.
# So: one `say2` process per press, playing straight to the default audio
# device. STOP is killing that process -- see stop_speaker for why a plain
# SIGTERM is not enough.
#
# v4.2 (2026-09-28): the stop press did nothing once speech was audible.
# say2 (at 7b8eeff) catches SIGTERM and turns it into "cancel synthesis"
# (Sources/say2/main.swift), but by the time audio plays the whole utterance
# is already rendered to a temp .wav, and its playback loop
# (Application.swift, play()) never checks for cancel. So SIGTERM during
# speech was silently ignored and the voice ran to the end. The old note here
# ("kill-to-exit ~15 ms") was measured before say2 took this shape.
# stop_speaker now sends SIGKILL. Cost: say2's temp .wav in its $TMPDIR is
# left behind (macOS clears $TMPDIR itself), and a stop during rendering does
# not tell the Siri daemon to cancel (it finishes into nowhere, harmless).
# The real fix belongs in say2's play() loop.
#
# v4.3 (same evening): v4.2 first sent SIGTERM and polled ~0.2 s before the
# SIGKILL. MEASURED: each `sleep 0.02` here really takes ~59 ms, so that
# "0.2 s" wait was ~0.6 s of audible lag on every stop, for a SIGTERM say2
# ignores anyway during playback. Gone; SIGKILL is immediate.
#
# v4.4 (same evening): the v4 claim above that say2 "already streams
# internally" was WRONG for direct playback. say2's play path renders the
# whole utterance to a .wav and only then plays it (Application.swift,
# unchanged since 2026-09-08). The v4 test used a 16 s paragraph, which
# renders too fast to tell the two apart. Gavin reported long selections
# waiting over a minute. MEASURED with fresh text (3,360 chars, ~100 s of
# speech): direct play 35.1 s of silence first; `--format pcm -o -` to stdout
# gave its first audio bytes after 0.33 s, rendering ~3x faster than speech.
# So start_speaker now pipes that stream into ffplay when it is available,
# and keeps the direct-play path as the fallback. Once say2's own playback
# streams (the say2 fix filed alongside the SIGTERM one), drop the ffplay
# layer and call say2 directly again.
#
# v4.1 (2026-09-10, same day): two corrections after Gavin reported the real
# hotkey taking 2-3 s to start speaking, which the numbers above did not
# predict.
#
# First, `say2 synthesize` (the subcommand) is measurably slower than the bare
# `say2 -v ... TEXT` form REGARDLESS of how text reaches it -- MEASURED both
# ways, repeated, ~2-4 s of overhead on `synthesize` either via stdin or argv,
# vs ~0.6-0.7 s on the bare form. Switched to the bare form and, since that
# form only reliably streams fast with TEXT as a normal argument (not stdin,
# not `-f FILE` -- both measured slower too), text now goes on argv. That is a
# deliberate reversal of this file's original "never argv" privacy design:
# Gavin chose speed after seeing the actual trade-off (text briefly visible in
# `ps` output while speaking, on his own single-user Mac).
#
# Second, and this is the part argv did NOT fix: paired testing (same command,
# run twice) showed the SAME command is slow (~1-2.6 s of overhead, noisy)
# on the first call after any real pause, and fast (~0.6 s) on a second call
# fired immediately after. That is the actual 2-3 s Gavin was hearing --
# selecting text, then pressing the key, is always a "first call". Tried
# feeding it a silent warm-up ping beforehand (both `--no-output` and `-o
# FILE`, ~0.3 s / ~30 MB each, genuinely cheap) and MEASURED that neither
# changes the real call's timing at all -- the cold cost is not in the
# synthesis engine, which is already fast every time. Best-evidenced guess:
# it is the audio OUTPUT device (not the voice model) waking from idle, which
# a silent-only ping does not touch. A ping that reliably fixed this would
# have to make a real (if quiet) sound every few minutes -- Gavin decided
# against building that (uncertain payoff, adds a periodic background noise)
# on 2026-09-10. So: this delay is accepted as a trait of the voice pipeline,
# not something this script tries to hide.
#
# FALLBACK (2026-09-10): say2 reaches a private Apple framework that a macOS
# update can remove or rename without warning (it exits 69 for exactly that
# case), and a fresh machine may have say2 installed but not the premium Siri
# voice downloaded. Neither should mean silence. resolve_engine() picks Aaron,
# then Simone (the two premium Siri "natural" voices), then the always-present
# `say` binary with voice Samantha, in that order -- checked once and cached
# for a day (see resolve_engine's own comment) so a normal press costs a file
# read, not a live probe. `--voice` bypasses all of this and goes straight to
# say2 with the given key, trusting an explicit override as-is.
#
# The toggle rule (v5, 2026-09-28, Gavin's call): ANY press while it speaks
# = stop, whatever the clipboard holds; the next press speaks the current
# selection. Until v5, a press with NEW text replaced the speech instead,
# decided by comparing a SHA-256 of the cleaned text. The cleaner still
# computes that hash, but since v4.5 nothing stores or reads it.
#
# PRIVACY: the text is never logged. It DOES pass on the command line as of
# v4.1 above (a deliberate speed-over-privacy trade, see that note) -- it is
# visible in `ps` output to anyone with shell access on this Mac for as long
# as the utterance is speaking, which the original v1-v4 design specifically
# avoided. Their stderr is still captured for diagnostics, never the text.
#
# CONCURRENCY: key auto-repeat or a double tap runs this script twice within
# a few ms. A flock on speak-clipboard.flock (macOS `lockf` on fd 9)
# serialises the check-stop-start section; the loser records outcome=busy and
# exits 0 (never queues -- N repeats would mean N toggles). The kernel drops
# the lock when the script exits, even on SIGKILL, so there is no stale-lock
# case to handle. The pid file is trusted only if that pid is still the same
# live process (pid plus start time) and is one of our engines: pids are
# recycled, and a stale file must never kill a stranger.
#
# NOTHING IS EVER DELETED (v4.5, 2026-09-28, Gavin's call). Until v4.5 the
# lock was a mkdir'd folder and the pid/hash files were removed after use.
# In a script `command rm` is the ~/.local/bin/rm Trash shim, so every press
# put 1-3 of these files in the Trash (verified with a probe) at ~95 ms each.
# Now the lock file is never removed (a lock is the flock, not the file), the
# pid file is overwritten in place and judged stale by its contents, and the
# hash file is no longer written at all.
#
# USAGE
#   speak-clipboard              speak the clipboard (replacing any current speech)
#   speak-clipboard --toggle     speaking: stop (any text); idle: speak
#   speak-clipboard --stop       stop any speech in progress
#   speak-clipboard --print      print what WOULD be spoken (no audio)
#   speak-clipboard --stdin      read text from stdin instead of the clipboard
#                                (for tests; combine with --print/--toggle)
#   speak-clipboard --rate N     words per minute, this press only (1-700)
#   speak-clipboard --volume N   speech volume 0-100 under the system volume,
#                                this press only (streaming path only)
#   speak-clipboard --voice KEY  say2 voice asset key or display name, this press
#                                only -- bypasses the fallback chain entirely
#
# SAVED SETTINGS (used by every press, the hotkey included)
#   speak-clipboard --settings          show rate, volume and voice, and where
#                                       each one comes from (saved or default)
#   speak-clipboard --get KEY           print one value alone: rate, volume or
#                                       voice (its full key); with no KEY, all
#                                       three as key=value lines
#   speak-clipboard --set rate N        save words per minute (1-700)
#   speak-clipboard --set volume N      save volume 0-100
#   speak-clipboard --set voice V       save a voice: its number or name from
#                                       --voices, or its full key
#   speak-clipboard --reset KEY         back to the recommended value:
#                                       rate, volume, voice, or all; prints
#                                       the values before and after
#   speak-clipboard --voices            list the installed Siri voices, numbered,
#                                       with the one in use marked
#
# EXIT CODES
#   0  spoke, stopped, replaced, printed, or a settings command worked
#      (or lost the lock: busy)
#   1  nothing to say (clipboard empty, or empty once cleaned), a bad
#      option or value, or say2 could not list its voices
#
# SETTINGS FILE (v6, 2026-10-08, Gavin's ask: change speed, volume and voice
# without editing this script). ~/.config/speak-clipboard/settings holds
# key=value lines for rate, volume and voice; a key that is absent uses the
# default above. Only --set and --reset write it, and they check the value
# first. A press reads it with shell builtins (no fork). A hand-edited value
# that fails the same check is ignored for the default and noted in the log
# (settings=bad:<key>), never a silent hotkey failure. A saved voice goes to
# the FRONT of the fallback chain (saved, Aaron, Simone, `say`), so it keeps
# streaming and still falls back if it disappears. Every installed Siri voice
# streams the same 48 kHz mono 16-bit PCM (MEASURED 2026-10-08, all four
# English voices), so ffplay's fixed -ar 48000 holds for any of them.
# The 700 ceiling is say2's own: -r 875 exits 2, "between 0 and 700".
# say2 lists NO voices inside a Claude sandbox (it cannot reach the speech
# daemon), so --voices and --set voice refuse there instead of saying none.
#
# STATE (all under ~/.local/state/herdr/, nothing here ever contains text)
#   speak-clipboard.log    one line per press: when, mode, ppid, outcome, chars
#   speak-render.log       the speaker's stderr, for diagnostics only
#   speak-render.pid       the last speaker's pid (line 1) and start time (line 2)
#   speak-engine.cache     resolve_engine()'s cached choice, refreshed daily
#                          or when the saved voice changes
#   speak-clipboard.flock  empty; flock'd for one run of this script
#   (speak-render.hash and a speak-clipboard.lock/ folder are pre-v4.5
#    leftovers, no longer read or written)
# ============================================================================
set -uo pipefail

# The two premium Siri "natural" voices (Apple's own "Voice 1" / "Voice 2" in
# System Settings > Accessibility > Spoken Content). Aaron first, Simone as a
# second try before giving up on say2 entirely -- either is a real improvement
# over the `say` fallback. `say` itself is always present on macOS, so it is
# the last resort, not a "might also be missing" case.
_default_voice="en-US:natural:male:Aaron:premium:5030"
_secondary_voice="en-US:natural:female:Simone:premium:5029"
_say_fallback_voice="Samantha"
_default_rate="420"
_default_volume="60"
cli_rate=""
cli_volume=""
voice=""
mode="speak"
from_stdin=0
set_key=""
set_value=""

while [ $# -gt 0 ]; do
    case "$1" in
        --print)  mode="print";  shift ;;
        --stop)   mode="stop";   shift ;;
        --toggle) mode="toggle"; shift ;;
        --stdin)  from_stdin=1;  shift ;;
        --rate)  [ $# -ge 2 ] || { echo "speak-clipboard: --rate needs a value" >&2; exit 1; }; cli_rate="$2"; shift 2 ;;
        --volume) [ $# -ge 2 ] || { echo "speak-clipboard: --volume needs a value" >&2; exit 1; }; cli_volume="$2"; shift 2 ;;
        --voice) [ $# -ge 2 ] || { echo "speak-clipboard: --voice needs a value" >&2; exit 1; }; voice="$2"; shift 2 ;;
        --settings) mode="settings"; shift ;;
        --voices)   mode="voices";   shift ;;
        --get)   mode="get"; set_key="${2:-all}"; shift; [ $# -eq 0 ] || shift ;;
        --set)   [ $# -ge 3 ] || { echo "speak-clipboard: --set needs a name and a value, e.g. --set rate 380" >&2; exit 1; }; mode="set"; set_key="$2"; set_value="$3"; shift 3 ;;
        --reset) [ $# -ge 2 ] || { echo "speak-clipboard: --reset needs rate, volume, voice or all" >&2; exit 1; }; mode="reset"; set_key="$2"; shift 2 ;;
        -h|--help) mode="help"; shift ;;
        *) echo "speak-clipboard: unknown option '$1'" >&2; exit 1 ;;
    esac
done

# The same checks guard a --rate/--volume flag, a --set, and a value read
# back from the settings file. Five digits or more is refused before `[`
# sees it, so a huge number is "not a number", not a test error.
_valid_rate()   { case "$1" in ''|*[!0-9]*|?????*) return 1 ;; esac; [ "$1" -ge 1 ] && [ "$1" -le 700 ]; }
_valid_volume() { case "$1" in ''|*[!0-9]*|?????*) return 1 ;; esac; [ "$1" -le 100 ]; }
_valid_voice()  { case "$1" in ''|*'|'*) return 1 ;; esac; }   # '|' would break the engine cache line

if [ -n "$cli_rate" ] && ! _valid_rate "$cli_rate"; then
    echo "speak-clipboard: --rate takes a whole number 1-700 (say2's own limit)" >&2; exit 1
fi
if [ -n "$cli_volume" ] && ! _valid_volume "$cli_volume"; then
    echo "speak-clipboard: --volume takes a whole number 0-100" >&2; exit 1
fi

# Saved settings (v6). f_* hold the file's lines exactly as written, so a
# --set of one key rewrites the others untouched; saved_* hold only the ones
# that pass the checks, and a failing one is named in _bad_settings.
_settings_file="${XDG_CONFIG_HOME:-$HOME/.config}/speak-clipboard/settings"
f_rate=""; f_volume=""; f_voice=""
if [ -f "$_settings_file" ]; then
    while IFS='=' read -r _k _v || [ -n "$_k" ]; do
        case "$_k" in
            rate)   f_rate="$_v" ;;
            volume) f_volume="$_v" ;;
            voice)  f_voice="$_v" ;;
        esac
    done <"$_settings_file"
fi
_bad_settings=""
saved_rate="";   if [ -n "$f_rate" ];   then if _valid_rate "$f_rate";     then saved_rate="$f_rate";     else _bad_settings="${_bad_settings:+$_bad_settings,}rate"; fi; fi
saved_volume=""; if [ -n "$f_volume" ]; then if _valid_volume "$f_volume"; then saved_volume="$f_volume"; else _bad_settings="${_bad_settings:+$_bad_settings,}volume"; fi; fi
saved_voice="";  if [ -n "$f_voice" ];  then if _valid_voice "$f_voice";   then saved_voice="$f_voice";   else _bad_settings="${_bad_settings:+$_bad_settings,}voice"; fi; fi

rate="${cli_rate:-${saved_rate:-$_default_rate}}"
volume="${cli_volume:-${saved_volume:-$_default_volume}}"
_preferred_voice="${saved_voice:-$_default_voice}"

_state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/herdr"
_trace_file="$_state_dir/speak-clipboard.log"
_render_log="$_state_dir/speak-render.log"
_pid_file="$_state_dir/speak-render.pid"
_lock_file="$_state_dir/speak-clipboard.flock"
_engine_cache="$_state_dir/speak-engine.cache"
_engine_cache_ttl=86400
_max_chars=8000
[ -d "$_state_dir" ] || mkdir -p "$_state_dir" 2>/dev/null

# Decide which engine+voice a plain press actually uses, and cache the answer
# for a day so a normal press costs one file read, not a live say2 probe
# (`say2 voices --status` alone measured ~0.1-0.3s -- fine once, not on every
# keystroke). A 24h TTL means a macOS update that silently removes the Siri
# voice heals itself within a day instead of failing forever. Sets _engine
# (say2 or say) and _engine_voice. Skipped entirely when --voice overrides the
# default: an explicit voice is trusted as-is, straight to say2, no fallback.
# The cache line's fourth field is the voice it was resolved FOR (v6): a
# --set voice changes _preferred_voice, the fields no longer match, and the
# next press probes again instead of waiting out the day. A pre-v6 line has
# three fields, so it is re-probed once.
resolve_engine() {
    if [ -n "$voice" ]; then
        _engine="say2"; _engine_voice="$voice"
        return
    fi
    local now cached_at cached_engine cached_voice cached_for
    now="$(date +%s)"
    if [ -f "$_engine_cache" ]; then
        { IFS='|' read -r cached_at cached_engine cached_voice cached_for <"$_engine_cache"; } 2>/dev/null || true
        if [ -n "${cached_at:-}" ] && [ "${cached_for:-}" = "$_preferred_voice" ] &&
            [ $((now - cached_at)) -lt "$_engine_cache_ttl" ]; then
            _engine="$cached_engine"; _engine_voice="$cached_voice"
            return
        fi
    fi
    _engine="say"; _engine_voice="$_say_fallback_voice"
    if command -v say2 >/dev/null 2>&1; then
        local v
        for v in "$_preferred_voice" "$_default_voice" "$_secondary_voice"; do
            if say2 voices --status "$v" --json 2>/dev/null | grep -q '"state" *: *"installed"'; then
                _engine="say2"; _engine_voice="$v"
                break
            fi
        done
    fi
    printf '%s|%s|%s|%s\n' "$now" "$_engine" "$_engine_voice" "$_preferred_voice" >"$_engine_cache" 2>/dev/null || true
}

# ---------------------------------------------------------------------------
# Settings commands (v6). None of them takes the lock or touches speech.
# ---------------------------------------------------------------------------

# Fills _voice_keys with the full key of every installed Siri voice, in
# say2's own order (that order is what the --voices numbers refer to). The
# key is the last column of `say2 voices`; a line whose last word is not a
# six-part key is a header or a message, and skipped.
_load_voices() {
    _voice_keys=()
    if ! command -v say2 >/dev/null 2>&1; then
        echo "speak-clipboard: say2 is not installed, so there are no Siri voices to list" >&2
        return 1
    fi
    local line key
    while IFS= read -r line; do
        line="${line%"${line##*[![:space:]]}"}"
        key="${line##* }"
        case "$key" in *:*:*:*:*:*) _voice_keys+=("$key") ;; esac
    done < <(say2 voices 2>/dev/null)
    if [ ${#_voice_keys[@]} -eq 0 ]; then
        echo "speak-clipboard: say2 listed no installed voices." >&2
        echo "  Inside a Claude Code sandbox it cannot reach the speech daemon: run this in a normal terminal." >&2
        echo "  In a normal terminal, it means no Siri voice is downloaded (System Settings > Accessibility > Spoken Content)." >&2
        return 1
    fi
}

# "Aaron (en-US, male, natural)" for a full key; anything else as it is.
_voice_label() {
    local lang tier gender name rest
    case "$1" in
        *:*:*:*:*:*) IFS=: read -r lang tier gender name rest <<<"$1"
                     printf '%s (%s, %s, %s)' "$name" "$lang" "$gender" "$tier" ;;
        *) printf '%s' "$1" ;;
    esac
}

show_voices() {
    _load_voices || return 1
    local i=0 key lang tier gender name rest mark
    printf '  %-3s %-8s %-9s %-7s %s\n' '#' NAME LANGUAGE GENDER TIER
    for key in "${_voice_keys[@]}"; do
        i=$((i + 1))
        IFS=: read -r lang tier gender name rest <<<"$key"
        mark=" "; [ "$key" = "$_preferred_voice" ] && mark="*"
        printf '%s %-3s %-8s %-9s %-7s %s%s\n' "$mark" "$i" "$name" "$lang" "$gender" "$tier" \
            "$([ "$mark" = "*" ] && printf '   (in use)')"
    done
    echo
    echo "natural = the newer Siri voices (version 5000s); neuralAX = the older ones (1000s)."
    echo "Change: speak-clipboard --set voice <number or name>"
}

# Turns a number, a name or a full key into a full key, in _picked_voice. A
# name shared by two tiers (Aaron, Simone) picks the natural one.
_pick_voice() {
    local want="$1" key name first="" natural=""
    _picked_voice=""
    _load_voices || return 1
    case "$want" in
        ''|*[!0-9]*) ;;
        *) if [ "$want" -ge 1 ] && [ "$want" -le ${#_voice_keys[@]} ]; then
               _picked_voice="${_voice_keys[$((want - 1))]}"; return 0
           fi
           echo "speak-clipboard: no voice number $want; --voices lists 1-${#_voice_keys[@]}" >&2
           return 1 ;;
    esac
    shopt -s nocasematch
    for key in "${_voice_keys[@]}"; do
        if [[ "$key" == "$want" ]]; then _picked_voice="$key"; break; fi
        IFS=: read -r _ _ _ name _ <<<"$key"
        if [[ "$name" == "$want" ]]; then
            [ -z "$first" ] && first="$key"
            case "$key" in *:natural:*) [ -z "$natural" ] && natural="$key" ;; esac
        fi
    done
    shopt -u nocasematch
    [ -z "$_picked_voice" ] && _picked_voice="${natural:-$first}"
    if [ -z "$_picked_voice" ]; then
        echo "speak-clipboard: no installed voice called '$want'; speak-clipboard --voices lists them" >&2
        return 1
    fi
}

# Rewrites the settings file from f_*. A temp file then a rename, so a
# press never reads half a file; nothing is deleted (see NOTHING IS EVER
# DELETED above).
_write_settings() {
    local tmp="$_settings_file.tmp"
    mkdir -p "${_settings_file%/*}" 2>/dev/null
    if {
        echo "# speak-clipboard settings. Change with: speak-clipboard --set / --reset (--help)"
        [ -n "$f_rate" ]   && echo "rate=$f_rate"
        [ -n "$f_volume" ] && echo "volume=$f_volume"
        [ -n "$f_voice" ]  && echo "voice=$f_voice"
        true
    } >"$tmp" 2>/dev/null && command mv -f "$tmp" "$_settings_file" 2>/dev/null; then
        return 0
    fi
    echo "speak-clipboard: could not write $(_tilde "$_settings_file")" >&2
    return 1
}

# A path with $HOME shown as ~ (a ~ in a ${x/..} replacement is
# tilde-expanded straight back by bash).
_tilde() {
    case "$1" in
        "$HOME"/*) printf '~/%s' "${1#"$HOME"/}" ;;
        *) printf '%s' "$1" ;;
    esac
}

# One line per setting: the value in use and where it came from.
show_settings() {
    local cached_at cached_engine cached_voice cached_for
    printf 'rate    %-44s %s\n' "$rate wpm" "$([ -n "$saved_rate" ] && echo saved || echo default)"
    printf 'volume  %-44s %s\n' "$volume of 100" "$([ -n "$saved_volume" ] && echo saved || echo default)"
    printf 'voice   %-44s %s\n' "$(_voice_label "$_preferred_voice")" "$([ -n "$saved_voice" ] && echo saved || echo default)"
    if [ -f "$_engine_cache" ]; then
        { IFS='|' read -r cached_at cached_engine cached_voice cached_for <"$_engine_cache"; } 2>/dev/null || true
        if [ "${cached_for:-}" = "$_preferred_voice" ] && [ "${cached_voice:-}" != "$_preferred_voice" ]; then
            echo "        NOT INSTALLED: the last press fell back to $cached_engine, $(_voice_label "$cached_voice")"
        fi
    fi
    [ -z "$_bad_settings" ] || echo "ignored: saved $_bad_settings not valid, default used instead (fix with --set)"
    echo "file    $(_tilde "$_settings_file")"
}

# --help's middle section. Printed from the _default_* values, not typed into
# the USAGE text, so the help can never disagree with what a press uses.
show_recommended() {
    local f='  %-8s %-31s %s\n' mark
    echo "RECOMMENDED VALUES (the defaults, tuned by ear; --reset all returns to them)"
    printf "$f" "" "recommended" "now"
    mark=" (default)"; [ -n "$saved_rate" ] && mark=" (saved)"; [ -n "$cli_rate" ] && mark=" (this press)"
    printf "$f" rate "$_default_rate wpm" "$rate wpm$mark"
    mark=" (default)"; [ -n "$saved_volume" ] && mark=" (saved)"; [ -n "$cli_volume" ] && mark=" (this press)"
    printf "$f" volume "$_default_volume of 100" "$volume of 100$mark"
    mark=" (default)"; [ -n "$saved_voice" ] && mark=" (saved)"
    printf "$f" voice "$(_voice_label "$_default_voice")" "$(_voice_label "$_preferred_voice")$mark"
    echo
}


# One line per press. A line here means the key reached herdr and this script
# ran; no line means the key or the spawn is at fault. Never any text.
trace() {
    local ts
    if ((BASH_VERSINFO[0] > 4 || (BASH_VERSINFO[0] == 4 && BASH_VERSINFO[1] >= 2))); then
        TZ=UTC printf -v ts '%(%FT%TZ)T' -1
    else
        ts="$(date -u +%FT%TZ)"
    fi
    printf '%s mode=%s ppid=%s %s\n' "$ts" "$mode" "${PPID:-?}" "$*" >>"$_trace_file" 2>/dev/null
}

# Log trimming runs once, at exit, off the press path. The lock needs no
# release: it goes when fd 9 closes.
_trim_log() {
    local f="$1" max="$2" n
    [ -f "$f" ] || return 0
    n="$(wc -l <"$f" 2>/dev/null)" || return 0
    [ "${n:-0}" -gt "$max" ] || return 0
    tail -n "$max" "$f" >"$f.tmp" 2>/dev/null && command mv -f "$f.tmp" "$f" 2>/dev/null
}
_on_exit() {
    _trim_log "$_trace_file" 200
    _trim_log "$_render_log" 400
}
trap _on_exit EXIT

# flock via macOS `lockf` on fd 9, opened for append so the file is created
# if missing and never truncated. -t 0: fail at once if held (exit 75),
# never queue. MEASURED 2026-09-28: a second taker gets 75 while the first
# holds, 0 once it exits or is SIGKILLed; and a background child that
# inherits fd 9 keeps the lock after the script exits, which is why every
# speaker in start_speaker is launched with 9>&-.
acquire_lock() {
    exec 9>>"$_lock_file" || return 1
    lockf -s -t 0 9
}

# Sets _speaker to the pid of the live speaker, or returns 1. The pid file
# holds a pid and that process's start time; it is never removed, only
# overwritten by the next start, so a finished speaker leaves a stale file
# that this check must reject. It holds either a lone say2/say pid, or
# (streaming, v4.4) the leader of a process group running say2 | ffplay;
# _speaker_group is set to 1 in that case. `kill -0` alone is not enough:
# pids are recycled, so the process must have the same start time AND be one
# of our engines (or lead a group holding one) before anyone signals it.
# A process's start time with all whitespace removed. `ps -o lstart=` pads
# its output with trailing spaces and `read` strips them, so the raw strings
# never compare equal (MEASURED: that bug made every stop report idle).
_start_of() {
    local s
    s="$(ps -o lstart= -p "$1" 2>/dev/null)"
    printf '%s' "${s//[[:space:]]/}"
}

speaker_alive() {
    local p="" stamp="" comm=""
    _speaker=""
    _speaker_group=""
    [ -f "$_pid_file" ] || return 1
    { read -r p; read -r stamp; } <"$_pid_file" 2>/dev/null || true
    case "$p" in
        ''|*[!0-9]*) return 1 ;;
    esac
    [ -n "$stamp" ] && [ "$(_start_of "$p")" = "$stamp" ] || return 1
    comm="$(ps -o comm= -p "$p" 2>/dev/null)"
    case "${comm##*/}" in
        say2|say) _speaker="$p"; return 0 ;;
    esac
    if [ -n "$comm" ] && [ -n "$(pgrep -g "$p" -x 'say2|ffplay' 2>/dev/null)" ]; then
        _speaker="$p"; _speaker_group=1; return 0
    fi
    return 1
}

# Returns 0 if something was actually stopped. SIGKILL straight away: say2
# ignores SIGTERM once playback has started (v4.2 note up top), and a
# SIGTERM-then-wait cost ~0.6 s of audible lag (v4.3). speaker_alive has
# already confirmed the pid is ours, so a recycled pid is never hit. A
# streaming speaker is killed as a whole group, so say2 does not keep
# rendering into a dead pipe and hold up the next press.
stop_speaker() {
    local rc=1
    if speaker_alive; then
        if [ -n "$_speaker_group" ]; then
            kill -KILL -- "-$_speaker" 2>/dev/null && rc=0
        else
            kill -KILL "$_speaker" 2>/dev/null && rc=0
        fi
    fi
    return $rc
}

# Text goes in as an argv element (2026-09-10, see the v4.1 note up top --
# reversed from the original "never argv" design on purpose, traded away for
# speed). `trap '' HUP; exec` replaces nohup: the speaker must outlive this
# script, and exec keeps $! equal to its own pid (see speaker_alive: it checks
# the live process really is say2 or say before anyone signals it). say2 MUST
# be invoked as the bare `say2 -v ... TEXT` form, never `say2 synthesize` --
# synthesize is the slow path regardless of how text reaches it (MEASURED).
#
# Streaming (v4.4): with the default say2 voice and ffplay on PATH, say2
# writes raw PCM to stdout as it renders and ffplay plays it, so speech starts
# in ~0.3 s instead of after the whole render. `set -m` gives the pair its own
# process group, whose leader pid goes in the pid file for stop_speaker. An
# explicit --voice skips streaming, since it may name a non-Siri voice and
# stdout streaming needs `--engine siri` stated.
#
# -infbuf is load-bearing (v4.6, 2026-09-28). Without it ffplay reads only
# about a second ahead, say2's writes stall, and say2 ends the render early:
# "Synthesis produced only 5.178 seconds of audio [exit 6]" on a 1,401-char
# selection whose full audio is 39.6 s, cutting off mid-sentence. MEASURED
# the same text three ways: fast reader 39.6 s; ffplay 5.2 s + that error;
# ffplay -infbuf 40.1 s wall, no error. (A say2 bug too: a slow consumer
# should slow it down, not truncate it. Filed with the other say2 items.)
start_speaker() {
    resolve_engine
    if [ "$_engine" = "say2" ] && [ -z "$voice" ] && command -v ffplay >/dev/null 2>&1; then
        set -m
        ( trap '' HUP
          say2 -v "$_engine_voice" -r "$rate" --engine siri --format pcm -o - "$text" \
              2>>"$_render_log" |
              ffplay -nodisp -autoexit -infbuf -loglevel error -volume "$volume" \
                  -f s16le -ar 48000 -ch_layout mono -i - >/dev/null 2>>"$_render_log"
        ) >/dev/null 2>&1 9>&- &
        set +m
    elif [ "$_engine" = "say2" ]; then
        ( trap '' HUP; exec say2 -v "$_engine_voice" -r "$rate" "$text" ) \
            >/dev/null 2>>"$_render_log" 9>&- &
    else
        ( trap '' HUP; exec say -v "$_engine_voice" -r "$rate" "$text" ) \
            >/dev/null 2>>"$_render_log" 9>&- &
    fi
    local p=$!
    printf '%s\n%s\n' "$p" "$(_start_of "$p")" >"$_pid_file"
}

# ---------------------------------------------------------------------------
# The cleaner. Prints four lines: sha256, truncated (0/1), chars, text.
# ---------------------------------------------------------------------------
read -r -d '' _clean_pl <<'PERL' || true
use strict; use warnings;
use Encode qw(decode);
use Unicode::Normalize qw(NFD);
use Digest::SHA qw(sha256_hex);
my $max = $ARGV[0] || 8000;

# --- Tables (v4.7) ---------------------------------------------------------
# A box-drawn or markdown table is re-spoken row by row as
#   "Row 1. Source. The record body... What it adds to a PADD. The detail..."
# Every name and cell becomes its own sentence because the full stop is what
# makes the voice pause; cells already hold commas, so a comma separator
# would sound like one more list item. Cells split on the vertical bars, not
# on column positions, so a table pasted with ragged indentation still
# parses. Lines between two rules are one row (a cell wrapped onto several
# lines is rejoined). A column empty in every row (an outer frame) is
# dropped. No header divider -> cells are just joined with full stops.
my $VB = qr/[\x{2502}\x{2503}\x{2551}]/;       # box verticals
sub _is_rule { $_[0] =~ /^[\s\x{2500}-\x{257F}]*[\x{2500}\x{2501}\x{2550}]{3}[\s\x{2500}-\x{257F}]*$/ }
sub _is_md_rule { $_[0] =~ /^\s*\|?\s*:?-{3,}:?\s*(?:\|\s*:?-{3,}:?\s*)+\|?\s*$/ }
sub _is_md_row { my $l = shift; return 0 unless $l =~ /^\s*\|.*\|\s*$/; my $n = () = $l =~ /\|/g; return $n >= 3 }
sub _vbars { my $n = () = $_[0] =~ /$VB/g; return $n }
# Cells of one row, WITHOUT the pieces outside the outermost bars. A box row
# is cut at the junction positions of the nearest rule line (lined up on the
# row's first bar, so ragged indentation is fine), which keeps a literal bar
# INSIDE a cell as text (v4.9: "│ Check │ Result │ cafe" in a cell became
# three extra columns). When the positions do not land on bars (wide
# characters, a hand-drawn table) it falls back to splitting on every bar.
sub _cut_by_rule {
    my ($l, $r) = @_;
    return undef unless defined $r;
    my @rj;
    while ($r =~ /[\x{2500}-\x{257F}]/g) {
        my $p = pos($r) - 1;
        push @rj, $p unless substr($r, $p, 1) =~ /[\x{2500}\x{2501}\x{2550}\x{2504}-\x{250B}\x{254C}\x{254D}]/;
    }
    return undef if @rj < 2 || $l !~ /$VB/;
    my $shift = $-[0] - $rj[0];
    my @b = map { $_ + $shift } @rj;
    for my $p (@b) {
        return undef if $p < 0 || $p >= length($l) || substr($l, $p, 1) !~ /$VB/;
    }
    my @c = map { substr($l, $b[$_] + 1, $b[$_ + 1] - $b[$_] - 1) } 0 .. $#b - 1;
    s/^\s+|\s+$//g for @c;
    return \@c;
}
sub _cells {
    my ($l, $md, $rule) = @_;
    if (!$md) {
        my $c = _cut_by_rule($l, $rule);
        return $c if $c;
    }
    my @c = $md ? split(/\|/, $l, -1) : split(/$VB/, $l, -1);
    shift @c; pop @c;                           # outside the outermost bars
    s/^\s+|\s+$//g for @c;
    return \@c;
}
sub _sentence {
    my $s = shift // '';
    $s =~ s/\s+/ /g; $s =~ s/^ | $//g;
    return '' if $s eq '';
    $s =~ s/[:;,]$//;
    $s .= '.' unless $s =~ /[.!?]$/;
    return $s;
}
sub _merge {                                    # lines of one row -> one cell list
    my @m;
    for my $line (@_) {
        for my $i (0 .. $#$line) {
            my $c = $line->[$i];
            $m[$i] = (defined $m[$i] && $m[$i] ne '') ? ($c eq '' ? $m[$i] : "$m[$i] $c") : $c;
        }
    }
    return \@m;
}
sub _speak_table {
    my ($groups, $md) = @_;
    my @rows;
    if (@$groups == 2) {
        # Header divider only: each line is a row, except that a line whose
        # first NAMED column is empty continues the row above (a wrapped cell).
        my $h = _merge(@{ $groups->[0] });
        push @rows, $h;
        my ($k) = grep { defined $h->[$_] && $h->[$_] ne '' } 0 .. $#$h;
        my @pending;
        for my $line (@{ $groups->[1] }) {
            if (!$md && @pending && defined $k && ($line->[$k] // '') eq '') {
                push @{ $pending[-1] }, $line;
            } else {
                push @pending, [$line];
            }
        }
        push @rows, _merge(@$_) for @pending;
    } else {
        push @rows, _merge(@$_) for @$groups;
    }
    my $ncol = 0; for (@rows) { $ncol = @$_ if @$_ > $ncol }
    my @keep = grep { my $j = $_; grep { defined $_->[$j] && $_->[$j] ne '' } @rows } 0 .. $ncol - 1;
    my @out;
    if (@$groups >= 2 && @rows >= 2) {
        my $h = shift @rows;
        my $n = 0;
        for my $r (@rows) {
            my @parts = ('Row ' . (++$n) . '.');
            for my $j (@keep) {
                my $c = _sentence($r->[$j]);
                next if $c eq '';
                push @parts, (_sentence($h->[$j]) || 'Column ' . ($j + 1) . '.'), $c;
            }
            push @out, join(' ', @parts);
        }
    } else {
        for my $r (@rows) {
            push @out, join(' ', grep { $_ ne '' } map { _sentence($r->[$_]) } @keep);
        }
    }
    return @out;
}
sub _tables {
    my @lines = split /\n/, $_[0], -1;
    my @out;
    my $i = 0;
    while ($i < @lines) {
        my $l = $lines[$i];
        my $box = _is_rule($l) || _vbars($l) >= 2;
        my $md = !$box && _is_md_row($l) && $i + 1 < @lines && _is_md_rule($lines[$i + 1]);
        if (!$box && !$md) { push @out, $l; $i++; next }
        my (@groups, @cur, $rule);
        while ($i < @lines) {
            my $x = $lines[$i];
            if ($md ? _is_md_rule($x) : _is_rule($x)) {
                if (@cur) { push @groups, [@cur]; @cur = () }
                $rule = $x unless $md;
                $i++; next;
            }
            last unless $md ? _is_md_row($x) : _vbars($x) >= 2;
            push @cur, _cells($x, $md, $rule);
            $i++;
        }
        push @groups, [@cur] if @cur;
        if (@groups == 1 && @{ $groups[0] } > 1) {  # no rules at all: each line alone
            @groups = map { [$_] } @{ $groups[0] };
            push @out, _speak_table([$_], $md) for @groups;
        } elsif (@groups) {
            push @out, _speak_table(\@groups, $md);
        }
    }
    return join("\n", @out);
}
# ---------------------------------------------------------------------------

local $/;
my $raw = <STDIN>;
$raw = '' unless defined $raw;
my $t = decode('UTF-8', $raw);                  # malformed bytes become U+FFFD, dropped below
$t =~ s/\e\[[0-9;?]*[ -\/]*[@-~]//g;            # ANSI CSI
$t =~ s/\e\][^\a]*(?:\a|\e\\)//g;               # OSC (titles, hyperlinks)
$t = _tables($t);                               # tables -> "Row 1. Name. Cell." (v4.7)
$t =~ s/[\x{2018}\x{2019}\x{201A}\x{2032}]/'/g; # single curly quotes, prime
$t =~ s/[\x{201C}\x{201D}\x{201E}\x{2033}]/"/g; # double curly quotes, double prime
$t =~ s/\p{Pd}/-/g;                             # every dash
$t =~ s/\x{2026}/.../g;                         # ellipsis
$t =~ s/\p{Zs}/ /g;                             # every space separator (NBSP etc.)
$t = NFD($t);                                   # split letters from their accents
$t =~ s/\p{Mn}//g;                              # drop the accents, keep the letters
# Letters with no decomposition: NFD cannot help, so map the common ones.
$t =~ s/\x{0141}/L/g; $t =~ s/\x{0142}/l/g;     # L-stroke
$t =~ s/\x{00D8}/O/g; $t =~ s/\x{00F8}/o/g;     # O-slash
$t =~ s/\x{00C6}/AE/g; $t =~ s/\x{00E6}/ae/g;   # ash
$t =~ s/\x{0152}/OE/g; $t =~ s/\x{0153}/oe/g;   # ethel
$t =~ s/\x{00DF}/ss/g;                          # eszett
$t =~ s/\x{0110}/D/g; $t =~ s/\x{0111}/d/g;     # D-stroke
$t =~ s/\x{00DE}/Th/g; $t =~ s/\x{00FE}/th/g;   # thorn
$t =~ s/\[\[/[ [/g;                             # no embedded speech commands
$t =~ s/[^\t\n\r\x20-\x7e]//g;                  # everything else outside printable ASCII
$t =~ s/[-=_.~*#+]{4,}/ /g;                     # rule runs and padding
$t =~ s/^[-*] +//mg;                            # list markers
$t =~ s/[ \t\r]+/ /g;                           # collapse spaces within lines
$t =~ s/^ | $//mg;                              # trim each line
$t =~ s/\n+/ /g;                                # join lines (drops blank lines)
$t =~ s/ {2,}/ /g;
$t =~ s/^ | $//g;
my $orig = length $t;
$t = substr($t, 0, $max) if $orig > $max;
print sha256_hex($t), "\n", ($orig > $max ? 1 : 0), "\n", length($t), "\n", $t, "\n";
PERL

clean_input() {
    if [ "$from_stdin" = 1 ]; then
        perl -e "$_clean_pl" -- "$_max_chars" 2>/dev/null
    else
        # LC_ALL is load-bearing (v4.8, 2026-09-28). pbpaste picks its output
        # encoding from the locale, and herdr launches this with none, so
        # every non-ASCII character came out as '?': box-drawn tables were
        # never seen as tables, and curly quotes and accents were lost.
        # MEASURED: Gavin's 5-row table logged 1255 chars from the hotkey;
        # the same table with each non-ASCII char made '?' cleans to exactly
        # 1255, intact UTF-8 to 451. `env -i pbpaste` printed "? Check ?",
        # the same with LC_ALL=en_US.UTF-8 or en_AU.UTF-8 printed the box bars.
        # en_AU is Gavin's own locale (his call, 2-way tested).
        LC_ALL=en_AU.UTF-8 pbpaste 2>/dev/null | perl -e "$_clean_pl" -- "$_max_chars" 2>/dev/null
    fi
}

# ---------------------------------------------------------------------------
# Modes
# ---------------------------------------------------------------------------
# A --set or --reset re-runs this script as --settings, so what it prints is
# read back from the file just written, not from memory.
case "$mode" in
    help)
        # The USAGE text from the header, then the recommended values, then
        # the exit codes. Each sed range drops its closing heading line.
        sed -n '/^# USAGE/,/^# EXIT CODES/p' "$0" | sed '$d' | sed 's/^# \{0,1\}//'
        show_recommended
        sed -n '/^# EXIT CODES/,/^# SETTINGS FILE/p' "$0" | sed '$d' | sed 's/^# \{0,1\}//'
        exit 0 ;;
    settings) show_settings; exit 0 ;;
    get)
        case "$set_key" in
            rate)   echo "$rate" ;;
            volume) echo "$volume" ;;
            voice)  echo "$_preferred_voice" ;;
            all)    printf 'rate=%s\nvolume=%s\nvoice=%s\n' "$rate" "$volume" "$_preferred_voice" ;;
            *) echo "speak-clipboard: --get takes rate, volume or voice, not '$set_key'" >&2; exit 1 ;;
        esac
        exit 0 ;;
    voices)   show_voices; exit $? ;;
    set)
        case "$set_key" in
            rate)   _valid_rate "$set_value" || { echo "speak-clipboard: rate takes a whole number 1-700 (say2's own limit)" >&2; exit 1; }
                    f_rate="$set_value" ;;
            volume) _valid_volume "$set_value" || { echo "speak-clipboard: volume takes a whole number 0-100" >&2; exit 1; }
                    f_volume="$set_value" ;;
            voice)  _pick_voice "$set_value" || exit 1
                    f_voice="$_picked_voice" ;;
            *) echo "speak-clipboard: --set takes rate, volume or voice, not '$set_key'" >&2; exit 1 ;;
        esac
        _write_settings || exit 1
        exec "$0" --settings ;;
    reset)
        case "$set_key" in
            rate)   f_rate="" ;;
            volume) f_volume="" ;;
            voice)  f_voice="" ;;
            all)    f_rate=""; f_volume=""; f_voice="" ;;
            *) echo "speak-clipboard: --reset takes rate, volume, voice or all, not '$set_key'" >&2; exit 1 ;;
        esac
        # Before, then after (Gavin's ask, 2026-10-08). "Before" is the saved
        # state, so a --rate or --volume on the same command does not show.
        rate="${saved_rate:-$_default_rate}"; volume="${saved_volume:-$_default_volume}"
        echo "BEFORE"
        show_settings | sed '/^file /d'
        echo
        _write_settings || exit 1
        echo "AFTER"
        exec "$0" --settings ;;
esac

if [ "$mode" = "print" ]; then
    { IFS= read -r hash; IFS= read -r truncated; IFS= read -r chars; IFS= read -r text; } < <(clean_input)
    if [ -z "${text:-}" ]; then
        echo "(nothing to speak -- clipboard empty or all decoration)"
        exit 1
    fi
    printf '%s\n' "$text"
    exit 0
fi

acquire_lock || { trace "outcome=busy"; exit 0; }

if [ "$mode" = "stop" ]; then
    if stop_speaker; then trace "outcome=stopped"; else trace "outcome=idle"; fi
    exit 0
fi

# Toggle rule (v5): any press while speaking stops, whatever the clipboard
# holds. Checked before the clipboard is read, so a stop costs no cleaner run.
if [ "$mode" = "toggle" ] && speaker_alive; then
    stop_speaker
    trace "outcome=stopped"
    exit 0
fi

{ IFS= read -r hash; IFS= read -r truncated; IFS= read -r chars; IFS= read -r text; } < <(clean_input)
if [ -z "${text:-}" ]; then
    trace "outcome=nothing"
    exit 1
fi

# Plain speak mode always replaces whatever is speaking.
outcome="started"
if speaker_alive; then
    stop_speaker
    outcome="replaced"
fi

start_speaker
trace "outcome=$outcome chars=$chars truncated=$truncated${_bad_settings:+ settings=bad:$_bad_settings}"
exit 0
