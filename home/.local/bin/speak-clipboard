#!/usr/bin/env bash
# ============================================================================
#  speak-clipboard -- read the clipboard aloud, without reading the furniture
# ============================================================================
#
# WHY
# ---
# macOS "Speak selection" cannot see a selection made inside herdr: herdr
# captures the mouse, so the selection lives in its process memory and is never
# published to the accessibility API. The clipboard is the only bridge, since
# herdr's copy_on_select means a drag has already copied by the time you let go.
#
# But speaking the clipboard raw is unpleasant, because a terminal selection is
# not prose. It carries pane borders, Powerlevel10k prompt decoration, Nerd Font
# glyphs from the private use area, box drawing, and separator runs. A speech
# engine pronounces those -- the reported symptom was "F" and "F dash" chanted
# at the end of every line -- and the actual words get lost in the noise.
#
# So this strips the furniture before speaking. The native accessibility hotkey
# CANNOT do this: it reads the raw screen, decoration and all. That asymmetry is
# the main argument for going through the clipboard at all.
#
# WHAT IT STRIPS (and why each)
#   * ANSI/OSC escape sequences  -- colour and title codes, never spoken content
#   * anything outside printable ASCII -- box drawing, Nerd Font PUA glyphs,
#     emoji, the middle dots p10k uses as separators
#   * runs of punctuation used as rules or padding (----, ====, ....)
#   * repeated blank lines and collapsed whitespace, which become dead air
#
# Deliberately NOT stripped: ordinary punctuation inside sentences, code
# symbols, and paths. Those carry meaning when read aloud.
#
# SPEED
# ----
# Default is 278 wpm, which is 1.5x. That number was MEASURED, not guessed:
# `say` with no -r runs at 175 wpm (a fixed sample rendered identically with
# `-r 175` and with no flag at all), and rendering the same sample across a
# sweep of rates put 278 wpm at exactly 1.50x the baseline duration. Duration
# is not perfectly inverse to rate -- there is fixed padding around phrases --
# so 175 * 1.5 = 262 is measurably too slow, at 1.44x.
#
# USAGE
#   speak-clipboard              speak the clipboard
#   speak-clipboard --toggle     speak, or stop if already speaking
#   speak-clipboard --print      print what WOULD be spoken (no audio)
#   speak-clipboard --stop       stop any speech in progress
#   speak-clipboard --rate N     words per minute (default: 278 = 1.5x)
#   speak-clipboard --voice NAME voice to use (see `say -v '?'`)
#
# EXIT CODES
#   0  spoke, printed, stopped, or toggled cleanly
#   1  nothing to say (clipboard empty, or empty once cleaned)
# ============================================================================
set -uo pipefail

rate="420"
voice=""
mode="speak"

while [ $# -gt 0 ]; do
    case "$1" in
        --print)  mode="print";  shift ;;
        --stop)   mode="stop";   shift ;;
        --toggle) mode="toggle"; shift ;;
        --rate)  rate="${2:-}"; shift 2 ;;
        --voice) voice="${2:-}"; shift 2 ;;
        -h|--help) sed -n '/^# USAGE/,/^# EXIT/p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
        *) echo "speak-clipboard: unknown option '$1'" >&2; exit 1 ;;
    esac
done

# Invocation trace. One line per run, no clipboard CONTENT ever written -- just
# when it ran and in which mode. This exists because when a keybinding "does
# nothing" there are two indistinguishable explanations: the key never reached
# herdr, or it did and the command failed. A line here means the script ran, so
# the fault is downstream; no line means the key or the spawn is at fault. Cheap
# enough to leave on permanently, and it turns a guessing game into a lookup.
_trace_dir="${XDG_STATE_HOME:-$HOME/.local/state}/herdr"
mkdir -p "$_trace_dir" 2>/dev/null
printf '%s mode=%s ppid=%s\n' "$(date -u +%FT%TZ)" "$mode" "${PPID:-?}" \
    >>"$_trace_dir/speak-clipboard.log" 2>/dev/null || true

# -x matches the executable name exactly, so this cannot hit anything whose
# command line merely mentions "say".
if [ "$mode" = "stop" ]; then
    pkill -x say 2>/dev/null
    exit 0
fi

# Toggle: the same key starts and stops, mirroring how the macOS Spoken Content
# hotkey behaves. Speech is a detached `say` process, so "is it speaking?" is
# simply "does one exist?" -- no state file to go stale.
if [ "$mode" = "toggle" ]; then
    if pgrep -x say >/dev/null 2>&1; then
        pkill -x say 2>/dev/null
        exit 0
    fi
    mode="speak"
fi

clean() {
    # 1. ANSI CSI + OSC escape sequences.
    # 2. Everything outside tab/newline/printable-ASCII. This is the blunt one,
    #    and the blunt one is correct here: every glyph a terminal draws for
    #    decoration lives outside ASCII, and every word worth speaking does not.
    # 3. Punctuation runs of 4+ used as horizontal rules or padding.
    # 4. Whitespace collapse, then drop lines that are now empty.
    sed -E $'s/\033\\[[0-9;?]*[ -\/]*[@-~]//g; s/\033\\][^\a]*(\a|\033\\\\)//g' \
    | LC_ALL=C tr -cd '\11\12\15\40-\176' \
    | sed -E 's/[-=_.~*#+]{4,}/ /g; s/[[:space:]]+/ /g; s/^ //; s/ $//' \
    | grep -v '^$'
}

text="$(pbpaste 2>/dev/null | clean)"

if [ -z "${text//[[:space:]]/}" ]; then
    [ "$mode" = "print" ] && echo "(nothing to speak -- clipboard empty or all decoration)"
    exit 1
fi

if [ "$mode" = "print" ]; then
    printf '%s\n' "$text"
    exit 0
fi

args=()
[ -n "$voice" ] && args+=(-v "$voice")
[ -n "$rate" ]  && args+=(-r "$rate")

printf '%s' "$text" | say "${args[@]}"
