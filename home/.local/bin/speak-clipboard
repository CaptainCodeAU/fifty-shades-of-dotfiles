#!/usr/bin/env bash
# ============================================================================
#  speak-clipboard -- read the clipboard aloud, without reading the furniture
# ============================================================================
#
# WHY
# ---
# macOS "Speak selection" cannot see a selection made inside herdr: herdr
# captures the mouse, so the selection lives in its process memory and is never
# published to the accessibility API. The clipboard is the only bridge, since
# herdr's copy_on_select means a drag has already copied by the time you let go.
#
# But speaking the clipboard raw is unpleasant, because a terminal selection is
# not prose. It carries pane borders, Powerlevel10k prompt decoration, Nerd Font
# glyphs from the private use area, box drawing, and separator runs. A speech
# engine pronounces those -- the reported symptom was "F" and "F dash" chanted
# at the end of every line -- and the actual words get lost in the noise.
#
# So this strips the furniture before speaking. The native accessibility hotkey
# CANNOT do this: it reads the raw screen, decoration and all. That asymmetry is
# the main argument for going through the clipboard at all.
#
# WHAT THE CLEANER DOES (one perl pass, in this order, and why each)
#   * ANSI/OSC escape sequences are removed -- colour and title codes, never
#     spoken content
#   * typographic punctuation is MAPPED, not dropped: curly quotes -> straight,
#     every Unicode dash -> hyphen, ellipsis -> "...", every space separator ->
#     space. Accented letters are decomposed and their marks removed, so "cafe"
#     with an acute and "Dvorak" with a caron both survive. Without this, "I'm"
#     with a curly apostrophe became "Im".
#   * "[[" is split into "[ [" so clipboard text cannot smuggle embedded
#     speech-engine commands like [[slnc 60000]] (a 60 s silence)
#   * everything still outside printable ASCII is dropped -- box drawing, Nerd
#     Font PUA glyphs, emoji, the middle dots p10k uses as separators
#   * runs of punctuation used as rules or padding (----, ====, ....)
#   * leading "- " / "* " list markers, blank lines, and whitespace runs, which
#     become dead air; everything is joined to one line because the engine
#     pauses on every line break (MEASURED: 20 words took 4.64 s as one line
#     and 6.98 s as ten short lines); joining here means say2 gets one clean run
#   * the result is capped at 8000 chars (~2 min of speech; stop is instant)
#
# Deliberately NOT stripped: ordinary punctuation inside sentences, code
# symbols, and paths. Those carry meaning when read aloud.
#
# Why one perl pass and not sed | tr | grep: the old pipeline was seven forks
# (~21 ms per press); this is one (~6 ms), and it also computes the SHA-256 the
# toggle rule needs, so `shasum` (a 14 ms perl script of its own) is not spawned.
# All three modules (Encode, Unicode::Normalize, Digest::SHA) are core perl.
#
# SPEED
# ----
# Default is 420 wpm, set by hand after listening to 278 wpm (1.5x) and
# finding it too slow. `say` with no -r runs at 175 wpm; 420 lands around
# 2.4x that baseline. Re-tune by listening, not by arithmetic. say2's `-r` is
# documented as the same say-compatible WPM scale, so the number carried over
# unchanged across the engine switch below.
#
# VOLUME
# ------
# Not controlled here. Speech plays through the current output device at the
# system volume. Use the volume keys or the menu-bar slider. (say2's own
# --volume flag is a documented no-op on the siri engine anyway.)
#
# ONE PROCESS PER PRESS, DIRECT TO say2 (v4, 2026-09-10)
# --------------------------------------------------------
# History, so nobody rebuilds any of this: v1 shelled out to `say` (1 s before
# the first word, every press). v2 kept a background daemon warm to save that
# second; it saved ~0.5 s and brought a socket, a singleton race, a process
# that never exited, a lock that stopped the Mac from sleeping, and a toggle
# that silently cancelled long text because it rendered the WHOLE selection to
# a file before playing any of it (10+ s of silence on a long selection).
# v3 fixed that by hand-building a chunked pipeline in Swift
# (speak-render.swift, since deleted): split text at sentence ends, render
# sentence 1 via NSSpeechSynthesizer (~0.7 s), start playing it, render the
# rest while it plays.
#
# v4 (this) deletes that pipeline. `say2` (https://github.com/CaptainCodeAU/say2)
# reaches the same premium Aaron voice (now the "natural" tier,
# en-US:natural:male:Aaron:premium:5030 -- a better tier than NSSpeechSynthesizer
# could even reach) and already streams internally: MEASURED on this Mac
# 2026-09-10, direct playback of a 16.1 s / ~120-word paragraph
# (`say2 -v ... "$text"`, no -o) took 16.7 s wall-clock total -- about 0.65 s of
# overhead before/around the speech, not 0.65 s PLUS a multi-second render-first
# wait. Rendering that same paragraph to a file first (`-o`, the old chunked
# design's approach) took 5.0 s before any audio could start -- proof the old
# problem is real, but proof say2's own direct-play mode already solves it, so
# building a second chunker on top of it would just be solving it twice.
# So: one `say2` process per press, playing straight to the default audio
# device. STOP is killing that process (MEASURED: kill-to-exit was ~15 ms in
# testing -- audio stops with the process).
#
# v4.1 (2026-09-10, same day): two corrections after Gavin reported the real
# hotkey taking 2-3 s to start speaking, which the numbers above did not
# predict.
#
# First, `say2 synthesize` (the subcommand) is measurably slower than the bare
# `say2 -v ... TEXT` form REGARDLESS of how text reaches it -- MEASURED both
# ways, repeated, ~2-4 s of overhead on `synthesize` either via stdin or argv,
# vs ~0.6-0.7 s on the bare form. Switched to the bare form and, since that
# form only reliably streams fast with TEXT as a normal argument (not stdin,
# not `-f FILE` -- both measured slower too), text now goes on argv. That is a
# deliberate reversal of this file's original "never argv" privacy design:
# Gavin chose speed after seeing the actual trade-off (text briefly visible in
# `ps` output while speaking, on his own single-user Mac).
#
# Second, and this is the part argv did NOT fix: paired testing (same command,
# run twice) showed the SAME command is slow (~1-2.6 s of overhead, noisy)
# on the first call after any real pause, and fast (~0.6 s) on a second call
# fired immediately after. That is the actual 2-3 s Gavin was hearing --
# selecting text, then pressing the key, is always a "first call". Tried
# feeding it a silent warm-up ping beforehand (both `--no-output` and `-o
# FILE`, ~0.3 s / ~30 MB each, genuinely cheap) and MEASURED that neither
# changes the real call's timing at all -- the cold cost is not in the
# synthesis engine, which is already fast every time. Best-evidenced guess:
# it is the audio OUTPUT device (not the voice model) waking from idle, which
# a silent-only ping does not touch. A ping that reliably fixed this would
# have to make a real (if quiet) sound every few minutes -- Gavin decided
# against building that (uncertain payoff, adds a periodic background noise)
# on 2026-09-10. So: this delay is accepted as a trait of the voice pipeline,
# not something this script tries to hide.
#
# FALLBACK (2026-09-10): say2 reaches a private Apple framework that a macOS
# update can remove or rename without warning (it exits 69 for exactly that
# case), and a fresh machine may have say2 installed but not the premium Siri
# voice downloaded. Neither should mean silence. resolve_engine() picks Aaron,
# then Simone (the two premium Siri "natural" voices), then the always-present
# `say` binary with voice Samantha, in that order -- checked once and cached
# for a day (see resolve_engine's own comment) so a normal press costs a file
# read, not a live probe. `--voice` bypasses all of this and goes straight to
# say2 with the given key, trusting an explicit override as-is.
#
# The toggle rule: press on the SAME text while it speaks = stop. Press with
# NEW text while it speaks = stop the old one and speak the new one. Text
# identity is a SHA-256 of the cleaned text, kept next to the pid file.
#
# PRIVACY: the text is never logged. It DOES pass on the command line as of
# v4.1 above (a deliberate speed-over-privacy trade, see that note) -- it is
# visible in `ps` output to anyone with shell access on this Mac for as long
# as the utterance is speaking, which the original v1-v4 design specifically
# avoided. Their stderr is still captured for diagnostics, never the text.
#
# CONCURRENCY: key auto-repeat or a double tap runs this script twice within
# a few ms. An atomic mkdir lock serialises the check-stop-start section; the
# loser records outcome=busy and exits 0 (never queues -- N repeats would mean
# N toggles). The pid file is trusted only if that pid is a live say2/say
# (pids are recycled; a stale file must never kill a stranger).
#
# USAGE
#   speak-clipboard              speak the clipboard (replacing any current speech)
#   speak-clipboard --toggle     same text: stop; new text: replace; idle: speak
#   speak-clipboard --stop       stop any speech in progress
#   speak-clipboard --print      print what WOULD be spoken (no audio)
#   speak-clipboard --stdin      read text from stdin instead of the clipboard
#                                (for tests; combine with --print/--toggle)
#   speak-clipboard --rate N     words per minute (default: 420)
#   speak-clipboard --voice KEY  say2 voice asset key or display name -- bypasses
#                                the Aaron/Simone/say fallback chain entirely
#                                (default when omitted: en-US:natural:male:Aaron:premium:5030,
#                                falling back through Simone to `say`/Samantha)
#
# EXIT CODES
#   0  spoke, stopped, replaced, or printed (or lost the lock: busy)
#   1  nothing to say (clipboard empty, or empty once cleaned)
#
# STATE (all under ~/.local/state/herdr/, nothing here ever contains text)
#   speak-clipboard.log    one line per press: when, mode, ppid, outcome, chars
#   speak-render.log       the speaker's stderr, for diagnostics only
#   speak-render.pid/.hash the current speaker's pid and the hash of what it speaks
#   speak-engine.cache     resolve_engine()'s cached choice, refreshed daily
#   speak-clipboard.lock/  the mkdir lock, held for one run of this script
# ============================================================================
set -uo pipefail

# The two premium Siri "natural" voices (Apple's own "Voice 1" / "Voice 2" in
# System Settings > Accessibility > Spoken Content). Aaron first, Simone as a
# second try before giving up on say2 entirely -- either is a real improvement
# over the `say` fallback. `say` itself is always present on macOS, so it is
# the last resort, not a "might also be missing" case.
_default_voice="en-US:natural:male:Aaron:premium:5030"
_secondary_voice="en-US:natural:female:Simone:premium:5029"
_say_fallback_voice="Samantha"
rate="420"
voice=""
mode="speak"
from_stdin=0

while [ $# -gt 0 ]; do
    case "$1" in
        --print)  mode="print";  shift ;;
        --stop)   mode="stop";   shift ;;
        --toggle) mode="toggle"; shift ;;
        --stdin)  from_stdin=1;  shift ;;
        --rate)  rate="${2:-}"; shift 2 ;;
        --voice) voice="${2:-}"; shift 2 ;;
        -h|--help) sed -n '/^# USAGE/,/^# EXIT/p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
        *) echo "speak-clipboard: unknown option '$1'" >&2; exit 1 ;;
    esac
done

_state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/herdr"
_trace_file="$_state_dir/speak-clipboard.log"
_render_log="$_state_dir/speak-render.log"
_pid_file="$_state_dir/speak-render.pid"
_hash_file="$_state_dir/speak-render.hash"
_lock_dir="$_state_dir/speak-clipboard.lock"
_engine_cache="$_state_dir/speak-engine.cache"
_engine_cache_ttl=86400
_max_chars=8000
_have_lock=""
[ -d "$_state_dir" ] || mkdir -p "$_state_dir" 2>/dev/null

# Decide which engine+voice a plain press actually uses, and cache the answer
# for a day so a normal press costs one file read, not a live say2 probe
# (`say2 voices --status` alone measured ~0.1-0.3s -- fine once, not on every
# keystroke). A 24h TTL means a macOS update that silently removes the Siri
# voice heals itself within a day instead of failing forever. Sets _engine
# (say2 or say) and _engine_voice. Skipped entirely when --voice overrides the
# default: an explicit voice is trusted as-is, straight to say2, no fallback.
resolve_engine() {
    if [ -n "$voice" ]; then
        _engine="say2"; _engine_voice="$voice"
        return
    fi
    local now cached_at cached_engine cached_voice
    now="$(date +%s)"
    if [ -f "$_engine_cache" ]; then
        { IFS='|' read -r cached_at cached_engine cached_voice <"$_engine_cache"; } 2>/dev/null || true
        if [ -n "${cached_at:-}" ] && [ $((now - cached_at)) -lt "$_engine_cache_ttl" ]; then
            _engine="$cached_engine"; _engine_voice="$cached_voice"
            return
        fi
    fi
    _engine="say"; _engine_voice="$_say_fallback_voice"
    if command -v say2 >/dev/null 2>&1; then
        local v
        for v in "$_default_voice" "$_secondary_voice"; do
            if say2 voices --status "$v" --json 2>/dev/null | grep -q '"state" *: *"installed"'; then
                _engine="say2"; _engine_voice="$v"
                break
            fi
        done
    fi
    printf '%s|%s|%s\n' "$now" "$_engine" "$_engine_voice" >"$_engine_cache" 2>/dev/null || true
}

# One line per press. A line here means the key reached herdr and this script
# ran; no line means the key or the spawn is at fault. Never any text.
trace() {
    local ts
    if ((BASH_VERSINFO[0] > 4 || (BASH_VERSINFO[0] == 4 && BASH_VERSINFO[1] >= 2))); then
        TZ=UTC printf -v ts '%(%FT%TZ)T' -1
    else
        ts="$(date -u +%FT%TZ)"
    fi
    printf '%s mode=%s ppid=%s %s\n' "$ts" "$mode" "${PPID:-?}" "$*" >>"$_trace_file" 2>/dev/null
}

# Log trimming and lock release run once, at exit, off the press path.
_trim_log() {
    local f="$1" max="$2" n
    [ -f "$f" ] || return 0
    n="$(wc -l <"$f" 2>/dev/null)" || return 0
    [ "${n:-0}" -gt "$max" ] || return 0
    tail -n "$max" "$f" >"$f.tmp" 2>/dev/null && command mv -f "$f.tmp" "$f" 2>/dev/null
}
_on_exit() {
    [ -n "$_have_lock" ] && command rm -rf "$_lock_dir" 2>/dev/null
    _trim_log "$_trace_file" 200
    _trim_log "$_render_log" 400
}
trap _on_exit EXIT

# mkdir is atomic, so two presses cannot both win. A lock whose owner pid is
# dead is stale (a killed script) and is taken over. A lock with no pid file
# yet belongs to a winner that is between mkdir and its echo: if the directory
# is under three seconds old it is live, not stale.
acquire_lock() {
    local owner="" age=0
    if ! mkdir "$_lock_dir" 2>/dev/null; then
        { read -r owner <"$_lock_dir/pid"; } 2>/dev/null || true
        if [ -n "$owner" ]; then
            kill -0 "$owner" 2>/dev/null && return 1
        else
            age=$(( $(date +%s) - $(stat -f %m "$_lock_dir" 2>/dev/null || echo 0) ))
            [ "$age" -lt 3 ] && return 1
        fi
        command rm -rf "$_lock_dir" 2>/dev/null
        mkdir "$_lock_dir" 2>/dev/null || return 1
    fi
    echo $$ >"$_lock_dir/pid"
    _have_lock=1
}

# Sets _speaker to the pid of the live speaker (say2 or its `say` fallback),
# or clears stale state and returns 1. `kill -0` alone is not enough: pids are
# recycled, so the process must also BE one of our two engines before anyone
# sends it a signal.
speaker_alive() {
    local p="" comm=""
    _speaker=""
    [ -f "$_pid_file" ] || return 1
    { read -r p <"$_pid_file"; } 2>/dev/null || true
    case "$p" in
        ''|*[!0-9]*) command rm -f "$_pid_file" "$_hash_file" 2>/dev/null; return 1 ;;
    esac
    comm="$(ps -o comm= -p "$p" 2>/dev/null)"
    case "${comm##*/}" in
        say2|say) ;;
        *) command rm -f "$_pid_file" "$_hash_file" 2>/dev/null; return 1 ;;
    esac
    _speaker="$p"
}

# Returns 0 if something was actually stopped.
stop_speaker() {
    local rc=1
    if speaker_alive; then
        kill "$_speaker" 2>/dev/null && rc=0
    fi
    command rm -f "$_pid_file" "$_hash_file" 2>/dev/null
    return $rc
}

# Text goes in as an argv element (2026-09-10, see the v4.1 note up top --
# reversed from the original "never argv" design on purpose, traded away for
# speed). `trap '' HUP; exec` replaces nohup: the speaker must outlive this
# script, and exec keeps $! equal to its own pid (see speaker_alive: it checks
# the live process really is say2 or say before anyone signals it). say2 MUST
# be invoked as the bare `say2 -v ... TEXT` form, never `say2 synthesize` --
# synthesize is the slow path regardless of how text reaches it (MEASURED).
start_speaker() {
    resolve_engine
    if [ "$_engine" = "say2" ]; then
        ( trap '' HUP; exec say2 -v "$_engine_voice" -r "$rate" "$text" ) \
            >/dev/null 2>>"$_render_log" &
    else
        ( trap '' HUP; exec say -v "$_engine_voice" -r "$rate" "$text" ) \
            >/dev/null 2>>"$_render_log" &
    fi
    echo $! >"$_pid_file"
    echo "$hash" >"$_hash_file"
}

# ---------------------------------------------------------------------------
# The cleaner. Prints four lines: sha256, truncated (0/1), chars, text.
# ---------------------------------------------------------------------------
read -r -d '' _clean_pl <<'PERL' || true
use strict; use warnings;
use Encode qw(decode);
use Unicode::Normalize qw(NFD);
use Digest::SHA qw(sha256_hex);
my $max = $ARGV[0] || 8000;
local $/;
my $raw = <STDIN>;
$raw = '' unless defined $raw;
my $t = decode('UTF-8', $raw);                  # malformed bytes become U+FFFD, dropped below
$t =~ s/\e\[[0-9;?]*[ -\/]*[@-~]//g;            # ANSI CSI
$t =~ s/\e\][^\a]*(?:\a|\e\\)//g;               # OSC (titles, hyperlinks)
$t =~ s/[\x{2018}\x{2019}\x{201A}\x{2032}]/'/g; # single curly quotes, prime
$t =~ s/[\x{201C}\x{201D}\x{201E}\x{2033}]/"/g; # double curly quotes, double prime
$t =~ s/\p{Pd}/-/g;                             # every dash
$t =~ s/\x{2026}/.../g;                         # ellipsis
$t =~ s/\p{Zs}/ /g;                             # every space separator (NBSP etc.)
$t = NFD($t);                                   # split letters from their accents
$t =~ s/\p{Mn}//g;                              # drop the accents, keep the letters
# Letters with no decomposition: NFD cannot help, so map the common ones.
$t =~ s/\x{0141}/L/g; $t =~ s/\x{0142}/l/g;     # L-stroke
$t =~ s/\x{00D8}/O/g; $t =~ s/\x{00F8}/o/g;     # O-slash
$t =~ s/\x{00C6}/AE/g; $t =~ s/\x{00E6}/ae/g;   # ash
$t =~ s/\x{0152}/OE/g; $t =~ s/\x{0153}/oe/g;   # ethel
$t =~ s/\x{00DF}/ss/g;                          # eszett
$t =~ s/\x{0110}/D/g; $t =~ s/\x{0111}/d/g;     # D-stroke
$t =~ s/\x{00DE}/Th/g; $t =~ s/\x{00FE}/th/g;   # thorn
$t =~ s/\[\[/[ [/g;                             # no embedded speech commands
$t =~ s/[^\t\n\r\x20-\x7e]//g;                  # everything else outside printable ASCII
$t =~ s/[-=_.~*#+]{4,}/ /g;                     # rule runs and padding
$t =~ s/^[-*] +//mg;                            # list markers
$t =~ s/[ \t\r]+/ /g;                           # collapse spaces within lines
$t =~ s/^ | $//mg;                              # trim each line
$t =~ s/\n+/ /g;                                # join lines (drops blank lines)
$t =~ s/ {2,}/ /g;
$t =~ s/^ | $//g;
my $orig = length $t;
$t = substr($t, 0, $max) if $orig > $max;
print sha256_hex($t), "\n", ($orig > $max ? 1 : 0), "\n", length($t), "\n", $t, "\n";
PERL

clean_input() {
    if [ "$from_stdin" = 1 ]; then
        perl -e "$_clean_pl" -- "$_max_chars" 2>/dev/null
    else
        pbpaste 2>/dev/null | perl -e "$_clean_pl" -- "$_max_chars" 2>/dev/null
    fi
}

# ---------------------------------------------------------------------------
# Modes
# ---------------------------------------------------------------------------
if [ "$mode" = "print" ]; then
    { IFS= read -r hash; IFS= read -r truncated; IFS= read -r chars; IFS= read -r text; } < <(clean_input)
    if [ -z "${text:-}" ]; then
        echo "(nothing to speak -- clipboard empty or all decoration)"
        exit 1
    fi
    printf '%s\n' "$text"
    exit 0
fi

acquire_lock || { trace "outcome=busy"; exit 0; }

if [ "$mode" = "stop" ]; then
    if stop_speaker; then trace "outcome=stopped"; else trace "outcome=idle"; fi
    exit 0
fi

{ IFS= read -r hash; IFS= read -r truncated; IFS= read -r chars; IFS= read -r text; } < <(clean_input)
if [ -z "${text:-}" ]; then
    trace "outcome=nothing"
    exit 1
fi

# Toggle rule. Same hash while speaking: stop. Different hash: replace.
# Plain speak mode always replaces.
outcome="started"
if speaker_alive; then
    old_hash=""
    { read -r old_hash <"$_hash_file"; } 2>/dev/null || true
    stop_speaker
    if [ "$mode" = "toggle" ] && [ "$old_hash" = "$hash" ]; then
        trace "outcome=stopped chars=$chars"
        exit 0
    fi
    outcome="replaced"
fi

start_speaker
trace "outcome=$outcome chars=$chars truncated=$truncated"
exit 0
