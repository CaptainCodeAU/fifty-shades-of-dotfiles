#!/usr/bin/env bash
# ============================================================================
#  speak-clipboard -- read the clipboard aloud, without reading the furniture
# ============================================================================
#
# WHY
# ---
# macOS "Speak selection" cannot see a selection made inside herdr: herdr
# captures the mouse, so the selection lives in its process memory and is never
# published to the accessibility API. The clipboard is the only bridge, since
# herdr's copy_on_select means a drag has already copied by the time you let go.
#
# But speaking the clipboard raw is unpleasant, because a terminal selection is
# not prose. It carries pane borders, Powerlevel10k prompt decoration, Nerd Font
# glyphs from the private use area, box drawing, and separator runs. A speech
# engine pronounces those -- the reported symptom was "F" and "F dash" chanted
# at the end of every line -- and the actual words get lost in the noise.
#
# So this strips the furniture before speaking. The native accessibility hotkey
# CANNOT do this: it reads the raw screen, decoration and all. That asymmetry is
# the main argument for going through the clipboard at all.
#
# WHAT THE CLEANER DOES (one perl pass, in this order, and why each)
#   * ANSI/OSC escape sequences are removed -- colour and title codes, never
#     spoken content
#   * tables (box-drawn or markdown) are re-spoken row by row, "Row 1. Source.
#     The record body... When. Any time...", every name and cell its own
#     sentence so the voice pauses between them (v4.7, 2026-09-28, Gavin's
#     call: a pause after "Row N" and after each column name). MEASURED on
#     Aaron at 420 wpm: four pauses of 276-361 ms where the run-together
#     form had none over 60 ms. See _tables in the cleaner.
#   * typographic punctuation is MAPPED, not dropped: curly quotes -> straight,
#     every Unicode dash -> hyphen, ellipsis -> "...", every space separator ->
#     space. Accented letters are decomposed and their marks removed, so "cafe"
#     with an acute and "Dvorak" with a caron both survive. Without this, "I'm"
#     with a curly apostrophe became "Im".
#   * "[[" is split into "[ [" so clipboard text cannot smuggle embedded
#     speech-engine commands like [[slnc 60000]] (a 60 s silence)
#   * everything still outside printable ASCII is dropped -- box drawing, Nerd
#     Font PUA glyphs, emoji, the middle dots p10k uses as separators
#   * runs of punctuation used as rules or padding (----, ====, ....)
#   * leading "- " / "* " list markers, blank lines, and whitespace runs, which
#     become dead air; everything is joined to one line because the engine
#     pauses on every line break (MEASURED: 20 words took 4.64 s as one line
#     and 6.98 s as ten short lines); joining here means say2 gets one clean run
#   * the result is capped at 8000 chars (~2 min of speech; stop is instant)
#
# Deliberately NOT stripped: ordinary punctuation inside sentences, code
# symbols, and paths. Those carry meaning when read aloud.
#
# Why one perl pass and not sed | tr | grep: the old pipeline was seven forks
# (~21 ms per press); this is one (~6 ms), and it also computes the SHA-256 the
# toggle rule needs, so `shasum` (a 14 ms perl script of its own) is not spawned.
# All three modules (Encode, Unicode::Normalize, Digest::SHA) are core perl.
#
# SPEED
# ----
# Default is 420 wpm, set by hand after listening to 278 wpm (1.5x) and
# finding it too slow. `say` with no -r runs at 175 wpm; 420 lands around
# 2.4x that baseline. Re-tune by listening, not by arithmetic. say2's `-r` is
# documented as the same say-compatible WPM scale, so the number carried over
# unchanged across the engine switch below.
#
# VOLUME
# ------
# Default 60 of 100 (2026-09-28, Gavin: speech a little quieter than
# everything else, without touching the system volume). It scales the
# samples linearly: 60 is about -4.4 dB, 50 about -6 dB (first set at 70,
# lowered by ear). Until v8 ffplay's -volume did that; since v8 the line
# player does it to each voice's samples (x volume/100, the same scale) and
# ffplay runs at 100, so voices at different volumes share one player.
# It sits UNDER the system volume, so it can only make speech quieter, never
# louder. Re-tune by listening. The
# fallback paths (no ffplay, or no say2 voice) play at plain system
# volume: say2's own --volume is a documented no-op on the siri engine.
#
# ONE PROCESS PER PRESS, DIRECT TO say2 (v4, 2026-09-10)
# --------------------------------------------------------
# History, so nobody rebuilds any of this: v1 shelled out to `say` (1 s before
# the first word, every press). v2 kept a background daemon warm to save that
# second; it saved ~0.5 s and brought a socket, a singleton race, a process
# that never exited, a lock that stopped the Mac from sleeping, and a toggle
# that silently cancelled long text because it rendered the WHOLE selection to
# a file before playing any of it (10+ s of silence on a long selection).
# v3 fixed that by hand-building a chunked pipeline in Swift
# (speak-render.swift, since deleted): split text at sentence ends, render
# sentence 1 via NSSpeechSynthesizer (~0.7 s), start playing it, render the
# rest while it plays.
#
# v4 (this) deletes that pipeline. `say2` (https://github.com/CaptainCodeAU/say2)
# reaches the same premium Aaron voice (now the "natural" tier,
# en-US:natural:male:Aaron:premium:5030 -- a better tier than NSSpeechSynthesizer
# could even reach) and already streams internally: MEASURED on this Mac
# 2026-09-10, direct playback of a 16.1 s / ~120-word paragraph
# (`say2 -v ... "$text"`, no -o) took 16.7 s wall-clock total -- about 0.65 s of
# overhead before/around the speech, not 0.65 s PLUS a multi-second render-first
# wait. Rendering that same paragraph to a file first (`-o`, the old chunked
# design's approach) took 5.0 s before any audio could start -- proof the old
# problem is real, but proof say2's own direct-play mode already solves it, so
# building a second chunker on top of it would just be solving it twice.
# So: one `say2` process per press, playing straight to the default audio
# device. STOP is killing that process -- see stop_speaker for why a plain
# SIGTERM is not enough.
#
# v4.2 (2026-09-28): the stop press did nothing once speech was audible.
# say2 (at 7b8eeff) catches SIGTERM and turns it into "cancel synthesis"
# (Sources/say2/main.swift), but by the time audio plays the whole utterance
# is already rendered to a temp .wav, and its playback loop
# (Application.swift, play()) never checks for cancel. So SIGTERM during
# speech was silently ignored and the voice ran to the end. The old note here
# ("kill-to-exit ~15 ms") was measured before say2 took this shape.
# stop_speaker now sends SIGKILL. Cost: say2's temp .wav in its $TMPDIR is
# left behind (macOS clears $TMPDIR itself), and a stop during rendering does
# not tell the Siri daemon to cancel (it finishes into nowhere, harmless).
# The real fix belongs in say2's play() loop.
#
# v4.3 (same evening): v4.2 first sent SIGTERM and polled ~0.2 s before the
# SIGKILL. MEASURED: each `sleep 0.02` here really takes ~59 ms, so that
# "0.2 s" wait was ~0.6 s of audible lag on every stop, for a SIGTERM say2
# ignores anyway during playback. Gone; SIGKILL is immediate.
#
# v4.4 (same evening): the v4 claim above that say2 "already streams
# internally" was WRONG for direct playback. say2's play path renders the
# whole utterance to a .wav and only then plays it (Application.swift,
# unchanged since 2026-09-08). The v4 test used a 16 s paragraph, which
# renders too fast to tell the two apart. Gavin reported long selections
# waiting over a minute. MEASURED with fresh text (3,360 chars, ~100 s of
# speech): direct play 35.1 s of silence first; `--format pcm -o -` to stdout
# gave its first audio bytes after 0.33 s, rendering ~3x faster than speech.
# So start_speaker now pipes that stream into ffplay when it is available,
# and keeps the direct-play path as the fallback. Once say2's own playback
# streams (the say2 fix filed alongside the SIGTERM one), drop the ffplay
# layer and call say2 directly again.
#
# v4.1 (2026-09-10, same day): two corrections after Gavin reported the real
# hotkey taking 2-3 s to start speaking, which the numbers above did not
# predict.
#
# First, `say2 synthesize` (the subcommand) is measurably slower than the bare
# `say2 -v ... TEXT` form REGARDLESS of how text reaches it -- MEASURED both
# ways, repeated, ~2-4 s of overhead on `synthesize` either via stdin or argv,
# vs ~0.6-0.7 s on the bare form. Switched to the bare form and, since that
# form only reliably streams fast with TEXT as a normal argument (not stdin,
# not `-f FILE` -- both measured slower too), text now goes on argv. That is a
# deliberate reversal of this file's original "never argv" privacy design:
# Gavin chose speed after seeing the actual trade-off (text briefly visible in
# `ps` output while speaking, on his own single-user Mac).
#
# Second, and this is the part argv did NOT fix: paired testing (same command,
# run twice) showed the SAME command is slow (~1-2.6 s of overhead, noisy)
# on the first call after any real pause, and fast (~0.6 s) on a second call
# fired immediately after. That is the actual 2-3 s Gavin was hearing --
# selecting text, then pressing the key, is always a "first call". Tried
# feeding it a silent warm-up ping beforehand (both `--no-output` and `-o
# FILE`, ~0.3 s / ~30 MB each, genuinely cheap) and MEASURED that neither
# changes the real call's timing at all -- the cold cost is not in the
# synthesis engine, which is already fast every time. Best-evidenced guess:
# it is the audio OUTPUT device (not the voice model) waking from idle, which
# a silent-only ping does not touch. A ping that reliably fixed this would
# have to make a real (if quiet) sound every few minutes -- Gavin decided
# against building that (uncertain payoff, adds a periodic background noise)
# on 2026-09-10. So: this delay is accepted as a trait of the voice pipeline,
# not something this script tries to hide.
#
# FALLBACK (2026-09-10): say2 reaches a private Apple framework that a macOS
# update can remove or rename without warning (it exits 69 for exactly that
# case), and a fresh machine may have say2 installed but not the premium Siri
# voice downloaded. Neither should mean silence. resolve_engine() picks Aaron,
# then Simone (the two premium Siri "natural" voices), then the always-present
# `say` binary with voice Samantha, in that order -- checked once and cached
# for a day (see resolve_engine's own comment) so a normal press costs a file
# read, not a live probe. `--voice` bypasses all of this and goes straight to
# say2 with the given key, trusting an explicit override as-is.
#
# The toggle rule (v5, 2026-09-28, Gavin's call): ANY press while it speaks
# = stop, whatever the clipboard holds; the next press speaks the current
# selection. Until v5, a press with NEW text replaced the speech instead,
# decided by comparing a SHA-256 of the cleaned text. The cleaner still
# computes that hash, but since v4.5 nothing stores or reads it.
#
# PRIVACY: the text is never logged. It DOES pass on the command line as of
# v4.1 above (a deliberate speed-over-privacy trade, see that note) -- it is
# visible in `ps` output to anyone with shell access on this Mac for as long
# as the utterance is speaking, which the original v1-v4 design specifically
# avoided. Their stderr is still captured for diagnostics, never the text.
#
# CONCURRENCY: key auto-repeat or a double tap runs this script twice within
# a few ms. A flock on speak-clipboard.flock (macOS `lockf` on fd 9)
# serialises the check-stop-start section; the loser records outcome=busy and
# exits 0 (never queues -- N repeats would mean N toggles). The kernel drops
# the lock when the script exits, even on SIGKILL, so there is no stale-lock
# case to handle. The pid file is trusted only if that pid is still the same
# live process (pid plus start time) and is one of our engines: pids are
# recycled, and a stale file must never kill a stranger.
#
# NOTHING IS EVER DELETED (v4.5, 2026-09-28, Gavin's call). Until v4.5 the
# lock was a mkdir'd folder and the pid/hash files were removed after use.
# In a script `command rm` is the ~/.local/bin/rm Trash shim, so every press
# put 1-3 of these files in the Trash (verified with a probe) at ~95 ms each.
# Now the lock file is never removed (a lock is the flock, not the file), the
# pid file is overwritten in place and judged stale by its contents, and the
# hash file is no longer written at all.
#
# USAGE
#   speak-clipboard              speak the clipboard (replacing any current speech,
#                                and clearing anything waiting in line)
#   speak-clipboard --toggle     speaking: stop (any text); idle: speak
#   speak-clipboard --queue [MS] speaking: wait in line, then speak; idle: speak
#                                now. MS (0-5000) is a gap in milliseconds
#                                before this voice; not with --toggle
#   speak-clipboard --stop       stop any speech and clear the line
#   speak-clipboard --skip       stop the voice speaking now; the next in line plays
#   speak-clipboard --profile NAME
#                                use profile NAME for this command (any
#                                command below); without it, the first
#                                profile in the file
#   speak-clipboard --print      print what WOULD be spoken (no audio)
#   speak-clipboard --stdin      read text from stdin instead of the clipboard
#                                (for tests; combine with --print/--toggle)
#   speak-clipboard --rate N     words per minute, this press only (1-700)
#   speak-clipboard --volume N   speech volume 0-100 under the system volume,
#                                this press only (streaming path only)
#   speak-clipboard --voice KEY  say2 voice asset key or display name, this press
#                                only -- bypasses the fallback chain entirely
#   speak-clipboard --selftest   run the automatic tests (stand-ins, no speech)
#
# SAVED SETTINGS (~/.config/speak-clipboard/settings; every press, the hotkey
# included, speaks with what it holds; any run writes it if it is missing).
# The file holds profiles, one [name] block each with rate, volume, voice and
# notify. Every command below acts on the first profile, or on --profile NAME.
#   speak-clipboard --profiles          list the profiles and their settings
#   speak-clipboard --new-profile NAME  add a profile, a copy of the first one
#                                       (letters, digits, _ and - only)
#   speak-clipboard --remove-profile NAME
#                                       rename its heading to NAME_REMOVED: no
#                                       longer listed or usable; deleting it
#                                       is a hand edit
#   speak-clipboard --settings          show rate, volume, voice and notify,
#                                       whether each is the default, and any
#                                       problem with the file
#   speak-clipboard --get KEY           print one value alone: rate, volume,
#                                       voice (its full key) or notify; with
#                                       no KEY or all, all four as key=value
#   speak-clipboard --set rate N        save words per minute (1-700); +N or
#                                       -N steps from the current value and
#                                       stops at the limit (--set rate +20)
#   speak-clipboard --set volume N      save volume 0-100; +N or -N steps
#   speak-clipboard --set voice N       save a voice by its number from
#                                       --voices (names repeat, numbers do not)
#   speak-clipboard --set notify on|off on: every --set and --reset also shows
#                                       the change as a notification (what the
#                                       herdr hotkeys rely on); off: never
#   speak-clipboard --reset KEY         write the default value back:
#                                       rate, volume, voice, notify, or all
#   (--set and --reset show each value they change as "old -> new")
#   --notify / --no-notify              add to a --set or --reset to show or
#                                       skip the notification this once,
#                                       whatever the notify setting says;
#   speak-clipboard --notify --settings also show the settings as a
#                                       notification, whatever notify says
#   speak-clipboard --voices            list the installed Siri voices, numbered,
#                                       with the one in use marked
#
# EXIT CODES
#    0  done: spoke, stopped, printed, or a settings command worked
#       (also a press that lost the lock to key repeat: busy, not an error)
#   Failed (nothing spoken or saved):
#    1  nothing to say: clipboard empty, or empty once cleaned
#    2  bad command: unknown option, missing value, or a wrong name after
#       --set, --reset or --get
#    3  bad value: rate not 1-700, volume not 0-100, notify not on/off, no
#       voice with that number, --queue not 0-5000, or a profile name that
#       is not allowed, already taken, or the last one left
#    4  the settings file could not be written
#    5  voices not listed: say2 missing, or it cannot reach the speech
#       service (it cannot inside a Claude Code sandbox)
#    6  no such profile: nothing spoken or saved, never another profile
#       instead (a notification names it)
#
#   Spoke, but with a fallback (the log line names every problem; the
#   lowest code wins):
#   10  a value in the file is bad or missing: the default was used
#   11  the saved voice is not installed: Aaron, Simone or Samantha was used
#   12  the file could not be read or created: default values were used
#
# SETTINGS FILE (v6, 2026-10-08, Gavin's ask: change speed, volume and voice
# without editing this script; v7 the same day, dotfiles-main Q2 and Q3).
# ~/.config/speak-clipboard/settings holds key=value lines for rate, volume,
# voice and notify, and is the one place they come from. Any run writes it
# with the default values if it is missing, and puts back a key that is
# absent; the _default_* values below exist only for that and as the safety
# net. A press reads it with shell builtins (no fork). A hand-edited value
# that fails its check is not used and not overwritten: the press speaks
# with the default value, exits 10, logs settings=bad:<key>, and
# --settings shows a WARNING line. Speech never stops because of the file:
# a file that cannot be read or created means default values and exit
# 12, never a silent hotkey. A saved voice goes to
# the FRONT of the fallback chain (saved, Aaron, Simone, `say`), so it keeps
# streaming and still falls back if it disappears. Every installed Siri voice
# streams the same 48 kHz mono 16-bit PCM (MEASURED 2026-10-08, all four
# English voices), so ffplay's fixed -ar 48000 holds for any of them.
# The 700 ceiling is say2's own: -r 875 exits 2, "between 0 and 700".
# say2 lists NO voices inside a Claude sandbox (it cannot reach the speech
# daemon), so --voices and --set voice refuse there instead of saying none.
#
# PROFILES AND THE LINE (v8, 2026-10-10). Every rule and the question that
# settled it: docs/SPEAK_CLIPBOARD_PROFILES.md (ruling D-20261010-A01).
# The settings file holds [name] blocks; a press uses the first, or
# --profile NAME, and an unknown name is refused (exit 6), never swapped
# for another profile. A flat pre-v8 file is rewritten once into a
# [default] block. Edits change the lines in place, so comments, order
# and a typo stay where Gavin put them.
# Speech now always goes through one long-lived player per line: a perl
# process (_player_pl below) that owns ONE ffplay at -volume 100, renders
# each voice with say2, scales its samples by that voice's own volume, and
# writes it into the same stream. Two players gave a faint crackle at most
# changeovers in the listening tests; one player gave none. A --queue
# press hands its voice to the running player through a named pipe
# (memory only, text never touches disk) instead of stopping it. The
# player reads ffplay's own playback clock (-stats) so it knows which
# voice is audible: that is what lets --skip drop only that one, and
# what tells it the line is over.
#
# STATE (all under ~/.local/state/herdr/, nothing here ever contains text)
#   speak-clipboard.log    one line per press: when, mode, ppid, outcome, chars
#   speak-render.log       the speaker's stderr, for diagnostics only
#   speak-render.pid       the last speaker's pid (line 1), start time (line 2)
#                          and "line" (line 3) when it is the v8 player
#   speak-engine.cache     resolve_engine()'s cached choices, one line per
#                          voice, each refreshed daily
#   speak-line.fifo        named pipe a --queue press writes its voice into
#   speak-line.flock       empty; flock'd while a press hands a voice to the
#                          player, or while the player decides to finish
#   speak-queue.time       when the last --queue press ran (key repeat check)
#   speak-clipboard.flock  empty; flock'd for one run of this script
#   (speak-render.hash and a speak-clipboard.lock/ folder are pre-v4.5
#    leftovers, no longer read or written)
# ============================================================================
set -uo pipefail

# The two premium Siri "natural" voices (Apple's own "Voice 1" / "Voice 2" in
# System Settings > Accessibility > Spoken Content). Aaron first, Simone as a
# second try before giving up on say2 entirely -- either is a real improvement
# over the `say` fallback. `say` itself is always present on macOS, so it is
# the last resort, not a "might also be missing" case.
_default_voice="en-US:natural:male:Aaron:premium:5030"
_secondary_voice="en-US:natural:female:Simone:premium:5029"
_say_fallback_voice="Samantha"
_default_rate="420"
_default_volume="60"
_default_notify="on"
_default_profile="default"
cli_rate=""
cli_volume=""
voice=""
mode="speak"
from_stdin=0
set_key=""
set_value=""
cli_notify="${_SPEAK_CLIPBOARD_NOTIFY:-}"     # on/off for this command only, or empty
cli_profile=""
queue=0
queue_delay=0
profile_arg=""                                # NAME for --new-profile / --remove-profile

# A mistake in the command is recorded here, not reported: the message is
# printed with the whole --help after it (Gavin's ask, 2026-10-08), and the
# help needs the settings and functions loaded further down. _usage_error is
# checked just before the modes run.
_usage_error=""; _usage_code=0
_fail() { [ -n "$_usage_error" ] || { _usage_code="$1"; _usage_error="$2"; }; }

# The message for a --set that is missing its value names what that setting
# takes, with an example for it (Gavin, 2026-10-08: "--set voice" answered
# with a rate example).
_set_missing() {
    case "${1:-}" in
        rate)   echo "--set rate needs a number 1-700, or +N / -N to step, e.g. --set rate $_default_rate" ;;
        volume) echo "--set volume needs a number 0-100, or +N / -N to step, e.g. --set volume $_default_volume" ;;
        voice)  echo "--set voice needs a number from the list: run speak-clipboard --voices, then e.g. --set voice 6" ;;
        notify) echo "--set notify needs on or off, e.g. --set notify off" ;;
        '')     echo "--set needs a setting and a value: rate, volume, voice or notify, e.g. --set rate $_default_rate" ;;
        *)      echo "--set takes rate, volume, voice or notify, not '$1'" ;;
    esac
}

while [ $# -gt 0 ]; do
    case "$1" in
        --print)  mode="print";  shift ;;
        --stop)   mode="stop";   shift ;;
        --skip)   mode="skip";   shift ;;
        --toggle) mode="toggle"; shift ;;
        --stdin)  from_stdin=1;  shift ;;
        # The gap is optional, so the next word is taken as it only when it
        # is not another option; "-5" counts as a (bad) gap, not an option.
        --queue) queue=1; shift
                 case "${1:-}" in ''|--*|-h) ;; *) queue_delay="$1"; shift ;; esac ;;
        --profile) [ $# -ge 2 ] || { _fail 2 "--profile needs a name: speak-clipboard --profiles lists them"; break; }
                   cli_profile="$2"; shift 2 ;;
        --profiles) mode="profiles"; shift ;;
        --new-profile)    [ $# -ge 2 ] || { _fail 2 "--new-profile needs a name, e.g. --new-profile simone_fast"; break; }
                          mode="new-profile"; profile_arg="$2"; shift 2 ;;
        --remove-profile) [ $# -ge 2 ] || { _fail 2 "--remove-profile needs a name: speak-clipboard --profiles lists them"; break; }
                          mode="remove-profile"; profile_arg="$2"; shift 2 ;;
        --selftest) mode="selftest"; shift ;;
        --rate)  [ $# -ge 2 ] || { _fail 2 "--rate needs a value"; break; }; cli_rate="$2"; shift 2 ;;
        --volume) [ $# -ge 2 ] || { _fail 2 "--volume needs a value"; break; }; cli_volume="$2"; shift 2 ;;
        --voice) [ $# -ge 2 ] || { _fail 2 "--voice needs a value"; break; }; voice="$2"; shift 2 ;;
        --settings) mode="settings"; shift ;;
        --notify)    cli_notify="on";  shift ;;
        --no-notify) cli_notify="off"; shift ;;
        --voices)   mode="voices";   shift ;;
        --get)   mode="get"; set_key="${2:-all}"; shift; [ $# -eq 0 ] || shift ;;
        --set)   [ $# -ge 3 ] || { _fail 2 "$(_set_missing "${2:-}")"; break; }; mode="set"; set_key="$2"; set_value="$3"; shift 3 ;;
        --reset) [ $# -ge 2 ] || { _fail 2 "--reset needs rate, volume, voice, notify or all"; break; }; mode="reset"; set_key="$2"; shift 2 ;;
        -h|--help) mode="help"; shift ;;
        *) _fail 2 "unknown option '$1'"; break ;;
    esac
done

# The same checks guard a --rate/--volume flag, a --set, and a value read
# back from the settings file. Five digits or more is refused before `[`
# sees it, so a huge number is "not a number", not a test error.
_valid_rate()   { case "$1" in ''|*[!0-9]*|?????*) return 1 ;; esac; [ "$1" -ge 1 ] && [ "$1" -le 700 ]; }
_valid_volume() { case "$1" in ''|*[!0-9]*|?????*) return 1 ;; esac; [ "$1" -le 100 ]; }
# '|' would break the engine cache line, a tab the message to the player.
_valid_voice()  { case "$1" in ''|*'|'*|*$'\t'*) return 1 ;; esac; }
_valid_notify() { case "$1" in on|off) ;; *) return 1 ;; esac; }
_valid_delay()  { case "$1" in ''|*[!0-9]*|?????*) return 1 ;; esac; [ "$1" -le 5000 ]; }
# Profile names: letters, digits, _ and - (Q14 v2: no spaces, every hotkey
# would need quotes; no dots, ambiguous beside a key as in aaron_fast.rate).
# Spelled out rather than A-Z, which follows the locale in bash 3.2.
_valid_profile_name() {
    case "$1" in ''|*[!abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_-]*) return 1 ;; esac
}
# A heading renamed by --remove-profile (Q24): kept in the file, never used.
_is_removed() { case "$1" in *_REMOVED|*_REMOVED_[0-9]*) return 0 ;; esac; return 1; }

if [ -n "$cli_rate" ] && ! _valid_rate "$cli_rate"; then
    _fail 3 "--rate takes a whole number 1-700 (say2's own limit)"; cli_rate=""
fi
if [ -n "$cli_volume" ] && ! _valid_volume "$cli_volume"; then
    _fail 3 "--volume takes a whole number 0-100"; cli_volume=""
fi
if [ "$queue" = 1 ] && ! _valid_delay "$queue_delay"; then
    _fail 3 "--queue takes a gap in whole milliseconds 0-5000, or nothing (0), not '$queue_delay'"
fi
# Q21: a toggle press stops speech and a --queue press waits for it.
if [ "$queue" = 1 ] && [ "$mode" = "toggle" ]; then
    _fail 2 "--toggle and --queue contradict: a toggle press stops speech, a --queue press waits for it"
fi

# The settings file (v8: profiles, see PROFILES AND THE LINE above). Read
# with builtins only, in two passes: _lines holds the file as written, then
# _parse_settings sorts each line into a profile. Per profile i: p_name,
# p_head (its heading's line; -1 for a block not in the file yet, -2 for a
# flat pre-v8 file, which gets a heading inserted), p_ins (the line a
# put-back setting goes after), pr_<key> (the value as written, the last
# one if a key is set twice) and pl_<key> (the line it came from, -1 if
# none). l_owner says which profile a line belongs to (-1: none), so a
# rewrite changes exactly the lines it means to and copies the rest.
# _file_state: ok, missing (written before the modes run), or unusable
# (cannot be read, or cannot be created).
_settings_file="${XDG_CONFIG_HOME:-$HOME/.config}/speak-clipboard/settings"
_read_settings_file() {
    local l n=0
    _lines=(); _file_state="ok"
    if [ -f "$_settings_file" ] && [ -r "$_settings_file" ]; then
        while IFS= read -r l || [ -n "$l" ]; do
            _lines[n]="$l"; n=$((n + 1))
        done <"$_settings_file"
    elif [ -e "$_settings_file" ]; then
        _file_state="unusable"
    else
        _file_state="missing"
    fi
}

# A line setting one of the four keys: sets _sk and _sv. Whole-line
# comments only (Q14 v2), so a value is everything after the first "=".
_setting_line() {
    case "$1" in
        rate=*|volume=*|voice=*|notify=*) _sk="${1%%=*}"; _sv="${1#*=}" ;;
        *) return 1 ;;
    esac
}

_new_profile_slot() {   # name, heading line; the new index in _np
    _np=${#p_name[@]}
    p_name[_np]="$1"; p_head[_np]="$2"; p_ins[_np]="$2"
    pr_rate[_np]=""; pr_volume[_np]=""; pr_voice[_np]=""; pr_notify[_np]=""
    pl_rate[_np]=-1; pl_volume[_np]=-1; pl_voice[_np]=-1; pl_notify[_np]=-1
}

# The warnings are there for the one way blocks under headings go wrong
# (Q14 v2): a lost or mistyped heading quietly moves a block into the
# profile above it. --settings shows them; a press logs _warn_log.
_warn() {
    _file_warnings="${_file_warnings}WARNING $1"$'\n'
    _warn_log="${_warn_log:+$_warn_log,}$2"
}

_parse_settings() {
    local n l cur=-1 j prev name nl=${#_lines[@]} has_heading=0
    p_name=(); p_head=(); p_ins=(); l_owner=()
    pr_rate=(); pr_volume=(); pr_voice=(); pr_notify=()
    pl_rate=(); pl_volume=(); pl_voice=(); pl_notify=()
    _file_warnings=""; _warn_log=""; _flat=-1
    for ((n = 0; n < nl; n++)); do
        case "${_lines[n]}" in '['*']') has_heading=1; break ;; esac
    done
    if [ "$has_heading" = 0 ]; then
        # A flat pre-v8 file: its settings become one [default] block, the
        # heading going in just above the first of them (written once, by
        # _ensure_settings_file).
        for ((n = 0; n < nl; n++)); do
            if _setting_line "${_lines[n]}"; then
                _new_profile_slot "$_default_profile" -2; cur=0; _flat=$n; break
            fi
        done
    fi
    for ((n = 0; n < nl; n++)); do
        l="${_lines[n]}"; l_owner[n]=-1
        case "$l" in
            '#'*|';'*) continue ;;
            '['*']')
                name="${l#[}"; name="${name%]}"
                if ! _valid_profile_name "$name"; then
                    _warn "line $((n + 1)): [$name] is not a usable profile name (letters, digits, _ and - only): its settings are not used" "bad-heading:$((n + 1))"
                    cur=-2; continue
                fi
                cur=-1
                for ((j = 0; j < ${#p_name[@]}; j++)); do
                    if [ "${p_name[j]}" = "$name" ]; then
                        _warn "[$name] is a heading twice (lines $((p_head[j] + 1)) and $((n + 1))): both blocks count as one profile" "heading-twice:$name"
                        cur=$j; break
                    fi
                done
                if [ "$cur" -lt 0 ]; then _new_profile_slot "$name" "$n"; cur=$_np; fi
                l_owner[n]=$cur ;;
            *)
                _setting_line "$l" || continue
                if [ "$cur" -eq -1 ]; then
                    _warn "line $((n + 1)): $l is above the first [heading]: not used" "above-heading:$((n + 1))"
                    continue
                fi
                [ "$cur" -ge 0 ] || continue
                eval "prev=\${pl_$_sk[cur]}"
                if [ "$prev" -ge 0 ]; then
                    _warn "[${p_name[cur]}] sets $_sk twice (lines $((prev + 1)) and $((n + 1))): line $((n + 1)) is used" "twice:${p_name[cur]}:$_sk"
                fi
                eval "pr_$_sk[cur]=\$_sv; pl_$_sk[cur]=\$n"
                p_ins[cur]=$n; l_owner[n]=$cur ;;
        esac
    done
}

# Sets _fp to the usable profile named $1; a _REMOVED one never matches.
_find_profile() {
    local i
    _is_removed "$1" && return 1
    for ((i = 0; i < ${#p_name[@]}; i++)); do
        if [ "${p_name[i]}" = "$1" ]; then _fp=$i; return 0; fi
    done
    return 1
}
# Sets _fp to the first usable profile: the one a press uses without
# --profile (Q15: 1, no default= line, which would sit outside every block).
_first_usable() {
    local i
    for ((i = 0; i < ${#p_name[@]}; i++)); do
        _is_removed "${p_name[i]}" || { _fp=$i; return 0; }
    done
    return 1
}

_put_back=""; _file_note=""; _pi=-1
_read_settings_file
_parse_settings

# Picks the profile this command uses (_pi, profile) and loads its values
# the way v7 loaded the flat file: f_* hold the lines exactly as written, so
# a rewrite keeps a typo for Gavin to see and fix; saved_* hold only values
# that pass the checks. A key the profile lacked is named in
# _missing_settings (_ensure_settings_file has put it back by now); one
# that fails its check in _bad_settings. An unknown --profile sets
# _profile_missing, which is exit 6, never another profile instead (Q16).
# Runs after _ensure_settings_file, before the modes.
_load_profile() {
    local k v e IFS=$'\n'
    _pi=-1; _profile_missing=""
    if [ -n "$cli_profile" ]; then
        if _find_profile "$cli_profile"; then _pi=$_fp
        elif [ "$_file_state" != "unusable" ]; then _profile_missing="$cli_profile"; fi
    elif _first_usable; then
        _pi=$_fp
    fi
    profile="${cli_profile:-$_default_profile}"
    f_rate=""; f_volume=""; f_voice=""; f_notify=""
    if [ "$_pi" -ge 0 ]; then
        profile="${p_name[_pi]}"
        f_rate="${pr_rate[_pi]}"; f_volume="${pr_volume[_pi]}"
        f_voice="${pr_voice[_pi]}"; f_notify="${pr_notify[_pi]}"
    fi
    # o_* keep the values as read, for the WARNING lines, so they always
    # show the text in the file, never a value a --set or --reset put in f_*.
    o_rate="$f_rate"; o_volume="$f_volume"; o_voice="$f_voice"; o_notify="$f_notify"
    _bad_settings=""; _missing_settings=""
    for e in $_put_back; do
        [ "${e%%=*}" != "$profile" ] || _missing_settings="${e#*=}"
    done
    saved_rate=""; saved_volume=""; saved_voice=""; saved_notify=""
    if [ "$_file_state" = "ok" ] && [ "$_pi" -ge 0 ]; then
        for k in rate volume voice notify; do
            eval "v=\$f_$k"
            if [ -z "$v" ]; then
                :
            elif "_valid_$k" "$v"; then
                eval "saved_$k=\$v"
            else
                _bad_settings="${_bad_settings:+$_bad_settings,}$k"
            fi
        done
    fi
    rate="${cli_rate:-${saved_rate:-$_default_rate}}"
    volume="${cli_volume:-${saved_volume:-$_default_volume}}"
    _preferred_voice="${saved_voice:-$_default_voice}"
    notify_saved="${saved_notify:-$_default_notify}"     # the file's value, for display
    notify="${cli_notify:-$notify_saved}"                  # what this command does
}

_state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/herdr"
_trace_file="$_state_dir/speak-clipboard.log"
_render_log="$_state_dir/speak-render.log"
_pid_file="$_state_dir/speak-render.pid"
_lock_file="$_state_dir/speak-clipboard.flock"
_engine_cache="$_state_dir/speak-engine.cache"
_fifo="$_state_dir/speak-line.fifo"
_line_lock="$_state_dir/speak-line.flock"
_queue_time="$_state_dir/speak-queue.time"
_engine_cache_ttl=86400
_max_chars=8000
[ -d "$_state_dir" ] || mkdir -p "$_state_dir" 2>/dev/null

# Decide which engine+voice a plain press actually uses, and cache the answer
# for a day so a normal press costs one file read, not a live say2 probe
# (`say2 voices --status` alone measured ~0.1-0.3s -- fine once, not on every
# keystroke). A 24h TTL means a macOS update that silently removes the Siri
# voice heals itself within a day instead of failing forever. Sets _engine
# (say2 or say) and _engine_voice. Skipped entirely when --voice overrides the
# default: an explicit voice is trusted as-is, straight to say2, no fallback.
# Each cache line's fourth field is the voice it was resolved FOR (v6). v8
# keeps one line per voice, so two profiles with different voices do not
# re-probe each other on every press; a line for another voice is kept
# while it is fresh. A pre-v6 line has three fields, matches nothing, and
# is dropped.
_read_engine_cache() {   # sets _cache_hit (engine|voice) and _cache_keep
    local now="$1" at eng v for
    _cache_hit=""; _cache_keep=""
    [ -f "$_engine_cache" ] || return 0
    while IFS='|' read -r at eng v for; do
        case "$at" in ''|*[!0-9]*) continue ;; esac
        [ -n "$for" ] && [ $((now - at)) -lt "$_engine_cache_ttl" ] || continue
        if [ "$for" = "$_preferred_voice" ]; then
            _cache_hit="$eng|$v"
        else
            _cache_keep="$_cache_keep$at|$eng|$v|$for"$'\n'
        fi
    done <"$_engine_cache" 2>/dev/null
}
resolve_engine() {
    if [ -n "$voice" ]; then
        _engine="say2"; _engine_voice="$voice"
        return
    fi
    local now
    now="$(date +%s)"
    _read_engine_cache "$now"
    if [ -n "$_cache_hit" ]; then
        _engine="${_cache_hit%%|*}"; _engine_voice="${_cache_hit#*|}"
        return
    fi
    _engine="say"; _engine_voice="$_say_fallback_voice"
    if command -v say2 >/dev/null 2>&1; then
        local v
        for v in "$_preferred_voice" "$_default_voice" "$_secondary_voice"; do
            if say2 voices --status "$v" --json 2>/dev/null | grep -q '"state" *: *"installed"'; then
                _engine="say2"; _engine_voice="$v"
                break
            fi
        done
    fi
    printf '%s%s|%s|%s|%s\n' "$_cache_keep" "$now" "$_engine" "$_engine_voice" "$_preferred_voice" >"$_engine_cache" 2>/dev/null || true
}

# ---------------------------------------------------------------------------
# Settings commands (v6). None of them takes the lock or touches speech.
# ---------------------------------------------------------------------------

# Fills _voice_keys with the full key of every installed Siri voice, in
# say2's own order (that order is what the --voices numbers refer to). The
# key is the last column of `say2 voices`; a line whose last word is not a
# six-part key is a header or a message, and skipped.
_load_voices() {
    _voice_keys=()
    if ! command -v say2 >/dev/null 2>&1; then
        echo "speak-clipboard: say2 is not installed, so there are no Siri voices to list" >&2
        return 1
    fi
    local line key
    while IFS= read -r line; do
        line="${line%"${line##*[![:space:]]}"}"
        key="${line##* }"
        case "$key" in *:*:*:*:*:*) _voice_keys+=("$key") ;; esac
    done < <(say2 voices 2>/dev/null)
    if [ ${#_voice_keys[@]} -eq 0 ]; then
        echo "speak-clipboard: say2 listed no installed voices." >&2
        echo "  Inside a Claude Code sandbox it cannot reach the speech daemon: run this in a normal terminal." >&2
        echo "  In a normal terminal, it means no Siri voice is downloaded (System Settings > Accessibility > Spoken Content)." >&2
        return 1
    fi
}

# "Aaron (en-US, male, natural)" for a full key; anything else as it is.
_voice_label() {
    local lang tier gender name rest
    case "$1" in
        *:*:*:*:*:*) IFS=: read -r lang tier gender name rest <<<"$1"
                     printf '%s (%s, %s, %s)' "$name" "$lang" "$gender" "$tier" ;;
        *) printf '%s' "$1" ;;
    esac
}

# The natural tier (the better voices) is drawn in bold bright white
# (Gavin's ask, 2026-10-08), only on a terminal and never with NO_COLOR set,
# so a pipe or a script still gets plain text.
show_voices() {
    _load_voices || return 5
    local i=0 key lang tier gender name rest mark on="" off="" hi lo
    if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then on=$'\e[1;97m'; off=$'\e[0m'; fi
    printf '  %-3s %-8s %-9s %-7s %s\n' '#' NAME LANGUAGE GENDER TIER
    for key in "${_voice_keys[@]}"; do
        i=$((i + 1))
        IFS=: read -r lang tier gender name rest <<<"$key"
        mark=" "; [ "$key" = "$_preferred_voice" ] && mark="*"
        hi=""; lo=""; [ "$tier" = "natural" ] && { hi="$on"; lo="$off"; }
        printf '%s%s %-3s %-8s %-9s %-7s %s%s%s\n' "$hi" "$mark" "$i" "$name" "$lang" "$gender" "$tier" \
            "$([ "$mark" = "*" ] && printf '   (in use)')" "$lo"
    done
    echo
    echo "${on}natural${off} = the newer, better Siri voices (version 5000s); neuralAX = the older ones (1000s)."
    echo "Change: speak-clipboard --set voice <number>"
}

# Turns a number from --voices into a full key, in _picked_voice. Numbers
# only (Gavin's call, 2026-10-08): names repeat across tiers (two Aarons,
# two Simones), so a name could pick the wrong one. Returns 3 for anything
# else or a number not in the list, 5 when say2 cannot list voices.
_pick_voice() {
    local want="$1"
    _picked_voice=""
    case "$want" in
        ''|*[!0-9]*|?????*)
            echo "speak-clipboard: --set voice takes the number from speak-clipboard --voices, not '$want'" >&2
            return 3 ;;
    esac
    _load_voices || return 5
    if [ "$want" -ge 1 ] && [ "$want" -le ${#_voice_keys[@]} ]; then
        _picked_voice="${_voice_keys[$((want - 1))]}"; return 0
    fi
    echo "speak-clipboard: no voice number $want; speak-clipboard --voices lists 1-${#_voice_keys[@]}" >&2
    return 3
}

# Rewrites the settings file (v8). Every line is copied as it is, except: a
# setting line a profile now holds another value for, a renamed heading, a
# put-back setting (after its block's last setting), the [default] heading
# a flat file gains, and a new profile's block at the end. A --set or
# --reset for this command's profile goes in through f_*. So comments,
# order and blank lines stay where Gavin put them. A temp file then a
# rename, so a press never reads half a file; nothing is deleted (see
# NOTHING IS EVER DELETED above). Reads the file back afterwards, so the
# line numbers match the disk for any later step.
_write_settings() {
    local tmp="$_settings_file.tmp"
    if [ "$_pi" -ge 0 ]; then
        pr_rate[_pi]="$f_rate"; pr_volume[_pi]="$f_volume"
        pr_voice[_pi]="$f_voice"; pr_notify[_pi]="$f_notify"
    fi
    mkdir -p "${_settings_file%/*}" 2>/dev/null
    if _emit_settings >"$tmp" 2>/dev/null && command mv -f "$tmp" "$_settings_file" 2>/dev/null; then
        _read_settings_file; _parse_settings
        return 0
    fi
    echo "speak-clipboard: could not write $(_tilde "$_settings_file")" >&2
    return 1
}

_emit_settings() {
    local n i u v l nl=${#_lines[@]} np=${#p_name[@]}
    for ((n = 0; n < nl; n++)); do
        [ "$n" -ne "$_flat" ] || printf '[%s]\n' "${p_name[0]}"
        l="${_lines[n]}"; i="${l_owner[n]}"
        if [ "$i" -lt 0 ]; then
            printf '%s\n' "$l"
        elif [ "${l:0:1}" = "[" ]; then
            printf '[%s]\n' "${p_name[i]}"
        else
            _setting_line "$l"
            eval "u=\${pl_$_sk[i]}; v=\${pr_$_sk[i]}"
            if [ "$u" -eq "$n" ]; then printf '%s=%s\n' "$_sk" "$v"; else printf '%s\n' "$l"; fi
        fi
        for ((i = 0; i < np; i++)); do
            [ "${p_ins[i]}" -ne "$n" ] || _emit_put_back "$i"
        done
    done
    for ((i = 0; i < np; i++)); do
        [ "${p_head[i]}" -eq -1 ] || continue
        [ "$nl" -eq 0 ] || [ -z "${_lines[nl - 1]}" ] || echo
        printf '[%s]\n' "${p_name[i]}"
        _emit_put_back "$i"
    done
}

_emit_put_back() {   # the settings profile $1 has no line for, in the usual order
    local k u v
    for k in rate volume voice notify; do
        eval "u=\${pl_$k[$1]}; v=\${pr_$k[$1]}"
        [ "$u" -ge 0 ] || [ -z "$v" ] || printf '%s=%s\n' "$k" "$v"
    done
}

# A path with $HOME shown as ~ (a ~ in a ${x/..} replacement is
# tilde-expanded straight back by bash).
_tilde() {
    case "$1" in
        "$HOME"/*) printf '~/%s' "${1#"$HOME"/}" ;;
        *) printf '%s' "$1" ;;
    esac
}

# Makes the file hold every setting of every usable profile (v7, Gavin's
# call 2026-10-08, dotfiles-main Q2; v8 per profile): writes a missing file
# with one [default] block of default values, adds that block when no
# usable profile is left, puts back a setting a profile lacks, and gives a
# flat pre-v8 file its [default] heading. A bad value is never overwritten.
# Runs once per invocation, before any mode. Sets _file_note (created,
# migrated, added:default; comma-joined) for --settings and the log,
# _put_back ("profile=keys" lines) for _load_profile and --settings, and
# turns a missing file that cannot be written into _file_state=unusable.
_ensure_settings_file() {
    local i k v m changed=0 notes=""
    [ "$_file_state" != "unusable" ] || return 0
    if [ "$_file_state" = "missing" ]; then
        _lines=("# speak-clipboard settings: one [profile] block each; a press uses the first,"
                "# or --profile NAME. Change with: speak-clipboard --set / --reset (--help)")
        _parse_settings
        changed=1; notes="created"
    fi
    if ! _first_usable; then
        _new_profile_slot "$_default_profile" -1
        changed=1; notes="${notes:-added:$_default_profile}"
    fi
    if [ "$_flat" -ge 0 ]; then changed=1; notes="${notes:+$notes,}migrated"; fi
    for ((i = 0; i < ${#p_name[@]}; i++)); do
        ! _is_removed "${p_name[i]}" || continue
        m=""
        for k in rate volume voice notify; do
            eval "v=\${pr_$k[i]}"
            [ -z "$v" ] || continue
            eval "pr_$k[i]=\$_default_$k"; m="${m:+$m,}$k"
        done
        [ -n "$m" ] || continue
        changed=1
        # A block written whole just now was never missing anything.
        [ "${p_head[i]}" -eq -1 ] || _put_back="$_put_back${p_name[i]}=$m"$'\n'
    done
    [ "$changed" = 1 ] || return 0
    if _write_settings 2>/dev/null; then
        _file_state="ok"; _file_note="$notes"
    elif [ "$_file_state" = "missing" ]; then
        _file_state="unusable"
    fi
}

# "(default)" when a value matches the built-in one, else "(changed)"; with
# a third argument, "(changed, default <it>)", so --settings says what the
# default is (Gavin's pick, dotfiles-main Q6).
_vs_default() {
    if [ "$1" = "$2" ]; then echo "(default)"
    elif [ -n "${3:-}" ]; then echo "(changed, default $3)"
    else echo "(changed)"; fi
}

# The box is at least this wide; it grows to fit the longest row or the
# file's path, and both rules are drawn to the same width (Gavin's layout,
# 2026-10-08).
_box_width=62

# A voice key's display name alone ("Aaron"), or the value as it is.
_voice_name() {
    local name
    case "$1" in
        *:*:*:*:*:*) IFS=: read -r _ _ _ name _ <<<"$1"; printf '%s' "$name" ;;
        *) printf '%s' "$1" ;;
    esac
}

# The settings in a box: a top rule naming the file, one row per setting
# with "(default)" or "(changed, default ...)", any problem each on its own
# line saying what was used instead, then a bottom rule. After a --set or
# --reset, _SPEAK_CLIPBOARD_BEFORE holds the values before it
# (rate|volume|voice), and a row that changed reads "old -> new" in bold
# bright white (dotfiles-main Q6). The file's path is bold bright white too.
# Colour only on a terminal and never with NO_COLOR set.
show_settings() {
    local k raw top label problems="" e IFS_old
    local b_rate="" b_volume="" b_voice="" b_notify="" on="" off="" i w=44 width="$_box_width" n
    local -a names=(rate volume voice notify) vals marks hot=("" "" "" "")
    [ -z "${_SPEAK_CLIPBOARD_BEFORE:-}" ] || IFS='|' read -r b_rate b_volume b_voice b_notify <<<"$_SPEAK_CLIPBOARD_BEFORE"
    if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then on=$'\e[1;97m'; off=$'\e[0m'; fi
    vals[0]="$rate wpm";      marks[0]="$(_vs_default "$rate" "$_default_rate" "$_default_rate")"
    vals[1]="$volume of 100"; marks[1]="$(_vs_default "$volume" "$_default_volume" "$_default_volume")"
    vals[2]="$(_voice_label "$_preferred_voice")"
    marks[2]="$(_vs_default "$_preferred_voice" "$_default_voice" "$(_voice_name "$_default_voice")")"
    vals[3]="$notify_saved";  marks[3]="$(_vs_default "$notify_saved" "$_default_notify" "$_default_notify")"
    if [ -n "$b_rate" ] && [ "$b_rate" != "$rate" ]; then vals[0]="$b_rate -> $rate wpm"; hot[0]=1; fi
    if [ -n "$b_volume" ] && [ "$b_volume" != "$volume" ]; then vals[1]="$b_volume -> $volume of 100"; hot[1]=1; fi
    if [ -n "$b_voice" ] && [ "$b_voice" != "$_preferred_voice" ]; then
        vals[2]="$(_voice_name "$b_voice") -> ${vals[2]}"; hot[2]=1
    fi
    if [ -n "$b_notify" ] && [ "$b_notify" != "$notify_saved" ]; then vals[3]="$b_notify -> $notify_saved"; hot[3]=1; fi
    for i in 0 1 2 3; do [ ${#vals[i]} -le "$w" ] || w=${#vals[i]}; done
    for i in 0 1 2 3; do n=$((8 + w + 1 + ${#marks[i]})); [ "$n" -le "$width" ] || width=$n; done
    label="$(_tilde "$_settings_file"), profile $profile"
    top="__ Settings file: $label "
    [ $((${#top} + 3)) -le "$width" ] || width=$((${#top} + 3))
    printf '__ Settings file: %s%s%s %s\n' "$on" "$label" "$off" \
        "$(printf '%*s' $((width - ${#top})) '' | tr ' ' _)"
    echo
    for i in 0 1 2 3; do
        if [ -n "${hot[i]}" ]; then
            printf '%s%-8s%-*s %s%s\n' "$on" "${names[i]}" "$w" "${vals[i]}" "${marks[i]}" "$off"
        else
            printf '%-8s%-*s %s\n' "${names[i]}" "$w" "${vals[i]}" "${marks[i]}"
        fi
    done
    _read_engine_cache "$(date +%s)"
    if [ -n "$_cache_hit" ] && [ "${_cache_hit#*|}" != "$_preferred_voice" ]; then
        problems="${problems}WARNING the voice is not installed: the last press used ${_cache_hit%%|*}, $(_voice_label "${_cache_hit#*|}") (exit 11)"$'\n'
    fi
    for k in ${_bad_settings//,/ }; do
        eval "raw=\$o_$k"
        problems="${problems}WARNING $k=$raw in the file is not valid: the default is used (exit 10). Fix: speak-clipboard --set $k ..."$'\n'
    done
    problems="$problems$_file_warnings"
    case ",$_file_note," in
        *,created,*) problems="${problems}NOTE    the file did not exist: written now with one [$_default_profile] profile of default values"$'\n' ;;
        *,added:*) problems="${problems}NOTE    the file had no usable profile: a [$_default_profile] one of default values was added"$'\n' ;;
    esac
    case ",$_file_note," in
        *,migrated,*) problems="${problems}NOTE    the file had no [profile] headings: its settings are now the [$_default_profile] profile"$'\n' ;;
    esac
    IFS_old="$IFS"; IFS=$'\n'
    for e in $_put_back; do
        problems="${problems}NOTE    [${e%%=*}] was missing ${e#*=}: put back with the default value"$'\n'
    done
    IFS="$IFS_old"
    if [ "$_file_state" = "unusable" ]; then
        problems="${problems}WARNING the file could not be read or created: default values used (exit 12)"$'\n'
    fi
    [ -z "$problems" ] || printf '\n%s' "$problems"
    printf '%*s\n' "$width" '' | tr ' ' _
    echo
}

# --help's middle section. Printed from the _default_* values, not typed into
# the USAGE text, so the help can never disagree with what a press uses.
show_defaults() {
    local f='  %-8s %-31s %s\n' mark
    echo "DEFAULT VALUES (recommended, tuned by ear; --reset all writes them back)"
    printf "$f" "" "default" "now"
    mark=" $(_vs_default "$rate" "$_default_rate")"; [ -n "$cli_rate" ] && mark=" (this press)"
    printf "$f" rate "$_default_rate wpm" "$rate wpm$mark"
    mark=" $(_vs_default "$volume" "$_default_volume")"; [ -n "$cli_volume" ] && mark=" (this press)"
    printf "$f" volume "$_default_volume of 100" "$volume of 100$mark"
    mark=" $(_vs_default "$_preferred_voice" "$_default_voice")"
    printf "$f" voice "$(_voice_label "$_default_voice")" "$(_voice_label "$_preferred_voice")$mark"
    mark=" $(_vs_default "$notify" "$_default_notify")"; [ -n "$cli_notify" ] && mark=" (this command)"
    printf "$f" notify "$_default_notify" "$notify$mark"
    echo
}

# The whole --help: the USAGE text from the header, then the default values,
# then the exit codes. Each sed range drops its closing heading line.
_print_help() {
    sed -n '/^# USAGE/,/^# EXIT CODES/p' "$0" | sed '$d' | sed 's/^# \{0,1\}//'
    show_defaults
    sed -n '/^# EXIT CODES/,/^# SETTINGS FILE/p' "$0" | sed '$d' | sed 's/^# \{0,1\}//'
}

# "+N" or "-N" applied to a current value and held inside min-max, in
# _stepped (Gavin's ask, 2026-10-08: hotkeys that step the rate by 20 and the
# volume by 10). Returns 1 if $1 is not a sign and up to four digits.
_step() {
    local d="${1#[+-]}"
    case "$1" in [+-]*) ;; *) return 1 ;; esac
    case "$d" in ''|*[!0-9]*|?????*) return 1 ;; esac
    if [ "${1:0:1}" = "+" ]; then _stepped=$(($2 + 10#$d)); else _stepped=$(($2 - 10#$d)); fi
    [ "$_stepped" -ge "$3" ] || _stepped="$3"
    [ "$_stepped" -le "$4" ] || _stepped="$4"
}

# A notification, when notify is on (dotfiles-main Q7: 2). Straight to macOS
# through osascript, because herdr's `notification show` joins the lines of
# the body into one: MEASURED 2026-10-08, the same four-line body arrived as
# separate lines from osascript (newline or return, tests C and D) and as one
# line through herdr (return or U+2028, tests A and B), dotfiles-main Q11.
# herdr is the fallback if osascript fails. Text goes in as osascript
# arguments, never pasted into the script, so a quote cannot break it.
# macOS labels these "Script Editor".
_send_notification() {
    if osascript -e 'on run argv' -e 'display notification (item 2 of argv) with title (item 1 of argv)' \
        -e 'end run' "$1" "$2" >/dev/null 2>&1; then
        return 0
    fi
    command -v herdr >/dev/null 2>&1 &&
        herdr notification show "$1" --body "$2" --sound none >/dev/null 2>&1
}

# What a --set or --reset changed, as one notification: "Rate: 420 -> 440
# wpm". A step that hit a limit says "No change" and names the limit.
_notify_change() {
    local b_rate="" b_volume="" b_voice="" b_notify="" body="" nl=$'\n'
    [ -z "${_SPEAK_CLIPBOARD_BEFORE:-}" ] || IFS='|' read -r b_rate b_volume b_voice b_notify <<<"$_SPEAK_CLIPBOARD_BEFORE"
    # One change per line (Gavin's ask, 2026-10-08). Only ever called with
    # notify on, so a notify change here means it was just turned on;
    # turning it off sends nothing, by its own rule.
    [ "$b_rate" = "$rate" ] || body="Rate: $b_rate -> $rate wpm"
    [ "$b_volume" = "$volume" ] || body="${body:+$body$nl}Volume: $b_volume -> $volume"
    [ "$b_voice" = "$_preferred_voice" ] || body="${body:+$body$nl}Voice: $(_voice_name "$b_voice") -> $(_voice_name "$_preferred_voice")"
    [ "$b_notify" = "$notify_saved" ] || body="${body:+$body$nl}Notifications: on"
    if [ -z "$body" ]; then
        body="No change"
        case "$rate" in 1|700) body="$body${nl}Rate: $rate wpm (limit 1-700)" ;; esac
        case "$volume" in 0|100) body="$body${nl}Volume: $volume (limit 0-100)" ;; esac
    fi
    _send_notification "Speak clipboard: $profile" "$body"
}

# The current settings as one notification, for `--notify --settings`
# (Gavin's ask, 2026-10-08: ctrl+alt+9 in herdr), one setting per line. It
# shows whatever the notify setting says, because asking for it is the
# point. A problem the --settings box would warn about is flagged, not
# spelled out.
_notify_summary() {
    local body problem="" nl=$'\n'
    body="Rate: $rate wpm${nl}Volume: $volume${nl}Voice: $(_voice_name "$_preferred_voice")${nl}Notifications: $notify_saved"
    [ -z "$_bad_settings" ] || problem="bad value in the file: $_bad_settings"
    [ "$_file_state" != "unusable" ] || problem="settings file unusable, defaults in use"
    [ -z "$problem" ] || body="$body${nl}Problem: $problem (run speak-clipboard --settings)"
    _send_notification "Speak clipboard settings: $profile" "$body"
}

# A mistake in the command (exit 2 or 3): the message, then the whole help,
# so the usage is on screen without typing --help (Gavin's ask, 2026-10-08).
_die_with_help() {
    { echo "speak-clipboard: $2"; echo; _print_help; } >&2
    exit "$1"
}


# One line per press. A line here means the key reached herdr and this script
# ran; no line means the key or the spawn is at fault. Never any text.
trace() {
    local ts
    if ((BASH_VERSINFO[0] > 4 || (BASH_VERSINFO[0] == 4 && BASH_VERSINFO[1] >= 2))); then
        TZ=UTC printf -v ts '%(%FT%TZ)T' -1
    else
        ts="$(date -u +%FT%TZ)"
    fi
    printf '%s mode=%s ppid=%s %s\n' "$ts" "$mode" "${PPID:-?}" "$*" >>"$_trace_file" 2>/dev/null
}

# Log trimming runs once, at exit, off the press path. The lock needs no
# release: it goes when fd 9 closes.
_trim_log() {
    local f="$1" max="$2" n
    [ -f "$f" ] || return 0
    n="$(wc -l <"$f" 2>/dev/null)" || return 0
    [ "${n:-0}" -gt "$max" ] || return 0
    tail -n "$max" "$f" >"$f.tmp" 2>/dev/null && command mv -f "$f.tmp" "$f" 2>/dev/null
}
_on_exit() {
    _trim_log "$_trace_file" 200
    _trim_log "$_render_log" 400
}
trap _on_exit EXIT

# flock via macOS `lockf` on fd 9, opened for append so the file is created
# if missing and never truncated. -t 0: fail at once if held (exit 75),
# never queue. MEASURED 2026-09-28: a second taker gets 75 while the first
# holds, 0 once it exits or is SIGKILLed; and a background child that
# inherits fd 9 keeps the lock after the script exits, which is why every
# speaker in start_speaker is launched with 9>&-.
acquire_lock() {
    exec 9>>"$_lock_file" || return 1
    lockf -s -t 0 9
}

# A process's start time with all whitespace removed. `ps -o lstart=` pads
# its output with trailing spaces and `read` strips them, so the raw strings
# never compare equal (MEASURED: that bug made every stop report idle).
# LC_ALL=C because lstart follows the locale (v4.11, 2026-10-10): en_AU
# prints "Sat 10 Oct", C or no locale "Sat Oct 10". The herdr hotkey runs
# with en_AU and the t33remap LaunchAgent with none, so a stamp written by
# one never matched the other's check, and a toggle started a second voice
# (found by button_bunny-main; write-up in button_bunny-isolinear workbench,
# speak-clipboard-parallel-voices-2026-10-10.md).
_start_of() {
    local s
    s="$(LC_ALL=C ps -o lstart= -p "$1" 2>/dev/null)"
    printf '%s' "${s//[[:space:]]/}"
}

# Sets _speaker to the pid of the live speaker, or returns 1. The pid file
# holds a pid and that process's start time; it is never removed, only
# overwritten by the next start, so a finished speaker leaves a stale file
# that this check must reject. It holds the v8 line player (a perl process
# leading its own group, "line" on the third line: _speaker_line=1), a
# lone say2/say pid, or (v4.4-v7, still running across an update) the
# leader of a group running say2 | ffplay; _speaker_group is set to 1 for a
# group. `kill -0` alone is not enough: pids are recycled, so the process
# must have the same start time AND be one of ours before anyone signals it.
speaker_alive() {
    local p="" stamp="" kind="" comm=""
    _speaker=""
    _speaker_group=""
    _speaker_line=""
    [ -f "$_pid_file" ] || return 1
    { read -r p; read -r stamp; read -r kind; } <"$_pid_file" 2>/dev/null || true
    case "$p" in
        ''|*[!0-9]*) return 1 ;;
    esac
    [ -n "$stamp" ] && [ "$(_start_of "$p")" = "$stamp" ] || return 1
    comm="$(ps -o comm= -p "$p" 2>/dev/null)"
    case "${comm##*/}" in
        say2|say) _speaker="$p"; return 0 ;;
        perl|perl5*)
            if [ "$kind" = "line" ]; then _speaker="$p"; _speaker_group=1; _speaker_line=1; return 0; fi ;;
    esac
    if [ -n "$comm" ] && [ -n "$(pgrep -g "$p" -x 'say2|ffplay' 2>/dev/null)" ]; then
        _speaker="$p"; _speaker_group=1; return 0
    fi
    return 1
}

# Returns 0 if something was actually stopped. SIGKILL straight away: say2
# ignores SIGTERM once playback has started (v4.2 note up top), and a
# SIGTERM-then-wait cost ~0.6 s of audible lag (v4.3). speaker_alive has
# already confirmed the pid is ours, so a recycled pid is never hit. A
# streaming speaker is killed as a whole group, so say2 does not keep
# rendering into a dead pipe and hold up the next press; for the line
# player that group is every voice in the line, which is what --stop
# means (Q25: silence, and the line cleared).
stop_speaker() {
    local rc=1
    if speaker_alive; then
        if [ -n "$_speaker_group" ]; then
            kill -KILL -- "-$_speaker" 2>/dev/null && rc=0
        else
            kill -KILL "$_speaker" 2>/dev/null && rc=0
        fi
    fi
    return $rc
}

# --skip (Q25): the line player drops the voice you can hear and goes on
# with the next one (SIGUSR1, see _player_pl). A speaker with no line has
# no next one, so skipping it is stopping it. Returns 1 when idle.
skip_speaker() {
    speaker_alive || return 1
    if [ -n "$_speaker_line" ]; then
        kill -USR1 "$_speaker" 2>/dev/null
    else
        stop_speaker
    fi
}

# One message to the line player, on stdout: the gap in ms, then the voice,
# rate, volume and text this press speaks with. Tab-separated on one line:
# the cleaner leaves no tab or newline in the text, and _valid_voice
# refuses a tab in a voice.
_send_voice() {
    printf 'V\t%s\t%s\t%s\t%s\t%s\n' "$1" "$_engine_voice" "$rate" "$volume" "$text"
}

# Text goes in as an argv element (2026-09-10, see the v4.1 note up top --
# reversed from the original "never argv" design on purpose, traded away for
# speed). `trap '' HUP; exec` replaces nohup: the speaker must outlive this
# script, and exec keeps $! equal to its own pid (see speaker_alive: it checks
# the live process really is ours before anyone signals it). say2 MUST be
# invoked as the bare `say2 -v ... TEXT` form, never `say2 synthesize` --
# synthesize is the slow path regardless of how text reaches it (MEASURED).
#
# Streaming (v4.4, every voice since v8): with say2 and ffplay on PATH, say2
# writes raw PCM to stdout as it renders and ffplay plays it, so speech
# starts in ~0.3 s instead of after the whole render (35 s of silence on
# 3,360 chars, which is what an explicit --voice got until v8). Since v8
# that pair lives inside the line player (start_line); `set -m` gives it
# its own process group, whose leader pid goes in the pid file.
#
# -infbuf is load-bearing (v4.6, 2026-09-28). Without it ffplay reads only
# about a second ahead, say2's writes stall, and say2 ends the render early:
# "Synthesis produced only 5.178 seconds of audio [exit 6]" on a 1,401-char
# selection whose full audio is 39.6 s, cutting off mid-sentence. MEASURED
# the same text three ways: fast reader 39.6 s; ffplay 5.2 s + that error;
# ffplay -infbuf 40.1 s wall, no error. (A say2 bug too: a slow consumer
# should slow it down, not truncate it. Filed with the other say2 items.)
# The line player also drains say2 into its own memory as fast as it comes.
#
# `--` before the text (v4.10, 2026-10-09): without it, a selection that
# starts with a dash is read as an option. MEASURED: clipboard "--help"
# cleaned to "--help", and say2 printed its own help, exit 0, nothing spoken.
# With `--`, say2 and say both take it as text.
start_speaker() {
    resolve_engine
    if [ "$_engine" = "say2" ] && command -v ffplay >/dev/null 2>&1 && start_line; then
        return 0
    elif [ "$_engine" = "say2" ]; then
        ( trap '' HUP; exec say2 -v "$_engine_voice" -r "$rate" -- "$text" ) \
            >/dev/null 2>>"$_render_log" 9>&- &
    else
        ( trap '' HUP; exec say -v "$_engine_voice" -r "$rate" -- "$text" ) \
            >/dev/null 2>>"$_render_log" 9>&- &
    fi
    local p=$!
    printf '%s\n%s\n' "$p" "$(_start_of "$p")" >"$_pid_file"
}

# A new line player with this press's voice first in it. The press opens
# the named pipe read-write and writes the voice into it BEFORE the player
# exists (the pipe holds it), then hands the pipe over as fd 3, so the
# player's first read finds it. Written after the start, it raced the
# player, which could find an empty line and finish before the voice came:
# with the write moved back after the start, 9 selftest checks fail (the
# --skip, --stop, clean-slate and --toggle arms), measured 2026-10-10. Read-write also means no open of
# that pipe ever blocks. The player's program comes in on stdin, so its
# command line is short in `ps`.
start_line() {
    [ -p "$_fifo" ] || mkfifo "$_fifo" 2>/dev/null || return 1
    exec 7<>"$_fifo" || return 1
    _send_voice 0 >&7
    set -m
    ( trap '' HUP; exec perl - speak-clipboard-line "$_line_lock" <<<"$_player_pl" ) \
        3<&7 7<&- >/dev/null 2>>"$_render_log" 8>&- 9>&- &
    set +m
    local p=$!
    printf '%s\n%s\nline\n' "$p" "$(_start_of "$p")" >"$_pid_file"
    exec 7<&-
}

# A --queue press while a line plays (Q12): its voice goes to the running
# player, which speaks it after the voices already waiting. Under
# speak-line.flock, because the player decides the line is over only while
# holding that lock: so it cannot finish between this check and this
# write. Returns 1 when there is no line to join, and the press starts one.
join_line() {
    local rc=1
    exec 8>>"$_line_lock" || return 1
    if lockf -s -t 3 8; then
        if speaker_alive && [ -n "$_speaker_line" ] && [ -p "$_fifo" ] && exec 7<>"$_fifo"; then
            _send_voice "$queue_delay" >&7 && rc=0
            exec 7<&-
        fi
    fi
    exec 8>&-
    return $rc
}

# Key repeat on a --queue key (Q22): presses under 0.5 s apart are one key
# held down, not a line of them. speak-queue.time holds the last --queue
# press in microseconds, overwritten in place and updated by every --queue
# press, so a key held down counts once however long it is held.
_queue_repeat() {
    local now="${EPOCHREALTIME:-}" last=""
    now="${now//[!0-9]/}"
    [ -n "$now" ] || now="$(perl -MTime::HiRes=time -e 'printf "%d", time * 1e6')"
    { read -r last <"$_queue_time"; } 2>/dev/null || true
    printf '%s\n' "$now" >"$_queue_time" 2>/dev/null
    case "$last" in ''|*[!0-9]*) return 1 ;; esac
    [ $((now - last)) -lt 500000 ]
}

# ---------------------------------------------------------------------------
# The cleaner. Prints four lines: sha256, truncated (0/1), chars, text.
# ---------------------------------------------------------------------------
read -r -d '' _clean_pl <<'PERL' || true
use strict; use warnings;
use Encode qw(decode);
use Unicode::Normalize qw(NFD);
use Digest::SHA qw(sha256_hex);
my $max = $ARGV[0] || 8000;

# --- Tables (v4.7) ---------------------------------------------------------
# A box-drawn or markdown table is re-spoken row by row as
#   "Row 1. Source. The record body... What it adds to a PADD. The detail..."
# Every name and cell becomes its own sentence because the full stop is what
# makes the voice pause; cells already hold commas, so a comma separator
# would sound like one more list item. Cells split on the vertical bars, not
# on column positions, so a table pasted with ragged indentation still
# parses. Lines between two rules are one row (a cell wrapped onto several
# lines is rejoined). A column empty in every row (an outer frame) is
# dropped. No header divider -> cells are just joined with full stops.
my $VB = qr/[\x{2502}\x{2503}\x{2551}]/;       # box verticals
sub _is_rule { $_[0] =~ /^[\s\x{2500}-\x{257F}]*[\x{2500}\x{2501}\x{2550}]{3}[\s\x{2500}-\x{257F}]*$/ }
sub _is_md_rule { $_[0] =~ /^\s*\|?\s*:?-{3,}:?\s*(?:\|\s*:?-{3,}:?\s*)+\|?\s*$/ }
sub _is_md_row { my $l = shift; return 0 unless $l =~ /^\s*\|.*\|\s*$/; my $n = () = $l =~ /\|/g; return $n >= 3 }
sub _vbars { my $n = () = $_[0] =~ /$VB/g; return $n }
# Cells of one row, WITHOUT the pieces outside the outermost bars. A box row
# is cut at the junction positions of the nearest rule line (lined up on the
# row's first bar, so ragged indentation is fine), which keeps a literal bar
# INSIDE a cell as text (v4.9: "│ Check │ Result │ cafe" in a cell became
# three extra columns). When the positions do not land on bars (wide
# characters, a hand-drawn table) it falls back to splitting on every bar.
sub _cut_by_rule {
    my ($l, $r) = @_;
    return undef unless defined $r;
    my @rj;
    while ($r =~ /[\x{2500}-\x{257F}]/g) {
        my $p = pos($r) - 1;
        push @rj, $p unless substr($r, $p, 1) =~ /[\x{2500}\x{2501}\x{2550}\x{2504}-\x{250B}\x{254C}\x{254D}]/;
    }
    return undef if @rj < 2 || $l !~ /$VB/;
    my $shift = $-[0] - $rj[0];
    my @b = map { $_ + $shift } @rj;
    for my $p (@b) {
        return undef if $p < 0 || $p >= length($l) || substr($l, $p, 1) !~ /$VB/;
    }
    my @c = map { substr($l, $b[$_] + 1, $b[$_ + 1] - $b[$_] - 1) } 0 .. $#b - 1;
    s/^\s+|\s+$//g for @c;
    return \@c;
}
sub _cells {
    my ($l, $md, $rule) = @_;
    if (!$md) {
        my $c = _cut_by_rule($l, $rule);
        return $c if $c;
    }
    my @c = $md ? split(/\|/, $l, -1) : split(/$VB/, $l, -1);
    shift @c; pop @c;                           # outside the outermost bars
    s/^\s+|\s+$//g for @c;
    return \@c;
}
sub _sentence {
    my $s = shift // '';
    $s =~ s/\s+/ /g; $s =~ s/^ | $//g;
    return '' if $s eq '';
    $s =~ s/[:;,]$//;
    $s .= '.' unless $s =~ /[.!?]$/;
    return $s;
}
sub _merge {                                    # lines of one row -> one cell list
    my @m;
    for my $line (@_) {
        for my $i (0 .. $#$line) {
            my $c = $line->[$i];
            $m[$i] = (defined $m[$i] && $m[$i] ne '') ? ($c eq '' ? $m[$i] : "$m[$i] $c") : $c;
        }
    }
    return \@m;
}
sub _speak_table {
    my ($groups, $md) = @_;
    my @rows;
    if (@$groups == 2) {
        # Header divider only: each line is a row, except that a line whose
        # first NAMED column is empty continues the row above (a wrapped cell).
        my $h = _merge(@{ $groups->[0] });
        push @rows, $h;
        my ($k) = grep { defined $h->[$_] && $h->[$_] ne '' } 0 .. $#$h;
        my @pending;
        for my $line (@{ $groups->[1] }) {
            if (!$md && @pending && defined $k && ($line->[$k] // '') eq '') {
                push @{ $pending[-1] }, $line;
            } else {
                push @pending, [$line];
            }
        }
        push @rows, _merge(@$_) for @pending;
    } else {
        push @rows, _merge(@$_) for @$groups;
    }
    my $ncol = 0; for (@rows) { $ncol = @$_ if @$_ > $ncol }
    my @keep = grep { my $j = $_; grep { defined $_->[$j] && $_->[$j] ne '' } @rows } 0 .. $ncol - 1;
    my @out;
    if (@$groups >= 2 && @rows >= 2) {
        my $h = shift @rows;
        my $n = 0;
        for my $r (@rows) {
            my @parts = ('Row ' . (++$n) . '.');
            for my $j (@keep) {
                my $c = _sentence($r->[$j]);
                next if $c eq '';
                push @parts, (_sentence($h->[$j]) || 'Column ' . ($j + 1) . '.'), $c;
            }
            push @out, join(' ', @parts);
        }
    } else {
        for my $r (@rows) {
            push @out, join(' ', grep { $_ ne '' } map { _sentence($r->[$_]) } @keep);
        }
    }
    return @out;
}
sub _tables {
    my @lines = split /\n/, $_[0], -1;
    my @out;
    my $i = 0;
    while ($i < @lines) {
        my $l = $lines[$i];
        my $box = _is_rule($l) || _vbars($l) >= 2;
        my $md = !$box && _is_md_row($l) && $i + 1 < @lines && _is_md_rule($lines[$i + 1]);
        if (!$box && !$md) { push @out, $l; $i++; next }
        my (@groups, @cur, $rule);
        while ($i < @lines) {
            my $x = $lines[$i];
            if ($md ? _is_md_rule($x) : _is_rule($x)) {
                if (@cur) { push @groups, [@cur]; @cur = () }
                $rule = $x unless $md;
                $i++; next;
            }
            last unless $md ? _is_md_row($x) : _vbars($x) >= 2;
            push @cur, _cells($x, $md, $rule);
            $i++;
        }
        push @groups, [@cur] if @cur;
        if (@groups == 1 && @{ $groups[0] } > 1) {  # no rules at all: each line alone
            @groups = map { [$_] } @{ $groups[0] };
            push @out, _speak_table([$_], $md) for @groups;
        } elsif (@groups) {
            push @out, _speak_table(\@groups, $md);
        }
    }
    return join("\n", @out);
}
# ---------------------------------------------------------------------------

local $/;
my $raw = <STDIN>;
$raw = '' unless defined $raw;
my $t = decode('UTF-8', $raw);                  # malformed bytes become U+FFFD, dropped below
$t =~ s/\e\[[0-9;?]*[ -\/]*[@-~]//g;            # ANSI CSI
$t =~ s/\e\][^\a]*(?:\a|\e\\)//g;               # OSC (titles, hyperlinks)
$t = _tables($t);                               # tables -> "Row 1. Name. Cell." (v4.7)
$t =~ s/[\x{2018}\x{2019}\x{201A}\x{2032}]/'/g; # single curly quotes, prime
$t =~ s/[\x{201C}\x{201D}\x{201E}\x{2033}]/"/g; # double curly quotes, double prime
$t =~ s/\p{Pd}/-/g;                             # every dash
$t =~ s/\x{2026}/.../g;                         # ellipsis
$t =~ s/\p{Zs}/ /g;                             # every space separator (NBSP etc.)
$t = NFD($t);                                   # split letters from their accents
$t =~ s/\p{Mn}//g;                              # drop the accents, keep the letters
# Letters with no decomposition: NFD cannot help, so map the common ones.
$t =~ s/\x{0141}/L/g; $t =~ s/\x{0142}/l/g;     # L-stroke
$t =~ s/\x{00D8}/O/g; $t =~ s/\x{00F8}/o/g;     # O-slash
$t =~ s/\x{00C6}/AE/g; $t =~ s/\x{00E6}/ae/g;   # ash
$t =~ s/\x{0152}/OE/g; $t =~ s/\x{0153}/oe/g;   # ethel
$t =~ s/\x{00DF}/ss/g;                          # eszett
$t =~ s/\x{0110}/D/g; $t =~ s/\x{0111}/d/g;     # D-stroke
$t =~ s/\x{00DE}/Th/g; $t =~ s/\x{00FE}/th/g;   # thorn
$t =~ s/\[\[/[ [/g;                             # no embedded speech commands
$t =~ s/[^\t\n\r\x20-\x7e]//g;                  # everything else outside printable ASCII
$t =~ s/[-=_.~*#+]{4,}/ /g;                     # rule runs and padding
$t =~ s/^[-*] +//mg;                            # list markers
$t =~ s/[ \t\r]+/ /g;                           # collapse spaces within lines
$t =~ s/^ | $//mg;                              # trim each line
$t =~ s/\n+/ /g;                                # join lines (drops blank lines)
$t =~ s/ {2,}/ /g;
$t =~ s/^ | $//g;
my $orig = length $t;
$t = substr($t, 0, $max) if $orig > $max;
print sha256_hex($t), "\n", ($orig > $max ? 1 : 0), "\n", length($t), "\n", $t, "\n";
PERL

clean_input() {
    if [ "$from_stdin" = 1 ]; then
        perl -e "$_clean_pl" -- "$_max_chars" 2>/dev/null
    else
        # LC_ALL is load-bearing (v4.8, 2026-09-28). pbpaste picks its output
        # encoding from the locale, and herdr launches this with none, so
        # every non-ASCII character came out as '?': box-drawn tables were
        # never seen as tables, and curly quotes and accents were lost.
        # MEASURED: Gavin's 5-row table logged 1255 chars from the hotkey;
        # the same table with each non-ASCII char made '?' cleans to exactly
        # 1255, intact UTF-8 to 451. `env -i pbpaste` printed "? Check ?",
        # the same with LC_ALL=en_US.UTF-8 or en_AU.UTF-8 printed the box bars.
        # en_AU is Gavin's own locale (his call, 2-way tested).
        LC_ALL=en_AU.UTF-8 pbpaste 2>/dev/null | perl -e "$_clean_pl" -- "$_max_chars" 2>/dev/null
    fi
}

# ---------------------------------------------------------------------------
# The line player (v8): one per line of voices, started by start_line and
# run as `perl - speak-clipboard-line <lock>` with this program on stdin.
# See PROFILES AND THE LINE in the header for why one player.
# ---------------------------------------------------------------------------
read -r -d '' _player_pl <<'PERL' || true
use strict; use warnings;
use POSIX ();
use Fcntl qw(:flock F_GETFL F_SETFL F_SETFD FD_CLOEXEC O_NONBLOCK);
use Time::HiRes qw(time);

# fd 3 is the line's named pipe, opened read-write by the press that
# started this player, so it never reads end-of-file and no press blocks
# opening it. One message per line:
#   V <tab> gap-ms <tab> voice <tab> rate <tab> volume <tab> text
my $lock_path = $ARGV[1];
my $BPS     = 96000;   # 48 kHz mono s16le: bytes per second (96 per ms)
my $LEAD    = 0.3;     # the next voice goes in when this much is left
my $END     = 0.1;     # the line is over when this much is left
my $RENDERS = 3;       # voices rendering at once: the current and the next two
my @FFPLAY  = qw(ffplay -nodisp -autoexit -infbuf -stats -loglevel error -volume 100
                 -f s16le -ar 48000 -ch_layout mono -i -);

open(my $line, '<&=', 3) or die "speak-clipboard line: no pipe on fd 3: $!\n";
fcntl($line, F_SETFD, FD_CLOEXEC);
nonblock($line);
my $skips = 0;
$SIG{USR1} = sub { $skips++ };
$SIG{PIPE} = 'IGNORE';
$SIG{HUP}  = 'IGNORE';

my @v;            # the voices in the order they came: see read_pipe
my $cur = 0;      # the voice being written to ffplay
my $msgs = '';    # a message read in part
my %ff;           # the one ffplay: pid, in, err, ebuf, written, clock, t0
my $end_lock;     # speak-line.flock, held from the decision to finish to exit

sub nonblock { my $fh = shift; fcntl($fh, F_SETFL, fcntl($fh, F_GETFL, 0) | O_NONBLOCK) }
sub note { print STDERR "speak-clipboard line: @_\n" }

# Returns how many voices came in. The gap is written as silence at the
# front of the voice: 96 bytes of zero samples per ms, exact to the sample.
sub read_pipe {
    my $new = 0;
    while (1) {
        my $n = sysread($line, my $b, 65536);
        last unless $n;
        $msgs .= $b;
    }
    while ($msgs =~ s/^([^\n]*)\n//) {
        my ($tag, $gap, $voice, $rate, $vol, $text) = split /\t/, $1, 6;
        next unless defined $text && $tag eq 'V';
        push @v, { voice => $voice, rate => $rate, f => $vol / 100, text => $text,
                   buf => "\0" x (96 * $gap), pos => 0, carry => '' };
        $new++;
    }
    return $new;
}

sub start_render {
    my $x = shift;
    $x->{started} = 1;
    my ($r, $w);
    pipe($r, $w) or do { note("no pipe for say2: $!"); $x->{done} = 1; return };
    my $pid = fork;
    if (!defined $pid) { note("no fork for say2: $!"); $x->{done} = 1; return }
    if ($pid == 0) {
        open(STDIN, '<', '/dev/null'); open(STDOUT, '>&', $w);
        { exec('say2', '-v', $x->{voice}, '-r', $x->{rate}, '--engine', 'siri',
               '--format', 'pcm', '-o', '-', '--', $x->{text}) };
        POSIX::_exit(127);
    }
    close $w; nonblock($r);
    $x->{pid} = $pid; $x->{out} = $r;
    delete $x->{text};
}

sub read_render {
    my $x = shift;
    my $n = sysread($x->{out}, my $b, 65536);
    return if !defined $n && $!{EAGAIN};
    if (!$n) { close $x->{out}; $x->{out} = undef; $x->{done} = 1; return }
    $b = $x->{carry} . $b;
    my $even = length($b) & ~1;
    $x->{carry} = substr($b, $even);
    $b = substr($b, 0, $even);
    # The voice's own volume, in its samples (Q17, Q18): x volume/100, the
    # linear scale ffplay -volume uses, so a profile sounds as loud as it
    # did with a player of its own. ffplay itself runs at 100.
    $b = pack('s<*', map { int($_ * $x->{f}) } unpack('s<*', $b)) if $x->{f} != 1;
    $x->{buf} .= $b;
}

sub ff_start {
    my ($r, $w, $er, $ew);
    (pipe($r, $w) && pipe($er, $ew)) or do { note("no pipe for ffplay: $!"); return 0 };
    my $pid = fork;
    if (!defined $pid) { note("no fork for ffplay: $!"); return 0 }
    if ($pid == 0) {
        open(STDIN, '<&', $r); open(STDOUT, '>', '/dev/null'); open(STDERR, '>&', $ew);
        { exec(@FFPLAY) };
        POSIX::_exit(127);
    }
    close $r; close $ew; nonblock($w); nonblock($er);
    %ff = (pid => $pid, in => $w, err => $er, ebuf => '', written => 0, clock => undef, t0 => undef);
    return 1;
}

# ffplay's status line (-stats, on stderr even at -loglevel error) starts
# with its clock: the seconds of audio it has played. Anything else it
# says goes to the render log.
sub ff_read_err {
    my $n = sysread($ff{err}, my $b, 8192);
    return if !defined $n && $!{EAGAIN};
    if (!$n) { close $ff{err}; $ff{err} = undef; return }
    $ff{ebuf} .= $b;
    while ($ff{ebuf} =~ s/^([^\r\n]*)[\r\n]//) {
        (my $l = $1) =~ s/\e\[[0-9;]*[A-Za-z]//g;
        if ($l =~ /^\s*(-?\d+(?:\.\d+)?)\s+M-A:/) { $ff{clock} = $1 < 0 ? 0 : $1 }
        elsif ($l =~ /\S/ && $l !~ /\bfd=\s*-?\d+\s+aq=/) { note("ffplay: $l") }
    }
}

# Seconds played: ffplay's own clock; until its first one (or if a later
# ffplay never prints one) a guess from the wall clock.
sub ff_played {
    return 0 unless $ff{pid} && defined $ff{t0};
    return $ff{clock} if defined $ff{clock};
    my $s = time - $ff{t0} - 0.5;
    return $s < 0 ? 0 : $s;
}
sub ff_left {
    return 0 unless $ff{pid};
    my $s = $ff{written} / $BPS - ff_played();
    return $s < 0 ? 0 : $s;
}
sub ff_kill {
    return unless $ff{pid};
    kill 'KILL', $ff{pid};
    waitpid($ff{pid}, 0);
    close $ff{in} if $ff{in};
    close $ff{err} if $ff{err};
    %ff = ();
}

# Writes the current voice into ffplay as it renders. A voice after the
# first waits until the one before has less than $LEAD left, so the one
# you hear is the only one in ffplay's buffer and --skip can take it alone.
sub feed {
    my $x = $v[$cur];
    return unless $ff{in} && length($x->{buf}) > $x->{pos};
    if (!defined $x->{start}) {
        return if $ff{written} > 0 && ff_left() > $LEAD;
        $x->{start} = $ff{written};
    }
    while ($x->{pos} < length $x->{buf}) {
        my $n = syswrite($ff{in}, $x->{buf}, 65536, $x->{pos});
        if (!defined $n) {
            return if $!{EAGAIN};
            note("ffplay stopped taking audio: $!");
            finish(1);
        }
        $x->{pos} += $n; $ff{written} += $n;
        $ff{t0} = time unless defined $ff{t0};
    }
}

# A voice that has played to its end no longer needs its audio.
sub free_played {
    my $played = ff_played() * $BPS;
    for my $x (@v[0 .. $cur - 1]) {
        next unless defined $x->{start} && length $x->{buf};
        $x->{buf} = '' if $played >= $x->{start} + length $x->{buf};
    }
}

# --skip (Q25): drop the voice you can hear. It may be the voice being
# written, or the one before it still playing out; with none audible, the
# next to speak. Killing ffplay is the only way to take audio back out of
# its buffer, so a voice after the dropped one already written into it is
# rewound and written again into the next ffplay.
sub skip {
    my $played = ff_played() * $BPS;
    my $p = $cur;
    for my $i (0 .. $#v) {
        my $x = $v[$i];
        next if $x->{gone} || !defined $x->{start} || $x->{start} > $played;
        if ($i == $cur || $played < $x->{start} + length $x->{buf}) { $p = $i; last }
    }
    return if $p > $#v;
    my $x = $v[$p];
    if (defined $x->{start}) {
        ff_kill();
        for my $y (@v[$p + 1 .. $#v]) { $y->{pos} = 0; delete $y->{start} }
    }
    if ($x->{out}) { kill 'KILL', $x->{pid} if $x->{pid}; close $x->{out}; $x->{out} = undef }
    $x->{gone} = 1; $x->{done} = 1; $x->{buf} = ''; $x->{pos} = 0;
    $cur = $p + 1;
}

sub reap {
    while ((my $pid = waitpid(-1, POSIX::WNOHANG())) > 0) {
        my $st = $? >> 8;
        if ($ff{pid} && $pid == $ff{pid}) {
            note("ffplay ended early (exit $st): the line ends here");
            %ff = ();
            finish(1);
        }
        for my $x (@v) {
            next unless $x->{pid} && $x->{pid} == $pid;
            note("say2 exit $st for a voice ($x->{voice})") if $st && !$x->{gone};
            $x->{pid} = undef;
        }
    }
}

# Nothing is left to write. Under speak-line.flock, which a --queue press
# holds while it checks for a live player and writes to it: a voice
# written before the lock is in the pipe now, and none can come after it,
# so a waiting voice is never lost. Returns 1 if one came in.
sub more_waiting {
    open(my $lk, '>>', $lock_path) or return 0;
    flock($lk, LOCK_EX);
    return 1 if read_pipe();
    $end_lock = $lk;
    return 0;
}

# The end of input lets ffplay play its last fraction of a second and
# exit; it is then waited for (3 s at most), still holding the lock.
sub finish {
    my $rc = shift;
    if ($ff{pid}) {
        close $ff{in} if $ff{in};
        my $until = time + 3;
        while ($ff{err} && time < $until) {
            my $rin = ''; vec($rin, fileno($ff{err}), 1) = 1;
            select(my $rout = $rin, undef, undef, 0.05);
            ff_read_err();
        }
        kill 'KILL', $ff{pid} if waitpid($ff{pid}, POSIX::WNOHANG()) == 0;
        waitpid($ff{pid}, 0);
    }
    for my $x (@v) { kill 'KILL', $x->{pid} if $x->{pid} }
    exit $rc;
}

# The first voice is in the pipe before this starts; 2 s is only a
# backstop, so a player never sits idle for ever.
my $wait_until = time + 2;
until (read_pipe() || time > $wait_until) { select(undef, undef, undef, 0.02) }
while (1) {
    if ($skips) { $skips = 0; skip() }
    read_pipe();
    for my $i ($cur .. $#v) {
        last if $i >= $cur + $RENDERS;
        start_render($v[$i]) unless $v[$i]{started} || $v[$i]{gone};
    }
    while ($cur <= $#v && ($v[$cur]{gone} || ($v[$cur]{done} && $v[$cur]{pos} >= length $v[$cur]{buf}))) {
        $cur++;
    }
    if ($cur <= $#v) {
        if (!$ff{pid}) { ff_start() or finish(1) }
        feed();
    } elsif (!$ff{pid} || ff_left() <= $END) {
        more_waiting() or finish(0);
        next;
    }
    reap();
    free_played();
    my $rin = '';
    vec($rin, fileno($line), 1) = 1;
    for my $x (@v) { vec($rin, fileno($x->{out}), 1) = 1 if $x->{out} }
    vec($rin, fileno($ff{err}), 1) = 1 if $ff{err};
    select(my $rout = $rin, undef, undef, 0.03);
    for my $x (@v) { read_render($x) if $x->{out} }
    ff_read_err() if $ff{err};
}
PERL

# ---------------------------------------------------------------------------
# --selftest (W-20261008-A05, W-20261009-A03; Gavin: "make sure all the
# tests are there and done"). Every arm runs this script as a separate
# process in its own temp folder (XDG_CONFIG_HOME and XDG_STATE_HOME point
# there), with stand-ins for say2, say, ffplay, osascript, herdr and pbpaste
# first on a PATH that holds no Homebrew folder, so nothing is spoken, no
# real notification shows, and the real settings and state are not read.
# The ffplay stand-in keeps every byte it is sent and prints ffplay's own
# status line, so an arm checks the exact samples a voice produced. Each
# stand-in voice is one sample value (Aaron 10001, Simone -20001, any other
# 3001), so the samples show whose voice it was and at what volume. Exits 1
# if any arm fails, and refuses (exit 1, saying why) where ps cannot see
# processes, as inside a Claude Code sandbox: a run that tested nothing is
# not a pass.
# ---------------------------------------------------------------------------
run_selftest() {
    local self T bin A out rc pass=0 fail=0 t1 t2 n1 n2 i t0 _st_unset=""
    case "$0" in /*) self="$0" ;; *) self="$PWD/$0" ;; esac
    if ! ps -o pid= -p $$ >/dev/null 2>&1; then
        echo "speak-clipboard --selftest: REFUSED, nothing was tested: ps cannot list processes here" >&2
        echo "  (a Claude Code sandbox blocks it). Run it in a normal terminal." >&2
        return 1
    fi
    T="$(mktemp -d "${TMPDIR:-/tmp}/speak-clipboard-selftest.XXXXXX")" || {
        echo "speak-clipboard --selftest: REFUSED, nothing was tested: could not make a temp folder" >&2; return 1; }
    bin="$T/bin"; mkdir -p "$bin"
    ln -s "$BASH" "$bin/bash"

    cat >"$bin/say2" <<'STANDIN'
#!/usr/bin/perl
# Stand-in for say2 and say (speak-clipboard --selftest): never speaks.
use strict; use warnings;
my $d = $ENV{STANDIN_DIR} or die "STANDIN_DIR is not set\n";
my @keys = split /,/, ($ENV{STANDIN_VOICES} // 'en-US:natural:male:Aaron:premium:5030,en-US:natural:female:Simone:premium:5029,en-US:neuralAX:male:Aaron:premium:1370');
if (@ARGV && $ARGV[0] eq 'voices') {
    if (@ARGV > 2 && $ARGV[1] eq '--status') {
        my $k = $ARGV[2];
        printf qq({\n  "identifier" : "%s",\n  "state" : "%s"\n}\n), $k, (grep { $_ eq $k } @keys) ? 'installed' : 'notInstalled';
        exit 0;
    }
    print "NAME    LANGUAGE  VERSION  ENGINE  INSTALLED  ASSET KEY\n";
    for (@keys) { my @f = split /:/; print "$f[3]  $f[0]  $f[5]  siri  yes  $_\n" }
    exit 0;
}
my (%o, $text);
while (@ARGV) {
    my $a = shift @ARGV;
    if ($a eq '--') { $text = join ' ', @ARGV; last }
    $o{$a} = shift @ARGV if $a =~ /^(?:-v|-r|-o|--engine|--format)$/;
}
$text = '' unless defined $text;
my $voice = $o{'-v'} // '';
my ($me) = $0 =~ m{([^/]+)$};
open my $log, '>>', "$d/say2.log" or die;
print $log "$me voice=$voice rate=" . ($o{'-r'} // '') . " out=" . ($o{'-o'} // 'play') . " chars=" . length($text) . "\n";
close $log;
my $samples = int(($ENV{STANDIN_MS_PER_CHAR} // 20) * length($text) * 48);
my $val = $voice =~ /natural:male:Aaron/ ? 10001 : $voice =~ /Simone/ ? -20001 : 3001;
select(undef, undef, undef, $ENV{STANDIN_RENDER_DELAY}) if $ENV{STANDIN_RENDER_DELAY};
if (($o{'-o'} // '') eq '-') {
    my $b = pack('s<*', ($val) x $samples);
    # Odd-sized writes, so the reader has to carry half a sample over.
    for (my $p = 0; $p < length $b; $p += 9601) { syswrite(STDOUT, $b, 9601, $p) or exit 1 }
    exit 0;
}
select(undef, undef, undef, $samples / 48000);   # direct play: as long as speech would take
STANDIN
    cp "$bin/say2" "$bin/say"

    cat >"$bin/ffplay" <<'STANDIN'
#!/usr/bin/perl
# Stand-in for ffplay (speak-clipboard --selftest): never plays a sound. Keeps
# every byte it is sent in ffplay.N.pcm, "plays" it in real time, and prints
# ffplay's -stats status line (unless STANDIN_FFPLAY_QUIET) on stderr.
use strict; use warnings; use Time::HiRes qw(time);
my $d = $ENV{STANDIN_DIR} or die "STANDIN_DIR is not set\n";
my $n = 1; $n++ while -e "$d/ffplay.$n.pcm";
open my $cap, '>', "$d/ffplay.$n.pcm" or die; binmode $cap;
open my $a, '>>', "$d/ffplay.args" or die; print $a "$n @ARGV\n"; close $a;
my ($got, $played, $eof, $last) = (0, 0, 0, time);
while (1) {
    my $rin = ''; vec($rin, 0, 1) = 1 unless $eof;
    select(my $r = $rin, undef, undef, 0.03);
    if (!$eof && vec($r, 0, 1)) {
        my $k = sysread(STDIN, my $b, 65536);
        if (!$k) { $eof = 1 } else { syswrite($cap, $b); $got += $k }
    }
    my $now = time; $played += ($now - $last) * 96000; $last = $now;
    $played = $got if $played > $got;
    printf STDERR "%7.2f M-A:  0.000 fd=   0 aq=%5dKB vq=    0KB sq=    0B \r", $played / 96000, ($got - $played) / 1024
        unless $ENV{STANDIN_FFPLAY_QUIET};
    last if $eof && $played >= $got;
}
STANDIN

    cat >"$bin/osascript" <<'STANDIN'
#!/bin/sh
# Stand-in for osascript (speak-clipboard --selftest): notes a notification's
# title and body (its last two arguments; a newline in the body becomes ~).
t=""; b=""
for a in "$@"; do t="$b"; b="$a"; done
{ printf '%s|' "$t"; printf '%s' "$b" | tr '\n' '~'; echo; } >>"$STANDIN_DIR/notify.log"
STANDIN
    printf '#!/bin/sh\necho "$*" >>"$STANDIN_DIR/herdr.log"\n' >"$bin/herdr"
    printf '#!/bin/sh\necho "clipboard stand-in text"\n' >"$bin/pbpaste"
    chmod +x "$bin"/*

    # One arm's folder: settings in $A/cfg, state in $A/state, stand-in
    # logs and captured audio in $A/standin.
    _st_arm() { A="$T/$1"; mkdir -p "$A/standin" "$A/cfg/speak-clipboard"; }
    _st_file() { printf '%s' "$1" >"$A/cfg/speak-clipboard/settings"; }
    _st() {
        env $_st_unset PATH="$bin:/usr/bin:/bin:/usr/sbin:/sbin" XDG_CONFIG_HOME="$A/cfg" \
            XDG_STATE_HOME="$A/state" STANDIN_DIR="$A/standin" NO_COLOR=1 "$bin/bash" "$self" "$@"
    }
    _ok() {
        local d="$1"; shift
        if "$@"; then pass=$((pass + 1)); printf '  ok    %s\n' "$d"
        else fail=$((fail + 1)); printf '  FAIL  %s\n' "$d"; fi
    }
    _has() { case "$1" in *"$2"*) return 0 ;; esac; return 1; }
    _lacks() { ! _has "$1" "$2"; }
    _log_last() { tail -n 1 "$A/state/herdr/speak-clipboard.log" 2>/dev/null; }
    _say_log() { cat "$A/standin/say2.log" 2>/dev/null; }
    _notes() { cat "$A/standin/notify.log" 2>/dev/null; }
    _cfg() { cat "$A/cfg/speak-clipboard/settings" 2>/dev/null; }
    # The samples in a captured .pcm as value*count runs: "7000*4800 0*7200".
    _runs() {
        [ -f "$A/standin/ffplay.$1.pcm" ] || { echo "(no ffplay.$1)"; return; }
        perl -e 'local $/; my $b = <STDIN>; $b = "" unless defined $b; my @r;
                 for (unpack "s<*", $b) { if (@r && $r[-1][0] == $_) { $r[-1][1]++ } else { push @r, [$_, 1] } }
                 print join(" ", map { "$_->[0]*$_->[1]" } @r), "\n"' <"$A/standin/ffplay.$1.pcm"
    }
    # Until the arm's speaker is gone (10 s at most).
    _st_idle() {
        local p="" k=0
        while [ $k -lt 200 ]; do
            p=""; { read -r p <"$A/state/herdr/speak-render.pid"; } 2>/dev/null || true
            [ -n "$p" ] && kill -0 "$p" 2>/dev/null || return 0
            sleep 0.05; k=$((k + 1))
        done
        _st --stop >/dev/null 2>&1
        return 1
    }
    _now_ms() { local t="${EPOCHREALTIME:-}"; t="${t//[!0-9]/}"; echo $(( ${t:-0} / 1000 )); }
    # Samples a stand-in voice makes for text of $1 characters at $2 ms each.
    _n() { echo $(($1 * $2 * 48)); }

    local aaron="en-US:natural:male:Aaron:premium:5030" simone="en-US:natural:female:Simone:premium:5029"
    local other="en-US:neuralAX:male:Aaron:premium:1370"
    local P2="# test profiles
; a semicolon comment
[aaron_fast]
rate=440
volume=70
voice=$aaron
notify=off

[simone_fast]
rate=380
volume=60
voice=$simone
notify=off

[third]
rate=300
volume=50
voice=$other
notify=off
"
    echo "speak-clipboard --selftest (temp folder: $T)"

    echo "File format and profile selection"
    _st_arm format; _st_file "$P2"
    _ok "no --profile reads the first profile"       [ "$(_st --get rate)" = 440 ]
    _ok "--profile reads that profile"                [ "$(_st --get rate --profile simone_fast)" = 380 ]
    _ok "--profile reads that profile's voice"        [ "$(_st --get voice --profile simone_fast)" = "$simone" ]
    _ok "a file with nothing wrong is left as it was" [ "$(_cfg)" = "${P2%$'\n'}" ]
    echo "hello world" | _st --stdin >/dev/null 2>&1; _st_idle
    echo "hello world" | _st --stdin --profile simone_fast >/dev/null 2>&1; _st_idle
    out="$(_say_log)"
    _ok "a press uses the first profile's voice and rate" _has "$out" "say2 voice=$aaron rate=440 out=-"
    _ok "--profile uses that profile's voice and rate"    _has "$out" "say2 voice=$simone rate=380 out=-"
    _ok "first profile: its volume (70) in the samples"   [ "$(_runs 1)" = "7000*$(_n 11 20)" ]
    _ok "--profile: its volume (60) in the samples"       [ "$(_runs 2)" = "-12000*$(_n 11 20)" ]
    _ok "ffplay itself plays at -volume 100"              _has "$(cat "$A/standin/ffplay.args")" "-volume 100"

    echo "Warnings in the file"
    _st_arm warnings
    _st_file "rate=300
[aaron_fast]
rate=440
volume=70
voice=$aaron
notify=off
rate=450
[simone_fast]
rate=380
voice=$simone
notify=off
[bad name]
rate=100
"
    echo "hello world" | _st --stdin --profile simone_fast >/dev/null 2>&1; rc=$?; _st_idle
    _ok "a press on a profile missing a setting exits 10"   [ "$rc" = 10 ]
    # Line 13, not 12: the put-back volume=60 now sits above [bad name].
    out="$(_log_last)"
    _ok "...and logs it"                                    _has "$out" "settings=missing:volume"
    _ok "...and logs the file's warnings"                   _has "$out" "warn=above-heading:1,twice:aaron_fast:rate,bad-heading:13"
    _ok "...using the default volume (60) for it"           [ "$(_runs 1)" = "-12000*$(_n 11 20)" ]
    _ok "the missing setting is put back in its own block"  _has "$(_cfg)" "notify=off
volume=60
[bad name]"
    out="$(_st --settings --profile aaron_fast 2>&1)"
    _ok "--settings warns: a setting above the first heading" _has "$out" "line 1: rate=300 is above the first [heading]: not used"
    _ok "--settings warns: a setting twice in one profile"   _has "$out" "[aaron_fast] sets rate twice (lines 3 and 7): line 7 is used"
    _ok "--settings warns: a heading that is not a name"     _has "$out" "line 13: [bad name] is not a usable profile name"
    _ok "the last of a setting set twice is the one used"    [ "$(_st --get rate)" = 450 ]
    echo "hello world" | _st --stdin >/dev/null 2>&1; rc=$?; _st_idle
    _ok "a press on a complete profile exits 0, warnings or not" [ "$rc" = 0 ]

    echo "Unknown profile (exit 6)"
    _st_arm unknown; _st_file "$P2"
    echo "hello world" | _st --stdin --profile nope >/dev/null 2>&1; rc=$?
    _ok "a press with an unknown profile exits 6"           [ "$rc" = 6 ]
    _ok "...speaks nothing (no render at all)"              [ ! -e "$A/standin/say2.log" ]
    _ok "...and a notification names the profile"          _has "$(_notes)" "No profile named 'nope'"
    _st --set rate 300 --profile nope >/dev/null 2>&1; rc=$?
    _ok "--set on an unknown profile exits 6"               [ "$rc" = 6 ]
    _st --get rate --profile nope >/dev/null 2>&1; rc=$?
    _ok "--get on an unknown profile exits 6"               [ "$rc" = 6 ]
    _st --reset all --profile nope >/dev/null 2>&1; rc=$?
    _ok "--reset on an unknown profile exits 6"             [ "$rc" = 6 ]
    _st --settings --profile nope >/dev/null 2>&1; rc=$?
    _ok "--settings on an unknown profile exits 6"          [ "$rc" = 6 ]
    _ok "...and the file is untouched"                      [ "$(_cfg)" = "${P2%$'\n'}" ]

    echo "--new-profile, --remove-profile, --profiles"
    _st_arm manage; _st_file "$P2"
    _st --new-profile extra >/dev/null 2>&1; rc=$?
    _ok "--new-profile makes a profile"                     [ "$rc" = 0 ]
    _ok "...a copy of the first profile"                    [ "$(_st --get all --profile extra)" = "rate=440
volume=70
voice=$aaron
notify=off" ]
    _ok "...as a block at the end of the file"              _has "$(_cfg)" "voice=$other
notify=off

[extra]
rate=440"
    _st --new-profile extra >/dev/null 2>&1; rc=$?
    _ok "--new-profile refuses a name that exists (3)"      [ "$rc" = 3 ]
    _st --new-profile "two words" >/dev/null 2>&1; rc=$?
    _ok "--new-profile refuses a space (3)"                 [ "$rc" = 3 ]
    _st --new-profile a.b >/dev/null 2>&1; rc=$?
    _ok "--new-profile refuses a dot (3)"                   [ "$rc" = 3 ]
    _st --set rate 300 --profile extr >/dev/null 2>&1; rc=$?
    _ok "--set with a mistyped profile exits 6..."          [ "$rc" = 6 ]
    _ok "...and makes no stray profile"                     _lacks "$(_cfg)" "[extr]"
    _st --set rate 333 --profile extra >/dev/null 2>&1
    _ok "--set --profile changes only that profile"         [ "$(_st --get rate --profile extra) $(_st --get rate)" = "333 440" ]
    _st --remove-profile extra >/dev/null 2>&1; rc=$?
    _ok "--remove-profile works"                            [ "$rc" = 0 ]
    _ok "...renaming the heading to NAME_REMOVED"           _has "$(_cfg)" "[extra_REMOVED]
rate=333"
    _st --get rate --profile extra >/dev/null 2>&1; rc=$?
    _ok "a removed profile is unusable by its name (6)"     [ "$rc" = 6 ]
    _st --get rate --profile extra_REMOVED >/dev/null 2>&1; rc=$?
    _ok "...and by its _REMOVED name (6)"                   [ "$rc" = 6 ]
    _st --new-profile extra >/dev/null 2>&1; _st --remove-profile extra >/dev/null 2>&1
    _ok "a second removal of the same name: NAME_REMOVED_2" _has "$(_cfg)" "[extra_REMOVED_2]"
    out="$(_st --profiles 2>&1)"
    _ok "--profiles marks the first profile"                _has "$out" "* aaron_fast "
    _ok "--profiles lists the others"                       _has "$out" "  simone_fast "
    _ok "--profiles hides removed ones..."                  _lacks "$out" "extra"
    _ok "...and counts them"                                _has "$out" "2 removed"
    _st_arm last; _st_file "[only]
rate=440
volume=70
voice=$aaron
notify=off
"
    _st --remove-profile only >/dev/null 2>&1; rc=$?
    _ok "--remove-profile refuses the last profile (3)"     [ "$rc" = 3 ]
    _ok "...and leaves it in place"                         _has "$(_cfg)" "[only]"

    echo "Migration of a flat file"
    _st_arm migrate; _st_file "# my old settings
rate=400
volume=50
voice=$aaron
notify=off
"
    out="$(_st --settings 2>&1)"
    _ok "the run that migrates says so"                     _has "$out" "now the [default] profile"
    _ok "a flat file becomes one [default] block, comment kept" [ "$(_cfg)" = "# my old settings
[default]
rate=400
volume=50
voice=$aaron
notify=off" ]
    _ok "...with the same values"                           [ "$(_st --get rate)" = 400 ]

    echo "--queue"
    t1="aaaa bbbb cccc"; t2="dd ee"; n1=$(_n 14 100); n2=$(_n 5 100)
    _st_arm queue; _st_file "$P2"
    export STANDIN_MS_PER_CHAR=100
    echo "$t1" | _st --stdin >/dev/null 2>&1; sleep 0.6
    echo "$t2" | _st --stdin --queue --profile simone_fast >/dev/null 2>&1; rc=$?
    _ok "a --queue press while speaking exits 0"           [ "$rc" = 0 ]
    _ok "...and is logged as queued"                        _has "$(_log_last)" "outcome=queued profile=simone_fast"
    _st_idle
    _ok "both voices, back to back, in ONE player"          [ "$(_runs 1)" = "7000*$n1 -12000*$n2" ]
    _ok "...no second player was started"                  [ ! -e "$A/standin/ffplay.2.pcm" ]
    _st_arm queue-gap; _st_file "$P2"
    echo "$t1" | _st --stdin >/dev/null 2>&1; sleep 0.6
    echo "$t2" | _st --stdin --queue 150 --profile simone_fast >/dev/null 2>&1
    _st_idle
    _ok "--queue 150: 7200 zero samples (14400 bytes) between" [ "$(_runs 1)" = "7000*$n1 0*7200 -12000*$n2" ]
    _st_arm queue-idle; _st_file "$P2"
    echo "$t2" | _st --stdin --queue 150 --profile simone_fast >/dev/null 2>&1
    _ok "a --queue press with nothing playing speaks now"   _has "$(_log_last)" "outcome=started"
    _st_idle
    _ok "...with no gap in front"                           [ "$(_runs 1)" = "-12000*$n2" ]
    for i in 5001 abc -5 1.5; do
        _st --queue "$i" --print --stdin </dev/null >/dev/null 2>&1; rc=$?
        _ok "--queue $i is refused (3)"                     [ "$rc" = 3 ]
    done
    echo "x" | _st --queue 5000 --print --stdin >/dev/null 2>&1; rc=$?
    _ok "--queue 5000 is accepted"                          [ "$rc" = 0 ]
    _st --toggle --queue </dev/null >/dev/null 2>&1; rc=$?
    _ok "--toggle with --queue is refused (2)"              [ "$rc" = 2 ]

    echo "Key repeat"
    _st_arm repeat; _st_file "$P2"
    echo "$t1" | _st --stdin >/dev/null 2>&1; sleep 0.6
    echo "$t2" | _st --stdin --queue --profile simone_fast >/dev/null 2>&1
    echo "$t2" | _st --stdin --queue --profile simone_fast >/dev/null 2>&1; rc=$?
    _ok "a second --queue press under 0.5 s is busy, exit 0" [ "$rc" = 0 ]
    _ok "...logged as key repeat"                           _has "$(_log_last)" "outcome=busy queue=key-repeat"
    _st_idle
    _ok "...and the voice waits in line once, not twice"    [ "$(_runs 1)" = "7000*$n1 -12000*$n2" ]

    echo "Stopping: --skip, --stop, a plain press, --toggle"
    t1="aaaa bbbb cccc dddd eeee"; n1=$(_n 24 100)
    _st_arm skip; _st_file "$P2"
    echo "$t1" | _st --stdin >/dev/null 2>&1; sleep 0.6
    echo "$t2" | _st --stdin --queue --profile simone_fast >/dev/null 2>&1; sleep 0.3
    t0=$(_now_ms); _st --skip >/dev/null 2>&1; rc=$?
    [ "$rc" = 0 ] && _has "$(_log_last)" "outcome=skipped"; _ok "--skip exits 0, logged as skipped" [ $? = 0 ]
    _st_idle
    _ok "...the voice you heard was cut, the line ended early" [ $(( $(_now_ms) - t0 )) -lt 1500 ]
    _ok "...its player held only that voice"                [ "$(_runs 1)" = "7000*$n1" ]
    _ok "...and the next in line played whole"              [ "$(_runs 2)" = "-12000*$n2" ]
    _st_arm stop; _st_file "$P2"
    echo "$t1" | _st --stdin >/dev/null 2>&1; sleep 0.6
    echo "$t2" | _st --stdin --queue --profile simone_fast >/dev/null 2>&1; sleep 0.3
    _st --stop >/dev/null 2>&1
    _ok "--stop is logged as stopped"                       _has "$(_log_last)" "outcome=stopped"
    sleep 0.3
    _ok "...and the player is gone at once"                 _st_idle
    [ "$(_runs 1)" = "7000*$n1" ] && [ ! -e "$A/standin/ffplay.2.pcm" ]; _ok "...the voice playing was the only one ever played" [ $? = 0 ]
    _st_arm slate; _st_file "$P2"
    echo "$t1" | _st --stdin >/dev/null 2>&1; sleep 0.6
    echo "$t2" | _st --stdin --queue --profile simone_fast >/dev/null 2>&1; sleep 0.3
    echo "ff gg" | _st --stdin --profile third >/dev/null 2>&1
    _ok "a press without --queue replaces the line"         _has "$(_log_last)" "outcome=replaced profile=third"
    _st_idle
    _ok "...the waiting voice never plays"                  [ "$(_runs 1)" = "7000*$n1" ]
    _ok "...the new text plays alone (volume 50: 1500)"     [ "$(_runs 2)" = "1500*$(_n 5 100)" ]
    _st_arm toggle; _st_file "$P2"
    echo "$t1" | _st --stdin >/dev/null 2>&1; sleep 0.3
    echo "$t2" | _st --stdin --toggle >/dev/null 2>&1
    _ok "--toggle while speaking stops"                     _has "$(_log_last)" "outcome=stopped"
    sleep 0.3
    _ok "...at once"                                        _st_idle
    _st_arm skip-idle; _st_file "$P2"
    _st --skip >/dev/null 2>&1; rc=$?
    [ "$rc" = 0 ] && _has "$(_log_last)" "outcome=idle"; _ok "--skip with nothing playing: idle, exit 0" [ $? = 0 ]
    unset STANDIN_MS_PER_CHAR

    echo "Locale (d78e8de: lstart follows the locale)"
    export STANDIN_MS_PER_CHAR=100
    _st_arm locale-1; _st_file "$P2"
    echo "$t1" | LC_ALL=en_AU.UTF-8 _st --stdin >/dev/null 2>&1; sleep 0.3
    _st_unset="-u LC_ALL -u LANG -u LC_TIME"
    echo "$t1" | _st --stdin --toggle >/dev/null 2>&1
    _st_unset=""
    _ok "started under en_AU, a toggle with no locale stops it" _has "$(_log_last)" "outcome=stopped"
    _ok "...leaving no voice"                               _st_idle
    _st_arm locale-2; _st_file "$P2"
    _st_unset="-u LC_ALL -u LANG -u LC_TIME"
    echo "$t1" | _st --stdin >/dev/null 2>&1; sleep 0.3
    _st_unset=""
    echo "$t1" | LC_ALL=en_AU.UTF-8 _st --stdin --toggle >/dev/null 2>&1
    _ok "started with no locale, a toggle under en_AU stops it" _has "$(_log_last)" "outcome=stopped"
    _ok "...leaving no voice"                               _st_idle
    unset STANDIN_MS_PER_CHAR

    echo "Every voice streams"
    _st_arm voice; _st_file "$P2"
    echo "hello world" | _st --stdin --voice "$other" >/dev/null 2>&1; _st_idle
    _ok "--voice streams through the player"                _has "$(_say_log)" "say2 voice=$other rate=440 out=-"
    _ok "...at the profile's volume (70: 2100)"             [ "$(_runs 1)" = "2100*$(_n 11 20)" ]
    echo "hello world" | _st --stdin --volume 33 >/dev/null 2>&1; _st_idle
    echo "hello world" | _st --stdin --volume 100 >/dev/null 2>&1; _st_idle
    _ok "the volume step is exact: 10001 x 33/100 = 3300"   [ "$(_runs 2)" = "3300*$(_n 11 20)" ]
    _ok "...and 100 leaves the samples alone"               [ "$(_runs 3)" = "10001*$(_n 11 20)" ]
    _st_arm quiet; _st_file "$P2"
    echo "hello world" | STANDIN_FFPLAY_QUIET=1 _st --stdin >/dev/null 2>&1
    _ok "an ffplay with no clock line: the line still ends" _st_idle
    _ok "...having played everything"                      [ "$(_runs 1)" = "7000*$(_n 11 20)" ]

    echo "Settings and exit codes (v6, v7)"
    _st_arm settings
    _ok "a missing file is written..."                      [ "$(_st --get all)" = "rate=420
volume=60
voice=$aaron
notify=on" ]
    _ok "...as a [default] profile"                         _has "$(_cfg)" "[default]"
    _st --set rate 300 >/dev/null 2>&1
    _ok "--set rate saves"                                  [ "$(_st --get rate)" = 300 ]
    _ok "...with a notification (notify on)"                _has "$(_notes)" "Rate: 420 -> 300 wpm"
    _st --set rate +20 >/dev/null 2>&1
    _ok "--set rate +20 steps"                              [ "$(_st --get rate)" = 320 ]
    _st --set rate +1000 >/dev/null 2>&1
    _ok "--set rate +1000 stops at 700"                     [ "$(_st --get rate)" = 700 ]
    i=$(wc -l <"$A/standin/notify.log")
    _st --no-notify --set volume -10 >/dev/null 2>&1
    [ "$(_st --get volume)" = 50 ] && [ "$(wc -l <"$A/standin/notify.log")" = "$i" ]; _ok "--no-notify --set: saved, no notification" [ $? = 0 ]
    _st --notify --settings >/dev/null 2>&1
    _ok "--notify --settings sends the settings"            _has "$(_notes)" "Speak clipboard settings: default|Rate: 700 wpm"
    _st --reset all >/dev/null 2>&1
    _ok "--reset all writes the defaults back"              [ "$(_st --get rate)" = 420 ]
    for i in "--set volume abc:3" "--set notify maybe:3" "--set rate 0:3" "--set:2" "--set speed 3:2" "--bogus:2" "--get bogus:2" "--reset bogus:2" "--profile:2" "--set voice 9:3"; do
        _st ${i%:*} </dev/null >/dev/null 2>&1; rc=$?
        _ok "${i%:*} exits ${i##*:}"                        [ "$rc" = "${i##*:}" ]
    done
    out="$(_st --voices 2>&1)"
    _has "$out" "* 1   Aaron" && _has "$out" "  2   Simone"; _ok "--voices lists the voices, the one in use marked" [ $? = 0 ]
    _st --set voice 2 >/dev/null 2>&1
    _ok "--set voice 2 saves that voice's key"              [ "$(_st --get voice)" = "$simone" ]
    out="$(printf '%s\n' "- hello   world  " | _st --print --stdin)"
    _ok "--print prints what would be spoken"               [ "$out" = "hello world" ]
    printf '' | _st --stdin >/dev/null 2>&1; rc=$?
    _ok "nothing to say exits 1"                            [ "$rc" = 1 ]
    _st_arm bad-value; _st_file "[p]
rate=fast
volume=70
voice=$aaron
notify=off
"
    echo "hello world" | _st --stdin >/dev/null 2>&1; rc=$?; _st_idle
    [ "$rc" = 10 ] && _has "$(_log_last)" "settings=bad:rate"; _ok "a bad value in the file: exit 10" [ $? = 0 ]
    _ok "...spoken at the default rate"                     _has "$(_say_log)" "rate=420"
    _ok "...and the bad value is kept for Gavin to fix"     _has "$(_cfg)" "rate=fast"
    _st_arm not-installed; _st_file "$P2"
    echo "hello world" | STANDIN_VOICES="$aaron" _st --stdin --profile simone_fast >/dev/null 2>&1; rc=$?; _st_idle
    [ "$rc" = 11 ] && _has "$(_log_last)" "voice=fallback:$aaron"; _ok "the saved voice is not installed: exit 11" [ $? = 0 ]
    _st_arm unusable; mkdir -p "$A/cfg/speak-clipboard/settings"
    echo "hello world" | _st --stdin >/dev/null 2>&1; rc=$?; _st_idle
    [ "$rc" = 12 ] && _has "$(_log_last)" "file=unusable"; _ok "the file cannot be read: exit 12" [ $? = 0 ]
    _ok "...and it still spoke"                             _has "$(_say_log)" "say2 voice=$aaron"
    _st_arm readonly; _st_file "$P2"; chmod a-w "$A/cfg/speak-clipboard"
    _st --set rate 300 >/dev/null 2>&1; rc=$?
    chmod u+w "$A/cfg/speak-clipboard"
    _ok "the file cannot be written: exit 4"                [ "$rc" = 4 ]

    echo
    if [ "$fail" -eq 0 ]; then
        echo "speak-clipboard --selftest: all $pass checks passed."
    else
        echo "speak-clipboard --selftest: $fail of $((pass + fail)) checks FAILED."
    fi
    echo "(temp folder left for macOS to clear: $T)"
    [ "$fail" -eq 0 ]
}

# ---------------------------------------------------------------------------
# Modes
# ---------------------------------------------------------------------------
# Every --set and --reset shows the values before and after (Gavin's ask,
# 2026-10-08), as one box whose changed rows read "old -> new"
# (dotfiles-main Q6). "Before" is the saved state, so a --rate or --volume
# on the same command does not show in it. The box comes from re-running
# this script as --settings, so "after" is read back from the file just
# written, not from memory; _SPEAK_CLIPBOARD_BEFORE carries the old values
# across the exec, and --profile goes along so it is the same profile.
_save_showing_change() {
    local before="${saved_rate:-$_default_rate}|${saved_volume:-$_default_volume}|${saved_voice:-$_default_voice}|${saved_notify:-$_default_notify}"
    _write_settings || { [ "$notify" != "on" ] || _send_notification "Speak clipboard: $profile" "Could not save $(_tilde "$_settings_file")"; exit 4; }
    if [ -n "$cli_profile" ]; then
        _SPEAK_CLIPBOARD_BEFORE="$before" _SPEAK_CLIPBOARD_NOTIFY="$cli_notify" exec "$0" --settings --profile "$cli_profile"
    fi
    _SPEAK_CLIPBOARD_BEFORE="$before" _SPEAK_CLIPBOARD_NOTIFY="$cli_notify" exec "$0" --settings
}

# Q16: an unknown profile is refused and never swapped for another one, or
# a wrong voice would be hard to trace back ("it'll become difficult to
# debug"). Nothing spoken or saved; a notification names it, because a
# hotkey has no screen to print to (--no-notify skips it).
_no_such_profile() {
    echo "speak-clipboard: no profile named '$1'. speak-clipboard --profiles lists them." >&2
    [ "$cli_notify" = "off" ] ||
        _send_notification "Speak clipboard" "No profile named '$1'"$'\n'"Nothing spoken. speak-clipboard --profiles lists them."
    trace "outcome=no-profile profile=$1 exit=6"
    exit 6
}

# --profiles (Q24): every usable profile and its settings as written, the
# first one marked. Removed ones are counted, not listed.
show_profiles() {
    local i w=7 removed=0 first=1 mark note
    for ((i = 0; i < ${#p_name[@]}; i++)); do
        [ ${#p_name[i]} -le "$w" ] || w=${#p_name[i]}
    done
    printf '  %-*s %-5s %-7s %-8s %s\n' "$w" PROFILE RATE VOLUME VOICE NOTIFY
    for ((i = 0; i < ${#p_name[@]}; i++)); do
        if _is_removed "${p_name[i]}"; then removed=$((removed + 1)); continue; fi
        mark=" "; note=""
        if [ "$first" = 1 ]; then mark="*"; note="   (first: used without --profile)"; first=0; fi
        printf '%s %-*s %-5s %-7s %-8s %s%s\n' "$mark" "$w" "${p_name[i]}" "${pr_rate[i]}" "${pr_volume[i]}" \
            "$(_voice_name "${pr_voice[i]}")" "${pr_notify[i]}" "$note"
    done
    echo
    echo "Use one: speak-clipboard --profile NAME (any command). Settings: speak-clipboard --settings --profile NAME"
    [ "$removed" -eq 0 ] || echo "$removed removed (NAME_REMOVED in $(_tilde "$_settings_file"), not listed; deleting one is a hand edit)"
    [ -z "$_file_warnings" ] || printf '\n%s' "$_file_warnings"
    [ "$_file_state" = "ok" ] || echo "WARNING the settings file could not be read or created: default values used (exit 12)"
}

if [ "$mode" = "selftest" ] && [ -z "$_usage_error" ]; then
    run_selftest
    exit $?
fi

_ensure_settings_file
_load_profile

[ -z "$_usage_error" ] || _die_with_help "$_usage_code" "$_usage_error"

case "$mode" in
    speak|toggle|print|set|reset|get|settings|voices)
        [ -z "$_profile_missing" ] || _no_such_profile "$_profile_missing" ;;
esac

case "$mode" in
    help) _print_help; exit 0 ;;
    settings)
        show_settings
        if [ -n "${_SPEAK_CLIPBOARD_BEFORE:-}" ]; then
            [ "$notify" != "on" ] || _notify_change          # after a --set or --reset
        elif [ "$cli_notify" = "on" ]; then
            _notify_summary                                  # --notify --settings
        fi
        exit 0 ;;
    profiles) show_profiles; exit 0 ;;
    new-profile)
        # Q13 v3: always a copy of the first profile, no --from. Refused if
        # the name is taken, so it never overwrites one.
        _valid_profile_name "$profile_arg" ||
            _die_with_help 3 "a profile name takes letters, digits, _ and - only, not '$profile_arg'"
        ! _is_removed "$profile_arg" ||
            _die_with_help 3 "'$profile_arg' ends the way a removed profile does (_REMOVED): pick another name"
        [ "$_file_state" = "ok" ] || { echo "speak-clipboard: could not write $(_tilde "$_settings_file")" >&2; exit 4; }
        for ((i = 0; i < ${#p_name[@]}; i++)); do
            [ "${p_name[i]}" != "$profile_arg" ] || _die_with_help 3 "there is already a profile named '$profile_arg'"
        done
        _first_usable; src=$_fp
        _new_profile_slot "$profile_arg" -1
        pr_rate[_np]="${pr_rate[src]}"; pr_volume[_np]="${pr_volume[src]}"
        pr_voice[_np]="${pr_voice[src]}"; pr_notify[_np]="${pr_notify[src]}"
        src="${p_name[src]}"; _pi=-1
        _write_settings || exit 4
        echo "New profile [$profile_arg], a copy of [$src]. Change it: speak-clipboard --set rate N --profile $profile_arg"
        echo
        show_profiles
        [ "$notify" != "on" ] || _send_notification "Speak clipboard" "New profile: $profile_arg"$'\n'"A copy of $src"
        exit 0 ;;
    remove-profile)
        # Q24: the heading is renamed, never deleted; the last usable
        # profile stays, because a press needs one.
        [ "$_file_state" = "ok" ] || { echo "speak-clipboard: could not write $(_tilde "$_settings_file")" >&2; exit 4; }
        _find_profile "$profile_arg" || _no_such_profile "$profile_arg"
        target=$_fp; usable=0
        for ((i = 0; i < ${#p_name[@]}; i++)); do _is_removed "${p_name[i]}" || usable=$((usable + 1)); done
        [ "$usable" -gt 1 ] || _die_with_help 3 "'$profile_arg' is the last profile left, and a press needs one"
        new="${profile_arg}_REMOVED"; n=2
        while :; do
            taken=0
            for ((i = 0; i < ${#p_name[@]}; i++)); do [ "${p_name[i]}" != "$new" ] || taken=1; done
            [ "$taken" = 1 ] || break
            new="${profile_arg}_REMOVED_$n"; n=$((n + 1))
        done
        p_name[target]="$new"; _pi=-1
        _write_settings || exit 4
        echo "Removed [$profile_arg]: its heading is now [$new], so it is not listed or usable. Deleting it is a hand edit."
        echo
        show_profiles
        [ "$notify" != "on" ] || _send_notification "Speak clipboard" "Removed profile: $profile_arg"
        exit 0 ;;
    get)
        case "$set_key" in
            rate)   echo "$rate" ;;
            volume) echo "$volume" ;;
            voice)  echo "$_preferred_voice" ;;
            notify) echo "$notify" ;;
            all)    printf 'rate=%s\nvolume=%s\nvoice=%s\nnotify=%s\n' "$rate" "$volume" "$_preferred_voice" "$notify" ;;
            *) _die_with_help 2 "--get takes rate, volume, voice or notify, not '$set_key'" ;;
        esac
        exit 0 ;;
    voices)   show_voices; exit $? ;;
    set)
        case "$set_key" in
            rate)   if _step "$set_value" "${saved_rate:-$_default_rate}" 1 700; then set_value="$_stepped"; fi
                    _valid_rate "$set_value" || _die_with_help 3 "rate takes a whole number 1-700 (say2's own limit), or +N / -N to step"
                    f_rate="$set_value" ;;
            volume) if _step "$set_value" "${saved_volume:-$_default_volume}" 0 100; then set_value="$_stepped"; fi
                    _valid_volume "$set_value" || _die_with_help 3 "volume takes a whole number 0-100, or +N / -N to step"
                    f_volume="$set_value" ;;
            voice)  _pick_voice "$set_value"; rc=$?
                    # 3 (no such voice) is a mistake in the command, so the
                    # help follows _pick_voice's own message; 5 (say2 cannot
                    # list voices) is not, and help would not fix it.
                    if [ "$rc" -eq 3 ]; then { echo; _print_help; } >&2; fi
                    [ "$rc" -eq 0 ] || exit "$rc"
                    f_voice="$_picked_voice" ;;
            notify) _valid_notify "$set_value" || _die_with_help 3 "notify takes on or off"
                    f_notify="$set_value" ;;
            *) _die_with_help 2 "--set takes rate, volume, voice or notify, not '$set_key'" ;;
        esac
        _save_showing_change ;;
    reset)
        case "$set_key" in
            rate)   f_rate="$_default_rate" ;;
            volume) f_volume="$_default_volume" ;;
            voice)  f_voice="$_default_voice" ;;
            notify) f_notify="$_default_notify" ;;
            all)    f_rate="$_default_rate"; f_volume="$_default_volume"; f_voice="$_default_voice"; f_notify="$_default_notify" ;;
            *) _die_with_help 2 "--reset takes rate, volume, voice, notify or all, not '$set_key'" ;;
        esac
        _save_showing_change ;;
esac

if [ "$mode" = "print" ]; then
    { IFS= read -r hash; IFS= read -r truncated; IFS= read -r chars; IFS= read -r text; } < <(clean_input)
    if [ -z "${text:-}" ]; then
        echo "(nothing to speak -- clipboard empty or all decoration)"
        exit 1
    fi
    printf '%s\n' "$text"
    exit 0
fi

acquire_lock || { trace "outcome=busy"; exit 0; }

if [ "$mode" = "stop" ]; then
    if stop_speaker; then trace "outcome=stopped"; else trace "outcome=idle"; fi
    exit 0
fi

if [ "$mode" = "skip" ]; then
    if skip_speaker; then trace "outcome=skipped"; else trace "outcome=idle"; fi
    exit 0
fi

# Toggle rule (v5): any press while speaking stops, whatever the clipboard
# holds. Checked before the clipboard is read, so a stop costs no cleaner run.
if [ "$mode" = "toggle" ] && speaker_alive; then
    stop_speaker
    trace "outcome=stopped"
    exit 0
fi

if [ "$queue" = 1 ] && _queue_repeat; then
    trace "outcome=busy queue=key-repeat"
    exit 0
fi

{ IFS= read -r hash; IFS= read -r truncated; IFS= read -r chars; IFS= read -r text; } < <(clean_input)
if [ -z "${text:-}" ]; then
    trace "outcome=nothing"
    exit 1
fi

# A --queue press joins a playing line (Q12). Anything else replaces
# whatever is speaking, and that clears the line too (Q23 v2: a clean
# slate). So does a --queue press that finds a pre-v8 speaker, which has
# no line to join.
outcome="started"
if [ "$queue" = 1 ] && speaker_alive && [ -n "$_speaker_line" ]; then
    resolve_engine
    if [ "$_engine" = "say2" ] && join_line; then outcome="queued"; fi
fi
if [ "$outcome" != "queued" ]; then
    if speaker_alive; then
        stop_speaker
        outcome="replaced"
    fi
    start_speaker
fi

# Spoke; now say whether a fallback was used (dotfiles-main Q3). Every
# problem goes in the log line; the exit code is the lowest that applies:
# 10 a bad or missing value in the file, 11 the saved voice is not
# installed, 12 the file could not be read or created.
problems=""
rc=0
[ "$outcome" != "queued" ] || problems="$problems gap=$queue_delay"
if [ -n "$_bad_settings" ]; then problems="$problems settings=bad:$_bad_settings"; rc=10; fi
if [ -n "$_missing_settings" ]; then problems="$problems settings=missing:$_missing_settings"; rc=10; fi
[ -z "$_file_note" ] || problems="$problems file=$_file_note"
[ -z "$_warn_log" ] || problems="$problems warn=$_warn_log"
if [ -z "$voice" ] && [ "$_engine_voice" != "$_preferred_voice" ]; then
    problems="$problems voice=fallback:$_engine_voice"; [ "$rc" -ne 0 ] || rc=11
fi
if [ "$_file_state" = "unusable" ]; then
    problems="$problems file=unusable"; [ "$rc" -ne 0 ] || rc=12
fi
trace "outcome=$outcome profile=$profile chars=$chars truncated=$truncated exit=$rc$problems"
exit $rc
