#!/usr/bin/env bash
# install-preflight-selftest -- prove the install.sh quirk checks actually fire.
#
# Sibling of safe-rm-selftest / vulnlib-selftest / claude-hooks-sync-selftest.
# These three checks exist because a clang/SDK mismatch on the Intel MacBook
# cost most of a session to diagnose by hand on 2026-09-05. A check that only
# LOOKS right is worth nothing -- each one here is driven to fire.
#
# THE SEAM is the function's observable behaviour: does it stay silent when the
# machine is healthy, and does it name the right thing when it is not. The
# functions are sourced out of install.sh with `main` never called.
#
# Usage: install-preflight-selftest      (exit 0 = all passed)

set -uo pipefail

PASS=0; FAIL=0; WORK=""
SELF_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"

# Find the repo root whether this is run from the repo OR through its stow
# symlink at ~/.local/bin. Stow makes RELATIVE links, and the first version of
# this resolved `readlink` output without re-basing it on the link's own
# directory -- so it worked from the repo path and failed from ~/, which is the
# only path a fresh session or another machine would ever use.
_resolve_repo() {
    local self="${BASH_SOURCE[0]}" dir target
    dir="$(cd -- "$(dirname -- "$self")" && pwd)"
    if [[ -L "$self" ]]; then
        target="$(readlink "$self")"
        [[ "$target" != /* ]] && target="$dir/$target"   # re-base a relative link
        dir="$(cd -- "$(dirname -- "$target")" && pwd)"
    fi
    # dir is now <repo>/home/.local/bin
    (cd -- "$dir/../../.." && pwd)
}
REPO="$(_resolve_repo)"
INSTALL_SH="${INSTALL_SH_OVERRIDE:-$REPO/install.sh}"

cleanup() { [[ -n "$WORK" && -d "$WORK" ]] && { rm -rf "$WORK" >/dev/null 2>&1 || true; }; WORK=""; }
trap cleanup EXIT

# Strip comment lines from a chunk of shell before asserting on it.
#
# USE THIS FOR EVERY "must NOT contain X" CHECK. Three times while writing this
# suite, a test failed on the comment that EXPLAINS the trap it was checking for:
# the brew-subprocess check matched the comment saying why brew is not called,
# the redirect check matched the comment describing the redirect bug, and the
# codename check matched the comment listing the codenames not to invent. A test
# that fails on its own documentation teaches people to delete the documentation.
code_of() { grep -v '^[[:space:]]*#' <<<"$1"; }

ok()  { PASS=$(( PASS + 1 )); printf '  \033[32mPASS\033[0m  %s\n' "$1"; }
bad() { FAIL=$(( FAIL + 1 )); printf '  \033[31mFAIL\033[0m  %s\n' "$1"
        [[ $# -gt 1 ]] && printf '        %s\n' "$2"; }

echo "install.sh pre-flight selftest"
echo

if [[ ! -f "$INSTALL_SH" ]]; then
    bad "install.sh found" "looked at $INSTALL_SH"
    echo; echo "  $PASS passed, $FAIL failed"; exit 1
fi

# --- 1. the three functions exist ------------------------------------------
for fn in _preflight_cc_toolchain_check _preflight_brew_busy_check _preflight_brew_tap_trust_check; do
    if grep -q "^${fn}() {" "$INSTALL_SH"; then ok "$fn is defined"
    else bad "$fn is defined" "not found in $INSTALL_SH"; fi
done

# --- 2. each is wired into main() -------------------------------------------
for fn in _preflight_cc_toolchain_check _preflight_brew_busy_check _preflight_brew_tap_trust_check; do
    if grep -qE "^[[:space:]]+${fn}$" "$INSTALL_SH"; then ok "$fn is called from main()"
    else bad "$fn is called from main()" "defined but never invoked"; fi
done

# --- 3. the C++ check never blocks ------------------------------------------
# It must end in `return 0`, not exit. An installer that refuses to stow because
# a compiler is broken is worse than the bug it is reporting.
body=$(sed -n '/^_preflight_cc_toolchain_check() {/,/^}/p' "$INSTALL_SH")
if grep -qE '^[[:space:]]*exit ' <<<"$body"; then
    bad "C++ check never exits the installer" "found an 'exit' in its body"
else ok "C++ check never exits the installer"; fi
if grep -q 'return 0    # never fatal' <<<"$body"; then ok "C++ check returns 0 explicitly"
else bad "C++ check returns 0 explicitly" "no explicit non-fatal return"; fi

# --- 4. the C++ probe is a COMPILE, not a version comparison ---------------
if grep -q 'fsyntax-only' <<<"$body"; then ok "C++ check probes by compiling"
else bad "C++ check probes by compiling" "no compile probe found"; fi

# --- 5. the brew guard uses a PROCESS, not a lock file ---------------------
# Measured 2026-09-05: ~100 stale .formula.lock files sat in var/homebrew/locks
# dated weeks earlier with no brew running. Lock files prove nothing.
busy=$(sed -n '/^_preflight_brew_busy_check() {/,/^}/p' "$INSTALL_SH")
if grep -q 'pgrep' <<<"$busy"; then ok "brew guard looks for a live process"
else bad "brew guard looks for a live process" "no pgrep"; fi
if grep -qE '(locks/|\.formula\.lock)' <<<"$busy"; then
    bad "brew guard does NOT trust lock files" "it reads the locks directory"
else ok "brew guard does NOT trust lock files"; fi

# --- 6. tap trust advice is narrow only ------------------------------------
# `brew trust <tap>` is standing trust for every future formula from a third
# party. Homebrew offers it; this repo must never echo it.
tap=$(sed -n '/^_preflight_brew_tap_trust_check() {/,/^}/p' "$INSTALL_SH")
if grep -q 'brew trust --formula' <<<"$tap"; then ok "tap check offers per-formula trust"
else bad "tap check offers per-formula trust" "no --formula guidance"; fi
if grep -qE '^\s*(echo|printf|info).*brew trust [a-z][a-z0-9_-]*/' <<<"$tap"; then
    bad "tap check never prints whole-tap trust" "a broad 'brew trust <tap>' is printed"
else ok "tap check never prints whole-tap trust"; fi
if grep -q 'grep -E .\^\[\[:space:\]\]\*brew trust --(formula|cask)' <<<"$tap"; then
    ok "tap check filters brew's own output to the narrow form"
else
    grep -q 'formula|cask' <<<"$tap" && ok "tap check filters brew's own output to the narrow form" \
      || bad "tap check filters brew's own output to the narrow form" "no filter found"
fi

# --- 7. the parser handles a REAL untrusted-taps sample ---------------------
# This machine has zero untrusted taps, so the only honest way to exercise the
# parser is against captured output from the machine that did.
WORK="$(mktemp -d "${TMPDIR:-/tmp}/install-preflight-test.XXXXXX")" || WORK=""
if [[ -z "$WORK" || ! -d "$WORK" ]]; then
    printf '  \033[31mABORT\033[0m  cannot create a temp dir; no parser test can be trusted.\n' >&2
    echo; echo "  $PASS passed, $FAIL failed"; exit 2
fi
cat > "$WORK/sample.txt" <<'SAMPLE'
Warning: The following taps are not trusted:
  adoptopenjdk/openjdk
  bramstein/webfonttools
  oven-sh/bun

Homebrew is currently ignoring formulae, casks and commands from these taps.
Trust installed formulae from these taps with:
  brew trust --formula bramstein/webfonttools/sfnt2woff
  brew trust --formula oven-sh/bun/bun
Whole-tap trust is broader. Trust whole taps with:
  brew trust adoptopenjdk/openjdk bramstein/webfonttools
SAMPLE
n_taps=$(sed -n '/The following taps are not trusted:/,/^$/p' "$WORK/sample.txt" \
         | sed '1d;/^$/d;s/^[[:space:]]*//' | grep -c .)
n_narrow=$(grep -cE '^[[:space:]]*brew trust --(formula|cask) ' "$WORK/sample.txt")
if [[ "$n_taps" == "3" ]]; then ok "parser finds all 3 untrusted taps in a real sample"
else bad "parser finds all 3 untrusted taps in a real sample" "got $n_taps"; fi
if [[ "$n_narrow" == "2" ]]; then ok "parser extracts only the 2 narrow commands"
else bad "parser extracts only the 2 narrow commands" "got $n_narrow"; fi

# --- 8. the Dev-managers line now states a reason --------------------------
# It printed a bare "!" for several sessions on a machine where all three tools
# were fine, and two theories argued from the code were both wrong.
ONB="$REPO/home/.zsh_onboarding"
if [[ -f "$ONB" ]]; then
    if grep -q 'need >= \${NVM_MIN_VERSION}' "$ONB" && grep -q 'not found on PATH' "$ONB"; then
        ok "Dev-managers failure names the tool and the value read"
    else bad "Dev-managers failure names the tool and the value read" "no per-tool reason"; fi
else bad "Dev-managers failure names the tool and the value read" "no .zsh_onboarding"; fi

# --- 9. the Intel pnpm nudge reads Homebrew, not the registry --------------
WEL="$REPO/home/.zsh_welcome"
if [[ -f "$WEL" ]]; then
    if grep -q '_pnpm_is_brew' "$WEL" && grep -q 'Cellar/pnpm' "$WEL"; then
        ok "Intel pnpm nudge compares against the brew formula"
    else bad "Intel pnpm nudge compares against the brew formula" "still registry-only"; fi
    # Strip comment lines before looking for a brew CALL. The first version of
    # this test matched the string anywhere and failed on the comment that
    # EXPLAINS why brew is not called (260ms vs a 4ms Cellar read) -- a test that
    # fails on its own documentation teaches you to ignore it.
    if grep -v '^[[:space:]]*#' "$WEL" | grep -q 'brew list --versions'; then
        bad "Intel pnpm nudge avoids a brew subprocess" "calls brew in the banner (260ms)"
    else ok "Intel pnpm nudge avoids a brew subprocess"; fi
else bad "Intel pnpm nudge compares against the brew formula" "no .zsh_welcome"; fi

# --- 10. CLT offer + brew sweep ---------------------------------------------
clt=$(sed -n '/^_offer_clt_install() {/,/^}/p' "$INSTALL_SH")
swp=$(sed -n '/^_offer_brew_sweep() {/,/^}/p' "$INSTALL_SH")
lim=$(sed -n '/^_run_limited() {/,/^}/p' "$INSTALL_SH")

# `timeout` is coreutils, NOT stock macOS -- /usr/bin/timeout does not exist. A
# bare call would break the machines this targets.
if grep -q 'command -v timeout' <<<"$lim" && grep -q 'else "\$@"' <<<"$lim"; then
    ok "_run_limited degrades when timeout is absent"
else bad "_run_limited degrades when timeout is absent" "no fallback path"; fi

# softwareupdate --list sat for over ten minutes during development. Unbounded
# network calls in an installer teach people to kill it.
if grep -q '_run_limited [0-9]* softwareupdate' <<<"$clt"; then
    ok "softwareupdate --list is time-limited"
else bad "softwareupdate --list is time-limited" "unbounded network call"; fi

# The marker makes macOS believe a CLT install is in progress. Ours must go --
# but ONLY after the install, never before it.
cln=$(sed -n '/^_clt_marker_cleanup() {/,/^}/p' "$INSTALL_SH")
if grep -q 'created" == true' <<<"$cln" && grep -q 'rm -f "\$marker"' <<<"$cln"; then
    ok "the installondemand marker is removed again"
else bad "the installondemand marker is removed again" "marker may be left behind"; fi

# THE BUG THE LAPTOP FOUND. The marker must still EXIST while --install runs.
# v1 removed it immediately after --list, and the install then failed with
# "No such update" on the very label the listing had just produced.
clt_code=$(grep -v '^[[:space:]]*#' <<<"$clt")
list_ln=$(grep -n 'softwareupdate --list' <<<"$clt_code" | head -1 | cut -d: -f1)
inst_ln=$(grep -n 'softwareupdate --install' <<<"$clt_code" | head -1 | cut -d: -f1)
clean_ln=$(grep -n '_clt_marker_cleanup' <<<"$clt_code" | head -1 | cut -d: -f1)
if [[ -n "$list_ln" && -n "$inst_ln" && -n "$clean_ln" ]] && (( clean_ln > inst_ln )); then
    ok "the marker outlives --list and survives into --install"
else
    bad "the marker outlives --list and survives into --install" \
        "cleanup at line ${clean_ln:-?} precedes install at ${inst_ln:-?}"
fi

# An offer OLDER than the installed clang is a downgrade, and softwareupdate
# answers "No such update" -- observed on the Intel MacBook with a 16.2 offer
# against clang 17. Do not send the operator into a sudo prompt for that.
if grep -q 'offer_major < cc_major' <<<"$clt"; then
    ok "a downgrade offer is detected and not installed"
else bad "a downgrade offer is detected and not installed" "no version comparison"; fi

# A failed redirect is reported by the shell BEFORE the redirection applies, so
# `: > f 2>/dev/null` still leaks "Operation not permitted".
# Strip comments first. The comment EXPLAINING this trap contains the very
# pattern being searched for, so a naive match fails on its own documentation --
# the second time that happened while writing this suite.
if code_of "$clt" | grep -qE ":[[:space:]]*>[[:space:]]*\"\$marker\""; then
    bad "marker creation cannot leak a redirect error" "uses ': >' instead of touch"
else ok "marker creation cannot leak a redirect error"; fi

# sudo is a human decision; it must sit behind a confirm, never run bare.
if grep -q 'confirm "Install it now with softwareupdate' <<<"$clt"; then
    ok "the sudo install sits behind a confirm"
else bad "the sudo install sits behind a confirm" "sudo may run unprompted"; fi

# Offering a source-build sweep to a machine that cannot compile C++ guarantees
# a wasted evening -- it is exactly the ten failures that started this thread.
if grep -q 'CC_TOOLCHAIN_OK' <<<"$swp"; then
    ok "the brew sweep is gated on a working compiler"
else bad "the brew sweep is gated on a working compiler" "would offer on a broken box"; fi
if grep -q 'confirm "Run .brew upgrade' <<<"$swp"; then
    ok "brew upgrade sits behind a confirm"
else bad "brew upgrade sits behind a confirm" "may run unattended"; fi
if grep -q 'n == 0' <<<"$swp"; then ok "the brew sweep is silent when nothing is outdated"
else bad "the brew sweep is silent when nothing is outdated" "no zero-case guard"; fi

# --- 11. the manual step is repeated in the closing summary -----------------
# The pre-flight runs first, and a re-install scrolls ~200 lines of stow output
# past it. The one thing the operator must do by hand is the one thing they can
# no longer see by the time the run ends.
sums=$(sed -n '/^show_summary() {/,/^}/p' "$INSTALL_SH")
if grep -q 'CC_TOOLCHAIN_OK' <<<"$sums"; then
    ok "the closing summary repeats the C++ manual step"
else bad "the closing summary repeats the C++ manual step" "guidance only appears at the top"; fi
if grep -q 'developer.apple.com/download/all' <<<"$sums"; then
    ok "the closing summary carries the download URL"
else bad "the closing summary carries the download URL" "no actionable link at the end"; fi
# It must stay exception-based: a healthy machine gets no extra noise.
if grep -qE 'CC_TOOLCHAIN_OK:-true\}" != true' <<<"$sums"; then
    ok "the summary line is silent on a healthy toolchain"
else bad "the summary line is silent on a healthy toolchain" "may print unconditionally"; fi

# STATE THE FACTS, do not ask for a lookup. "Match your macOS version" makes the
# operator go and find numbers the script is already holding.
if grep -q 'sw_vers -productVersion' <<<"$sums"; then
    ok "the summary prints the actual macOS version"
else bad "the summary prints the actual macOS version" "still asks the user to look it up"; fi
if grep -q 'CC_CLANG_MAJOR' <<<"$sums" && grep -q 'CC_SDK_VER' <<<"$sums"; then
    ok "the summary prints the actual clang and SDK versions"
else bad "the summary prints the actual clang and SDK versions" "numbers not carried through"; fi
# A codename would have to be guessed; sw_vers does not supply one.
if grep -qiE "Sequoia|Sonoma|Ventura|Tahoe" <<<"$(code_of "$sums")"; then
    bad "the summary invents no macOS codename" "hardcodes a marketing name"
else ok "the summary invents no macOS codename"; fi
# A pre-filtered URL is one less thing to do on Apple's page.
if grep -q 'q=command+line+tools' <<<"$sums"; then
    ok "the download link is pre-filtered"
else bad "the download link is pre-filtered" "bare download page"; fi

# Opening a page is free and reversible, and it is the next thing the operator
# does anyway -- it should not need a keystroke to reach.
if grep -qE 'confirm "Open the download page now\?" y' <<<"$clt"; then
    ok "the browser prompt defaults to yes"
else bad "the browser prompt defaults to yes" "still defaults to no"; fi

# --- 12. the pj machine file and the pj prerequisite report (P8a) -----------
# These two are DRIVEN, not read: the machine file decides whether `open-items add` works
# at all on a box, and the prereq report is the only thing that tells a fresh machine why
# `pj` refuses to launch. Both run in a scratch HOME; nothing real is touched.
for fn in _write_pj_machine_file _check_pj_prereqs; do
    if grep -q "^${fn}() {" "$INSTALL_SH"; then ok "$fn is defined"
    else bad "$fn is defined" "not found in $INSTALL_SH"; fi
    if grep -qE "^[[:space:]]+${fn}$" "$INSTALL_SH"; then ok "$fn is called from main()"
    else bad "$fn is called from main()" "defined but never invoked"; fi
done
# The retired two-range scheme must be gone from the writer: a box that still gets a
# `range:` file has an allocator that refuses, and the installer would have caused it.
mf=$(sed -n '/^_write_pj_machine_file() {/,/^}/p' "$INSTALL_SH")
if grep -q "range: %s" <<<"$(code_of "$mf")"; then
    bad "the writer no longer writes a 'range:' line" "it still formats one"
else ok "the writer no longer writes a 'range:' line"; fi
if grep -q "letter: %s" <<<"$(code_of "$mf")"; then ok "the writer writes a 'letter:' line"
else bad "the writer writes a 'letter:' line" "no letter format found"; fi

# The writer's fallback prints a command to COPY. It is printf, not `echo -e`: echo does not
# substitute %s, and the first version of the line printed the placeholders verbatim at the
# exact moment someone needed a working command. Driven, with no tty, so the prompt declines.
mf_home="$WORK/mfhome"; mkdir -p "$mf_home/.config/pj"
mf_out="$(HOME="$mf_home" bash -c '
    DRY_RUN=false; GREEN=""; RED=""; YELLOW=""; RESET=""; DIM=""; CYAN=""; BOLD=""
    info(){ :; }; success(){ echo "OK $*"; }; warn(){ echo "WARN $*"; }
    source <(sed -n "/^_pj_machine_letter_prompt() {/,/^}/p;/^_write_pj_machine_file() {/,/^}/p" "$1")
    _write_pj_machine_file' _ "$INSTALL_SH" </dev/null 2>&1)"
if grep -q "letter: <A-D>" <<<"$mf_out"; then ok "the no-letter fallback prints a copyable command"
else bad "the no-letter fallback prints a copyable command" "$(tail -2 <<<"$mf_out")"; fi
if grep -q '%s' <<<"$mf_out"; then
    bad "the fallback command has no unsubstituted placeholders" "$(grep '%s' <<<"$mf_out" | head -1)"
else ok "the fallback command has no unsubstituted placeholders"; fi
if [[ -e "$mf_home/.config/pj/machine" ]]; then
    bad "declining the prompt writes NO machine file" "the file was created anyway"
else ok "declining the prompt writes NO machine file"; fi
# A retired range-only file is rewritten to a letter file, and a good one is left alone.
printf 'name: box\nletter: B\nrange: 01-49\n' > "$mf_home/.config/pj/machine"
HOME="$mf_home" bash -c '
    DRY_RUN=false; GREEN=""; RED=""; YELLOW=""; RESET=""; DIM=""; CYAN=""; BOLD=""
    info(){ :; }; success(){ :; }; warn(){ :; }
    source <(sed -n "/^_pj_machine_letter_prompt() {/,/^}/p;/^_write_pj_machine_file() {/,/^}/p" "$1")
    _write_pj_machine_file' _ "$INSTALL_SH" </dev/null >/dev/null 2>&1
if grep -q '^letter: B$' "$mf_home/.config/pj/machine" && ! grep -q '^range:' "$mf_home/.config/pj/machine"; then
    ok "a leftover 'range:' beside a good letter is dropped, the letter kept"
else bad "a leftover 'range:' beside a good letter is dropped, the letter kept" "$(tr '\n' '|' < "$mf_home/.config/pj/machine")"; fi

pj_scratch="$WORK/pjhome"; mkdir -p "$pj_scratch/.claude/pj/.claude-plugin"
# shellcheck disable=SC2016
pj_drive() {   # pj_drive <HOME> <REPO_DIR> : run _check_pj_prereqs with stubs, print its output
    HOME="$1" bash -c '
      REPO_DIR="$2"
      GREEN=""; RED=""; YELLOW=""; RESET=""; DIM=""; CYAN=""
      step(){ :; }; success(){ echo "VERDICT-OK $*"; }; warn(){ echo "VERDICT-WARN $*"; }
      BOLD=""
      source <(sed -n "/^_check_pj_prereqs() {/,/^}/p" "$1")
      _check_pj_prereqs
      # W-20260921-A23: the flag is the thing the exit code is built from, so the
      # arms have to see it, not just the prose.
      echo "PJ_PREREQS_OK=${PJ_PREREQS_OK:-unset}"
    ' _ "$INSTALL_SH" "$2" 2>&1
}
out_missing="$(pj_drive "$pj_scratch" /some/other/place)"
if grep -q 'VERDICT-WARN' <<<"$out_missing"; then ok "prereq report WARNS on a bare machine"
else bad "prereq report WARNS on a bare machine" "$(head -3 <<<"$out_missing")"; fi
if grep -q 'pj-global/RULES.md missing' <<<"$out_missing"; then ok "  and names the missing RULES.md"
else bad "  and names the missing RULES.md" "$(head -3 <<<"$out_missing")"; fi
if grep -q 'OPERATIONAL_RULES.md missing' <<<"$out_missing"; then ok "  and names the missing OPERATIONAL_RULES.md"
else bad "  and names the missing OPERATIONAL_RULES.md" "$(head -3 <<<"$out_missing")"; fi
# A DANGLING plugin symlink must name the one path the whole scheme depends on.
ln -sfn /nowhere/plugin.json "$pj_scratch/.claude/pj/.claude-plugin/plugin.json"
out_dead="$(pj_drive "$pj_scratch" /some/other/place)"
if grep -q 'dangling symlink' <<<"$out_dead"; then ok "a dangling plugin symlink is reported as dangling, not absent"
else bad "a dangling plugin symlink is reported as dangling, not absent" "$(grep -i plugin <<<"$out_dead" | head -2)"; fi
if grep -q 'CODE/Scaffoldings/fifty-shades-of-dotfiles' <<<"$out_dead"; then ok "  and names the required repo path"
else bad "  and names the required repo path" "$(grep -i dangl -A3 <<<"$out_dead")"; fi
# POSITIVE CONTROL. Without this, every arm above passes just as well when the function
# is broken and reports everything as missing.
mkdir -p "$pj_scratch/ok/.claude/pj-global/notes" "$pj_scratch/ok/.claude/pj-voice" \
         "$pj_scratch/ok/.claude/LIFEOS/USER/CONFIG" "$pj_scratch/ok/.claude/pj/.claude-plugin" \
         "$pj_scratch/ok/.claude/pj/skills/wrap-up" "$pj_scratch/ok/.claude/pj/skills/health"
: > "$pj_scratch/ok/.claude/pj-global/RULES.md"
: > "$pj_scratch/ok/.claude/pj-global/notes/INDEX.md"
mkdir -p "$pj_scratch/ok/.claude/pj-global/decisions"
: > "$pj_scratch/ok/.claude/LIFEOS/USER/CONFIG/OPERATIONAL_RULES.md"
: > "$pj_scratch/ok/.claude/pj/.claude-plugin/plugin.json"
: > "$pj_scratch/ok/.claude/pj/skills/wrap-up/SKILL.md"
: > "$pj_scratch/ok/.claude/pj/skills/health/SKILL.md"
out_ok="$(pj_drive "$pj_scratch/ok" /some/other/place)"
if grep -q 'VERDICT-OK' <<<"$out_ok"; then ok "CONTROL: a complete machine gets the pass verdict"
else bad "CONTROL: a complete machine gets the pass verdict" "$(head -5 <<<"$out_ok")"; fi
if grep -q 'VERDICT-WARN' <<<"$out_ok"; then
    bad "CONTROL: a complete machine gets NO warning" "$(grep VERDICT-WARN <<<"$out_ok")"
else ok "CONTROL: a complete machine gets NO warning"; fi

# --- W-20260921-A23: the installer must SAY pj is not ready, and not exit 0 ----
# Ruled 2026-09-21: the public installer never clones the two private repos, a
# human does that first. But "installed fine" and "installed, and pj cannot
# start" must not be the same observation -- for a human reading a terminal, or
# for anything reading $?.
if grep -q 'pj is not ready on this machine' <<<"$out_missing"; then ok "bare machine: the block is headed 'pj is not ready on this machine'"
else bad "bare machine: the block is headed 'pj is not ready on this machine'" "$(head -4 <<<"$out_missing")"; fi
if grep -q 'PJ_PREREQS_OK=0' <<<"$out_missing"; then ok "bare machine: PJ_PREREQS_OK=0"
else bad "bare machine: PJ_PREREQS_OK=0" "$(grep PJ_PREREQS_OK <<<"$out_missing")"; fi
if grep -q 'git clone' <<<"$out_missing"; then ok "bare machine: the block carries the clone commands"
else bad "bare machine: the block carries the clone commands" "$(head -4 <<<"$out_missing")"; fi
if grep -q 're-run ./install.sh' <<<"$out_missing"; then ok "bare machine: it says what to do next"
else bad "bare machine: it says what to do next" "$(head -4 <<<"$out_missing")"; fi
# CONTROL, the other half: a complete machine must NOT print the block and must
# set the flag to 1. Without this pair, "the block appears" is equally true of a
# function that prints it unconditionally.
if grep -q 'PJ_PREREQS_OK=1' <<<"$out_ok"; then ok "CONTROL: a complete machine sets PJ_PREREQS_OK=1"
else bad "CONTROL: a complete machine sets PJ_PREREQS_OK=1" "$(grep PJ_PREREQS_OK <<<"$out_ok")"; fi
if grep -q 'pj is not ready' <<<"$out_ok"; then
    bad "CONTROL: a complete machine does NOT print the not-ready block" "$(grep -n 'not ready' <<<"$out_ok")"
else ok "CONTROL: a complete machine does NOT print the not-ready block"; fi
# _finish turns the flag into the exit code. Both directions, from install.sh's
# own text, so a future edit to _finish is caught here.
fin_src="$(sed -n '/^_finish() {/,/^}/p' "$INSTALL_SH")"
if [[ -n "$fin_src" ]]; then ok "CONTROL: _finish is defined in install.sh"
else bad "CONTROL: _finish is defined in install.sh" "not found -- the two arms below would prove nothing"; fi
rc_bad=0; PJ_PREREQS_OK=0 bash -c "$fin_src"'; _finish' || rc_bad=$?
rc_ok=0;  PJ_PREREQS_OK=1 bash -c "$fin_src"'; _finish' || rc_ok=$?
if [[ "$rc_bad" -ne 0 ]]; then ok "_finish exits NON-ZERO ($rc_bad) when pj is not ready"
else bad "_finish exits NON-ZERO when pj is not ready" "got 0"; fi
if [[ "$rc_ok" -eq 0 ]]; then ok "CONTROL: _finish exits 0 when pj IS ready"
else bad "CONTROL: _finish exits 0 when pj IS ready" "got $rc_ok"; fi
# And the dispatch must actually CALL it, or none of the above reaches a user.
if grep -qE '^\s+""\)\s+main; _finish ;;' "$INSTALL_SH"; then ok "the default action runs _finish"
else bad "the default action runs _finish" "$(grep -n '"")' "$INSTALL_SH" | head -2)"; fi
if grep -qE 'stow-only\).*_check_pj_prereqs; _finish ;;' "$INSTALL_SH"; then ok "--stow-only runs _finish"
else bad "--stow-only runs _finish" "$(grep -n 'stow-only)' "$INSTALL_SH" | head -2)"; fi

echo
echo "  $PASS passed, $FAIL failed"
(( FAIL == 0 ))
