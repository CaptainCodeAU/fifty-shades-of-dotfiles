#!/usr/bin/env bash
# ============================================================================
#  ci-watch -- escalating, dismiss-only-by-fixing CI status for the welcome dash
# ============================================================================
# Why this exists: a red CI nobody notices is as bad as no CI. PASSIVE signals
# (e.g. "workflow failed" emails) habituate -- they were empirically tuned out
# here for a week while ~25 red runs piled up. This watcher lives in the
# session-start dashboard and is EXCEPTION-BASED so it cannot become wallpaper.
#
# ---------------------------------------------------------------------------
# 2026-09-15 REWRITE: the tool used to be able to tell a comfortable lie.
# ---------------------------------------------------------------------------
# The old query path ended both fetch attempts in `2>/dev/null || true`, which
# destroys the evidence three times over: `2>/dev/null` deletes the diagnosis,
# `$(...)` collapses any failure into an empty string, and `|| true` forces a
# zero exit. After that line nothing in the process could tell a 403 from a
# timeout from a genuinely empty result. Every one of them became `unknown`.
#
# Worse, an empty result fell back to the per-target cache, and the GREEN render
# path threaded no staleness marker. So a repo that went green and then lost
# Actions access (token rotation, a tightened PAT, an App permission change, a
# repo transfer) rendered `OK CI green -- <label> (<sha>)` FOREVER, identical to
# a live green. Reproduced by execution 2026-09-15: same command twice against a
# target whose fetch fails, one variable changed (a planted cache) --
#     no cache -> `.. CI unknown`      cache -> `OK CI green ... (deadbee)`
# The docs promised "a skip is never a false green". They were wrong.
#
# THE FIX, and why it is shaped this way (researched 2026-09-15, 3 reports):
#
#   1. ONLY A SUCCESS MAY STAMP THE CLOCK. `fetched_at` is written on `ok` and
#      `empty_ok` outcomes and on nothing else, so a failed refresh is
#      STRUCTURALLY INCAPABLE of marking data fresh. This is Ubuntu's
#      `update-success-stamp` design (the APT post-invoke-SUCCESS hook), and it
#      makes the false green impossible rather than merely detectable.
#
#   2. HEALTH AND RESULT ARE TWO FACTS, NEVER ONE. `last_outcome` (could I see
#      it?) and `observed_*` (what did I last see?) are separate fields.
#      Prometheus writes `up` on every scrape and, on a FAILED scrape, ingests
#      "nothing ... other than up&friends" -- the payload never carries forward
#      past a failed observation. Prometheus 1.x had exactly this bug and fixed
#      it in 2.0 with an explicit stale marker.
#
#   3. A STALE VALUE IS ALWAYS MARKED. RFC 5861 says a stale response SHOULD be
#      "visibly stale"; RFC 9111 raised age marking to a MUST. No credible
#      source defends UNMARKED last-known-good. Serving the old value is fine;
#      claiming it is current is not. Past HARD_TTL no value is shown at all,
#      only the reason -- Prometheus returns nothing rather than something old.
#
#   4. FOUR STATES, NOT THREE. Nagios/Icinga carry UNKNOWN precisely because
#      "the check could not decide" is not "the thing is bad" and is REALLY not
#      "the thing is fine". With only green/red/unknown, "cannot observe" lands
#      in the nearest slot, and the nearest slot was green. So:
#        BLIND        -- was observable, now REFUSED. Loud, magenta (never red,
#                        so it cannot consume the real alarm channel), and it
#                        SELF-CLEARS on the next success with no ack step
#                        (SRE: long reset times are named as a cause of alerts
#                        being ignored).
#        UNOBSERVABLE -- never successfully observed. Quiet. Nothing regressed;
#                        the setup is just incomplete. A permanently LOUD line
#                        for a runner that may not exist for weeks trains the
#                        operator to ignore the colour, which costs the real
#                        alarm (Ewaschuk: "err on the side of removing noisy
#                        alerts"; teams route loud channels somewhere "so that
#                        they can be summarily ignored").
#
#   5. AN OBSERVED-BUT-INCONCLUSIVE RUN IS NOT A BLIND ONE. The new state space
#      creates a NEW way to lie: a run that is `in_progress`, or that finished
#      `cancelled`/`neutral`/`skipped`, WAS successfully observed. Filing any of
#      those under "cannot see" would swap the old false green for a new false
#      alarm. They render as `running` / their own conclusion, never BLIND.
#
#   6. A DELETED BRANCH IS INVISIBLE TO THE RUNS ENDPOINT. Measured on cli/cli
#      2026-09-15: three merged-and-deleted branches still returned 4-9 runs
#      each, indistinguishable from a live branch. The ONLY discriminator is a
#      second call to /repos/{o}/{r}/branches/{b} (200 alive / 404 gone), so we
#      make it, cached for BRANCH_TTL to keep it to one extra call per day.
#
#   7. THE PROMISE NEEDS ITS OWN PROOF. `ci-watch --control` renders a target
#      that MUST NOT come out green. A run where every line is green looks
#      identical to a run where the check never executed, unless something in
#      the same run is guaranteed to be non-green. (Watchdog/dead-man's-switch;
#      the repo's own count-and-absence rule applied to the watcher itself.)
#
# GitHub API facts this depends on, all doc-cited or measured 2026-09-15:
#   - GET /repos/{o}/{r}/actions/runs needs the "Actions" repo permission (read)
#     for Apps and fine-grained tokens; classic PATs need `repo`.
#   - 403 wording is NOT a reliable token-family discriminator. GitHub's docs
#     imply "...by integration" means a GitHub App and "...by personal access
#     token" means a fine-grained PAT, but MEASURED 2026-09-15: a fine-grained
#     PAT (github_pat_ prefix) received the "by integration" wording. So the
#     remedy leads with the permission, which is the same either way, and the
#     wording is reported as an aside rather than used to route the reader.
#   - A token that cannot SEE a private repo gets 404, not 403 -- deliberate, so
#     GitHub never confirms a private repo exists. So a 404 CANNOT distinguish
#     "no such repo" from "no access", and we must not claim it does.
#   - `documentation_url` is BYTE-IDENTICAL on the 403 and the 404. Useless.
#   - A rate-limit 403 and a permission 403 share a status code; separate them
#     by `x-ratelimit-remaining: 0` or the message text.
#   - `gh api` writes the ERROR BODY TO STDOUT and exits 1 for every failure
#     alike, so `gh api --jq '.total_count // 0'` yields a plausible-looking
#     answer on a 403. That is the count-and-absence trap, and it is why the
#     runs query uses `gh run list` instead: that command writes NOTHING to
#     stdout on failure (verified against the real API), so failure and "no
#     runs" cannot be confused. `gh api` survives here only for the branch
#     checks, where the exit code alone is the answer.
#
# Portability: written for bash 3.2 (stock macOS): no associative arrays. There
# is no jq dependency -- `gh --jq` embeds its own Go implementation and works
# with an emptied PATH (verified). macOS 26 also ships /usr/bin/jq now, but this
# tool does not rely on it.
#
# Privacy: this generic engine is committed to a PUBLIC repo. The real repo list
# lives ONLY in ~/.config/ci-watch/watchlist (gitignored). See watchlist.example.
#
# Guarantees:
#   - read-only to your repos; the only writes are state under XDG_STATE_HOME
#   - the render path ALWAYS exits 0 (it runs at session start; never block)
#   - a cached value can never produce the green glyph -- proven by
#     `ci-watch-selftest`, whose cases were written before this rewrite
#
# Usage:
#   ci-watch                       render the session readout (default)
#   ci-watch --add <repo|.> [lbl]  add a repo (or "." = the current repo)
#   ci-watch --snooze <repo> <d>   silence a red target for <d> days
#   ci-watch --list                show the watchlist
#   ci-watch --json                machine-readable status per target
#   ci-watch --control             prove the watcher cannot report a false green
#   ci-watch --help
#
# Env (mostly for testing):
#   CI_WATCH_LIST, CI_WATCH_STATE, CI_WATCH_NOTIFY_URL, CI_WATCH_VOICE_ID
#   CI_WATCH_FORCE=green|red|unknown   bypass the live query (self-test only)
#   CI_WATCH_NOW=<epoch>               override "now" (self-test only)
#   CI_WATCH_GH=<path>                 the gh binary to use. The selftest points
#                                      this at a shim that impersonates gh, so
#                                      every outcome is deterministic with no
#                                      network and no token.
#   CI_WATCH_DEBUG=1                   echo "[voice] ..." to stderr
# ============================================================================
set -uo pipefail

WATCHLIST="${CI_WATCH_LIST:-$HOME/.config/ci-watch/watchlist}"
STATE_DIR="${CI_WATCH_STATE:-${XDG_STATE_HOME:-$HOME/.local/state}/ci-watch}"
NOTIFY_URL="${CI_WATCH_NOTIFY_URL:-http://localhost:8888/notify}"
VOICE_ID="${CI_WATCH_VOICE_ID:-}"

# Age bands. HARD_TTL is where a cached value stops being shown AT ALL and only
# the reason remains -- Prometheus's "return nothing rather than something old".
HARD_TTL="${CI_WATCH_HARD_TTL:-604800}"     # 7 days
BRANCH_TTL="${CI_WATCH_BRANCH_TTL:-86400}"  # 1 day; branches rarely vanish twice

mkdir -p "$STATE_DIR" 2>/dev/null || true

# Where a fetch's stderr goes. NOT the state dir: that is exactly the directory a
# sandboxed session cannot write, and a failed redirect prints from bash before
# any of our own error handling gets a say. TMPDIR is writable in every context
# this runs in; /dev/null is the last resort (we lose the diagnosis text, never
# the exit code -- and the exit code is what the classifier actually reads).
ERR_SINK=/dev/null
if [ -n "${TMPDIR:-}" ] && ( : >"${TMPDIR%/}/ci-watch.$$.err" ) 2>/dev/null; then
  ERR_SINK="${TMPDIR%/}/ci-watch.$$.err"
  # One file per invocation, and this runs at EVERY session start. An audit of
  # this tool left 487 of them behind in a single afternoon. Clean up on the way
  # out; `command rm` skips any shell function but still reaches the PATH shim,
  # and a scratch file we created this run is ours to remove.
  trap 'command rm -f "$ERR_SINK" 2>/dev/null' EXIT INT TERM
fi

if [ -n "${NO_COLOR:-}" ]; then
  RED='' GREEN='' YELLOW='' MAGENTA='' DIM='' BOLD='' NC=''
else
  RED=$'\033[0;31m'; GREEN=$'\033[0;32m'; YELLOW=$'\033[1;33m'
  # MAGENTA is the BLIND/UNOBSERVABLE register. Deliberately NOT red: a watch
  # that cannot see is a different sentence from a build that is broken, and
  # sharing red's channel would spend the real alarm's attention budget.
  MAGENTA=$'\033[0;35m'
  DIM=$'\033[2m'; BOLD=$'\033[1m'; NC=$'\033[0m'
fi

have(){ command -v "$1" >/dev/null 2>&1; }
now_epoch(){
  if [ -n "${CI_WATCH_NOW:-}" ]; then printf '%s' "$CI_WATCH_NOW"; return 0; fi
  local n; n="$(date +%s 2>/dev/null)"
  case "$n" in ''|*[!0-9]*) n=0 ;; esac   # no `date` on a stripped PATH: degrade
  printf '%s' "$n"
}
trim(){ local s="$1"; s="${s#"${s%%[![:space:]]*}"}"; s="${s%"${s##*[![:space:]]}"}"; printf '%s' "$s"; }
keyof(){ printf '%s' "$1" | tr '/@:.' '____' 2>/dev/null | tr -cd 'A-Za-z0-9_-' 2>/dev/null; }
# Percent-encode every character that is reserved in a URL PATH segment, not
# just `/`. Encoding only the slash meant a branch called `feat/#42` truncated at
# the fragment marker and 404'd, which the liveness check then read as a deleted
# branch -- a confident false alarm about a branch that was alive. (`%` must be
# first or it double-encodes the escapes added after it.)
enc_branch(){
  local s="$1" out='' c i
  for (( i=0; i<${#s}; i++ )); do
    c="${s:i:1}"
    case "$c" in
      [A-Za-z0-9._~-]) out="$out$c" ;;
      *) out="$out$(printf '%%%02X' "'$c")" ;;
    esac
  done
  printf '%s' "$out"
}
# All-digit is NOT the same as safe-in-arithmetic. Bash reads a leading zero as
# OCTAL, so `08` is an invalid expression -- and an invalid arithmetic expansion
# ABORTS THE SCRIPT. With one `fetched_at=08` in one state file, the render died
# mid-loop and every target after it silently vanished from the dashboard, at
# exit 0. A single garbage byte was a global mute button that reported success,
# which is the worst failure this tool can have. Strip the zeros here, and every
# arithmetic site that reads state also forces base 10.
numor0(){
  local s="${1:-}"
  case "$s" in ''|*[!0-9]*) printf '0'; return 0 ;; esac
  while [ "${#s}" -gt 1 ]; do
    case "$s" in 0*) s="${s#0}" ;; *) break ;; esac
  done
  printf '%s' "$s"
}

# Humanised age. Bands are coarse on purpose -- the reader needs "is this recent
# or ancient", not a duration to the second.
age_str(){
  local s; s="$(numor0 "${1:-0}")"
  if   [ "$s" -lt 60 ];    then printf '<1m'
  elif [ "$s" -lt 3600 ];  then printf '%sm' $(( s / 60 ))
  elif [ "$s" -lt 86400 ]; then printf '%sh' $(( s / 3600 ))
  else                          printf '%sd' $(( s / 86400 )); fi
}

tier_for_days(){ if [ "$1" -ge 7 ]; then TIER=3; elif [ "$1" -ge 3 ]; then TIER=2; else TIER=1; fi; }

# ---- transport: gh owns the JSON, and gh owns the error shape ---------------
# The hand-rolled bash-regex JSON reader that used to live here produced THREE
# wrong answers in one day: it read `"status":"completed"` off a run object as an
# HTTP status; it truncated the run object at the first `}` so a commit titled
# `fix: handle {} in the parser` turned a RED build into a quiet "running"; and
# its numeric guard let `08` abort the whole render. Parsing JSON with regex is
# a known-bad idea and this file is the evidence.
#
# `gh run list --json` already has the exact contract this tool spent a day
# hand-building (measured against the real API, gh 2.98.0):
#
#     failure (404 / 401 / network)  ->  exit 1, stdout EMPTY, reason on stderr
#     no matching runs               ->  exit 0, stdout []
#     real runs                      ->  exit 0, stdout [{...}]
#
# Failure and "nothing to report" can never be confused, which is the entire bug
# class. And `gh --jq` does NOT need the jq binary -- gh embeds a Go jq, proven
# with an emptied PATH -- so leaning on it adds no runtime dependency beyond the
# gh this tool already needs to reach the API at all.
#
# What is LOST by moving off `gh api`: the structured error body. gh reports the
# reason as PROSE on stderr ("failed to get runs: HTTP 403: Resource not
# accessible by integration"). So the classifier now reads a status code out of
# prose. That is a far safer regex surface than JSON -- there is no nesting, no
# escaping and no user-controlled field to collide with -- but it IS a string
# match against another tool's wording, so an unrecognised message degrades to
# the quiet register rather than guessing.
GH="${CI_WATCH_GH:-gh}"
have_gh(){ command -v "$GH" >/dev/null 2>&1 || [ -x "$GH" ]; }

# classify_gh_error <stderr-text> -> sets O_TOKEN / O_DETAIL
classify_gh_error(){
  local err="$1" code=''
  [[ "$err" =~ HTTP[[:space:]]+([0-9]{3}) ]] && code="${BASH_REMATCH[1]}"
  case "$code" in
    401) O_TOKEN=unauthorized; O_DETAIL='token invalid or expired'; return 0 ;;
    403)
      case "$err" in
        *"rate limit"*|*"Rate limit"*|*"secondary rate"*|*"abuse detection"*|*"abuse-detection"*)
          O_TOKEN=rate_limited; O_DETAIL='rate limited'; return 0 ;;
      esac
      O_TOKEN=perm_denied
      # "Resource not accessible by integration" is NOT a reliable marker of a
      # GitHub App. Measured 2026-09-15: a fine-grained PAT (github_pat_ prefix)
      # got exactly that wording from /user. GitHub's own troubleshooting page
      # implies the two token families get distinct strings -- they do not, at
      # least not consistently -- so keying a remedy off the wording sent the
      # reader to App settings for a PAT problem. Lead with the PERMISSION, which
      # is the same fix either way, and name both places to check without
      # asserting which kind of token is in play.
      O_DETAIL='token lacks the Actions permission (read) for this repo. Fine-grained token: add Actions:read AND confirm the repo is in its selected-repositories list. GitHub App: grant Actions:read, have the installation owner accept the prompt, then mint a FRESH token -- old ones keep old permissions'
      case "$err" in
        *"personal access token"*) O_DETAIL="${O_DETAIL} [GitHub says: personal access token]" ;;
        *"integration"*)           O_DETAIL="${O_DETAIL} [GitHub says: integration -- note this wording is NOT proof it is an App]" ;;
      esac
      return 0 ;;
    404)
      # GitHub returns 404 rather than 403 so it never confirms a private repo
      # exists. We genuinely cannot tell these apart and must not pretend to.
      O_TOKEN=not_found
      O_DETAIL='repo not found, OR this token cannot see it -- GitHub will not say which'
      return 0 ;;
    429) O_TOKEN=rate_limited; O_DETAIL='rate limited'; return 0 ;;
    5??) O_TOKEN=server_error; O_DETAIL="GitHub returned HTTP ${code}"; return 0 ;;
    '')
      # No HTTP code in the message at all: a transport failure, a TLS problem, a
      # credential helper that died. Quiet -- being loud about something we did
      # not understand spends the alarm channel on our own ignorance.
      case "$err" in
        *"timeout"*|*"timed out"*|*"deadline exceeded"*)
          O_TOKEN=timeout; O_DETAIL='request timed out' ;;
        *) O_TOKEN=transport
           O_DETAIL="gh could not reach the API${err:+ (${err%%$'\n'*})}" ;;
      esac
      return 0 ;;
    *)   O_TOKEN=http_other; O_DETAIL="HTTP ${code}"; return 0 ;;
  esac
}

# fetch_runs <repo> <branch> -> O_TOKEN O_DETAIL O_CONCL O_STATUS O_SHA O_URL
fetch_runs(){
  local repo="$1" branch="$2" out rc err
  O_TOKEN=''; O_DETAIL=''; O_CONCL=''; O_STATUS=''; O_SHA=''; O_URL=''

  if [ -n "${CI_WATCH_FORCE:-}" ]; then O_TOKEN=forced; return 0; fi
  if ! have_gh; then
    O_TOKEN=no_transport; O_DETAIL='gh is not installed -- nothing can be observed'
    return 0
  fi

  : >"$ERR_SINK" 2>/dev/null
  if [ -n "$branch" ]; then
    out="$("$GH" run list --repo "$repo" --branch "$branch" --limit 1 \
             --json conclusion,status,headSha,url \
             --jq '(.[0] // {}) | [(.conclusion // ""),(.status // ""),(.headSha // ""),(.url // "")] | @tsv' \
             2>"$ERR_SINK")"
  else
    out="$("$GH" run list --repo "$repo" --limit 1 \
             --json conclusion,status,headSha,url \
             --jq '(.[0] // {}) | [(.conclusion // ""),(.status // ""),(.headSha // ""),(.url // "")] | @tsv' \
             2>"$ERR_SINK")"
  fi
  rc=$?

  if [ "$rc" -ne 0 ]; then
    err="$(cat "$ERR_SINK" 2>/dev/null)"
    classify_gh_error "$err"
    return 0
  fi

  # exit 0. Either real fields, or every field empty, which is gh's honest way of
  # saying "no runs matched" -- and it can never be confused with a failure,
  # because a failure never gets here.
  IFS=$'\t' read -r O_CONCL O_STATUS O_SHA O_URL <<<"$out"
  if [ -z "${O_CONCL}${O_STATUS}${O_SHA}" ]; then
    O_TOKEN=empty_ok; O_DETAIL='no workflow runs recorded'; return 0
  fi
  O_SHA="${O_SHA:0:7}"
  O_TOKEN=ok
  return 0
}

# gh_api_ok <path> -> 0 if the call succeeded; sets GA_OUT and GA_CODE otherwise
gh_api_ok(){
  local path="$1" out rc err code=''
  GA_OUT=''; GA_CODE=''
  have_gh || return 2
  : >"$ERR_SINK" 2>/dev/null
  out="$("$GH" api "$path" 2>"$ERR_SINK")"; rc=$?
  if [ "$rc" -eq 0 ]; then GA_OUT="$out"; GA_CODE=200; return 0; fi
  err="$(cat "$ERR_SINK" 2>/dev/null)"
  [[ "$err" =~ HTTP[[:space:]]+([0-9]{3}) ]] && code="${BASH_REMATCH[1]}"
  GA_CODE="$code"
  return 1
}

# A SUCCESSFUL observation still has to be mapped to what it means. Note that
# in_progress and cancelled/neutral/skipped were SEEN -- they are results, not
# failures to observe, and must never land in the BLIND/UNOBSERVABLE register.
observed_state_of(){ # observed_state_of <conclusion> <status> -> green|red|inconclusive|running
  local concl="$1" status="$2"
  case "$status" in
    completed|'') ;;
    *) printf 'running'; return 0 ;;
  esac
  case "$concl" in
    success)                                printf 'green' ;;
    failure|timed_out|startup_failure)      printf 'red' ;;
    ''|null)                                printf 'running' ;;
    *)                                      printf 'inconclusive' ;;
  esac
}

# ---- per-target state ------------------------------------------------------
# schema=2. The two halves are deliberately independent: last_outcome answers
# "could I see it just now", observed_* answers "what did I last actually see".
# fetched_at is the success-only stamp; checked_at moves every run.
load_state(){
  local f="$STATE_DIR/$1.state" k v
  S_SCHEMA=0; S_OUTCOME=''; S_OBS=''; S_CONCL=''; S_SHA=''; S_URL=''
  S_FETCHED=0; S_CHECKED=0; S_RED_SINCE=0; S_SNOOZE=0
  S_BRANCH_ALIVE='?'; S_BRANCH_CHECKED=0
  if [ -f "$f" ]; then
    # Unknown keys are ignored and malformed lines cannot set anything: a
    # truncated or garbage file degrades to "never successfully observed".
    while IFS='=' read -r k v || [ -n "$k" ]; do
      case "$k" in
        schema)          S_SCHEMA="$(numor0 "$v")" ;;
        last_outcome)    S_OUTCOME="$v" ;;
        observed_state)  S_OBS="$v" ;;
        observed_concl)  S_CONCL="$v" ;;
        observed_sha)    S_SHA="$v" ;;
        observed_url)    S_URL="$v" ;;
        fetched_at)      S_FETCHED="$(numor0 "$v")" ;;
        checked_at)      S_CHECKED="$(numor0 "$v")" ;;
        red_since)       S_RED_SINCE="$(numor0 "$v")" ;;
        snooze_until)    S_SNOOZE="$(numor0 "$v")" ;;
        branch_alive)    case "$v" in 0|1) S_BRANCH_ALIVE="$v" ;; *) S_BRANCH_ALIVE='?' ;; esac ;;
        branch_checked)  S_BRANCH_CHECKED="$(numor0 "$v")" ;;
        last)            : ;;  # schema 1 remnant: deliberately NOT trusted
      esac
    done < "$f" 2>/dev/null
  fi
  # A schema-1 file (or anything unrecognised) has no success stamp, so it reads
  # as never-observed and cannot resurrect a stale green.
  [ "$S_SCHEMA" -eq 2 ] || { S_OBS=''; S_CONCL=''; S_SHA=''; S_FETCHED=0; S_OUTCOME=''; }
}

# Atomic: write to a temp file, then rename. Two sessions starting at once must
# never interleave into a half-written record.
save_state(){
  local f="$STATE_DIR/$1.state" t="$STATE_DIR/$1.state.$$.tmp"
  ( {
      printf 'schema=2\n'
      printf 'last_outcome=%s\n'   "$2"
      printf 'observed_state=%s\n' "$3"
      printf 'observed_concl=%s\n' "$4"
      printf 'observed_sha=%s\n'   "$5"
      printf 'observed_url=%s\n'   "$6"
      printf 'fetched_at=%s\n'     "$7"
      printf 'checked_at=%s\n'     "$8"
      printf 'red_since=%s\n'      "$9"
      printf 'snooze_until=%s\n'   "${10}"
      printf 'branch_alive=%s\n'   "${11}"
      printf 'branch_checked=%s\n' "${12}"
    } >"$t" ) 2>/dev/null && mv -f "$t" "$f" 2>/dev/null || true
}

# ---- spoken alert (best-effort; never fails) -------------------------------
voice_alert(){
  local msg="${1//\"/}" body
  [ -n "${CI_WATCH_DEBUG:-}" ] && { printf '[voice] %s\n' "$msg" >&2; return 0; }
  if [ -n "$VOICE_ID" ]; then
    body="$(printf '{"message": "%s", "voice_id": "%s", "voice_enabled": true}' "$msg" "$VOICE_ID")"
  else
    body="$(printf '{"message": "%s", "voice_enabled": true}' "$msg")"
  fi
  if have curl && curl -fsS --max-time 4 -X POST "$NOTIFY_URL" \
       -H 'Content-Type: application/json' -d "$body" >/dev/null 2>&1; then
    return 0
  fi
  [ -x /usr/bin/say ] && { /usr/bin/say "$msg" >/dev/null 2>&1 & }
  return 0
}

# ---- banners ---------------------------------------------------------------
red_banner(){ # tier days label concl sha repo stale
  local tier="$1" days="$2" label="$3" concl="$4" sha="$5" repo="$6" stale="$7"
  local snip="ci-watch --snooze ${repo} ${days:-3}"
  local note=""; [ -n "$stale" ] && note=" ${DIM}(last known; ${stale})${NC}"
  case "$tier" in
    1)
      printf '%b\n' "${RED}${BOLD}  CI RED -- ${label}${NC}${note}"
      printf '%b\n' "${RED}     ${concl:-failure} . ${sha:-?} . red for ${days}d${NC}"
      printf '%b\n' "${DIM}     fix it, or hush: ${snip}${NC}" ;;
    2)
      printf '%b\n' "${RED}${BOLD}  +------------------------------------------+${NC}"
      printf '%b\n' "${RED}${BOLD}  |  CI RED for ${days} DAYS -- ${label}${NC}${note}"
      printf '%b\n' "${RED}${BOLD}  +------------------------------------------+${NC}"
      printf '%b\n' "${RED}     ${concl:-failure} . ${sha:-?}${NC}"
      printf '%b\n' "${DIM}     fix it, or hush: ${snip}${NC}" ;;
    *)
      printf '%b\n' "${RED}${BOLD}  ############################################${NC}"
      printf '%b\n' "${RED}${BOLD}  ##  CI RED ${days} DAYS -- ${label}${NC}${note}"
      printf '%b\n' "${RED}${BOLD}  ############################################${NC}"
      printf '%b\n' "${RED}     ${concl:-failure} . ${sha:-?}${NC}"
      printf '%b\n' "${DIM}     fix it, or hush: ${snip}${NC}" ;;
  esac
}

# BLIND is loud, but in its own register and it self-clears. See header note 4.
blind_banner(){ # label detail lastline
  local label="$1" detail="$2" lastline="$3"
  printf '%b\n' "${MAGENTA}${BOLD}  !! CI BLIND -- ${label}${NC}"
  printf '%b\n' "${MAGENTA}     the watch cannot observe this target: ${detail}${NC}"
  [ -n "$lastline" ] && printf '%b\n' "${DIM}     ${lastline}${NC}"
  printf '%b\n' "${DIM}     clears itself the moment access returns -- no ack needed${NC}"
}

# ---- one target ------------------------------------------------------------
process_target(){ # repo branch label
  local repo="$1" branch="$2" label="$3" key now days tier
  TRANSITION=0   # per-target: it used to be global and the branch-gone early
                 # return skipped its reset, so one target's fresh red spoke a
                 # "just went red" alert about a DIFFERENT, already-known red.
  local fetched checked red_since snooze balive bchecked
  local obs concl sha url outcome detail age lastline
  key="$(keyof "${repo}@${branch}")"
  load_state "$key"
  now="$(now_epoch)"

  # Forced classification is a self-test lever; it deliberately bypasses the
  # network AND the cache so --control can drive the render deterministically.
  if [ -n "${CI_WATCH_FORCE:-}" ]; then
    outcome=ok; detail=forced
    case "$CI_WATCH_FORCE" in
      green) obs=green; concl=success; sha=FORCED ;;
      red)   obs=red;   concl=failure; sha=FORCED ;;
      *)     outcome=transport; detail=forced; obs=''; concl=''; sha='' ;;
    esac
    url=''
  else
    fetch_runs "$repo" "$branch"
    outcome="$O_TOKEN"; detail="$O_DETAIL"
    concl="$O_CONCL"; sha="$O_SHA"; url="$O_URL"
    obs=''
    [ "$outcome" = ok ] && obs="$(observed_state_of "$O_CONCL" "$O_STATUS")"
    [ "$outcome" = empty_ok ] && obs=norun
  fi

  # --- branch liveness. The runs endpoint CANNOT see a deleted branch (it keeps
  # serving its historical runs), so this second call is the only discriminator.
  # Cached for BRANCH_TTL to keep it to roughly one extra call per target per day.
  # A 404 HERE IS NOT PROOF THE BRANCH IS GONE. Measured live 2026-09-15: the
  # branches endpoint returned 404 for a watched branch
  # that is alive and whose CI was green in the same breath -- because this
  # token can read Actions on that repo but not Contents, and GitHub returns 404
  # rather than 403 so it never confirms a private resource exists. Shipping
  # "branch gone" on a bare 404 would have invented a NEW false alarm to replace
  # the false green, which is not a trade worth making.
  #
  # So a 404 gets a POSITIVE CONTROL in the same breath, exactly as this repo's
  # own count-and-absence rule demands: ask for a branch that MUST exist (the
  # repo's default). If that one answers 200 the token can clearly read branches,
  # so our 404 means genuinely deleted. If it 404s too, the instrument is blind
  # and the honest answer is "cannot confirm", never "gone".
  balive="$S_BRANCH_ALIVE"; bchecked="$S_BRANCH_CHECKED"
  if [ -n "$branch" ] && [ -z "${CI_WATCH_FORCE:-}" ] \
     && [ $(( 10#$now - 10#$bchecked )) -ge "$BRANCH_TTL" ]; then
    if gh_api_ok "repos/${repo}/branches/$(enc_branch "$branch")"; then
      balive=1; bchecked="$now"
    elif [ "$GA_CODE" = 404 ]; then
      local dflt
      dflt=''
      gh_api_ok "repos/${repo}" && dflt="$(printf '%s' "$GA_OUT" | tr ',' '\n' \
                                            | grep '"default_branch"' | head -1 \
                                            | sed 's/.*"default_branch"[[:space:]]*:[[:space:]]*"//; s/".*//')"
      if [ -n "$dflt" ] && [ "$dflt" != "$branch" ] \
         && gh_api_ok "repos/${repo}/branches/$(enc_branch "$dflt")"; then
        balive=0; bchecked="$now"       # control HIT: the 404 is real
      else
        balive='?'; bchecked="$now"     # control MISSED: invalid trial, say nothing
      fi
    fi
    # Any other failure tells us nothing about the ref, so we leave the previous
    # answer alone rather than inventing one.
  fi

  # --- fold the outcome into the record. THE INVARIANT: fetched_at moves only
  # on a successful observation. Everything else about a failed fetch is
  # recorded, but the freshness stamp is untouchable.
  fetched="$S_FETCHED"; red_since="$S_RED_SINCE"; snooze="$S_SNOOZE"
  checked="$now"
  if [ "$outcome" = ok ] || [ "$outcome" = empty_ok ]; then
    fetched="$now"
    # ONLY A GREEN CLEARS THE ALARM. This used to read `else red_since=0`, which
    # let `running`, `cancelled`, `neutral`, `skipped` and `no runs` wipe a red
    # streak -- so cancelling a workflow DISMISSED the alarm, and the next real
    # failure came back as "red for 0d" at tier 1 with a fresh transition voice.
    # Reproduced 2026-09-15: red for 6 days at tier 2, one cancelled run, alarm
    # gone. That is dismiss-by-cancel, the exact thing this tool exists to
    # prevent, and it was introduced by the four-state rewrite: the OLD tool
    # mapped all of those to `unknown`, whose branch never wrote state at all.
    # An inconclusive observation is news about a RUN, never proof the build was
    # fixed. Found by an independent audit (Max), not by the 82-case suite --
    # C8 and Anti-C23 both passed while this was live.
    case "$obs" in
      red)   [ "$red_since" -le 0 ] && { red_since="$now"; TRANSITION=1; } ;;
      green) red_since=0; snooze=0 ;;
      *)     : ;;
    esac
  else
    # Failure: keep the previous observation verbatim, and keep the red history.
    obs="$S_OBS"; concl="$S_CONCL"; sha="$S_SHA"; url="$S_URL"
  fi
  save_state "$key" "$outcome" "$obs" "$concl" "$sha" "$url" \
             "$fetched" "$checked" "$red_since" "$snooze" "$balive" "$bchecked"

  # --- a dead ref outranks everything: the watch can never fire again as pinned.
  if [ "$balive" = 0 ]; then
    printf '%b\n' "${MAGENTA}${BOLD}  !! CI branch gone -- ${label}${NC}"
    printf '%b\n' "${MAGENTA}     the watched branch ${repo}@${branch} no longer exists on GitHub${NC}"
    printf '%b\n' "${DIM}     GitHub still serves its old runs, so this watch would look alive forever${NC}"
    printf '%b\n' "${DIM}     re-point it: ci-watch --add . from the branch you actually want${NC}"
    return 0
  fi

  age=$(( 10#$now - 10#$fetched )); [ "$fetched" -le 0 ] && age=-1

  # --- LIVE observation --------------------------------------------------
  if [ "$outcome" = ok ] || [ "$outcome" = empty_ok ]; then
    # An unfixed red outranks a newer non-conclusive observation. Keeping
    # red_since in the file but rendering `.. CI cancelled` would still hide the
    # alarm for the session, which is the same dismissal wearing a quieter coat.
    if [ "$obs" != green ] && [ "$obs" != red ] && [ "$red_since" -gt 0 ]; then
      days=$(( (10#$now - 10#$red_since) / 86400 ))
      if [ "$snooze" -gt "$now" ]; then
        printf '%b\n' "   ${YELLOW}zzz${NC} ${DIM}CI red ${days}d but snoozed -- ${label}${NC}"
      else
        tier_for_days "$days"; tier="$TIER"
        red_banner "$tier" "$days" "$label" "$concl" "$sha" "${repo}@${branch}" \
                   "newest run: ${obs}${O_CONCL:+ / $O_CONCL} -- not a fix"
      fi
      TRANSITION=0
      return 0
    fi
    case "$obs" in
      green)
        printf '%b\n' "   ${GREEN}OK${NC} ${DIM}CI green -- ${label} (${sha:-?})${NC}" ;;
      red)
        days=$(( (10#$now - 10#$red_since) / 86400 ))
        if [ "$snooze" -gt "$now" ]; then
          printf '%b\n' "   ${YELLOW}zzz${NC} ${DIM}CI red ${days}d but snoozed -- ${label}${NC}"
        else
          tier_for_days "$days"; tier="$TIER"
          red_banner "$tier" "$days" "$label" "$concl" "$sha" "${repo}@${branch}" ""
          if [ "${TRANSITION:-0}" -eq 1 ]; then
            voice_alert "Heads up. ${label} C I just went red."
          elif [ "$tier" -ge 2 ]; then
            voice_alert "Reminder. ${label} C I has been red for ${days} days."
          fi
        fi ;;
      running)
        printf '%b\n' "   ${DIM}.. CI running -- ${label} (${sha:-?})${NC}" ;;
      inconclusive)
        printf '%b\n' "   ${DIM}.. CI ${concl:-inconclusive} -- ${label} (${sha:-?})${NC}" ;;
      norun)
        printf '%b\n' "   ${DIM}.. CI no runs yet -- ${label}${NC}" ;;
    esac
    TRANSITION=0
    return 0
  fi

  # --- COULD NOT OBSERVE --------------------------------------------------
  # A known red is never silenced by an outage: dismiss-only-by-fixing.
  if [ "$S_OBS" = red ] && [ "$red_since" -gt 0 ]; then
    days=$(( (10#$now - 10#$red_since) / 86400 ))
    if [ "$snooze" -gt "$now" ]; then
      printf '%b\n' "   ${YELLOW}zzz${NC} ${DIM}CI red ${days}d, snoozed, status stale -- ${label}${NC}"
    else
      tier_for_days "$days"; tier="$TIER"
      red_banner "$tier" "$days" "$label" "$concl" "$sha" "${repo}@${branch}" "$(age_str "$age") old"
    fi
    return 0
  fi

  # Never successfully observed: nothing regressed, the setup is incomplete.
  # Quiet on purpose -- a permanently loud line here would spend the attention
  # that BLIND and RED need.
  if [ "$fetched" -le 0 ]; then
    printf '%b\n' "   ${DIM}.. CI unobservable -- ${label} (never successfully seen: ${detail})${NC}"
    return 0
  fi

  # Past the hard TTL the value is withheld entirely; only the reason remains.
  if [ "$age" -ge "$HARD_TTL" ]; then
    lastline="last success was $(age_str "$age") ago -- too old to show"
  else
    lastline="last seen ${obs:-?} (${concl:-?} ${sha:-?}) $(age_str "$age") ago"
  fi

  case "$outcome" in
    perm_denied|unauthorized|not_found)
      # We COULD see this and now cannot. Something regressed. Loud.
      blind_banner "$label" "$detail" "$lastline" ;;
    *)
      # Transient: a blip does not deserve a banner, but it must never wear green.
      printf '%b\n' "   ${DIM}.. CI stale -- ${label}: ${lastline} (${detail})${NC}" ;;
  esac
  return 0
}

# ---- watchlist parsing -----------------------------------------------------
each_entry(){
  local cb="$1" line target label repo branch
  [ -f "$WATCHLIST" ] || return 1
  while IFS= read -r line || [ -n "$line" ]; do
    case "$line" in ''|\#*) continue;; esac
    if [[ "$line" == *"|"* ]]; then target="${line%%|*}"; label="$(trim "${line#*|}")";
    else target="$line"; label=""; fi
    target="$(trim "$target")"
    [ -z "$target" ] && continue
    if [[ "$target" == *"@"* ]]; then repo="${target%@*}"; branch="${target#*@}";
    else repo="$target"; branch=""; fi
    [ -z "$label" ] && { label="$repo"; [ -n "$branch" ] && label="$repo@$branch"; }
    "$cb" "$repo" "$branch" "$label"
  done < "$WATCHLIST"
}

remote_owner_repo(){ printf '%s' "$1" | sed -E 's#\.git$##; s#^.*[:/]([^/:]+/[^/:]+)$#\1#'; }

default_branch_of(){ # best effort; origin/HEAD when set, else the usual names
  local d
  d="$(git symbolic-ref --short -q refs/remotes/origin/HEAD 2>/dev/null)"
  d="${d#origin/}"
  [ -n "$d" ] && { printf '%s' "$d"; return 0; }
  for d in main master; do
    git show-ref --verify -q "refs/heads/$d" 2>/dev/null && { printf '%s' "$d"; return 0; }
  done
  printf ''
}

suggest_current_repo(){
  local top remote owner_repo
  top="$(git rev-parse --show-toplevel 2>/dev/null || true)"
  [ -n "$top" ] && [ -d "$top/.github/workflows" ] || return 0
  remote="$(git remote get-url origin 2>/dev/null || true)"
  [ -n "$remote" ] || return 0
  owner_repo="$(remote_owner_repo "$remote")"
  [ -n "$owner_repo" ] || return 0
  if [ -f "$WATCHLIST" ] && grep -qiF "$owner_repo" "$WATCHLIST" 2>/dev/null; then
    return 0
  fi
  printf '%b\n' "   ${DIM}.. untracked CI: ${owner_repo} has workflows but isn't watched -- add: ci-watch --add .${NC}"
}

# One row must never be able to take the dashboard down with it: a target that
# dies renders nothing, and every other row still gets its line.
render_target(){ ( process_target "$@" ) || true; }

cmd_render(){
  TRANSITION=0
  if [ -f "$WATCHLIST" ]; then
    if ! have gh && [ -z "${GH_TOKEN:-}" ] && [ -z "${CI_WATCH_FORCE:-}" ] \
       && [ -z "${CI_WATCH_HTTP_STUB:-}" ]; then
      printf '%b\n' "${DIM}CI watch: skipped (no gh / GH_TOKEN -- runs inside Claude sessions).${NC}"
    fi
    printf '%b\n' "${BOLD}CI watch${NC} ${DIM}(live each session; red is sticky until fixed)${NC}"
    each_entry render_target
  fi
  suggest_current_repo
  return 0
}

cmd_snooze(){
  local match="${1:-}" days="${2:-}" hit=0 now until
  case "$days" in ''|*[!0-9]*) printf 'usage: ci-watch --snooze <repo> <days>\n' >&2; return 2;; esac
  days="$(numor0 "$days")"          # `08` is all-digit AND invalid octal
  [ -z "$match" ] && { printf 'usage: ci-watch --snooze <repo> <days>\n' >&2; return 2; }
  now="$(now_epoch)"; until=$(( 10#$now + 10#$days * 86400 ))
  _snooze_one(){
    local repo="$1" branch="$2" label="$3" key
    case "${repo}@${branch}" in *"$match"*) ;; *) return 0;; esac
    key="$(keyof "${repo}@${branch}")"
    load_state "$key"
    # NOT "${S_OBS:-red}": snoozing a never-observed target used to write
    # observed_state=red into the record, so --json reported a red for something
    # that had never been seen. A snooze is a decision about noise, not an
    # observation.
    save_state "$key" "${S_OUTCOME:-}" "$S_OBS" "$S_CONCL" "$S_SHA" "$S_URL" \
               "$S_FETCHED" "$S_CHECKED" "${S_RED_SINCE:-$now}" "$until" \
               "$S_BRANCH_ALIVE" "$S_BRANCH_CHECKED"
    printf 'snoozed %s for %s day(s)\n' "$label" "$days"
    hit=1
  }
  each_entry _snooze_one || true
  [ "$hit" -eq 1 ] || { printf 'no watchlist target matched "%s"\n' "$match" >&2; return 1; }
}

cmd_add(){
  local target="${1:-.}" label="${2:-}" remote owner_repo branch dflt
  if [ "$target" = "." ]; then
    remote="$(git remote get-url origin 2>/dev/null || true)"
    [ -n "$remote" ] || { printf 'ci-watch --add .: not in a git repo with an origin remote\n' >&2; return 2; }
    owner_repo="$(remote_owner_repo "$remote")"
    branch="$(git symbolic-ref --short -q HEAD 2>/dev/null || true)"
    [ -n "$branch" ] && target="${owner_repo}@${branch}" || target="$owner_repo"
    [ -z "$label" ] && { label="$(basename "$owner_repo")"; [ -n "$branch" ] && label="$label $branch"; }
  fi
  [ -n "$target" ] || { printf 'usage: ci-watch --add <owner/repo[@branch] | .> [label]\n' >&2; return 2; }
  mkdir -p "$(dirname "$WATCHLIST")" 2>/dev/null || true
  if [ -f "$WATCHLIST" ] && grep -qiF "${target%%@*}" "$WATCHLIST" 2>/dev/null; then
    printf 'already on the watchlist: %s\n' "${target%%@*}"; return 0
  fi
  if [ -n "$label" ]; then printf '%s | %s\n' "$target" "$label" >> "$WATCHLIST"
  else printf '%s\n' "$target" >> "$WATCHLIST"; fi
  printf 'added to watchlist: %s\n' "$target"

  # A feature branch will be merged and deleted, and GitHub keeps serving a
  # deleted branch's old runs -- so a pin left behind looks alive forever. Say so
  # AT ADD TIME, when it is one command to fix, not months later.
  if [ -n "${branch:-}" ]; then
    dflt="$(default_branch_of)"
    if [ -n "$dflt" ] && [ "$branch" != "$dflt" ]; then
      printf '\nNOTE: this watch is PINNED to the branch "%s", not to "%s".\n' "$branch" "$dflt"
      printf '      When that branch merges and is deleted the watch cannot fire again.\n'
      printf '      To re-point it later: ci-watch --add . from %s, then drop the old row\n' "$dflt"
      printf '      from %s\n' "$WATCHLIST"
    fi
  fi
}

cmd_list(){
  [ -f "$WATCHLIST" ] || { printf 'no watchlist at %s\n' "$WATCHLIST"; return 0; }
  printf 'watchlist: %s\n' "$WATCHLIST"
  _list_one(){ printf '  %-40s %s\n' "$1${2:+@$2}" "$3"; }
  each_entry _list_one
}

cmd_json(){
  [ -f "$WATCHLIST" ] || { printf '[]\n'; return 0; }
  local first=1
  printf '['
  _json_one(){
    local repo="$1" branch="$2" key now days age
    key="$(keyof "${repo}@${branch}")"; load_state "$key"
    now="$(now_epoch)"; days=0
    [ "$S_RED_SINCE" -gt 0 ] && days=$(( (10#$now - 10#$S_RED_SINCE) / 86400 ))
    age=-1; [ "$S_FETCHED" -gt 0 ] && age=$(( 10#$now - 10#$S_FETCHED ))
    [ "$first" -eq 1 ] && first=0 || printf ','
    printf '{"repo":"%s","branch":"%s","last_outcome":"%s","observed_state":"%s","conclusion":"%s","sha":"%s","age_seconds":%s,"checked_at":%s,"days_red":%s,"snoozed":%s,"branch_alive":"%s"}' \
      "$repo" "$branch" "${S_OUTCOME:-never}" "${S_OBS:-}" "$S_CONCL" "$S_SHA" \
      "$age" "$S_CHECKED" "$days" "$([ "$S_SNOOZE" -gt "$now" ] && echo true || echo false)" "$S_BRANCH_ALIVE"
  }
  each_entry _json_one
  printf ']\n'
}

# ---- the control arm -------------------------------------------------------
# "A skip is never a false green" is a claim ABOUT THIS TOOL, and a run where
# every line is green is indistinguishable from a run that never executed --
# unless something in the same run is GUARANTEED to be non-green. This renders
# two targets that must not come out green: one never observed, one with a
# planted success that is then refused. Exit 1 if either shows the green glyph.
cmd_control(){
  local d stub list out rc=0
  d="$(mktemp -d "${TMPDIR:-/tmp}/ci-watch-control.XXXXXX")" || {
    printf 'ci-watch --control: mktemp failed -- INVALID TRIAL, not a pass\n' >&2; return 2; }
  mkdir -p "$d/state"
  printf 'ci-watch-control/never-observable@main | CONTROL never observed\n'  > "$d/list"
  printf 'ci-watch-control/was-green@main | CONTROL was green, now refused\n' >> "$d/list"
  stub="$d/stub"
  cat > "$stub" <<'CSTUB'
#!/usr/bin/env bash
printf '403\n{"message":"Resource not accessible by integration","status":"403"}'
CSTUB
  chmod +x "$stub"
  # Plant a success for the second target so the cache-fallback path is armed.
  printf 'schema=2\nlast_outcome=ok\nobserved_state=green\nobserved_concl=success\nobserved_sha=deadbee\nobserved_url=u\nfetched_at=1\nchecked_at=1\nred_since=0\nsnooze_until=0\nbranch_alive=1\nbranch_checked=99999999999\n' \
    > "$d/state/$(keyof 'ci-watch-control/was-green@main').state"

  out="$(CI_WATCH_LIST="$d/list" CI_WATCH_STATE="$d/state" CI_WATCH_HTTP_STUB="$stub" \
         NO_COLOR=1 "$0" 2>&1)"
  if printf '%s' "$out" | grep -q 'CI green'; then
    printf 'ci-watch --control: FAILED -- a refused target rendered GREEN.\n' >&2
    printf '%s\n' "$out" >&2
    rc=1
  elif [ -z "$out" ]; then
    printf 'ci-watch --control: FAILED -- rendered nothing at all (invalid trial).\n' >&2
    rc=1
  else
    printf 'ci-watch --control: ok -- a refused target cannot render green.\n'
  fi
  return "$rc"
}

# render MUST always exit 0 (it runs at session start and must never block).
rc=0
case "${1:-}" in
  ''|check|--check|render)  cmd_render ;;
  --add)                    shift; cmd_add "${1:-}" "${2:-}" || rc=$? ;;
  --snooze)                 shift; cmd_snooze "${1:-}" "${2:-}" || rc=$? ;;
  --list|-l)                cmd_list || rc=$? ;;
  --json)                   cmd_json || rc=$? ;;
  --control)                cmd_control || rc=$? ;;
  -h|--help)                sed -n '2,140p' "$0" | sed 's/^# \{0,1\}//' ;;
  *) printf 'ci-watch: unknown arg "%s" (try --help)\n' "$1" >&2; exit 2 ;;
esac
exit "$rc"
