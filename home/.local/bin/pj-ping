#!/bin/sh
# pj-ping -- the old name of engage-ping (wean B13, goal 16). Every call goes on, unchanged, to
# engage-ping: the same arguments, streams and exit code; read `engage-ping --help`.
# Kept until no session started before B13's render is alive and 7 days pass with no call
# (Gavin, e-conductor Q27: 1); then it moves to ~/RETIRED, never the Trash.
#
# Each call is marked in engage's mousetrap first (`engage-go trap log --stub`), so engage can
# see who still calls the old name. A failed mark, or no engage-go, never stops the call.
"${ENGAGE_TRAP_GO:-$HOME/.local/bin/engage-go}" trap log --ppid "$PPID" --stub --tool pj-ping -- "$@" </dev/null >/dev/null 2>&1

# engage-ping beside this file's real path (a link is followed), else on PATH; never itself.
self="$0"
while [ -L "$self" ]; do
  t=$(readlink "$self")
  case "$t" in /*) self="$t" ;; *) self="$(dirname "$self")/$t" ;; esac
done
target="$(dirname "$self")/engage-ping"
[ -x "$target" ] || target=$(command -v engage-ping 2>/dev/null)
if [ -z "$target" ] || [ ! -x "$target" ] || [ "$target" -ef "$self" ]; then
  echo "pj-ping: engage-ping not found beside $self or on PATH (it is the tool this stub forwards to)" >&2
  exit 127
fi
exec "$target" "$@"
