#!/bin/bash
# herdr-cache-report -- put a Claude session's prompt-cache countdown on its row
# in herdr's agents list ("◷ 42 m"), from inside the session's status line.
#
#   herdr-cache-report --warm true|false --expires EPOCH [--ttl SECONDS]
#   herdr-cache-report --selftest
#
# Gavin, 19 Oct 2026 (dotfiles-main Q70: 1): the minutes left before the cache
# goes cold, against each agent in the sidebar. A status line already gets the
# exact expiry from Claude Code (.prompt_cache.expires_at, .warm, .ttl) and
# re-runs every 30 s, so each status line calls this once per run:
#   ~/.claude/statusline-command.sh       (plain claude sessions)
#   engage's statusline/session-line.sh   (engage sessions; engage's to wire)
#
# It reports one of seven tokens on $HERDR_PANE_ID, clearing the other six. The
# band is the minutes shown (Gavin, 19 Oct, 11:55 PM: six colours, one per ten
# minutes, and a space between the number and the m):
#   $cache_m50   "◷ 55 m"    50 minutes or more   green
#   $cache_m40   "◷ 45 m"    40 to 49             mint
#   $cache_m30   "◷ 35 m"    30 to 39             aqua
#   $cache_m20   "◷ 25 m"    20 to 29             orchid
#   $cache_m10   "◷ 15 m"    10 to 19             tangerine
#   $cache_m0    "◷ 9 m"     under 10             crimson (he asked for a blink too;
#                                                 herdr refuses blink in config.toml)
#   $cache_cold  "◷ cold"    expired, or Claude Code says it is not warm
# Their colours are in herdr's config.toml, [ui.sidebar.agents], line 1. --ttl is
# still read, and no longer changes the band.
# --ttl-ms drops the token 2 minutes after the last report, so a pane whose
# status line stopped shows none; --agent claude drops it when Claude exits.
#
# Silent and exit 0 outside herdr (HERDR_ENV unset), without a pane id, or
# without herdr on PATH. The report runs in the background, so a slow herdr
# never slows a status line. Exit 2 on bad arguments.
set -u

SOURCE="dotfiles-statusline-cache"

minutes_left() { # epoch -> "42 m", or "1 h 05 m" past an hour
    local d=$(($1 - $(date +%s)))
    [ "$d" -lt 0 ] && d=0
    if [ "$d" -ge 3600 ]; then printf '%d h %02d m' $((d / 3600)) $((d % 3600 / 60))
    else printf '%d m' $((d / 60)); fi
}

BANDS="m50 m40 m30 m20 m10 m0 cold"
# bucket WARM EXPIRES -> m50 | m40 | m30 | m20 | m10 | m0 | cold, by the minutes shown
bucket() {
    local left=$(($2 - $(date +%s))) m
    if [ "$1" != true ] || [ "$left" -le 0 ]; then echo cold; return; fi
    m=$((left / 60))
    if [ "$m" -ge 50 ]; then echo m50
    elif [ "$m" -ge 40 ]; then echo m40
    elif [ "$m" -ge 30 ]; then echo m30
    elif [ "$m" -ge 20 ]; then echo m20
    elif [ "$m" -ge 10 ]; then echo m10
    else echo m0; fi
}

if [ "${1:-}" = "--selftest" ]; then
    fx=$(mktemp -d "${TMPDIR:-/tmp}/herdr-cache-report.XXXXXX") || exit 1
    mkdir -p "$fx/bin"
    printf '#!/bin/sh\nprintf "%%s\\n" "$*" >> "%s/args"\n' "$fx" > "$fx/bin/herdr"
    chmod +x "$fx/bin/herdr"
    pass=0 fail=0 now=$(date +%s)
    run() { env HERDR_ENV=1 HERDR_PANE_ID=wT:p1 PATH="$fx/bin:$PATH" "$0" "$@"; }
    got() { local n=0; while [ ! -s "$fx/args" ] && [ $n -lt 30 ]; do sleep 0.1; n=$((n + 1)); done
            sleep 0.1; cat "$fx/args" 2>/dev/null; command mv "$fx/args" "$fx/args.$RANDOM" 2>/dev/null; }
    check() { if printf '%s' "$2" | grep -qF -- "$3"; then g=yes; else g=no; fi
              if [ "$g" = "$4" ]; then pass=$((pass + 1)); else fail=$((fail + 1)); echo "FAIL $1: '$3' present=$g, wanted $4"; fi; }
    run --warm true --expires $((now + 1830)) --ttl 3600; a=$(got)
    check "30 min left: the 30s band, a space before the m" "$a" "--token cache_m30=◷ 30 m" yes
    check "the other six bands cleared" "$a" "--clear-token cache_m50 --clear-token cache_m40 --clear-token cache_m20 --clear-token cache_m10 --clear-token cache_m0 --clear-token cache_cold" yes
    check "pane, source, agent, expiry" "$a" "pane report-metadata wT:p1 --source $SOURCE --agent claude --ttl-ms 120000" yes
    for c in "3590 m50 59" "3030 m50 50" "2990 m40 49" "2430 m40 40" "2390 m30 39" "1790 m20 29" "1230 m20 20" "1190 m10 19" "630 m10 10" "590 m0 9" "30 m0 0"; do
        set -- $c; run --warm true --expires $((now + $1)) --ttl 3600; a=$(got)
        check "$3 min shown: band $2" "$a" "--token cache_$2=◷ $3 m" yes
    done
    run --warm true --expires $((now + 4000)) --ttl 7200; a=$(got)
    check "past an hour: 1 h 06 m, green" "$a" "--token cache_m50=◷ 1 h 06 m" yes
    run --warm true --expires $((now + 215)) --ttl 300; a=$(got)
    check "5 m ttl, 3 min left: the under-10 band" "$a" "--token cache_m0=◷ 3 m" yes
    run --warm false --expires $((now + 1830)) --ttl 3600; a=$(got)
    check "not warm: cold" "$a" "--token cache_cold=◷ cold" yes
    run --warm true --expires $((now - 5)) --ttl 3600; a=$(got)
    check "expired: cold" "$a" "--token cache_cold=◷ cold" yes
    sleep 0.3; command mv "$fx/args" "$fx/args.late" 2>/dev/null
    env -u HERDR_ENV HERDR_PANE_ID=wT:p1 PATH="$fx/bin:$PATH" "$0" --warm true --expires $((now + 900)); sleep 0.3
    check "outside herdr: nothing sent" "$([ -e "$fx/args" ] && echo sent || echo none)" "none" yes
    run --warm true; rc=$?
    check "no --expires: usage error" "$rc" "2" yes
    run --warm true --expires 2>/dev/null; rc=$?
    check "a flag given last with no value: usage error, no hang" "$rc" "2" yes
    echo "herdr-cache-report selftest: $pass passed, $fail failed"
    [ "$fail" -eq 0 ]
    exit
fi

warm="" expires="" ttl=0
while [ $# -gt 0 ]; do
    # every flag takes a value; one given last with none cannot shift 2, so it
    # is refused there rather than spinning this loop
    case "$1" in
        --warm) warm=${2:-}; shift 2 || { echo "herdr-cache-report: --warm needs a value" >&2; exit 2; } ;;
        --expires) expires=${2%.*}; shift 2 || { echo "herdr-cache-report: --expires needs a value" >&2; exit 2; } ;;
        --ttl) ttl=${2:-0}; shift 2 || { echo "herdr-cache-report: --ttl needs a value" >&2; exit 2; } ;;
        *) echo "herdr-cache-report: unknown argument: $1" >&2; exit 2 ;;
    esac
done
case "$warm" in true|false) ;; *) echo "herdr-cache-report: --warm true|false is required" >&2; exit 2 ;; esac
case "$expires" in ''|*[!0-9]*) echo "herdr-cache-report: --expires EPOCH is required" >&2; exit 2 ;; esac
case "$ttl" in ''|*[!0-9]*) ttl=0 ;; esac

[ "${HERDR_ENV:-}" = 1 ] && [ -n "${HERDR_PANE_ID:-}" ] || exit 0
command -v herdr >/dev/null 2>&1 || exit 0

b=$(bucket "$warm" "$expires")
if [ "$b" = cold ]; then value="◷ cold"; else value="◷ $(minutes_left "$expires")"; fi
clear=()
for other in $BANDS; do [ "$other" = "$b" ] || clear+=(--clear-token "cache_$other"); done
# The three tokens before 19 Oct; cleared too, so no pane keeps an old one.
clear+=(--clear-token cache_warm --clear-token cache_low)
( herdr pane report-metadata "$HERDR_PANE_ID" --source "$SOURCE" --agent claude \
    --ttl-ms 120000 --token "cache_$b=$value" "${clear[@]}" >/dev/null 2>&1 & )
exit 0
