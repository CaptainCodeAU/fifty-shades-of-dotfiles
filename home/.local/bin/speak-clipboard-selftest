#!/usr/bin/env bash
# ============================================================================
#  speak-clipboard-selftest -- prove the --from-pane clipboard loan, every arm
# ============================================================================
#
# Proves speak-clipboard's SELECTION path (v6) without a mouse: the copy step
# is injected with SPEAK_CLIPBOARD_COPY_CMD (a shell command that writes the
# pasteboard, standing in for Ctrl+Shift+C into a Claude pane). The one arm it
# CANNOT prove is the real one, a real highlight in a real Claude Code pane;
# that needs a hand on the mouse (docs/HERDR.md, speak-selection).
#
# YOUR CLIPBOARD IS SAFE, AND THE PROOF IS PRINTED. Before the first arm,
# `speak-clipboard-grab --hold` snapshots the live clipboard into its own
# memory (never to disk: it may hold a secret) and blocks on a pipe from this
# script. When this script ends, normally or by a crash, the pipe closes and
# the holder restores the clipboard, then compares type lists and SHA-256
# prefixes before and after and prints digest_identical=yes|NO (exit 3 on NO).
# Anything YOU copy while it runs (about 25 s) is lost at that restore.
#
# A copy from OUTSIDE during a run (you, another session, any app) can also
# fail an arm whose clipboard it changed. MEASURED 2026-10-02: 3 outside
# writes in a quiet minute on this Mac, and 2 arms in 14 runs failed that
# way (an item with 1 type where the 3-type fixture had been). Rerun before
# believing a lone FAIL in a selection or error arm.
#
# Speech arms run against a throwaway state folder and play at --volume 0,
# so nothing is heard and the real speak-clipboard.log and pid file are not
# touched. They are SKIPPED (named, never passed) unless the cached engine is
# say2 with ffplay, the only path where --volume applies.
#
# Must run OUTSIDE Claude Code's Bash sandbox: inside it the pasteboard is
# unreachable and this refuses (exit 2) rather than reporting a clean run.
#
# EXIT  0 every arm passed (SKIPs named on stdout)  1 an arm failed
#       2 could not measure (sandbox, missing helper)  3 restore mismatch
# ============================================================================
set -uo pipefail

here="$(cd "$(dirname "$0")" && pwd)"
sc="$here/speak-clipboard"
grab="$here/speak-clipboard-grab"
G() { osascript -l JavaScript "$grab" "$@"; }

[ -x "$sc" ] && [ -f "$grab" ] || { echo "selftest: speak-clipboard or its grab helper is missing in $here" >&2; exit 2; }
if ! G --digest >/dev/null 2>&1; then
    echo "selftest: the pasteboard is unreachable (inside the sandbox?); NOT a pass" >&2
    exit 2
fi

work="$(mktemp -d "${TMPDIR:-/tmp}/speak-selftest.XXXXXX")" || exit 2
state="$work/state"; mkdir -p "$state/herdr"
log="$state/herdr/speak-clipboard.log"
pass=0; fail=0; skip=0
ok()   { pass=$((pass + 1)); printf 'PASS  %s\n' "$*"; }
bad()  { fail=$((fail + 1)); printf 'FAIL  %s\n' "$*"; }
skp()  { skip=$((skip + 1)); printf 'SKIP  %s\n' "$*"; }
dg()   { G --digest | tail -n +2 | shasum | cut -c1-12; }
cc()   { G --digest | sed -n 's/^change_count=//p'; }
# Run speak-clipboard against the throwaway state, as a Claude-pane press.
SC()   { XDG_STATE_HOME="$state" HERDR_BIN_PATH=/nonexistent/herdr "$sc" "$@"; }

# --- the holder ----------------------------------------------------------
exec 3> >(G --hold >"$work/hold.out" 2>"$work/hold.err")
holder=$!
for _ in $(seq 1 100); do
    grep -q '^held' "$work/hold.out" 2>/dev/null && break
    sleep 0.05
done
grep -q '^held' "$work/hold.out" 2>/dev/null || { echo "selftest: the holder never took its snapshot; stopping before any arm" >&2; exit 2; }
echo "holder: $(cat "$work/hold.out")  (your clipboard, in memory only)"

finish() {
    local rc=$?
    XDG_STATE_HOME="$state" "$sc" --stop >/dev/null 2>&1
    exec 3>&-
    wait "$holder" 2>/dev/null
    for _ in $(seq 1 100); do [ -s "$work/hold.err" ] && break; sleep 0.05; done
    echo "holder: $(cat "$work/hold.err" 2>/dev/null)"
    echo "result: $pass passed, $fail failed, $skip skipped (work dir $work)"
    if ! grep -q 'digest_identical=yes' "$work/hold.err" 2>/dev/null; then exit 3; fi
    [ "$fail" -eq 0 ] && [ "$rc" -eq 0 ] && exit 0
    exit 1
}
trap finish EXIT

# Arms 1-3 of edge 3/4: a selection over each kind of clipboard comes back
# exactly. The control is changed=yes: the copy really did replace the
# clipboard mid-run, so "identical afterwards" is a real restore.
for kind in rich image multi text empty; do
    G --fixture "$kind"
    before="$(dg)"; c0="$(cc)"
    word="sel$RANDOM$RANDOM"
    out="$(SPEAK_CLIPBOARD_COPY_CMD="printf '%s' 'hello $word' | pbcopy" SC --print --from-pane w0:p0 2>"$work/err")"
    sleep 1.1  # past the guard window
    after="$(dg)"; c1="$(cc)"
    if [ "$out" = "hello $word" ] && grep -q 'source=selection' "$work/err" && [ "$before" = "$after" ] && [ "$c0" != "$c1" ]; then
        ok "selection over a $kind clipboard: text read, clipboard restored (digest $before, changed=yes)"
    else
        bad "selection over a $kind clipboard: out_ok=$([ "$out" = "hello $word" ] && echo y || echo n) $(cat "$work/err") before=$before after=$after cc $c0->$c1"
    fi
done

# Edge 2: nothing highlighted. The copy command writes nothing, so the press
# speaks the clipboard itself and the clipboard is never touched.
G --fixture text
before="$(dg)"; c0="$(cc)"
want="$(LC_ALL=en_AU.UTF-8 pbpaste)"
out="$(SPEAK_CLIPBOARD_COPY_CMD=true SC --print --from-pane w0:p0 --copy-timeout 200 2>"$work/err")"
after="$(dg)"; c1="$(cc)"
if [ "$out" = "$want" ] && grep -q 'grab=unchanged' "$work/err" && [ "$before" = "$after" ] && [ "$c0" = "$c1" ]; then
    ok "nothing highlighted: clipboard spoken, changeCount unmoved ($c0)"
else
    bad "nothing highlighted: $(cat "$work/err") before=$before after=$after cc $c0->$c1"
fi

# Edge 5: errors after the snapshot. (a) the copy command fails, (b) herdr
# is missing (the real path, no injection), (c) an exception right after the
# copy landed: the finally restores, and (c)'s control is that the clipboard
# DID change in between.
for arm in copy-fails herdr-missing fault-after-copy; do
    G --fixture rich
    before="$(dg)"; c0="$(cc)"
    want="$(LC_ALL=en_AU.UTF-8 pbpaste)"
    case "$arm" in
        copy-fails)       out="$(SPEAK_CLIPBOARD_COPY_CMD='exit 7' SC --print --from-pane w0:p0 2>"$work/err")"; expect='why=copy-command-failed' ;;
        herdr-missing)    out="$(SC --print --from-pane w0:p0 2>"$work/err")"; expect='grab=error why=exception' ;;
        fault-after-copy) out="$(SPEAK_CLIPBOARD_COPY_CMD="printf 'zz' | pbcopy" SPEAK_CLIPBOARD_GRAB_ARGS=--fault SC --print --from-pane w0:p0 2>"$work/err")"; expect='restored=1' ;;
    esac
    after="$(dg)"; c1="$(cc)"
    moved=$([ "$c0" != "$c1" ] && echo yes || echo no)
    if [ "$out" = "$want" ] && grep -q -- "$expect" "$work/err" && [ "$before" = "$after" ] && { [ "$arm" != fault-after-copy ] || [ "$moved" = yes ]; }; then
        ok "error $arm: fell back to the clipboard, clipboard intact (changed=$moved)"
    else
        bad "error $arm: $(cat "$work/err") before=$before after=$after changed=$moved"
    fi
done

# Edge 9: unicode and box drawing get the same cleaning as the clipboard path.
G --fixture text
u="$(printf '\xe2\x94\x82 caf\xc3\xa9 \xe2\x80\x9cquoted\xe2\x80\x9d \xe2\x80\x94 it\xe2\x80\x99s \xe2\x94\x82')"
want="$(printf '%s' "$u" | SC --print --stdin)"
out="$(SPEAK_CLIPBOARD_COPY_CMD="printf '%s' '$u' | LC_ALL=en_AU.UTF-8 pbcopy" SC --print --from-pane w0:p0 2>/dev/null)"
if [ -n "$want" ] && [ "$out" = "$want" ]; then ok "unicode selection cleaned the same as --stdin (${#out} chars)"; else bad "unicode: got ${#out} chars, want ${#want}"; fi

# Edge 10 and the double write. (a) a late second write of the SAME text
# (Claude Code's OSC 52 copy landing after the restore) is restored again and
# logged; (b) the control: a late write of OTHER text is someone's fresh copy
# and is kept; (c) a run with no late write logs no guard line at all, so the
# guard does not mistake its own restore for a copy.
: >"$log"
G --fixture rich; before="$(dg)"
SPEAK_CLIPBOARD_COPY_CMD="printf 'twice' | pbcopy; (sleep 0.2; printf 'twice' | pbcopy) >/dev/null 2>&1 &" \
    SC --print --from-pane w0:p0 >/dev/null 2>&1
sleep 1.3
after="$(dg)"
if [ "$before" = "$after" ] && grep -q 'outcome=late-write-restored late_writes=1' "$log"; then
    ok "late second write of the selection: restored again ($(grep -o 'first_after_ms=[0-9.]*' "$log"))"
else
    bad "late second write: before=$before after=$after log=[$(cat "$log")]"
fi
: >"$log"
G --fixture rich
SPEAK_CLIPBOARD_COPY_CMD="printf 'mine' | pbcopy; (sleep 0.2; printf 'yours' | pbcopy) >/dev/null 2>&1 &" \
    SC --print --from-pane w0:p0 >/dev/null 2>&1
sleep 1.3
now="$(LC_ALL=en_AU.UTF-8 pbpaste)"
if [ "$now" = "yours" ] && grep -q 'outcome=foreign-copy-kept' "$log"; then
    ok "late write of other text: kept (a fresh copy is never overwritten)"
else
    bad "late foreign write: clipboard_is_yours=$([ "$now" = yours ] && echo y || echo n) log=[$(cat "$log")]"
fi
: >"$log"
G --fixture rich
SPEAK_CLIPBOARD_COPY_CMD="printf 'once' | pbcopy" SC --print --from-pane w0:p0 >/dev/null 2>&1
sleep 1.3
n="$(grep -c 'mode=guard' "$log")"
if [ "$n" = 0 ] && [ -f "$log" ]; then ok "single write: the guard logged nothing (its own restore is not a copy)"; else bad "single write: $n guard lines"; fi

# Speech arms: need the silent streaming path.
real_cache="${XDG_STATE_HOME:-$HOME/.local/state}/herdr/speak-engine.cache"
engine="$(cut -d'|' -f2 "$real_cache" 2>/dev/null)"
voicek="$(cut -d'|' -f3 "$real_cache" 2>/dev/null)"
if [ "$engine" != say2 ] || ! command -v ffplay >/dev/null 2>&1 || ! command -v say2 >/dev/null 2>&1; then
    skp "press while speaking: the cached engine is '${engine:-none}' or ffplay is missing; --volume 0 would not apply"
    skp "two fast presses: same reason"
    exit 0
fi
printf '%s|%s|%s\n' "$(date +%s)" say2 "$voicek" >"$state/herdr/speak-engine.cache"
long="$(for i in $(seq 1 40); do printf 'This is silent selftest sentence number %s. ' "$i"; done)"

# Edge 1: a press while speaking stops and does nothing else: the copy
# command never runs and the clipboard does not move.
: >"$log"
G --fixture rich; before="$(dg)"; c0="$(cc)"
printf '%s' "$long" | SC --stdin --toggle --volume 0 >/dev/null 2>&1
sleep 0.6
SPEAK_CLIPBOARD_COPY_CMD="touch '$work/copied'; printf x | pbcopy" SC --toggle --from-pane w0:p0 --volume 0 >/dev/null 2>&1
after="$(dg)"; c1="$(cc)"
if grep -q 'outcome=started' "$log" && grep -q 'outcome=stopped' "$log" && [ ! -e "$work/copied" ] && [ "$c0" = "$c1" ] && [ "$before" = "$after" ]; then
    ok "press while speaking: stopped, no keys sent, changeCount unmoved ($c0)"
else
    bad "press while speaking: log=[$(tr '\n' ';' <"$log")] copied=$([ -e "$work/copied" ] && echo y || echo n) cc $c0->$c1"
fi
SC --stop >/dev/null 2>&1

# Edge 7: two presses inside the copy window. The lock lets one through and
# the other logs busy; the copy runs once; one restore, no stale re-write.
: >"$log"
G --fixture rich; before="$(dg)"
cmd="echo x >>'$work/copies'; sleep 0.15; printf 'two presses' | pbcopy"
SPEAK_CLIPBOARD_COPY_CMD="$cmd" SC --toggle --from-pane w0:p0 --volume 0 >/dev/null 2>&1 &
SPEAK_CLIPBOARD_COPY_CMD="$cmd" SC --toggle --from-pane w0:p0 --volume 0 >/dev/null 2>&1 &
wait
sleep 1.3
after="$(dg)"
copies="$(wc -l <"$work/copies" 2>/dev/null | tr -d ' ')"
if grep -q 'outcome=busy' "$log" && grep -q 'outcome=started.*source=selection' "$log" && [ "$copies" = 1 ] && [ "$before" = "$after" ]; then
    ok "two fast presses: one busy, one spoke the selection, one copy, clipboard restored"
else
    bad "two fast presses: log=[$(tr '\n' ';' <"$log")] copies=$copies before=$before after=$after"
fi
SC --stop >/dev/null 2>&1
exit 0
