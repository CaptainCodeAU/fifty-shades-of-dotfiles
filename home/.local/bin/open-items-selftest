printf '#!/bin/sh\necho scanned: 1\nexit 0\n' > "$MC/good"; chmod +x "$MC/good"
mkdir -p "$MC/good.fixtures/pass" "$MC/good.fixtures/fail"; : > "$MC/good.fixtures/pass/a"; : > "$MC/good.fixtures/fail/a"
