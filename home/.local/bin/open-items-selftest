#!/usr/bin/env bash
# open-items-selftest -- proves open-items can tell three different kinds of "nothing",
# and that it finds the RIGHT drawer for the repo you are standing in.
#
# THE CLAIM UNDER TEST is not "it lists items". Listing is the easy half and it fails
# loudly. The claim is that these are never confused, because they look identical in
# any tool that just prints its results:
#
#   a) the projects root is MISSING   -> REFUSED, rc=2, and that is NOT a pass
#   b) this repo has NO MEMORY DIR    -> REFUSED, rc=2 (key wrong, or never a session)
#   c) this project has NO DRAWER     -> rc=1, and it must say which projects do
#   d) a drawer with nothing open     -> rc=1, but a genuinely empty one
#
# And, since 2026-09-19, that the drawer is resolved PER REPO from the harness key:
#
#   e) two fixture repos each resolve to their OWN drawer, and `--all` finds both.
#      One repo has a plain name; the other has a DOT in its name, like `~/.claude`,
#      because `.` -> `-` is the half of the encoding most likely to be got wrong.
#
# Every one of those prints little or nothing on stdout. So every case below asserts
# on the EXIT CODE and on the text, and each "must not appear" arm is twinned with a
# case where the same marker MUST appear. An assertion with no twin proves nothing.
#
# Exit: 0 all passed  |  1 a case failed  |  2 could not run (invalid trial)

set -uo pipefail

TOOL="${OPEN_ITEMS_TOOL:-$(dirname "$0")/$(basename "$0" | sed "s/-selftest//")}"
[ -x "$TOOL" ] || { printf 'selftest: cannot find open-items at %s\n' "$TOOL" >&2; exit 2; }

PASS=0; FAIL=0
ROOT="$(mktemp -d "${TMPDIR:-/tmp}/open-items-selftest.XXXXXX")" || {
    printf 'selftest: mktemp failed -- INVALID TRIAL, not a pass\n' >&2; exit 2; }
# git prints the REAL path of a toplevel (macOS: /tmp -> /private/tmp), and the key
# is computed from that, so the fixture must be keyed from the same resolved path.
ROOT="$(cd "$ROOT" && pwd -P)"

ok(){  PASS=$((PASS+1)); printf '  ok   %s\n' "$1"; }
bad(){ FAIL=$((FAIL+1)); printf '  FAIL %s\n       want: %s\n       got : %s\n' \
        "$1" "$2" "$(printf '%s' "$3" | tr '\n' '|')"; }
want(){    case "$3" in *"$2"*) ok "$1";; *) bad "$1" "contains: $2" "$3";; esac; }
wantnot(){ case "$3" in *"$2"*) bad "$1" "must NOT contain: $2" "$3";; *) ok "$1";; esac; }
wanteq(){  [ "$2" = "$3" ] && ok "$1" || bad "$1" "$2" "$3"; }

# The same encoding the tool uses. Duplicated on purpose: the arm below proves the
# tool's forward match agrees with a key built independently from the repo path.
key(){ printf '%s' "$1" | sed 's#[/._]#-#g'; }

# A fixture: a projects root with two repos, `alpha` (plain name, one open + one done
# item) and `.beta` (dot in the name, one decided item -- case (d): a real drawer
# that is genuinely empty of open work, which must not read like having no drawer).
N=0
mk_fixture(){
    D="$ROOT/case$((++N))"; P="$D/projects"; mkdir -p "$P"
    ALPHA="$D/alpha"; BETA="$D/.beta"
    mkdir -p "$ALPHA/deep/sub" "$BETA"
    git -C "$ALPHA" init -q 2>/dev/null; git -C "$BETA" init -q 2>/dev/null
    AW="$P/$(key "$ALPHA")/memory/WORK"; BW="$P/$(key "$BETA")/memory/WORK"
    mkdir -p "$AW" "$BW"
    cat > "$AW/OPEN.md" <<'EOF'
# alpha -- open items

## W-20260918-01 -- the live one

project: alpha
status: open
size: small
holds-in: research/NEXT.md

Body of the live item.

## W-20260918-02 -- the finished one

project: alpha
status: done
size: small

Body of the finished item.
EOF
    cat > "$BW/OPEN.md" <<'EOF'
# beta -- open items

## W-20260918-03 -- beta's only item, already decided

project: beta
status: decided
size: decision

Body.
EOF
}
run(){    OUT="$(OPEN_ITEMS_PROJECTS_DIR="$P" "$TOOL" "$@" 2>&1)"; RC=$?; return 0; }
run_in(){ local d="$1"; shift; OUT="$(cd "$d" 2>/dev/null && OPEN_ITEMS_PROJECTS_DIR="$P" "$TOOL" "$@" 2>&1)"; RC=$?; return 0; }

printf '\nopen-items-selftest -- fixtures in %s\n\n' "$ROOT"

# ---- the kinds of nothing ----------------------------------------------------
printf 'A  the kinds of nothing\n'
mk_fixture

# (a) MISSING PROJECTS ROOT must REFUSE. A tool that printed "nothing open" here
# would be reporting the absence of a filesystem as the absence of work.
OUT="$(OPEN_ITEMS_PROJECTS_DIR="$ROOT/nope" "$TOOL" --all 2>&1)"; RC=$?
wanteq "a missing projects root REFUSES (rc=2), it does not report 'nothing open'" "2" "$RC"
want   "and says REFUSED out loud" "REFUSED" "$OUT"

# (b) A REPO WITH NO MEMORY DIR AT ALL must REFUSE: the key resolved to nothing the
# harness ever wrote, which is either "never had a session" or "key computed wrong",
# and both deserve a loud answer rather than a quiet miss.
GAMMA="$D/gamma"; mkdir -p "$GAMMA"; git -C "$GAMMA" init -q 2>/dev/null
run_in "$GAMMA"
wanteq "a repo with no harness memory dir REFUSES (rc=2)" "2" "$RC"
want   "and names the memory dir it expected" "$(key "$GAMMA")/memory" "$OUT"

# (c) NO DRAWER FOR THIS PROJECT: rc=1, and it must name the projects that DO have
# one, so the reader can see the search was real.
run --project gamma
wanteq "an unknown project name misses (rc=1)" "1" "$RC"
want   "and names the drawers it did search" "alpha" "$OUT"
want   "and states the denominator"          "searched" "$OUT"
want   "and says a miss is not 'nothing is open'" "not the same as" "$OUT"
# Same fact reached from inside a repo whose memory dir exists but holds no drawer.
DELTA="$D/delta"; mkdir -p "$DELTA" "$P/$(key "$DELTA")/memory"; git -C "$DELTA" init -q 2>/dev/null
run_in "$DELTA"
wanteq "a repo with a memory dir but no drawer misses (rc=1), it does not refuse" "1" "$RC"
want   "and still states the denominator" "searched" "$OUT"

# (d) A REAL DRAWER WITH NOTHING OPEN. Same rc as (c) by design, but the twin proves
# the tool can tell beta's decided item from alpha's open one.
run --project beta
wanteq "a drawer with only closed items misses (rc=1)" "1" "$RC"
run --closed --project beta
wanteq "TWIN --closed finds it (rc=0), so the miss above was a filter not a failure" "0" "$RC"
want   "TWIN and prints the decided item" "W-20260918-03" "$OUT"

# ---- filtering ---------------------------------------------------------------
printf 'B  status filtering\n'
run --project alpha
wanteq "a project with an open item succeeds (rc=0)" "0" "$RC"
want    "prints the open item"         "W-20260918-01" "$OUT"
wantnot "hides the done item"          "W-20260918-02" "$OUT"
run --closed --project alpha
want "TWIN --closed shows the open item too"  "W-20260918-01" "$OUT"
want "TWIN --closed shows the done item"      "W-20260918-02" "$OUT"

# ---- per-repo resolution: one arm per fixture repo -------------------------------
printf 'C  per-repo resolution (plain name, and a dot in the name)\n'
run_in "$ALPHA/deep/sub"
wanteq "alpha: standing in a SUBDIRECTORY resolves the repo's own drawer (rc=0)" "0" "$RC"
want   "alpha: and finds alpha's item"        "W-20260918-01" "$OUT"
wantnot "alpha: and NOT beta's item"          "W-20260918-03" "$OUT"
run_in "$BETA" --closed
wanteq ".beta: a repo with a DOT in its name resolves its own drawer (rc=0)" "0" "$RC"
want   ".beta: and finds beta's item"         "W-20260918-03" "$OUT"
wantnot ".beta: and NOT alpha's item"         "W-20260918-01" "$OUT"
run_in "$BETA" --where
want   ".beta: --where prints the dash-encoded key, dot included" "$(key "$BETA")/memory/WORK/OPEN.md" "$OUT"
# TWIN: outside any git repo it REFUSES rather than guessing a project from the cwd.
run_in "$ROOT"
wanteq "TWIN outside a git repo it refuses rather than guessing (rc=2)" "2" "$RC"
# Linked worktrees resolve to the MAIN repo's drawer, not their own (empty) key.
WT="$D/alpha-wt"; git -C "$ALPHA" -c user.email=t@t -c user.name=t commit -q --allow-empty -m init 2>/dev/null
git -C "$ALPHA" worktree add -q "$WT" -b wt 2>/dev/null
run_in "$WT"
wanteq "a linked worktree resolves the MAIN repo's drawer (rc=0)" "0" "$RC"
want   "and finds alpha's item from inside the worktree" "W-20260918-01" "$OUT"

# ---- scope -------------------------------------------------------------------
printf 'D  scope\n'
run --all
wanteq "--all succeeds when any drawer has open work" "0" "$RC"
want    "--all reaches alpha"                      "W-20260918-01" "$OUT"
wantnot "--all still respects the status filter"   "W-20260918-03" "$OUT"
run --closed --all
want    "TWIN --all --closed reaches beta too"     "W-20260918-03" "$OUT"
run --projects
want "--projects lists alpha" "alpha" "$OUT"
want "--projects lists beta"  "beta"  "$OUT"
want "--projects states the item total" "item(s) total" "$OUT"
want "--projects states 2 drawers" "2 drawer(s)" "$OUT"
# A memory dir that is a SYMLINK (dot-claude's is) must still be found by --all.
EPS="$D/eps"; mkdir -p "$EPS" "$D/elsewhere/WORK"; git -C "$EPS" init -q 2>/dev/null
mkdir -p "$P/$(key "$EPS")"; ln -s "$D/elsewhere" "$P/$(key "$EPS")/memory"
printf '# eps -- open items\n\n## W-20260918-09 -- through a symlink\n\nproject: eps\nstatus: open\n\nBody.\n' > "$D/elsewhere/WORK/OPEN.md"
run --all
want "--all follows a SYMLINKED memory dir" "W-20260918-09" "$OUT"
run_in "$EPS"
wanteq "and the symlinked repo resolves its own drawer (rc=0)" "0" "$RC"

# ---- the session surface -------------------------------------------------------
# It must be SILENT when there is nothing open and LOUD when there is. Silence is the
# whole point (a line that prints every session becomes wallpaper), which is exactly
# why it needs the twin: silence is also what a completely broken surface produces.
printf 'E  the session surface\n'
mk_fixture
run_in "$ALPHA" --session
wanteq "--session exits 0 when there IS open work" "0" "$RC"
want   "--session names the open item"  "the live one" "$OUT"
wantnot "--session hides the done item" "the finished one" "$OUT"
sed -i '' 's/^status: open$/status: done/' "$AW/OPEN.md" 2>/dev/null \
  || sed -i 's/^status: open$/status: done/' "$AW/OPEN.md" 2>/dev/null
run_in "$ALPHA" --session
wanteq "TWIN with nothing open it is silent, and still exits 0" "0" "$RC"
wanteq "TWIN and prints literally nothing" "" "$OUT"
# A MISSING ROOT MUST ALSO BE SILENT AND EXIT 0 HERE, unlike every other arm.
OUT="$(cd "$ALPHA" && OPEN_ITEMS_PROJECTS_DIR="$ROOT/nope" "$TOOL" --session 2>&1)"; RC=$?
wanteq "a missing projects root does not break a session start (rc=0)" "0" "$RC"
wanteq "and says nothing there either" "" "$OUT"


# ==============================================================================
# The items/ layout (P5.1, D-20260920-05 and -08): every command, atomic IDs,
# commits by explicit path, the drawer that must NOT be committed, a failed commit
# that must not lose the write, hand-edit rescue, migration, and a mixed machine.
# ==============================================================================
# A fixture "dot-claude": a git repo whose projects/ is the projects root, so a
# drawer inside it is committable and one symlinked elsewhere is not.
mk_dotclaude(){
    D="$ROOT/case$((++N))"; DC="$D/dotclaude"; P="$DC/projects"; mkdir -p "$P"
    git -C "$DC" init -q 2>/dev/null
    git -C "$DC" config user.email t@t; git -C "$DC" config user.name t
    # Mirror the real dot-claude .gitignore: the global MEMORY/ rule would otherwise
    # swallow memory/ (core.ignorecase), and a commit of nothing would look like success.
    printf 'projects/*\n!projects/*/\nprojects/*/*\n!projects/*/memory/\n!projects/*/memory\n' > "$DC/.gitignore"
    git -C "$DC" add .gitignore
    git -C "$DC" -c commit.gpgsign=false commit -q --allow-empty -m init 2>/dev/null
    ZETA="$D/zeta"; mkdir -p "$ZETA"; git -C "$ZETA" init -q 2>/dev/null
    ZW="$P/$(key "$ZETA")/memory/WORK"; mkdir -p "$ZW"
}
runw(){ local d="$1"; shift; OUT="$(cd "$d" 2>/dev/null && OPEN_ITEMS_PROJECTS_DIR="$P" OPEN_ITEMS_DOTCLAUDE="$DC" CLAUDE_CODE_SESSION_ID=sess-test CLAUDE_SESSION_ID=sess-test "$TOOL" "$@" 2>&1)"; RC=$?; return 0; }
TODAY="$(date +%Y%m%d)"
# IDs come from pj-id (P5.5, letters since P8a). Pin a FIXTURE machine file so this box's
# real letter (~/.config/pj/machine) never shifts the -A01/-A02 numbers these arms expect,
# and so the suite passes on a machine whose real file does not exist yet (B, C, D on day
# one). Pointing at an absent file is no longer an option: pj-id REFUSES without a letter.
printf 'name: selftest-fixture\nletter: A\n' > "$D/machine-A"
export PJ_MACHINE_FILE="$D/machine-A"
committed(){ [ -z "$(git -C "$DC" status --porcelain -- "$1" 2>/dev/null)" ] && git -C "$DC" ls-files --error-unmatch -- "$1" >/dev/null 2>&1; }

printf 'F  commands on the items/ layout\n'
mk_dotclaude
runw "$ZETA" add "no drawer yet" --done-when x
wanteq "add before init REFUSES (rc=2): a project with no items/ is never written" "2" "$RC"
runw "$ZETA" init
wanteq "init creates items/ and commits (rc=0)" "0" "$RC"
wanteq "init: OPEN.md generated" "1" "$([ -f "$ZW/OPEN.md" ] && echo 1)"
want   "init: OPEN.md carries the do-not-edit header" "DO NOT EDIT" "$(cat "$ZW/OPEN.md")"
# W-20260921-A15: an EMPTY drawer must still name its repo. Before the stamp,
# name_of had nothing to read but the harness's encoded directory key, so two
# projects announced "nothing open for <the encoded key>" the day their drawers
# were created -- which reads as a broken tool, not an empty drawer. The arms
# are: the stamp exists, the LISTING shows the repo name, and -- the one that
# matters -- the encoded key does NOT appear anywhere in it.
wanteq "init: items/.project stamps the repo name" "zeta" "$(cat "$ZW/items/.project" 2>/dev/null)"
runw "$ZETA"
want    "empty drawer names the repo, not the encoded key" "zeta" "$OUT"
wantnot "empty drawer never prints the encoded harness key" "$(key "$ZETA")" "$OUT"
runw "$ZETA" add "first thing" --done-when "it is done" --size small --holds-in repo:README.md --body "Body text."
wanteq "add succeeds (rc=0)" "0" "$RC"
want   "add prints the new ID" "W-$TODAY-A01" "$OUT"
F1="$ZW/items/open/W-$TODAY-A01.md"
wanteq "add: the file lands in items/open/" "1" "$([ -f "$F1" ] && echo 1)"
want   "add: status open written"      "status: open"          "$(cat "$F1")"
want   "add: kind defaults to do"      "kind: do"              "$(cat "$F1")"
want   "add: done-when written"        "done-when: it is done" "$(cat "$F1")"
# W-20260921-A15: the project: line names the REPO, never the encoded harness key.
# This is the arm that matters, because a wrong value here is PERMANENT: name_of
# reads the first item back and agrees with itself from then on.
want    "add: project: names the repo"            "project: zeta"  "$(cat "$F1")"
wantnot "add: project: is never the encoded key"  "$(key "$ZETA")" "$(cat "$F1")"
# W-20260921-A15 CONTROL, two directions.
#
# (1) The stamp WINS, because it is the only source not derived from an earlier
#     guess. Poison it and the poison must show. Without this arm, "the listing
#     says zeta" is equally true if the stamp is read first, read last, or never
#     read at all -- the drawer says zeta in every one of those worlds.
cp "$ZW/items/.project" "$ZW/items/.project.bak8b"
printf 'POISONED-STAMP\n' > "$ZW/items/.project"
runw "$ZETA"
want "CONTROL: the stamp is read FIRST, ahead of the item's project: line" "POISONED-STAMP" "$OUT"
# (2) With no stamp at all, the older sources must still work: a drawer nobody
#     stamped still finds its name in the filed item.
command mv "$ZW/items/.project" "$ZW/items/.project.gone8b"
runw "$ZETA"
want "CONTROL: with no stamp, the item's project: line is still read" "zeta" "$OUT"
command mv "$ZW/items/.project.bak8b" "$ZW/items/.project"
want   "add: raised filled by the tool with date and session" "raised: $(date +%Y-%m-%d) (session sess-test)" "$(cat "$F1")"
want   "add: body kept"                "Body text."            "$(cat "$F1")"
wanteq "add: the item file is COMMITTED" "1" "$(committed "projects/$(key "$ZETA")/memory/WORK/items/open/W-$TODAY-A01.md" && echo 1)"
want   "add: the commit names the item by explicit path" "items/open/W-$TODAY-A01.md" "$(git -C "$DC" show --stat --name-only HEAD)"
want   "add: OPEN.md regenerated with the item" "first thing" "$(cat "$ZW/OPEN.md")"
runw "$ZETA" add "second thing" --done-when y --kind decide
want   "add: the next ID is -02" "W-$TODAY-A02" "$OUT"
printf 'name: other-box\nletter: B\n' > "$D/machine-B"
PJ_MACHINE_FILE="$D/machine-B" runw "$ZETA" add "from the other machine" --done-when z
want   "add: a machine file with letter B claims -B01, not -A03 (cross-machine IDs, P8a)" "W-$TODAY-B01" "$OUT"
wanteq "add: the -B01 item file exists" "1" "$([ -f "$ZW/items/open/W-$TODAY-B01.md" ] && echo 1)"
wanteq "add: machine A's own numbering is untouched by B's claim" "1" "$([ ! -f "$ZW/items/open/W-$TODAY-A03.md" ] && echo 1)"
# NO MACHINE FILE = NO ID. A default letter would put another machine's name on this
# machine's work, so the tool refuses instead (P8a gate Q6).
PJ_MACHINE_FILE="$D/no-machine-file" runw "$ZETA" add "no letter for this box" --done-when q
wanteq "add with NO machine file REFUSES (rc=2): no default letter exists" "2" "$RC"
want   "and the refusal names install.sh" "install.sh" "$OUT"
# THE REQUIRED-FIELD REFUSAL, with the passing control right above it.
runw "$ZETA" add "no finish line"
wanteq "add WITHOUT --done-when REFUSES (rc=2)" "2" "$RC"
want   "and says which field" "done-when" "$OUT"
wanteq "and creates NO file (control: -A01, -A02 and -B01 exist)" "3" "$(ls "$ZW/items/open" | grep -c '^W-')"
runw "$ZETA" add "bad size" --done-when z --kind decide --size small
wanteq "add: --size on a decide item REFUSES (rc=2)" "2" "$RC"
runw "$ZETA" add "bad root" --done-when z --holds-in docs/x.md
wanteq "add: holds-in without a root marker REFUSES (rc=2)" "2" "$RC"
want   "and names the markers" "repo:" "$OUT"
runw "$ZETA" close "W-$TODAY-A01" "finished it"
wanteq "close succeeds (rc=0)" "0" "$RC"
wanteq "close: file moved to items/closed/" "1" "$([ -f "$ZW/items/closed/W-$TODAY-A01.md" ] && [ ! -f "$F1" ] && echo 1)"
want   "close: status done"   "status: done" "$(cat "$ZW/items/closed/W-$TODAY-A01.md")"
want   "close: note appended" "finished it"  "$(cat "$ZW/items/closed/W-$TODAY-A01.md")"
wanteq "close: committed (old path gone from the index too)" "0" "$(git -C "$DC" status --porcelain | wc -l | tr -d ' ')"
runw "$ZETA" park "W-$TODAY-A02"
wanteq "park: file in items/parked/ with status parked" "1" "$(grep -q '^status: parked$' "$ZW/items/parked/W-$TODAY-A02.md" && echo 1)"
runw "$ZETA" reopen "W-$TODAY-A02"
wanteq "reopen: back in items/open/ with status open" "1" "$(grep -q '^status: open$' "$ZW/items/open/W-$TODAY-A02.md" && echo 1)"
runw "$ZETA" decline "W-$TODAY-A02" "not doing it"
wanteq "decline: in items/closed/ with status declined" "1" "$(grep -q '^status: declined$' "$ZW/items/closed/W-$TODAY-A02.md" && echo 1)"
runw "$ZETA" add "third thing" --done-when q
# LEGACY ID RESOLUTION (P8a gate Q1). ~230 references to the pre-letter shape survive in
# reports and handoffs; one typed from there must land, not read as "no such item".
runw "$ZETA" set "W-$TODAY-03" next "typed the old way"
wanteq "set with a pre-P8a bare ID resolves to the letter form (rc=0)" "0" "$RC"
want   "  and SAYS it resolved, naming the real ID" "resolved to W-$TODAY-A03" "$OUT"
want   "  and the value landed in the A03 file" "next: typed the old way" "$(cat "$ZW/items/open/W-$TODAY-A03.md")"
wanteq "  and NO bare-NN file was created (the old ID is a lookup, never a new item)" "1" "$([ ! -e "$ZW/items/open/W-$TODAY-03.md" ] && echo 1)"
# AMBIGUITY REFUSES. -A01 (closed) and -B01 (open) both answer to a bare -01, so guessing
# would silently edit one machine's item while you meant the other's.
runw "$ZETA" set "W-$TODAY-01" next "which one?"
wanteq "an ambiguous legacy ID REFUSES (rc=2) rather than guessing" "2" "$RC"
want   "  and names every candidate" "W-$TODAY-A01" "$OUT"
want   "  and the other candidate too" "W-$TODAY-B01" "$OUT"
# The refusal must be the LAST word. It used to be followed by "no item <id>", which is
# false and is the line a reader keeps.
wantnot "  and is NOT contradicted by a 'no item' line after it" "no item" "$OUT"
# NEGATIVE CONTROL: a legacy ID matching nothing still misses, so the fallback did not
# turn every typo into a hit.
runw "$ZETA" set "W-$TODAY-77" next "nobody"
wanteq "a legacy ID matching no item still REFUSES (rc=2)" "2" "$RC"
runw "$ZETA" set "W-$TODAY-A03" done-when "a better finish line"
wanteq "set replaces a field (rc=0)" "0" "$RC"
want   "set: new value present" "done-when: a better finish line" "$(cat "$ZW/items/open/W-$TODAY-A03.md")"
wanteq "set: old value gone" "1" "$(grep -c '^done-when:' "$ZW/items/open/W-$TODAY-A03.md")"
runw "$ZETA" set "W-$TODAY-A03" next "run the thing"
want   "set adds a field that was absent, inside the header" "next: run the thing" "$(sed -n '2,12p' "$ZW/items/open/W-$TODAY-A03.md")"
runw "$ZETA" set "W-$TODAY-A03" status done
wanteq "set status REFUSES (rc=2); status moves through close/park/decline/reopen" "2" "$RC"
# holds-in may repeat, one marked path per line (P5.3, ruled at the P5.2 gate).
runw "$ZETA" add "two homes" --done-when h --holds-in repo:docs/a.md --holds-in "~/.local/bin/b"
F4="$ZW/items/open/W-$TODAY-A04.md"
wanteq "add with --holds-in twice writes two lines (rc=0)" "0" "$RC"
wanteq "  two holds-in lines" "2" "$(grep -c '^holds-in:' "$F4")"
wanteq "  in the order given" "holds-in: repo:docs/a.md|holds-in: ~/.local/bin/b" "$(grep '^holds-in:' "$F4" | tr '\n' '|' | sed 's/|$//')"
runw "$ZETA" add "bad second home" --done-when h --holds-in repo:ok.md --holds-in docs/bare.md
wanteq "add REFUSES when any --holds-in lacks a marker (rc=2)" "2" "$RC"
runw "$ZETA" set "W-$TODAY-A04" holds-in drawer:x.md drawer:y.md
wanteq "set holds-in with two values (rc=0)" "0" "$RC"
wanteq "  replaces the whole set: two lines" "2" "$(grep -c '^holds-in:' "$F4")"
wantnot "  old value gone" "repo:docs/a.md" "$(cat "$F4")"
want    "  new value present, inside the header" "holds-in: drawer:y.md" "$(sed -n '2,12p' "$F4")"
runw "$ZETA" set --add "W-$TODAY-A04" holds-in repo:z.md
wanteq "set --add holds-in appends (rc=0)" "0" "$RC"
wanteq "  three lines now" "3" "$(grep -c '^holds-in:' "$F4")"
wanteq "  appended after the existing ones" "drawer:x.md|drawer:y.md|repo:z.md" "$(sed -n 's/^holds-in: //p' "$F4" | tr '\n' '|' | sed 's/|$//')"
want   "  raised still last in the header (control)" "raised:" "$(awk 'NR>2 && /^$/{exit} NR>2{l=$0} END{print l}' "$F4")"
runw "$ZETA" set --add "W-$TODAY-A04" next "x"
wanteq "set --add on a single-valued field REFUSES (rc=2)" "2" "$RC"
runw "$ZETA" set "W-$TODAY-A04" next "a" "b"
wanteq "set with two values on a single-valued field REFUSES (rc=2)" "2" "$RC"
runw "$ZETA" set "W-$TODAY-A04" holds-in bare/path.md
wanteq "set holds-in without a marker REFUSES (rc=2)" "2" "$RC"
wanteq "  and the file keeps its three lines (control)" "3" "$(grep -c '^holds-in:' "$F4")"
# the session id the harness really sets is CLAUDE_CODE_SESSION_ID (P5.3); the old name stays as a fallback
OUT="$(cd "$ZETA" && OPEN_ITEMS_PROJECTS_DIR="$P" OPEN_ITEMS_DOTCLAUDE="$DC" CLAUDE_CODE_SESSION_ID=cc-real CLAUDE_SESSION_ID=sess-test "$TOOL" add "real id" --done-when i 2>&1)"; RC=$?
want   "raised uses CLAUDE_CODE_SESSION_ID when set" "(session cc-real)" "$(cat "$ZW/items/open/W-$TODAY-A05.md")"
runw "$ZETA" decline "W-$TODAY-A04" "test"; runw "$ZETA" decline "W-$TODAY-A05" "test"
runw "$ZETA" close "W-$TODAY-A99"
wanteq "close of an unknown ID REFUSES (rc=2)" "2" "$RC"
runw "$ZETA" --closed
want   "listing --closed shows done, declined and open together" "W-$TODAY-A01" "$OUT"
want   "  ..." "W-$TODAY-A03" "$OUT"
runw "$ZETA" --status declined
want    "--status declined shows the declined one" "W-$TODAY-A02" "$OUT"
wantnot "and not the open one" "W-$TODAY-A03" "$OUT"
runw "$ZETA"
wanteq "default listing shows only open (rc=0)" "0" "$RC"
wantnot "default hides the declined item" "W-$TODAY-A02" "$OUT"
runw "$ZETA" --session
want   "--session on items/ layout names the open item" "third thing" "$OUT"
runw "$ZETA" park "W-$TODAY-A03"
runw "$ZETA" --session
want   "--session with only a parked item prints the parked count" "parked: 1" "$OUT"
wantnot "and no title" "third thing" "$OUT"
runw "$ZETA" --help
wanteq "--help opens with usage in under 25 lines (was 71)" "1" "$([ "$(printf '%s\n' "$OUT" | wc -l | tr -d ' ')" -lt 25 ] && echo 1)"
want   "--help lists add" "open-items add" "$OUT"
want   "--help points at the doc" "docs/OPEN_ITEMS.md" "$OUT"

printf 'G  two writers at once\n'
mk_dotclaude
runw "$ZETA" init
i=0; while [ $i -lt 20 ]; do i=$((i+1))
  ( cd "$ZETA" && OPEN_ITEMS_PROJECTS_DIR="$P" OPEN_ITEMS_DOTCLAUDE="$DC" "$TOOL" add "parallel $i" --done-when x >/dev/null 2>&1 ) &
done; wait
IDS="$(ls "$ZW/items/open" | grep '^W-' | sort -u | wc -l | tr -d ' ')"
wanteq "20 concurrent adds produce 20 DISTINCT IDs (files)" "20" "$IDS"
wanteq "and 20 distinct titles survived (no file overwritten)" "20" "$(cat "$ZW/items/open"/W-*.md | grep -c '^## W-.* -- parallel ')"
wanteq "and every one of the 20 is COMMITTED (clean tree under the drawer)" "0" "$(git -C "$DC" status --porcelain -- "projects/$(key "$ZETA")" | wc -l | tr -d ' ')"
wanteq "and all 20 are in the index" "20" "$(git -C "$DC" ls-files -- "projects/$(key "$ZETA")/memory/WORK/items/open" | wc -l | tr -d ' ')"
wanteq "and the lock was released" "1" "$([ ! -e "$ZW/items/.lock" ] && echo 1)"

printf 'H  a mixed machine: one legacy drawer, one items/ drawer\n'
mk_dotclaude
LEG="$D/legacy"; mkdir -p "$LEG"; git -C "$LEG" init -q 2>/dev/null
LW="$P/$(key "$LEG")/memory/WORK"; mkdir -p "$LW"
printf '# legacy -- open items\n\n## W-20260918-05 -- the legacy one\n\nproject: legacy\nstatus: open\nsize: small\n\nBody.\n' > "$LW/OPEN.md"
runw "$ZETA" init; runw "$ZETA" add "the new one" --done-when x
runw "$ZETA" --all
want   "--all reaches the legacy drawer"  "the legacy one" "$OUT"
want   "--all reaches the items/ drawer"  "the new one"    "$OUT"
want   "--all counts both"                "2 drawer(s)"    "$OUT"
runw "$ZETA" --projects
want   "--projects labels the legacy layout" "legacy	$LW/OPEN.md	legacy" "$OUT"
want   "--projects labels the items layout"  "	items" "$OUT"
runw "$LEG"
wanteq "standing in the legacy repo reads its OPEN.md unchanged (rc=0)" "0" "$RC"
want   "  and finds its item" "W-20260918-05" "$OUT"
runw "$LEG" --session
want   "legacy --session still prints the title" "the legacy one" "$OUT"
runw "$LEG" add "into a legacy drawer" --done-when x
wanteq "add into a LEGACY drawer REFUSES (rc=2): it stays as it is" "2" "$RC"
want   "  and says why" "legacy" "$OUT"
wanteq "  and the legacy OPEN.md is byte-identical (control: zeta's changed)" "1" "$(grep -q 'into a legacy' "$LW/OPEN.md" || echo 1)"

printf 'I  the symlinked drawer that must NOT be committed\n'
mk_dotclaude
ETA="$D/eta"; mkdir -p "$ETA" "$D/elsewhere/WORK"; git -C "$ETA" init -q 2>/dev/null
mkdir -p "$P/$(key "$ETA")"; ln -s "$D/elsewhere" "$P/$(key "$ETA")/memory"
runw "$ETA" init
wanteq "init through a symlink OUTSIDE dot-claude: written, NOT committed (rc=3)" "3" "$RC"
want   "  and says so out loud" "NOT COMMITTED, outside dot-claude" "$OUT"
runw "$ETA" add "outside" --done-when x
wanteq "add there: rc=3" "3" "$RC"
wanteq "  the file IS written" "1" "$([ -f "$D/elsewhere/WORK/items/open/W-$TODAY-A01.md" ] && echo 1)"
wanteq "  and dot-claude got NO commit for it (control: zeta's add commits)" "0" "$(git -C "$DC" log --oneline | grep -c 'add W-')"
runw "$ZETA" init; runw "$ZETA" add "inside" --done-when x
wanteq "  control: the in-tree drawer's add IS committed" "1" "$(git -C "$DC" log --oneline | grep -c 'add W-')"

printf 'J  a failed commit never loses the write\n'
mk_dotclaude
runw "$ZETA" init
printf '#!/bin/sh\nexit 1\n' > "$DC/.git/hooks/pre-commit"; chmod +x "$DC/.git/hooks/pre-commit"
runw "$ZETA" add "survives" --done-when x
wanteq "commit refused by a hook: rc=3, not 0 and not 2" "3" "$RC"
want   "  and says COMMIT FAILED" "COMMIT FAILED" "$OUT"
wanteq "  the item file is on disk" "1" "$([ -f "$ZW/items/open/W-$TODAY-A01.md" ] && echo 1)"
wanteq "  and OPEN.md was still regenerated" "1" "$(grep -q survives "$ZW/OPEN.md" && echo 1)"
mv "$DC/.git/hooks/pre-commit" "$DC/.git/hooks/pre-commit.off"
runw "$ZETA" add "next write" --done-when x
wanteq "the next write commits (rc=0)" "0" "$RC"
wanteq "  and carries the earlier uncommitted item with it" "2" "$(git -C "$DC" ls-files -- "projects/$(key "$ZETA")/memory/WORK/items/open" | wc -l | tr -d ' ')"
# (2a) a stale index.lock is retried, not fatal.
touch "$DC/.git/index.lock"; ( sleep 1; rmdir "$DC/.git/index.lock" 2>/dev/null || command mv "$DC/.git/index.lock" "$DC/.git/index.lock.gone" ) &
runw "$ZETA" add "through a lock" --done-when x
wanteq "a transient index.lock is waited out (rc=0)" "0" "$RC"
wait

printf 'K  hand edits are rescued, never discarded\n'
mk_dotclaude
runw "$ZETA" init; runw "$ZETA" add "one" --done-when x
printf '\n## W-20260920-77 -- typed straight into OPEN.md\n\nproject: zeta\nstatus: open\n\nhand text\n' >> "$ZW/OPEN.md"
runw "$ZETA" add "two" --done-when x
want   "a hand-edited OPEN.md triggers a WARNING naming the rescue file" "hand-edit-rescued" "$OUT"
RES="$(ls "$ZW/items/notes"/*hand-edit-rescued.md 2>/dev/null | head -1)"
wanteq "  the rescue file exists" "1" "$([ -n "$RES" ] && [ -f "$RES" ] && echo 1)"
want   "  and holds the hand-typed text" "hand text" "$(cat "${RES:-/nonexistent}" 2>/dev/null)"
wantnot "  and OPEN.md was regenerated without the hand block as an item" "typed straight into OPEN.md\n\nproject" "$(sed -n '1,12p' "$ZW/OPEN.md")"
wanteq "  and the rescue file is committed" "1" "$(committed "projects/$(key "$ZETA")/memory/WORK/items/notes/$(basename "$RES")" && echo 1)"
NRES="$(ls "$ZW/items/notes" | grep -c rescued)"
runw "$ZETA" add "three" --done-when x
wantnot "CONTROL: an untouched OPEN.md raises no warning" "hand-edit-rescued" "$OUT"
wanteq  "CONTROL: and no new rescue file" "$NRES" "$(ls "$ZW/items/notes" | grep -c rescued)"
want   "regen: OPEN.md lists every item" "three" "$(cat "$ZW/OPEN.md")"
wanteq "regen: exactly one generated header" "1" "$(grep -c 'GENERATED by open-items' "$ZW/OPEN.md")"
printf 'stale\n' > "$ZW/OPEN.md"
runw "$ZETA" regen
wanteq "regen rebuilds a stale OPEN.md (rc=0)" "0" "$RC"
want   "  which now holds the items again" "W-$TODAY-A03" "$(cat "$ZW/OPEN.md")"
wanteq "  control: the stale text is gone" "0" "$(grep -c '^stale$' "$ZW/OPEN.md")"

printf 'L  migrate: legacy OPEN.md -> items/\n'
mk_dotclaude
cat > "$ZW/OPEN.md" <<'EOF'
# zeta -- open items

> old header line

## W-20260901-01 -- a done task

project: zeta
status: done
size: small
holds-in: sub/NOTE.md

Done body.

## Re-verification pass -- not an item

Free text here.

## W-20260902-01 -- a decision with a finish line

project: zeta
status: open
size: decision
holds-in: README.md (top)

Body one.

**Done when:** the ruling is recorded
and this item is closed.

Trailing paragraph.

## W-20260903-01 -- a programme, parked

project: zeta
status: open
size: programme

Body three.
EOF
mkdir -p "$ZW/sub"; touch "$ZW/sub/NOTE.md" "$ZETA/README.md"
SCR="$D/scratch"
runw "$ZETA" migrate --dry-run --into "$SCR" --park W-20260903-01
wanteq "migrate --dry-run succeeds (rc=0)" "0" "$RC"
wanteq "  and leaves the drawer legacy (no items/)" "1" "$([ ! -d "$ZW/items" ] && echo 1)"
wanteq "  and commits nothing" "1" "$(git -C "$DC" log --oneline | wc -l | tr -d ' ')"
wanteq "  scratch: done item in closed/" "1" "$([ -f "$SCR/items/closed/W-20260901-01.md" ] && echo 1)"
wanteq "  scratch: parked item in parked/" "1" "$([ -f "$SCR/items/parked/W-20260903-01.md" ] && echo 1)"
want   "  scratch: size decision -> kind decide" "kind: decide" "$(cat "$SCR/items/open/W-20260902-01.md")"
wanteq "  scratch: and no size on it" "0" "$(grep -c '^size:' "$SCR/items/open/W-20260902-01.md")"
want   "  scratch: programme -> large" "size: large" "$(cat "$SCR/items/parked/W-20260903-01.md")"
want   "  scratch: Done when paragraph lifted, joined" "done-when: the ruling is recorded and this item is closed." "$(cat "$SCR/items/open/W-20260902-01.md")"
want   "  scratch: legacy done-when marked, not invented" "done-when: not stated (legacy)" "$(cat "$SCR/items/closed/W-20260901-01.md")"
want   "  scratch: raised from the ID date, not today" "raised: 2026-09-01 (legacy" "$(cat "$SCR/items/closed/W-20260901-01.md")"
want   "  scratch: holds-in resolved to drawer:" "holds-in: drawer:sub/NOTE.md" "$(cat "$SCR/items/closed/W-20260901-01.md")"
want   "  scratch: holds-in resolved to repo:, suffix kept" "holds-in: repo:README.md (top)" "$(cat "$SCR/items/open/W-20260902-01.md")"
want   "  scratch: body kept verbatim" "Trailing paragraph." "$(cat "$SCR/items/open/W-20260902-01.md")"
wanteq "  scratch: non-block section became a note" "1" "$(ls "$SCR/items/notes" | grep -c 're-verification')"
want   "  scratch: preamble preserved as a note" "old header line" "$(cat "$SCR/items/notes/legacy-OPEN-header.md")"
runw "$ZETA" migrate --park W-20260903-01
wanteq "migrate for real (rc=0)" "0" "$RC"
wanteq "  items/ now exists and OPEN.md is generated" "1" "$([ -d "$ZW/items/open" ] && grep -q 'GENERATED' "$ZW/OPEN.md" && echo 1)"
want   "  the generated view still carries every block" "W-20260903-01" "$(cat "$ZW/OPEN.md")"
wanteq "  and it is committed (items/ and OPEN.md clean)" "0" "$(git -C "$DC" status --porcelain -- "projects/$(key "$ZETA")/memory/WORK/items" "projects/$(key "$ZETA")/memory/WORK/OPEN.md" | wc -l | tr -d ' ')"
runw "$ZETA" migrate
wanteq "migrate twice REFUSES (rc=2)" "2" "$RC"
wanteq "migrate does not rescue its own source as a hand edit (control: arm K rescues)" "0" "$(ls "$ZW/items/notes" | grep -c rescued)"
runw "$ZETA" --session
want   "--session after migrate: open title" "a decision with a finish line" "$OUT"
want   "  and parked count" "parked: 1" "$OUT"

printf '\n%s passed, %s failed   (fixtures: %s)\n' "$PASS" "$FAIL" "$ROOT"
[ "$FAIL" -eq 0 ] || { printf 'open-items-selftest: FAILURES above\n' >&2; exit 1; }
printf 'open-items-selftest: all arms pass\n'
exit 0
