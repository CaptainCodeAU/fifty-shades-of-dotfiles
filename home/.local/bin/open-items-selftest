printf '\nG  a REFUSED drawer write is not a held lock (W-20260921-A44)\n'
# The bug: `mkdir "$LOCK"` fails for two completely different reasons -- the lock is held,
# or the folder is not writable -- and open-items read both as the first. Sandboxed, it
# span for 60 seconds and then blamed "pid ?" for a lock file that did not exist.
#
# The fixture is a chmod, not the sandbox, so the arm runs the same in both modes. Three
# arms in order, because the refusal is an ABSENCE of a write and an absence needs both
# sides: it must work, then fail for the right reason, then work again.
runw "$ZETA" add "A44 positive arm before" --done-when x
wanteq "  control: the drawer is writable and an add succeeds (rc=0)" "0" "$RC"
chmod 500 "$ZW/items" 2>/dev/null
A44_S=$(date +%s)
runw "$ZETA" add "A44 refused arm" --done-when x
A44_E=$(date +%s)
wanteq "  an unwritable drawer REFUSES (rc=2)" "2" "$RC"
want   "  the refusal names the denied path" "$ZW/items/.lock" "$OUT"
want   "  and names WRITE permission as the cause" "WRITE permission" "$OUT"
want   "  and says nothing was changed" "Nothing was changed" "$OUT"
case "$OUT" in
  *"held by pid"*) bad "  and does NOT blame a pid for holding the lock" "no 'held by pid'" "$OUT" ;;
  *) ok "  and does NOT blame a pid for holding the lock" ;;
esac
# The 60 seconds were the actual cost of this bug, so the arm measures them.
if [ $(( A44_E - A44_S )) -lt 10 ]; then ok "  and refuses at once, not after the 60s spin ($(( A44_E - A44_S ))s)"
else bad "  and refuses at once, not after the 60s spin" "<10s" "$(( A44_E - A44_S ))s"; fi
chmod 700 "$ZW/items" 2>/dev/null
runw "$ZETA" add "A44 positive arm after" --done-when x
wanteq "  control: with the permission back, an add succeeds again (rc=0)" "0" "$RC"
# The lock must not be left behind by any of the three.
wanteq "  no lock directory left behind" "0" "$([ -d "$ZW/items/.lock" ] && echo 1 || echo 0)"

printf '\nH  every `## W-` header starts its own line, across a drawer boundary (X0)\n'
# THE BUG: `hits="$(blocks_from ...)"` strips every trailing newline, and report() then
# printed it with a bare `printf '%s'`. The next drawer's first line, a `## W-` header,
# landed on the previous drawer's last body line. Two real headers were lost that way on
# 2026-09-22 and anything reading the output line by line lost the items with them.
#
# THE MEASUREMENT IS A DIFFERENCE, not a count: headers that START a line versus headers
# ANYWHERE. Those two numbers are equal in a healthy run and equal in a run that produced
# no output at all, so the arm below is worthless without the two controls that follow it.
#
# KNOWN LIMIT OF THE INSTRUMENT, stated because it decides how the arms are written:
# the "anywhere" arm counts the literal `## W-` wherever it falls, so a fixture whose
# BODY quoted a header mid-line would read as a glue that is not there. The arms below
# therefore never trust "anywhere" alone. The real assertion compares at-line-start
# against the number of item FILES in the fixture, a denominator drawn from the
# filesystem rather than from the text being measured, and "anywhere" is kept only for
# the negative control that proves the instrument can see a glue at all.
glue_count(){                   # glue_count <text> -> "<anywhere> <atstart>"
    printf '%s\n' "$1" | awk '
      { n = 0; s = $0; while ((i = index(s, "## W-")) > 0) { n++; s = substr(s, i + 5) }
        anywhere += n; if ($0 ~ /^## W-/) atstart++ }
      END { printf "%d %d", anywhere + 0, atstart + 0 }'
}
# `set --` would clobber the script's own positional parameters for every arm that came
# after, and under `set -u` an empty capture would abort the run at "$1" instead of
# failing an arm. Two named variables, filled in one read, do neither.
X0_ANY=0; X0_AT=0
measure(){ read -r X0_ANY X0_AT <<<"$(glue_count "$1")"; }

D="$ROOT/caseX0"; P="$D/projects"
export PJ_ID_CLAIMS_DIR="$D/claims"   # per case: a claim never leaks between cases, never the real folder
# Two drawers. The glob in all_drawers() is sorted, so `-x0-aaa` is printed first and
# `-x0-bbb`'s header is the one that used to glue onto aaa's last line.
#
# aaa holds THREE items, and the newline-less file sits in the MIDDLE and at the END.
# Both placements are deliberate. The pre-X0 bug was first blamed on a file saved
# without its last byte, so the fixture has to put that file everywhere it could
# matter: mid-drawer, where blocks_raw's own '\n' absorbs it, and last, where it meets
# the drawer boundary. A fixture that only tested the last slot would leave the
# mid-drawer case looking untested and assumed safe.
X0A="$P/-x0-aaa/memory/WORK/items/open"; X0B="$P/-x0-bbb/memory/WORK/items/open"
mkdir -p "$X0A" "$X0B"
printf 'x0-aaa\n' > "$P/-x0-aaa/memory/WORK/items/.project"
printf 'x0-bbb\n' > "$P/-x0-bbb/memory/WORK/items/.project"
printf '## W-20260101-A01 -- aaa first, file ends with a newline\n\nproject: x0-aaa\nstatus: open\nkind: do\ndone-when: x\n' > "$X0A/W-20260101-A01.md"
printf '## W-20260101-A02 -- aaa MIDDLE, file ends WITHOUT a newline\n\nproject: x0-aaa\nstatus: open\nkind: do\ndone-when: x'  > "$X0A/W-20260101-A02.md"
printf '## W-20260101-A03 -- aaa LAST, file ends WITHOUT a newline\n\nproject: x0-aaa\nstatus: open\nkind: do\ndone-when: x'    > "$X0A/W-20260101-A03.md"
printf '## W-20260101-B01 -- bbb, the header that used to glue\n\nproject: x0-bbb\nstatus: open\nkind: do\ndone-when: x\n'      > "$X0B/W-20260101-B01.md"
wanteq "  fixture: aaa's middle item file really has no trailing newline" "0" \
       "$(tail -c 1 "$X0A/W-20260101-A02.md" | wc -l | tr -d ' ')"
wanteq "  fixture: aaa's last item file really has no trailing newline" "0" \
       "$(tail -c 1 "$X0A/W-20260101-A03.md" | wc -l | tr -d ' ')"
# The denominator comes from the FILESYSTEM, not from the text being measured, so a
# body that happened to quote a `## W-` cannot inflate it. 4 item files, 4 headers.
X0_FILES="$(find "$X0A" "$X0B" -name 'W-*.md' | wc -l | tr -d ' ')"
wanteq "  fixture: four item files across the two drawers" "4" "$X0_FILES"

run --all
wanteq "--all across two drawers succeeds (rc=0)" "0" "$RC"
X0_ALL="$(OPEN_ITEMS_PROJECTS_DIR="$P" "$TOOL" --all 2>/dev/null)"
measure "$X0_ALL"
wanteq "  CONTROL: the run produced headers at all, so 0==0 cannot pass vacuously" "4" "$X0_ANY"
wanteq "  every header starts its own line: one per item FILE ($X0_FILES)" "$X0_FILES" "$X0_AT"
want   "  and the glued header is present and whole" "W-20260101-B01 -- bbb, the header that used to glue" "$X0_ALL"

# CONTROL 2: the instrument must be able to FAIL. Hand it the pre-X0 shape -- the same
# text with the boundary newline removed -- and it has to report the glue. Without this
# arm the assertion above would pass just as happily on a measurement that never ran.
X0_BROKEN='## W-20260101-A01 -- one
done-when: x## W-20260101-B01 -- two'
measure "$X0_BROKEN"
wanteq "  CONTROL: glue_count SEES a glued header (anywhere 2)" "2" "$X0_ANY"
wanteq "  CONTROL: and reports only one at line start, so the arm above can fail" "1" "$X0_AT"

# CONTROL 3: a SINGLE drawer was never glued, before the fix or after, INCLUDING across
# its newline-less middle file. This is what pins the bug to the drawer BOUNDARY rather
# than to a file saved without its last byte.
X0_ONE="$(OPEN_ITEMS_PROJECTS_DIR="$P" "$TOOL" --project x0-aaa 2>/dev/null)"
measure "$X0_ONE"
wanteq "  CONTROL: one drawer alone, headers found" "3" "$X0_ANY"
wanteq "  CONTROL: one drawer alone, none glued (a newline-less file is NOT the cause)" "3" "$X0_AT"

# W-20260922-A25: EXACTLY one blank line between two records INSIDE a drawer, whatever
# each item file ends with. The arms above prove only that headers start their own line;
# before A25 a file saved without its last byte printed its last line and the next header
# with NO blank line between, and a file with trailing blank lines printed two. Measured as
# a pair per header (blank lines directly above it, and whether it counted at all), with a
# denominator from the filesystem, so an output with no headers cannot pass.
gap_check(){                    # gap_check <text> -> "<headers after the first> <with exactly one blank above>"
    printf '%s\n' "$1" | awk '
      /^## W-/ { if (seen++) { n++; if (nb == 1) ok++ } }
      { if ($0 == "") nb++; else nb = 0 }
      END { printf "%d %d", n + 0, ok + 0 }'
}
A25_N=0; A25_OK=0
gap_measure(){ read -r A25_N A25_OK <<<"$(gap_check "$1")"; }
# CONTROL: the instrument must see both faults. No blank, and two blanks, each fail.
gap_measure '## W-20260101-A01 -- a
done-when: x
## W-20260101-A02 -- b

x


## W-20260101-A03 -- c'
wanteq "A25 CONTROL: gap_check counts 2 headers after the first, only 0 with exactly one blank" "2 0" "$A25_N $A25_OK"
# The same drawer as CONTROL 3: A02 in the MIDDLE and A03 LAST were saved without a last byte.
gap_measure "$X0_ONE"
wanteq "A25: one drawer, every record after the first has exactly one blank line above it" "2 2" "$A25_N $A25_OK"
# A drawer of its own, so the X0 counts above stay as they were: a file ending WITHOUT a
# newline, one ending with THREE trailing blank lines, and plain ones around them.
A25D="$ROOT/caseA25"; A25P="$A25D/projects"; A25R="$A25D/repo"; mkdir -p "$A25R"; git -C "$A25R" init -q 2>/dev/null
A25W="$A25P/$(key "$A25R")/memory/WORK"; mkdir -p "$A25W/items/open"; printf 'a25\n' > "$A25W/items/.project"
printf '## W-20260101-C01 -- plain\n\nproject: a25\nstatus: open\nkind: do\ndone-when: x\n'            > "$A25W/items/open/W-20260101-C01.md"
printf '## W-20260101-C02 -- no last byte\n\nproject: a25\nstatus: open\nkind: do\ndone-when: x'        > "$A25W/items/open/W-20260101-C02.md"
printf '## W-20260101-C03 -- three trailing blanks\n\nproject: a25\nstatus: open\nkind: do\ndone-when: x\n\n\n\n' > "$A25W/items/open/W-20260101-C03.md"
printf '## W-20260101-C04 -- plain, last\n\nproject: a25\nstatus: open\nkind: do\ndone-when: x\n'      > "$A25W/items/open/W-20260101-C04.md"
A25_FILES="$(find "$A25W/items/open" -name 'W-*.md' | wc -l | tr -d ' ')"
wanteq "  fixture: four item files, C02 with no last byte" "4 0" "$A25_FILES $(tail -c 1 "$A25W/items/open/W-20260101-C02.md" | wc -l | tr -d ' ')"
gap_measure "$(OPEN_ITEMS_PROJECTS_DIR="$A25P" "$TOOL" --project a25 2>/dev/null)"
wanteq "A25: the listing puts exactly one blank line above each of the $((A25_FILES - 1)) later records" "$((A25_FILES - 1)) $((A25_FILES - 1))" "$A25_N $A25_OK"
# The generated OPEN.md is the second printer. regen writes it; the commit then fails
# (rc 3) because the fixture has no dot-claude repo, and the view is on disk either way.
OUT="$(cd "$A25R" && OPEN_ITEMS_PROJECTS_DIR="$A25P" OPEN_ITEMS_DOTCLAUDE="$A25D/no-dotclaude" "$TOOL" regen 2>&1)"; RC=$?
wanteq "  regen writes the view (rc 3: written, NOT committed, no dot-claude here)" "3" "$RC"
gap_measure "$(cat "$A25W/OPEN.md" 2>/dev/null)"
wanteq "A25: the generated OPEN.md puts exactly one blank line above each later record" "$((A25_FILES - 1)) $((A25_FILES - 1))" "$A25_N $A25_OK"
want   "  and the record after the no-last-byte file is whole" "## W-20260101-C03 -- three trailing blanks" "$(cat "$A25W/OPEN.md" 2>/dev/null)"

# --closed widens the population; the boundary must hold there too.
X0_CL="$(OPEN_ITEMS_PROJECTS_DIR="$P" "$TOOL" --all --closed 2>/dev/null)"
measure "$X0_CL"
wanteq "  --all --closed: headers found" "4" "$X0_ANY"
wanteq "  --all --closed: none glued" "4" "$X0_AT"

printf '\nAR argument parsing: a value flag given last, a backslash in holds-in (W-20260923-A36, A27)\n'
# THE BUG (A36): `add t --kind` spun forever. `shift 2` with ONE argument left shifts
# nothing in bash, so `while [ $# -gt 0 ]` never ends. Every value flag is given LAST with
# no value; each must REFUSE (rc 2) naming the flag. The kill is a 1 s alarm, which reports
# a hang as rc 142, so a hanging tool FAILS these arms instead of hanging the suite.
mk_dotclaude
runw "$ZETA" init
AR_T0="$(find "$ZW/items" -name 'W-*.md' 2>/dev/null | wc -l | tr -d ' ')"
runk(){ local s="$1" d="$2"; shift 2; OUT="$(cd "$d" 2>/dev/null && OPEN_ITEMS_PROJECTS_DIR="$P" OPEN_ITEMS_DOTCLAUDE="$DC" CLAUDE_CODE_SESSION_ID=sess-test CLAUDE_SESSION_ID=sess-test perl -e 'alarm shift; exec @ARGV' "$s" "$TOOL" "$@" 2>&1 </dev/null)"; RC=$?; return 0; }
# CONTROL: the instrument can report a hang at all. Without this, rc 2 everywhere below
# could not be told from a kill that never fired.
OUT="$(perl -e 'alarm 1; exec @ARGV' sleep 5 2>&1)"; RC=$?
wanteq "  CONTROL: the 1 s alarm kills a hang, and says so as rc 142" "142" "$RC"
# CONTROL: the same flag WITH its value still works, so the guard refuses only the bare flag.
runk 20 "$ZETA" add "value given" --done-when x --kind do
wanteq "  CONTROL: add with --kind do given last WITH its value succeeds (rc 0)" "0" "$RC"
for AR_F in --kind --size --done-when --when --next --blocked-on --holds-in --body \
            --for --watch --reach --check-script; do
  runk 1 "$ZETA" add "flag last" "$AR_F"
  wanteq "add ... $AR_F (last, no value) REFUSES within 1 s (rc 2; 142 = hung)" "2" "$RC"
  want   "  and names $AR_F" "$AR_F" "$OUT"
done
runk 1 "$ZETA" add "flag last" --check
wanteq "add ... --check (last, no value) REFUSES within 1 s (rc 2)" "2" "$RC"
wanteq "  none of the refusals wrote an item (one file: the control)" "$((AR_T0 + 1))" \
       "$(find "$ZW/items" -name 'W-*.md' 2>/dev/null | wc -l | tr -d ' ')"
for AR_F in --into --park; do
  runk 1 "$ZETA" migrate --dry-run "$AR_F"
  wanteq "migrate ... $AR_F (last, no value) REFUSES within 1 s (rc 2; 142 = hung)" "2" "$RC"
  want   "  and names $AR_F" "$AR_F" "$OUT"
done
for AR_F in --grep --status; do
  runk 1 "$ZETA" "$AR_F"
  wanteq "top level $AR_F (last, no value) REFUSES within 1 s (rc 2)" "2" "$RC"
done
runk 1 "$ZETA" show --project
wanteq "show --project (last, no value) REFUSES within 1 s (rc 2)" "2" "$RC"

# A27: a holds-in value is written LITERALLY. `awk -v` expands backslash escapes, so
# the `\t` in `repo:C:\temp\x.md` became a TAB through add_field (set, set --add). add
# writes with printf and was never affected; it is armed too so a later move to add_field
# cannot regress it quietly.
AR_BS='repo:C:\temp\x.md'
runk 20 "$ZETA" add "backslash home" --done-when x --holds-in "$AR_BS"
wanteq "add --holds-in with a backslash (rc 0)" "0" "$RC"
AR_ID="$(printf '%s\n' "$OUT" | sed -n 's/^\(W-[0-9]\{8\}-[A-Z][0-9]*\)$/\1/p' | head -1)"
AR_FILE="$ZW/items/open/$AR_ID.md"
wanteq "  fixture: the new item file exists" "1" "$([ -f "$AR_FILE" ] && echo 1)"
wanteq "  add wrote it literally" "$AR_BS" "$(sed -n 's/^holds-in: //p' "$AR_FILE" 2>/dev/null)"
ar_ctl(){ LC_ALL=C tr -d '\n' < "$AR_FILE" 2>/dev/null | LC_ALL=C tr -cd '[:cntrl:]' | wc -c | tr -d ' '; }
runk 20 "$ZETA" set --add "$AR_ID" holds-in 'drawer:D:\tmp\new.md'
wanteq "set --add holds-in with a backslash (rc 0)" "0" "$RC"
wanteq "  set --add wrote it literally, and left the first one literal" \
       'repo:C:\temp\x.md|drawer:D:\tmp\new.md' "$(sed -n 's/^holds-in: //p' "$AR_FILE" 2>/dev/null | tr '\n' '|' | sed 's/|$//')"
wanteq "  and no control byte (TAB from \\t, BEL from \\a ...) is in the file" "0" "$(ar_ctl)"
runk 20 "$ZETA" set "$AR_ID" holds-in 'repo:E:\a\b.md'
wanteq "set (replace) holds-in with a backslash (rc 0)" "0" "$RC"
wanteq "  set replace wrote it literally" 'repo:E:\a\b.md' "$(sed -n 's/^holds-in: //p' "$AR_FILE" 2>/dev/null)"
wanteq "  and no control byte is in the file" "0" "$(ar_ctl)"
# CONTROL: the byte counter SEES a control byte, or the two zeros above could not fail.
printf 'x\ty\n' > "$D/ar-ctl"; wanteq "  CONTROL: the counter finds the one TAB in a probe file" "1" "$(AR_FILE="$D/ar-ctl" ar_ctl)"

printf '\nM  pinned items lead the session surface (W-20260923-A23)\n'
# THE BUG: --session listed titles in ID order and the card keeps the first 10, so an item
# filed today "for next session" was the NEWEST ID and fell off the bottom. The fixture is a
# 40-item drawer whose two pinned items are the two NEWEST IDs, plus two look-alikes that
# must NOT pin: a `when:` that says "next time", and "when: next session" in the BODY.
D="$ROOT/caseM"; P="$D/projects"; PIN="$D/pin"; mkdir -p "$PIN"; git -C "$PIN" init -q 2>/dev/null
export PJ_ID_CLAIMS_DIR="$D/claims"   # per case: a claim never leaks between cases, never the real folder
PWK="$P/$(key "$PIN")/memory/WORK"; mkdir -p "$PWK/items/open"; printf 'pin\n' > "$PWK/items/.project"
i=0; while [ $i -lt 40 ]; do i=$((i+1)); id="$(printf 'W-20260101-A%02d' "$i")"
  { printf '## %s -- item number %s\n\nproject: pin\nstatus: open\nkind: do\ndone-when: x\n' "$id" "$i"
    case "$i" in
      37) printf '\nBody that happens to say\nwhen: next session\non a line of its own.\n' ;;
      38) printf 'when: next time something breaks\n' ;;
      39) printf 'when: Next Session, before anything else\n' ;;
      40) printf 'when: next session, first\n' ;;
    esac; } > "$PWK/items/open/$id.md"
done
run_in "$PIN" --session
M_TITLES="$(printf '%s\n' "$OUT" | sed 's/\x1b\[[0-9;]*m//g' | grep '   · ')"   # the dim code rides on line 1
M_TOP10="$(printf '%s\n' "$M_TITLES" | head -10)"
wanteq "--session on a 40-item drawer exits 0" "0" "$RC"
wanteq "  control: all 40 titles are listed (nothing dropped here; the card caps)" "40" "$(printf '%s\n' "$M_TITLES" | wc -l | tr -d ' ')"
want   "  the NEWEST-ID pinned item is inside the first 10 titles" "item number 40" "$M_TOP10"
want   "  a pinned item whose when: is in another case is too" "item number 39" "$M_TOP10"
wanteq "  pinned come FIRST, in ID order" "   · [pinned] item number 39|   · [pinned] item number 40" "$(printf '%s\n' "$M_TITLES" | head -2 | tr '\n' '|' | sed 's/|$//')"
want   "  the header says how many are pinned" "40 in pin, 2 pinned --" "$OUT"
wantnot "  'when: next time' does NOT pin" "[pinned] item number 38" "$OUT"
wantnot "  'when: next session' in the BODY does NOT pin" "[pinned] item number 37" "$OUT"
wanteq "  the rest keep ID order after the pinned ones" "   · item number 1" "$(printf '%s\n' "$M_TITLES" | sed -n 3p)"
# TWIN: unpin them and the same newest items must fall OUT of the first 10, or the arm
# above would pass on a fixture that never tested ordering at all.
sed -i '' '/^when: /d' "$PWK/items/open/W-20260101-A39.md" "$PWK/items/open/W-20260101-A40.md" 2>/dev/null \
  || sed -i '/^when: /d' "$PWK/items/open/W-20260101-A39.md" "$PWK/items/open/W-20260101-A40.md" 2>/dev/null
run_in "$PIN" --session
wantnot "TWIN unpinned, item 40 is NOT in the first 10 (the bug the pin fixes)" "item number 40" "$(printf '%s\n' "$OUT" | grep '   · ' | head -10)"
wantnot "TWIN and the header says nothing about pinned" "pinned" "$OUT"

printf '\nPJ --projects --json, and --json that cannot apply says so (W-20260923-A29)\n'
# THE BUG: dispatch parsed --json into JSON=1 and then --projects, --where and --session
# never read it, so a script asking for JSON got the tab listing and nothing said why.
# Fixture: a drawer whose key AND name hold a quote, a backslash and a non-ASCII letter;
# a legacy drawer keyed to a real repo (for --where); the inbox, which is a drawer too.
D="$ROOT/casePJ"; P="$D/projects"; DC="$D/dotclaude"; mkdir -p "$P" "$DC"
export PJ_ID_CLAIMS_DIR="$D/claims"   # per case: a claim never leaks between cases, never the real folder
PJH="$P/we\"ird\\é-key/memory/WORK"; PJN='we"ird\é name'
mkdir -p "$PJH/items/open" "$PJH/items/closed"; printf '%s\n' "$PJN" > "$PJH/items/.project"
printf '## W-20260101-A01 -- hostile open\n\nproject: x\nstatus: open\n' > "$PJH/items/open/W-20260101-A01.md"
printf '## W-20260101-A02 -- hostile done\n\nproject: x\nstatus: done\n' > "$PJH/items/closed/W-20260101-A02.md"
PJL="$D/leg"; mkdir -p "$PJL"; git -C "$PJL" init -q 2>/dev/null; PJLW="$P/$(key "$PJL")/memory/WORK"; mkdir -p "$PJLW"
printf '# leg -- open items\n\n## W-20260101-03 -- c\n\nproject: leg\nstatus: open\n\n## W-20260101-04 -- d\n\nproject: leg\nstatus: parked\n' > "$PJLW/OPEN.md"
mkdir -p "$DC/pj-inbox/items/open"
printf '## W-20260101-A09 -- inboxed\n\nproject: inbox\nstatus: open\n' > "$DC/pj-inbox/items/open/W-20260101-A09.md"
pjrun(){ OUT="$(cd "${PJD:-$D}" 2>/dev/null && OPEN_ITEMS_PROJECTS_DIR="$P" OPEN_ITEMS_DOTCLAUDE="$DC" "$TOOL" "$@" 2>"$D/err")"; RC=$?; ERR="$(cat "$D/err")"; return 0; }
if command -v jq >/dev/null 2>&1; then
  printf '{"a":"x\001y"}' | jq . >/dev/null 2>&1; M_RC=$?
  wanteq "  CONTROL: jq REJECTS a raw control character in a string" "1" "$([ "$M_RC" -ne 0 ] && echo 1)"
  pjrun --projects --json
  printf '%s' "$OUT" | jq . >/dev/null 2>&1; M_RC=$?
  wanteq "--projects --json exits 0 AND jq . accepts it (a quote, a backslash, an e-acute in a name and a path)" "0|0" "$RC|$M_RC"
  wanteq "  count = the 3 drawers built, inbox included" "3" "$(printf '%s' "$OUT" | jq '.count')"
  wanteq "  items_total 5 (every status), open_total 3" "5|3" "$(printf '%s' "$OUT" | jq -r '"\(.items_total)|\(.open_total)"')"
  wanteq "  the hostile name round-trips byte for byte" "$PJN" "$(printf '%s' "$OUT" | jq -r '.drawers[] | select(.layout == "items" and .items == 2) | .name')"
  wanteq "  and so does its drawer path" "$PJH" "$(printf '%s' "$OUT" | jq -r --arg n "$PJN" '.drawers[] | select(.name == $n) | .drawer')"
  wanteq "  view is the drawer's OPEN.md" "$PJH/OPEN.md" "$(printf '%s' "$OUT" | jq -r --arg n "$PJN" '.drawers[] | select(.name == $n) | .view')"
  wanteq "  the legacy drawer: layout legacy, 2 items, 1 open" "legacy|2|1" "$(printf '%s' "$OUT" | jq -r '.drawers[] | select(.name == "leg") | "\(.layout)|\(.items)|\(.open)"')"
  wanteq "  the inbox is listed like any other drawer" "inbox|1|1" "$(printf '%s' "$OUT" | jq -r --arg d "$DC/pj-inbox" '.drawers[] | select(.drawer == $d) | "\(.name)|\(.items)|\(.open)"')"
  PJE="$D/emptyroot"; mkdir -p "$PJE"
  OUT="$(OPEN_ITEMS_PROJECTS_DIR="$PJE" OPEN_ITEMS_DOTCLAUDE="$D/nodc" "$TOOL" --projects --json 2>/dev/null)"; RC=$?
  wanteq "--projects --json with no drawers exits 1 and is STILL valid JSON, count 0, empty list" "1|0|0" \
         "$RC|$(printf '%s' "$OUT" | jq -r '"\(.count)|\(.drawers | length)"' 2>/dev/null)"
else
  bad "jq is required to prove --projects --json is valid JSON" "jq on PATH" "jq not found -- INVALID TRIAL"
fi
# TWIN, a guard rather than a new behaviour: the plain listing must not move by a byte. The
# expected text is master's (c341a4d) real output on this same fixture, paths substituted.
pjrun --projects
wanteq "TWIN plain --projects is byte-identical to before (rc 0 + stdout)" \
  "0|$(printf 'leg\t%s\tlegacy\n%s\t%s\titems\ninbox\t%s\titems\n\nopen-items: 3 drawer(s), 5 item(s) total.' "$PJLW/OPEN.md" "$PJN" "$PJH/OPEN.md" "$DC/pj-inbox/OPEN.md")" "$RC|$OUT"
# --where and --session cannot honour --json: they say so on stderr and change nothing else.
PJD="$PJL" pjrun --where --json; PJW_J="$RC|$OUT"
want   "--where --json says --json has no effect, on stderr" "--json has no effect with --where" "$ERR"
PJD="$PJL" pjrun --where
wanteq "  and its exit code and stdout are what --where alone gives" "$RC|$OUT" "$PJW_J"
wantnot "TWIN --where without --json prints no such note" "no effect" "$ERR"
PJD="$PJL" pjrun --session --json
wanteq "--session --json still exits 0 (the start card depends on it)" "0" "$RC"
want   "  and says --json has no effect, on stderr" "--json has no effect with --session" "$ERR"
PJD="$ROOT" pjrun --session --json
wanteq "  outside any git repo --session --json still exits 0" "0" "$RC"
want   "  and still says so" "--json has no effect with --session" "$ERR"
unset PJD

printf '\nU  IDs unique across every drawer, claimed machine-wide (W-20260923-A22, A25; D-20260923-A10)\n'
# THE BUG: `add` passed only its OWN drawer to pj-id, so a project minted an ID another
# drawer already held; 12 W- IDs exist twice on the real machine because of it. Every arm
# here runs with a FIXTURE claim folder (mk_dotclaude exports it); none can write the real
# ~/.local/state/pj/ids, because pj-id refuses a fixture machine file with the real folder.
mk_dotclaude
UO="$D/other"; mkdir -p "$UO"; git -C "$UO" init -q 2>/dev/null
UOW="$P/$(key "$UO")/memory/WORK"
runw "$ZETA" init; runw "$UO" init
u_plant(){  # u_plant <work> <NN> <title>: an item file written by hand, then committed
  printf '## W-%s-%s -- %s\n\nproject: planted\nstatus: open\nkind: do\ndone-when: x\nraised: %s (session sess-test)\n' \
    "$TODAY" "$2" "$3" "$(date +%Y-%m-%d)" > "$1/items/open/W-$TODAY-$2.md"
  git -C "$DC" add -A -- "${1#"$DC"/}" >/dev/null 2>&1; git -C "$DC" -c commit.gpgsign=false commit -q -m plant >/dev/null 2>&1
}
u_plant "$UOW" A01 "other one"; u_plant "$UOW" A02 "other two"
runw "$ZETA" add "zeta after other" --done-when x
wanteq "add in zeta skips the IDs ANOTHER drawer holds (rc=0)" "0" "$RC"
want   "  and mints -A03, not the -A01 its own empty drawer would allow" "W-$TODAY-A03" "$OUT"
[ -e "$PJ_ID_CLAIMS_DIR/W-$TODAY-A03" ] && ok "  and CLAIMED it in the (fixture) claim folder" || bad "  and CLAIMED it in the (fixture) claim folder" "$PJ_ID_CLAIMS_DIR/W-$TODAY-A03" "$(ls "$PJ_ID_CLAIMS_DIR" 2>&1)"
# A legacy drawer's OPEN.md is a store too.
UL="$D/legacyu"; mkdir -p "$UL"; git -C "$UL" init -q 2>/dev/null; ULW="$P/$(key "$UL")/memory/WORK"; mkdir -p "$ULW"
printf '# legacyu -- open items\n\n## W-%s-A04 -- a legacy-drawer item\n\nproject: legacyu\nstatus: open\n' "$TODAY" > "$ULW/OPEN.md"
runw "$ZETA" add "zeta after legacy" --done-when x
want   "a legacy OPEN.md header counts as taken too: -A05, not -A04" "W-$TODAY-A05" "$OUT"
# The duplicates already on disk are LEFT; a lookup across drawers refuses them by name.
u_plant "$ZW" A02 "zeta planted twin"
runw "$ZETA" show "W-$TODAY-A02"
wanteq "an ID planted in two drawers (pre-claim duplicate): show REFUSES (rc=2)" "2" "$RC"
want   "  and names the other drawer" "other" "$OUT"

# A25: an items/open that refuses the create must REFUSE, by path, and not spin.
# u_capped kills the whole PROCESS GROUP after N seconds (rc 142). A plain `perl alarm;
# exec` is not enough, measured 2026-09-23: it killed open-items but not the command-
# substitution child running the endless loop, which kept the output pipe open and hung
# the suite for ten minutes against master.
u_capped(){ perl -e 'my $s = shift; my $p = fork; defined $p or exit 125;
  if (!$p) { setpgrp(0, 0); exec @ARGV or exit 127 }
  setpgrp($p, $p); local $SIG{ALRM} = sub { kill "KILL", -$p; waitpid($p, 0); exit 142 };
  alarm $s; waitpid($p, 0); exit($? >> 8)' "$@"; }
runw "$ZETA" add "A25 control before" --done-when x
wanteq "A25 control: a writable drawer adds (rc=0)" "0" "$RC"
chmod 500 "$ZW/items/open"
U_S=$(date +%s)
OUT="$(cd "$ZETA" && OPEN_ITEMS_PROJECTS_DIR="$P" OPEN_ITEMS_DOTCLAUDE="$DC" u_capped 10 "$TOOL" add "A25 refused" --done-when x 2>&1)"; RC=$?
U_E=$(date +%s)
chmod 700 "$ZW/items/open"
wanteq "an items/open that refuses the create REFUSES (rc=2; 142 means it hung and was killed)" "2" "$RC"
want   "  and names the path it could not create" "$ZW/items/open/W-$TODAY-A" "$OUT"
want   "  and says refused, not a clash" "REFUSED, not a clash" "$OUT"
[ $(( U_E - U_S )) -lt 10 ] && ok "  and returns at once ($(( U_E - U_S ))s)" || bad "  and returns at once" "<10s" "$(( U_E - U_S ))s"
wanteq "  and wrote no item" "0" "$(grep -l 'A25 refused' "$ZW/items/open"/*.md 2>/dev/null | wc -l | tr -d ' ')"
wanteq "  and left no drawer lock" "0" "$([ -d "$ZW/items/.lock" ] && echo 1 || echo 0)"
# The same refusal for a CLAIM create that is refused.
chmod 500 "$PJ_ID_CLAIMS_DIR"
OUT="$(cd "$ZETA" && OPEN_ITEMS_PROJECTS_DIR="$P" OPEN_ITEMS_DOTCLAUDE="$DC" u_capped 10 "$TOOL" add "claim refused" --done-when x 2>&1)"; RC=$?
chmod 700 "$PJ_ID_CLAIMS_DIR"
wanteq "a claim folder that refuses the create REFUSES the add (rc=2)" "2" "$RC"
want   "  and names the claim path" "$PJ_ID_CLAIMS_DIR/W-$TODAY-A" "$OUT"
wanteq "  and wrote no item" "0" "$(grep -l 'claim refused' "$ZW/items/open"/*.md 2>/dev/null | wc -l | tr -d ' ')"
runw "$ZETA" add "A25 control after" --done-when x
wanteq "A25 control: with permissions back, an add works again (rc=0)" "0" "$RC"

# THE RACE, end to end: two real adds in two drawers released at the same instant.
# CONTROL first, claim off (PJ_ID_CLAIM=off, a test seam pj-id honours only with a fixture
# folder): they must collide, or the race never happened and the claim arm proves nothing.
u_race(){  # u_race <on|off> <trials> -> "DUPS" count, or INVALID
  local mode="$1" n="$2" k d=0 R who a b
  for k in $(seq 1 "$n"); do
    R="$D/race-$mode-$k"
    for who in X Y; do mkdir -p "$R/$who"; git -C "$R/$who" init -q 2>/dev/null; (cd "$R/$who" && OPEN_ITEMS_PROJECTS_DIR="$P" OPEN_ITEMS_DOTCLAUDE="$DC" "$TOOL" init >/dev/null 2>&1); done
    for who in X Y; do
      ( while [ ! -e "$R/go" ]; do :; done
        cd "$R/$who" || exit 2
        if [ "$mode" = off ]; then PJ_ID_CLAIM=off PJ_ID_CLAIMS_DIR="$R/claims" OPEN_ITEMS_PROJECTS_DIR="$P" OPEN_ITEMS_DOTCLAUDE="$DC" "$TOOL" add "race $who" --done-when x >/dev/null 2>&1
        else PJ_ID_CLAIMS_DIR="$R/claims" OPEN_ITEMS_PROJECTS_DIR="$P" OPEN_ITEMS_DOTCLAUDE="$DC" "$TOOL" add "race $who" --done-when x >/dev/null 2>&1; fi ) &
    done
    sleep 0.2; : > "$R/go"; wait
    a="$(ls "$P/$(key "$R/X")/memory/WORK/items/open" 2>/dev/null | head -1)"; b="$(ls "$P/$(key "$R/Y")/memory/WORK/items/open" 2>/dev/null | head -1)"
    [ -n "$a" ] && [ -n "$b" ] || { echo INVALID; return; }
    [ "$a" = "$b" ] && d=$((d+1))
  done
  echo "$d"
}
# Every trial adds two drawers that later trials also scan, so each race starts from a
# FRESH projects root: otherwise trial 2 would see trial 1's IDs and still be a fair race,
# but the counts would drift. Separate roots keep every trial identical.
U_P="$P"; U_OFF=0; U_ON=0; U_BAD=""
for k in 1 2 3 4; do P="$D/rp-off-$k/projects"; mkdir -p "$P"; r="$(u_race off 1)"; [ "$r" = INVALID ] && U_BAD=1 || U_OFF=$((U_OFF+r)); done
for k in 1 2 3 4; do P="$D/rp-on-$k/projects"; mkdir -p "$P"; r="$(u_race on 1)"; [ "$r" = INVALID ] && U_BAD=1 || U_ON=$((U_ON+r)); done
P="$U_P"
if [ -n "$U_BAD" ]; then bad "race: a racer wrote no item -- INVALID TRIAL" "two items per trial" "off=$U_OFF on=$U_ON"
else
  [ "$U_OFF" -gt 0 ] && ok "race CONTROL, claim off: $U_OFF of 4 simultaneous adds in two drawers got the SAME ID (must be > 0)" \
                     || bad "race CONTROL showed no duplicate, so the race never happened" "> 0" "$U_OFF"
  wanteq "race with the claim: simultaneous adds in two drawers never share an ID (duplicates of 4)" "0" "$U_ON"
fi


# ==============================================================================
# V  A16 write side (W-20260923-A28, D-20260923-A09, safety rules P1-P12 in
#    docs/OPEN_ITEMS_CROSS_PROJECT_SAFETY.md). Every refusal arm checks the refusal's
#    TEXT as well as rc 2: master's tool refuses every new verb and flag as "unknown",
#    and an arm satisfied by that would prove nothing.
# ==============================================================================
printf 'V  A16: owners, watchers, checks, reach, moves, the inbox\n'
export CLAUDE_CODE_SESSION_NAME=sess-name
NM=0
nm(){ NM=$((NM+1)); printf '  NOT MEASURED %s (%s)\n' "$1" "$2"; }
lastid(){ printf '%s\n' "$OUT" | sed -n 's/^\(W-[0-9]\{8\}-[A-Z][0-9]*\)$/\1/p' | head -1; }
ifile(){ local d; for d in open parked closed; do [ -f "$1/items/$d/$2.md" ] && { printf '%s' "$1/items/$d/$2.md"; return 0; }; done; return 1; }
nfiles(){ find "$1/items/open" "$1/items/parked" "$1/items/closed" -name 'W-*.md' 2>/dev/null | wc -l | tr -d ' '; }
shaf(){ [ -f "$1" ] && shasum -a 256 "$1" | cut -d' ' -f1 || printf 'absent'; }
# mkrepo <name> [group] [--nocommit-group]: a fixture repo with one commit, a drawer via init.
mkrepo(){
  local r="$D/$1"
  mkdir -p "$r"; git -C "$r" init -q 2>/dev/null
  git -C "$r" config user.email t@t; git -C "$r" config user.name t
  printf 'readme\n' > "$r/README"; git -C "$r" add README
  if [ -n "${2:-}" ]; then mkdir -p "$r/.claude"; printf 'records: private\ngroup: %s\n' "$2" > "$r/.claude/pj-homes"; git -C "$r" add .claude/pj-homes; fi
  git -C "$r" -c commit.gpgsign=false commit -q -m init 2>/dev/null
  mkdir -p "$P/$(key "$r")/memory/WORK"
  runw "$r" init
}
wk(){ printf '%s' "$P/$(key "$D/$1")/memory/WORK"; }
# A real terminal, driven by expect: the ONLY way the TTY gates can be passed. The sandbox
# denies openpty, so there these arms are reported NOT MEASURED, never passed.
# expect exits 0 even when spawn fails ("no more ptys"), so the probe must see a real
# terminal on the far side: rc 7 comes only from [ -t 0 ] being true there.
PTY_OK=""
if [ -z "${OPEN_ITEMS_SELFTEST_NO_PTY:-}" ]; then
  expect -c 'spawn sh -c {[ -t 0 ] && exit 7}; expect eof; exit [lindex [wait] 3]' >/dev/null 2>&1; [ $? -eq 7 ] && PTY_OK=1
fi
cat > "$ROOT/tty.exp" <<'EXP'
set ans [lindex $argv 0]
set cmd [lrange $argv 1 end]
set timeout 30
log_user 1
spawn {*}$cmd
expect {
  "confirm:" { send -- "$ans\r"; exp_continue }
  eof {}
  timeout { exit 124 }
}
set r [wait]
exit [lindex $r 3]
EXP
tty_run(){ local ans="$1" d="$2"; shift 2; OUT="$(cd "$d" && OPEN_ITEMS_PROJECTS_DIR="$P" OPEN_ITEMS_DOTCLAUDE="$DC" CLAUDE_CODE_SESSION_ID=sess-test expect -f "$ROOT/tty.exp" -- "$ans" "$@" 2>&1)"; RC=$?; }

mk_dotclaude
mkrepo alpha g; mkrepo beta g; mkrepo gamma h; mkrepo nogroup
AW2="$(wk alpha)"; BW2="$(wk beta)"; GW2="$(wk gamma)"

printf 'V1 P1: a header value is one plain line (the forgery measured in M1)\n'
n0="$(nfiles "$AW2")"
runw "$D/alpha" add "harmless" --done-when $'x\nreach: mandatory'
wanteq "P1: a newline in --done-when REFUSES (rc=2)" "2" "$RC"
want   "P1:   and names the control character, not an unknown flag" "control character" "$OUT"
wanteq "P1:   and wrote NO file (count before = after)" "$n0" "$(nfiles "$AW2")"
runw "$D/alpha" add $'title\nwatch: beta' --done-when x
wanteq "P1: a newline in the TITLE refuses (rc=2)" "2" "$RC"
want   "P1:   naming the title" "the title holds a control" "$OUT"
runw "$D/alpha" add "t" --done-when x --check beta $'dw\npassed: beta 2026-09-23'
wanteq "P1: a newline in a --check done-when refuses (rc=2)" "2" "$RC"
want   "P1:   naming --check" "--check (done-when) holds a control" "$OUT"
runw "$D/alpha" add $'osc \e]52;c;aGk=\a title' --done-when x
want   "P1: an ESC (OSC 52) in a title is refused" "control character" "$OUT"
runw "$D/alpha" add $'rtl \xe2\x80\xae title' --done-when x
want   "P1: a U+202E bidi override in a title is refused" "bidi" "$OUT"
wanteq "P1:   none of the four refused adds wrote a file" "$n0" "$(nfiles "$AW2")"
runw "$D/alpha" add "plain" --done-when "a plain value"
wanteq "P1 CONTROL: the same add with plain values writes (rc=0)" "0" "$RC"
V_PLAIN="$(lastid)"
runw "$D/alpha" get "$V_PLAIN" reach
wanteq "P1 CONTROL:   and the item has no reach: field (get rc=1)" "1" "$RC"
runw "$D/alpha" set "$V_PLAIN" next $'a\tb'
wanteq "P1: set with a TAB in a one-line field refuses (rc=2; master only refused a newline)" "2" "$RC"
want   "P1:   naming the control character" "control character" "$OUT"
runw "$D/alpha" set "$V_PLAIN" next "tab free"
wanteq "P1 CONTROL: the same set without the tab works (rc=0)" "0" "$RC"

