mkdir -p "$D/loose"; cp "$TOOL" "$D/loose/open-items"
OUT="$(cd "$FD" && OPEN_ITEMS_PROJECTS_DIR="$P" OPEN_ITEMS_DOTCLAUDE="$DC" "$D/loose/open-items" add "script elsewhere" --done-when y --reach mandatory --check-script good 2>&1)"; RC=$?
want   "P4: the same name through a tool copy NOT inside a dotfiles repo is refused" "dotfiles root unknown" "$OUT"
runf "$D/beta" pass "$V_SCR" beta
wanteq "P2: pass on an item WITH a check-script REFUSES even from beta (rc=2)" "2" "$RC"
want   "P2:   saying only the script can pass it" "only the script can pass it" "$OUT"
runf "$D/alpha" pass "$V_MAN" beta
wanteq "P2: pass for beta FROM ALPHA REFUSES (rc=2)" "2" "$RC"
want   "P2:   with the P2 text" "only a session in beta" "$OUT"
runf "$D/beta" pass "$V_MAN" beta
wanteq "P2 CONTROL: pass from inside beta on a script-less item works (rc=0)" "0" "$RC"
want   "P2:   passed: records date and session" "passed: beta $(date +%Y-%m-%d) by sess-name" "$(cat "$F_MAN")"
runf "$D/beta" pass "$V_MAN" beta
wanteq "  a second pass by the same project REFUSES (rc=2)" "2" "$RC"
want   "    by name" "beta has already passed" "$OUT"
if [ -n "$PTY_OK" ]; then
  tty_run alpha "$D/alpha" "$TOOL" add "human mandatory" --done-when y --reach mandatory
  wanteq "P8 TTY: a human typing the owner name at a terminal may file reach: mandatory (rc=0)" "0" "$RC"
  tty_run wrong "$D/alpha" "$TOOL" add "human typo" --done-when y --reach mandatory
  wanteq "P8 TTY CONTROL: the wrong name typed REFUSES (rc=2)" "2" "$RC"
  want   "P8 TTY CONTROL:   with the P8 refusal, not an unknown flag" "or the name did not match" "$OUT"
else nm "P8 TTY positive and typo arms" "no pty here: expect could not open one (the Claude sandbox denies openpty)"; fi

printf 'V7 move: groups, history, notice, no-clobber (P10, P11, P12)\n'
runw "$D/alpha" add "to move" --done-when y --watch beta
V_MV="$(lastid)"; F_MV="$(ifile "$AW2" "$V_MV")"
runw "$D/alpha" move "$V_MV" --to beta
wanteq "move without --why REFUSES (rc=2)" "2" "$RC"
want   "  saying --why is required" "--why is required" "$OUT"
runw "$D/alpha" move "$V_MV" --to beta --why $'x\nmoved-from: gamma'
want   "P1: a newline in --why is refused" "control character" "$OUT"
runw "$D/alpha" move "$V_MV" --to inbox --why "hide it"
wanteq "P11: move --to inbox REFUSES (rc=2)" "2" "$RC"
want   "P11:   by name" "--to inbox is refused" "$OUT"
H0="$(git -C "$DC" rev-parse HEAD)"
runw "$D/alpha" move "$V_MV" --to gamma --why "wrong group"
wanteq "P11: a CROSS-GROUP move (g -> h) REFUSES without a terminal (rc=2)" "2" "$RC"
want   "P11:   naming both groups" "(group g) to gamma (group h)" "$OUT"
want   "P11:   and saying it is Gavin's call" "Gavin's call" "$OUT"
runw "$D/alpha" move "$V_MV" --to nogroup --why "no group there"
want   "P11: a move to a project with NO group is refused as cross-group" "(no group)" "$OUT"
runw "$D/alpha" move "$V_MV" --to beta --why "belongs to beta"
wanteq "move inside group g, alpha -> beta, works (rc=0)" "0" "$RC"
F_MV2="$BW2/items/open/$V_MV.md"
wanteq "  the source file is gone" "1" "$([ ! -e "$F_MV" ] && echo 1)"
wanteq "  the destination file exists" "1" "$([ -f "$F_MV2" ] && echo 1)"
want   "  project: is now beta" "project: beta" "$(cat "$F_MV2")"
want   "  moved-from: records source, session, both groups and both heads, then why" "moved-from: alpha $(date +%Y-%m-%d) by sess-name (group g -> g, head $(git -C "$D/alpha" rev-parse --short=7 HEAD) -> $(git -C "$D/beta" rev-parse --short=7 HEAD)): belongs to beta" "$(cat "$F_MV2")"
wantnot "  beta's watch: line went (it owns the item now)" "watch: beta" "$(cat "$F_MV2")"
want   "P11: the SOURCE drawer holds a moved-out record" "moved-to: beta" "$(cat "$AW2/items/moved-out/$V_MV.md" 2>/dev/null)"
want   "P11:   naming the session and the reason" "why: belongs to beta" "$(cat "$AW2/items/moved-out/$V_MV.md" 2>/dev/null)"
wanteq "P12: ONE commit touches both drawers" "2" "$(git -C "$DC" show --name-only --format= HEAD | sed -n 's#^projects/\([^/]*\)/.*#\1#p' | sort -u | wc -l | tr -d ' ')"
wanteq "P12:   and both drawers are clean afterwards" "0" "$(git -C "$DC" status --porcelain -- "projects/$(key "$D/alpha")" "projects/$(key "$D/beta")" | wc -l | tr -d ' ')"
wanteq "P12:   the item is in the index under beta only" "1" "$(git -C "$DC" ls-files | grep -c "/items/open/$V_MV.md")"
runw "$D/beta" move "$V_MV" --to alpha --why "back again"
wanteq "P11: a move BACK to a former owner REFUSES (rc=2)" "2" "$RC"
want   "P11:   by name" "a move back is Gavin's call" "$OUT"
wanteq "P11:   and the item is unchanged" "1" "$([ -f "$F_MV2" ] && [ ! -e "$F_MV" ] && echo 1)"
# no-clobber: plant beta's own copy of an ID alpha holds, in beta's CLOSED folder.
runw "$D/alpha" add "clash" --done-when y
V_CL="$(lastid)"; F_CL="$(ifile "$AW2" "$V_CL")"
mkdir -p "$BW2/items/closed"; printf '## %s -- beta own copy\n\nproject: beta\nstatus: done\n' "$V_CL" > "$BW2/items/closed/$V_CL.md"
SA="$(shaf "$F_CL")"; SB="$(shaf "$BW2/items/closed/$V_CL.md")"
runw "$D/alpha" move "$V_CL" --to beta --why "collide" --project alpha
wanteq "P12: a move onto an ID the destination holds in closed/ REFUSES (rc=2)" "2" "$RC"
want   "P12:   naming both files" "$BW2/items/closed/$V_CL.md" "$OUT"
wanteq "P12:   source byte-identical" "$SA" "$(shaf "$F_CL")"
wanteq "P12:   destination byte-identical" "$SB" "$(shaf "$BW2/items/closed/$V_CL.md")"
# P11 rule 2: a group line only in the working tree does not count.
mkrepo late; mkdir -p "$D/late/.claude"; printf 'group: g\n' > "$D/late/.claude/pj-homes"
runw "$D/alpha" move "$V_CL" --to late --why "uncommitted group" --project alpha
wanteq "P11: a group line only in the WORKING TREE refuses the move (rc=2)" "2" "$RC"
want   "P11:   saying commit it first" "commit the group line first" "$OUT"
git -C "$D/late" add .claude/pj-homes; git -C "$D/late" -c commit.gpgsign=false commit -q -m group 2>/dev/null
runw "$D/alpha" move "$V_CL" --to late --why "committed group" --project alpha
wanteq "P11 CONTROL: once committed, the same move works (rc=0)" "0" "$RC"
# P10: a repo: line that does not belong to its drawer makes the repo unknown.
runw "$D/alpha" add "spoof" --done-when y
V_SP="$(lastid)"
cp "$BW2/items/.project" "$D/beta-project.bak"
printf 'beta\nrepo: %s\n' "$D/gamma" > "$BW2/items/.project"
runw "$D/alpha" move "$V_SP" --to beta --why "spoofed"
wanteq "P10: a repo: line pointing at ANOTHER repo -> repo unknown, move refused (rc=2)" "2" "$RC"
want   "P10:   said out loud" "repo unknown (repo: line does not match this drawer)" "$OUT"
printf 'beta\nrepo: %s\n' "$D/beta-deleted" > "$BW2/items/.project"
runw "$D/alpha" move "$V_SP" --to beta --why "deleted"
want   "P10: a repo: line naming a missing directory -> repo unknown" "repo unknown" "$OUT"
command mv "$D/beta-project.bak" "$BW2/items/.project"
runw "$D/alpha" move "$V_SP" --to beta --why "restored"
wanteq "P10 CONTROL: with the right repo: line the move works (rc=0)" "0" "$RC"
if [ -n "$PTY_OK" ]; then
  runw "$D/alpha" add "cross by hand" --done-when y
  V_X="$(lastid)"
  tty_run "$V_X" "$D/alpha" "$TOOL" move "$V_X" --to gamma --why "Gavin says so"
  wanteq "P11 TTY: a human typing the ID moves ACROSS groups (rc=0)" "0" "$RC"
  wanteq "P11 TTY:   the item is in gamma" "1" "$([ -n "$(ifile "$GW2" "$V_X")" ] && echo 1)"
else nm "P11 TTY cross-group positive arm" "no pty here"; fi

printf 'V8 P10: the repo: line on write\n'
runw "$D/alpha" add "no-op" --done-when y
wanteq "back-fill CONTROL: a drawer that has its repo: line keeps exactly one" "1" "$(awk '/^repo:/{n++} END{print n+0}' "$AW2/items/.project")"
printf 'alpha\n' > "$AW2/items/.project"
runw "$D/alpha" add "backfill" --done-when y
wanteq "back-fill: a write from inside the repo adds the missing repo: line" "repo: $D/alpha" "$(sed -n 2p "$AW2/items/.project")"
wanteq "back-fill:   and it was committed" "0" "$(git -C "$DC" status --porcelain -- "projects/$(key "$D/alpha")" | wc -l | tr -d ' ')"
mkdir -p "$D/a/b" "$D/a_b"; git -C "$D/a/b" init -q 2>/dev/null; git -C "$D/a_b" init -q 2>/dev/null
mkdir -p "$P/$(key "$D/a/b")/memory"
runw "$D/a/b" init
SPJ="$(shaf "$P/$(key "$D/a/b")/memory/WORK/items/.project")"
runw "$D/a_b" add "collide" --done-when y
wanteq "P10: a write from a_b into the drawer a/b owns (same key) REFUSES (rc=2)" "2" "$RC"
want   "P10:   naming the repo on record" "repo: $D/a/b" "$OUT"
want   "P10:   and the repo you are in" "you are in $D/a_b" "$OUT"
wanteq "P10:   .project is byte-identical" "$SPJ" "$(shaf "$P/$(key "$D/a/b")/memory/WORK/items/.project")"

printf 'V9 P12: a failed move commit, and opposite moves at once\n'
runw "$D/alpha" add "fails to commit" --done-when y
V_FC="$(lastid)"
printf '#!/bin/sh\nexit 1\n' > "$DC/.git/hooks/pre-commit"; chmod +x "$DC/.git/hooks/pre-commit"
runw "$D/alpha" move "$V_FC" --to beta --why "commit will fail"
command mv "$DC/.git/hooks/pre-commit" "$DC/.git/hooks/pre-commit.off"
wanteq "P12: a move whose commit fails returns rc=3" "3" "$RC"
want   "P12:   and says uncommitted move" "uncommitted move $V_FC" "$OUT"
wanteq "P12:   a marker in the SOURCE drawer" "1" "$([ -d "$AW2/items/.pending-move/$V_FC@$(key "$D/beta")" ] && echo 1)"
wanteq "P12:   and one in the DESTINATION" "1" "$([ -d "$BW2/items/.pending-move/$V_FC@$(key "$D/alpha")" ] && echo 1)"
runw "$D/beta" add "next write in beta" --done-when y
wanteq "P12: the next write in EITHER drawer commits (rc=0)" "0" "$RC"
wanteq "P12:   carrying BOTH halves: both drawers are clean" "0" "$(git -C "$DC" status --porcelain -- "projects/$(key "$D/alpha")" "projects/$(key "$D/beta")" | wc -l | tr -d ' ')"
wanteq "P12:   the moved item is committed under beta only" "1" "$(git -C "$DC" ls-files | grep -c "/items/open/$V_FC.md" )"
wanteq "P12:   and both markers are gone" "1" "$([ ! -e "$AW2/items/.pending-move/$V_FC@$(key "$D/beta")" ] && [ ! -e "$BW2/items/.pending-move/$V_FC@$(key "$D/alpha")" ] && echo 1)"
# Opposite moves at once, with a pause between taking the two locks so the order matters.
v_race(){                       # v_race <unsorted?> -> "okA okB" exit codes
  local x y a b
  runw "$D/alpha" add "race a" --done-when y; x="$(lastid)"
  runw "$D/beta" add "race b" --done-when y; y="$(lastid)"
  ( cd "$D/alpha" && OPEN_ITEMS_TEST_LOCK_UNSORTED="$1" OPEN_ITEMS_TEST_LOCK_GAP=1 OPEN_ITEMS_TEST_LOCK_TRIES="${2:-600}" OPEN_ITEMS_PROJECTS_DIR="$P" OPEN_ITEMS_DOTCLAUDE="$DC" "$TOOL" move "$x" --to beta --why race >"$D/race.a.out" 2>&1; echo $? > "$D/race.a" ) &
  ( cd "$D/beta" && OPEN_ITEMS_TEST_LOCK_UNSORTED="$1" OPEN_ITEMS_TEST_LOCK_GAP=1 OPEN_ITEMS_TEST_LOCK_TRIES="${2:-600}" OPEN_ITEMS_PROJECTS_DIR="$P" OPEN_ITEMS_DOTCLAUDE="$DC" "$TOOL" move "$y" --to alpha --why race >"$D/race.b.out" 2>&1; echo $? > "$D/race.b" ) &
  wait
  a="$(cat "$D/race.a")"; b="$(cat "$D/race.b")"
  printf '%s %s' "$a" "$b"
}
R_OK=0; for k in 1 2 3; do [ "$(v_race "")" = "0 0" ] && R_OK=$((R_OK+1)); done
wanteq "P12: 3 rounds of opposite moves at once, locks in sorted order: every move succeeds" "3" "$R_OK"
wanteq "P12:   and no lock is left behind" "1" "$([ ! -e "$AW2/items/.lock" ] && [ ! -e "$BW2/items/.lock" ] && echo 1)"
R_C="$(v_race 1 25)"
case "$R_C" in *2*) ok "P12 CONTROL: the same race with the locks in CALLER order deadlocks, and a move refuses ($R_C)" ;;
  *) bad "P12 CONTROL: unsorted locks should deadlock and refuse" "a rc of 2" "$R_C" ;; esac
want   "P12 CONTROL:   and the refusal IS the lock timeout (not some other refusal)" "could not take the drawer lock" "$(cat "$D/race.a.out" "$D/race.b.out")"
wanteq "P12:   every ID still sits in exactly one drawer" "0" "$(ls "$AW2/items/open" "$BW2/items/open" 2>/dev/null | grep '^W-' | sort | uniq -d | wc -l | tr -d ' ')"

printf 'V10 the inbox and route (P11, P12)\n'
mkdir -p "$DC/other"; printf 'stray\n' > "$DC/other/stray.txt"
runw "$D/alpha" add "unrouted" --done-when y --inbox
wanteq "add --inbox writes (rc=0)" "0" "$RC"
V_IN="$(lastid)"
wanteq "  into pj-inbox/items/open" "1" "$([ -f "$DC/pj-inbox/items/open/$V_IN.md" ] && echo 1)"
wanteq "  the inbox is named inbox" "inbox" "$(head -1 "$DC/pj-inbox/items/.project")"
want   "P12: the commit lists the inbox item" "pj-inbox/items/open/$V_IN.md" "$(git -C "$DC" log -1 --name-only --format=)"
wantnot "P12:   and NOT a stray file elsewhere in dot-claude" "other/stray.txt" "$(git -C "$DC" log -1 --name-only --format=)"
runw "$D/alpha" --projects
want   "  --projects lists the inbox drawer by its path" "inbox	$DC/pj-inbox/OPEN.md	items" "$OUT"
runw "$D/alpha" add "both" --done-when y --inbox --for beta
wanteq "--inbox with --for REFUSES (rc=2)" "2" "$RC"
want   "  by name" "--inbox and --for each name the owner" "$OUT"
runw "$D/alpha" route "$V_IN" --to beta < /dev/null
wanteq "P11: route with stdin from a pipe REFUSES (rc=2)" "2" "$RC"
want   "P11:   saying it needs a human at a terminal" "needs a human at a terminal" "$OUT"
wanteq "P11:   and the item is still in the inbox" "1" "$([ -f "$DC/pj-inbox/items/open/$V_IN.md" ] && echo 1)"
runw "$D/alpha" move "$V_IN" --to beta --why "sneak"
wanteq "P11: 'move' cannot take an item out of the inbox either (rc=2)" "2" "$RC"
want   "P11:   pointing at route" "only by 'open-items route'" "$OUT"
if [ -n "$PTY_OK" ]; then
  tty_run "$V_IN" "$D/alpha" "$TOOL" route "$V_IN" --to beta
  wanteq "P11 TTY: a human typing the ID routes it (rc=0)" "0" "$RC"
  want   "P11 TTY:   moved-from: inbox" "moved-from: inbox" "$(cat "$BW2/items/open/$V_IN.md" 2>/dev/null)"
  want   "P11 TTY:   and the inbox keeps a moved-out record" "moved-to: beta" "$(cat "$DC/pj-inbox/items/moved-out/$V_IN.md" 2>/dev/null)"
else nm "P11 TTY route positive arm" "no pty here"; fi
mk_dotclaude
mkrepo solo
chmod 500 "$DC"
runw "$D/solo" add "no inbox possible" --done-when y --inbox
chmod 700 "$DC"
wanteq "an inbox that cannot be created REFUSES (rc=2)" "2" "$RC"
want   "  naming the path" "$DC/pj-inbox/items" "$OUT"
unset CLAUDE_CODE_SESSION_NAME

# THE EXIT CODE FOR "NOT MEASURED" IS ITSELF MEASURED: a child run of this very suite with
# the pty forced off must exit 3, never 0. The child does not recurse.
if [ -z "${OPEN_ITEMS_SELFTEST_CHILD:-}" ]; then
  printf 'W  exit 3 when arms were NOT MEASURED (a child run of this suite, pty forced off)\n'
  OUT="$(OPEN_ITEMS_SELFTEST_CHILD=1 OPEN_ITEMS_SELFTEST_NO_PTY=1 "$0" 2>&1)"; RC=$?
  wanteq "a run with NOT MEASURED arms exits 3, not 0 (1 would mean the child had a real failure)" "3" "$RC"
  want   "  and says passed what ran, N not measured" "passed what ran, 3 arm group(s) NOT MEASURED" "$OUT"
fi
# ---- the cross-project read side (W-20260923-A28) lives in its own selftest, which copies
# the tool into a fixture dotfiles repo (the check-script trust root is the tool's real path).
# Its arms are folded into this total, so one green run here means both are green.
printf '\nXP the cross-project read side (open-items-xp-selftest)\n'
XPT="$(dirname "$0")/open-items-xp-selftest"
if [ -x "$XPT" ]; then
  XPO="$(OPEN_ITEMS_TOOL="$TOOL" "$XPT" </dev/null 2>&1)"; XPR=$?
  XPP="$(printf '%s\n' "$XPO" | sed -n 's/^\([0-9]*\) passed, \([0-9]*\) failed.*/\1/p' | tail -1)"
  XPF="$(printf '%s\n' "$XPO" | sed -n 's/^\([0-9]*\) passed, \([0-9]*\) failed.*/\2/p' | tail -1)"
  printf '%s\n' "$XPO" | grep -E '^  (FAIL|     )' | sed 's/^/  /'
  if [ -z "$XPP" ]; then bad "open-items-xp-selftest printed no totals -- INVALID TRIAL" "N passed, M failed" "rc $XPR"
  else PASS=$((PASS + XPP)); FAIL=$((FAIL + XPF)); printf '  %s passed, %s failed in open-items-xp-selftest (rc %s)\n' "$XPP" "$XPF" "$XPR"
    [ "$XPR" -eq 0 ] || [ "$XPF" -gt 0 ] || bad "open-items-xp-selftest exited $XPR with no failed arm" "rc 0" "rc $XPR"; fi
else
  bad "open-items-xp-selftest is missing beside this selftest" "$XPT" "absent"
fi

printf '\n%s passed, %s failed   (fixtures: %s)\n' "$PASS" "$FAIL" "$ROOT"
[ "$FAIL" -eq 0 ] || { printf 'open-items-selftest: FAILURES above\n' >&2; exit 1; }
if [ "${NM:-0}" -gt 0 ]; then
  printf 'open-items-selftest: passed what ran, %s arm group(s) NOT MEASURED (no pty in this environment) -- NOT a pass; run outside the sandbox to measure them (exit 3)\n' "$NM"
  exit 3
fi
printf 'open-items-selftest: all arms pass\n'
exit 0
