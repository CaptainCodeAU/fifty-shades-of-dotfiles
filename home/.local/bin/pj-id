#!/usr/bin/env bash
# pj-id -- the one ID allocator behind `open-items add` and `decided add` (P5.5, P8a).
#
# Usage:
#   pj-id machine                       print "NAME LETTER" for this machine
#   pj-id next <D|W> <store>...         lowest free NN of today for THIS machine's letter,
#                                       given every store an ID of that kind could sit in
#                                       (a folder is searched recursively for <ID>*.md, a
#                                       file for a "## <ID> " header). Prints the full ID.
#   pj-id --selftest                    prove the arms
#
# WHY. W- and D- IDs are claimed locally by creating a file, which is atomic on one
# machine and blind to another clone: two machines claimed the same W-YYYYMMDD-NN on one
# day (pj-wrap-selftest, 2026-09-20). Fix: the ID carries the machine that minted it.
#
# THE SHAPE  X-YYYYMMDD-LNN, e.g. W-20260921-A07, D-20260921-A07. L is the machine letter,
# NN runs 01-99 per machine per day. Ruled by Gavin 2026-09-21 (P8a gate, Q1 and Q6); it
# REPLACES the two-range scheme (`range: 01-49` / `50-99`) that P5.5 shipped.
#
# THE MACHINE FILE  ${PJ_MACHINE_FILE:-~/.config/pj/machine}, written by install.sh:
#   name: mini
#   letter: A
# The four machines Gavin runs: A = the M4 Mac mini, B = the Intel Mac laptop, C = the PC
# (all coding inside WSL2 Ubuntu), D = a Proxmox Linux VM or container.
#
# NO DEFAULT LETTER, DELIBERATELY. An absent or letterless machine file REFUSES (rc 2) and
# names the fix. P5.5's absent-file default of 01-49 was safe because a range collision only
# duplicated a number; a default LETTER would put another machine's name on this machine's
# work, which is a wrong record rather than a clash. Refusing is the conservative arm.
#
# An exhausted letter (99 IDs of one kind in one day) REFUSES loudly; it never wraps and
# never borrows another machine's letter. `pj-wrap push` keeps its add/add collision stop as
# the second line of defence. Measured before choosing 99: the most IDs ever claimed in one
# day on this machine were 9 W and 11 D (2026-09-21 census).
#
# LEGACY IDs. The pre-P8a shape X-YYYYMMDD-NN is not minted any more. Every such ID was
# renamed to the `A` form by the P8a migration, and `open-items` and `decided` still RESOLVE
# a bare X-YYYYMMDD-NN typed from an older document. This tool only mints; resolution lives
# in those two.
#
# Exit: 0 printed · 2 REFUSED (bad args, missing/unreadable/letterless machine file, letter
#       exhausted).

set -uo pipefail

MACHINE_FILE="${PJ_MACHINE_FILE:-${XDG_CONFIG_HOME:-$HOME/.config}/pj/machine}"

refuse(){ printf 'pj-id: REFUSED -- %s\n' "$1" >&2; exit 2; }
usage(){ sed -n '2,10p' "$0" | sed 's/^# \{0,1\}//'; }

# read_machine -> "NAME LETTER"
read_machine(){
  local name letter range
  if [ ! -f "$MACHINE_FILE" ]; then
    refuse "no machine file at $MACHINE_FILE, so this machine has no letter and an ID cannot say where it was minted. Fix: run ./install.sh in the dotfiles repo (it asks which machine this is), or write the file by hand with 'name: <host>' and 'letter: <A-Z>'."
  fi
  [ -r "$MACHINE_FILE" ] || refuse "$MACHINE_FILE exists but is unreadable; fix: chmod u+r $MACHINE_FILE"
  name="$(sed -n 's/^name:[[:space:]]*//p' "$MACHINE_FILE" | head -1 | sed 's/[[:space:]]*$//')"
  letter="$(sed -n 's/^letter:[[:space:]]*//p' "$MACHINE_FILE" | head -1 | sed 's/[[:space:]]*$//')"
  range="$(sed -n 's/^range:[[:space:]]*//p' "$MACHINE_FILE" | head -1 | sed 's/[[:space:]]*$//')"
  [ -n "$name" ] || refuse "$MACHINE_FILE has no 'name:' line"
  if [ -z "$letter" ]; then
    if [ -n "$range" ]; then
      refuse "$MACHINE_FILE still carries the retired 'range: $range' and no 'letter:' line. The ID shape changed to X-YYYYMMDD-LNN on 2026-09-21 (P8a). Fix: run ./install.sh in the dotfiles repo; it rewrites this file once, replacing range with a letter."
    fi
    refuse "$MACHINE_FILE has no 'letter:' line, so an ID cannot name the machine that minted it. Fix: run ./install.sh in the dotfiles repo, or add 'letter: <A-Z>' by hand (A = Mac mini, B = Intel laptop, C = WSL, D = Linux VM)."
  fi
  case "$letter" in
    [A-Z]) ;;
    *) refuse "$MACHINE_FILE 'letter:' must be ONE capital letter A-Z (got '$letter')" ;;
  esac
  printf '%s %s\n' "$name" "$letter"
}

# taken <ID> <store>... -> 0 when any store already holds that ID
taken(){
  local id="$1" s; shift
  for s in "$@"; do
    if [ -d "$s" ]; then
      [ -n "$(find "$s" -name "$id*.md" -print -quit 2>/dev/null)" ] && return 0
    elif [ -f "$s" ]; then
      grep -q "^## $id " "$s" 2>/dev/null && return 0
    fi
  done
  return 1
}

cmd_next(){
  local kind="${1:-}" day n id name letter; shift || true
  case "$kind" in D|W) ;; *) refuse "next: kind must be D or W" ;; esac
  [ $# -gt 0 ] || refuse "next: name at least one store to check"
  local line
  line="$(read_machine)" || exit 2
  # SPLIT FROM THE RIGHT, and re-validate. `read -r name letter` word-splits, so a machine
  # file reading `name: my box` put "box" in $name and "A" nowhere useful -- measured
  # 2026-09-21: it minted `W-20260921-box A01`, exit 0, and open-items would have created
  # a file with a space in its name. read_machine validates the letter before printing, so
  # nothing was watching after the split. The old range code caught this only by accident,
  # because a non-number failed the arithmetic; a letter goes straight into printf.
  letter="${line##* }"; name="${line% *}"
  case "$letter" in
    [A-Z]) ;;
    *) refuse "could not read a single-letter machine name out of '$line' (check $MACHINE_FILE)" ;;
  esac
  day="$(date +%Y%m%d)"
  n=1
  while [ "$n" -le 99 ]; do
    id="$(printf '%s-%s-%s%02d' "$kind" "$day" "$letter" "$n")"
    taken "$id" "$@" || { printf '%s\n' "$id"; return 0; }
    n=$((n+1))
  done
  refuse "no free $kind ID left for $day on machine $letter ($name): all 99 are taken. The letter is exhausted, not wrapped, and this machine never borrows another machine's letter. Wait for tomorrow, or close/rename some of today's."
}

selftest(){
  local tmp fails=0 out rc a b day
  tmp=$(mktemp -d "${TMPDIR:-/tmp}/pj-id-selftest.XXXXXX") || { echo "pj-id --selftest: mktemp failed -- INVALID TRIAL" >&2; return 2; }
  day="$(date +%Y%m%d)"
  ok(){ echo "  ok   $1"; }; fail(){ echo "  FAIL $1"; fails=1; }
  mkdir -p "$tmp/s"

  # arm 1: an ABSENT machine file REFUSES and names install.sh (P8a Q6: no default letter)
  out="$(PJ_MACHINE_FILE="$tmp/none" "$0" machine 2>&1)"; rc=$?
  [ "$rc" -eq 2 ] && case "$out" in *install.sh*) ok "absent machine file REFUSES rc 2 and names install.sh";; *) fail "rc 2 but message was '$out'";; esac || fail "absent file gave rc=$rc: $out"
  PJ_MACHINE_FILE="$tmp/none" "$0" next W "$tmp/s" >/dev/null 2>&1; rc=$?
  [ "$rc" -eq 2 ] && ok "absent machine file REFUSES an allocation too" || fail "next with no machine file gave rc=$rc"

  # arm 2: the RETIRED range-only file refuses and says the shape changed
  printf 'name: old-box\nrange: 01-49\n' > "$tmp/m-range"
  out="$(PJ_MACHINE_FILE="$tmp/m-range" "$0" next D "$tmp/s" 2>&1)"; rc=$?
  [ "$rc" -eq 2 ] && case "$out" in *"retired 'range"*) ok "a range-only machine file REFUSES and names the retired key";; *) fail "rc 2 but message was '$out'";; esac || fail "range-only gave rc=$rc: $out"

  # arm 3: POSITIVE ARM -- a valid letter file allocates -A01
  printf 'name: one\nletter: A\n' > "$tmp/mA"; printf 'name: two\nletter: B\n' > "$tmp/mB"
  out="$(PJ_MACHINE_FILE="$tmp/mA" "$0" machine)"; [ "$out" = "one A" ] && ok "machine prints 'NAME LETTER'" || fail "machine printed '$out'"
  out="$(PJ_MACHINE_FILE="$tmp/mA" "$0" next W "$tmp/s")"; [ "$out" = "W-$day-A01" ] && ok "first W on machine A is -A01" || fail "first W was '$out'"

  # arm 4: two letters never overlap -- claim all 99 under each and intersect
  mkdir -p "$tmp/one" "$tmp/two"
  local i id2
  for i in $(seq 1 99); do id2="$(PJ_MACHINE_FILE="$tmp/mA" "$0" next D "$tmp/one")" || break; : > "$tmp/one/$id2.md"; done
  for i in $(seq 1 99); do id2="$(PJ_MACHINE_FILE="$tmp/mB" "$0" next D "$tmp/two")" || break; : > "$tmp/two/$id2.md"; done
  a="$(ls "$tmp/one" | wc -l | tr -d ' ')"; b="$(ls "$tmp/two" | wc -l | tr -d ' ')"
  [ "$a" = 99 ] && [ "$b" = 99 ] && ok "letter A claimed 99, letter B claimed 99" || fail "claimed $a and $b"
  out="$(comm -12 <(ls "$tmp/one" | sort) <(ls "$tmp/two" | sort) | wc -l | tr -d ' ')"
  [ "$out" = 0 ] && ok "the two letters share no ID (control: 99 + 99 = 198 distinct)" || fail "$out IDs overlap"
  out="$(ls "$tmp/one" "$tmp/two" | grep -c "^D-$day-[AB]")"; [ "$out" = 198 ] && ok "198 distinct IDs exist (positive arm)" || fail "expected 198 IDs, found $out"

  # arm 5: an exhausted letter refuses loudly, rc 2, and does not borrow the other letter
  out="$(PJ_MACHINE_FILE="$tmp/mA" "$0" next D "$tmp/one" 2>&1)"; rc=$?
  [ "$rc" -eq 2 ] && case "$out" in *exhausted*) ok "exhausted letter refuses (rc=2, says exhausted)";; *) fail "rc=2 but message was '$out'";; esac || fail "exhausted letter gave rc=$rc: $out"
  out="$(ls "$tmp/one" | grep -c "^D-$day-B" || true)"; [ "$out" = 0 ] && ok "the exhausted run claimed nothing under letter B (negative control)" || fail "$out B-IDs leaked into machine A's store"

  # arm 6: a store that is a single FILE with headers counts as taken; a folder searched recursively
  printf '## D-%s-A01 -- x\n' "$day" > "$tmp/legacy.md"; mkdir -p "$tmp/deep/open"; : > "$tmp/deep/open/D-$day-A02-slug.md"
  out="$(PJ_MACHINE_FILE="$tmp/mA" "$0" next D "$tmp/legacy.md" "$tmp/deep")"; [ "$out" = "D-$day-A03" ] && ok "file header and nested file both count as taken -> -A03" || fail "got '$out'"

  # arm 7: a bad letter refuses; each form separately
  local bad
  for bad in 'a' 'AB' '1' ''; do
    printf 'name: x\nletter: %s\n' "$bad" > "$tmp/mbad"
    PJ_MACHINE_FILE="$tmp/mbad" "$0" next D "$tmp/s" >/dev/null 2>&1; rc=$?
    [ "$rc" -eq 2 ] && ok "letter '$bad' refuses (rc=2)" || fail "letter '$bad' gave rc=$rc"
  done

  # arm 8: no name, and an unknown kind
  printf 'letter: A\n' > "$tmp/mnoname"
  PJ_MACHINE_FILE="$tmp/mnoname" "$0" next D "$tmp/s" >/dev/null 2>&1; rc=$?
  [ "$rc" -eq 2 ] && ok "a machine file with no name: refuses (rc=2)" || fail "no-name rc=$rc"
  PJ_MACHINE_FILE="$tmp/mA" "$0" next Q "$tmp/s" >/dev/null 2>&1; rc=$?
  [ "$rc" -eq 2 ] && ok "unknown kind refuses (rc=2)" || fail "unknown kind rc=$rc"

  # arm 8b: a machine NAME WITH SPACES must not leak into the ID. Measured 2026-09-21:
  # `read -r name letter` word-split it and minted `W-<day>-box A01` with exit 0.
  printf 'name: my box\nletter: A\n' > "$tmp/mspace"
  out="$(PJ_MACHINE_FILE="$tmp/mspace" "$0" next W "$tmp/s")"; rc=$?
  [ "$rc" -eq 0 ] && [ "$out" = "W-$day-A01" ] && ok "a machine name with spaces still mints -A01" || fail "spaced name gave rc=$rc '$out'"
  case "$out" in *" "*) fail "the minted ID contains a space: '$out'";; *) ok "the minted ID has no space in it";; esac

  # arm 9: a LEGACY file in the store does not block, and does not get re-minted
  mkdir -p "$tmp/mixed"; : > "$tmp/mixed/W-$day-01.md"
  out="$(PJ_MACHINE_FILE="$tmp/mA" "$0" next W "$tmp/mixed")"
  [ "$out" = "W-$day-A01" ] && ok "a legacy W-$day-01 in the store does not change the new ID (-A01)" || fail "legacy file gave '$out'"
  case "$out" in *-A*) ok "every minted ID carries a letter (no bare-NN shape is ever produced)";; *) fail "minted '$out' with no letter";; esac

  # arm 10: `range` still answers, as a deprecated alias, and says so on stderr
  out="$(PJ_MACHINE_FILE="$tmp/mA" "$0" range 2>"$tmp/dep")"; rc=$?
  [ "$rc" -eq 0 ] && [ "$out" = "one A" ] && ok "the old 'range' verb still prints NAME LETTER" || fail "range gave rc=$rc '$out'"
  grep -q -i 'deprecated' "$tmp/dep" && ok "'range' announces it is deprecated on stderr" || fail "no deprecation notice: $(cat "$tmp/dep")"

  if [ "$fails" -eq 0 ]; then echo "pj-id --selftest: all arms pass"; return 0; fi
  echo "pj-id --selftest: FAILURES above"; return 1
}

case "${1:-}" in
  --selftest) selftest; exit $? ;;
  --help|-h|"") usage; exit 0 ;;
  machine) read_machine; exit $? ;;
  range) printf 'pj-id: note: `range` is deprecated (the two-range scheme was retired 2026-09-21); use `pj-id machine`.\n' >&2; read_machine; exit $? ;;
  next) shift; cmd_next "$@"; exit $? ;;
  *) refuse "unknown command $1 (machine | next | --selftest)" ;;
esac
