oi_other add "same id from other" --done-when x >/dev/null 2>&1; git -C "$OTHER" push -q 2>/dev/null
# DC2 stands for a clone on ANOTHER box, so it gets its own claim folder: claim folders are
# machine state and never sync (D-20260923-A10). Sharing one here would stop the clash this
# arm exists to provoke, which no two real machines could do.
( cd "$ZETA" && PJ_ID_CLAIMS_DIR="$ROOT/claims-dc2" OPEN_ITEMS_PROJECTS_DIR="$DC2/projects" OPEN_ITEMS_DOTCLAUDE="$DC2" "$OI" add "same id from here" --done-when x >/dev/null 2>&1 )
