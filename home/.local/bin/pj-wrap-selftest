# --- H: the push failure DIAGNOSIS names the right cause (P8a gate Q5) -----------------------
# The message used to blame the sandbox unconditionally, which was wrong every time the
# sandbox was already off (F3, P6b). Both arms, and each must EXCLUDE the other's wording --
# a message containing both sentences would pass a one-sided check while telling you nothing.
AA(){ OUT="$(PJ_WRAP_KEYCHAIN="$1" "$WRAP" why-auth 2>&1)"; RC=$?; }
AA yes
check "H why-auth exits 0 and pushes nothing" '[ "$RC" -eq 0 ]'
check "H keychain answers -> says it is NOT the sandbox" 'printf "%s" "$OUT" | grep -q "not the sandbox"'
check "H keychain answers -> names the stale App token"  'printf "%s" "$OUT" | grep -qi "stale or expired GitHub App token"'
check "H keychain answers -> does NOT tell you to lift the sandbox" '! printf "%s" "$OUT" | grep -q "with the sandbox lifted"'
AA no
check "H keychain silent -> says to lift the sandbox for this one command" 'printf "%s" "$OUT" | grep -q "with the sandbox lifted"'
check "H keychain silent -> does NOT claim the Keychain answered" '! printf "%s" "$OUT" | grep -q "DOES answer"'
check "H both arms name [H12] step 1 verbatim" 'printf "%s" "$OUT" | grep -q "git credential-cache exit"'
check "H both arms name [H12] steps 2 and 3" 'printf "%s" "$OUT" | grep -q "github-agent-token token" && printf "%s" "$OUT" | grep -q "githubagent.tier"'
# The advice NAMES the ghs_ prefix on purpose ([H12] step 2), so the check must reject a
# real token, not the word. A token is the prefix plus at least 20 more characters.
check "H the advice names the ghs_ prefix (positive control for the next arm)" 'printf "%s" "$OUT" | grep -q "ghs_"'
check "H the advice never prints an actual credential" '! printf "%s" "$OUT" | grep -qE "gh[pousr]_[A-Za-z0-9]{20,}"'
# THE REAL BRANCH, not just the seam. The two arms above drive PJ_WRAP_KEYCHAIN, which
# proves the wording and nothing about the probe. A stub `security` first on PATH lets the
# actual detection run. Three exit codes: success, 44 (item not found / sandbox), and 51
# (errSecInteractionNotAllowed) -- the third is the one that used to read as "it answered".
STUB="$ROOT/stub"; mkdir -p "$STUB"
sec_rc(){ printf '#!/bin/sh\nexit %s\n' "$1" > "$STUB/security"; chmod +x "$STUB/security"
          OUT="$(PATH="$STUB:$PATH" "$WRAP" why-auth 2>&1)"; }
sec_rc 0
check "H real probe: security exit 0 -> the Keychain answered" 'printf "%s" "$OUT" | grep -q "DOES answer"'
sec_rc 44
check "H real probe: security exit 44 -> not answering here" 'printf "%s" "$OUT" | grep -q "not answering in this shell"'
sec_rc 51
check "H real probe: any OTHER non-zero also reads as not answering (the conservative arm)" 'printf "%s" "$OUT" | grep -q "not answering in this shell"'
check "H real probe: exit 51 does NOT claim the Keychain answered" '! printf "%s" "$OUT" | grep -q "DOES answer"'
# NO `security` binary at all (Linux, audit A10). A PATH holding only bash, so the real
# `command -v security` probe runs and misses. It used to read that as "DOES answer".
NOSEC="$ROOT/nosec"; mkdir -p "$NOSEC"; ln -s "$BASH" "$NOSEC/bash"
OUT="$(PATH="$NOSEC" "$WRAP" why-auth 2>&1)"; RC=$?
check "H control: the stripped PATH really has no security binary, and pj-wrap ran (rc 0)" '! PATH="$NOSEC" command -v security >/dev/null 2>&1 && [ "$RC" -eq 0 ]'
check "H no security binary -> says there is no Keychain on this OS" 'printf "%s" "$OUT" | grep -q "no Keychain on this OS"'
check "H no security binary -> does NOT claim the Keychain answered" '! printf "%s" "$OUT" | grep -q "DOES answer"'
check "H no security binary -> no sandbox advice either, still the [H12] steps" '! printf "%s" "$OUT" | grep -q "with the sandbox lifted" && printf "%s" "$OUT" | grep -q "git credential-cache exit"'

# --- I: misc ------------------------------------------------------------------------------
wrap bogus; check "I unknown command REFUSES (rc 2)" '[ "$RC" -eq 2 ]'
wrap --help; check "I --help rc 0, usage first" '[ "$RC" -eq 0 ] && printf "%s" "$OUT" | grep -q "^Usage:"'
check "I usage names --skill, --owed, owed --clear and ends at --selftest" 'printf "%s" "$OUT" | grep -q -- "--skill" && printf "%s" "$OUT" | grep -q -- "--owed" && printf "%s" "$OUT" | grep -q "owed --clear" && [ "$(printf "%s\n" "$OUT" | tail -1 | grep -c -- "--selftest")" -eq 1 ]'
check "I bash -n clean" 'bash -n "$WRAP"'
check "I nothing personal: no \$HOME in printed status paths" '! printf "%s" "$(SID=x; cd "$ZETA" && "$WRAP" status 2>&1)" | grep -q "$HOME"'

# --- J: the wrap-up skill text (S4A, Gavin's pick 5 Oct 2026) ------------------------------
# Wrap-up applies its verdicts without an approval box. Step 3 must hold no pop-up that
# approves the table, and the questions that stay his (decide rows, a ruling, a decline,
# a new drawer) must still be asked. Control: the step was found and is not empty.
SKILL="${PJ_WRAP_SKILL:-$BIN/../../.claude/pj/skills/wrap-up/SKILL.md}"
