#!/usr/bin/env bash
# pj-wrap-selftest -- proves every arm of pj-wrap against throwaway fixtures: status on
# no, one and three records; done with and without a session id, with --keep-earlier;
# push with nothing to push, accepted, rejected with a clean tree (rebased), rejected
# with a DIRTY tree (stopped, tree byte-identical), a conflict in the generated OPEN.md
# (regenerated, never merged) and a conflict elsewhere (aborted, tree as it was).
# Nothing here touches ~/.local/state, ~/.claude or any real repo.
# Read this whole file before running any of it, so an edit saved mid-run cannot change
# the run (W-20260923-A57). A crash under it exits 127 (unbound var) or 1 (bash 3.2 syntax
# error); `selftest-whole-read --help` has the map. Do not move or reword these lines.
[ -n "${SELFTEST_WHOLE_READ-}" ] || SELFTEST_WHOLE_READ=1 exec "$BASH" -c 'shopt -u sourcepath; . "$0"' "$0" "$@"
unset SELFTEST_WHOLE_READ

set -uo pipefail
BIN="$(cd "$(dirname "$0")" && pwd -P)"
WRAP="${PJ_WRAP:-$BIN/pj-wrap}"; OI="${OPEN_ITEMS_TOOL:-$BIN/open-items}"
[ -x "$WRAP" ] && [ -x "$OI" ] || { echo "need pj-wrap and open-items next to this selftest"; exit 1; }
ROOT="$(mktemp -d "${TMPDIR:-/tmp}/pj-wrap-selftest.XXXXXX")" || exit 1
ROOT="$(cd "$ROOT" && pwd -P)"
export GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_SYSTEM=/dev/null GIT_AUTHOR_NAME=t GIT_AUTHOR_EMAIL=t@t GIT_COMMITTER_NAME=t GIT_COMMITTER_EMAIL=t@t
export PATH="$BIN:$PATH"
# BLANK BOTH session variables (M16). pj-wrap falls back to CLAUDE_SESSION_ID, so a selftest
# run inside a session that exports it saw a session id in every "no session id" arm.
unset CLAUDE_SESSION_ID CLAUDE_CODE_SESSION_ID
STATE="$ROOT/state"; export PJ_STATE_DIR="$STATE"
# PIN THE MACHINE LETTER (P8a). Every ID pj-id mints carries this box's letter, so an arm
# that matched a bare -NN passed on the mini and would fail on the laptop. A fixture letter
# makes the IDs identical on all four machines -- and proves the tool works on a box whose
# real ~/.config/pj/machine does not exist yet, which is B, C and D on day one.
printf 'name: selftest-fixture\nletter: Z\n' > "$ROOT/machine"; export PJ_MACHINE_FILE="$ROOT/machine"
# A FIXTURE claim folder (D-20260923-A10). pj-id refuses a fixture machine file with the real
# ~/.local/state/pj/ids, so without this every add here fails and the push arms find nothing.
export PJ_ID_CLAIMS_DIR="$ROOT/claims"
# Never the machine's real engage-go: every arm runs as "not moved" unless section HM puts
# its own fake in (Gavin, 6 Oct 2026: homes asks the move marker first). mk_eg <name> <body>.
mk_eg(){ mkdir -p "$ROOT/eg-$1"; printf '#!/bin/sh\nprintf "%%s\\n" "$*" > "%s/eg-%s/ran"\n%s\n' "$ROOT" "$1" "$2" > "$ROOT/eg-$1/engage-go"; chmod +x "$ROOT/eg-$1/engage-go"; }
mk_eg stay 'echo "not moved: pj-wrap selftest"; exit 1'
export PJ_WRAP_ENGAGE_GO="$ROOT/eg-stay/engage-go"
PASS=0; FAIL=0
ok(){ PASS=$((PASS+1)); printf '  ok   %s\n' "$1"; }
bad(){ FAIL=$((FAIL+1)); printf '  FAIL %s\n       got: %s\n' "$1" "$(printf '%s' "${OUT:-}" | tr '\n' '|' | cut -c1-900)"; }
check(){ if eval "$2"; then ok "$1"; else bad "$1"; fi; }
encode_key(){ printf '%s' "$1" | sed 's#[/._]#-#g'; }
nstate(){ find "$STATE" -type f 2>/dev/null | wc -l | tr -d ' '; }
snapshot(){ ( cd "$1" && find . -path ./.git -prune -o -type f -print | sort | xargs shasum -a 256; git status --porcelain; git rev-parse HEAD ) 2>/dev/null; }
echo "pj-wrap selftest in $ROOT"

# --- fixture: a project repo, a bare remote, "dot-claude" DC and a second clone OTHER ---------
ZETA="$ROOT/zeta"; mkdir -p "$ZETA"; git -C "$ZETA" init -q
KEY="$(encode_key "$ZETA")"
REMOTE="$ROOT/remote.git"; git init -q --bare "$REMOTE"
DC="$ROOT/dc"; git clone -q "$REMOTE" "$DC" 2>/dev/null; git -C "$DC" checkout -q -b master 2>/dev/null
printf 'seed\n' > "$DC/notes.txt"; git -C "$DC" add notes.txt; git -C "$DC" commit -q -m seed; git -C "$DC" push -q -u origin master 2>/dev/null
OTHER="$ROOT/other"; git clone -q "$REMOTE" "$OTHER" 2>/dev/null
oi(){   ( cd "$ZETA" && OPEN_ITEMS_PROJECTS_DIR="$DC/projects" OPEN_ITEMS_DOTCLAUDE="$DC" "$OI" "$@" ); }
oi_other(){ ( cd "$ZETA" && OPEN_ITEMS_PROJECTS_DIR="$OTHER/projects" OPEN_ITEMS_DOTCLAUDE="$OTHER" "$OI" "$@" ); }
wrap(){ OUT="$(cd "$ZETA" && OPEN_ITEMS_PROJECTS_DIR="$DC/projects" OPEN_ITEMS_DOTCLAUDE="$DC" CLAUDE_SESSION_ID= CLAUDE_CODE_SESSION_ID="${SID-}" "$WRAP" "$@" 2>&1)"; RC=$?; return 0; }
mkdir -p "$DC/projects/$KEY/memory/WORK"
oi init >/dev/null 2>&1; oi add "seed item" --done-when x >/dev/null 2>&1
git -C "$DC" push -q origin master 2>/dev/null; git -C "$OTHER" pull -q 2>/dev/null
W="$DC/projects/$KEY/memory/WORK"
[ -f "$W/OPEN.md" ] || { echo "fixture broken: no OPEN.md"; exit 1; }

# --- A: status -------------------------------------------------------------------------------
FLAG="$STATE/no-wrap-up/$KEY"; mkdir -p "$STATE/no-wrap-up"
SID=this-session
wrap status
check "A no flag -> rc 1 and says so" '[ "$RC" -eq 1 ] && printf "%s" "$OUT" | grep -q "no earlier session"'
printf 'project: zeta\nrepo: %s\nended: 2026-09-20 10:00\nsession: s-one\ntranscript: %s/t1.jsonl\nmessages: 3\nedits: 1\n' "$ZETA" "$ROOT" > "$FLAG"
wrap status
check "A one record -> rc 0" '[ "$RC" -eq 0 ]'
check "A says 1 earlier session" 'printf "%s" "$OUT" | grep -q "^pj-wrap: 1 earlier session"'
check "A lists the transcript path" 'printf "%s" "$OUT" | grep -q "transcript: $ROOT/t1.jsonl"'
check "A lists the counts" 'printf "%s" "$OUT" | grep -q "(3 messages, 1 edits)"'
printf 'project: zeta\nrepo: %s\nended: 2026-09-20 12:00\nsession: s-three\ntranscript: %s/t3.jsonl\n\nproject: zeta\nrepo: %s\nended: 2026-09-20 11:00\nsession: this-session\ntranscript: %s/t2.jsonl\n\n' "$ZETA" "$ROOT" "$ZETA" "$ROOT" | cat - "$FLAG" > "$FLAG.new" && mv "$FLAG.new" "$FLAG"
wrap status
check "A three records -> says 3" 'printf "%s" "$OUT" | grep -q "^pj-wrap: 3 earlier session"'
check "A newest first" '[ "$(printf "%s\n" "$OUT" | grep -o "session s-[a-z]*" | head -1)" = "session s-three" ]'
check "A all three transcripts listed" '[ "$(printf "%s\n" "$OUT" | grep -c "transcript: $ROOT/t[123].jsonl")" -eq 3 ]'
check "A names this session when it is in the list" 'printf "%s" "$OUT" | grep -q "THIS session"'
( cd "$ROOT" && PJ_STATE_DIR="$STATE" "$WRAP" status >/dev/null 2>&1 ); check "A outside a repo REFUSES (rc 2)" '[ $? -eq 2 ]'

# --- B: done ---------------------------------------------------------------------------------
BEFORE="$(nstate)"
SID=""; wrap done
check "B done without a session id REFUSES (rc 2)" '[ "$RC" -eq 2 ]'
check "B and moved nothing" '[ -f "$FLAG" ] && [ "$(nstate)" -eq "$BEFORE" ]'
SID=this-session; wrap done --keep-earlier
check "B done --keep-earlier rc 0" '[ "$RC" -eq 0 ]'
check "B marker written" '[ -f "$STATE/wrapped/this-session" ]'
check "B flag KEPT" '[ -f "$FLAG" ] && printf "%s" "$OUT" | grep -q "KEPT"'
wrap done
check "B done rc 0" '[ "$RC" -eq 0 ]'
check "B flag gone from no-wrap-up/" '[ ! -e "$FLAG" ]'
check "B flag MOVED to handled/, not deleted" '[ "$(ls "$STATE/no-wrap-up/handled/" | grep -c "^$KEY\.")" -eq 1 ]'
check "B handled copy still holds all three records" '[ "$(cat "$STATE/no-wrap-up/handled/$KEY".* | grep -c "^session:")" -eq 3 ]'
check "B file count under state: flag + marker = before + 1, nothing lost" '[ "$(nstate)" -eq $((BEFORE + 1)) ]'
wrap done
check "B done again with no flag: rc 0, says so" '[ "$RC" -eq 0 ] && printf "%s" "$OUT" | grep -q "no earlier-session flag"'
wrap done --bogus; check "B unknown flag REFUSES" '[ "$RC" -eq 2 ]'

# --- B2: via (W6), the CHECKED marker write (W-20260924-A25), owed records (W5) --------------
MK="$STATE/wrapped/this-session"
check "B bare done writes via: bare" 'grep -qx "via: bare" "$MK"'
wrap done --skill
check "B done --skill rc 0, writes via: skill" '[ "$RC" -eq 0 ] && grep -qx "via: skill" "$MK" && ! grep -q "via: bare" "$MK"'
check "B marker keeps wrapped: and project: lines" 'grep -q "^wrapped: [0-9-]* [0-9:]*$" "$MK" && grep -qx "project: zeta" "$MK"'
# A refused write, two ways. The marker path is a directory (the write cannot succeed),
# and a read-only wrapped/ (the sandbox's EPERM shape). Each must REFUSE, never claim.
printf 'project: zeta\nsession: s-refused\n' > "$FLAG"
mkdir -p "$STATE/wrapped/refused-sid"
SID=refused-sid; wrap done
check "B marker write refused (path is a dir) -> rc 2" '[ "$RC" -eq 2 ]'
check "B refused write never prints marked wrapped" '! printf "%s" "$OUT" | grep -q "marked wrapped,"'
check "B refused write says NOT marked wrapped" 'printf "%s" "$OUT" | grep -q "NOT marked wrapped"'
check "B refused write left the no-wrap-up flag in place" '[ -f "$FLAG" ]'
chmod 555 "$STATE/wrapped"
SID=readonly-sid; wrap done
chmod 755 "$STATE/wrapped"
check "B read-only wrapped/ -> rc 2 and no marker file" '[ "$RC" -eq 2 ] && [ ! -e "$STATE/wrapped/readonly-sid" ] && printf "%s" "$OUT" | grep -q "NOT marked wrapped"'
SID=readonly-sid; wrap done
check "B control: same session, writable again -> rc 0, marker written, flag moved" '[ "$RC" -eq 0 ] && [ -f "$STATE/wrapped/readonly-sid" ] && [ ! -e "$FLAG" ]'
# owed
SID=this-session
OWED="$STATE/owed/$KEY"
wrap done --owed "/wrap-up"
check "B done --owed rc 0 and says owed" '[ "$RC" -eq 0 ] && printf "%s" "$OUT" | grep -q "owed: /wrap-up, recorded"'
check "B owed record: keys owed, project, session, since in that order" '[ "$(sed -n "s/^\([a-z]*\): .*/\1/p" "$OWED" | tr "\n" " ")" = "owed project session since " ]'
check "B owed record values" 'grep -qx "owed: /wrap-up" "$OWED" && grep -qx "project: zeta" "$OWED" && grep -qx "session: this-session" "$OWED" && grep -Eqx "since: [0-9]{4}-[0-9]{2}-[0-9]{2} [0-9]{2}:[0-9]{2}" "$OWED"'
check "B owed done still marks wrapped (via: bare)" 'grep -qx "via: bare" "$MK"'
wrap done --skill --owed "/release patch" --keep-earlier
check "B --owed combines with --skill and --keep-earlier" '[ "$RC" -eq 0 ] && grep -qx "via: skill" "$MK" && [ "$(grep -c "^owed: " "$OWED")" -eq 2 ]'
check "B two owed records, exactly one blank line between" '[ "$(grep -c "^$" "$OWED")" -eq 1 ] && [ "$(sed -n 6p "$OWED")" = "owed: /release patch" ]'
OSNAP="$(shasum "$OWED")"; MSNAP="$(shasum "$MK")"
wrap done --owed "";                       R1=$RC
wrap done --owed "   ";                    R2=$RC
wrap done --owed "$(printf 'a\tb')";       R3=$RC
wrap done --owed "$(printf '/a\nowed: b')"; R4=$RC
wrap done --owed;                          R5=$RC
check "B --owed empty, blank, tab, newline, missing -> all rc 2" '[ "$R1$R2$R3$R4$R5" = "22222" ]'
check "B and none of them wrote: owed file and marker byte-identical" '[ "$(shasum "$OWED")" = "$OSNAP" ] && [ "$(shasum "$MK")" = "$MSNAP" ]'
wrap owed
check "B owed lists both records, rc 0" '[ "$RC" -eq 0 ] && printf "%s" "$OUT" | grep -q "^pj-wrap: 2 owed record" && printf "%s" "$OUT" | grep -q "1. /wrap-up  since" && printf "%s" "$OUT" | grep -q "2. /release patch  since"'
wrap owed --clear "/nope"
check "B owed --clear of a command not owed -> rc 1, nothing moved" '[ "$RC" -eq 1 ] && [ "$(shasum "$OWED")" = "$OSNAP" ] && [ ! -d "$STATE/owed/handled" -o -z "$(ls "$STATE/owed/handled")" ]'
wrap owed --clear "pj:wrap-up"
check "B owed --clear pj:wrap-up does NOT clear /wrap-up (exact name, never a suffix)" '[ "$RC" -eq 1 ] && [ "$(shasum "$OWED")" = "$OSNAP" ]'
wrap owed --clear "release patch"
check "B owed --clear one command (no slash) -> rc 0" '[ "$RC" -eq 0 ] && printf "%s" "$OUT" | grep -q "1 other record"'
check "B that command moved to owed/handled, the other still owed" '[ "$(grep -c "^owed: " "$OWED")" -eq 1 ] && grep -qx "owed: /wrap-up" "$OWED" && grep -qx "owed: /release patch" "$STATE/owed/handled/$KEY".*'
check "B the kept file is a clean record (no leading blank line)" '[ "$(head -1 "$OWED")" = "owed: /wrap-up" ]'
wrap owed --clear
check "B owed --clear with no command -> rc 0, the file moved" '[ "$RC" -eq 0 ] && [ ! -e "$OWED" ]'
check "B nothing deleted: 2 owed records across owed/handled/, 2 files" '[ "$(cat "$STATE/owed/handled/"* | grep -c "^owed: ")" -eq 2 ] && [ "$(ls "$STATE/owed/handled" | grep -c "^$KEY\.")" -eq 2 ]'
wrap owed
check "B owed with nothing owed -> rc 1" '[ "$RC" -eq 1 ] && printf "%s" "$OUT" | grep -q "nothing owed"'
wrap owed --clear
check "B owed --clear with nothing owed -> rc 1" '[ "$RC" -eq 1 ]'
wrap owed --bogus; check "B owed unknown argument REFUSES" '[ "$RC" -eq 2 ]'

# --- C: push, nothing to push --------------------------------------------------------------
wrap push
check "C nothing to push -> rc 1" '[ "$RC" -eq 1 ] && printf "%s" "$OUT" | grep -q "nothing to push"'

# --- D: push accepted ----------------------------------------------------------------------
oi add "second item" --done-when x >/dev/null 2>&1
wrap push
check "D push accepted rc 0" '[ "$RC" -eq 0 ] && printf "%s" "$OUT" | grep -q "push accepted"'
check "D remote head == local head" '[ "$(git -C "$REMOTE" rev-parse master)" = "$(git -C "$DC" rev-parse HEAD)" ]'

# --- D1: a drawer handoff (pj-homes handoff: drawer:) is committed by explicit path before the push
mkdir -p "$ZETA/.claude"; printf 'handoff: drawer:OPENING-PROMPT.md\n' > "$ZETA/.claude/pj-homes"
printf '<!-- generated by /pj:wrap-up -->\nhandoff body\n' > "$W/OPENING-PROMPT.md"
printf 'not the handoff\n' > "$W/stray.txt"
wrap push
check "D1 handoff present -> rc 0" '[ "$RC" -eq 0 ] && printf "%s" "$OUT" | grep -q "handoff committed"'
check "D1 handoff is in the remote" 'git -C "$REMOTE" cat-file -e "master:projects/$KEY/memory/WORK/OPENING-PROMPT.md"'
check "D1 the stray drawer file was NOT committed (explicit path only)" '! git -C "$REMOTE" cat-file -e "master:projects/$KEY/memory/WORK/stray.txt" 2>/dev/null && [ -n "$(git -C "$DC" status --porcelain -- "$W/stray.txt")" ]'
check "D1 message names dot-claude, never the project repo" 'printf "%s" "$OUT" | grep -q "never pushes the project repo"'
command mv "$W/stray.txt" "$ROOT/stray.moved"
wrap push
check "D1 unchanged handoff -> nothing to push (rc 1), no new commit" '[ "$RC" -eq 1 ]'

# --- P1: W1, commits that are not this session's are NAMED before the push, grouped ---------
# The trailer block is the shape a real dot-claude commit carries (five C- trailers).
SID=this-session
dcommit(){  # dcommit <subject> [<C-Sess-Id>]
  printf '%s\n' "$1" >> "$DC/p.txt"; git -C "$DC" add p.txt
  if [ -n "${2-}" ]; then
    git -C "$DC" commit -q -m "$1" -m "$(printf 'C-Sess-Id: %s\nC-Web-Id: https://claude.ai/code/session_fixture\nC-Branch: master\nC-Worktree: .\nC-Wt-Path: ~/dc' "$2")"
  else git -C "$DC" commit -q -m "$1"; fi
}
dcommit "p1 from other-a" other-a; dcommit "p2 mine" this-session; dcommit "p3 from other-a again" other-a; dcommit "p4 no trailer"
wrap push
check "P1 W1 still pushes (rc 0, accepted)" '[ "$RC" -eq 0 ] && printf "%s" "$OUT" | grep -q "push accepted"'
check "P1 W1 says 3 of 4 are not from this session" 'printf "%s" "$OUT" | grep -q "3 of 4 commit(s) to push are NOT this session"'
check "P1 W1 groups session other-a with its count" 'printf "%s" "$OUT" | grep -q "session other-a (2):"'
check "P1 W1 names both other-a subjects" 'printf "%s" "$OUT" | grep -q "p1 from other-a$" && printf "%s" "$OUT" | grep -q "p3 from other-a again$"'
check "P1 W1 names the commit with no trailer" 'printf "%s" "$OUT" | grep -q "no C-Sess-Id trailer (1):" && printf "%s" "$OUT" | grep -q "p4 no trailer$"'
check "P1 W1 does NOT list the commit from this session" '! printf "%s" "$OUT" | grep -q "p2 mine"'
check "P1 W1 the list comes BEFORE the push" '[ "$(printf "%s\n" "$OUT" | grep -n "NOT this session" | cut -d: -f1)" -lt "$(printf "%s\n" "$OUT" | grep -n "^pj-wrap: pushing" | cut -d: -f1)" ]'
dcommit "p5 mine" this-session
wrap push
check "P1 control: only a commit from this session -> says so, lists nothing" '[ "$RC" -eq 0 ] && printf "%s" "$OUT" | grep -q "all 1 commit(s) to push carry this session" && ! printf "%s" "$OUT" | grep -q "NOT this session"'
dcommit "p6 mine but unknown" this-session
SID=""; wrap push; SID=this-session
check "P1 no session id -> every commit listed, and it says why" '[ "$RC" -eq 0 ] && printf "%s" "$OUT" | grep -q "id is not in the environment" && printf "%s" "$OUT" | grep -q "p6 mine but unknown"'

# --- P2: W3, a GENERATED handoff over 60 lines is warned with its count --------------------
gen(){ { printf '<!-- generated by /pj:wrap-up -->\n'; i=2; while [ "$i" -le "$1" ]; do printf 'line %s %s\n' "$i" "$3"; i=$((i+1)); done; } > "$2"; }
gen 61 "$W/OPENING-PROMPT.md" a
wrap push
check "P2 drawer handoff of 61 lines -> WARNING with the count" '[ "$RC" -eq 0 ] && printf "%s" "$OUT" | grep -q "WARNING: the generated handoff .*OPENING-PROMPT.md is 61 lines, over the 60-line cap"'
gen 60 "$W/OPENING-PROMPT.md" b
wrap push
check "P2 control: 60 lines -> no warning" '[ "$RC" -eq 0 ] && ! printf "%s" "$OUT" | grep -q "WARNING"'
{ printf '# written by the project, no marker\n'; seq 1 80; } > "$W/OPENING-PROMPT.md"
wrap push
check "P2 control: 81 lines WITHOUT the marker -> no warning (the project owns it, W2)" '[ "$RC" -eq 0 ] && ! printf "%s" "$OUT" | grep -q "WARNING"'
printf 'handoff: repo:HANDOFF.md\n' > "$ZETA/.claude/pj-homes"; gen 75 "$ZETA/HANDOFF.md" c
wrap push
check "P2 repo: handoff of 75 lines -> WARNING even with nothing to push (rc 1)" '[ "$RC" -eq 1 ] && printf "%s" "$OUT" | grep -q "HANDOFF.md is 75 lines"'
printf 'records: private\n' > "$ZETA/.claude/pj-homes"; gen 62 "$ZETA/OPENING-PROMPT.md" d
wrap push
check "P2 no handoff: key -> the default repo:OPENING-PROMPT.md is counted" 'printf "%s" "$OUT" | grep -q "zeta/OPENING-PROMPT.md is 62 lines"'
printf 'handoff: drawer:OPENING-PROMPT.md\n' > "$ZETA/.claude/pj-homes"

# --- P3: E8, branch and upstream are checked BEFORE the handoff is committed ---------------
gen 5 "$W/OPENING-PROMPT.md" e
git -C "$DC" checkout -q --detach; HB="$(git -C "$DC" rev-parse HEAD)"
wrap push
check "P3 detached HEAD -> STOPPED (rc 3)" '[ "$RC" -eq 3 ] && printf "%s" "$OUT" | grep -q "detached HEAD"'
check "P3 detached HEAD -> the handoff was NOT committed (HEAD unchanged, file still modified)" '[ "$(git -C "$DC" rev-parse HEAD)" = "$HB" ] && [ -n "$(git -C "$DC" status --porcelain -- "$W/OPENING-PROMPT.md")" ]'
git -C "$DC" checkout -q master; git -C "$DC" checkout -q -b p3-noup; HB="$(git -C "$DC" rev-parse HEAD)"
wrap push
check "P3 no upstream -> STOPPED, handoff NOT committed" '[ "$RC" -eq 3 ] && printf "%s" "$OUT" | grep -q "no upstream" && [ "$(git -C "$DC" rev-parse HEAD)" = "$HB" ] && [ -n "$(git -C "$DC" status --porcelain -- "$W/OPENING-PROMPT.md")" ]'
git -C "$DC" checkout -q master
wrap push
check "P3 control: back on master -> handoff committed and pushed" '[ "$RC" -eq 0 ] && printf "%s" "$OUT" | grep -q "handoff committed" && [ -z "$(git -C "$DC" status --porcelain -- "$W/OPENING-PROMPT.md")" ]'

# --- P4: W-20260924-A12, "Everything up-to-date" is not an auth failure ---------------------
# A stub git first on PATH answers `push` with git's own up-to-date line (the text quoted in
# A12) and hands every other call to the real git. No real remote could be made to do this
# on demand; the cause in A12 is still unknown, so the arm fixes the REPORTING only.
REALGIT="$(command -v git)"; GSTUB="$ROOT/gitstub"; mkdir -p "$GSTUB"
stubgit(){  # stubgit <exit code> <say up-to-date: yes|no>
  printf '#!/bin/sh\nfor a in "$@"; do [ "$a" = push ] && { [ "%s" = yes ] && echo "Everything up-to-date" >&2; exit %s; }; done\nexec "%s" "$@"\n' "$2" "$1" "$REALGIT" > "$GSTUB/git"; chmod +x "$GSTUB/git"
}
wrapg(){ OUT="$(cd "$ZETA" && PATH="$GSTUB:$PATH" OPEN_ITEMS_PROJECTS_DIR="$DC/projects" OPEN_ITEMS_DOTCLAUDE="$DC" CLAUDE_SESSION_ID= CLAUDE_CODE_SESSION_ID="${SID-}" "$WRAP" "$@" 2>&1)"; RC=$?; }
dcommit "p7 pending" this-session
stubgit 1 yes; wrapg push
check "P4 push exit 1 + up-to-date while ahead -> STOPPED (rc 3), its own case" '[ "$RC" -eq 3 ] && printf "%s" "$OUT" | grep -q "not an auth failure"'
check "P4 and NO credential advice (no Keychain, no [H12] steps)" '! printf "%s" "$OUT" | grep -qi "keychain" && ! printf "%s" "$OUT" | grep -q "credential-cache"'
stubgit 0 yes; wrapg push
check "P4 push exit 0 + up-to-date while ahead -> STOPPED, never push accepted" '[ "$RC" -eq 3 ] && ! printf "%s" "$OUT" | grep -q "push accepted" && printf "%s" "$OUT" | grep -q "Everything up-to-date"'
stubgit 0 no; wrapg push
check "P4 push exit 0 but the upstream still lacks HEAD -> STOPPED, never push accepted" '[ "$RC" -eq 3 ] && ! printf "%s" "$OUT" | grep -q "push accepted" && printf "%s" "$OUT" | grep -q "went somewhere else"'
wrap push
check "P4 control: the real git -> push accepted" '[ "$RC" -eq 0 ] && printf "%s" "$OUT" | grep -q "push accepted"'
git -C "$OTHER" pull -q --rebase 2>/dev/null

# --- E: rejected, clean tree -> rebased and pushed ------------------------------------------
git -C "$OTHER" pull -q --rebase 2>/dev/null; printf 'other 1\n' > "$OTHER/other1.txt"; git -C "$OTHER" add other1.txt; git -C "$OTHER" commit -q -m other1; git -C "$OTHER" push -q 2>/dev/null
oi add "third item" --done-when x >/dev/null 2>&1
wrap push
check "E rc 0" '[ "$RC" -eq 0 ]'
check "E reported the rejection and the fetch" 'printf "%s" "$OUT" | grep -q "push rejected; fetching"'
check "E accepted after rebase" 'printf "%s" "$OUT" | grep -q "push accepted after rebase"'
check "E remote has other1 AND the third item" 'git -C "$REMOTE" cat-file -e master:other1.txt && git -C "$REMOTE" ls-tree -r --name-only master | grep -q "items/open/W-[0-9]*-Z03.md"'
check "E tree clean afterwards" '[ -z "$(git -C "$DC" status --porcelain)" ]'
check "E no rebase in progress" '[ ! -d "$DC/.git/rebase-merge" ]'

# --- F: rejected, DIRTY tree -> stopped, byte-identical --------------------------------------
git -C "$OTHER" pull -q --rebase 2>/dev/null; printf 'other 2\n' > "$OTHER/other2.txt"; git -C "$OTHER" add other2.txt; git -C "$OTHER" commit -q -m other2; git -C "$OTHER" push -q 2>/dev/null
oi add "fourth item" --done-when x >/dev/null 2>&1
printf 'someone else is editing this\n' >> "$DC/notes.txt"
printf 'untracked scratch\n' > "$DC/scratch.txt"
SNAP="$(snapshot "$DC")"; REMOTE_BEFORE="$(git -C "$REMOTE" rev-parse master)"
wrap push
check "F rc 3 STOPPED" '[ "$RC" -eq 3 ]'
check "F names the dirty path" 'printf "%s" "$OUT" | grep -q "notes.txt"'
check "F says what is needed" 'printf "%s" "$OUT" | grep -q "Commit or stash them yourself"'
check "F tree BYTE-IDENTICAL (every file hash, status and HEAD)" '[ "$(snapshot "$DC")" = "$SNAP" ]'
check "F no rebase in progress" '[ ! -d "$DC/.git/rebase-merge" ] && [ ! -d "$DC/.git/rebase-apply" ]'
check "F remote untouched" '[ "$(git -C "$REMOTE" rev-parse master)" = "$REMOTE_BEFORE" ]'
check "F no stash created" '[ -z "$(git -C "$DC" stash list)" ]'
# control: the same push with the dirt removed goes through
git -C "$DC" checkout -q -- notes.txt; command mv "$DC/scratch.txt" "$ROOT/scratch.moved"
wrap push
check "F control: clean again -> pushed" '[ "$RC" -eq 0 ]'

# --- G: conflict in the generated OPEN.md only -> regenerated, never merged -----------------
git -C "$OTHER" pull -q --rebase 2>/dev/null
OW="$OTHER/projects/$KEY/memory/WORK"
printf '## W-20260101-77 -- from other\n\nproject: zeta\nstatus: open\nkind: do\ndone-when: x\n' > "$OW/items/open/W-20260101-77.md"
oi_other regen >/dev/null 2>&1; git -C "$OTHER" push -q 2>/dev/null
oi add "from here" --done-when x >/dev/null 2>&1
wrap push
check "G rc 0" '[ "$RC" -eq 0 ]'
check "G took the generated conflict path" 'printf "%s" "$OUT" | grep -q "conflict only in generated files"'
check "G regenerated" 'printf "%s" "$OUT" | grep -q "OPEN.md regenerated"'
check "G remote OPEN.md holds BOTH titles" 'git -C "$REMOTE" show "master:projects/$KEY/memory/WORK/OPEN.md" | grep -q "from other" && git -C "$REMOTE" show "master:projects/$KEY/memory/WORK/OPEN.md" | grep -q "from here"'
check "G no conflict markers in OPEN.md" '! grep -q "^<<<<<<<\|^>>>>>>>" "$W/OPEN.md"'
check "G no hand-edit rescue was written (control: notes/ has none)" '[ -z "$(ls "$W/items/notes" 2>/dev/null | grep rescued)" ]'
check "G tree clean, nothing in progress" '[ -z "$(git -C "$DC" status --porcelain)" ] && [ ! -d "$DC/.git/rebase-merge" ]'
check "G both item files present (4 + other's 77 + here = 6)" '[ "$(ls "$W/items/open" | grep -c "^W-")" -eq 6 ]'

# --- H: conflict elsewhere -> aborted, tree as it was ----------------------------------------
git -C "$OTHER" pull -q --rebase 2>/dev/null; printf 'theirs\n' > "$OTHER/notes.txt"; git -C "$OTHER" commit -q -am theirs; git -C "$OTHER" push -q 2>/dev/null
printf 'ours\n' > "$DC/notes.txt"; git -C "$DC" commit -q -am ours
SNAP="$(snapshot "$DC")"; HEAD_BEFORE="$(git -C "$DC" rev-parse HEAD)"
