check "H tree byte-identical" '[ "$(snapshot "$DC")" = "$SNAP" ]'
check "H no rebase in progress" '[ ! -d "$DC/.git/rebase-merge" ]'

# --- G0: two clones claim the SAME W-ID (found by this selftest 2026-09-20): an item file
# is not a generated view, so it must STOP, never guess. In a throwaway clone DC2, behind origin.
DC2="$ROOT/dc2"; git clone -q "$REMOTE" "$DC2" 2>/dev/null
