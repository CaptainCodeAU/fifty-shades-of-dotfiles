#!/usr/bin/env -S uv run --quiet python3
# /// script
# requires-python = ">=3.10"
# dependencies = []
# ///
#
# ============================================================================
#  vuln-scan -- incremental CVE scan of what is actually installed
# ============================================================================
#
# WHY THIS AND NOT toolchain-cve-check
#   toolchain-cve-check answers "is this vulnerable?" from scratch every run. For
#   231 Homebrew formulae that is ~15 minutes, which is fine for an ad-hoc audit
#   and impossible for a shell prompt. This tool remembers what it has already
#   checked, so the ordinary case -- nothing changed since last login -- costs one
#   local `brew list` and one SQLite read, with NO network at all.
#
#   The cache key is (name, version, REVISION). The revision matters: Homebrew
#   ships backported security patches as a revision bump while keeping the
#   upstream version, so libssh2 1.11.1_3 and 1.11.1_4 are different things and
#   the bump must force a rescan. Keying on version alone would mean a security
#   update is never re-examined.
#
# THE THREE DOORS
#   --fast        every new terminal tab. Silent + instant when nothing changed;
#                 announces itself and shows progress when there is work to do.
#   --background  Claude SessionStart. Detaches, writes a verdict + marker file.
#   --report      writes a self-contained briefing for a context-free assistant.
#
# WHAT IT WILL NOT DO
#   Report "clean" when it could not tell. Every uncertain path -- unresolvable
#   CPE, rate limit, empty body, namesake collision -- lands on UNKNOWN. A tool
#   that is trusted and silently wrong is worse than no tool.
#
# HOMEBREW-PATCHED FINDINGS
#   NVD knows nothing about Homebrew revisions, so a formula whose fix has been
#   backported still reports vulnerable. Where a CVE description names its fix
#   commit and that commit is patched into the installed formula, the finding is
#   downgraded to `patched` and kept out of the alarm. Telling someone to upgrade
#   a package they just upgraded is how a security alert stops being read.
#
# EXIT CODES
#   0  nothing actionable
#   1  at least one un-acknowledged HIGH or CRITICAL finding
#   2  scan could not run (no brew, no network on a cold database, etc.)
# ============================================================================

import argparse
import json
import os
import subprocess
import sys
import time

# Look for vulnlib.py beside BOTH the symlink and the real file. This tool is
# deployed as a stow-style symlink into ~/.local/bin, so `abspath` finds the
# deployed copy while `realpath` finds the repo source. Trying only one of them
# means the tool dies with ImportError the first time the pair is half-deployed --
# and a security check that fails to start is indistinguishable from one that
# passed, which is the whole failure mode this project keeps designing against.
for _d in (os.path.dirname(os.path.realpath(__file__)),
           os.path.dirname(os.path.abspath(__file__))):
    if _d not in sys.path:
        sys.path.insert(0, _d)
try:
    import vulnlib as V  # noqa: E402
except ImportError:  # pragma: no cover
    sys.stderr.write("vuln-scan: cannot find vulnlib.py beside this script "
                     "(deploy both, or run ./install.sh --stow-only)\n")
    sys.exit(2)

ACTION_THRESHOLD = 7.0          # CVSS at or above this becomes an action item
SUBJECT = "brew"

# How many packages --fast will check INLINE before refusing and detaching.
# This is the guard that keeps the tool out of the "why is my terminal frozen"
# category. A cold database has 231 packages to check at roughly 1-4s each; a
# login shell that blocks for a quarter of an hour is a tool people delete.
# A dozen changed formulae after a `brew upgrade` is a few seconds and fine.
FAST_MAX_INLINE = 12
# How long a cached verdict stays trustworthy. THE CACHE KEY IS NOT ENOUGH: it is
# (name, version, revision) with no time in it, and NVD is not a fixed function of
# a version -- it re-analyses, corrects ranges, and publishes new CVEs against
# versions that never move. Measured 2026-09-04: a python@3.14 row from 08-18
# survived NVD bounding its CVE on 08-20 and the banner cried wolf for 17 days,
# while 97 of 231 rows were 32 days old. The quiet direction is the dangerous one
# -- a CVE published tomorrow against an unchanged version was undiscoverable.
#
# Seven days is affordable here because an NVD API key raises the rate limit to
# 50 requests / 30s, making a whole-inventory sweep about five minutes. It runs
# detached and lock-protected via spawn_background, so a stale backlog never
# blocks a login -- see THE SHELL-SAFETY GUARD below.
STALE_AFTER_DAYS = 7


# --------------------------------------------------------------------------- #
#  Styling                                                                     #
# --------------------------------------------------------------------------- #
class C:
    enabled = sys.stdout.isatty() and os.environ.get("NO_COLOR") is None

    @staticmethod
    def _w(code, s):
        return f"\033[{code}m{s}\033[0m" if C.enabled else s

    bold = staticmethod(lambda s: C._w("1", s))
    dim = staticmethod(lambda s: C._w("2", s))
    red = staticmethod(lambda s: C._w("31", s))
    green = staticmethod(lambda s: C._w("32", s))
    yellow = staticmethod(lambda s: C._w("33", s))
    cyan = staticmethod(lambda s: C._w("36", s))


def sev_colour(sev, s):
    return {"CRITICAL": C.red, "HIGH": C.red, "MEDIUM": C.yellow,
            "LOW": C.dim, "UNRATED": C.yellow}.get(sev, C.dim)(s)


# --------------------------------------------------------------------------- #
#  Inventory                                                                   #
# --------------------------------------------------------------------------- #
def inventory():
    """[(name, upstream_version, revision, raw_version)] or None if brew is absent.

    HOMEBREW ONLY, DELIBERATELY. On a Debian/Ubuntu box this returns None and the
    caller says so out loud rather than printing an all-clear, because "no
    packages checked" and "no vulnerable packages" must never look the same.

    apt is NOT simply a second inventory to bolt on here. Debian and Ubuntu
    backport security fixes far more aggressively than Homebrew while keeping the
    upstream version in the string (`1.11.1-1ubuntu0.2`), and unlike `brew cat`
    there is no per-package list of applied patch commits to match against. Asking
    NVD by CPE about a Debian version would therefore reproduce -- at several times
    the scale -- exactly the false-positive class this tool exists to eliminate.
    The correct source for those boxes is Ubuntu's own security tracker (USN/OVAL),
    which understands `-1ubuntu0.2` as a patched build. That is a separate design,
    not a flag."""
    raw = V.brew_formulae()
    if raw is None:
        return None
    return [(n, V.brew_version_for_cpe(rv), V.brew_revision(rv), rv) for n, rv in raw]


# --------------------------------------------------------------------------- #
#  Scanning one package                                                        #
# --------------------------------------------------------------------------- #
def scan_one(client, name, version, revision, absent_names=frozenset()):
    """(status, cpe, worst_score, findings). Never raises on network trouble."""
    key = V.formula_key(name)

    if key in V.CPE_NAMESAKE_BLOCK:
        return ("unknown", None, None,
                [{"note": f"namesake collision -- {V.CPE_NAMESAKE_BLOCK[key]}"}])
    if not version:
        return ("skipped", None, None, [{"note": "no parseable version"}])

    target = V.FORMULA_CPE.get(name) or V.FORMULA_CPE.get(key)
    if target is None:
        target = client.resolve_cpe(key)
    if target is None:
        return ("unknown", None, None,
                [{"note": "CPE resolution failed or throttled -- NOT verified clean"}])
    if target is False:
        # CPE_ABSENT_OK is the hand-curated, in-source list; absent_names is the
        # DB-backed one triage_unknowns() fills in -- see its docstring for why
        # this is not just hand-curated in source too.
        if key in V.CPE_ABSENT_OK or key in absent_names:
            return ("skipped", None, None, [{"note": f"no CPE published for {key}"}])
        return ("unknown", None, None,
                [{"note": f"no CPE published for {key} -- NOT verified clean"}])

    vendor, product = target
    cpe = f"{vendor}:{product}"
    found = client.cves_for(vendor, product, version)
    if found is None:
        return ("unknown", cpe, None,
                [{"note": f"NVD lookup failed or throttled ({cpe})"}])

    hits, truncated = found
    if not hits:
        return ("clean", cpe, None, [])

    # Homebrew may already have backported the fix. Read once per formula and
    # memoised; since 2026-09-04 this is a local keg file, not a `brew cat` fork.
    #
    # NOT gated on `revision`. That gate looked like a free cost saving -- revision
    # 0 reads as "nothing backported" -- and it is measurably wrong: 12 of the 231
    # formulae installed here carry `patch do` blocks at revision 0, openssl@3 and
    # python@3.14 among them, because a formula that bumps its version and its
    # patch set in one commit resets the revision to 0.
    patches = V.homebrew_patch_commits(name)

    findings = []
    for h in hits:
        patched = V.is_patched_by_homebrew(
            name, h["id"], h.get("fix_commit"), patches)
        findings.append({
            "cve": h["id"],
            "score": h.get("score"),
            "severity": h.get("severity", "UNRATED"),
            "unbounded": h.get("unbounded", False),
            "patched_by_homebrew": patched,
            "fix_commit": h.get("fix_commit"),
            "description": (h.get("description") or "")[:300],
        })
    if truncated:
        findings.append({"note": "NVD result page truncated -- more CVEs may exist"})

    # Patches Homebrew applied that NOTHING has explained: no CVE description
    # named their commit, and the formula attached no `resolves` to them. This is
    # the honest edge of what a deterministic tool can decide -- a leftover patch
    # subject often plainly corresponds to a leftover CVE, but matching prose to
    # prose is judgement, not string comparison. Faking certainty here would be the
    # same sin as a false all-clear, so the hashes are recorded and handed to the
    # briefing for a human or an assistant to rule on.
    #
    # This list used to be longer than it had any right to be. libssh2's three
    # reported CVEs each sat directly beside a `resolves` field the scanner never
    # read, so all three arrived in the briefing as "please go read these commits"
    # when the formula had already answered (2026-09-04).
    if patches:
        claimed = {f["fix_commit"] for f in findings
                   if f.get("patched_by_homebrew") and f.get("fix_commit")}
        unmatched = V.unclaimed_patches(name, patches, claimed)
        if unmatched:
            findings.append({"unmatched_patches": unmatched})

    live = [f for f in findings if f.get("cve")
            and not f["patched_by_homebrew"] and not f["unbounded"]]
    unfixed = [f for f in findings if f.get("cve")
               and not f["patched_by_homebrew"] and f["unbounded"]]

    scores = [f["score"] for f in live if isinstance(f.get("score"), (int, float))]
    worst = max(scores) if scores else None

    if live:
        status = "exposed"
    elif unfixed:
        status = "unfixed"
    elif findings:
        status = "patched"      # every hit accounted for by a Homebrew backport
    else:
        status = "clean"
    return (status, cpe, worst, findings)


def triage_unknowns(store, client):
    """Re-probe every UNKNOWN row's CPE resolution once, live.

    Most UNKNOWN formulae are not a coverage bug: NVD's CPE dictionary is built
    around enterprise software, and modern single-purpose OSS tools are largely
    just not in it -- measured 2026-08-03, six formulae sampled came back six for
    six with no CPE published anywhere. resolve_cpe() already returns False,
    never "unknown", for that case (see its docstring: "a hard 0 here is
    meaningful and final") -- what was missing was somewhere durable to RECORD
    that finality, so a permanently-absent product would stop being re-asked and
    re-counted as an open question every single scan.

    Namesake-blocked formulae (V.CPE_NAMESAKE_BLOCK) are never re-probed: their
    CPE resolves just fine, to different software, which is exactly why they are
    UNKNOWN. Re-probing would look like a fresh resolution and risk reclassifying
    them, which is precisely the false positive the block exists to prevent.

    Anything still ambiguous after the probe (throttled, or a real product that
    genuinely could not be resolved this time) is left exactly where it is, per
    the same never-invent-a-clean-verdict rule as everywhere else in this tool.

    Returns (checked, confirmed)."""
    checked = confirmed = 0
    for row in store.all_rows(SUBJECT):
        if row["status"] != "unknown":
            continue
        key = V.formula_key(row["name"])
        if key in V.CPE_NAMESAKE_BLOCK:
            continue
        checked += 1
        if client.resolve_cpe(key) is False:
            store.confirm_absent(key)
            store.record(SUBJECT, row["name"], row["version"], row["revision"], None,
                        "skipped", None,
                        [{"note": f"no CPE published for {key} (confirmed absent, triaged)"}])
            confirmed += 1
    store.commit()
    return checked, confirmed


# --------------------------------------------------------------------------- #
#  The scan                                                                    #
# --------------------------------------------------------------------------- #
def spawn_background(args) -> bool:
    """Detach a full scan. Returns False if one is already running.

    The lock is a DIRECTORY because mkdir is atomic -- two terminal tabs opened in
    the same second must not both start a 15-minute sweep. A lock older than two
    hours is reclaimed so a killed scan cannot wedge this forever."""
    d = V.state_dir()
    if not d:
        return False
    lock = os.path.join(d, "vuln-scan.lock")
    try:
        age = time.time() - os.path.getmtime(lock)
        if age > 7200:
            os.rmdir(lock)
    except OSError:
        pass
    try:
        os.mkdir(lock)
    except OSError:
        return False        # already running; leave it alone
    cmd = [os.path.abspath(__file__), "--no-progress", "--quiet"]
    if args.db:
        cmd += ["--db", args.db]
    log = os.path.join(d, "vuln-scan-background.log")
    try:
        with open(log, "w") as fh:
            subprocess.Popen(
                ["/bin/sh", "-c",
                 f'{shlex_join(cmd)}; rmdir {shlex_quote(lock)} 2>/dev/null'],
                stdout=fh, stderr=subprocess.STDOUT,
                start_new_session=True, close_fds=True)
        return True
    except OSError:
        try:
            os.rmdir(lock)
        except OSError:
            pass
        return False


def shlex_quote(s):
    return "'" + s.replace("'", "'\"'\"'") + "'"


def shlex_join(parts):
    return " ".join(shlex_quote(p) for p in parts)


def run_scan(store, args, announce):
    inv = inventory()
    if inv is None:
        import shutil as _sh
        if not _sh.which("brew"):
            # Say WHY nothing was checked. A silent no-op on a Linux box would be
            # read as "scanned, all clear" -- the false all-clear in its purest form.
            return None, ("no Homebrew on this machine, so nothing was scanned. "
                          "This tool covers Homebrew only; apt/dpkg needs Ubuntu's "
                          "security tracker, not NVD (see inventory() for why)")
        return None, "`brew list` failed"

    if args.only:
        wanted = set(args.only)
        inv = [row for row in inv if row[0] in wanted or V.formula_key(row[0]) in wanted]
        if not inv:
            return None, f"no installed formula matches {', '.join(sorted(wanted))}"

    live_keys = {(n, v, r) for n, v, r, _ in inv}
    # Reaping compares against the FULL inventory, so a --only run must not
    # conclude that the other 230 formulae have been uninstalled.
    reaped = 0 if args.only else store.reap(SUBJECT, live_keys)

    max_age = args.stale_days * 86400
    todo = []
    for name, version, revision, _raw in inv:
        if (args.full or args.only
                or store.known(SUBJECT, name, version, revision, max_age) is None):
            todo.append((name, version, revision))

    if args.limit:
        todo = todo[:args.limit]

    # THE SHELL-SAFETY GUARD. In --fast mode a large backlog is never worked
    # through inline: it is handed to a detached process and this run reports from
    # whatever is already cached. Without this, the very first login on a new
    # machine blocks for ~15 minutes with a progress bar, and the tool gets removed
    # from .zshrc that same day.
    if args.fast and len(todo) > FAST_MAX_INLINE:
        spawned = spawn_background(args)
        return ({"checked": 0, "total": len(inv), "reaped": reaped,
                 "deferred": len(todo), "spawned": spawned}, None)

    if todo:
        announce(len(todo), len(inv))
        client = V.NvdClient(V.nvd_api_key(), timeout=args.timeout)
        absent_names = store.absent_names()
        for i, (name, version, revision) in enumerate(todo, 1):
            if args.progress:
                pkg = name[:26]
                print(f"\r  checking {i}/{len(todo)}  {pkg} ".ljust(56),
                      end="", file=sys.stderr, flush=True)
            status, cpe, worst, findings = scan_one(client, name, version, revision, absent_names)
            store.record(SUBJECT, name, version, revision, cpe, status, worst, findings)
            # Commit as we go: a shell that gets closed mid-scan should keep the
            # work already paid for rather than start from nothing next time.
            store.commit()
        if args.progress:
            print("\r".ljust(58) + "\r", end="", file=sys.stderr, flush=True)
        store.set_meta("last_scan", int(time.time()))
        store.commit()

    return {"checked": len(todo), "total": len(inv), "reaped": reaped}, None


# --------------------------------------------------------------------------- #
#  Reporting                                                                   #
# --------------------------------------------------------------------------- #
def collect(store):
    """Rows grouped by status, with acknowledged findings filtered out."""
    groups = {"exposed": [], "unfixed": [], "unknown": [],
              "patched": [], "clean": [], "skipped": []}
    for row in store.all_rows(SUBJECT):
        findings = json.loads(row["findings"] or "[]")
        live = [f for f in findings
                if f.get("cve") and not f.get("patched_by_homebrew")
                and not f.get("unbounded")
                and not store.acked(SUBJECT, row["name"], f["cve"])]
        status = row["status"]
        # An exposure whose every CVE has been acknowledged stops being an
        # exposure until the acknowledgement expires -- then it comes straight back.
        if status == "exposed" and not live:
            status = "patched" if any(f.get("patched_by_homebrew") for f in findings) else "clean"
        groups.setdefault(status, []).append({"row": row, "findings": findings, "live": live})
    return groups


def actionable(groups):
    out = []
    for item in groups["exposed"]:
        hi = [f for f in item["live"]
              if isinstance(f.get("score"), (int, float)) and f["score"] >= ACTION_THRESHOLD]
        unrated = [f for f in item["live"] if f.get("score") is None]
        # An unscored CVE is not a harmless one -- NVD simply has not analysed it
        # yet. Treat it as actionable rather than silently dropping it.
        if hi or unrated:
            out.append({**item, "high": hi, "unrated": unrated})
    return out


def print_table(groups, stats, quiet=False):
    exposed, unfixed = groups["exposed"], groups["unfixed"]
    unknown, patched = groups["unknown"], groups["patched"]
    clean, skipped = groups["clean"], groups["skipped"]
    total = sum(len(v) for v in groups.values())

    if not quiet:
        head = C.bold(f"vuln-scan  {total} Homebrew formulae")
        if stats and stats["checked"]:
            head += C.dim(f"   ({stats['checked']} newly checked this run)")
        elif stats:
            head += C.dim("   (no changes since last scan)")
        print(head)

    # Split EXPOSED the same way the briefing does. Previously this printed all
    # exposed formulae identically, so the banner shouted about 7 while the briefing
    # could only act on 2 -- and the 5 sub-threshold rows never change from session to
    # session. Identical unchanging alarm is how the whole block stops being read, and
    # the ACTION NEEDED rows get skimmed along with it. Split, don't hide: everything
    # below is still printed, still under --quiet, because these ARE live unfixed CVEs
    # (they are NOT backported and NOT unfixable -- that is what PATCHED BY HOMEBREW
    # and ALL-VERSION below are for). They are merely under the action threshold.
    acts = actionable(groups)
    act_names = {i["row"]["name"] for i in acts}
    below = [i for i in exposed if i["row"]["name"] not in act_names]

    if acts:
        print(C.red(f"  ACTION NEEDED  {len(acts)}")
              + C.dim(f"  (CVSS >= {ACTION_THRESHOLD:.1f} or unrated -- the briefing covers these)"))
        for item in sorted(acts, key=lambda i: -(i["row"]["worst_score"] or 0)):
            r = item["row"]
            worst = max((f["score"] for f in item["live"]
                         if isinstance(f.get("score"), (int, float))), default=None)
            sev = next((f["severity"] for f in item["live"]
                        if f.get("score") == worst), "UNRATED")
            score_s = f"{worst:.1f}" if worst is not None else "  ?"
            print(f"    {sev_colour(sev, score_s)}  {C.bold(r['name']):<22} "
                  f"{r['version']}{'_' + str(r['revision']) if r['revision'] else ''}"
                  + C.dim(f"   {len(item['live'])} CVE(s)  [{r['cpe']}]"))
            print("        " + C.dim(", ".join(f["cve"] for f in item["live"][:8])
                                     + (" …" if len(item["live"]) > 8 else "")))

    if below:
        # One line, names only. Deliberately not itemised: the point is that it stays
        # visible and countable without competing with the block above.
        names = ", ".join(i["row"]["name"] for i in below[:8])
        more = f" +{len(below) - 8}" if len(below) > 8 else ""
        worst = max((f["score"] for i in below for f in i["live"]
                     if isinstance(f.get("score"), (int, float))), default=None)
        worst_s = f", worst {worst:.1f}" if worst is not None else ""
        cves = sum(len(i["live"]) for i in below)
        print(C.yellow(f"  EXPOSED, BELOW ACTION THRESHOLD  {len(below)}")
              + C.dim(f"  {names}{more}"))
        print(C.dim(f"      {cves} live CVE(s), unfixed{worst_s} -- "
                    f"under CVSS {ACTION_THRESHOLD:.1f}, so not in the briefing. "
                    f"`vuln-scan --report` after lowering ACTION_THRESHOLD to see them."))

    if patched and not quiet:
        names = ", ".join(i["row"]["name"] for i in patched[:6])
        more = f" +{len(patched) - 6}" if len(patched) > 6 else ""
        print(C.green(f"  PATCHED BY HOMEBREW  {len(patched)}")
              + C.dim(f"  {names}{more}  (NVD still flags these; the fix is backported)"))

    if unfixed and not quiet:
        names = ", ".join(i["row"]["name"] for i in unfixed[:6])
        more = f" +{len(unfixed) - 6}" if len(unfixed) > 6 else ""
        print(C.dim(f"  ALL-VERSION, no fixed release  {len(unfixed)}  {names}{more}"))

    if unknown:
        # Always shown, even under --quiet: UNKNOWN is the state a silent bug also
        # produces, so hiding it is exactly the false all-clear to avoid.
        names = ", ".join(i["row"]["name"] for i in unknown[:8])
        more = f" +{len(unknown) - 8} more" if len(unknown) > 8 else ""
        print(C.yellow(f"  UNVERIFIED  {len(unknown)}") + C.dim(f"  {names}{more}"))

    if not quiet:
        print(C.dim(f"  clean {len(clean)}   skipped {len(skipped)}"))


# --------------------------------------------------------------------------- #
#  Briefing for a context-free assistant                                       #
# --------------------------------------------------------------------------- #
def write_briefing(groups, path):
    """A self-contained handover. Deliberately carries NO machine identifiers,
    usernames or absolute paths: it names installed software and versions, which
    is a target list, so it must be safe to paste into a fresh session."""
    acts = actionable(groups)
    lines = [
        "# Security briefing: installed packages with known vulnerabilities",
        "",
        f"Generated {time.strftime('%Y-%m-%d %H:%M %Z')} by `vuln-scan` on a macOS/Homebrew machine.",
        "",
        "## What this is, and what I need",
        "",
        "This file is a complete, self-contained problem statement. You have no",
        "access to the machine it came from and do not need any.",
        "",
        "Each package below is INSTALLED and matches a published CVE for its exact",
        "version in NVD. Findings already fixed by a Homebrew backport, already",
        "acknowledged, or with no fixed release anywhere have been filtered out --",
        "everything listed is believed live and unaddressed.",
        "",
        "Please help me with:",
        "1. Which of these actually matter given how each package is typically used",
        "   (a parsing library reachable from untrusted input is not the same as a",
        "   local CLI I invoke by hand).",
        "2. Concrete mitigations where no upgrade exists -- config changes, disabling",
        "   a feature, replacing the tool, or accepting the risk with a reason.",
        "3. What to do first, and what is safe to defer.",
        "",
        "Commands to verify or fix are run by me; give me exact ones where relevant.",
        "",
        f"## Findings ({len(acts)} package(s))",
        "",
    ]
    if not acts:
        lines += ["Nothing currently actionable.", ""]
    for item in sorted(acts, key=lambda i: -(max(
            (f["score"] for f in i["live"] if isinstance(f.get("score"), (int, float))),
            default=0))):
        r = item["row"]
        ver = r["version"] + (f"_{r['revision']}" if r["revision"] else "")
        lines += [f"### {r['name']} {ver}", ""]
        lines.append(f"- CPE: `{r['cpe']}`")
        # Report what is actually known, not what the revision implies. The old
        # wording here said "revision > 0 means Homebrew has applied patches" --
        # the same false belief that was removed from the code on 2026-09-04, left
        # standing in prose where a human would read it as fact. It has a blind
        # spot too: 12 of the 231 formulae installed on this machine carry patches
        # at revision 0, so the whole clause used to be omitted for exactly the
        # formulae whose backport context was least obvious.
        npatch = len(V.homebrew_patch_commits(r["name"]) or {})
        declared = V.homebrew_resolved_cves(r["name"])
        if npatch:
            note = f"  ({npatch} patch(es) applied"
            note += (f"; the formula declares {len(declared)} CVE(s) resolved, and"
                     " the ones below are not among them)" if declared
                     else "; the formula names no CVE for any of them)")
        else:
            note = "  (no patches applied to this formula)"
        lines.append(f"- Homebrew revision: {r['revision']}{note}")
        lines.append("")
        lines.append("| CVE | CVSS | Severity | Summary |")
        lines.append("|---|---|---|---|")
        for f in sorted(item["live"],
                        key=lambda f: -(f["score"] if isinstance(f.get("score"), (int, float)) else 0)):
            score = f"{f['score']:.1f}" if isinstance(f.get("score"), (int, float)) else "unscored"
            desc = (f.get("description") or "").replace("\n", " ").replace("|", "\\|")[:180]
            lines.append(f"| {f['cve']} | {score} | {f.get('severity', '?')} | {desc} |")
        lines.append("")
        unmatched = next((f["unmatched_patches"] for f in item["findings"]
                          if f.get("unmatched_patches")), None)
        if unmatched:
            lines += [
                f"**{len(unmatched)} Homebrew patch(es) applied to this formula could not be",
                "matched to any CVE above.** Homebrew backports fixes without changing the",
                "upstream version, so NVD keeps reporting the package vulnerable after it has",
                "been fixed. Where a CVE description named its fix commit I matched it and",
                "filtered that CVE out; these patches named no CVE, so I could not.",
                "",
                "**This is the most useful thing you can help with.** Please read these commits",
                "and judge whether they already fix the CVEs listed above -- the subject lines",
                "are usually enough:",
                "",
            ]
            for url in unmatched:
                lines.append(f"- {url}")
            lines += ["", "If they do, these findings are already resolved on this machine and the",
                      "correct action is to record that, not to upgrade anything.", ""]
    lines += [
        "## Context you may find useful",
        "",
        "- The scanner queries NVD by exact CPE and honours version ranges, so these",
        "  are matches against the installed version, not a package's whole history.",
        "- It excludes NVD `vulnerable: false` context matches (a CVE merely",
        "  MENTIONING a package is not a CVE IN it).",
        "- 'No fixed release' findings are excluded here; they exist but cannot be",
        "  resolved by upgrading.",
        "",
    ]
    try:
        with open(path, "w", encoding="utf-8") as fh:
            fh.write("\n".join(lines))
        return path
    except OSError:
        return None


# --------------------------------------------------------------------------- #
#  Main                                                                        #
# --------------------------------------------------------------------------- #
def parse_args(argv):
    p = argparse.ArgumentParser(
        prog="vuln-scan",
        description="Incremental CVE scan of installed Homebrew formulae.")
    p.add_argument("--fast", action="store_true",
                   help="shell-startup mode: silent when nothing changed")
    p.add_argument("--full", action="store_true", help="rescan everything, ignoring the cache")
    p.add_argument("--stale-days", type=int, default=STALE_AFTER_DAYS, metavar="N",
                   help=f"re-check a cached verdict older than N days "
                        f"(default {STALE_AFTER_DAYS}; 0 disables expiry)")
    p.add_argument("--report", action="store_true", help="write the briefing file")
    p.add_argument("--json", dest="as_json", action="store_true", help="machine-readable output")
    p.add_argument("--quiet", action="store_true", help="only exposures and unknowns")
    p.add_argument("--limit", type=int, default=0, help="check at most N packages (testing)")
    p.add_argument("--only", action="append", default=[], metavar="NAME",
                   help="restrict to this formula (repeatable); re-checks it even if cached")
    p.add_argument("--timeout", type=float, default=25.0, help="per-call network timeout")
    p.add_argument("--db", default=None, help="override the database path (testing)")
    p.add_argument("--no-progress", dest="progress", action="store_false", default=None,
                   help="suppress the stderr progress line")
    p.add_argument("--ack", nargs=2, metavar=("NAME", "CVE"),
                   help="acknowledge a finding for --ack-days")
    p.add_argument("--ack-days", type=int, default=30, help="acknowledgement lifetime (default 30)")
    p.add_argument("--ack-reason", default="", help="why it was acknowledged")
    p.add_argument("--triage-unknowns", action="store_true",
                   help="re-probe every UNKNOWN row once; record confirmed CPE "
                        "absences so they stop being counted as unknown")
    return p.parse_args(argv)


def main(argv) -> int:
    args = parse_args(argv)
    if args.progress is None:
        args.progress = sys.stderr.isatty()

    store = V.ScanStore(args.db)
    try:
        if args.ack:
            store.ack(SUBJECT, args.ack[0], args.ack[1].upper(), args.ack_days, args.ack_reason)
            print(f"acknowledged {args.ack[1].upper()} for {args.ack[0]} "
                  f"({args.ack_days}d)")
            return 0

        if args.triage_unknowns:
            client = V.NvdClient(V.nvd_api_key(), timeout=args.timeout)
            checked, confirmed = triage_unknowns(store, client)
            print(f"vuln-scan: re-probed {checked} unknown formula(e), "
                  f"confirmed {confirmed} as having no CPE published anywhere "
                  f"(now skipped, not unknown)")
            remaining = checked - confirmed
            if remaining:
                print(C.dim(f"  {remaining} left unknown -- still throttled/ambiguous, "
                            f"or a namesake-blocked formula was excluded from re-probing"))
            return 0

        def announce(n, total):
            if args.as_json:
                return
            # The whole point of the friendly line: a login shell that pauses with
            # no explanation reads as a hang, and the next move is to kill it.
            print(C.cyan(f"vuln-scan: {n} new or changed package(s) of {total} to check")
                  + C.dim("  (cached results reused for the rest)"), flush=True)

        stats, err = run_scan(store, args, announce)
        if err:
            if not args.fast:
                print(C.yellow(f"vuln-scan: {err}"))
            return 2

        groups = collect(store)
        acts = actionable(groups)

        if args.as_json:
            print(json.dumps({
                "stats": stats,
                "actionable": [{"name": i["row"]["name"],
                                "version": i["row"]["version"],
                                "revision": i["row"]["revision"],
                                "score": i["row"]["worst_score"],
                                "cves": [f["cve"] for f in i["live"]]} for i in acts],
                "counts": {k: len(v) for k, v in groups.items()},
            }, indent=2))
        elif stats.get("deferred"):
            # Say exactly what is happening and why nothing is blocked. A silent
            # deferral looks identical to a check that never ran.
            n = stats["deferred"]
            if stats.get("spawned"):
                print(C.cyan(f"vuln-scan: {n} package(s) need checking -- running in the "
                             f"background (~{max(1, n * 3 // 60)} min)")
                      + C.dim("  your prompt is not waiting on it"))
            else:
                print(C.dim(f"vuln-scan: {n} package(s) pending; a scan is already running"))
            if acts or groups["unknown"]:
                print_table(groups, None, quiet=True)
        elif args.fast and not acts and not groups["unknown"] and not stats["checked"]:
            # Nothing changed and nothing wrong: one line, no noise.
            print(C.dim(f"vuln-scan: {stats['total']} formulae, no known CVEs (cached)"))
        else:
            print_table(groups, stats, quiet=args.quiet)

        if args.report or acts:
            d = V.state_dir()
            if d:
                path = write_briefing(groups, os.path.join(d, "vuln-briefing.md"))
                if path and not args.as_json and acts:
                    print(C.dim(f"  briefing written: {path}"))

        return 1 if acts else 0
    finally:
        store.close()


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except KeyboardInterrupt:
        print()
        sys.exit(130)
