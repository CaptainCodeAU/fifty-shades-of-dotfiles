#!/usr/bin/env zsh
# pj -- the light project launcher for Claude Code (F3, W-20260921-13).
#
# WHY A SCRIPT AND NOT AN ALIAS. Until 2026-09-21 `pj` was an alias in ~/.zshrc. An
# alias is read ONCE, when the shell starts, so a shell opened before the alias changed
# kept launching the OLD form for as long as it lived. Herdr keeps panes alive for days,
# and four of the last seven pj sessions ran without pj-global/RULES.md that way (P5.7,
# P6a). A script is read from disk at every launch: it cannot go stale.
#
# What it does, and only that (the same steps the alias + __claude_launch did):
#   1. builds the claude argv: project-only settings, the ONE combined system-prompt file
#      pj-prompt-file prints, the five plugin dirs, skip-permissions, effort high;
#   2. sources ~/.zsh_claude_launch (the shared launch function, also used by the `c`
#      family from .zshrc) and hands the argv to __claude_launch, which prints the last
#      commit's files to the tty, reads the two keychain entries, refreshes the GH
#      rate-limit cache, starts the per-session ssh-agent, sets the env vars and runs
#      claude. Anything after `pj` on the command line is appended (`pj -p x`,
#      `pj --resume`, `pj --model haiku` all pass through untouched).
#
# Own flags, recognised ONLY as the leading arguments so pass-through stays pure:
#   pj --profile <name>      launch under that profile (F5a). Must come FIRST, before
#                            --dry-run. PJ_PROFILE=<name> does the same without a flag.
#   pj --dry-run [args...]   print the exact claude argv, one entry per line, exit 0. No
#                            launch, no keychain, no ssh-agent. pj-launch-check and
#                            pj-health read it.
#   pj --selftest            prove the dry-run arms (below). Exit 0 all green, 1 otherwise.
#
# PROFILES (F5a, ruled by Gavin 2026-09-21). A profile is a key:value file under
# ~/.config/pj/profiles/, stowed from home/.config/pj/profiles/. It names the config dir,
# the settings file, the prompt source, the plugin dirs, the always-appended flags, the
# mode and whether the start card prints. `default` reproduces this script's built-in
# values exactly, so a machine with NO profiles dir stowed behaves as it always did --
# every value below has the old hardcoded constant as its fallback, and a missing or
# unreadable profile file is a silent no-op rather than a refusal.
#
# THE MERGE RULE: the DEFAULT profile's `required` flags are appended to every profile,
# whatever that profile says, so no profile can drop --dangerously-skip-permissions or
# --effort high by forgetting the key.
#
# THREE MORE KEYS, F5b 2026-09-21, from the W-20260920-A03 audit. Gavin ruled these three
# are a per-profile choice rather than something every pj session gets:
#   model: <name>            --model <name>. Unset = the account default (Opus 5 here).
#   remote_control: on|off   remoteControlAtStartup. Unset = leave it to the org default.
#   voice: on|off            voiceEnabled (Claude Code's own voice, NOT the hook_runner
#                            audio pipeline, which was PARKED at the same gate).
# Unset means EMIT NOTHING, never "emit the default", so a profile that names none of
# them produces the same argv it did before this change.
#
# THE CONFIG DIR IS THE ONLY THING THAT ACTUALLY MOVES. Measured 2026-09-21 with pj's
# real argv under a scratch CLAUDE_CONFIG_DIR: the appended prompt file, the output
# style and all five --plugin-dir dirs still loaded from ~/.claude, because every path
# pj passes is absolute. What moves with the config dir is login, folder trust,
# ~/.claude.json, transcripts and auto memory -- and nothing pj owns. `config_dir:
# ~/.claude` is therefore treated as "do not export the variable at all", so the default
# launch keeps an UNSET CLAUDE_CONFIG_DIR rather than one set to its own default.
#
# Refuses (exit 2, one line on stderr) when pj-prompt-file prints nothing: a launch
# without the rules file is the failure this script exists to prevent, so it never
# launches half-loaded. Also refuses when ~/.zsh_claude_launch is missing (stow it).
#
# Paths under ~ only. No secrets in this file; the keychain is read inside
# __claude_launch and never printed. Seams (the selftest sets them, nobody else should):
#   PJ_LAUNCH_FILE   the launch-function file (default ~/.zsh_claude_launch)
#   PJ_PROMPT_OUT    honoured by pj-prompt-file (its own seam), so the dry run can be
#                    pointed at a fixture cache
#   PJ_PROFILE_DIR   the profiles folder (default ~/.config/pj/profiles)
set -u
emulate -L zsh

SELF="${0:A}"   # captured at top level: inside a zsh function $0 is the FUNCTION name
LAUNCH_FILE="${PJ_LAUNCH_FILE:-$HOME/.zsh_claude_launch}"
PLUGIN_DIRS=(skills/herdr skills/AgentRelay skills/ISA pj-voice pj)
PROFILE_DIR="${PJ_PROFILE_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/pj/profiles}"
typeset -ga PJ_ARGV   # not ARGV: in zsh that is the positional parameters
typeset -ga PJ_ENV    # VAR=value pairs the launch exports; EMPTY for the default profile

# --- the profile ----------------------------------------------------------------
# Every P_* below starts at the value this script hardcoded before profiles existed, so
# a box with no profiles dir stowed launches exactly as it always did. THAT IS THE
# FALLBACK, not an error path: `pj` must never refuse because a config file is absent.
P_CONFIG_DIR="$HOME/.claude"
P_SETTING_SOURCES="project,local"
P_SETTINGS="$HOME/.claude/settings.project.json"
P_PROMPT="pj-prompt-file"
P_PLUGINS="skills/herdr skills/AgentRelay skills/ISA pj-voice pj"
P_REQUIRED="--dangerously-skip-permissions --effort high"
P_MODE="normal"
P_CARD="on"
# F5b. The three keys Gavin made per-profile at the F5b gate out of the 47 audited in
# W-20260920-A03. ALL THREE DEFAULT TO EMPTY, and empty means EMIT NOTHING -- not "emit
# the default value". That distinction is what keeps the default profile's argv
# byte-identical to the pre-F5a launcher, which is arm 1 of this selftest.
P_MODEL=""
P_REMOTE_CONTROL=""
P_VOICE=""
PROFILE_NAME="default"

expand_tilde() { local p="$1"; print -r -- "${p/#\~/$HOME}"; }

# read_profile <file> -- apply the keys it holds; unknown keys and comments ignored.
# Silent on a missing file, by design (see the fallback note above).
read_profile() {
  # extended_glob is what makes `[[:space:]]#` mean "zero or more spaces" in the trims
  # below. `local_options` scopes it to this function, so nothing else sees it.
  setopt local_options extended_glob
  local f="$1" k v line
  [[ -r "$f" ]] || return 0
  while IFS= read -r line; do
    case "$line" in ''|'#'*) continue ;; esac
    [[ "$line" == *:* ]] || continue
    k="${line%%:*}"; v="${line#*:}"
    k="${k##[[:space:]]#}"; k="${k%%[[:space:]]#}"
    v="${v##[[:space:]]#}"; v="${v%%[[:space:]]#}"
    case "$k" in
      config_dir)      P_CONFIG_DIR="$(expand_tilde "$v")" ;;
      setting_sources) P_SETTING_SOURCES="$v" ;;
      settings)        P_SETTINGS="$(expand_tilde "$v")" ;;
      prompt)          P_PROMPT="$v" ;;
      plugins)         P_PLUGINS="$v" ;;
      required)        P_REQUIRED="$v" ;;
      mode)            P_MODE="$v" ;;
      card)            P_CARD="$v" ;;
      model)           P_MODEL="$v" ;;
      remote_control)  P_REMOTE_CONTROL="$v" ;;
      voice)           P_VOICE="$v" ;;
    esac
  done < "$f"
}

# load_profile <name> -- the default profile first (it supplies every fallback AND the
# `required` flags every profile inherits), then the named one on top.
load_profile() {
  local name="$1" req_default
  PROFILE_NAME="$name"
  read_profile "$PROFILE_DIR/default"
  req_default="$P_REQUIRED"
  if [[ "$name" != default ]]; then
    if [[ ! -r "$PROFILE_DIR/$name" ]]; then
      print -u2 -- "pj: REFUSED: no profile '$name' at ${PROFILE_DIR/#$HOME/~}/$name; pj-health lists the profiles it can see"
      return 2
    fi
    read_profile "$PROFILE_DIR/$name"
  fi
  # THE MERGE RULE (ruled at the F5a gate): the default profile's `required` flags are
  # appended to every profile. A profile that omits or shortens `required` cannot drop
  # them; a profile that repeats one does not get it twice.
  local t
  for t in ${=req_default}; do
    [[ " $P_REQUIRED " == *" $t "* ]] || P_REQUIRED="$P_REQUIRED $t"
  done
  return 0
}

build_argv() {
  local prompt d
  if [[ "$P_PROMPT" == pj-prompt-file ]]; then
    prompt="$(pj-prompt-file)"
  else
    prompt="$(expand_tilde "$P_PROMPT")"
  fi
  if [[ -z "$prompt" ]]; then
    print -u2 -- "pj: REFUSED: pj-prompt-file printed no system-prompt file; run pj-prompt-file --selftest"
    return 2
  fi
  PJ_ARGV=(claude --setting-sources "$P_SETTING_SOURCES" --settings "$P_SETTINGS"
        --append-system-prompt-file "$prompt")
  if [[ "$P_PLUGINS" != none ]]; then
    for d in ${=P_PLUGINS}; do PJ_ARGV+=(--plugin-dir "$HOME/.claude/$d"); done
  fi
  [[ "$P_MODE" == safe ]] && PJ_ARGV+=(--safe-mode)
  # F5b: the three per-profile keys. `model` has its own flag; the other two are
  # settings keys with no flag, so they ride a SECOND --settings carrying a JSON string.
  #
  # WHY THAT WORKS, measured 2026-09-21 against Claude Code 2.1.278 with three arms:
  #   --settings <file> alone                  -> API_TIMEOUT_MS=1800000   (control)
  #   --settings <file> --settings <json>      -> F5B_OVERLAY=OVERLAYSET   (overlay applies)
  #   --settings <file> --settings <json>      -> API_TIMEOUT_MS=1800000   (file SURVIVES)
  # So the flag REPEATS and MERGES: later wins per key, earlier keys are kept. It is not
  # last-one-wins, which would have silently dropped the whole settings.project.json.
  # The third arm is the one that decided it; the first two alone cannot tell the two
  # behaviours apart.
  #
  # The overlay is emitted ONLY when a profile sets one of the two keys, so the default
  # profile passes exactly one --settings and its argv is unchanged.
  [[ -n "$P_MODEL" ]] && PJ_ARGV+=(--model "$P_MODEL")
  local ov=""
  [[ "$P_REMOTE_CONTROL" == on  ]] && ov="$ov\"remoteControlAtStartup\":true,"
  [[ "$P_REMOTE_CONTROL" == off ]] && ov="$ov\"remoteControlAtStartup\":false,"
  [[ "$P_VOICE" == on  ]] && ov="$ov\"voiceEnabled\":true,"
  [[ "$P_VOICE" == off ]] && ov="$ov\"voiceEnabled\":false,"
  [[ -n "$ov" ]] && PJ_ARGV+=(--settings "{${ov%,}}")
  PJ_ARGV+=(${=P_REQUIRED})
  # The env the launch exports. EMPTY for the default profile, which is what keeps the
  # default launch byte-identical: `config_dir: ~/.claude` means DO NOT EXPORT, because a
  # CLAUDE_CONFIG_DIR set to its own default is not the same as one that is unset.
  PJ_ENV=()
  [[ "$P_CONFIG_DIR" != "$HOME/.claude" ]] && PJ_ENV+=("CLAUDE_CONFIG_DIR=$P_CONFIG_DIR")
  [[ "$P_CARD" == off ]] && PJ_ENV+=("PJ_NO_CARD=1")
  PJ_ENV+=("PJ_PROFILE=$PROFILE_NAME")
}

# --- dot-claude freshness (P8a gate Q4, ruled by Gavin 2026-09-21) --------------
# FIRE AND FORGET. Nothing waits on this: a measured fetch of dot-claude took 1354, 1208 and
# 1223 ms on this machine (three warm runs, 2026-09-21), and a second and a quarter on every
# launch is a tax nobody consented to. The start card reports what the PREVIOUS fetch left in
# the refs, so the reading is at worst one launch old and says how old it is.
#
# IT NEVER PULLS, and never merges. dot-claude holds the drawer another session may be
# writing; a pull at launch is the concurrent-write hazard D-20260920-08 exists to keep out.
#
# THREE THINGS BOUND IT, because a launcher must never hang:
#   GIT_TERMINAL_PROMPT=0   a stale credential FAILS instead of blocking on a prompt. This is
#                           the real hazard: dot-claude is on the GitHub App HTTPS path, and
#                           an expired ghs_ token is what stopped `pj-wrap push` twice today.
#   low-speed abort         a stalled transfer gives up after 8 s rather than hanging on.
#   detached, output binned  nothing it prints can reach the terminal or a pipe.
# Skipped entirely when the last fetch is under 10 minutes old (a relaunch is not new news)
# or when PJ_NO_FETCH is set.
kick_dotclaude_fetch() {
  [[ -n "${PJ_NO_FETCH:-}" ]] && return 0
  local dc="${OPEN_ITEMS_DOTCLAUDE:-$HOME/.claude}" fh m now
  [[ -d "$dc/.git" ]] || return 0
  fh="$dc/.git/FETCH_HEAD"
  if [[ -f "$fh" ]]; then
    m="$(stat -L -c %Y "$fh" 2>/dev/null || stat -L -f %m "$fh" 2>/dev/null || echo 0)"
    now="$(date +%s 2>/dev/null || echo 0)"
    [[ "$m" -gt 0 && "$now" -gt 0 && $(( now - m )) -lt 600 ]] && return 0
  fi
  ( GIT_TERMINAL_PROMPT=0 GIT_HTTP_LOW_SPEED_LIMIT=1000 GIT_HTTP_LOW_SPEED_TIME=8 \
      git -C "$dc" fetch --quiet origin >/dev/null 2>&1 & ) >/dev/null 2>&1
  return 0
}

selftest() {
  local pass=0 fail=0 out rc root n d
  ok()  { pass=$((pass + 1)); print -- "  ok   $1"; }
  bad() { fail=$((fail + 1)); print -- "  FAIL $1"; print -- "       got: $2"; }
  root="$(mktemp -d "${TMPDIR:-/tmp}/pj-selftest.XXXXXX")" || exit 1
  print -- "pj selftest in $root"
  # 1. dry-run argv carries the cache prompt file and all five plugin dirs, first entry is claude
  out="$(PJ_PROMPT_OUT="$root/prompt.md" "$SELF" --dry-run 2>"$root/err1")"; rc=$?
  [[ $rc -eq 0 ]] && ok "1 dry-run exits 0" || bad "1 dry-run rc" "$rc $(<"$root/err1")"
  [[ "${out%%$'\n'*}" == claude ]] && ok "1 argv[0] is claude" || bad "1 argv[0]" "${out%%$'\n'*}"
  [[ "$out" == *$'\n--append-system-prompt-file\n'"$root/prompt.md"$'\n'* ]] && ok "1 carries the prompt cache path" || bad "1 prompt path" "$out"
  n=0; for d in "${PLUGIN_DIRS[@]}"; do [[ "$out" == *$'\n--plugin-dir\n'"$HOME/.claude/$d"$'\n'* ]] && n=$((n + 1)); done
  [[ $n -eq 5 ]] && ok "1 all five plugin dirs present" || bad "1 plugin dirs" "$n of 5"
  [[ "$out" == *$'\n--setting-sources\nproject,local\n'* ]] && ok "1 setting-sources project,local" || bad "1 setting-sources" "$out"
  [[ "$out" == *$'\n--settings\n'"$HOME/.claude/settings.project.json"$'\n'* ]] && ok "1 project settings file" || bad "1 settings" "$out"
  # 2. pass-through: -p x --model haiku land at the end, in order
  out="$(PJ_PROMPT_OUT="$root/prompt.md" "$SELF" --dry-run -p x --model haiku 2>/dev/null)"
  [[ "$out" == *$'\n-p\nx\n--model\nhaiku' ]] && ok "2 -p x --model haiku appended in order" || bad "2 pass-through" "$out"
  # 3. a claude flag in first position is NOT eaten: --dry-run only counts as \$1
  out="$(PJ_PROMPT_OUT="$root/prompt.md" "$SELF" --dry-run --resume --dry-run 2>/dev/null)"
  [[ "$out" == *$'\n--resume\n--dry-run' ]] && ok "3 a later --dry-run passes through as a claude arg" || bad "3 later flag" "$out"
  # 4. no prompt file: refuses with rc 2, prints nothing on stdout
  out="$(PJ_PROMPT_SOURCES="$root/none-a:$root/none-b" PJ_PROMPT_OUT="$root/p2.md" "$SELF" --dry-run 2>"$root/err4")"; rc=$?
  [[ $rc -eq 2 && -z "$out" ]] && ok "4 no prompt source -> REFUSED rc 2, no argv" || bad "4 refusal" "rc=$rc out=$out"
  grep -q REFUSED "$root/err4" && ok "4 refusal is announced on stderr" || bad "4 stderr" "$(<"$root/err4")"
  # 5. control: the launch file is found (the real launch path exists on this machine)
  [[ -r "$LAUNCH_FILE" ]] && ok "5 launch file readable: ${LAUNCH_FILE/#$HOME/~}" || bad "5 launch file" "$LAUNCH_FILE missing (stow?)"
  # 6. control: __claude_launch is defined by that file, in a clean zsh
  out="$(zsh -fc "source '$LAUNCH_FILE' && whence -w __claude_launch" 2>&1)"
  [[ "$out" == *": function" ]] && ok "6 launch file defines __claude_launch" || bad "6 function" "$out"
  # 7. negative control: a missing launch file is REFUSED before any launch (dry-run untouched)
  out="$(PJ_LAUNCH_FILE="$root/nope" PJ_PROMPT_OUT="$root/prompt.md" "$SELF" --dry-run 2>/dev/null)"; rc=$?
  [[ $rc -eq 0 && "${out%%$'\n'*}" == claude ]] && ok "7 dry-run does not need the launch file" || bad "7 dry-run vs launch file" "rc=$rc"
  # 8. the dry-run path NEVER kicks a fetch: a real git repo is left with no FETCH_HEAD.
  #    The fixture is a real repo with a real (unreachable) remote, so a fetch WOULD write.
  local dc="$root/dotclaude"
  git init -q --bare "$root/origin.git" >/dev/null 2>&1
  git init -q "$dc" >/dev/null 2>&1
  git -C "$dc" remote add origin "$root/origin.git" >/dev/null 2>&1
  PJ_PROMPT_OUT="$root/prompt.md" OPEN_ITEMS_DOTCLAUDE="$dc" "$SELF" --dry-run >/dev/null 2>&1
  [[ ! -e "$dc/.git/FETCH_HEAD" ]] && ok "8 --dry-run kicks no fetch (no FETCH_HEAD written)" || bad "8 dry-run fetched" "FETCH_HEAD exists"
  # 9. the guard: PJ_NO_FETCH, a non-repo, and a fresh FETCH_HEAD each return 0 and fetch nothing
  PJ_NO_FETCH=1 OPEN_ITEMS_DOTCLAUDE="$dc" kick_dotclaude_fetch
  [[ $? -eq 0 && ! -e "$dc/.git/FETCH_HEAD" ]] && ok "9 PJ_NO_FETCH suppresses the fetch" || bad "9 PJ_NO_FETCH" "fetched or rc!=0"
  OPEN_ITEMS_DOTCLAUDE="$root/not-a-repo" kick_dotclaude_fetch
  [[ $? -eq 0 ]] && ok "9 a directory with no .git is a silent no-op" || bad "9 non-repo" "rc=$?"
  : > "$dc/.git/FETCH_HEAD"
  OPEN_ITEMS_DOTCLAUDE="$dc" kick_dotclaude_fetch
  [[ $? -eq 0 ]] && ok "9 a FETCH_HEAD under 10 min old skips the fetch" || bad "9 fresh FETCH_HEAD" "rc=$?"
  # 10. POSITIVE CONTROL for arm 8: with no guard in the way the fetch IS reached.
  #     Without this arm, arm 8 passes just as well when the function is broken and never
  #     fetches at all -- "no FETCH_HEAD" is true in both worlds.
  #     A SECOND, VIRGIN fixture, never a cleared one: `rm` here is the Trash-routed shim,
  #     which can refuse and leave the file (measured 2026-09-21 in this very arm), and then
  #     the control would pass on a stale file instead of a fresh fetch.
  local dc2="$root/dotclaude2"
  git init -q "$dc2" >/dev/null 2>&1
  git -C "$dc2" remote add origin "$root/origin.git" >/dev/null 2>&1
  [[ ! -e "$dc2/.git/FETCH_HEAD" ]] || bad "10 fixture was not virgin" "FETCH_HEAD already present"
  OPEN_ITEMS_DOTCLAUDE="$dc2" kick_dotclaude_fetch
  local waited=0
  while [[ $waited -lt 50 && ! -e "$dc2/.git/FETCH_HEAD" ]]; do sleep 0.1; waited=$((waited + 1)); done
  [[ -e "$dc2/.git/FETCH_HEAD" ]] && ok "10 control: with no guard the fetch IS reached (FETCH_HEAD appears)" \
    || bad "10 control did not fetch -- arm 8 proves nothing" "no FETCH_HEAD after ${waited}00ms"
  # ---- profiles (F5a) -------------------------------------------------------------
  # 11. NO profiles dir at all: the argv is the built-in one. This is the consumer-box
  #     fallback, and it is arm ONE of the byte-for-byte guarantee.
  local pdir="$root/profiles" base
  base="$(PJ_PROFILE_DIR="$root/none-such" PJ_PROMPT_OUT="$root/prompt.md" "$SELF" --dry-run 2>/dev/null)"
  [[ "${base%%$'\n'*}" == claude ]] && ok "11 no profiles dir: still launches (built-in fallback)" || bad "11 no profiles dir" "$base"
  n=0; for d in "${PLUGIN_DIRS[@]}"; do [[ "$base" == *$'\n--plugin-dir\n'"$HOME/.claude/$d"$'\n'* ]] && n=$((n + 1)); done
  [[ $n -eq 5 ]] && ok "11 fallback carries all five plugin dirs" || bad "11 fallback plugins" "$n of 5"
  # 12. a `default` profile that spells out today's values produces the SAME argv, byte
  #     for byte. Hard constraint 1 of F5a, proven against arm 11's output rather than
  #     against a copy of the expected text.
  mkdir -p "$pdir"
  {
    print -- "config_dir:      ~/.claude"
    print -- "setting_sources: project,local"
    print -- "settings:        ~/.claude/settings.project.json"
    print -- "prompt:          pj-prompt-file"
    print -- "plugins:         skills/herdr skills/AgentRelay skills/ISA pj-voice pj"
    print -- "required:        --dangerously-skip-permissions --effort high"
    print -- "mode:            normal"
    print -- "card:            on"
  } > "$pdir/default"
  out="$(PJ_PROFILE_DIR="$pdir" PJ_PROMPT_OUT="$root/prompt.md" "$SELF" --dry-run 2>/dev/null)"
  [[ "$out" == "$base" ]] && ok "12 the default profile reproduces the built-in argv byte for byte" || bad "12 default profile drift" "$(diff <(print -r -- "$base") <(print -r -- "$out") | head -6)"
  # 13. the default profile exports NO CLAUDE_CONFIG_DIR. A variable set to its own
  #     default is not the same as an unset one, and this is the arm that keeps them apart.
  out="$(PJ_PROFILE_DIR="$pdir" PJ_PROMPT_OUT="$root/prompt.md" "$SELF" --dry-run-env 2>/dev/null)"
  [[ "$out" != *CLAUDE_CONFIG_DIR* ]] && ok "13 default profile exports no CLAUDE_CONFIG_DIR" || bad "13 default exported a config dir" "$out"
  [[ "$out" == *"PJ_PROFILE=default"* ]] && ok "13 default profile names itself in the env" || bad "13 PJ_PROFILE" "$out"
  # 14. a named profile: config dir exported, no plugin dirs, card off, safe mode absent
  {
    print -- "config_dir: $root/cfg-x"
    print -- "plugins:    none"
    print -- "card:       off"
  } > "$pdir/scratchy"
  out="$(PJ_PROFILE_DIR="$pdir" PJ_PROMPT_OUT="$root/prompt.md" "$SELF" --profile scratchy --dry-run 2>/dev/null)"
  [[ "$out" != *"--plugin-dir"* ]] && ok "14 plugins: none passes no --plugin-dir" || bad "14 plugins none" "$out"
  [[ "$out" != *"--safe-mode"* ]] && ok "14 mode defaults to normal (no --safe-mode)" || bad "14 unexpected safe mode" "$out"
  # 14b. THE MERGE RULE: scratchy never says `required`, and still gets both flags.
  [[ "$out" == *$'\n--dangerously-skip-permissions\n--effort\nhigh' ]] && ok "14b required flags are inherited from the default profile" || bad "14b merge rule" "$out"
  out="$(PJ_PROFILE_DIR="$pdir" PJ_PROMPT_OUT="$root/prompt.md" "$SELF" --profile scratchy --dry-run-env 2>/dev/null)"
  [[ "$out" == *"CLAUDE_CONFIG_DIR=$root/cfg-x"* ]] && ok "14 a forked config dir IS exported" || bad "14 config dir" "$out"
  [[ "$out" == *"PJ_NO_CARD=1"* ]] && ok "14 card: off exports PJ_NO_CARD=1" || bad "14 card off" "$out"
  # 15. mode: safe adds --safe-mode, and ONLY then. Kept supported for P9's baseline.
  printf 'mode: safe\n' > "$pdir/safey"
  out="$(PJ_PROFILE_DIR="$pdir" PJ_PROMPT_OUT="$root/prompt.md" "$SELF" --profile safey --dry-run 2>/dev/null)"
  [[ "$out" == *$'\n--safe-mode\n'* ]] && ok "15 mode: safe adds --safe-mode" || bad "15 safe mode" "$out"
  # 16. a profile that does not exist REFUSES rc 2 and prints no argv. Silence would
  #     launch the default profile under the wrong name, which is the dangerous arm.
  out="$(PJ_PROFILE_DIR="$pdir" PJ_PROMPT_OUT="$root/prompt.md" "$SELF" --profile nope --dry-run 2>"$root/err16")"; rc=$?
  [[ $rc -eq 2 && -z "$out" ]] && ok "16 unknown profile REFUSES rc 2, prints no argv" || bad "16 unknown profile" "rc=$rc out=$out"
  grep -q REFUSED "$root/err16" && ok "16 the refusal names itself on stderr" || bad "16 stderr" "$(<"$root/err16")"
  # 17. --profile with no name refuses; and a LATER --profile is a claude arg, not ours
  PJ_PROFILE_DIR="$pdir" "$SELF" --profile >/dev/null 2>&1; rc=$?
  [[ $rc -eq 2 ]] && ok "17 --profile with no name refuses rc 2" || bad "17 bare --profile" "rc=$rc"
  out="$(PJ_PROFILE_DIR="$pdir" PJ_PROMPT_OUT="$root/prompt.md" "$SELF" --dry-run --profile x 2>/dev/null)"
  [[ "$out" == *$'\n--profile\nx' ]] && ok "17 a later --profile passes through to claude" || bad "17 pass-through" "$out"
  # 18. PJ_PROFILE selects without the flag
  out="$(PJ_PROFILE=scratchy PJ_PROFILE_DIR="$pdir" PJ_PROMPT_OUT="$root/prompt.md" "$SELF" --dry-run 2>/dev/null)"
  [[ "$out" != *"--plugin-dir"* ]] && ok "18 PJ_PROFILE selects the profile without a flag" || bad "18 PJ_PROFILE" "$out"
  # 19. F5b: the three per-profile keys from the W-20260920-A03 audit.
  #     19a is the POSITIVE arm and 19d the NEGATIVE one, and 19d is the arm that
  #     matters: an absent key must emit NOTHING, because emitting the default value
  #     instead would break the byte-identical guarantee arm 1 proves. A negative arm
  #     alone cannot tell "correctly silent" from "the feature never ran", so 19a-c run
  #     against the SAME fixture dir in the same breath.
  {
    print -- "model:          haiku"
    print -- "remote_control: on"
    print -- "voice:          off"
  } > "$pdir/threekeys"
  out="$(PJ_PROFILE_DIR="$pdir" PJ_PROMPT_OUT="$root/prompt.md" "$SELF" --profile threekeys --dry-run 2>/dev/null)"
  [[ "$out" == *$'\n--model\nhaiku\n'* ]] && ok "19a model: emits --model <name>" || bad "19a model" "$out"
  [[ "$out" == *'"remoteControlAtStartup":true'* ]] && ok "19b remote_control: on rides a second --settings" || bad "19b remote_control" "$out"
  [[ "$out" == *'"voiceEnabled":false'* ]] && ok "19c voice: off is emitted explicitly, not omitted" || bad "19c voice" "$out"
  n=$(print -r -- "$out" | grep -c -- '^--settings$')
  [[ "$n" -eq 2 ]] && ok "19c the FILE --settings survives beside the overlay (2 of them)" || bad "19c settings count" "got $n, wanted 2"
  # 19d. the negative arm: a profile naming none of the three emits none of them.
  printf 'plugins: none\n' > "$pdir/nokeys"
  out="$(PJ_PROFILE_DIR="$pdir" PJ_PROMPT_OUT="$root/prompt.md" "$SELF" --profile nokeys --dry-run 2>/dev/null)"
  [[ "$out" != *"--model"* ]] && ok "19d an unset model emits no --model" || bad "19d model leaked" "$out"
  [[ "$out" != *'"voiceEnabled"'* && "$out" != *'"remoteControlAtStartup"'* ]] && ok "19d unset keys emit no overlay --settings" || bad "19d overlay leaked" "$out"
  n=$(print -r -- "$out" | grep -c -- '^--settings$')
  [[ "$n" -eq 1 ]] && ok "19d exactly ONE --settings when no profile key is set" || bad "19d settings count" "got $n, wanted 1"
  print -- "pj selftest: $pass passed, $fail failed"
  [[ $fail -eq 0 ]]
}

# --profile is read BEFORE --dry-run so `pj --profile scratch --dry-run` works, and only
# in leading position so a later --profile passes through to claude untouched.
WANT="${PJ_PROFILE:-default}"
if [[ "${1:-}" == --profile ]]; then
  if [[ -z "${2:-}" ]]; then
    print -u2 -- "pj: REFUSED: --profile needs a name (pj --profile scratch)"
    exit 2
  fi
  WANT="$2"; shift 2
fi

case "${1:-}" in
  --dry-run)
    shift
    load_profile "$WANT" || exit $?
    build_argv || exit $?
    print -l -- "${PJ_ARGV[@]}" "$@"
    exit 0 ;;
  --dry-run-env)
    # the env half of the dry run, one VAR=value per line. Deliberately a SEPARATE flag:
    # --dry-run must keep printing argv and nothing else, or the byte-for-byte default
    # comparison that hard constraint 1 rests on would compare two different things.
    shift
    load_profile "$WANT" || exit $?
    build_argv || exit $?
    print -l -- "${PJ_ENV[@]}"
    exit 0 ;;
  --selftest) selftest; exit $? ;;
esac

load_profile "$WANT" || exit $?
build_argv || exit $?
if [[ ! -r "$LAUNCH_FILE" ]]; then
  print -u2 -- "pj: REFUSED: ${LAUNCH_FILE/#$HOME/~} missing; stow -R the dotfiles"
  exit 2
fi
kick_dotclaude_fetch
source "$LAUNCH_FILE"
# Exported into THIS script's own process, which is safe because the script is its own
# process: nothing leaks back to the interactive shell that typed `pj`. NOT `env VAR=v
# __claude_launch ...` -- `env` execs an external command and __claude_launch is a shell
# function, so that form would fail with "No such file or directory".
# PJ_ENV never contains CLAUDE_CONFIG_DIR on the default profile, so the default launch
# still runs with that variable UNSET rather than set to its own default.
for _pv in "${PJ_ENV[@]}"; do export "${_pv%%=*}=${_pv#*=}"; done
unset _pv
__claude_launch "${PJ_ARGV[@]}" "$@"
