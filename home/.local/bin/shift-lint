FIX
  echo "=== UNGUARDED-LOOP: master imsg, and a one-line loop ==="
  lint "$T/imsg.sh"
  has "imsg.sh:6: UNGUARDED-LOOP"; chk "imsg --max flagged" $?
  has "imsg.sh:7: UNGUARDED-LOOP"; chk "imsg --account flagged" $?
  has "imsg.sh:14: UNGUARDED-LOOP"; chk "ci-watch-selftest:653 one-liner flagged: the loop's own \$# test is not a guard" $?
  has "imsg.sh:8: "; [ $? -ne 0 ]; chk "the arm after '-h|--help)  usage; exit 0 ;;' is not a site (control: no line-8 record)" $?

  # --- F3: one guarded example of each form, all real ---
  cat > "$T/guarded.sh" <<'FIX'   # shift-lint: fixture real lines, deliberately unguarded, for the selftest
