  echo "=== each guard removed or weakened is caught (mutations of the lines above) ==="
  lint "$T/mutated.sh"
  [ $rc -eq 1 ]; chk "mutated fixture: exit 1 (got $rc)" $?
  has "mutated.sh:6: WEAK"; chk "open-items --check with -ge 2 before shift 3: WEAK" $?
  has "mutated.sh:7: WEAK"; chk "open-items --for with -gt 0 before shift 2: WEAK" $?
  has "mutated.sh:11: "; chk "watch-history-sync with a plain shift between guard and shift 2: not accepted" $?
  has "mutated.sh:11: ok"; [ $? -ne 0 ]; chk "  ...and not reported ok" $?
