JSON
cat > "$D/fix.sh" <<'EOF'   # shift-lint: fixture a deliberately broken script for a test
#!/usr/bin/env bash
while :; do x=1; shift 2; done
EOF
cat > "$D/fix2.sh" <<'EOF'   # shift-lint: fixture
#!/bin/sh
EOF
echo hi   # shift-lint: fixture no heredoc here
FIX
  echo "=== a heredoc that writes a shell script is scanned as code (ci-watch-selftest's stub) ==="
  lint "$T/emb.sh"
  local L23
  has "emb.sh:11: UNGUARDED-LOOP: shift 2 in a loop with no guard: a value flag given last shifts nothing and the loop spins forever [in a script written by a heredoc]"; chk "stub --repo inside the heredoc script: UNGUARDED-LOOP, marked as in a heredoc script" $?
  has "emb.sh:12: UNGUARDED-LOOP"; chk "stub --branch flagged" $?
  has "emb.sh:18: ok heredoc"; chk "a text heredoc INSIDE the script is text" $?
  L23="$(printf '%s\n' "$out" | awk 'index($0, "emb.sh:23:")')"
  case "$L23" in *UNGUARDED-LOOP*) case "$L23" in *"heredoc]"*) false ;; *) true ;; esac ;; *) false ;; esac
  chk "after the script's terminator the outer file is code again, not marked as heredoc (line 23)" $?
  has "emb.sh:27: UNGUARDED-LOOP"; chk "a heredoc fed to 'bash <<' is a script even without a shebang" $?
  has "emb.sh:30: ok heredoc"; chk "a JSON heredoc is text, counted, not judged" $?
  has "emb.sh:34: ok fixture"; chk "'# shift-lint: fixture <reason>' on the opener: body counted as fixture, not judged" $?
  has "emb.sh:36: ANNOTATION: \`# shift-lint: fixture\` needs a reason"; chk "a fixture annotation with no reason is a finding" $?
  has "emb.sh:39: ANNOTATION: \`# shift-lint: fixture\` on a line that opens no heredoc"; chk "a fixture annotation with no heredoc is a finding" $?

  echo "=== refusals: nothing checked is never a pass ==="
  printf '# notes\n' > "$T/notes.md"
  lint "$T/notes.md"; [ $rc -eq 2 ] && has "checked 0 shell files"; chk "only a non-shell file: exit 2, says 0 checked (rc $rc)" $?
  lint "$T/does-not-exist"; [ $rc -eq 2 ]; chk "a missing path: exit 2 (rc $rc)" $?
  mkdir -p "$T/d"; : > "$T/d/empty.sh"
  lint "$T/d"; [ $rc -eq 2 ] && has "read 0 lines"; chk "a shell file with 0 lines: exit 2, not clean (rc $rc)" $?
  cp "$T/guarded.sh" "$T/locked.sh"; chmod 000 "$T/locked.sh"
  lint "$T/guarded.sh" "$T/locked.sh"; [ $rc -eq 2 ] && has "UNREADABLE" && has "locked.sh"; chk "an unreadable file is named and the run exits 2 (rc $rc)" $?
  chmod 600 "$T/locked.sh"
  mkdir -p "$T/walk/shut"; cp "$T/guarded.sh" "$T/walk/g.sh"; cp "$T/decided.sh" "$T/walk/shut/d.sh"; chmod 000 "$T/walk/shut"
  lint "$T/walk"; [ $rc -eq 2 ] && has "UNREADABLE" && has "shut"; chk "a directory the walk cannot enter is named and the run exits 2, not 0 (rc $rc)" $?
  chmod 700 "$T/walk/shut"
  lint "$T/walk"; [ $rc -eq 1 ] && has "d.sh:7: UNGUARDED-LOOP"; chk "  control: the same directory, opened, is walked and its finding appears (rc $rc)" $?
  ln -s "$T/d" "$T/linkdir"
  lint "$T/guarded.sh" "$T/linkdir"; has "declined symlink" && has "linkdir"; chk "a symlinked directory is named as declined" $?
  out="$(builtin cd "$T" && "$self" 2>&1)"; rc=$?
  [ $rc -eq 2 ] && has "not inside a git repo"; chk "no PATH outside a git repo: exit 2 (rc $rc)" $?
  out="$("$self" --bogus 2>&1)"; rc=$?; [ $rc -eq 2 ]; chk "an unknown flag: exit 2 (rc $rc)" $?

  echo "=== shebang detection ==="
  printf '#!/usr/bin/env -S bash -e\nwhile :; do x=1; shift 2; done\n' > "$T/envs"
  printf '#!/bin/zsh -f\nwhile :; do x=1; shift 2; done\n' > "$T/zsh1"
  printf '#!/usr/bin/env -S uv run python3\nwhile :; do x=1; shift 2; done\n' > "$T/py1"
  mkdir -p "$T/she"; mv "$T/envs" "$T/zsh1" "$T/py1" "$T/she/"
  lint "$T/she"; has "envs:2: UNGUARDED-LOOP" && has "zsh1:2: UNGUARDED-LOOP"; chk "env -S bash and /bin/zsh shebangs are shell" $?
  has "py1:"; [ $? -ne 0 ] && has "1 other files skipped"; chk "an env -S uv run python3 shebang is not shell, and is counted as skipped" $?

  echo "=== this file checks clean against itself (its fixtures are annotated heredocs) ==="
  lint "$self"; [ $rc -eq 0 ] && has "findings 0" && ! has "fixture heredoc 0"; chk "shift-lint on itself: exit 0, its fixtures counted as fixture heredocs (rc $rc)" $?

  rm -rf "$T" 2>/dev/null
  echo "shift-lint selftest: $pass passed, $fail failed"
  [ $fail -eq 0 ]
}

while [ $# -gt 0 ]; do
  case "$1" in
    --selftest) SELFTEST=1; shift ;;
    -v|--verbose) VERBOSE=1; shift ;;
    -h|--help) usage; exit 0 ;;
    --) shift; break ;;
    -*) refuse "unknown flag $1 (see --help)" ;;
    *) break ;;
  esac
done

if [ $SELFTEST -eq 1 ]; then selftest; exit $?; fi
run_lint "$@"
