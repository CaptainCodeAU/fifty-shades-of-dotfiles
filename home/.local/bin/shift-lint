  has "mutated.sh:14: UNGUARDED-LOOP"; chk "shift 2 && set --: not form c" $?

  # --- F5: loop condition, not-a-loop, READ, annotation ---
  cat > "$T/other.sh" <<'FIX'   # shift-lint: fixture real lines, deliberately unguarded, for the selftest
