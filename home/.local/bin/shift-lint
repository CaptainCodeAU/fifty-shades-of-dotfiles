  echo "=== guarded forms a, b, c, d (open-items, deletion guard, git-leak-scan, decided, watch-history-sync) ==="
  lint "$T/guarded.sh"
  [ $rc -eq 0 ]; chk "all-guarded fixture: exit 0 (got $rc)" $?
  has "guarded.sh:6: ok guarded-b"; chk "form b: need_val ... \$# (open-items --kind)" $?
  has "guarded.sh:7: ok guarded-a"; chk "form a: [ \$# -ge 2 ] || refuse on the same line (open-items --for)" $?
  has "guarded.sh:9: ok guarded-d"; chk "form d: the test on the arm's first line, shift 3 on the next (open-items --check)" $?
  has "guarded.sh:14: ok guarded-c"; chk "form c: shift 2 || set -- (deletion guard, time -o)" $?
  has "guarded.sh:17: ok guarded-c"; chk "form c: shift 2 || shift (git-leak-scan --range)" $?
  has "guarded.sh:19: ok guarded-c"; chk "form c with a redirection: shift 2 2>/dev/null || shift (decided --status)" $?
  has "guarded.sh:24: ok guarded-d"; chk "form d across an assignment line (watch-history-sync --db-path)" $?
  has "findings 0"; chk "summary states 'findings 0' positively" $?

  # --- F4: the same lines MUTATED so each guard is gone or too small ---
  cat > "$T/mutated.sh" <<'FIX'   # shift-lint: fixture real lines, deliberately unguarded, for the selftest
