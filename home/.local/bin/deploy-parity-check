#!/usr/bin/env -S uv run python3
# /// script
# requires-python = ">=3.10"
# dependencies = []
# ///
#
# ============================================================================
#  deploy-parity-check -- is every tracked home/ file actually linked into ~/ ?
# ============================================================================
#
# WHY
# ---
# On 2026-08-01 `herdr-cooldown-check` was found undeployed. It had been that
# way since 2026-07-29 and nothing said a word: the SessionStart hook falls
# back to the repo copy, and a shell only reports "command not found" for a
# command somebody actually types. A second file, home/.config/lazygit/
# config.yml, turned out to have the same problem.
#
# The cause was not stow. Symlink birth times showed the bulk created
# 2026-07-16 and each newer script linked individually on the day it was
# written. (This used to say `stow -R` relinks everything in one pass and would
# stamp them identically. It does not: stow 2.4.1 leaves an unchanged link
# alone, same inode and birth time -- measured 2026-10-05. The conclusion
# stands on the individual birth times alone.) So deploying a new file is a
# manual step somebody has to remember, it was forgotten twice, and there was
# no detector.
#
# WHY IT IS A SCRIPT AND NOT THREE COPIES
# ---------------------------------------
# The same logic was wanted in install.sh (--check), in /refresh (drift lane)
# and in the shell welcome banner. Three inline copies drift apart, and the
# /refresh command already declares "REUSE, don't reimplement" as a principle.
# One implementation, three callers.
#
# THE SELF-TEST RUNS EVERY TIME
# -----------------------------
# A guard that can only ever print OK is decoration -- and this guard exists
# BECAUSE a previous one, /refresh's drift probe, silently reported clean for
# a condition it structurally could not detect (`[ -L "$t" ]` is false when
# nothing is there at all, so the test short-circuited). Rather than trust
# that this one is different, it proves its own detectors against synthetic
# fixtures on every invocation, using the SAME function the real run uses.
#
# EXIT CODES
#   0  every tracked file is deployed (or the repo could not be located)
#   1  something is MISSING, SHADOWED or a WRONG link (dangling, or not into
#      this repo), or a detector assertion failed
# ============================================================================

import os
import subprocess
import sys
import tempfile
from pathlib import Path

# Mirrors home/.stow-local-ignore. KEEP IN SYNC: a pattern there without a
# counterpart here makes this tool report files stow was never going to create.
SKIP_NAMES = {".gitignore", ".gitmodules", ".DS_Store", ".stow-local-ignore",
              ".Spotlight-V100", ".Trashes"}


def is_ignored(rel: str) -> bool:
    """True when stow would never deploy this path, so absence is correct."""
    parts = Path(rel).parts
    if any(p in SKIP_NAMES or p.startswith("._") for p in parts):
        return True
    if "__pycache__" in parts or rel.endswith(".pyc"):
        return True
    # install.sh's skip flags (--skip-claude, --skip-ssh, ...) keep whole top-level
    # names out of stow and hand them here as DOTFILES_STOW_SKIP, colon-separated,
    # so the same run that skipped a tree does not then report it as not deployed.
    # Unset: read what the last real stow on this box recorded (install.sh writes
    # the same names to links/stow-skip). Set but empty: skip nothing, whatever the
    # file says -- the caller's flags are the truth for that run.
    skip = os.environ.get("DOTFILES_STOW_SKIP")
    if skip is None:
        state = Path(os.environ.get("XDG_STATE_HOME", Path.home() / ".local" / "state"))
        f = state / "dotfiles" / "links" / "stow-skip"
        skip = ":".join(f.read_text().split()) if f.is_file() else ""
    return bool(parts) and parts[0] in {s for s in skip.split(":") if s}


def classify(rel: str, target_root: Path, repo_home: Path | None = None) -> str:
    """OK | MISSING | SHADOWED | WRONG -- the one detector both callers and the
    self-test exercise. MISSING and SHADOWED need different fixes, so they
    are never collapsed into one verdict. With repo_home, a link only counts
    as OK when it resolves to repo_home/rel: a dangling link, or one into
    another copy of the repo, is WRONG (it used to read OK -- found by the
    2026-10-05 outage investigation)."""
    t = target_root / rel
    if t.is_symlink():
        if repo_home is None:
            return "OK"
        try:
            want = (repo_home / rel).resolve(strict=True)
            got = t.resolve(strict=True)
        except (OSError, RuntimeError):
            return "WRONG"
        return "OK" if got == want else "WRONG"
    if t.exists():
        return "SHADOWED"
    return "MISSING"


def tracked_files(repo: Path) -> list[str]:
    """git-TRACKED only -- the working tree would let build artefacts and
    untracked scratch produce false positives."""
    out = subprocess.run(["git", "-C", str(repo), "ls-files", "home/"],
                         capture_output=True, text=True)
    if out.returncode != 0:
        return []
    return [line[len("home/"):] for line in out.stdout.splitlines()
            if line.startswith("home/")]


def self_test() -> list[str]:
    """Prove both detectors fire, in both directions, against a throwaway
    tree. No network, no subprocess, nothing real touched."""
    failures = []
    with tempfile.TemporaryDirectory() as d:
        root = Path(d)
        (root / "sub").mkdir()
        real = root / "sub" / "real.txt"
        real.write_text("x")
        link = root / "sub" / "link.txt"
        link.symlink_to(real)

        if classify("sub/link.txt", root) != "OK":
            failures.append("a present symlink did not read as OK")
        if classify("sub/real.txt", root) != "SHADOWED":
            failures.append("a real file where a link belongs did not read as SHADOWED")
        if classify("sub/absent.txt", root) != "MISSING":
            failures.append("an absent path did not read as MISSING")

        # The exact bug this tool was written to replace: a check that only
        # asks "is it a dangling symlink?" scores an absent path as fine.
        if classify("nothing/at/all", root) == "OK":
            failures.append("an entirely absent path scored OK -- the 2026-08-01 blind spot is back")

        # With a repo: only a link that resolves to repo/home/rel is OK.
        repo_home = root / "repo" / "home"
        (repo_home / "sub").mkdir(parents=True)
        (repo_home / "sub" / "a.txt").write_text("a")
        (repo_home / "sub" / "b.txt").write_text("b")
        tgt = root / "t"
        (tgt / "sub").mkdir(parents=True)
        (tgt / "sub" / "a.txt").symlink_to(repo_home / "sub" / "a.txt")
        (tgt / "sub" / "b.txt").symlink_to(repo_home / "sub" / "a.txt")
        (tgt / "sub" / "c.txt").symlink_to(root / "gone" / "c.txt")
        if classify("sub/a.txt", tgt, repo_home) != "OK":
            failures.append("a link to the right repo file did not read as OK")
        if classify("sub/b.txt", tgt, repo_home) != "WRONG":
            failures.append("a link to the WRONG file read as fine")
        if classify("sub/c.txt", tgt, repo_home) != "WRONG":
            failures.append("a DANGLING link read as fine -- the 2026-10-05 blind spot")

        if not is_ignored("some/__pycache__/x.pyc"):
            failures.append("__pycache__ was not treated as never-deployed")
        if not is_ignored(".stow-local-ignore"):
            failures.append("stow's own control file was not treated as never-deployed")
        if is_ignored(".local/bin/ci-watch"):
            failures.append("an ordinary tracked file was wrongly treated as ignored")
        # The install.sh skip flags, both arms: a skipped tree is ignored, a
        # sibling is not, and an empty variable skips nothing.
        saved = os.environ.get("DOTFILES_STOW_SKIP")
        try:
            os.environ["DOTFILES_STOW_SKIP"] = ".claude:.ssh"
            if not is_ignored(".claude/hooks/x.sh"):
                failures.append("a tree named in DOTFILES_STOW_SKIP was not treated as skipped")
            if is_ignored(".local/bin/ci-watch"):
                failures.append("DOTFILES_STOW_SKIP leaked onto a path it does not name")
            os.environ["DOTFILES_STOW_SKIP"] = ""
            if is_ignored(".claude/hooks/x.sh"):
                failures.append("an empty DOTFILES_STOW_SKIP still skipped something")
        finally:
            if saved is None:
                os.environ.pop("DOTFILES_STOW_SKIP", None)
            else:
                os.environ["DOTFILES_STOW_SKIP"] = saved
    return failures


def main() -> int:
    repo = os.environ.get("DOTFILES_REPO")
    if repo:
        repo_path = Path(repo)
    else:
        out = subprocess.run(["git", "rev-parse", "--show-toplevel"],
                             capture_output=True, text=True,
                             cwd=Path(__file__).resolve().parent)
        if out.returncode != 0:
            print("deploy parity: repo not located, skipped")
            return 0
        repo_path = Path(out.stdout.strip())

    target_root = Path(os.environ.get("DEPLOY_TARGET", Path.home()))

    broken = self_test()
    for f in broken:
        print(f"  DETECTOR BROKEN - {f}")
    if broken:
        print("  the parity result below cannot be trusted")

    missing, shadowed, wrong = [], [], []
    for rel in tracked_files(repo_path):
        if is_ignored(rel):
            continue
        verdict = classify(rel, target_root, repo_path / "home")
        if verdict == "MISSING":
            missing.append(rel)
        elif verdict == "SHADOWED":
            shadowed.append(rel)
        elif verdict == "WRONG":
            wrong.append(rel)

    if not missing and not shadowed and not wrong and not broken:
        print(f"  deploy parity OK - every tracked home/ file is linked into this repo ({len(tracked_files(repo_path))} checked)")
        return 0

    for rel in missing:
        print(f"  NOT DEPLOYED: ~/{rel}")
    for rel in shadowed:
        print(f"  SHADOWED (real file where a link belongs): ~/{rel}")
    for rel in wrong:
        print(f"  WRONG LINK (dangling, or not into this repo): ~/{rel}")
    if missing or wrong:
        print("  Fix: ./install.sh --stow-only  (or, with no hooks working: sh ~/.local/state/dotfiles/links/restore)")
    if shadowed:
        print("  Shadowed files: sh ~/.local/state/dotfiles/links/restore moves them aside (never deletes) and relinks;")
        print("  check first whether one holds an edit that belongs in the repo.")
    return 1


if __name__ == "__main__":
    sys.exit(main())
