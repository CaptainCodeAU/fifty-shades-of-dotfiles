#!/usr/bin/env zsh
# zsh-welcome-selftest -- prove the welcome banner's pnpm-vs-nvm PATH check fires.
#
# Sibling of zsh-node-functions-selftest. The check exists because pnpm 12's
# globalShims:false (Ruling D-20260919-06) keeps `node` with nvm only while nvm's
# bin precedes $PNPM_HOME/bin on PATH, and nothing watched that order (Ruling
# D-20260919-11). It is exception-based: silent when right, loud when not. Both
# halves are driven here -- a check that is always silent looks identical to one
# that is always right.
#
# THE SEAM is __welcome_pnpm_path_check's output and exit code for a given PATH
# string. The function is EXTRACTED from the real ~/.zsh_welcome by name (the
# file runs the banner at source time, so it cannot simply be sourced), so the
# test sees today's code, not a copy.
#
# Usage: zsh-welcome-selftest      (exit 0 = all passed)

setopt no_unset pipe_fail 2>/dev/null

PASS=0; FAIL=0

_resolve_repo() {
    local self="${(%):-%x}" dir target
    dir="$(cd -- "$(dirname -- "$self")" && pwd)"
    if [[ -L "$self" ]]; then
        target="$(readlink "$self")"
        [[ "$target" != /* ]] && target="$dir/$target"   # re-base a relative stow link
        dir="$(cd -- "$(dirname -- "$target")" && pwd)"
    fi
    (cd -- "$dir/../../.." && pwd)                      # <repo>/home/.local/bin -> <repo>
}
REPO="$(_resolve_repo)"
WELCOME="${WELCOME_OVERRIDE:-$REPO/home/.zsh_welcome}"

ok()  { PASS=$(( PASS + 1 )); printf '  \033[32mPASS\033[0m  %s\n' "$1"; }
bad() { FAIL=$(( FAIL + 1 )); printf '  \033[31mFAIL\033[0m  %s\n' "$1"
        [[ $# -gt 1 ]] && printf '        %s\n' "$2"; }
code_of() { grep -v '^[[:space:]]*#' <<<"$1"; }

echo "zsh_welcome selftest (pnpm-vs-nvm PATH order)"
echo

if [[ ! -f "$WELCOME" ]]; then
    bad ".zsh_welcome found" "looked at $WELCOME"
    echo; echo "  $PASS passed, $FAIL failed"; exit 1
fi

# --- 1. static: defined, and called from the full banner ---------------------
fn_src=$(sed -n '/^__welcome_pnpm_path_check() {/,/^}/p' "$WELCOME")
if [[ -n "$fn_src" ]]; then ok "__welcome_pnpm_path_check is defined"
else bad "__welcome_pnpm_path_check is defined" "not found in $WELCOME"
     echo; echo "  $PASS passed, $FAIL failed"; exit 1; fi
full_src=$(sed -n '/^__show_welcome_full() {/,/^}/p' "$WELCOME")
if code_of "$full_src" | grep -cE '^[[:space:]]+__welcome_pnpm_path_check$' >/dev/null; then
    ok "called from __show_welcome_full"
else bad "called from __show_welcome_full" "defined but never invoked from the banner"; fi

# --- 2. behaviour: the real function, fixture PATH strings -------------------
eval "$fn_src"
ok=""; err=""; done=""; warn=""
export HOME="${HOME}"
NVM_BIN="$HOME/.nvm/versions/node/v24.0.0/bin"
PNPM_BIN="$HOME/Library/pnpm/bin"
unset PNPM_HOME 2>/dev/null; PNPM_HOME=""

run_check() { OUT="$(__welcome_pnpm_path_check "$1" "$PNPM_BIN" 2>&1)"; RC=$?; }

# 2a. correct order: silent, exit 0
run_check "$NVM_BIN:/usr/local/bin:/usr/bin:/bin:$PNPM_BIN"
if (( RC == 0 )) && [[ -z "$OUT" ]]; then ok "correct order (nvm first): silent, exit 0"
else bad "correct order (nvm first): silent, exit 0" "rc=$RC out='$OUT'"; fi

# 2b. nvm present, pnpm bin absent entirely: still silent (nothing to shadow)
run_check "$NVM_BIN:/usr/local/bin:/usr/bin:/bin"
if (( RC == 0 )) && [[ -z "$OUT" ]]; then ok "nvm first, no pnpm bin at all: silent"
else bad "nvm first, no pnpm bin at all: silent" "rc=$RC out='$OUT'"; fi

# 2c. reversed order: warns, names pnpm's bin, exit 1
run_check "/usr/local/bin:$PNPM_BIN:/usr/bin:$NVM_BIN:/bin"
if (( RC == 1 )) && [[ "$OUT" == *"precedes nvm's bin"* ]] && [[ "$OUT" == *"$PNPM_BIN"* ]]; then
    ok "reversed order (pnpm first): warns and names the pnpm bin, exit 1"
else bad "reversed order (pnpm first): warns, exit 1" "rc=$RC out='$OUT'"; fi

# 2d. nvm missing from PATH: warns, exit 1
run_check "/usr/local/bin:$PNPM_BIN:/usr/bin:/bin"
if (( RC == 1 )) && [[ "$OUT" == *"no nvm bin on PATH"* ]]; then
    ok "nvm bin absent: warns, exit 1"
else bad "nvm bin absent: warns, exit 1" "rc=$RC out='$OUT'"; fi

# 2e. Linux layout: PNPM_HOME/bin is what is matched, not a macOS literal
PNPM_BIN="$HOME/.local/share/pnpm/bin"
run_check "$PNPM_BIN:$NVM_BIN:/usr/bin"
if (( RC == 1 )) && [[ "$OUT" == *"$PNPM_BIN"* ]]; then ok "Linux pnpm bin (\$PNPM_HOME/bin) is matched too"
else bad "Linux pnpm bin is matched too" "rc=$RC out='$OUT'"; fi

# 2f. default pnpm bin comes from PNPM_HOME when set (second arg omitted)
PNPM_HOME="$HOME/.local/share/pnpm"
OUT="$(__welcome_pnpm_path_check "$PNPM_HOME/bin:$NVM_BIN" 2>&1)"; RC=$?
if (( RC == 1 )) && [[ "$OUT" == *"$PNPM_HOME/bin"* ]]; then ok "default pnpm bin is derived from PNPM_HOME"
else bad "default pnpm bin is derived from PNPM_HOME" "rc=$RC out='$OUT'"; fi

# --- 3. npm guard check (D-20261006-A10): the real function, a fixture nvm dir ---
ng_src=$(sed -n '/^__welcome_npm_guard_check() {/,/^}/p' "$WELCOME")
if [[ -n "$ng_src" ]]; then ok "__welcome_npm_guard_check is defined"; eval "$ng_src"
else bad "__welcome_npm_guard_check is defined" "not found in $WELCOME"; fi
if code_of "$full_src" | grep -cE '^[[:space:]]+__welcome_npm_guard_check$' >/dev/null; then ok "npm guard check is called from __show_welcome_full"
else bad "npm guard check is called from __show_welcome_full" "defined but never invoked"; fi
if [[ -n "$ng_src" ]]; then
    NGT=$(mktemp -d "${TMPDIR:-/tmp}/zsh-welcome-ng.XXXXXX") || { bad "npm guard fixture" "mktemp failed -- INVALID"; NGT=""; }
fi
if [[ -n "${NGT:-}" ]]; then
    ngv() {  # ngv <version> <guard|real|nonpm>
        local b="$NGT/nvm/versions/node/$1/bin" l="$NGT/nvm/versions/node/$1/lib/node_modules/npm/bin" n
        mkdir -p "$b"; [[ "$2" == nonpm ]] && return
        mkdir -p "$l"; for n in npm npx; do : >| "$l/$n-cli.js"
            if [[ "$2" == guard ]]; then ln -sfn "$HOME/.local/bin/npm-guard" "$b/$n"; else ln -sfn "../lib/node_modules/npm/bin/$n-cli.js" "$b/$n"; fi; done
    }
    ngv v1.0.0 guard; ngv v2.0.0 guard; ngv v3.0.0 nonpm
    OUT="$(__welcome_npm_guard_check "$NGT/nvm" 2>&1)"; RC=$?
    if (( RC == 0 )) && [[ -z "$OUT" ]]; then ok "every version guarded: silent"
    else bad "every version guarded: silent" "rc=$RC out='$OUT'"; fi
    ngv v4.0.0 real
    OUT="$(__welcome_npm_guard_check "$NGT/nvm" 2>&1)"; RC=$?
    if (( RC == 1 )) && [[ "$OUT" == *"v4.0.0"* && "$OUT" != *"v1.0.0"* && "$OUT" != *"v3.0.0"* ]]; then ok "an unguarded version is named, only that one"
    else bad "an unguarded version is named, only that one" "rc=$RC out='$OUT'"; fi
    OUT="$(__welcome_npm_guard_check "$NGT/none" 2>&1)"; RC=$?
    if (( RC == 0 )) && [[ -z "$OUT" ]]; then ok "no nvm versions: silent"
    else bad "no nvm versions: silent" "rc=$RC out='$OUT'"; fi
fi

# --- 4. parts left out on purpose (W-20261015-A07): codebox state vs none -------
# The real functions from both files, a fixture state dir and a fixture gitconfig.
# Every "codebox says nothing wrong" arm has a control arm with no state that still
# prints the old warning, so a check that never ran cannot pass.
ONB="${ONBOARDING_OVERRIDE:-$REPO/home/.zsh_onboarding}"
echo
for fn in __dotfiles_skipped __tool_left_out __run_section __ensure_command __show_docker_guidance; do
    src=$(sed -n "/^$fn() {/,/^}/p" "$ONB")
    if [[ -n "$src" ]]; then eval "$src"; else bad "$fn is defined in .zsh_onboarding" "not found in $ONB"; fi
done
gl_src=$(sed -n '/^__welcome_github_line() {/,/^}/p' "$WELCOME")
if [[ -n "$gl_src" ]]; then eval "$gl_src"; ok "__welcome_github_line is defined"
else bad "__welcome_github_line is defined" "not found in $WELCOME"; fi
if code_of "$full_src" | grep -cE '^[[:space:]]+__welcome_github_line$' >/dev/null; then ok "GitHub line is called from __show_welcome_full"
else bad "GitHub line is called from __show_welcome_full" "defined but never invoked"; fi
if code_of "$full_src" | grep -c 'DOTFILES_PLAIN_CLAUDE' >/dev/null; then ok "GH API line is skipped on a plain-Claude box"
else bad "GH API line is skipped on a plain-Claude box" "no DOTFILES_PLAIN_CLAUDE test in __show_welcome_full"; fi

FX=$(mktemp -d "${TMPDIR:-/tmp}/zsh-welcome-skip.XXXXXX") || { bad "skip fixture" "mktemp failed -- INVALID"; FX=""; }
if [[ -n "$FX" ]]; then
    info=""
    __check_github_forward_drift() { echo nokey; }   # the old path's worst case
    export GIT_CONFIG_NOSYSTEM=1
    mkdir -p "$FX/cb/dotfiles/links" "$FX/old/dotfiles/links" "$FX/none" "$FX/bin"
    printf '%s\n' claude ssh system-packages tmux docker rust >| "$FX/cb/dotfiles/links/skips"
    printf '%s\n' .claude .ssh .tmux.conf .zsh_tmux .zsh_docker_functions >| "$FX/cb/dotfiles/links/stow-skip"
    printf '%s\n' .claude .ssh .tmux.conf .zsh_tmux .zsh_docker_functions >| "$FX/old/dotfiles/links/stow-skip"
    printf '[credential "https://github.com"]\n\thelper = !~/.local/bin/gh-broker-ssh git-credential\n' >| "$FX/broker.gitconfig"
    : >| "$FX/empty.gitconfig"
    for t in git curl rg tree lazygit; do printf '#!/bin/sh\n' >| "$FX/bin/$t"; chmod +x "$FX/bin/$t"; done
    gh_line() { XDG_STATE_HOME="$FX/$1" GIT_CONFIG_GLOBAL="$FX/$2.gitconfig" __welcome_github_line 2>&1; }
    left()    { XDG_STATE_HOME="$FX/$1" __tool_left_out "$2"; }
    section() { ( XDG_STATE_HOME="$FX/$1"; PATH="$FX/bin"; rehash
                  _PKG_MANAGER_NAME=apt _PKG_MANAGER_CMD="sudo apt-get install -y" _PKG_MANAGER_NEEDS_ROOT=1
                  __run_section "CLI tools" rg ripgrep ripgrep nvim neovim neovim tree tree tree \
                      fastfetch fastfetch fastfetch lazygit lazygit lazygit lazydocker lazydocker lazydocker ) 2>&1; }

    OUT=$(gh_line cb broker)
    if [[ "$OUT" == *"token broker"* && "$OUT" != *ssh-add* && "$OUT" != *"NO KEY"* ]]; then ok "codebox + broker: says HTTPS via the broker, no key advice"
    else bad "codebox + broker: says HTTPS via the broker, no key advice" "out='$OUT'"; fi
    OUT=$(gh_line none broker)
    if [[ "$OUT" == *"token broker"* && "$OUT" != *ssh-add* ]]; then ok "broker helper alone (no state file): still the broker line"
    else bad "broker helper alone (no state file): still the broker line" "out='$OUT'"; fi
    OUT=$(gh_line cb empty)
    if [[ "$OUT" == *"no HTTPS helper"* && "$OUT" != *ssh-add* ]]; then ok "ssh left out, no helper: says so, no key advice"
    else bad "ssh left out, no helper: says so, no key advice" "out='$OUT'"; fi
    OUT=$(gh_line none empty)
    if [[ "$OUT" == *"NO KEY"* && "$OUT" == *ssh-add* ]]; then ok "control: other boxes keep the forwarded-key check"
    else bad "control: other boxes keep the forwarded-key check" "out='$OUT'"; fi

    left cb nvim && left cb fastfetch && left cb docker && left cb lazydocker \
        && ok "codebox: nvim, fastfetch, docker, lazydocker are left out on purpose" \
        || bad "codebox: nvim, fastfetch, docker, lazydocker are left out on purpose"
    ! left cb jq && ! left cb trash-put && ! left cb lazygit \
        && ok "codebox: jq, trash-put, lazygit still count as missing" \
        || bad "codebox: jq, trash-put, lazygit still count as missing"
    left old docker && ! left old nvim \
        && ok "older state (stow-skip only): docker from it, apt tools not (needs a restow)" \
        || bad "older state (stow-skip only): docker from it, apt tools not"
    ! left none nvim && ! left none docker \
        && ok "control: no state, nothing is left out" \
        || bad "control: no state, nothing is left out"

    OUT=$(section cb)
    if [[ "$OUT" == *"left out on purpose: nvim · fastfetch · lazydocker"* && "$OUT" != *"Tool missing"* && "$OUT" != *"ask an admin"* ]]; then
        ok "codebox CLI tools: left-out tools named once, no missing line"
    else bad "codebox CLI tools: left-out tools named once, no missing line" "out='$OUT'"; fi
    OUT=$(section none)
    if [[ "$OUT" == *"Tool missing: 'nvim'"* && "$OUT" == *"ask an admin"* && "$OUT" != *"left out"* ]]; then
        ok "control: no state, the same tools are reported missing"
    else bad "control: no state, the same tools are reported missing" "out='$OUT'"; fi
    OUT=$( (XDG_STATE_HOME="$FX/cb"; PATH="$FX/bin"; rehash; __show_docker_guidance) 2>&1)
    OUT2=$( (XDG_STATE_HOME="$FX/none"; PATH="$FX/bin"; rehash; __show_docker_guidance) 2>&1)
    if [[ -z "$OUT" && "$OUT2" == *"Tool missing: 'docker'"* ]]; then ok "docker guidance: silent on codebox, shown with no state"
    else bad "docker guidance: silent on codebox, shown with no state" "codebox='$OUT' none='$OUT2'"; fi
    ro_src=$(sed -n '/^run_onboarding() {/,/^}/p' "$ONB")
    if code_of "$ro_src" | grep -cE '^[[:space:]]+elif ! __tool_left_out docker; then$' >/dev/null; then ok "onboarding's Docker row is skipped when Docker is left out"
    else bad "onboarding's Docker row is skipped when Docker is left out" "no __tool_left_out docker guard in run_onboarding"; fi

    qh_src=$(sed -n '/^__quickref_tool_hints() {/,/^}/p' "$WELCOME")
    if [[ -n "$qh_src" ]]; then eval "$qh_src"; ok "__quickref_tool_hints is defined"
    else bad "__quickref_tool_hints is defined" "not found in $WELCOME"; fi
    for f in __show_quickref_full __show_quickref_minimal; do
        if code_of "$(sed -n "/^$f() {/,/^}/p" "$WELCOME")" | grep -c '__quickref_tool_hints' >/dev/null; then ok "$f uses the hint list"
        else bad "$f uses the hint list" "still prints a fixed list"; fi
    done
    OUT=$( (PATH="$FX/bin"; rehash; unfunction docker_help tdev 2>/dev/null; yt() { :; }; __quickref_tool_hints) 2>&1)
    if [[ "$OUT" == "Git/Docker: lg" ]]; then ok "codebox-like box: only the lazygit hint (no lzd, docker, tmux, yt)"
    else bad "codebox-like box: only the lazygit hint" "out='$OUT'"; fi
    for t in lazydocker ffmpeg; do printf '#!/bin/sh\n' >| "$FX/bin/$t"; chmod +x "$FX/bin/$t"; done
    OUT=$( (PATH="$FX/bin"; rehash; docker_help() { :; }; tdev() { :; }; yt() { :; }; __quickref_tool_hints) 2>&1)
    if [[ "$OUT" == *"lg, lzd"* && "$OUT" == *docker_help* && "$OUT" == *tdev* && "$OUT" == *"yt --help"* ]]; then
        ok "control: every tool present, every hint shown"
    else bad "control: every tool present, every hint shown" "out='$OUT'"; fi
fi

echo; echo "  $PASS passed, $FAIL failed"
(( FAIL == 0 ))
