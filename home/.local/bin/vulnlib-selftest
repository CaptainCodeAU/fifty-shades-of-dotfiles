#!/usr/bin/env -S uv run --quiet python3
"""vulnlib-selftest -- controls for backport detection and cache freshness.

WHY THIS EXISTS
---------------
On 2026-09-04 the startup banner reported three HIGH CVEs against libssh2
1.11.1_4 that the installed formula said, under each patch, were already fixed:
`resolves "CVE-2026-7598"`, `resolves "CVE-2026-58050"`,
`resolves "CVE-2026-58051"`. The scanner had never read that field, inferring
backports instead by scraping a commit hash out of NVD prose.

Reading it introduced a FAR more dangerous bug than the one it fixed, because the
new signal SILENCES a finding on a single string match. Review found five ways to
make it silence a live CVE -- patch scope, tap-vs-keg provenance, comment
attribution, the revision gate, and a negative control that passed while proving
nothing. Fixing the first of those then broke detection entirely for every
top-level patch, and this suite is what caught that.

The hand-written Ruby parser those bugs lived in is gone. Homebrew evaluates its
own formulae, and `serialized_patches` answers for the installed keg on the
running platform in ~0.4s for all 274 of them. What remains to control is the
BOUNDARY: that an undetermined answer never reads as "nothing was backported",
that only a security `resolves` can silence anything, and that a cached verdict
does not outlive its usefulness.

USAGE
  vulnlib-selftest        run everything, print a summary
  vulnlib-selftest -v     also print each check's values

Synthetic fixtures are injected through vulnlib's own caches, so nothing here
touches the network or a real database. The live section reads installed kegs
read-only and skips itself if they are absent.
"""

import atexit
import importlib.machinery
import importlib.util
import os
import re
import shutil
import subprocess
import sys
import tempfile
import time

VERBOSE = "-v" in sys.argv[1:]

# BOTH abspath and realpath, exactly as vuln-scan and toolchain-cve-check do:
# stow deploys these as symlinks, so abspath finds the DEPLOYED copy and realpath
# finds the REPO source, and only one of the two exists in a half-deployed tree.
# A security check that fails to start is indistinguishable from one that passed.
V = None
for _dir in (os.path.dirname(os.path.abspath(__file__)),
             os.path.dirname(os.path.realpath(__file__))):
    _path = os.path.join(_dir, "vulnlib.py")
    if not os.path.exists(_path):
        continue
    _spec = importlib.util.spec_from_file_location("vulnlib", _path)
    if _spec is None or _spec.loader is None:
        continue
    V = importlib.util.module_from_spec(_spec)
    _spec.loader.exec_module(V)
    break
if V is None:
    sys.exit("vulnlib-selftest: no vulnlib.py beside %s (deploy both)" % sys.argv[0])

_COLOR = sys.stdout.isatty() and not os.environ.get("NO_COLOR")
GREEN, RED, YELLOW, OFF = (("\033[32m", "\033[31m", "\033[33m", "\033[0m")
                          if _COLOR else ("", "", "", ""))

PASS = SKIP = 0
FAILURES = []   # labels, so a failing run names them instead of printing a count


def section(name):
    print("\n== %s ==" % name)


def check(label, got, want):
    global PASS
    if got == want:
        PASS += 1
        print("  %sPASS%s  %s" % (GREEN, OFF, label))
        if VERBOSE:
            print("          got %r" % (got,))
    else:
        FAILURES.append(label)
        print("  %sFAIL%s  %s" % (RED, OFF, label))
        print("          got  %r" % (got,))
        print("          want %r" % (want,))


def skip(label, why):
    global SKIP
    SKIP += 1
    print("  %sSKIP%s  %s  (%s)" % (YELLOW, OFF, label, why))


CVE = "CVE-2026-58050"
URL = "https://github.com/libssh2/libssh2/commit/" + "3" * 40


def sec(*ids):
    return [{"type": "security", "id": i} for i in ids]


def _seed(data):
    V._PATCH_DATA = data
    V._PATCH_DATA_FETCHED = True    # "the answer is final", separate from its value
    V._PATCH_ATTEMPTS = 0
    V._FORMULA_CACHE.clear()


def install(**formulae):
    """Seed Homebrew's answer. Replaces the whole map, so each call is isolated."""
    _seed(dict(formulae))


def brew_says_nothing():
    """Homebrew could not be asked at all -- the UNDETERMINED case."""
    _seed(None)


# --------------------------------------------------------------------------- #
# HARNESS CONTROL -- run before any assertion, as census-selftest and
# enforce-census-selftest both do. A suite that cannot produce a PASS cannot
# produce a meaningful FAIL either, and this one has a specific way to go quietly
# useless: every fixture is injected by writing PRIVATE module state. Rename
# `_PATCH_DATA` or change its shape and the fixtures stop taking, `homebrew_
# resolved_cves` returns None for names like "pkg", and every `check(..., False)`
# below still PASSES for entirely the wrong reason.
# --------------------------------------------------------------------------- #
install(pkg=[{"url": URL + ".patch", "resolves": sec(CVE)}])
if V.homebrew_patch_data() is not V._PATCH_DATA:
    sys.exit("vulnlib-selftest: fixture injection is broken -- homebrew_patch_data() "
             "did not return the injected map. Every negative check would pass "
             "for the wrong reason.")
if V.homebrew_resolved_cves("pkg") != {CVE}:
    sys.exit("vulnlib-selftest: the positive control does not fire -- an injected "
             "security `resolves %s` was not read. Fix that before trusting any "
             "FAIL from this suite." % CVE)
print("harness control: fixture injection works, and a known `resolves` is read.")


# --------------------------------------------------------------------------- #
section("undetermined is not the same as nothing")
# --------------------------------------------------------------------------- #
# The whole failure class in one idea. If `brew` is missing, the subprocess dies,
# or the JSON will not parse, the answer is UNKNOWN -- and an UNKNOWN that reads
# as "no patches were applied" is merely a false alarm, while an UNKNOWN that
# reads as "nothing to worry about" is the false all-clear this module exists to
# prevent. Every path below must produce None, never set().
brew_says_nothing()
check("brew unavailable -> None, not an empty set", V.homebrew_resolved_cves("pkg"), None)
check("...so nothing can be suppressed",
      V.is_patched_by_homebrew("pkg", CVE, None, None), False)
check("an unknown formula -> None even when brew answered",
      (install(other=[]) or V.homebrew_resolved_cves("pkg")), None)
check("an installed formula with no patches -> empty set, a real fact",
      V.homebrew_resolved_cves("other"), set())
check("patches_for distinguishes 'no patches' from 'never heard of it'",
      (V.homebrew_patches_for("other"), V.homebrew_patches_for("pkg")), ([], None))

# What `brew ruby` produced must be validated BEFORE it is believed, and the
# validator is controlled directly: folded inline it was unreachable without
# forking a fake brew, and a validation nothing exercises is not a validation.
# `{}` is the dangerous one -- the Ruby rescues each keg individually, so a
# systemic break (serialized_patches renamed, the glob matching nothing) skips
# every keg and still exits 0.
for label, value, ok in [
        ("a whole-inventory answer", {"libssh2": [{"file": "p"}], "jq": []}, True),
        ("a formula with no patches", {"jq": []}, True),
        ("an EMPTY map -- every keg was skipped", {}, False),
        ("not a map at all", [], False),
        ("None", None, False),
        ("patches as strings, not dicts", {"jq": ["oops"]}, False),
        ("a patch list that is not a list", {"jq": {"file": "p"}}, False)]:
    check("validator accepts %s" % label if ok else "validator REJECTS %s" % label,
          V._valid_patch_map(value), ok)


# --------------------------------------------------------------------------- #
section("only a security resolves may silence a CVE")
# --------------------------------------------------------------------------- #
# Measured across 274 installed kegs: 20 patches carry a `resolves`, split exactly
# 10 security / 10 defect. Homebrew classifies CVE, GHSA and OSV ids as security
# and everything else -- issue links, bug numbers -- as defect. Reading a defect
# id as an advisory id could only ever silence something it does not describe.
install(pkg=[{"file": "p.patch", "resolves": sec(CVE)}],
        defective=[{"file": "p.patch",
                    "resolves": [{"type": "defect", "id": "https://bugs.example/1"}]}],
        many=[{"file": "p.patch", "resolves": sec("CVE-2026-11111", "CVE-2026-22222")}],
        advisories=[{"file": "p.patch",
                     "resolves": sec("GHSA-qrv3-253h-g69c", "OSV-2025-433")}])
check("a security resolves silences its CVE",
      V.is_patched_by_homebrew("pkg", CVE, None, None), True)
check("a defect resolves silences nothing", V.homebrew_resolved_cves("defective"), set())
check("a variadic resolves captures EVERY id",
      V.homebrew_resolved_cves("many"), {"CVE-2026-11111", "CVE-2026-22222"})
check("GHSA and OSV advisory ids are captured",
      V.homebrew_resolved_cves("advisories"),
      {"GHSA-QRV3-253H-G69C", "OSV-2025-433"})
check("an unrelated CVE is not silenced",
      V.is_patched_by_homebrew("pkg", "CVE-2026-99999", None, None), False)
check("case-insensitive id match",
      V.is_patched_by_homebrew("pkg", CVE.lower(), None, None), True)
check("an empty cve id never matches", V.is_patched_by_homebrew("pkg", "", None, None), False)


# --------------------------------------------------------------------------- #
section("commit-hash signal: the fallback for patches with no resolves")
# --------------------------------------------------------------------------- #
# Kept, not replaced: 7 of the 62 installed patches carry a `file` and no
# `resolves` at all, so Homebrew's answer cannot speak for them.
pc = {"a" * 40: "https://example/commit/" + "a" * 40}
check("full sha matches", V.commit_is_patched("a" * 40, pc), True)
check("7-char prefix matches", V.commit_is_patched("a" * 7, pc), True)
check("6-char prefix rejected (collision-prone)", V.commit_is_patched("a" * 6, pc), False)
check("unrelated sha rejected", V.commit_is_patched("b" * 40, pc), False)
check("no patches -> False", V.commit_is_patched("a" * 40, None), False)
check("the hash signal alone still suppresses, with no resolves involved",
      V.is_patched_by_homebrew("other", "CVE-0000-0000", "a" * 40, pc), True)

install(mixed=[{"url": URL + ".patch?full_index=1", "resolves": sec(CVE)},
               {"file": "unexplained.patch"}])
V._FORMULA_CACHE["mixed"] = None
check("patch urls are read from Homebrew's own answer",
      sorted(V.homebrew_patch_commits("mixed")), ["3" * 40])
brew_says_nothing()
V._FORMULA_CACHE["scan-me"] = "# Backport of %s\n" % URL
check("the keg text is still scanned, for the file-patch case",
      sorted(V.homebrew_patch_commits("scan-me")), ["3" * 40])
V._FORMULA_CACHE["nothing"] = None
check("no Homebrew answer and no keg text -> None",
      V.homebrew_patch_commits("nothing"), None)


# --------------------------------------------------------------------------- #
section("unclaimed_patches: never re-ask what the formula answered")
# --------------------------------------------------------------------------- #
install(allknown=[{"url": URL + ".patch", "resolves": sec(CVE)}],
        partly=[{"url": URL + ".patch", "resolves": sec(CVE)},
                {"file": "mystery.patch"}])
check("every patch labelled -> nothing is unexplained",
      V.unclaimed_patches("allknown", {URL[-40:]: URL}, set()), [])
check("an unlabelled patch leaves its commit on the list",
      V.unclaimed_patches("partly", {URL[-40:]: URL, "b" * 40: "https://e/commit/" + "b" * 40},
                          set()), ["https://e/commit/" + "b" * 40])
check("a commit already claimed by a CVE is not asked about",
      V.unclaimed_patches("partly", {"b" * 40: "https://e/commit/" + "b" * 40},
                          {"b" * 40}), [])
# Must sit here, while `allknown` is still the installed fixture: install()
# replaces the whole map, and against an UNINSTALLED name this check passes for
# the wrong reason -- patches is None, so any short-circuit is skipped anyway.
check("all patches labelled, but an unexplained commit still gets asked about",
      V.unclaimed_patches("allknown", {"c" * 40: "https://e/commit/" + "c" * 40}, set()),
      ["https://e/commit/" + "c" * 40])
check("no patches -> empty list", V.unclaimed_patches("allknown", None, set()), [])

# THE MIXED CASE. A vendored `file` patch has no url, so its commit lives only in
# the `# Backport of` comment above it -- 5 of libssh2's 10 are exactly that. A
# formula gaining one ordinary unlabelled patch (a build fix) must not turn those
# five back into questions for a human.
install(mixedfile=[{"file": "Patches/x/CVE-2026-58050.patch", "resolves": sec(CVE)},
                   {"url": "https://github.com/x/y/commit/bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb.patch"}])
V._FORMULA_CACHE["mixedfile"] = "  # Backport of https://github.com/libssh2/libssh2/commit/5555555555555555555555555555555555555555\n  patch do\n  end\n"
_pc = {"5" * 40: "https://github.com/libssh2/libssh2/commit/5555555555555555555555555555555555555555", "b" * 40: "https://github.com/x/y/commit/bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"}
check("a labelled FILE patch's comment-named commit is not asked about",
      V.unclaimed_patches("mixedfile", _pc, set()), ["https://github.com/x/y/commit/bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"])
check("...and it is genuinely the comment doing it, not a short-circuit",
      len(V.homebrew_patches_for("mixedfile")), 2)


# --------------------------------------------------------------------------- #
section("annotate_hits: one decision, shared by both scanners")
# --------------------------------------------------------------------------- #
# This block lived in both scanners and the copies diverged TWICE -- once in
# August (toolchain-cve-check kept reporting backported formulae as EXPOSED for
# weeks) and again on 2026-09-04, when vuln-scan gained the undetermined guard and
# toolchain-cve-check did not. It is one function now, and these are its edges.
install(pkg=[{"url": URL + ".patch", "resolves": sec(CVE)}])
_hits = [{"id": CVE, "fix_commit": None}, {"id": "CVE-2026-99999", "fix_commit": None}]
_out = V.annotate_hits("pkg", [dict(h) for h in _hits])
check("a declared CVE is stamped patched", [h["patched"] for h in _out], [True, False])

brew_says_nothing()
check("Homebrew unreachable -> None, so the caller must say UNKNOWN",
      V.annotate_hits("pkg", [dict(h) for h in _hits]), None)

install(pkg=[{"url": URL + ".patch", "resolves": sec(CVE)}])
_hyp = V.annotate_hits("pkg", [dict(h) for h in _hits], hypothetical=True)
check("hypothetical: the installed formula does not answer at all",
      [h["patched"] for h in _hyp], [False, False])
check("hypothetical never returns None -- it is determined, just not suppressed",
      _hyp is not None, True)
check("no hits -> an empty list, not None", V.annotate_hits("pkg", []), [])
# THE CASE THAT WAS WRONG. The check above passes under a working fixture whether
# or not the `not hits` guard exists; only with Homebrew unreachable does it
# distinguish them. Without the guard this returns None, and check_brew turns
# every formula that came back with zero CVEs -- ~131 of 231 -- into UNKNOWN.
brew_says_nothing()
check("no hits -> still an empty list when Homebrew is unreachable",
      V.annotate_hits("pkg", []), [])
check("...and a real hit in the same state still says UNDETERMINED",
      V.annotate_hits("pkg", [{"id": CVE, "fix_commit": None}]), None)


# --------------------------------------------------------------------------- #
section("backport_commits: prose is not a patch of this formula")
# --------------------------------------------------------------------------- #
# Scanning the whole keg text re-opened the scope error that deleting the hand
# parser had removed. Measured over 231 formulae, a whole-file scan credited 7
# commits belonging to OTHER projects -- ollama's 1f92170dc9 is a `patch do`
# inside `resource "llama.cpp"`, i.e. a patch to a bundled dependency's source.
V._FORMULA_CACHE["cited"] = (
    "  # Backport of %s\n"
    "  # bcrypt no longer truncates: https://github.com/pyca/bcrypt/commit/%s\n"
    % (URL, "d" * 40))
check("a `Backport of` line names this formula's commit",
      sorted(V.backport_commits("cited")), ["3" * 40])
check("a prose citation of another project is NOT credited",
      "d" * 40 in V.backport_commits("cited"), False)
V._FORMULA_CACHE["nocomment"] = "class F < Formula\nend\n"
check("no attribution comments -> empty, not None", V.backport_commits("nocomment"), {})


# --------------------------------------------------------------------------- #
section("cache freshness: a row must not be trusted forever")
# --------------------------------------------------------------------------- #
# The cache had no time component, so `known()` reused a row for as long as the
# installed version held. Measured 2026-09-04: the python@3.14 row was written
# 2026-08-18, NVD bounded the CVE on 2026-08-20, and the banner reported a fixed
# CVE for 17 days; 97 of 231 rows were 32 days old. The false-NEGATIVE direction
# is the same bug and worse -- a CVE published tomorrow against a version that
# never moves would not be found at all.
_tmp = tempfile.mkdtemp(prefix="vulnlib-selftest-")
atexit.register(shutil.rmtree, _tmp, True)   # ours, created this run, empty of anything else
_db = os.path.join(_tmp, "scan.db")
_store = V.ScanStore(_db)
_store.record("brew", "fresh-pkg", "1.0", 0, "a:b", "clean", None, [])
_store.record("brew", "stale-pkg", "1.0", 0, "a:b", "clean", None, [])
_store.conn.execute("UPDATE scanned SET scanned_at=? WHERE name='stale-pkg'",
                    (int(time.time()) - 30 * 86400,))
_store.commit()
_fresh = ("brew", "fresh-pkg", "1.0", 0)
_stale = ("brew", "stale-pkg", "1.0", 0)
check("no max_age: a 30-day-old row is still known (old behaviour)",
      _store.known(*_stale) is not None, True)
check("max_age=7d: the 30-day-old row is NOT known",
      _store.known(*_stale, max_age=7 * 86400), None)
check("max_age=7d: a row written just now IS known",
      _store.known(*_fresh, max_age=7 * 86400) is not None, True)
check("max_age=0 disables expiry entirely",
      _store.known(*_stale, max_age=0) is not None, True)
check("max_age=None disables expiry entirely",
      _store.known(*_stale, max_age=None) is not None, True)
check("an absent row is still None with a max_age",
      _store.known("brew", "no-such-pkg", "1.0", 0, max_age=7 * 86400), None)


# --------------------------------------------------------------------------- #
def brew_vulns_resolved(formula):
    """What `brew vulns` says this formula's patches resolve, or None.

    INDEPENDENT ON PURPOSE. Asserting vulnlib against another call into vulnlib
    would be tautological, so the expectation comes from Homebrew's own command,
    which reaches the same kegs by a different code path. That was always the
    method here -- it was simply done by hand on 2026-09-04 and then frozen as a
    literal, which is the part that broke.

    WHY THE LITERALS ARE GONE. The arm asserted ten advisories and ten patch
    commits. Homebrew backported two more (OSV-2025-90, OSV-2025-92) and the
    suite went red while vulnlib was answering perfectly correctly -- a figure
    that stops reproducing reads as a broken instrument rather than a moved
    target, which is exactly the trap CLAUDE.md warns about for the tab-count in
    .zshrc. Derive it, do not freeze it.

    Parses the block `brew vulns` prints at the end:

        12 resolved by formula patches (not counted; ...):
          libssh2: CVE-..., OSV-...
    """
    if not shutil.which("brew"):
        return None
    try:
        p = subprocess.run(["brew", "vulns", formula],
                           capture_output=True, text=True, timeout=120)
    except (OSError, subprocess.SubprocessError):
        return None
    if p.returncode not in (0, 1):      # brew exits 1 when it finds anything
        return None
    m = re.search(r"^\s*%s:\s*(.+)$" % re.escape(formula), p.stdout, re.MULTILINE)
    if not m:
        return None
    ids = {t.strip() for t in m.group(1).split(",") if t.strip()}
    return ids or None


section("live kegs (read-only; skipped if not installed)")
# --------------------------------------------------------------------------- #
# The expectation is DERIVED from `brew vulns` on every run, never frozen. See
# brew_vulns_resolved above for why the frozen version broke.
V._PATCH_DATA = None
V._PATCH_DATA_FETCHED = False
V._PATCH_ATTEMPTS = 0
V._FORMULA_CACHE.clear()

_live = V.homebrew_patch_data()
if _live is None:
    skip("all live checks", "brew ruby did not answer")
elif len(_live) < 50:
    # A COLLAPSED MAP IS NOT AN EMPTY MACHINE. `{}` or a handful of keys means the
    # Ruby skipped nearly every keg -- `serialized_patches` renamed, the glob
    # matching nothing -- and every formula below would then report None and be
    # SKIPPED as "not installed", turning the live section green while proving
    # nothing. This box has 274 kegs; anything under 50 is a broken instrument,
    # not a small machine, and it must fail rather than skip.
    FAILURES.append("brew ruby returned only %d keg(s) -- the map collapsed" % len(_live))
    print("  %sFAIL%s  brew ruby returned only %d keg(s); expected the whole inventory"
          % (RED, OFF, len(_live)))
else:
    got = V.homebrew_resolved_cves("libssh2")
    if got is None:
        skip("libssh2", "not installed")
    else:
        want = brew_vulns_resolved("libssh2")
        if want is None:
            skip("libssh2 resolves exactly what `brew vulns` says",
                 "brew vulns unavailable or unparseable -- NOT a pass")
        elif len(want) < 10:
            # THE CONTROL ON THE INDEPENDENT SOURCE. If the parse silently
            # returned a near-empty set, comparing two empty sets would pass and
            # prove nothing. libssh2 has carried at least ten since 2026-09-04
            # and Homebrew does not un-patch, so anything smaller means the
            # parser broke, not that the formula shrank.
            FAILURES.append("brew vulns returned only %d id(s) for libssh2" % len(want))
            print("  %sFAIL%s  brew vulns returned only %d id(s) for libssh2 -- "
                  "the independent source is not answering" % (RED, OFF, len(want)))
        else:
            check("libssh2 resolves exactly what `brew vulns` says", got, want)
        # Pin the denominator FIRST. unclaimed_patches returns [] for a falsy
        # first argument, so without this the check below passes unchanged if
        # homebrew_patch_commits regresses to None or {} -- a green tick for a
        # signal that has disappeared.
        _pc_live = V.homebrew_patch_commits("libssh2")
        # NO FROZEN COUNT HERE EITHER -- it was ten, Homebrew made it eleven. The
        # job of this arm is to PIN THE DENOMINATOR so the unclaimed_patches
        # check below cannot pass vacuously: that function returns [] for a falsy
        # first argument, so a regression to None or {} would otherwise earn a
        # green tick for a signal that had disappeared. A floor plus a shape
        # check does that without going stale on the next backport.
        check("libssh2 still exposes a real set of patch commits (denominator pinned)",
              len(_pc_live or {}) >= 10, True)
        # The map is {commit_sha: patch_url}, so the SHAS ARE THE KEYS. Checking
        # .values() here instead was my own wrong assumption about the contract,
        # and this arm caught it on 2026-09-19 -- which is the argument for
        # asserting shape at all rather than only counting.
        check("...and every one of them is keyed by a real commit sha",
              all(re.fullmatch(r"[0-9a-f]{7,40}", str(c or "").lower())
                  for c in (_pc_live or {})) if _pc_live else False, True)
        check("...and every one carries the upstream URL that names that sha",
              all(str(c) in str(u or "") for c, u in (_pc_live or {}).items())
              if _pc_live else False, True)
        check("libssh2 has nothing left to ask a human about",
              V.unclaimed_patches("libssh2", _pc_live, set()), [])

    py = V.homebrew_resolved_cves("python@3.14")
    if py is None:
        skip("python@3.14", "not installed")
    else:
        check("python@3.14 declares no security resolves", py, set())

    # Both of these were WRONG under the hand parser: it saw 1 patch in bash where
    # Homebrew sees 15, and could not see ollama's `patch :DATA` at all because it
    # has no `do` for a block-stack parser to notice.
    for name, why in [("bash", "a formula whose patches the old parser undercounted"),
                      ("ollama", "a formula using `patch :DATA`, invisible to the old parser")]:
        ps = V.homebrew_patches_for(name)
        if ps is None:
            skip(name, "not installed")
        else:
            check("%s: patches are seen at all (%s)" % (name, why), len(ps) >= 1, True)
    bash = V.homebrew_patches_for("bash")
    if bash is not None:
        check("bash reports many patches, not the single block the parser found",
              len(bash) > 1, True)

section("covers(): mentioning your version is not covering it")

# THE FIXTURE IS REAL. Both dicts below are copied verbatim out of the live NVD
# response for `cpeName=cpe:2.3:a:pcre:pcre2:10.48:*:*:*:*:*:*:*`, fetched
# 2026-09-19 (15375 bytes, totalResults 6). Nothing here is invented, because an
# invented cpeMatch would only test that this file agrees with itself.
#
# WHAT WENT WRONG. cves_for() had ZERO controls in this suite, and the bug lived
# in the gap. NVD bounds all six pcre2 CVEs at `versionEndExcluding 10.48`, which
# correctly EXCLUDES the installed 10.48, then carries a SECOND entry pinned at
# `10.48:rc1`. The query sends `*` in the update field and `*` matches `rc1`, so
# a machine on the FIXED release was told it had 6 CVEs, one of them CVSS 7.4,
# at every single session start.
#
# THE CONTROL THAT NAMES IT is the 10.47 row: NVD returns the SAME SIX for 10.47,
# which really is vulnerable, and for 10.48, which is the fix. A property true in
# both worlds decides nothing, so these arms must always be run as a pair.
RANGE = {"criteria": "cpe:2.3:a:pcre:pcre2:*:*:*:*:*:*:*:*",
         "vulnerable": True, "versionEndExcluding": "10.48"}
RC1 = {"criteria": "cpe:2.3:a:pcre:pcre2:10.48:rc1:*:*:*:*:*:*", "vulnerable": True}

check("the fixed release is NOT covered by endExcluding itself",
      V.covers(RANGE, "10.48"), False)
check("the vulnerable release IS still covered (the arm that must not go quiet)",
      V.covers(RANGE, "10.47"), True)
check("a release candidate CPE does not cover the final release",
      V.covers(RC1, "10.48"), False)
check("a pinned CPE covers its own exact version",
      V.covers({"criteria": "cpe:2.3:a:pcre:pcre2:10.48:*:*:*:*:*:*:*",
                "vulnerable": True}, "10.48"), True)
check("a pinned CPE does not cover a different version",
      V.covers({"criteria": "cpe:2.3:a:pcre:pcre2:10.48:*:*:*:*:*:*:*",
                "vulnerable": True}, "10.47"), False)
check("an unbounded all-versions CPE still covers everything",
      V.covers({"criteria": "cpe:2.3:a:pcre:pcre2:*:*:*:*:*:*:*:*",
                "vulnerable": True}, "10.48"), True)

# EVERY UNDECIDABLE PATH MUST KEEP THE FINDING. These three are the reason this
# function is safe to add at all: a comparator that guessed would hide live CVEs
# to spare a false positive, which is the wrong trade in a security scanner.
check("an unparseable BOUND keeps the finding",
      V.covers({"criteria": "cpe:2.3:a:pcre:pcre2:*:*:*:*:*:*:*:*", "vulnerable": True,
                "versionEndExcluding": "10.48-beta2"}, "10.48"), True)
check("malformed criteria keeps the finding",
      V.covers({"criteria": "garbage", "vulnerable": True}, "10.48"), True)
check("an unparseable INSTALLED version keeps the finding",
      V.covers(RANGE, "10.48rc1"), True)

# Bounds arithmetic, both directions, so an off-by-one cannot pass unnoticed.
check("versionEndIncluding INCLUDES its own bound",
      V.covers({"criteria": "cpe:2.3:a:pcre:pcre2:*:*:*:*:*:*:*:*", "vulnerable": True,
                "versionEndIncluding": "10.48"}, "10.48"), True)
check("versionStartIncluding excludes everything below it",
      V.covers({"criteria": "cpe:2.3:a:pcre:pcre2:*:*:*:*:*:*:*:*", "vulnerable": True,
                "versionStartIncluding": "10.40"}, "10.39"), False)
check("a short version is padded, not mis-ranked (10.5 < 10.48)",
      V.covers({"criteria": "cpe:2.3:a:pcre:pcre2:*:*:*:*:*:*:*:*", "vulnerable": True,
                "versionEndExcluding": "10.48"}, "10.5"), True)


# THE PINNED BRANCH, every case review measured as wrongly silenced on
# 2026-09-19. A raw string compare answered False -- CVE DROPPED -- for all four,
# and every one of them is an UNDECIDABLE comparison, not a decided one. They
# live here so the fix cannot quietly come undone.
def _crit(ver, upd="*"):
    return {"criteria": "cpe:2.3:a:pcre:pcre2:%s:%s:*:*:*:*:*:*" % (ver, upd),
            "vulnerable": True}


check("a trailing .0 in the CPE is padded, not treated as a mismatch",
      V.covers(_crit("10.48.0"), "10.48"), True)
check("a trailing .0 in the INSTALLED version is padded too",
      V.covers(_crit("10.48"), "10.48.0"), True)
check("NVD's '-' version means not-applicable, so the finding is kept",
      V.covers(_crit("-"), "10.48"), True)
check("an escaped CPE version is undecidable, so the finding is kept",
      V.covers(_crit("1.0.2\\.a"), "1.0.2.a"), True)
check("...and the rc1 case still does NOT cover the final release",
      V.covers(_crit("10.48", "rc1"), "10.48"), False)


section("the cache must not outlive the logic that filled it")

# A CORRECTED MATCHER THAT CANNOT REACH ITS OWN OLD MISTAKES HAS NOT FIXED THEM.
# The cache key is (subject, name, version, revision) with no notion of the code
# that produced the row, so nothing about pcre2 changed when covers() landed and
# the six false CVEs would have kept being served for up to a full staleness
# window -- on exactly the finding the fix was written for. Review caught this on
# 2026-09-19. MATCHER_VERSION is the lever; SCHEMA_VERSION is not, because a bump
# there wipes the acks table and an accepted risk is a human decision.
import tempfile as _tempfile

_dbpath = os.path.join(_tempfile.mkdtemp(prefix="vulnlib-selftest-"), "t.db")
_s = V.ScanStore(_dbpath)
_s.record("brew", "pcre2", "10.48", 0, "cpe:x", "EXPOSED", 7.4, [{"id": "CVE-2026-89161"}])
_s.conn.execute("INSERT OR REPLACE INTO meta(key,value) VALUES('matcher_version','1')")
_s.commit()
_s.close()

_s = V.ScanStore(_dbpath)            # reopened under the CURRENT MATCHER_VERSION
check("a row written by an older matcher is dropped on open",
      _s.known("brew", "pcre2", "10.48", 0), None)
check("the stored matcher version is stamped forward",
      _s.conn.execute("SELECT value FROM meta WHERE key='matcher_version'"
                      ).fetchone()["value"], str(V.MATCHER_VERSION))

# THE CONTROL. Without this, "the row is gone" would pass just as well if the
# code wiped the table on EVERY open, which would silently disable the cache.
_s.record("brew", "jq", "1.8.2", 0, "cpe:y", "EXPOSED", 6.9, [{"id": "CVE-X"}])
_s.commit()
_s.close()
_s = V.ScanStore(_dbpath)
check("CONTROL: an UNCHANGED matcher keeps its rows (the cache still works)",
      _s.known("brew", "jq", "1.8.2", 0) is not None, True)
_s.close()


section("cves_for(): the wiring, not just the decision")

# THE TWELVE ARMS ABOVE PROVE covers() DECIDES CORRECTLY. None of them proves it
# is CONNECTED. Delete `and covers(m, version)` from the comprehension in
# cves_for and every one of them still passes -- and that comprehension is
# exactly where the bug lived, so a suite that cannot see it has not closed the
# gap it was written to close. Review caught this on 2026-09-19, in the first
# draft of the section above.
#
# REAL DATA, DEDUPLICATED. All six pcre2 CVEs in the live 15375-byte response
# carry the IDENTICAL pair of cpeMatch entries, verified against it on
# 2026-09-19, so the pair is written once and reused rather than pasted six
# times. The ids and the criteria strings are verbatim.
PCRE2_IDS = ["CVE-2026-89156", "CVE-2026-89157", "CVE-2026-89158",
             "CVE-2026-89160", "CVE-2026-89161", "CVE-2026-89162"]
PCRE2_MATCHES = [
    {"criteria": "cpe:2.3:a:pcre:pcre2:*:*:*:*:*:*:*:*",
     "vulnerable": True, "versionEndExcluding": "10.48"},
    {"criteria": "cpe:2.3:a:pcre:pcre2:10.48:rc1:*:*:*:*:*:*",
     "vulnerable": True},
]


def _pcre2_payload():
    return {"totalResults": len(PCRE2_IDS), "vulnerabilities": [
        {"cve": {"id": cid,
                 "descriptions": [{"lang": "en",
                                   "value": "PCRE2 before 10.48 has an issue."}],
                 "metrics": {},
                 "configurations": [{"nodes": [{"cpeMatch": PCRE2_MATCHES}]}]}}
        for cid in PCRE2_IDS]}


class _FixtureClient(V.NvdClient):
    """The REAL cves_for(), with only the socket replaced. Never sleeps, never
    reaches the network, and exercises every line between the payload and the
    returned hits."""

    def __init__(self):
        super().__init__(None, timeout=1.0)
        self.delay = 0.0

    def _get(self, url, params):
        return _pcre2_payload()


_fc = _FixtureClient()
_fixed = _fc.cves_for("pcre", "pcre2", "10.48")
_vuln = _fc.cves_for("pcre", "pcre2", "10.47")
check("cves_for returns a result at all for the fixed release",
      _fixed is not None, True)
check("cves_for returns a result at all for the vulnerable release",
      _vuln is not None, True)
if _fixed is not None and _vuln is not None:
    # THE PAIR IS THE POINT. Before the fix BOTH arms returned six, so six alone
    # was never evidence of anything. Run together, they separate the two worlds.
    check("cves_for: the FIXED release reports no CVEs", len(_fixed[0]), 0)
    check("cves_for: the VULNERABLE release still reports all six",
          sorted(h["id"] for h in _vuln[0]), PCRE2_IDS)
    check("cves_for: an unparseable installed version keeps every finding",
          len(_fc.cves_for("pcre", "pcre2", "10.48rc1")[0]), 6)


section("cves_for(): a short page is UNKNOWN, never clean (W-20260925-A35)")

# NVD SOMETIMES SAYS N AND SENDS FEWER. The worker measured it on 2026-09-25 on
# this exact query shape (jq 1.8.2, resultsPerPage=200): 1 reply in 6 was
# `totalResults=3, resultsPerPage=0, vulnerabilities=[]`, verbatim below. The old
# cves_for returned ([], True) for it, and both callers read the empty hit list
# as CLEAN before ever looking at the flag -- a false all-clear, cached for a week.
#
# THE ARMS COME IN PAIRS, for the same reason as the section above: "None" alone
# is also what a cves_for that refused EVERYTHING would print. The complete page
# and the genuinely truncated page carrying a real hit must still come through.


class _PayloadClient(V.NvdClient):
    """The real cves_for() fed one fixed payload."""

    def __init__(self, payload):
        super().__init__(None, timeout=1.0)
        self.delay = 0.0
        self.payload = payload

    def _get(self, url, params):
        return self.payload


def _pcre2_records(n, cid_prefix="CVE-2026-9"):
    return [{"cve": {"id": "%s%04d" % (cid_prefix, i),
                     "descriptions": [{"lang": "en", "value": "An issue."}],
                     "metrics": {},
                     "configurations": [{"nodes": [{"cpeMatch": PCRE2_MATCHES}]}]}}
            for i in range(n)]


_short = {"totalResults": 3, "resultsPerPage": 0, "vulnerabilities": []}
check("short page (says 3, sends 0, NVD's own shape) is UNKNOWN, not clean",
      _PayloadClient(_short).cves_for("jqlang", "jq", "1.8.2"), None)

_partial = {"totalResults": 6, "vulnerabilities": _pcre2_payload()["vulnerabilities"][:3]}
check("partial short page (says 6, sends 3) is UNKNOWN, not 3 of 6",
      _PayloadClient(_partial).cves_for("pcre", "pcre2", "10.47"), None)

# A GENUINELY truncated page: more than one page exists, page one came back full.
# Nothing on it applies to 10.48, but the unseen 50 might, so this is undetermined.
_trunc_clean = {"totalResults": 250, "vulnerabilities": _pcre2_records(200)}
check("full page one of 250 with no hit on it is UNKNOWN, not clean",
      _PayloadClient(_trunc_clean).cves_for("pcre", "pcre2", "10.48"), None)

# CONTROLS -- the guard must not swallow a real answer.
_trunc_hit = _PayloadClient(_trunc_clean).cves_for("pcre", "pcre2", "10.47")
check("control: full page one of 250 WITH hits still reports them, flagged truncated",
      None if _trunc_hit is None else (len(_trunc_hit[0]), _trunc_hit[1]), (200, True))
_complete = _PayloadClient(_pcre2_payload()).cves_for("pcre", "pcre2", "10.48")
check("control: a complete page with no hit is still clean, not truncated",
      _complete, ([], False))
_empty = {"totalResults": 0, "resultsPerPage": 0, "vulnerabilities": []}
check("control: a real zero (says 0, sends 0) is still clean",
      _PayloadClient(_empty).cves_for("jqlang", "jq", "1.8.2"), ([], False))


section("cves_for(): a short page is retried, a bounded number of times (W-20260925-A40)")

# Live 2026-09-25 the jq query short-paged, answered in full, then short-paged
# again. So one short page must not cost the answer, and a run of them must not
# loop forever: each try costs 6.5s without a key.


class _SequenceClient(V.NvdClient):
    """The real cves_for() fed payloads in order, counting the tries."""

    def __init__(self, payloads):
        super().__init__(None, timeout=1.0)
        self.delay = 0.0
        self.payloads = list(payloads)
        self.tries = 0

    def _get(self, url, params):
        self.tries += 1
        return self.payloads.pop(0) if self.payloads else None


_sc = _SequenceClient([_short, _pcre2_payload()])
_got = _sc.cves_for("pcre", "pcre2", "10.47")
check("short page then a full one: the full answer's six hits come through",
      None if _got is None else sorted(h["id"] for h in _got[0]), PCRE2_IDS)
check("short page then a full one: exactly two tries", _sc.tries, 2)

_sc = _SequenceClient([_short, _short, _short, _pcre2_payload()])
check("three short pages in a row: UNKNOWN, the fourth reply is never asked for",
      (_sc.cves_for("pcre", "pcre2", "10.47"), _sc.tries), (None, getattr(V, "SHORT_PAGE_TRIES", "missing")))
check("control: the retry cap is 3", getattr(V, "SHORT_PAGE_TRIES", "missing"), 3)

_sc = _SequenceClient([_pcre2_payload()])
_sc.cves_for("pcre", "pcre2", "10.47")
check("control: a complete first reply is not retried", _sc.tries, 1)

_sc = _SequenceClient([None, _pcre2_payload()])
check("control: a failed _get is not retried here (throttle pacing is _get's job)",
      (_sc.cves_for("pcre", "pcre2", "10.47"), _sc.tries), (None, 1))


section("vuln-scan: an UNKNOWN NVD did not answer is retried next run (W-20260925-A40)")

# THE REAL vuln-scan, loaded from beside this file. The decision is only half the
# fix; the other half is that run_scan sends the row to the BACKGROUND sweep, and
# only split_todo shows that. A marker nothing reads would pass every arm above.
VS = None
for _dir in (os.path.dirname(os.path.abspath(__file__)),
             os.path.dirname(os.path.realpath(__file__))):
    _path = os.path.join(_dir, "vuln-scan")
    if os.path.exists(_path):
        _ldr = importlib.machinery.SourceFileLoader("vuln_scan", _path)
        _spec = importlib.util.spec_from_loader("vuln_scan", _ldr)
        VS = importlib.util.module_from_spec(_spec)
        _ldr.exec_module(VS)
        break
if VS is None:
    sys.exit("vulnlib-selftest: no vuln-scan beside %s (deploy both)" % sys.argv[0])

_MARK = getattr(VS, "RETRY_NEXT_RUN", "missing")


class _ScanClient(VS.V.NvdClient):
    """scan_one's client with both NVD calls answered from the test."""

    def __init__(self, cpe, cves):
        super().__init__(None, timeout=1.0)
        self.delay = 0.0
        self._cpe, self._cves = cpe, cves

    def resolve_cpe(self, name):
        return self._cpe

    def cves_for(self, vendor, product, version):
        return self._cves


def _marked(result):
    return result[0], any(f.get(_MARK) for f in result[3])


check("CPE lookup did not answer: UNKNOWN, marked for retry",
      _marked(VS.scan_one(_ScanClient(None, None), "a40pkg", "1.0", 0)), ("unknown", True))
check("CVE lookup did not answer: UNKNOWN, marked for retry",
      _marked(VS.scan_one(_ScanClient(("v", "a40pkg"), None), "a40pkg", "1.0", 0)),
      ("unknown", True))
check("control: no CPE published is UNKNOWN but NOT marked (NVD answered, it is final)",
      _marked(VS.scan_one(_ScanClient(False, None), "a40pkg", "1.0", 0)), ("unknown", False))
check("control: a real clean answer is not marked",
      _marked(VS.scan_one(_ScanClient(("v", "a40pkg"), ([], False)), "a40pkg", "1.0", 0)),
      ("clean", False))

_vsdb = os.path.join(_tempfile.mkdtemp(prefix="vulnlib-selftest-"), "vs.db")
_vs = VS.V.ScanStore(_vsdb)
for _name, _args in (
        ("failed", ("v:failed", "unknown", None,
                    [{"note": "NVD lookup failed", _MARK: True}])),
        ("nocpe", (None, "unknown", None, [{"note": "no CPE published"}])),
        ("clean", ("v:clean", "clean", None, []))):
    _vs.record(VS.SUBJECT, _name, "1.0", 0, *_args)
_vs.commit()
_inv = [(n, "1.0", 0, "1.0") for n in ("failed", "nocpe", "clean", "new")]
_split = getattr(VS, "split_todo", None)
_week = 7 * 86400
check("split_todo: the failed row is stale at once, so it goes to the background",
      None if _split is None else _split(_vs, _inv, False, _week),
      ([("new", "1.0", 0)], [("failed", "1.0", 0)]))
check("split_todo: still retried with expiry switched off (--stale-days 0)",
      None if _split is None else _split(_vs, _inv, False, 0),
      ([("new", "1.0", 0)], [("failed", "1.0", 0)]))
check("control: a fresh verdict and a final UNKNOWN stay cached (the cache still works)",
      None if _split is None else sorted(n for n, _v, _r in sum(_split(_vs, _inv, False, _week), [])),
      ["failed", "new"])
_vs.close()


section("toolchain-cve-check honours vuln-scan acks, until they expire (W-20260925-A36)")

# The start card's brew alert is toolchain-cve-check, and it never read the acks
# table: 7 CVEs acked with evidence on 2026-09-25 kept the alert EXPOSED. The hook
# greps its text for EXPOSED and reads exit 1, so "acked" must be neither.
_read_acks = getattr(V, "read_acks", None)
_ackdb = os.path.join(_tempfile.mkdtemp(prefix="vulnlib-selftest-"), "acks.db")
_as = V.ScanStore(_ackdb)
_as.ack("brew", "a36pkg", "CVE-2026-0001", 30, "live one")
_as.ack("brew", "a36pkg", "CVE-2026-0002", -1, "expired yesterday")
_as.ack("other", "a36pkg", "CVE-2026-0003", 30, "another subject")
_as.close()
_live = None if _read_acks is None else _read_acks("brew", _ackdb)
check("read_acks: the live brew ack is read, the expired one and another subject's are not",
      None if _live is None else sorted(_live), [("a36pkg", "CVE-2026-0001")])
check("read_acks: no database yet means nothing acked, {}",
      None if _read_acks is None else _read_acks("brew", _ackdb + ".missing"), {})
_junk = _ackdb + ".junk"
with open(_junk, "w") as _fh:
    _fh.write("not a database")
check("read_acks: an unreadable database is None, so the caller stays EXPOSED",
      "missing" if _read_acks is None else _read_acks("brew", _junk), None)

TC = None
for _dir in (os.path.dirname(os.path.abspath(__file__)),
             os.path.dirname(os.path.realpath(__file__))):
    _path = os.path.join(_dir, "toolchain-cve-check")
    if os.path.exists(_path):
        _ldr = importlib.machinery.SourceFileLoader("toolchain_cve_check", _path)
        TC = importlib.util.module_from_spec(importlib.util.spec_from_loader("toolchain_cve_check", _ldr))
        _ldr.exec_module(TC)
        break
if TC is None:
    sys.exit("vulnlib-selftest: no toolchain-cve-check beside %s (deploy both)" % sys.argv[0])
TC.V = V                    # run_brew sets this global; the fixtures seed THIS module
install(a36pkg=[])          # Homebrew answers, and has backported nothing


class _BrewClient(V.NvdClient):
    def __init__(self, ids):
        super().__init__(None, timeout=1.0)
        self.delay = 0.0
        self.ids = ids

    def cves_for(self, vendor, product, version):
        return ([{"id": i, "unbounded": False, "fix_commit": None, "score": 7.5,
                  "severity": "HIGH", "description": ""} for i in self.ids], False)


def _brew(ids, acks):
    import inspect
    if "acks" not in inspect.signature(TC.check_brew).parameters:
        return ("no acks parameter", [])
    r = TC.check_brew(_BrewClient(ids), [("a36pkg", "1.0")],
                      {"a36pkg": ["v", "a36pkg"]}, acks=acks)[0]
    return (r.status, [a["cve"] for a in r.advisories])


_one = ["CVE-2026-0001"]
check("an acked CVE is ACKED, not EXPOSED", _brew(_one, _live or {}), ("acked", _one))
check("an ack that expired puts it straight back to EXPOSED (read from the real table)",
      _brew(["CVE-2026-0002"], _live or {}), ("exposed", ["CVE-2026-0002"]))
check("one acked and one not: EXPOSED, listing only the unacked one",
      _brew(["CVE-2026-0001", "CVE-2026-0009"], _live or {}),
      ("exposed", ["CVE-2026-0009"]))
check("control: no acks at all is EXPOSED", _brew(_one, {}), ("exposed", _one))
check("control: unreadable acks (None) is EXPOSED", _brew(_one, None), ("exposed", _one))

if _live:
    _r = TC.check_brew(_BrewClient(_one), [("a36pkg", "1.0")],
                       {"a36pkg": ["v", "a36pkg"]}, acks=_live)
    import contextlib as _cl
    import io as _io
    _buf = _io.StringIO()
    with _cl.redirect_stdout(_buf):
        TC.print_table(_r, quiet=False)
    _txt = _buf.getvalue()
    check("the table says ACKED with the expiry date, and never the word EXPOSED",
          ("ACKED" in _txt, "until 20" in _txt, "EXPOSED" in _txt), (True, True, False))


print("\n%s%s%s  %d passed, %d failed, %d skipped"
      % (RED if FAILURES else GREEN, "FAIL" if FAILURES else "OK  ", OFF,
         PASS, len(FAILURES), SKIP))
if FAILURES:
    print("  failed: %s" % "; ".join(FAILURES))
sys.exit(1 if FAILURES else 0)
