#!/usr/bin/env bash
# ============================================================================
#  ci-watch-selftest -- proves ci-watch cannot render a cached result as live
# ============================================================================
# WRITTEN BEFORE THE REWRITE IT TESTS, 2026-09-15, in the same spirit as
# ccw-watch-selftest. The bug being fixed is a FALSE GREEN: when the GitHub
# query failed, ci-watch fell back to a per-target cache and rendered the
# cached `success` through the ordinary green path, with no staleness marker.
# A repo that went green and then lost Actions access rendered
#     OK CI green -- <label> (deadbee)
# forever. Reproduced by execution on 2026-09-15, two runs of one command with
# one variable changed (a planted cache), before a line of the fix was written.
#
# WHY THE CASES CAME FIRST. Every assertion here is about an ABSENCE -- "no
# green glyph", "fetched_at unchanged", "no red escape code". Absences are the
# outputs that read identically whether the mechanism worked or the test never
# ran, so every failure-path case below ships with its success-path TWIN that
# asserts the same marker is PRESENT. A case without its twin proves nothing.
#
# THE STUB IS THE TEST SEAM. ci-watch honours CI_WATCH_HTTP_STUB: an executable
# called INSTEAD of gh/curl, given the API path as $1, printing the HTTP status
# on line 1 and the response body on the rest. Its own exit code simulates
# transport failure (7) and timeout (28). That makes all nine fetch outcomes
# deterministic with no network, no token, and no sandbox interaction -- the
# real gh binary on this machine is wrapped by github-agent-token, which needs
# a uv cache the Claude sandbox denies, so a network-dependent suite could not
# run here at all.
#
# Usage:  ci-watch-selftest            run every case
#         ci-watch-selftest -v         also print each rendered line
#         CI_WATCH_TOOL=/path/to/ci-watch ci-watch-selftest
# Exit:   0 all passed  |  1 a case failed  |  2 could not run (invalid trial)
# ============================================================================

set -uo pipefail

TOOL="${CI_WATCH_TOOL:-$(dirname "$0")/ci-watch}"
[ -x "$TOOL" ] || { printf 'selftest: cannot find ci-watch at %s\n' "$TOOL" >&2; exit 2; }

VERBOSE=0; [ "${1:-}" = "-v" ] && VERBOSE=1

# THE SUITE MUST NEVER SPEAK. 13 fixture cases drive a real green->red transition,
# and each one used to raise a live voice alert -- through a dead endpoint, then
# out of a backgrounded `say`, unserialised. Running the suite a dozen times today
# put roughly a hundred spoken alerts onto the machine with fixture labels like
# "TESTTARGET". CI_WATCH_DEBUG short-circuits voice_alert to stderr; it is exported
# here so no individual case can forget it.
export CI_WATCH_DEBUG=1

PASS=0; FAIL=0
declare -a COVERED=()          # claim ids touched, for the C32 coverage map

ROOT="$(mktemp -d "${TMPDIR:-/tmp}/ci-watch-selftest.XXXXXX")" || {
    printf 'selftest: mktemp failed -- INVALID TRIAL, not a pass\n' >&2; exit 2; }
# Deliberately NOT removed: `rm` here routes through the Trash wrapper and would
# fill the Trash with fixture trees on every run. The OS reaps TMPDIR. The path
# is printed at the end so a failing case can be opened.

ok(){  PASS=$((PASS+1)); COVERED+=("$1"); printf '  ok   %-7s %s\n' "$1" "$2"; }
bad(){ FAIL=$((FAIL+1)); COVERED+=("$1")
       printf '  FAIL %-7s %s\n       want: %s\n       got : %s\n' \
              "$1" "$2" "$3" "$(printf '%s' "$4" | tr '\n' '|')"; }

want(){    case "$4" in *"$3"*) ok "$1" "$2";; *) bad "$1" "$2" "contains: $3" "$4";; esac; }
wantnot(){ case "$4" in *"$3"*) bad "$1" "$2" "must NOT contain: $3" "$4";; *) ok "$1" "$2";; esac; }
wanteq(){  [ "$3" = "$4" ] && ok "$1" "$2" || bad "$1" "$2" "$3" "$4"; }

# ---- fixture plumbing ------------------------------------------------------
# A case gets its own state dir, watchlist and stub payloads.
CASE=0
new_case(){                      # new_case -> sets D, LIST, STATE, STUB, BSTUB
    CASE=$((CASE+1))
    D="$ROOT/case$CASE"; mkdir -p "$D/state"
    LIST="$D/watchlist"; STATE="$D/state"
    STUB="$D/runs.stub"; BSTUB="$D/branch.stub"
    RSTUB="$D/repo.stub"; DSTUB="$D/default.stub"
    printf 'o/r@main | TESTTARGET\n' > "$LIST"
    stub_runs 200 '{"total_count":1,"workflow_runs":[{"conclusion":"success","status":"completed","head_sha":"1234567cafe","html_url":"https://example.invalid/run"}]}'
    stub_branch 200 '{"name":"main"}'
    # The repo's default branch is "trunk" so the watched branch ("main") and the
    # control branch are distinguishable in the stub.
    stub_repo    200 '{"default_branch":"trunk"}'
    stub_default 200 '{"name":"trunk"}'
    cat > "$D/http-stub" <<'STUBEOF'
#!/usr/bin/env bash
# A `gh` IMPERSONATOR, not an HTTP stub. ci-watch now speaks to gh, so the test
# double has to speak gh's contract -- which is the point: the contract is the
# thing worth testing. Fixtures stay in the old (HTTP status + body) shape and
# this shim translates, so one translation lives here instead of in every case.
#   run list ...   -> exit 0 + TSV on stdout, or exit 1 + prose on stderr
#   api <path>     -> exit 0 + body, or exit 1 + "gh: <msg> (HTTP <code>)"
sub="$1"; shift
fixture_for_repo(){   # per-repo override, else the default fixture
  case "$1" in
    o/r2|x/y) [ -n "${CI_WATCH_SELFTEST_STUB2:-}" ] && { printf '%s' "$CI_WATCH_SELFTEST_STUB2"; return; } ;;
  esac
  printf '%s' "$CI_WATCH_SELFTEST_STUB"
}
if [ "$sub" = run ]; then
  shift                                  # drop "list"
  repo=''; branch=''
  while [ $# -gt 0 ]; do
    case "$1" in
      --repo)   repo="$2"; shift 2 ;;
      --branch) branch="$2"; shift 2 ;;
      *) shift ;;
    esac
  done
  f="$(fixture_for_repo "$repo")"
  [ -f "$f" ] || { printf 'failed to get runs: no fixture\n' >&2; exit 1; }
  code="$(head -1 "$f")"
  case "$code" in
    TIMEOUT)   printf 'failed to get runs: context deadline exceeded\n' >&2; exit 1 ;;
    TRANSPORT) printf 'failed to get runs: dial tcp: connection refused\n' >&2; exit 1 ;;
  esac
  body="$(tail -n +2 "$f")"
  if [ "$code" = 200 ]; then
    printf '%s' "$body" | jq -r '(.workflow_runs[0] // {}) | [(.conclusion // ""),(.status // ""),(.head_sha // ""),(.html_url // "")] | @tsv' 2>/dev/null \
      || { printf 'failed to get runs: invalid character in response\n' >&2; exit 1; }
    exit 0
  fi
  msg="$(printf '%s' "$body" | jq -r '.message // ""' 2>/dev/null)"
  printf 'failed to get runs: HTTP %s: %s (https://api.github.com/repos/%s/actions/runs)\n' "$code" "$msg" "$repo" >&2
  exit 1
fi
if [ "$sub" = api ]; then
  path="$1"
  case "$path" in
    */branches/trunk|*/branches/main2) f="$CI_WATCH_SELFTEST_DSTUB" ;;
    */branches/*)                      f="$CI_WATCH_SELFTEST_BSTUB" ;;
    *)                                 f="$CI_WATCH_SELFTEST_RSTUB" ;;
  esac
  [ -f "$f" ] || { printf 'gh: Not Found (HTTP 404)\n' >&2; exit 1; }
  code="$(head -1 "$f")"; body="$(tail -n +2 "$f")"
  if [ "$code" = 200 ]; then printf '%s\n' "$body"; exit 0; fi
  msg="$(printf '%s' "$body" | jq -r '.message // "error"' 2>/dev/null)"
  printf 'gh: %s (HTTP %s)\n' "$msg" "$code" >&2
  exit 1
fi
printf 'gh: unsupported in the selftest shim: %s\n' "$sub" >&2
exit 2
STUBEOF
    chmod +x "$D/http-stub"
}
stub_runs(){   { printf '%s\n' "$1"; printf '%s' "$2"; } > "$STUB"; }
stub_branch(){  { printf '%s\n' "$1"; printf '%s' "$2"; } > "$BSTUB"; }
stub_repo(){    { printf '%s\n' "$1"; printf '%s' "$2"; } > "$RSTUB"; }
stub_default(){ { printf '%s\n' "$1"; printf '%s' "$2"; } > "$DSTUB"; }

run_watch(){                     # run_watch [extra env assignments...] -> OUT / RC
    OUT="$(env CI_WATCH_DEBUG=1 CI_WATCH_LIST="$LIST" CI_WATCH_STATE="$STATE" \
               CI_WATCH_GH="$D/http-stub" \
               CI_WATCH_SELFTEST_STUB="$STUB" CI_WATCH_SELFTEST_BSTUB="$BSTUB" \
               CI_WATCH_SELFTEST_RSTUB="$RSTUB" CI_WATCH_SELFTEST_DSTUB="$DSTUB" \
               NO_COLOR="${NO_COLOR_OVERRIDE:-}" \
               "$@" "$TOOL" 2>&1)"
    RC=$?
    [ "$VERBOSE" -eq 1 ] && printf '       | %s\n' "$OUT"
    return 0
}
statefile(){ printf '%s/%s.state' "$STATE" "$(printf '%s' 'o/r@main' | tr '/@:.' '____' | tr -cd 'A-Za-z0-9_-')"; }
field(){ grep -E "^$1=" "$(statefile)" 2>/dev/null | head -1 | cut -d= -f2-; }

GREENGLYPH='CI green'
REDCODE=$'\033[0;31m'

printf '\nci-watch-selftest -- fixtures in %s\n\n' "$ROOT"

# ===========================================================================
# F1 -- honest fetch classification
# ===========================================================================
printf 'F1  honest fetch classification\n'

# C1 static: the evidence-destroying construct is gone from the fetch paths.
# Scope to the fetch/classify functions -- the claim is about the FETCH path, not
# about `mkdir -p ... || true` housekeeping elsewhere in the file.
c1_region="$(sed -n '/^fetch_runs()/,/^}/p;/^classify_gh_error()/,/^}/p;/^gh_api_ok()/,/^}/p' "$TOOL")"
c1_hits="$(printf '%s' "$c1_region" | grep -c '2>/dev/null || true' || true)"
c1_hits="$(printf '%s' "$c1_hits" | head -1)"
# POSITIVE ARM: the grep itself must be able to find something in this file,
# otherwise a 0 means "grep did not run", not "the construct is absent".
c1_control="$(printf '%s' "$c1_region" | grep -c 'O_TOKEN' || true)"
c1_control="$(printf '%s' "$c1_control" | head -1)"
if [ "$c1_control" -eq 0 ]; then
    bad C1 "fetch-path grep" "control token present" "control missed -- INVALID TRIAL, not a pass"
else
    wanteq C1 "no 2>/dev/null-plus-true in the tool" "0" "$c1_hits"
fi

# C2: every outcome token, one fixture each.
for spec in "200:ok" "403perm:perm_denied" "404:not_found" "401:unauthorized" \
            "403rate:rate_limited" "TIMEOUT:timeout" "TRANSPORT:transport" \
            "200empty:empty_ok" "200garbage:transport"; do
    code="${spec%%:*}"; expect="${spec#*:}"
    new_case
    case "$code" in
      200)        : ;;  # default fixture is a healthy success
      200empty)   stub_runs 200 '{"total_count":0,"workflow_runs":[]}' ;;
      200garbage) stub_runs 200 '<html>503 maintenance</html>' ;;
      403perm)    stub_runs 403 '{"message":"Resource not accessible by integration","status":"403"}' ;;
      403rate)    stub_runs 403 '{"message":"API rate limit exceeded","status":"403"}' ;;
      404)        stub_runs 404 '{"message":"Not Found","status":"404"}' ;;
      401)        stub_runs 401 '{"message":"Bad credentials","status":"401"}' ;;
      TIMEOUT)    stub_runs TIMEOUT '' ;;
      TRANSPORT)  stub_runs TRANSPORT '' ;;
    esac
    run_watch
    wanteq C2 "outcome token for $code" "$expect" "$(field last_outcome)"
done

# C3: an HTTP error body must never become a CI value.
new_case
stub_runs 403 '{"message":"Resource not accessible by integration","documentation_url":"https://docs.github.com/rest/actions/workflow-runs#list-workflow-runs-for-a-repository","status":"403"}'
run_watch
wantnot C3 "403 body yields no green" "$GREENGLYPH" "$OUT"
wantnot C3 "403 body yields no sha"   "1234567"     "$OUT"
# TWIN: the same assertion must FAIL to hold on a real success, or it proves nothing.
new_case; run_watch
want C3 "TWIN success does render green" "$GREENGLYPH" "$OUT"

# C4: the two 403 message strings name different token families.
new_case; stub_runs 403 '{"message":"Resource not accessible by integration","status":"403"}'
run_watch; app_out="$OUT"
new_case; stub_runs 403 '{"message":"Resource not accessible by personal access token","status":"403"}'
run_watch; pat_out="$OUT"
# The two wordings may still be reported, but the REMEDY must not depend on them:
# measured 2026-09-15, a fine-grained PAT received the "by integration" wording,
# so routing the reader to App settings on that string sends them to the wrong
# settings page. Both messages must carry the same core fix.
want C4 "integration wording names the permission"    "Actions permission (read)" "$app_out"
want C4 "PAT wording names the same permission"       "Actions permission (read)" "$pat_out"
want C4 "integration remedy still mentions PATs too"  "Fine-grained token"        "$app_out"
want C4 "the wording is flagged as NOT proof"         "NOT proof"                 "$app_out"

# C5: a 404 must not assert non-existence as fact.
new_case; stub_runs 404 '{"message":"Not Found","status":"404"}'
run_watch
want    C5 "404 names both possibilities" "cannot see it" "$OUT"
wantnot C5 "404 does not assert deletion" "no longer exists" "$OUT"

# ===========================================================================
# F2 -- success-only freshness stamp
# ===========================================================================
printf 'F2  success-only freshness stamp\n'

# C6: a failing fetch must not move fetched_at. THE CORE INVARIANT.
new_case
run_watch                                  # arm 1: success stamps the clock
t1="$(field fetched_at)"
[ -n "$t1" ] && ok C6 "success writes fetched_at" || bad C6 "success writes fetched_at" "non-empty" "$t1"
stub_runs 403 '{"message":"Resource not accessible by integration","status":"403"}'
run_watch CI_WATCH_NOW=9999999999          # arm 2: refusal, far in the future
t2="$(field fetched_at)"
wanteq C6 "failure leaves fetched_at byte-identical" "$t1" "$t2"
# TWIN: a later SUCCESS must move it, or the field is simply frozen and the
# assertion above would pass even if the tool never wrote it again.
new_case; run_watch; t3="$(field fetched_at)"
run_watch CI_WATCH_NOW=9999999999; t4="$(field fetched_at)"
if [ "$t3" = "$t4" ]; then bad C6 "TWIN success DOES move fetched_at" "changed" "$t4"
else ok C6 "TWIN success does move fetched_at"; fi

# C7: health and result are separate fields.
new_case; run_watch
[ -n "$(field last_outcome)" ] && [ -n "$(field observed_state)" ] \
    && ok C7 "health and result stored separately" \
    || bad C7 "health and result stored separately" "both fields" "$(cat "$(statefile)" 2>&1)"

# C8: a failing fetch must not reset red_since or the snooze.
new_case
stub_runs 200 '{"total_count":1,"workflow_runs":[{"conclusion":"failure","status":"completed","head_sha":"bbbbbbb2222","html_url":"u"}]}'
run_watch CI_WATCH_NOW=1000000000
rs1="$(field red_since)"
stub_runs 403 '{"message":"Resource not accessible by integration","status":"403"}'
run_watch CI_WATCH_NOW=1000432000          # +5 days, now blind
wanteq C8 "blind does not reset red_since" "$rs1" "$(field red_since)"

# ===========================================================================
# F3 -- four-state render, no cached green
# ===========================================================================
printf 'F3  four-state render\n'

# C9: THE REGRESSION TEST. The exact 2026-09-15 reproduction, both arms.
new_case
run_watch                                   # observe green for real
want C9 "ARM 1 live success renders green" "$GREENGLYPH" "$OUT"
stub_runs 403 '{"message":"Resource not accessible by integration","status":"403"}'
run_watch                                   # same target, now refused
wantnot C9 "ARM 2 cached success never renders green" "$GREENGLYPH" "$OUT"

# C10: a rendered cached value carries its age.
new_case
run_watch CI_WATCH_NOW=1000000000
stub_runs TIMEOUT ''
run_watch CI_WATCH_NOW=1000021600           # +6h
want C10 "stale render shows an age" "6h" "$OUT"

# C11: four visually distinct states.
seen=""
new_case; run_watch; seen="$seen|$(printf '%s' "$OUT" | grep -o 'CI [a-z]*' | head -1)"
new_case; stub_runs 200 '{"total_count":1,"workflow_runs":[{"conclusion":"failure","status":"completed","head_sha":"c","html_url":"u"}]}'
run_watch; seen="$seen|$(printf '%s' "$OUT" | grep -oE 'CI (RED|red)' | head -1)"
new_case; stub_runs 403 '{"message":"Resource not accessible by integration","status":"403"}'
run_watch; blind_never="$OUT"
new_case; run_watch >/dev/null; stub_runs 403 '{"message":"Resource not accessible by integration","status":"403"}'
run_watch; blind_after="$OUT"
if [ "$blind_never" = "$blind_after" ]; then
    bad C11 "BLIND distinct from UNOBSERVABLE" "different lines" "$blind_never"
else
    ok C11 "BLIND distinct from UNOBSERVABLE"
fi
want C11 "never-observed target says unobservable" "never" "$blind_never"
want C11 "previously-observed refusal says BLIND"  "BLIND" "$blind_after"

# C12: BLIND self-clears on the next success, no manual step.
new_case
run_watch
stub_runs 403 '{"message":"Resource not accessible by integration","status":"403"}'
run_watch
want C12 "went blind" "BLIND" "$OUT"
stub_runs 200 '{"total_count":1,"workflow_runs":[{"conclusion":"success","status":"completed","head_sha":"1234567cafe","html_url":"u"}]}'
run_watch
want    C12 "access returns -> green immediately" "$GREENGLYPH" "$OUT"
wantnot C12 "no BLIND residue"                    "BLIND"       "$OUT"

# C13: past the hard TTL, no value at all -- only the reason.
new_case
run_watch CI_WATCH_NOW=1000000000
stub_runs TIMEOUT ''
run_watch CI_WATCH_NOW=1001728000           # +20 days
wantnot C13 "expired cache shows no sha"   "1234567" "$OUT"
wantnot C13 "expired cache shows no green" "$GREENGLYPH" "$OUT"
# TWIN: inside the TTL the sha IS shown, so the assertion above is not vacuous.
new_case
run_watch CI_WATCH_NOW=1000000000
stub_runs TIMEOUT ''
run_watch CI_WATCH_NOW=1000086400           # +1 day
want C13 "TWIN inside TTL still shows the sha" "1234567" "$OUT"

# ===========================================================================
# F4 -- branch liveness
# ===========================================================================
printf 'F4  branch liveness\n'

# C14: a deleted branch is its own state, not unknown and not a stale green.
new_case
stub_branch 404 '{"message":"Not Found","status":"404"}'
stub_default 200 '{"name":"trunk"}'        # CONTROL HITS: the token can read branches
run_watch
want    C14 "dead ref named"        "no longer exists" "$OUT"
wantnot C14 "dead ref is not green" "$GREENGLYPH"      "$OUT"
# TWIN: a live branch must NOT produce the dead-ref line.
new_case; run_watch
wantnot C14 "TWIN live branch has no dead-ref line" "no longer exists" "$OUT"

# C15: the liveness call is cached -- two renders inside the TTL, one call.
new_case
CALLLOG="$D/branchcalls"; : > "$CALLLOG"
cat > "$D/http-stub" <<'STUBEOF'
#!/usr/bin/env bash
sub="$1"; shift
if [ "$sub" = api ]; then
  case "$1" in */branches/*) printf 'B\n' >> "$CI_WATCH_SELFTEST_CALLLOG" ;; esac
  printf '{"name":"main","default_branch":"main"}\n'; exit 0
fi
printf '%s\t%s\t%s\t%s\n' success completed 1234567cafe u
exit 0
STUBEOF
chmod +x "$D/http-stub"
run_watch CI_WATCH_SELFTEST_CALLLOG="$CALLLOG" CI_WATCH_NOW=1000000000
run_watch CI_WATCH_SELFTEST_CALLLOG="$CALLLOG" CI_WATCH_NOW=1000003600
wanteq C15 "branch liveness cached inside TTL" "1" "$(wc -l < "$CALLLOG" | tr -d ' ')"

# C34 (live-found 2026-09-15): a 404 from /branches/ is NOT proof of deletion.
# Measured against the real API: a live watched branch returned 404 while
# being demonstrably alive and green, because the token reads Actions but not
# Contents and GitHub 404s rather than confirming a private resource exists.
# So the 404 path carries a positive control, and when the CONTROL ALSO MISSES
# the honest answer is "cannot confirm", never "gone".
new_case
stub_branch  404 '{"message":"Not Found","status":"404"}'
stub_default 404 '{"message":"Not Found","status":"404"}'   # CONTROL MISSES
run_watch
wantnot C34 "blind instrument never claims the branch is gone" "no longer exists" "$OUT"
want    C34 "and the CI result is still reported"             "$GREENGLYPH"      "$OUT"

# ===========================================================================
# F5 -- the control arm
# ===========================================================================
printf 'F5  the control arm\n'

# C16: --control must fail loudly if the classifier ever calls a refusal green.
new_case
OUT="$(env CI_WATCH_STATE="$STATE" CI_WATCH_LIST="$LIST" "$TOOL" --control 2>&1)"; RC=$?
wanteq C16 "--control passes on a healthy tool" "0" "$RC"
# NEGATIVE ARM: force every classification to green and the control MUST fail.
OUT="$(env CI_WATCH_STATE="$STATE" CI_WATCH_LIST="$LIST" CI_WATCH_FORCE=green "$TOOL" --control 2>&1)"; RC=$?
if [ "$RC" -eq 0 ]; then
    bad C16 "--control catches a forced-green classifier" "exit != 0" "exit 0: $OUT"
else
    ok C16 "--control catches a forced-green classifier"
fi

# C17: the selftest is reachable through ~/.local/bin, not only from the repo.
if [ -x "$HOME/.local/bin/ci-watch-selftest" ] && [ -x "$HOME/.local/bin/ci-watch" ]; then
    ok C17 "stow-deployed and reachable via ~/.local/bin"
else
    bad C17 "stow-deployed and reachable via ~/.local/bin" "both executable" \
        "$(ls -l "$HOME/.local/bin/ci-watch"* 2>&1 | tr '\n' ';')"
fi

# ===========================================================================
# F6 -- --add ergonomics
# ===========================================================================
printf 'F6  --add ergonomics\n'

# C18: adding from a non-default branch warns and names the re-point command.
new_case
REPO="$D/repo"; mkdir -p "$REPO"
git -C "$REPO" init -q 2>/dev/null
git -C "$REPO" remote add origin "https://github.com/o/r.git" 2>/dev/null
git -C "$REPO" -c user.email=t@t -c user.name=t commit -q --allow-empty -m init 2>/dev/null
git -C "$REPO" checkout -q -b feature/thing 2>/dev/null
: > "$D/addlist"
OUT="$(env CI_WATCH_LIST="$D/addlist" CI_WATCH_STATE="$STATE" \
          git -C "$REPO" rev-parse --show-toplevel >/dev/null 2>&1; \
      cd_out=$(env CI_WATCH_LIST="$D/addlist" CI_WATCH_STATE="$STATE" \
          bash -c "builtin cd '$REPO' && '$TOOL' --add . 2>&1"); printf '%s' "$cd_out")"
want C18 "--add warns on a feature branch" "re-point" "$OUT"
# TWIN: adding from the default branch must NOT warn.
git -C "$REPO" checkout -q master 2>/dev/null || git -C "$REPO" checkout -q main 2>/dev/null
: > "$D/addlist"
OUT="$(bash -c "builtin cd '$REPO' && CI_WATCH_LIST='$D/addlist' CI_WATCH_STATE='$STATE' '$TOOL' --add . 2>&1")"
wantnot C18 "TWIN default branch does not warn" "re-point" "$OUT"

# ===========================================================================
# F7 -- edge cases and coverage
# ===========================================================================
printf 'F7  edge cases and coverage\n'

# C24: an IN-PROGRESS run was observed. It must never read as unobservable.
new_case
stub_runs 200 '{"total_count":1,"workflow_runs":[{"conclusion":null,"status":"in_progress","head_sha":"ddddddd4444","html_url":"u"}]}'
run_watch
wantnot C24 "in_progress is not BLIND"        "BLIND" "$OUT"
wantnot C24 "in_progress is not unobservable" "never" "$OUT"
want    C24 "in_progress is named"            "running" "$OUT"

# C33 REGRESSION (live-found 2026-09-15, invisible to every stub until now): a
# REAL runs payload contains "status":"completed" on the run and a "message" on
# head_commit. Reading those as an HTTP status and an API error message turned a
# healthy 200 into `HTTP completed: <the whole commit message>` and rendered the
# repo unobservable. Minimal stubs never carried the decoy fields.
new_case
stub_runs 200 '{"total_count":1,"workflow_runs":[{"conclusion":"success","status":"completed","head_sha":"1234567cafe","html_url":"u","head_commit":{"message":"docs: order the args table\n\nC-Branch: main","id":"abc"},"repository":{"full_name":"o/r"}}]}'
run_watch
want    C33 "realistic payload renders green"      "$GREENGLYPH" "$OUT"
wantnot C33 "commit message never leaks as detail" "C-Branch"    "$OUT"
wantnot C33 "run status never read as HTTP status" "HTTP completed" "$OUT"

# C25: every conclusion GitHub can return maps to a named state.
for concl in cancelled neutral skipped action_required stale timed_out startup_failure; do
    new_case
    stub_runs 200 "{\"total_count\":1,\"workflow_runs\":[{\"conclusion\":\"$concl\",\"status\":\"completed\",\"head_sha\":\"eeeeeee5555\",\"html_url\":\"u\"}]}"
    run_watch
    wantnot C25 "$concl is not unobservable" "never" "$OUT"
done

# C35 AUDIT-FOUND (2026-09-15, independent review): DISMISS-BY-CANCEL. Every
# non-conclusive observation used to zero red_since and snooze, so cancelling a
# run cleared a multi-day red alarm and the next failure restarted at "0d",
# tier 1. C8 and Anti-C23 both PASSED while this was live -- C8 only exercised
# the blind path and Anti-C23 only rendered red twice in a row, so neither ever
# put a non-red OBSERVATION between two reds. That gap is the lesson.
for mid in cancelled neutral skipped action_required stale; do
    new_case
    stub_runs 200 '{"total_count":1,"workflow_runs":[{"conclusion":"failure","status":"completed","head_sha":"deadbee1","html_url":"u"}]}'
    run_watch CI_WATCH_NOW=1000000000
    run_watch CI_WATCH_NOW=1000518400                      # +6 days, still red
    stub_runs 200 "{\"total_count\":1,\"workflow_runs\":[{\"conclusion\":\"$mid\",\"status\":\"completed\",\"head_sha\":\"cafe0001\",\"html_url\":\"u\"}]}"
    run_watch CI_WATCH_NOW=1000518500                      # a $mid run appears
    want   C35 "$mid does not hide the red alarm" "RED" "$OUT"
    wanteq C35 "$mid does not reset the streak" "1000000000" "$(field red_since)"
done
# in_progress is the same class: a running build is not a fixed build.
new_case
stub_runs 200 '{"total_count":1,"workflow_runs":[{"conclusion":"failure","status":"completed","head_sha":"deadbee1","html_url":"u"}]}'
run_watch CI_WATCH_NOW=1000000000
stub_runs 200 '{"total_count":1,"workflow_runs":[{"conclusion":null,"status":"in_progress","head_sha":"cafe0001","html_url":"u"}]}'
run_watch CI_WATCH_NOW=1000518500
want C35 "a running build does not clear the red" "RED" "$OUT"
# TWIN: an actual GREEN must still clear it, or the fix has simply frozen the alarm on.
new_case
stub_runs 200 '{"total_count":1,"workflow_runs":[{"conclusion":"failure","status":"completed","head_sha":"deadbee1","html_url":"u"}]}'
run_watch CI_WATCH_NOW=1000000000
stub_runs 200 '{"total_count":1,"workflow_runs":[{"conclusion":"success","status":"completed","head_sha":"1234567cafe","html_url":"u"}]}'
run_watch CI_WATCH_NOW=1000518500
want   C35 "TWIN a real green DOES clear the red" "$GREENGLYPH" "$OUT"
wanteq C35 "TWIN green zeroes the streak"          "0" "$(field red_since)"

# C36 AUDIT-FOUND (2026-09-15): THE PARSER TRUNCATED AT THE FIRST BRACE.
# `${rest%\}*}` cut the run object at the first `}`. GitHub orders the object
# id, name, ..., display_title, ..., status, conclusion -- so a commit title
# containing a brace ("fix: handle {} in the parser") or a workflow named
# "Build {matrix}" cut it BEFORE the fields being read, and both a green and a
# red run rendered `.. CI running`. Combined with the alarm bug that meant a
# COMMIT MESSAGE could dismiss a CI alarm. C33 missed it only because its
# fixture put the decoy fields AFTER the ones being read; this one uses the
# real key order, which is the whole point.
new_case
stub_runs 200 '{"total_count":1,"workflow_runs":[{"id":1,"name":"CI","node_id":"x","head_branch":"main","head_sha":"1234567cafe","path":".github/workflows/ci.yml","display_title":"fix: handle {} in the parser","run_number":5,"event":"push","status":"completed","conclusion":"success","html_url":"u","actor":{"login":"a","html_url":"z"},"head_commit":{"message":"plain","id":"abc"},"repository":{"full_name":"o/r","html_url":"nested"}}]}'
run_watch
want C36 "braced title: a green run still renders green" "$GREENGLYPH" "$OUT"
new_case
stub_runs 200 '{"total_count":1,"workflow_runs":[{"id":1,"name":"CI","node_id":"x","head_branch":"main","head_sha":"deadbee1234","path":".github/workflows/ci.yml","display_title":"fix: handle {} in the parser","run_number":5,"event":"push","status":"completed","conclusion":"failure","html_url":"u","actor":{"login":"a","html_url":"z"},"head_commit":{"message":"plain","id":"abc"},"repository":{"full_name":"o/r","html_url":"nested"}}]}'
run_watch
want C36 "braced title: a red run still renders RED" "RED" "$OUT"
# CONTROL: the same payloads with a plain title must behave identically, or the
# fixture is testing the title rather than the parser.
new_case
stub_runs 200 '{"total_count":1,"workflow_runs":[{"id":1,"name":"CI","node_id":"x","head_branch":"main","head_sha":"deadbee1234","path":".github/workflows/ci.yml","display_title":"a plain title","run_number":5,"event":"push","status":"completed","conclusion":"failure","html_url":"u","actor":{"login":"a","html_url":"z"},"head_commit":{"message":"plain","id":"abc"},"repository":{"full_name":"o/r","html_url":"nested"}}]}'
run_watch
want C36 "CONTROL plain title still renders RED" "RED" "$OUT"
# And an escaped quote in the title must not let prose spoof a field.
new_case
stub_runs 200 '{"total_count":1,"workflow_runs":[{"id":1,"name":"CI","node_id":"x","head_branch":"main","head_sha":"deadbee1234","path":".github/workflows/ci.yml","display_title":"title with \\"conclusion\\": \\"success\\" inside","run_number":5,"event":"push","status":"completed","conclusion":"failure","html_url":"u","actor":{"login":"a","html_url":"z"},"head_commit":{"message":"plain","id":"abc"},"repository":{"full_name":"o/r","html_url":"nested"}}]}'
run_watch
wantnot C36 "a title quoting a conclusion cannot spoof it" "$GREENGLYPH" "$OUT"

# C37 AUDIT-FOUND: every GitHub 5xx fired the LOUD magenta banner. GitHub
# incidents are routine, so that is precisely the habituation BLIND exists to
# prevent -- the loud channel has to stay rare to stay worth anything.
new_case
run_watch                                     # observe green first
stub_runs 503 '<html>GitHub is having a bad day</html>'
run_watch
wantnot C37 "a 5xx is not BLIND"        "BLIND" "$OUT"
want    C37 "a 5xx still says stale"    "stale" "$OUT"
# TWIN: a permission refusal MUST still be loud, or the register is just dead.
new_case
run_watch
stub_runs 403 '{"message":"Resource not accessible by integration","status":"403"}'
run_watch
want C37 "TWIN a 403 is still BLIND" "BLIND" "$OUT"

# C38 AUDIT-FOUND: TRANSITION was a GLOBAL, and the branch-gone early return
# skipped the reset that the normal render path does -- so a target going red
# for the first time, whose branch is also dead, left the flag set, and the NEXT
# target in the watchlist spoke "just went red" about a red that was days old.
#
# MY FIRST VERSION OF THIS CASE WAS HOLLOW. It rendered two fresh reds and then
# two known reds, which behaves identically with and without the bug -- it
# passed against the unfixed binary. The leak needs the branch-gone EARLY RETURN
# specifically, so the fixture now serves a dead branch for the first target.
# (This is the audit's own lesson turned on the audit's own test.)
new_case
printf 'o/r@main | GONE\no/r2@main | SECOND\n' > "$LIST"
cat > "$D/http-stub" <<'STUBEOF'
#!/usr/bin/env bash
sub="$1"; shift
if [ "$sub" = api ]; then
  case "$1" in
    repos/o/r/branches/trunk) printf '{"name":"trunk"}\n'; exit 0 ;;        # control HITS
    repos/o/r/branches/*)     printf 'gh: Not Found (HTTP 404)\n' >&2; exit 1 ;;
    repos/o/r2/branches/*)    printf '{"name":"main"}\n'; exit 0 ;;
    repos/o/r)                printf '{"default_branch":"trunk"}\n'; exit 0 ;;
    repos/o/r2)               printf '{"default_branch":"main"}\n'; exit 0 ;;
  esac
  printf '{}\n'; exit 0
fi
repo=''
while [ $# -gt 0 ]; do case "$1" in --repo) repo="$2"; shift 2 ;; *) shift ;; esac; done
case "$repo" in
  o/r)  f="$CI_WATCH_SELFTEST_STUB" ;;
  o/r2) f="$CI_WATCH_SELFTEST_STUB2" ;;
  *)    f="$CI_WATCH_SELFTEST_STUB" ;;
esac
tail -n +2 "$f" | jq -r '(.workflow_runs[0] // {}) | [(.conclusion // ""),(.status // ""),(.head_sha // ""),(.html_url // "")] | @tsv'
exit 0
STUBEOF
chmod +x "$D/http-stub"
GREENP='{"total_count":1,"workflow_runs":[{"conclusion":"success","status":"completed","head_sha":"1234567cafe","html_url":"u"}]}'
REDP='{"total_count":1,"workflow_runs":[{"conclusion":"failure","status":"completed","head_sha":"deadbee1234","html_url":"u"}]}'
voices_at(){ # voices_at <now> -> count of transition alerts
    local out
    out="$(env CI_WATCH_LIST="$LIST" CI_WATCH_STATE="$STATE" CI_WATCH_GH="$D/http-stub" \
            CI_WATCH_SELFTEST_STUB="$STUB" CI_WATCH_SELFTEST_STUB2="$D/runs2.stub" \
            CI_WATCH_DEBUG=1 CI_WATCH_NOW="$1" "$TOOL" 2>&1)"
    [ "$VERBOSE" -eq 1 ] && printf '       | %s\n' "$out"
    printf '%s' "$out" | grep -c 'Heads up' || true
}
# Day 0: GONE is green, SECOND goes red -> exactly one legitimate alert.
printf '200\n%s' "$GREENP" > "$STUB"; printf '200\n%s' "$REDP" > "$D/runs2.stub"
v="$(voices_at 1000000000 | head -1)"
wanteq C38 "one fresh red speaks one transition" "1" "$v"
# Day 1: GONE goes red for the FIRST time and its branch is dead (early return).
# SECOND's red is a day old and must stay silent.
printf '200\n%s' "$REDP" > "$STUB"
v="$(voices_at 1000086400 | head -1)"
wanteq C38 "a branch-gone target does not speak for the NEXT target" "0" "$v"

# C39 AUDIT-FOUND: snoozing a never-observed target wrote observed_state=red,
# so --json reported a red for something that had never been seen once.
new_case
env CI_WATCH_LIST="$LIST" CI_WATCH_STATE="$STATE" CI_WATCH_NOW=1000000000 \
    "$TOOL" --snooze o/r 3 >/dev/null 2>&1
wantnot C39 "a snooze does not invent an observation" "red" "$(field observed_state)x"

# C40 AUDIT-FOUND (cross-vendor, 2026-09-15): ONE BAD BYTE MUTED THE DASHBOARD.
# `numor0` accepted any all-digit string, but bash reads a leading zero as OCTAL,
# so `fetched_at=08` is an invalid arithmetic expression -- and an invalid
# arithmetic expansion ABORTS THE SCRIPT. The render died mid-loop and every
# target after the corrupt one silently vanished, at exit 0. A live RED on the
# second row was never printed. The trigger needs a FAILING fetch, because a
# successful one overwrites fetched_at before the subtraction.
new_case
printf 'o/r@main | CORRUPT-FIRST\nx/y@main | MUST-STILL-RENDER\n' > "$LIST"
cat > "$D/http-stub" <<'STUBEOF'
#!/usr/bin/env bash
case "$1" in
  */branches/*)          printf '200\n{"name":"main"}' ;;
  repos/o/r/actions/*)   printf '408\n{"message":"timeout","status":"408"}' ;;
  repos/x/y/actions/*)   printf '200\n{"total_count":1,"workflow_runs":[{"conclusion":"failure","status":"completed","head_sha":"deadbee1234","html_url":"u"}]}' ;;
  *)                     printf '200\n{"default_branch":"main"}' ;;
esac
STUBEOF
chmod +x "$D/http-stub"
mkstate(){ printf 'schema=2\nlast_outcome=ok\nobserved_state=green\nobserved_concl=success\nobserved_sha=abc1234\nobserved_url=u\nfetched_at=%s\nchecked_at=0\nred_since=0\nsnooze_until=0\nbranch_alive=1\nbranch_checked=0\n' "$1" > "$(statefile)"; }
mkstate 08
run_watch CI_WATCH_NOW=1000000000
want   C40 "a leading-zero state value does not mute later targets" "MUST-STILL-RENDER" "$OUT"
wanteq C40 "and the render still exits 0" "0" "$RC"
# CONTROL: the same fixture with a valid number must render both rows too, or the
# assertion above could pass for reasons unrelated to the octal fix.
mkstate 8
run_watch CI_WATCH_NOW=1000000000
want C40 "CONTROL valid value renders both rows" "MUST-STILL-RENDER" "$OUT"
# And the same class through the CLI: `08` is all-digit and invalid octal.
OUT="$(env CI_WATCH_LIST="$LIST" CI_WATCH_STATE="$STATE" CI_WATCH_NOW=1000000000 \
        "$TOOL" --snooze o/r 08 2>&1)"; RC=$?
wanteq C40 "--snooze with a leading-zero day count succeeds" "0" "$RC"
want   C40 "and snoozes for 8 days, not 0"                   "8 day" "$OUT"

# C41: the classifier reads a status code out of gh's PROSE, so it is pinned to
# go-gh's formatter. `HTTPError.Error()` has THREE branches and only two carry a
# colon after the code (source: cli/go-gh pkg/api/errors.go):
#     "HTTP %d: %s (%s)\n%s"   multi-line message
#     "HTTP %d: %s (%s)"       single-line message
#     "HTTP %d (%s)"           empty message -- NO COLON
# A classifier anchored on "HTTP 403:" would silently miss the third and drop a
# real refusal into the quiet register. Flagged by the research agent; verified
# here by running all three shapes rather than by re-reading the regex.
c41_probe(){ # c41_probe <stderr-text> -> the token
    ( O_TOKEN=''; O_DETAIL=''
      source <(sed -n '/^classify_gh_error()/,/^}/p' "$TOOL")
      classify_gh_error "$1"; printf '%s' "$O_TOKEN" )
}
wanteq C41 "single-line message, with colon" "perm_denied" \
    "$(c41_probe 'failed to get runs: HTTP 403: Resource not accessible by integration (https://api.github.com/x)')"
wanteq C41 "EMPTY message, NO COLON"          "perm_denied" \
    "$(c41_probe 'failed to get runs: HTTP 403 (https://api.github.com/x)')"
wanteq C41 "multi-line message"               "perm_denied" \
    "$(c41_probe "$(printf 'failed to get runs: HTTP 403: Resource not accessible by personal access token (https://x)\nsecond line')")"
wanteq C41 "404 without a colon"              "not_found" \
    "$(c41_probe 'failed to get runs: HTTP 404 (https://x)')"
wanteq C41 "5xx stays quiet"                  "server_error" \
    "$(c41_probe 'failed to get runs: HTTP 503 (https://x)')"
# CONTROL: a message with NO status code must NOT come back as a refusal, or the
# assertions above would pass for a classifier that simply answers perm_denied.
wanteq C41 "CONTROL no code at all is transport" "transport" \
    "$(c41_probe 'failed to get runs: dial tcp: connection refused')"

# C42: WHOSE CREDENTIAL ANSWERED. ci-watch inherits the caller's GH_TOKEN, so its
# output depends on who invokes it -- run from Gavin's terminal it gets one token,
# run inside a Claude session it gets another. Two sessions spent a day
# confidently disagreeing about the same repo for exactly this reason. The fix is
# to say which credential was in play, ON THE LINE.
#
# Deliberately NOT a fallback: the peer session first proposed retrying with
# GH_TOKEN unset on a 403 and then withdrew it, because that path lands on a
# keyring token carrying `repo` scope -- silently upgrading a status line to full
# source read across every owned repo. A watcher that cannot see must say so, not
# go looking for a bigger key.
new_case
stub_runs 403 '{"message":"Resource not accessible by integration","status":"403"}'
OUT="$(env CI_WATCH_LIST="$LIST" CI_WATCH_STATE="$STATE" CI_WATCH_GH="$D/http-stub" \
        CI_WATCH_SELFTEST_STUB="$STUB" CI_WATCH_SELFTEST_BSTUB="$BSTUB" \
        CI_WATCH_SELFTEST_RSTUB="$RSTUB" CI_WATCH_SELFTEST_DSTUB="$DSTUB" \
        GH_TOKEN=pretend "$TOOL" 2>&1)"
want C42 "403 remedy names the credential in use" "credential: GH_TOKEN from the environment" "$OUT"
OUT="$(env -u GH_TOKEN -u GITHUB_TOKEN CI_WATCH_LIST="$LIST" CI_WATCH_STATE="$STATE" \
        CI_WATCH_GH="$D/http-stub" CI_WATCH_SELFTEST_STUB="$STUB" \
        CI_WATCH_SELFTEST_BSTUB="$BSTUB" CI_WATCH_SELFTEST_RSTUB="$RSTUB" \
        CI_WATCH_SELFTEST_DSTUB="$DSTUB" "$TOOL" 2>&1)"
# CHANGED 2026-09-17. This used to assert "gh's own stored auth" with no env
# token, which documented the very behaviour we then measured as a silent
# privilege escalation: an unset GH_TOKEN is not "no credential", it is gh
# helping itself to a keyring token with `repo` scope, which reads private
# SOURCE and CREATES ISSUES. ci-watch now fetches the narrow read-only PAT
# itself, so the no-env-token case must name THAT.
want C42 "and names the Keychain PAT it fetched when no env token" \
    "credential: narrow read-only PAT, fetched from the Keychain by this tool" "$OUT"
# THE ARM THAT NOW MATTERS MOST: when the fetch CANNOT run, the broad fallback
# must still be named, and named loudly. Forced by hiding github-api-token from
# PATH. Without this the suite would only ever exercise the happy path, and a
# silently-broken fetch would read as success.
OUT="$(env -u GH_TOKEN -u GITHUB_TOKEN PATH="$D:/usr/bin:/bin" CI_WATCH_LIST="$LIST" CI_WATCH_STATE="$STATE" \
        CI_WATCH_GH="$D/http-stub" CI_WATCH_SELFTEST_STUB="$STUB" \
        CI_WATCH_SELFTEST_BSTUB="$BSTUB" CI_WATCH_SELFTEST_RSTUB="$RSTUB" \
        CI_WATCH_SELFTEST_DSTUB="$DSTUB" "$TOOL" 2>&1)"
want C42 "names the BROAD fallback loudly when the fetch cannot run" "BROAD" "$OUT"
# TWIN: the two must differ, or the line is decoration rather than information.
wantnot C42 "TWIN the two credentials render differently" "GH_TOKEN from the environment" "$OUT"
# It must never silently retry with the env token removed -- that is an escalation.
wantnot C42 "a refusal never becomes a green by dropping the token" "$GREENGLYPH" "$OUT"

# C43: the gh binary must be resolved from PATH, never from a shell function. In
# an interactive session here `gh` IS a function that injects its own token, so
# `GH_TOKEN=x gh api ...` does not use the token passed. `command -v` is NOT
# enough: given a function named gh it returns the string "gh". `type -P` searches
# PATH only. Both arms below run the real resolution line out of the tool.
# Run the tool's real resolution line in a child bash, once with a hostile `gh`
# function defined and once without. A helper FILE, not nested quoting -- the
# first version of this case used three levels of nesting, produced an empty
# string in both arms, and its control compared empty to empty and PASSED. A
# control that cannot fail is not a control.
cat > "$ROOT/ghres.sh" <<'GHRES'
#!/usr/bin/env bash
[ "${1:-}" = wrapped ] && eval 'gh(){ echo WRAPPER; }'
source <(sed -n '/^GH=/,/^have_gh/p' "$2")
printf '%s' "$GH"
GHRES
chmod +x "$ROOT/ghres.sh"
r_wrapped="$(bash "$ROOT/ghres.sh" wrapped "$TOOL")"
r_clean="$(bash "$ROOT/ghres.sh" clean   "$TOOL")"
case "$r_clean" in
  /*) ok C43 "CONTROL resolution yields a real path at all" ;;
  *)  bad C43 "CONTROL resolution yields a real path at all" "an absolute path" "$r_clean -- INVALID TRIAL" ;;
esac
case "$r_wrapped" in
  /*) ok C43 "resolves to a real path even with a gh function in scope" ;;
  *)  bad C43 "resolves to a real path even with a gh function in scope" "an absolute path" "$r_wrapped" ;;
esac
wanteq C43 "wrapper cannot change the answer" "$r_clean" "$r_wrapped"

# C26: corrupt state and cache degrade, never crash.
new_case
printf 'schema=2\nlast_outcome=' > "$(statefile)"     # truncated mid-record
stub_runs 403 '{"message":"Resource not accessible by integration","status":"403"}'
run_watch
wanteq  C26 "truncated state still exits 0" "0" "$RC"
wantnot C26 "truncated state renders no fragment green" "$GREENGLYPH" "$OUT"
new_case
printf 'not a state file at all\n\x00\x01binary' > "$(statefile)" 2>/dev/null
run_watch
wanteq C26 "garbage state still exits 0" "0" "$RC"

# C27: concurrent renders must not corrupt the state file.
new_case
for _ in 1 2 3 4 5 6; do
    env CI_WATCH_LIST="$LIST" CI_WATCH_STATE="$STATE" CI_WATCH_GH="$D/http-stub" \
        CI_WATCH_SELFTEST_STUB="$STUB" CI_WATCH_SELFTEST_BSTUB="$BSTUB" CI_WATCH_SELFTEST_RSTUB="$RSTUB" CI_WATCH_SELFTEST_DSTUB="$DSTUB" "$TOOL" >/dev/null 2>&1 &
done
wait
bad_lines="$(grep -cvE '^[a-z_]+=.*$' "$(statefile)" 2>/dev/null || true)"
bad_lines="$(printf '%s' "${bad_lines:-0}" | head -1)"
# POSITIVE ARM: the state file must exist and have real lines, or a 0 above means
# "nothing was scanned" rather than "nothing was malformed".
good_lines="$(grep -cE '^schema=2$' "$(statefile)" 2>/dev/null || true)"
good_lines="$(printf '%s' "${good_lines:-0}" | head -1)"
[ "$good_lines" -ge 1 ] || bad C27 "state file scanned at all" "schema=2 present" "INVALID TRIAL"
wanteq C27 "concurrent renders leave a parseable state file" "0" "$bad_lines"

# C28: five watchlist shapes.
new_case; rm -f "$LIST" 2>/dev/null; run_watch
wanteq C28 "missing watchlist exits 0" "0" "$RC"
new_case; : > "$LIST"; run_watch
wanteq C28 "empty watchlist exits 0" "0" "$RC"
new_case; printf '# only a comment\n\n' > "$LIST"; run_watch
wanteq C28 "comments-only watchlist exits 0" "0" "$RC"
new_case; printf 'o/r@main | A\no/r@main | A\n' > "$LIST"; run_watch
wanteq C28 "duplicated target exits 0" "0" "$RC"
new_case; printf 'o/r@feature/nested/name | SLASHY\n' > "$LIST"; run_watch
wanteq  C28 "slash in branch name exits 0" "0" "$RC"
want    C28 "slash branch still renders its label" "SLASHY" "$OUT"

# C29: no gh, no token, no curl, no jq -- a skip, never a green.
new_case
OUT="$(env -i HOME="$HOME" PATH=/nonexistent TMPDIR="${TMPDIR:-/tmp}" \
        CI_WATCH_LIST="$LIST" CI_WATCH_STATE="$STATE" \
        /bin/bash "$TOOL" 2>&1)"; RC=$?
wantnot C29 "stripped PATH never renders green" "$GREENGLYPH" "$OUT"
wanteq  C29 "stripped PATH still exits 0"       "0"           "$RC"

# C30: the documented env overrides still work.
new_case
OUT="$(env CI_WATCH_LIST="$LIST" CI_WATCH_STATE="$STATE" NO_COLOR=1 \
        CI_WATCH_GH="$D/http-stub" CI_WATCH_SELFTEST_STUB="$STUB" \
        CI_WATCH_SELFTEST_BSTUB="$BSTUB" CI_WATCH_SELFTEST_RSTUB="$RSTUB" \
        CI_WATCH_SELFTEST_DSTUB="$DSTUB" "$TOOL" 2>&1)"
wantnot C30 "NO_COLOR suppresses ANSI" $'\033[' "$OUT"
new_case
OUT="$(env CI_WATCH_LIST="$LIST" CI_WATCH_STATE="$STATE" CI_WATCH_FORCE=red "$TOOL" 2>&1)"
want C30 "CI_WATCH_FORCE still forces" "RED" "$OUT"
new_case
run_watch CI_WATCH_NOW=1000000000
wanteq C30 "CI_WATCH_NOW still overrides the clock" "1000000000" "$(field checked_at)"

# C31: the snooze boundary is exact.
new_case
stub_runs 200 '{"total_count":1,"workflow_runs":[{"conclusion":"failure","status":"completed","head_sha":"fff","html_url":"u"}]}'
run_watch CI_WATCH_NOW=1000000000
env CI_WATCH_LIST="$LIST" CI_WATCH_STATE="$STATE" CI_WATCH_NOW=1000000000 \
    "$TOOL" --snooze o/r 1 >/dev/null 2>&1
run_watch CI_WATCH_NOW=1000086399        # one second before expiry
want    C31 "snoozed at T-1"  "snoozed" "$OUT"
run_watch CI_WATCH_NOW=1000086400        # exactly at expiry
wantnot C31 "expired exactly at T" "snoozed" "$OUT"

# C19/C20 cross-cutting
printf 'F0  cross-cutting\n'
new_case
c19_bad=0
for code in 200 403 404 401 TIMEOUT TRANSPORT; do
    case "$code" in
      403) stub_runs 403 '{"message":"Resource not accessible by integration","status":"403"}' ;;
      404) stub_runs 404 '{"message":"Not Found","status":"404"}' ;;
      401) stub_runs 401 '{"message":"Bad credentials","status":"401"}' ;;
      TIMEOUT|TRANSPORT) stub_runs "$code" '' ;;
      *) : ;;
    esac
    run_watch
    [ "$RC" -eq 0 ] || c19_bad=$((c19_bad+1))
done
wanteq C19 "render exits 0 under every fetch outcome" "0" "$c19_bad"

new_case                                   # C20: an OLD-format state/cache pair
printf 'last=green\nred_since=0\nsnooze_until=0\n' > "$(statefile)"
printf 'success\tcompleted\tdeadbee\thttps://example.invalid\n' > "$STATE/o_r_main.cache"
stub_runs 403 '{"message":"Resource not accessible by integration","status":"403"}'
run_watch
wanteq  C20 "old-format state exits 0"            "0"           "$RC"
wantnot C20 "old-format cache never renders green" "$GREENGLYPH" "$OUT"

# Anti-C22: BLIND and UNOBSERVABLE must never wear the red alarm's colour.
new_case
NO_COLOR_OVERRIDE=""
OUT="$(env CI_WATCH_LIST="$LIST" CI_WATCH_STATE="$STATE" CI_WATCH_GH="$D/http-stub" \
        CI_WATCH_SELFTEST_STUB="$STUB" CI_WATCH_SELFTEST_BSTUB="$BSTUB" CI_WATCH_SELFTEST_RSTUB="$RSTUB" CI_WATCH_SELFTEST_DSTUB="$DSTUB" "$TOOL" 2>&1)"
stub_runs 403 '{"message":"Resource not accessible by integration","status":"403"}'
OUT="$(env CI_WATCH_LIST="$LIST" CI_WATCH_STATE="$STATE" CI_WATCH_GH="$D/http-stub" \
        CI_WATCH_SELFTEST_STUB="$STUB" CI_WATCH_SELFTEST_BSTUB="$BSTUB" CI_WATCH_SELFTEST_RSTUB="$RSTUB" CI_WATCH_SELFTEST_DSTUB="$DSTUB" "$TOOL" 2>&1)"
wantnot "AntiC22" "BLIND does not use the red escape code" "$REDCODE" "$OUT"
# TWIN: a real red MUST use it, or the assertion is vacuous.
new_case
stub_runs 200 '{"total_count":1,"workflow_runs":[{"conclusion":"failure","status":"completed","head_sha":"f","html_url":"u"}]}'
OUT="$(env CI_WATCH_LIST="$LIST" CI_WATCH_STATE="$STATE" CI_WATCH_GH="$D/http-stub" \
        CI_WATCH_SELFTEST_STUB="$STUB" CI_WATCH_SELFTEST_BSTUB="$BSTUB" CI_WATCH_SELFTEST_RSTUB="$RSTUB" CI_WATCH_SELFTEST_DSTUB="$DSTUB" "$TOOL" 2>&1)"
want "AntiC22" "TWIN a real red DOES use the red escape code" "$REDCODE" "$OUT"

# Anti-C23: seeing a red never clears it.
new_case
stub_runs 200 '{"total_count":1,"workflow_runs":[{"conclusion":"failure","status":"completed","head_sha":"f","html_url":"u"}]}'
run_watch CI_WATCH_NOW=1000000000
run_watch CI_WATCH_NOW=1000000060
want "AntiC23" "red survives being seen twice" "RED" "$OUT"

# ===========================================================================
# C32 -- coverage map. Printed, cross-checkable, never self-asserted.
# ===========================================================================
printf '\ncoverage map (C32)\n'
EXPECT="C1 C2 C3 C4 C5 C6 C7 C8 C9 C10 C11 C12 C13 C14 C15 C16 C17 C18 C19 C20 C24 C25 C26 C27 C28 C29 C30 C31 C33 C34 C35 C36 C37 C38 C39 C40 C41 C42 C43 AntiC22 AntiC23"
missing=""
for c in $EXPECT; do
    hit=0
    for seen in "${COVERED[@]}"; do [ "$seen" = "$c" ] && { hit=1; break; }; done
    [ "$hit" -eq 1 ] || missing="$missing $c"
done
if [ -n "$missing" ]; then
    printf '  FAIL C32     claims with no case:%s\n' "$missing"; FAIL=$((FAIL+1))
else
    printf '  ok   C32     all %s claims have at least one case\n' "$(printf '%s\n' $EXPECT | wc -l | tr -d ' ')"
    PASS=$((PASS+1))
fi

printf '\n%s passed, %s failed   (fixtures: %s)\n' "$PASS" "$FAIL" "$ROOT"
[ "$FAIL" -eq 0 ] || exit 1
exit 0
