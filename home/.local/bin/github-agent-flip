#!/usr/bin/env bash
# github-agent-flip: moves one repo onto the shared GitHub App system.
#
# Two things happen, and only these two:
#
#   1. 'origin' is rewritten from its SSH URL to the plain HTTPS one.
#   2. ONE key, githubagent.tier, is written into this repo's own .git/config,
#      saying which of the pooled tier Apps it belongs to.
#
# github-agent-token is registered as git's credential helper ONCE, globally,
# for all of https://github.com (see ~/.gitconfig-githubagent). git only ever
# invokes a credential helper for an http(s) remote, so an untouched SSH repo
# never triggers it. Step 1 is what opts a repo in; step 2 is what tells the
# helper which App to use, because nothing in this system guesses that.
#
# Everything else about a tier -- App ID, Infisical path, client ID, Keychain
# service -- lives once per tier in global config, never per repo, so rotating
# a tier's credentials is one edit in one file.
#
# Usage:
#   github-agent-flip [path-to-repo]                  ask which tier, confirm, verify
#   github-agent-flip --tier medium-value .           say the tier up front
#   github-agent-flip -y --tier low-value ~/code/foo  no prompts (agent use)
#   github-agent-flip --no-verify .                   skip the post-flip proof
#
# Idempotent: re-running on an already-flipped repo leaves the URL alone and
# just reports (or fixes) its tier.
#
# By default this asks before changing anything, meant to be run by a human,
# live, watching the prompt. -y/--yes skips that prompt for the one case where
# that's appropriate: an agent running it after the human has ALREADY said
# go-ahead in the same conversation. The before/after values print either way,
# so there is always a visible record of exactly what changed.
#
# VERIFICATION, AND WHY -y TURNS IT OFF. The last step mints a real token for
# this repo and throws it away, purely to prove the App is actually installed
# here -- a flip that looks fine but fails on the next push is the main way
# this goes wrong. Minting pulls the App's private key into the running
# process, though, so -y (the agent path) implies --no-verify: the key is not
# something an agent's process should hold. Pass --verify alongside -y to
# override that deliberately.

set -euo pipefail

if [[ -t 1 ]] && [[ -z "${NO_COLOR:-}" ]]; then
	bold=$'\033[1m'; dim=$'\033[2m'; grn=$'\033[1;32m'; red=$'\033[1;31m'
	ylw=$'\033[1;33m'; cyn=$'\033[1;36m'; blu=$'\033[1;34m'; rst=$'\033[0m'
else
	bold=''; dim=''; grn=''; red=''; ylw=''; cyn=''; blu=''; rst=''
fi

die() {
	echo "${red}github-agent-flip:${rst} $*" >&2
	exit 1
}

auto_yes=false
verify=unset
tier=""
repo_dir="."

while [[ $# -gt 0 ]]; do
	case "$1" in
	-y | --yes) auto_yes=true ;;
	--tier)
		[[ $# -ge 2 ]] || die "--tier needs a value"
		tier="$2"
		shift
		;;
	--tier=*) tier="${1#--tier=}" ;;
	--verify) verify=true ;;
	--no-verify) verify=false ;;
	-h | --help)
		sed -n '2,45p' "$0" | sed 's/^# \{0,1\}//'
		exit 0
		;;
	-*) die "unknown option '$1'" ;;
	*) repo_dir="$1" ;;
	esac
	shift
done

# -y is the agent path, and minting a token there would put the App's private
# key in an agent's process. Default it off; --verify overrides on purpose.
if [[ "$verify" == unset ]]; then
	if [[ "$auto_yes" == true ]]; then verify=false; else verify=true; fi
fi

git -C "$repo_dir" rev-parse --git-dir &>/dev/null ||
	die "'$repo_dir' is not a git repository"

# ---------------------------------------------------------------------------
# Which tiers exist? Read them out of config rather than hardcoding a list, so
# adding a fourth tier is a config edit and nothing else. A tier is any
# [githubagent "<name>"] block that carries an appId -- which is exactly what
# excludes the two PAT profiles, since PATs mint nothing and have no App.
# ---------------------------------------------------------------------------
tiers=()
while IFS= read -r t; do
	[[ -n "$t" ]] && tiers+=("$t")
done < <(git -C "$repo_dir" config --get-regexp '^githubagent\..+\.appid$' 2>/dev/null |
	awk '{print $1}' | awk -F. '{print $2}' | sort -u)

[[ ${#tiers[@]} -gt 0 ]] ||
	die "no tiers are configured. Is the [githubagent \"<tier>\"] block missing from ~/.gitconfig-githubagent?"

tier_is_known() {
	local candidate="$1" t
	for t in "${tiers[@]}"; do
		[[ "$t" == "$candidate" ]] && return 0
	done
	return 1
}

tier_description() {
	git -C "$repo_dir" config --get "githubagent.$1.description" 2>/dev/null || true
}

# ---------------------------------------------------------------------------
# Current state
# ---------------------------------------------------------------------------
current_url="$(git -C "$repo_dir" remote get-url origin)"
current_tier="$(git -C "$repo_dir" config --local --get githubagent.tier 2>/dev/null || true)"

already_flipped=false
[[ "$current_url" == https://x-access-token@github.com/* ]] && already_flipped=true

if [[ "$already_flipped" == true ]]; then
	new_url="$current_url"
else
	url_no_git="${current_url%.git}"
	# Extract OWNER/REPO regardless of transport: https://github.com/OWNER/REPO,
	# git@github.com:OWNER/REPO, or a local SSH alias like git-cc:OWNER/REPO.
	if [[ "$url_no_git" == *"://"* ]]; then
		path="${url_no_git#*://}"
		path="${path#*/}" # drop the host
	else
		path="${url_no_git#*:}" # scp-like [user@]host:OWNER/REPO
	fi
	owner="${path%%/*}"
	repo="${path#*/}"
	[[ -n "$owner" && -n "$repo" && "$owner" != "$repo" ]] ||
		die "could not parse OWNER/REPO out of origin '$current_url'"
	new_url="https://x-access-token@github.com/${owner}/${repo}.git"
fi

# ---------------------------------------------------------------------------
# Which tier?
# ---------------------------------------------------------------------------
if [[ -n "$tier" ]]; then
	tier_is_known "$tier" ||
		die "unknown tier '$tier'. Configured tiers: ${tiers[*]}"
elif [[ -n "$current_tier" ]]; then
	tier="$current_tier"
	tier_is_known "$tier" ||
		die "this repo is already set to tier '$tier', which no longer exists in config. Configured tiers: ${tiers[*]}"
elif [[ "$auto_yes" == true ]]; then
	die "-y given but this repo has no tier set and --tier wasn't passed -- nothing here guesses a tier. Configured tiers: ${tiers[*]}"
else
	echo "${cyn}Which tier does this repo belong to?${rst}"
	echo "${dim}  All tiers hold identical permissions. The tier decides which repos are"
	echo "  pooled behind one App, so a compromise is contained to that pool.${rst}"
	echo
	# Pad the tier names to the widest one so the descriptions line up.
	width=0
	for t in "${tiers[@]}"; do
		[[ ${#t} -gt $width ]] && width=${#t}
	done
	i=1
	for t in "${tiers[@]}"; do
		desc="$(tier_description "$t")"
		printf '  %s) %s%-*s%s  %s%s%s\n' "$i" "$blu" "$width" "$t" "$rst" "$dim" "$desc" "$rst"
		i=$((i + 1))
	done
	read -r -p "  Pick 1-${#tiers[@]} (anything else aborts): " pick
	[[ "$pick" =~ ^[0-9]+$ ]] && [[ "$pick" -ge 1 ]] && [[ "$pick" -le ${#tiers[@]} ]] ||
		die "aborted, nothing changed."
	tier="${tiers[$((pick - 1))]}"
	echo
fi

# ---------------------------------------------------------------------------
# Show, confirm, apply
# ---------------------------------------------------------------------------
# Nothing to change -- but DON'T exit here. Fall through to the live check, so
# that re-running this on an already-correct repo doubles as "is this still
# working?", which is the question you actually have when you re-run it.
nothing_to_change=false
if [[ "$already_flipped" == true && "$current_tier" == "$tier" ]]; then
	nothing_to_change=true
	echo "${grn}Already flipped, and already on tier ${blu}${tier}${rst}${grn}. Nothing to change.${rst}"
	printf '  origin: %s\n' "$current_url"
fi

if [[ "$nothing_to_change" == false ]]; then
	echo "${cyn}About to change:${rst}"
	if [[ "$already_flipped" == true ]]; then
		printf '  %-8s %s %s\n' "origin" "$current_url" "${dim}(already flipped, unchanged)${rst}"
	else
		printf '  %-8s before: %s\n' "origin" "$current_url"
		printf '  %-8s after:  %s%s%s\n' "" "$blu" "$new_url" "$rst"
	fi
	printf '  %-8s before: %s\n' "tier" "${current_tier:-(not set)}"
	printf '  %-8s after:  %s%s%s  %s%s%s\n' "" "$blu" "$tier" "$rst" "$dim" "$(tier_description "$tier")" "$rst"
	echo

	if [[ "$auto_yes" == false ]]; then
		read -r -p "  Proceed? [y/N] " confirm
		[[ "$confirm" == "y" || "$confirm" == "Y" ]] || die "aborted, nothing changed."
	else
		echo "  ${ylw}(--yes given, proceeding without an interactive prompt)${rst}"
	fi

	[[ "$already_flipped" == true ]] || git -C "$repo_dir" remote set-url origin "$new_url"
	git -C "$repo_dir" config --local githubagent.tier "$tier"

	# Don't just trust the commands succeeded -- read both back and prove them.
	actual_url="$(git -C "$repo_dir" remote get-url origin)"
	actual_tier="$(git -C "$repo_dir" config --local --get githubagent.tier)"
	[[ "$actual_url" == "$new_url" ]] ||
		die "set the remote but the read-back doesn't match -- got '$actual_url'"
	[[ "$actual_tier" == "$tier" ]] ||
		die "set the tier but the read-back doesn't match -- got '$actual_tier'"

	echo
	echo "${grn}Done, verified by reading both back:${rst}"
	printf '  origin: %s\n' "$actual_url"
	printf '  tier:   %s%s%s\n' "$blu" "$actual_tier" "$rst"
	if [[ "$already_flipped" == true ]]; then
		echo "Only this repo's tier changed; its remote and everything else are untouched."
	else
		echo "Its old SSH-based remote is gone; nothing else on this machine was touched."
	fi
fi

# ---------------------------------------------------------------------------
# Prove it actually works (see the header for why -y turns this off)
# ---------------------------------------------------------------------------
if [[ "$verify" == false ]]; then
	echo
	echo "${dim}Skipped the live check (--no-verify, or implied by -y). Nothing has yet"
	echo "proven the ${tier} App is installed on this repo -- the next push will.${rst}"
	exit 0
fi

echo
echo "${cyn}Checking the ${blu}${tier}${rst}${cyn} App is really installed on this repo...${rst}"
echo "${dim}  (mints one real token and discards it; the token is never printed)${rst}"

if (cd "$repo_dir" && github-agent-token token >/dev/null); then
	echo "${grn}[OK]${rst} A real token minted for this repo. It's genuinely wired up."
else
	echo
	echo "${red}[FAIL]${rst} The repo's settings are correct, but no token could be minted."
	echo "  The usual cause: the ${blu}${tier}${rst} App isn't installed on this repo yet."
	echo "  Install it, then re-run this command to re-check:"
	echo "    ${dim}github-agent-flip --tier ${tier} ${repo_dir}${rst}"
	exit 1
fi
