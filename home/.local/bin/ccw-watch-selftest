#!/usr/bin/env bash
# ============================================================================
#  ccw-watch-selftest -- proves the narrowed capture-presence watcher
# ============================================================================
# WRITTEN BEFORE THE TOOL IT TESTS, 2026-09-07. The narrowing threw away a
# 346-line suite of 37 cases that almost all exercised the `ccw doctor` prose
# parser and the timeout wrapped around it. Deleting well-tested code and
# shipping less-tested code is the one way a narrowing can quietly make things
# worse, so the cases came first and the tool was written to satisfy them.
#
# Every case here maps to a red-team finding (R1..R12) or to behaviour carried
# over from the doctor era that must not have been lost in the move.
#
# THE FIXTURE'S NARROWED PATH IS LOAD-BEARING, TWICE OVER.
#   1. ccw-watch resolves "$HOME/.local/bin/ccw" BEFORE consulting PATH, so
#      overriding HOME alone does NOT isolate the test -- the "absent ccw"
#      case falls through to the operator's real ccw and reports on the real
#      machine. A test that reaches the real install is not a test. (R11)
#   2. Excluding Homebrew's bin means `timeout` is absent and `python3` is
#      /usr/bin/python3 3.9.6 -- which is what a stock Mac actually has. Both
#      fallback branches get exercised for free.
# ============================================================================

set -uo pipefail

TOOL="${CCW_WATCH_TOOL:-$(dirname "$0")/ccw-watch}"
[ -x "$TOOL" ] || { printf 'selftest: cannot find ccw-watch at %s\n' "$TOOL" >&2; exit 2; }

PASS=0; FAIL=0
ROOT="$(mktemp -d "${TMPDIR:-/tmp}/ccw-watch-selftest.XXXXXX")"   # bare mktemp -d ignores TMPDIR on BSD
# NOT cleaned up on purpose: deleting it would route through the Trash wrapper and
# fill the Trash with fixture trees every run. The OS reaps TMPDIR; the path is
# printed at the end so a failing case can be inspected.

ok(){   PASS=$((PASS+1)); printf '  ok   %s\n' "$1"; }
bad(){  FAIL=$((FAIL+1)); printf '  FAIL %s\n     want: %s\n     got : %s\n' "$1" "$2" "$3"; }

want(){ # want <name> <needle> <haystack>
    case "$3" in *"$2"*) ok "$1";; *) bad "$1" "contains: $2" "$(printf '%s' "$3" | tr '\n' '|')";; esac
}
wantnot(){
    case "$3" in *"$2"*) bad "$1" "must NOT contain: $2" "$(printf '%s' "$3" | tr '\n' '|')";; *) ok "$1";; esac
}
wanteq(){ [ "$2" = "$3" ] && ok "$1" || bad "$1" "$2" "$3"; }

# ---- fixture ---------------------------------------------------------------
# Builds a complete fake machine. Every knob defaults to the HEALTHY value, so
# each case states only the thing it is breaking.
PLUGIN_ID="cc-capture@cc-warehouse"

fixture(){ # fixture <name> [ccw_mode] [version] [enabled] [registry] [pathmode]
    FX="$ROOT/$1"; mkdir -p "$FX/.local/bin" "$FX/.claude/plugins" "$FX/state"
    local ccw_mode="${2:-ok}" version="${3:-0.1.2}" enabled="${4:-true}"
    local registry="${5:-ok}" pathmode="${6:-exists}"

    case "$ccw_mode" in
        absent) : ;;
        noexec) printf '#!/bin/sh\nexit 0\n' > "$FX/.local/bin/ccw"; chmod 644 "$FX/.local/bin/ccw" ;;
        fails)  printf '#!/bin/sh\nexit 1\n' > "$FX/.local/bin/ccw"; chmod 755 "$FX/.local/bin/ccw" ;;
        hangs)  printf '#!/bin/sh\nsleep 300\n' > "$FX/.local/bin/ccw"; chmod 755 "$FX/.local/bin/ccw" ;;
        junk)   printf '#!/bin/sh\necho "not a version at all"\n' > "$FX/.local/bin/ccw"; chmod 755 "$FX/.local/bin/ccw" ;;
        *)      printf '#!/bin/sh\necho "%s"\n' "$version" > "$FX/.local/bin/ccw"; chmod 755 "$FX/.local/bin/ccw" ;;
    esac

    local cache="$FX/.claude/plugins/cache/cc-warehouse/cc-capture/2609b3759477"
    [ "$pathmode" = exists ] && mkdir -p "$cache"

    case "$enabled" in
        true)    printf '{"enabledPlugins":{"%s":true}}\n'  "$PLUGIN_ID" > "$FX/.claude/settings.json" ;;
        false)   printf '{"enabledPlugins":{"%s":false}}\n' "$PLUGIN_ID" > "$FX/.claude/settings.json" ;;
        missing) printf '{"enabledPlugins":{"some-other@thing":true}}\n' > "$FX/.claude/settings.json" ;;
        nofile)  : ;;
        junk)    printf '{ this is not json\n' > "$FX/.claude/settings.json" ;;
    esac

    local reg="$FX/.claude/plugins/installed_plugins.json"
    case "$registry" in
        ok)     printf '{"version":1,"plugins":{"%s":[{"scope":"user","installPath":"%s"}]}}\n' "$PLUGIN_ID" "$cache" > "$reg" ;;
        flat)   printf '{"%s":[{"scope":"user","installPath":"%s"}]}\n' "$PLUGIN_ID" "$cache" > "$reg" ;;
        two)    mkdir -p "$FX/second-copy"
                printf '{"version":1,"plugins":{"%s":[{"scope":"user","installPath":"%s/gone"},{"scope":"project","installPath":"%s/second-copy"}]}}\n' \
                       "$PLUGIN_ID" "$FX" "$FX" > "$reg" ;;
        noent)  printf '{"version":1,"plugins":{"other@thing":[{"installPath":"/tmp"}]}}\n' > "$reg" ;;
        nofile) : ;;
        junk)   printf 'not json at all\n' > "$reg" ;;
    esac
    printf '%s' "$FX"
}

run(){ # run <fixture-dir> [args...] ; sets OUT and RC
    local fx="$1"; shift
    OUT="$(env -i \
        HOME="$fx" \
        PATH="$fx/.local/bin:/usr/bin:/bin" \
        TERM=dumb NO_COLOR=1 \
        CCW_WATCH_STATE="$fx/state" \
        CCW_WATCH_DEBUG=1 \
        ${CCW_NOW:+CCW_WATCH_NOW="$CCW_NOW"} \
        ${CCW_VTO:+CCW_WATCH_VERSION_TIMEOUT="$CCW_VTO"} \
        /bin/bash "$TOOL" "$@" 2>&1)"
    RC=$?
}

printf '\nccw-watch selftest -- narrowed presence watcher\n\n'

# ---------------------------------------------------------------- healthy ---
printf 'HEALTHY PATH\n'
FX=$(fixture healthy); run "$FX"
want   '01 healthy says OK'                  'OK'                    "$OUT"
want   '02 healthy names what it verified'   'capture installed'     "$OUT"
wantnot '03 healthy claims no pending count' 'session(s) pending'    "$OUT"
wanteq '04 healthy exits 0'                  0 "$RC"

FX=$(fixture quiet); run "$FX" --quiet
wanteq '05 --quiet prints no OK line when healthy' 0 "$(printf '%s' "$OUT" | grep -c 'OK')"

# ------------------------------------------------------------ ccw missing ---
printf '\nTHE ccw BINARY (R3, R11)\n'
FX=$(fixture noccw absent); run "$FX"
want   '06 absent ccw escalates'             'capture is NOT working' "$OUT"
want   '07 absent ccw names itself'          'ccw is not installed'   "$OUT"
wantnot '08 absent ccw did NOT reach the real install' 'capture installed' "$OUT"
wanteq '09 absent ccw still exits 0'         0 "$RC"

FX=$(fixture noexec noexec); run "$FX"
want   '10 non-executable ccw reads as absent' 'ccw is not installed' "$OUT"

FX=$(fixture broken fails); run "$FX"
want   '11 ccw that will not run escalates'  'will not run'           "$OUT"

FX=$(fixture junkver junk); run "$FX"
want   '12 unreadable version is UNVERIFIED, not BROKEN' 'UNVERIFIED' "$OUT"
wantnot '13 unreadable version does not claim capture stopped' 'capture is NOT working' "$OUT"

CCW_VTO=3 FX=$(fixture hang hangs)
start=$(date +%s); CCW_VTO=3 run "$FX"; elapsed=$(( $(date +%s) - start ))
want   '14 hanging ccw times out'            'did not respond'        "$OUT"
[ "$elapsed" -lt 15 ] && ok "15 hang returned in ${elapsed}s, not 300" \
                       || bad '15 hang bounded' 'under 15s' "${elapsed}s"
unset CCW_VTO

# ------------------------------------------------------------------ floor ---
printf '\nTHE PINNED FLOOR (R3)\n'
FX=$(fixture old ok 0.1.1); run "$FX"
want   '16 below floor escalates'            'below the pinned floor' "$OUT"
FX=$(fixture atfloor ok 0.1.2); run "$FX"
want   '17 exactly at floor is healthy'      'OK'                     "$OUT"
FX=$(fixture above ok 0.2.0); run "$FX"
want   '18 above floor is healthy'           'OK'                     "$OUT"

# --------------------------------------------------------- enabledPlugins ---
printf '\nIS THE PLUGIN SWITCHED ON (R2)\n'
FX=$(fixture nosettings ok 0.1.2 nofile); run "$FX"
want   '19 missing settings.json is UNVERIFIED' 'UNVERIFIED'          "$OUT"
want   '20 missing settings.json says what it could not read' 'cannot read' "$OUT"

FX=$(fixture junksettings ok 0.1.2 junk); run "$FX"
want   '21 malformed settings.json is UNVERIFIED, never BROKEN' 'UNVERIFIED' "$OUT"

FX=$(fixture notenabled ok 0.1.2 false); run "$FX"
want   '22 plugin false escalates as broken' 'not enabled'            "$OUT"
FX=$(fixture keyabsent ok 0.1.2 missing); run "$FX"
want   '23 plugin key absent escalates as broken' 'not enabled'       "$OUT"

# ------------------------------------------------------------- registry ----
printf '\nIS THE PLUGIN ACTUALLY THERE (R1, R4, R8)\n'
FX=$(fixture noreg ok 0.1.2 true nofile); run "$FX"
want   '24 missing registry is UNVERIFIED'   'UNVERIFIED'             "$OUT"
FX=$(fixture junkreg ok 0.1.2 true junk); run "$FX"
want   '25 malformed registry is UNVERIFIED' 'UNVERIFIED'             "$OUT"
FX=$(fixture noentry ok 0.1.2 true noent); run "$FX"
want   '26 no registry entry escalates'      'not installed'          "$OUT"

FX=$(fixture ghost ok 0.1.2 true ok missing); run "$FX"
want   '27 R1: enabled+registered but copy GONE is broken' 'MISSING from disk' "$OUT"
wantnot '28 R1: and it does NOT report healthy' 'OK '                 "$OUT"

FX=$(fixture twoscopes ok 0.1.2 true two); run "$FX"
want   '29 R4: second scope satisfies it'    'OK'                     "$OUT"

FX=$(fixture flatreg ok 0.1.2 true flat); run "$FX"
want   '30 R8: key found at a different nesting depth' 'OK'           "$OUT"

# ---------------------------------------------------------- escalation -----
printf '\nESCALATION, VOICE, SNOOZE (carried over from the doctor era)\n'
FX=$(fixture tiers absent)
CCW_NOW=1000000 run "$FX"
want   '31 tier 1 banner'                    'capture is NOT working' "$OUT"
want   '32 voice fires on the transition'    '[voice]'                "$OUT"
CCW_NOW=1000000 run "$FX"
wantnot '33 voice does NOT fire twice at tier 1' '[voice]'            "$OUT"
CCW_NOW=$((1000000 + 3*86400)) run "$FX"
want   '34 tier 2 boxed banner carries the headline' 'CAPTURE IS NOT WORKING -- 3 DAYS' "$OUT"
want   '35 tier 2 speaks again'              '[voice]'                "$OUT"
CCW_NOW=$((1000000 + 8*86400)) run "$FX"
want   '36 tier 3 strongest banner'          '###'                    "$OUT"
unset CCW_NOW

FX=$(fixture snooze absent)
CCW_NOW=1000000 run "$FX"
CCW_NOW=1000000 run "$FX" --snooze 2
CCW_NOW=$((1000000 + 86400)) run "$FX"
want   '37 snooze silences the banner'       'snoozed'                "$OUT"
CCW_NOW=$((1000000 + 5*86400)) run "$FX"
wantnot '38 snooze expires'                  'snoozed'                "$OUT"
want   '38b and tier 2 keeps the BROKEN headline, not a generic one' 'CAPTURE IS NOT WORKING' "$OUT"
unset CCW_NOW

FX=$(fixture badsnooze absent); run "$FX" --snooze banana
wanteq '39 non-numeric snooze is refused'    2 "$RC"

FX=$(fixture unvertier ok 0.1.2 junk)
CCW_NOW=1000000 run "$FX"
CCW_NOW=$((1000000 + 4*86400)) run "$FX"
want   '36b R2: an aged UNVERIFIED keeps its own headline' 'CAPTURE IS UNVERIFIED' "$OUT"
wantnot '36c R2: and never claims capture stopped' 'NOT WORKING'      "$OUT"
unset CCW_NOW

# ------------------------------------------------------- state schema (R5) --
printf '\nSTATE SCHEMA (R5)\n'
FX=$(fixture oldstate absent)
printf 'last=broken\nred_since=1\nsnooze_until=0\n' > "$FX/state/capture.state"
CCW_NOW=$((1 + 40*86400)) run "$FX"
wantnot '40 a doctor-era clock does NOT arrive at tier 3' '###'       "$OUT"
want    '41 and the reset is announced once' 'escalation clock reset' "$OUT"
unset CCW_NOW

# ------------------------------------------------------------ never fatal ---
printf '\nNEVER FATAL\n'
allzero=yes
for m in absent noexec fails junk ok; do
    FX=$(fixture "nf-$m" "$m"); CCW_VTO=3 run "$FX"
    [ "$RC" -eq 0 ] || allzero="no ($m -> $RC)"
done
wanteq '42 every failure mode still exits 0' yes "$allzero"

printf '\nfixtures: %s\n' "$ROOT"
printf '%s passed, %s failed\n\n' "$PASS" "$FAIL"
[ "$FAIL" -eq 0 ]
