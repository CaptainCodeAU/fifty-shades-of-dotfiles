#!/usr/bin/env bash
# pj-start-card -- the 20-line start card every pj session opens with (D-20260920-04).
#
# Usage:
#   pj-start-card              print the card for the folder you are standing in
#   pj-start-card --json       the same facts as ONE JSON object (schema 1, below), for the
#                              start-card mod (W-20260923-A11, D-20260927-A13). Reads no stdin.
#   pj-start-card --selftest   prove every arm (runs pj-start-card-selftest)
#
# Registered as a SessionStart hook for pj through settings/claude/hooks.json
# (targets: project). Claude Code hands the hook a JSON object on stdin; the card
# prints on source startup, resume and clear, and stays silent on compact.
#
# CONTRACT, in order of importance:
#   1. exit 0 on EVERY path. A start hook that fails blocks a session.
#   2. writes NOTHING. Not the project, not the drawer, not a state folder.
#   3. no network, no prompt, well under a second.
#   4. at most 20 lines; every path is a root marker (repo:, drawer:, ~/), never
#      an absolute drawer path, so the output can be quoted in a public repo.
#   5. on an internal error a SECTION drops out; on a catastrophic one the whole
#      card does. Silence is the failure mode, by design, so a broken card can
#      never stop a session.
#
# WHAT IT PRINTS
#   line 1   pj start card: <project>
#   line 2   WARNING when the last session here ended without wrap-up (flag below)
#   then     open items from `open-items --session`: count (and "N pinned" when any item's
#            when: begins "next session"), up to 10 titles with pinned ones FIRST,
#            "+N more", "parked: N"; or one line saying there is no drawer, or, when pj-homes
#            says records: engage, one line pointing at engage instead
#   then     the cross-project lines from the same call (A16, W-20260923-A28): Watching,
#            Checks owed, Mandatory, Moved out, Ignored lines (each a count line plus up to
#            3 titles), then Inbox and notes. Only when non-empty. Own titles keep a floor
#            of 5 before any cross title (P8). The card never runs a check-script (P3).
#   then     Owed: <command> -- one line per project wrap-up command not finished at /pj:wrap-up
#            (W5, D-20260925-A01), only while owed/<key> holds a record; at most OWED_CAP
#            lines, the last one "+N more" when there are more. See THE OWED RECORD below
#   then     Handoff: <marker path> (size, date) -- only when the file exists
#   then     Tracker: <marker path>, one per declared tracker
#   then     dot-claude: N commit(s) behind origin -- ONLY when behind, never when level
#            (refs only, no network; `pj` kicks the detached fetch that fills them)
#   then     Mods API: (N) unseen change(s) -- ONLY when a Claude Code update changed the
#            mods API and Gavin has not said "seen" (`mods-api-drift --card`, read-only;
#            D-20260923-A06). Also one line when the drift check itself is NOT MEASURED
#   then     Rules copy edited on this machine: N path(s) in ~/repos/pj-rules (...) -- ONLY
#            on a relay-fed machine whose copy has local edits (pj-health's rules-copy row
#            holds the fix; 2026-09-29). Silent when clean, and on the Mac, which has no copy
#   then     Temp sweep ... -- ONE line, only when pj's launcher swept, left or failed something
#            at this launch (W-20260929-A155). pj runs `pj-temp sweep-dead` before claude starts
#            and exports its one-line summary as PJ_TEMP_SWEPT; the card only reads that
#            variable, so it still writes nothing. Printed on startup and resume, not on clear
#            (the same process, so it would repeat), and not in --json yet
#   last     the hello rule
#   Outside a git repo: line 1, the rules-copy line when it shows, and the hello rule.
#
# THE DECLARATION FILE  .claude/pj-homes  (D-20260920-06)
#   key: value lines, # comments. Keys: handoff, tracker (may repeat), decisions,
#   incidents, plans, records (repo|private|engage), wrap-up, panel. Defaults for a
#   missing key: handoff repo:OPENING-PROMPT.md, records repo, decisions/incidents/plans
#   under repo:docs/ (or drawer: when records is private). The card reads handoff, tracker,
#   panel and records; the other keys are for later stages and `decided`.
#
#   records: engage   the project's items are engage records (engage decision #1036), not
#             a drawer. With no drawer the card prints "kept as engage records" instead of
#             the `open-items init` hint, which would start a second list. A drawer that
#             exists is still shown as usual. --json is unchanged: items.drawer is "none".
#
#   panel: <names>   the start-card mod's /card panel sections, in this order (D-20260927-A13).
#             Names separated by commas or spaces, from: items parked handoff rulings flags
#             mods-api. `ci` is reserved: accepted, listed under unknown until it exists.
#             Any other name is listed under unknown, never dropped, so the panel can say
#             "unknown section: <name>". A name given twice counts once. No panel: line
#             means AUTOMATIC: every section whose source has something (items when any
#             are open, parked when any are parked, handoff when the file exists, flags
#             when any, mods-api when a change is unseen). Automatic never picks rulings,
#             because the card does not read `decided` (see rulings below). `panel:` with
#             nothing after it is an explicitly empty panel. Written twice: the FIRST line
#             is used, like every single-valued key here, and panel.duplicates counts the rest.
#             Only the JSON carries it; the text card prints nothing for it.
#
# THE NO-WRAP-UP FLAG  (contract for the SessionEnd stage; the card only READS it)
#   Location  ${XDG_STATE_HOME:-~/.local/state}/pj/no-wrap-up/<key>
#             <key> = the repo toplevel with every / . _ turned into -, the same
#             encoding the harness uses for ~/.claude/projects/<key>/ and that
#             open-items uses for the drawer. Outside every repo on purpose.
#   Format    one RECORD per unwrapped session, NEWEST FIRST, a blank line between
#             (P5.3). Each record: key: value lines: project, repo, ended (local
#             time), session, transcript, messages, edits. Any other line ignored.
#   Writer    pj-session-end, the SessionEnd hook, only when /pj:wrap-up did not run.
#   Clearer   pj-wrap done (moves it aside, never deletes). This card never writes.
#   Reader    ONE line from the first record's ended and transcript, plus the count
#             of records when there is more than one. A flag that exists but cannot
#             be read still prints the warning, without details.
#   Override  PJ_STATE_DIR replaces the .../pj part (selftest seam).
#
# THE OWED RECORD  (W5; the state contract is docs/PJ_WRAP_UP.md; the card only READS it)
#   Location  <state>/owed/<key>, the same <key> as the flag above.
#   Format    records separated by a blank line: owed: <command>, project: <name>,
#             session: <id>, since: YYYY-MM-DD HH:MM. The card reads owed and since only.
#   Writer    pj-wrap done --owed. Clearers: pj-wrap owed --clear, pj-session-end (both
#             MOVE the file to owed/handled/). This card never writes.
#   Reader    one line per DISTINCT command, oldest since, in file order:
#               Owed: <command> (since <date>, not finished at wrap-up). Run it, or 'pj-wrap owed --clear'.
#             The command is DATA (P7): controls and bidi/zero-width marks become ?, and it is
#             capped at OWED_CMD_LEN characters, the rule open-items applies to item titles.
#             A file with no owed: line is silent. A file that exists but cannot be read
#             prints one line saying so, without details, like the flag above.
#
# --json  (W-20260923-A11, D-20260927-A13; the start-card mod reads it)
#   ONE computation: gather() reads everything once, then render_text() or render_json()
#   prints it, so the two views cannot drift. The text card is byte-identical to what it was
#   before --json existed (Claude's copy unchanged, Gavin's ruling). The CONTRACT above holds
#   for --json too, except point 4 (a JSON object is not 20 lines) and point 5: on an internal
#   error the object still parses and `errors` names what dropped out. No stdin is read, so a
#   caller holding a pipe open cannot hang it. PJ_NO_CARD does not silence it; `no_card` says
#   it is set and the mod decides. Built by bash and awk alone: jq is never called, and the
#   whole object passes through `iconv -c` so it is valid UTF-8 even when a title is not.
#   Every string from a drawer or a flag file is DATA: controls, DEL, bidi and zero-width
#   marks become ?, exactly as the text card shows them.
#
#   SCHEMA 1 (a field is never missing; absent things are null, 0, false or []):
#   {
#     "schema": 1,
#     "project": "<repo name>",          outside a repo: the folder name
#     "in_repo": true | false,
#     "no_card": true | false,           PJ_NO_CARD is set
#     "wrap_up_warning": null | {"text": "<the WARNING line>", "records": N,
#                                "ended": "<local time>" | null, "transcript": "~/..." | null},
#     "items": null (outside a repo) | {
#       "drawer": "present" | "none" | "unknown",   unknown = open-items broken or absent
#       "open": N, "pinned": N, "parked": N,
#       "list": [ {"id": "W-..." | null, "title": "...", "pinned": true | false,
#                  "done_when": "..." | null, "when": "..." | null, "next": "..." | null} ],
#       "parked_list": [ {"id": "W-...", "title": "..."} ]   open-items' parked order; [] when
#                                        none parked or the read failed (errors says which)
#     },                                 list = EVERY own open item in the card's order, pinned
#                                        first, then ID order as open-items lists it (a byte
#                                        sort until W-20260924-A102). A field written on two
#                                        header lines is joined with one space. id and the
#                                        three fields are null when the detail read failed
#                                        (errors says so); titles and counts still come from
#                                        the card's own read.
#     "cross": {
#       "watching" | "checks_owed" | "mandatory" | "moved_out" | "ignored":
#           {"count": N, "line": "<header as open-items printed it>" | null,
#            "titles": ["<up to 3, as printed, without the leading '   · '>"]},
#       "inbox": N,                      unrouted items in the inbox
#       "notes": ["<Cross-project: / Repo: / Uncommitted move lines>"]
#     },
#     "owed": [ {"command": "...", "since": "YYYY-MM-DD" | "an unknown date"} ],   every
#                                        distinct command, uncapped, oldest since
#     "owed_unreadable": true | false,
#     "handoff": null | {"marker": "drawer:OPENING-PROMPT.md", "path": "/abs/path",
#                        "size": "3.1 KB", "bytes": N, "date": "YYYY-MM-DD"},
#                                        path is for the mod to read ON SCREEN only
#     "trackers": ["<marker>"],
#     "dot_claude_behind": N,            0 when level or not measurable
#     "mods_api": null (outside a repo) | {"unseen": N, "measured": true | false},
#     "flags": [ {"name": "no-wrap-up" | "owed" | "dot-claude-behind" | "mods-api" | "rules-copy",
#                 "text": "<the card's own line>"} ],   the card's OWN signals only (F1)
#     "panel": {"sections": ["items", ...], "source": "pj-homes" | "automatic",
#               "unknown": ["<name>"], "duplicates": N},
#     "errors": ["<section>: <what dropped out>"]
#   }
#   Rulings are NOT in schema 1: `decided --since <today>` took 469 to 602 ms here on
#   2026-09-27 against a 200 ms allowance, so the mod runs it itself for the rulings section.
#
# Selftest: pj-start-card-selftest. Rulings: D-20260920-02, -03, -04, -06, -09.

set -u

[ "${1:-}" = "--selftest" ] && exec "$(dirname "$0")/pj-start-card-selftest"
MODE=text; [ "${1:-}" = "--json" ] && MODE=json

CAP=20
TITLE_CAP=10
OWN_FLOOR=5      # P8 rule 3: this project's own titles before any cross-project title
HELLO='Hello rule: on a first message like hello or start, reply in two or three lines from this card, then ask what to work on. Anything a start hook flagged for action gets one read-only check that it still holds before you name it once at the top: a cached reading can predate the fix (D-20260927-A12).'
# ${HOME-}: under set -u an unset HOME killed the card HERE, before main, with exit 1 (CONTRACT
# point 1, measured on master 2026-09-27). Now a later read fails inside gather instead, and
# the card is silent (text) or answers with the internal-error object (--json).
STATE="${PJ_STATE_DIR:-${XDG_STATE_HOME:-${HOME-}/.local/state}/pj}"
OWED_CAP=3       # Owed: lines at most, a "+N more" line included
OWED_CMD_LEN=80

# --- hook input: print on startup/resume/clear, never on compact --------------
source_of_hook(){
  local in="" s=""
  [ -t 0 ] && { printf 'startup'; return; }
  in="$(cat 2>/dev/null || true)"
  [ -n "$in" ] || { printf 'startup'; return; }
  if command -v jq >/dev/null 2>&1; then
    s="$(printf '%s' "$in" | jq -r '.source // empty' 2>/dev/null || true)"
  else
    s="$(printf '%s' "$in" | sed -n 's/.*"source"[[:space:]]*:[[:space:]]*"\([a-z]*\)".*/\1/p' | head -1)"
  fi
  printf '%s' "${s:-startup}"
}

encode_key(){ printf '%s' "$1" | sed 's#[/._]#-#g'; }
strip_ansi(){ sed 's/\x1b\[[0-9;]*m//g'; }

# --- the declaration file -----------------------------------------------------
decl_get(){   # decl_get <file> <key>  -> first value, or nothing
  [ -f "$1" ] || return 0
  sed -n "s/^$2:[[:space:]]*//p" "$1" 2>/dev/null | sed 's/[[:space:]]*$//' | head -1
}
decl_all(){   # every value of a repeatable key
  [ -f "$1" ] || return 0
  sed -n "s/^$2:[[:space:]]*//p" "$1" 2>/dev/null | sed 's/[[:space:]]*$//'
}
# A marked path -> a real path. Unknown marker: nothing (never guess).
resolve(){    # resolve <marked> <top> <drawer>
  case "$1" in
    repo:*)   printf '%s/%s' "$2" "${1#repo:}" ;;
    drawer:*) [ -n "$3" ] && printf '%s/%s' "$3" "${1#drawer:}" ;;
    '~/'*)    printf '%s/%s' "$HOME" "${1#\~/}" ;;
    *)        return 1 ;;
  esac
}

file_size(){  # human size; GNU stat first, BSD fallback (memory: stat -f portability)
  local b
  b="$(stat -c %s "$1" 2>/dev/null || stat -f %z "$1" 2>/dev/null)" || return 1
  if [ "$b" -lt 1024 ]; then printf '%s B' "$b"; else awk -v b="$b" 'BEGIN{printf "%.1f KB", b/1024}'; fi
}
file_date(){
  local d
  if d="$(stat -c %y "$1" 2>/dev/null)"; then printf '%s' "${d:0:10}"
  else stat -f '%Sm' -t '%Y-%m-%d' "$1" 2>/dev/null; fi
}
mtime_epoch(){ stat -L -c %Y "$1" 2>/dev/null || stat -L -f %m "$1" 2>/dev/null || echo 0; }   # GNU first: on Linux -f means filesystem

# --- dot-claude freshness (P8a gate Q4) -----------------------------------------
# READS REFS ONLY. The card's contract forbids network (point 3) and writing (point 2), so
# it never fetches: `pj` kicks a DETACHED fetch at launch and does not wait, and this line
# reports what that fetch last brought back. Worst case the reading is one launch stale,
# which the age suffix states rather than hides.
#
# EXCEPTION-BASED, deliberately. Silent when level with origin. A line printed every session
# saying "up to date" is the passive, identical alert that teaches you to stop reading the
# card (alert-design-for-adhd), and the whole point of this line is to be noticed.
#
# It never pulls, and never suggests that pj should: dot-claude holds the drawer another
# session may be writing, and a pull at launch is exactly the concurrent-write hazard
# D-20260920-08 exists to keep out of the tooling.
sync_line(){
  local dc="${OPEN_ITEMS_DOTCLAUDE:-$HOME/.claude}" up behind fh m now age=""
  up="$(git -C "$dc" rev-parse --abbrev-ref --symbolic-full-name '@{u}' 2>/dev/null)" || return 0
  [ -n "$up" ] || return 0
  behind="$(git -C "$dc" rev-list --count "HEAD..$up" 2>/dev/null)" || return 0
  case "$behind" in ''|*[!0-9]*) return 0 ;; esac
  [ "$behind" -gt 0 ] || return 0
  fh="$dc/.git/FETCH_HEAD"
  if [ -f "$fh" ]; then
    m="$(mtime_epoch "$fh")"; now="$(date +%s 2>/dev/null || echo 0)"
    # >=, not >: a fetch that landed in THIS second is "0m ago", which is a fact worth
    # printing. With `>` the freshest possible reading was the one that said nothing about
    # its age, and the arm that checks for the age suffix failed roughly one run in two.
    if [ "$m" -gt 0 ] && [ "$now" -ge "$m" ]; then
      age=$(( (now - m) / 60 ))
      if [ "$age" -lt 90 ]; then age=", measured ${age}m ago"; else age=", measured $(( age / 60 ))h ago"; fi
    fi
  fi
  printf 'dot-claude: %s commit(s) behind %s%s. Pull it yourself when convenient; pj fetches but never pulls.' "$behind" "$up" "$age"
}

# The rules-copy line (FOLLOWUP-BRIEF T1/T2, 2026-09-29). A relay-fed machine gets pj's rules in
# ~/repos/pj-rules and links lead pj there, so an edit made THROUGH a link lands in the copy
# unnoticed and pj loads it; the relay's next push (updateInstead) is then refused. The same
# finding as pj-health's rules-copy row, which holds the fix. EXCEPTION-BASED like sync_line:
# silent when clean, when there is no copy (the Mac), and when the copy is not its own repo
# (pj-health says NOT MEASURED for that). --no-optional-locks keeps CONTRACT 2: a plain status
# may rewrite the copy's index. Seam: PJ_RULES_COPY.
# tilde <path>: $HOME at the front becomes ~. A prefix strip, never ${p/#$HOME/~}: bash 3.2 keeps
# the backslash of \~ and bash 5 tilde-expands a bare ~ back to $HOME (measured 2026-09-29).
tilde(){ case "$1" in "${HOME-}"|"${HOME-}"/*) [ -n "${HOME-}" ] && { printf '~%s' "${1#"$HOME"}"; return; } ;; esac; printf '%s' "$1"; }

rules_copy_line(){
  local rc="${PJ_RULES_COPY:-${HOME-}/repos/pj-rules}" top real out n eg
  [ -d "$rc" ] || return 0
  top="$(git -C "$rc" rev-parse --show-toplevel 2>/dev/null)" || return 0
  [ -n "$top" ] || return 0
  top="$( (builtin cd "$top" 2>/dev/null && pwd -P) )"; real="$( (builtin cd "$rc" 2>/dev/null && pwd -P) )"
  [ -n "$real" ] && [ "$top" = "$real" ] || return 0
  out="$(git --no-optional-locks -C "$rc" status --porcelain --untracked-files=all 2>/dev/null)" || return 0
  [ -n "$out" ] || return 0
  n="$(printf '%s\n' "$out" | grep -c .)"
  eg="$(printf '%s\n' "$out" | head -3 | cut -c4- | LC_ALL=C tr -d '\000-\037\177' | paste -sd, - | sed 's/,/, /g')"
  [ "$n" -gt 3 ] && eg="$eg, +$((n - 3)) more"
  printf "Rules copy edited on this machine: %s path(s) in %s (%s). pj loads them and the relay's next push is refused; 'pj-health' rules-copy row has the fix." "$n" "$(tilde "$rc")" "$eg"
}

# The mods API line (F8b, D-20260923-A06). mods-api-drift --card reads the saved reports and
# prints one line only when a Claude Code update changed the mods API and nobody has said
# "seen" yet. Read-only and local (it runs `claude --version`, 7 ms), so it keeps CONTRACT 2
# and 3. The count stays until Gavin clears it: that is his "keep unread".
mods_line(){
  local t="${PJ_MODS_API_DRIFT:-mods-api-drift}"
  command -v "$t" >/dev/null 2>&1 || return 0
  "$t" --card 2>/dev/null | head -1
}

# The owed lines (W5, D-20260925-A01). The command was typed in another session, so it is DATA
# and goes through the same clean() and cap() as open-items' cross-project titles (P7): one awk,
# byte-wise under LC_ALL=C, so every awk and locale agrees. A blank or whitespace-only line ends
# a record. A record without an owed: line is skipped, never guessed at.
# clean() and cap(): the card's rule for text that is DATA (P7), shared by the owed lines, the
# --json item detail and the panel names. clean() turns controls, DEL and the bidi and
# zero-width marks into ?; cap() cuts at m characters and adds ... (byte-wise, LC_ALL=C).
CLEAN_AWK='
  BEGIN {
    BAD["\342\200\252"]; BAD["\342\200\253"]; BAD["\342\200\254"]; BAD["\342\200\255"]; BAD["\342\200\256"]
    BAD["\342\201\246"]; BAD["\342\201\247"]; BAD["\342\201\250"]; BAD["\342\201\251"]
    BAD["\342\200\213"]; BAD["\342\200\214"]; BAD["\342\200\215"]; BAD["\342\200\216"]; BAD["\342\200\217"]
    BAD["\357\273\277"]
  }
  function clean(s,   o, i, m, c) {
    o = ""; m = length(s)
    for (i = 1; i <= m; i++) {
      c = substr(s, i, 1)
      if (c < " " || c == "\177") { o = o "?"; continue }
      if (c == "\342" || c == "\357") { if (substr(s, i, 3) in BAD) { o = o "?"; i += 2; continue } }
      o = o c
    }
    return o
  }
  function cap(s, m,   i, l, c, k) {
    l = length(s); k = 0
    for (i = 1; i <= l; i++) {
      c = substr(s, i, 1)
      if (c < "\200" || c > "\277") { k++; if (k > m) return substr(s, 1, i - 1) "..." }
    }
    return s
  }
'
OWED_AWK="$CLEAN_AWK"'
  BEGIN { n = 0; cmd = ""; since = "" }
  function val(s) { sub(/^[a-z]+:[ \t]*/, "", s); sub(/[ \t\r]+$/, "", s); return s }
  function flush() {
    if (cmd != "") {
      cmd = cap(clean(cmd), len)
      if (since ~ /^[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]/) since = substr(since, 1, 10)
      else since = "an unknown date"
      if (!(cmd in at)) { n++; order[n] = cmd; at[cmd] = since }
      else if (since != "an unknown date" && (at[cmd] == "an unknown date" || since < at[cmd])) at[cmd] = since
    }
    cmd = ""; since = ""
  }
  /^[ \t\r]*$/ { flush(); next }
  /^owed:/  { if (cmd == "") cmd = val($0); next }
  /^since:/ { if (since == "") since = val($0); next }
  END { flush(); for (i = 1; i <= n; i++) printf "%s\t%s\n", order[i], at[order[i]] }
'
# DATA, not lines: one "command<TAB>since" per distinct command, every one of them (clean()
# turned any tab in a command into ?). gather() renders the capped Owed: lines from it and
# --json lists all of it, so the two cannot disagree. rc 3: the file exists but cannot be read.
owed_data(){    # owed_data <owed-file>
  [ -e "$1" ] || return 0
  { [ -f "$1" ] && [ -r "$1" ]; } || return 3
  LC_ALL=C awk -v len="$OWED_CMD_LEN" "$OWED_AWK" "$1" 2>/dev/null
  return 0
}


# --- the card ------------------------------------------------------------------
# THE ONE COMPUTATION (A11). gather() reads every source once into the C_* globals;
# render_text() and render_json() only print them. A fact either view needs is gathered here
# and never re-read by a renderer, so the text card and --json cannot drift. Two reads are
# JSON-only and gated on MODE, because the text card has no use for them and pays for every
# fork: the panel: line and the per-item detail (id, done-when, when, next).
C_ERRORS=()
err(){ C_ERRORS+=("$1"); }

gather(){
  local where="" wrc=0 sess="" src=0 line="" sec="" t od orc c s i show b
  C_TOP=""; C_NAME=""; C_INREPO=0; C_DRAWER=""; C_DSTATE=unknown; C_DECL=""
  C_WARN=""; C_WREC=0; C_WENDED=""; C_WTR=""
  C_OPEN_HEADER=""; C_TITLES=(); C_PARKED=""; C_NPARKED=0; C_N=0; C_NPIN=""; C_HAVE_OWN=0
  C_XH=(); C_XT=(); C_XS=(); C_XSINGLE=()
  C_OWED=(); C_OWED_CMD=(); C_OWED_SINCE=(); C_OWED_UNREADABLE=0
  C_HMARK=""; C_HPATH=""; C_HANDOFF=""; C_HSIZE=""; C_HDATE=""
  C_TRACKERS=(); C_TRACKER_MARKS=()
  C_SYNC=""; C_BEHIND=0; C_MODS=""; C_MODS_UNSEEN=0; C_MODS_MEASURED=0; C_RCOPY=""
  C_PANEL_N=0; C_PANEL_VAL=""; C_LIST=""; C_PLIST=""
  # Selftest seam: a crash in the middle of gathering, the one failure nothing else provokes.
  [ "${PJ_CARD_FAULT:-}" = crash ] && exit 3

  # machine-wide, so read before the outside-a-repo return: that card shows it too
  C_RCOPY="$(rules_copy_line 2>/dev/null)" || C_RCOPY=""

  C_TOP="$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null)" || C_TOP=""
  [ -n "$C_TOP" ] && C_TOP="$(dirname "$C_TOP")"
  if [ -z "$C_TOP" ]; then C_NAME="$(basename "$PWD")"; return 0; fi
  C_INREPO=1
  C_NAME="$(basename "$C_TOP")"
  C_DECL="$C_TOP/.claude/pj-homes"
  if [ -e "$C_DECL" ] && { [ ! -f "$C_DECL" ] || [ ! -r "$C_DECL" ]; }; then
    err "pj-homes: .claude/pj-homes exists but is not a readable file; defaults used"
  fi

  # the drawer, through open-items so the key encoding lives in one place
  where="$(open-items --where 2>/dev/null)"; wrc=$?
  case "$wrc" in
    0) C_DRAWER="$(dirname "$where")"; C_DSTATE=present ;;
    1) C_DRAWER=""; C_DSTATE=none ;;          # this repo has no drawer yet
    *) err "items: open-items --where exit $wrc; the items section dropped out"
       C_DRAWER=""; wrc=99 ;;                 # open-items broken or absent: section drops out
  esac

  # the no-wrap-up flag
  local flag="$STATE/no-wrap-up/$(encode_key "$C_TOP")"
  if [ -e "$flag" ]; then
    C_WENDED="$(decl_get "$flag" ended)"; C_WTR="$(decl_get "$flag" transcript)"
    C_WREC="$(grep -c '^session:' "$flag" 2>/dev/null || true)"; C_WREC="${C_WREC:-0}"
    [ -n "$C_WTR" ] && C_WTR="$(tilde "$C_WTR")"
    if [ "$C_WREC" -gt 1 ]; then
      C_WARN="WARNING: the last $C_WREC sessions here ended without wrap-up"
      [ -n "$C_WENDED" ] && C_WARN="$C_WARN (latest $C_WENDED)"
    else
      C_WARN="WARNING: the last session here ended without wrap-up"
      [ -n "$C_WENDED" ] && C_WARN="$C_WARN ($C_WENDED)"
    fi
    C_WARN="$C_WARN."
    [ -n "$C_WTR" ] && C_WARN="$C_WARN Transcript: $C_WTR"
    [ "$C_WREC" -gt 1 ] && C_WARN="$C_WARN (pj-wrap status lists all)"
  fi

  # open items, then (A16, W-20260923-A28) the cross-project sections open-items --session
  # prints after them: Watching, Checks owed, Mandatory, Moved out, Ignored lines, each a
  # header plus up to 3 titles, and single lines (Inbox, notes). Read even with NO drawer:
  # the inbox and mandatory lines are for every project. Parsed by SECTION, so a cross title
  # can never be counted as one of this project's own.
  # --json: start the detail read NOW, on fd 9, so it runs beside --session instead of after
  # it: 645 ms became 450 on a 185-item drawer (2026-09-27). Only when there is a drawer.
  [ "$MODE" = json ] && [ "$wrc" -eq 0 ] && exec 9< <({ open-items --json 2>/dev/null; printf '\036RC %s\n' "$?"; })
  if [ "$wrc" -eq 0 ] || [ "$wrc" -eq 1 ]; then
    sess="$(open-items --session 2>/dev/null | strip_ansi; exit "${PIPESTATUS[0]}")"; src=$?
    [ "$src" -eq 0 ] || err "items: open-items --session exit $src"
    while IFS= read -r line; do
      case "$line" in
        'Open items'*) C_HAVE_OWN=1; sec=own
                       C_N="$(printf '%s' "$line" | sed -n 's/^Open items (\([0-9]*\) in.*/\1/p')"
                       C_NPIN="$(printf '%s' "$line" | sed -n 's/^Open items ([0-9]* in .*, \([0-9]*\) pinned -- .*/\1/p')" ;;
        'Watching: '*|'Checks owed: '*|'Mandatory: '*|'Moved out: '*|'Ignored lines: '*)
                       C_XH+=("$line"); sec=$(( ${#C_XH[@]} - 1 )) ;;
        'Inbox: '*|'Cross-project: '*|'Repo: '*|'Uncommitted move '*)
                       C_XSINGLE+=("$line"); sec=none ;;
        '   · '*)      if [ "$sec" = own ]; then C_TITLES+=("$line")
                       elif [ "$sec" != none ] && [ -n "$sec" ]; then C_XT+=("$line"); C_XS+=("$sec"); fi ;;
        '   parked: '*) [ "$sec" = own ] && C_PARKED="${line#"${line%%[![:space:]]*}"}" ;;
      esac
    done <<<"$sess"
  fi
  if [ "$wrc" -eq 1 ] && [ "$(decl_get "$C_DECL" records)" = engage ]; then
    C_OPEN_HEADER="Open items: kept as engage records (engage-go questions lists what waits on you)"
  elif [ "$wrc" -eq 1 ]; then
    C_OPEN_HEADER="Open items: no drawer for this project yet (\`open-items init\` creates one)"
  elif [ "$wrc" -eq 0 ]; then
    if [ "$C_HAVE_OWN" -eq 0 ]; then
      C_OPEN_HEADER="Open items: none open (\`open-items add\` files one)"
    else
      [ -n "$C_N" ] || C_N="${#C_TITLES[@]}"
      # W-20260923-A23: open-items --session lists pinned items (when: next session) FIRST,
      # so they survive the title cap below; the header says how many there are. Silent
      # when none are pinned, like every other exception line on this card.
      local pin_note=""; [ -n "$C_NPIN" ] && pin_note=", $C_NPIN pinned for next session, listed first"
      C_OPEN_HEADER="Open items: $C_N open$pin_note (\`open-items\` for detail; add/close/park/decline/reopen to change)"
    fi
  fi
  [ -n "$C_N" ] || C_N=0
  b="${C_PARKED#parked: }"; case "$b" in ''|*[!0-9]*) C_NPARKED=0 ;; *) C_NPARKED="$b" ;; esac

  # handoff: declared or default; a line only when the file exists
  C_HMARK="$(decl_get "$C_DECL" handoff)"; [ -n "$C_HMARK" ] || C_HMARK="repo:OPENING-PROMPT.md"
  if C_HPATH="$(resolve "$C_HMARK" "$C_TOP" "$C_DRAWER")" && [ -n "$C_HPATH" ] && [ -f "$C_HPATH" ]; then
    C_HSIZE="$(file_size "$C_HPATH")"; C_HDATE="$(file_date "$C_HPATH")"
    C_HANDOFF="Handoff: $C_HMARK ($C_HSIZE, $C_HDATE). Read on request, never print it."
  else
    C_HPATH=""
  fi

  # trackers, one line each
  while IFS= read -r t; do [ -n "$t" ] && { C_TRACKER_MARKS+=("$t"); C_TRACKERS+=("Tracker: $t"); }; done < <(decl_all "$C_DECL" tracker)

  # owed project wrap-ups (W5): the data, then the capped lines rendered from it
  od="$(owed_data "$STATE/owed/$(encode_key "$C_TOP")")"; orc=$?
  if [ "$orc" -eq 3 ]; then
    C_OWED_UNREADABLE=1
    C_OWED=("Owed: an unfinished project wrap-up is recorded here but cannot be read; 'pj-wrap owed' lists it.")
  else
    while IFS=$'\t' read -r c s; do [ -n "$c" ] && { C_OWED_CMD+=("$c"); C_OWED_SINCE+=("$s"); }; done <<<"$od"
    show=${#C_OWED_CMD[@]}; [ "$show" -gt "$OWED_CAP" ] && show=$(( OWED_CAP - 1 ))
    for ((i = 0; i < show; i++)); do
      C_OWED+=("Owed: ${C_OWED_CMD[$i]} (since ${C_OWED_SINCE[$i]}, not finished at wrap-up). Run it, or 'pj-wrap owed --clear'.")
    done
    [ "${#C_OWED_CMD[@]}" -gt "$OWED_CAP" ] \
      && C_OWED+=("Owed: +$(( ${#C_OWED_CMD[@]} - show )) more unfinished wrap-up command(s); 'pj-wrap owed' lists them.")
  fi

  C_SYNC="$(sync_line 2>/dev/null)" || C_SYNC=""
  b="${C_SYNC#dot-claude: }"; b="${b%% *}"; case "$b" in ''|*[!0-9]*) C_BEHIND=0 ;; *) C_BEHIND="$b" ;; esac
  C_MODS="$(mods_line 2>/dev/null)" || C_MODS=""
  if [ -z "$C_MODS" ]; then
    command -v "${PJ_MODS_API_DRIFT:-mods-api-drift}" >/dev/null 2>&1 && C_MODS_MEASURED=1
  else
    b="$(printf '%s' "$C_MODS" | sed -n 's/^Mods API: (\([0-9]*\)) unseen change.*/\1/p')"
    [ -n "$b" ] && { C_MODS_UNSEEN="$b"; C_MODS_MEASURED=1; }
  fi

  [ "$MODE" = json ] || return 0
  # --- JSON-only reads -------------------------------------------------------------
  if [ -f "$C_DECL" ] && [ -r "$C_DECL" ]; then
    b="$(awk 'sub(/^panel:[ \t]*/, "") { n++; if (n == 1) { sub(/[ \t\r]+$/, ""); v = $0 } }
              END { printf "%d\t%s", n, v }' "$C_DECL" 2>/dev/null)" || b=""
    C_PANEL_N="${b%%$'\t'*}"; C_PANEL_VAL="${b#*$'\t'}"
    case "$C_PANEL_N" in ''|*[!0-9]*) C_PANEL_N=0; C_PANEL_VAL="" ;; esac
  fi
  # Every own item's id, done-when, when and next, from open-items --json. The titles and the
  # order stay the card's own (the --session read above); this read is only accepted when it
  # names the same titles in the same order, so a drawer written between the two reads, or a
  # pin rule the two readers disagree on, is reported instead of shown wrong.
  # One awk pass does the reading, the check and the objects: bash loops over every item cost
  # 420 ms on a 182-item drawer (measured 2026-09-27). The card's titles reach awk through a
  # process substitution and open-items' output through fd 9 (opened above), so nothing is
  # written. fd 9 is closed on every path, read or not.
  if [ "$C_DSTATE" = present ] && [ "${#C_TITLES[@]}" -gt 0 ]; then
    od="$(LC_ALL=C awk "$DETAIL_AWK" <(printf '%s\n' "${C_TITLES[@]}") - <&9 2>/dev/null)"
    case "$od" in
      OK$'\n'*) C_LIST="${od#OK$'\n'}" ;;
      ERR\ *)   err "items: ${od#ERR }; id, done_when, when and next left out" ;;
      *)        err "items: the detail read gave nothing; id, done_when, when and next left out" ;;
    esac
  fi
  [ "$C_DSTATE" = present ] && exec 9<&-
  # Parked titles, JSON only and only when something is parked (about 90 ms, measured
  # 2026-09-27). A failed read keeps the count and leaves the list empty, named in errors.
  if [ "$MODE" = json ] && [ "$C_DSTATE" = present ] && [ "$C_NPARKED" -gt 0 ]; then
    od="$(LC_ALL=C awk "$PARKED_AWK" < <({ open-items --status parked --json 2>/dev/null; printf '\036RC %s\n' "$?"; }) 2>/dev/null)"
    case "$od" in
      OK|OK$'\n'*) C_PLIST="${od#OK}"; C_PLIST="${C_PLIST#$'\n'}" ;;
      ERR\ *)      err "parked: ${od#ERR }; titles left out" ;;
      *)           err "parked: the read gave nothing; titles left out" ;;
    esac
  fi
  return 0
}

# --- the text card: exactly what it printed before --json existed -----------------
render_text(){
  local lines=() n=0
  if [ "$C_INREPO" -eq 0 ]; then
    printf 'pj start card: %s (not a git repo, so no project, no items)\n' "$C_NAME"
    [ -n "$C_TEMP" ] && printf '%s\n' "$C_TEMP"
    [ -n "$C_RCOPY" ] && printf '%s\n' "$C_RCOPY"
    printf '%s\n' "$HELLO"
    return 0
  fi
  lines+=("pj start card: $C_NAME")
  [ -n "$C_WARN" ] && lines+=("$C_WARN")
  [ -n "$C_TEMP" ] && lines+=("$C_TEMP")
  [ -n "$C_OPEN_HEADER" ] && lines+=("$C_OPEN_HEADER")
  local fixed=$(( ${#lines[@]} + ${#C_TRACKERS[@]} + ${#C_OWED[@]} + 1 ))   # +1 hello
  [ -n "$C_PARKED" ] && fixed=$((fixed + 1))
  [ -n "$C_HANDOFF" ] && fixed=$((fixed + 1))
  [ -n "$C_SYNC" ] && fixed=$((fixed + 1))
  [ -n "$C_MODS" ] && fixed=$((fixed + 1))
  [ -n "$C_RCOPY" ] && fixed=$((fixed + 1))
  fixed=$(( fixed + ${#C_XH[@]} + ${#C_XSINGLE[@]} ))
  # THE BUDGET (P8 rule 3). This project's own titles keep a floor of OWN_FLOOR before any
  # cross-project title is placed; cross sections then take one title each in turn (at most
  # 3 each, as --session already cut them); own titles take what is left up to TITLE_CAP.
  # A "+N more" line comes out of the spare lines, else out of the largest cross section,
  # else out of the own titles. Every count line stays exact; a cut section says "showing K".
  local budget=$(( CAP - fixed )) total=${#C_TITLES[@]} give=0 avail k j more=0
  local nx=${#C_XH[@]} gx=() px=()
  for ((k = 0; k < nx; k++)); do gx[$k]=0; px[$k]=0; done
  for j in ${C_XS[@]+"${C_XS[@]}"}; do px[$j]=$(( ${px[$j]} + 1 )); done
  give=$total; [ "$give" -gt "$OWN_FLOOR" ] && give=$OWN_FLOOR; [ "$give" -gt "$budget" ] && give=$budget; [ "$give" -lt 0 ] && give=0
  avail=$(( budget - give ))
  local moved=1
  while [ "$avail" -gt 0 ] && [ "$moved" -eq 1 ]; do
    moved=0
    for ((k = 0; k < nx && avail > 0; k++)); do
      [ "${gx[$k]}" -lt "${px[$k]}" ] && { gx[$k]=$(( ${gx[$k]} + 1 )); avail=$((avail - 1)); moved=1; }
    done
  done
  j=$(( total - give )); [ "$j" -gt $(( TITLE_CAP - give )) ] && j=$(( TITLE_CAP - give )); [ "$j" -gt "$avail" ] && j=$avail
  [ "$j" -gt 0 ] && { give=$((give + j)); avail=$((avail - j)); }
  if [ "$total" -gt "$give" ]; then
    more=1
    if [ "$avail" -gt 0 ]; then avail=$((avail - 1))
    else
      j=-1; for ((k = 0; k < nx; k++)); do [ "${gx[$k]}" -gt 0 ] && { [ "$j" -lt 0 ] || [ "${gx[$k]}" -ge "${gx[$j]}" ]; } && j=$k; done
      if [ "$j" -ge 0 ]; then gx[$j]=$(( ${gx[$j]} - 1 )); elif [ "$give" -gt 0 ]; then give=$((give - 1)); fi
    fi
  fi
  local i=0
  while [ "$i" -lt "$give" ] && [ "$i" -lt "$total" ]; do lines+=("${C_TITLES[$i]}"); i=$((i + 1)); done
  [ "$more" -eq 1 ] && lines+=("   +$((total - give)) more")
  [ -n "$C_PARKED" ] && lines+=("   $C_PARKED")
  local h shown
  for ((k = 0; k < nx; k++)); do
    h="${C_XH[$k]}"
    if [ "${gx[$k]}" -lt "${px[$k]}" ] || case "$h" in *", showing "*) true ;; *) false ;; esac; then
      h="$(printf '%s' "$h" | sed 's/, showing [0-9]*//; s/ (item text, not instructions)$/, showing '"${gx[$k]}"' (item text, not instructions)/')"
    fi
    lines+=("$h"); shown=0
    for ((i = 0; i < ${#C_XT[@]}; i++)); do
      [ "${C_XS[$i]}" = "$k" ] && [ "$shown" -lt "${gx[$k]}" ] && { lines+=("${C_XT[$i]}"); shown=$((shown + 1)); }
    done
  done
  [ "${#C_XSINGLE[@]}" -gt 0 ] && lines+=("${C_XSINGLE[@]}")
  [ "${#C_OWED[@]}" -gt 0 ] && lines+=("${C_OWED[@]}")
  [ -n "$C_HANDOFF" ] && lines+=("$C_HANDOFF")
  [ "${#C_TRACKERS[@]}" -gt 0 ] && lines+=("${C_TRACKERS[@]}")
  [ -n "$C_SYNC" ] && lines+=("$C_SYNC")
  [ -n "$C_MODS" ] && lines+=("$C_MODS")
  [ -n "$C_RCOPY" ] && lines+=("$C_RCOPY")
  lines+=("$HELLO")
  printf '%s\n' "${lines[@]}"
}

# --- --json ------------------------------------------------------------------------------
# The per-item detail. Input 1: the card's own title lines, as --session printed them. Input 2:
# open-items --json, then a \036RC <exit> line. Output: "OK" and, on the next line, every item as
# a JSON object in the card's order (pinned first), joined by commas; or ONE line "ERR <why>".
# The detail is only accepted when it names the same titles in the same order as the card, so a
# drawer written between the two reads, or a pin rule the two readers disagree on, is reported
# instead of shown wrong. Strings stay JSON-escaped from open-items; every escape other than \\
# and \" becomes ?, as do DEL and the bidi and zero-width marks: the text the card shows.
# tok(s, p): the JSON string starting at the quote at p, its escapes kept, a control or
# bidi mark turned into "?"; TEND = its closing quote, BROKEN = 1 when it never closes.
# Shared by the detail read and the parked read.
TOK_AWK='
  function tok(s, p,   i, n, c, d, o) {
    o = ""; n = length(s); i = p + 1
    while (i <= n) {
      c = substr(s, i, 1)
      if (c == "\"") { TEND = i; return o }
      if (c == "\\") {
        d = substr(s, i + 1, 1)
        if (d == "\\" || d == "\"") { o = o c d; i += 2; continue }
        if (d == "/") { o = o "/"; i += 2; continue }
        o = o "?"; i += (d == "u") ? 6 : 2; continue
      }
      if (c == "\177") { o = o "?"; i++; continue }
      if ((c == "\342" || c == "\357") && (substr(s, i, 3) in BAD)) { o = o "?"; i += 3; continue }
      o = o c; i++
    }
    TEND = n; BROKEN = 1; return o
  }
'

# The parked read (items.parked_list, for the start-card mod, 2026-09-27): open-items
# --status parked --json on stdin, one {"id": ...} object per line, then "\036RC <exit>".
# Prints OK and the list's objects, or ERR and why. Order is open-items' own.
PARKED_AWK="$CLEAN_AWK$TOK_AWK"'
  BEGIN { n = 0; out = ""; ORC = -1 }
  /^\036RC / { ORC = $2 + 0; next }
  /^\{"id":"/ {
    id = tok($0, 7); rest = substr($0, TEND + 1)
    p = index(rest, "\"title\":\""); t = (p ? tok(rest, p + 8) : "")
    out = out (n++ ? "," : "") "{\"id\":\"" id "\",\"title\":\"" t "\"}"
  }
  END {
    if (ORC > 1) { print "ERR open-items --status parked --json exit " ORC; exit }
    if (ORC < 0) { print "ERR open-items --status parked --json did not finish"; exit }
    if (BROKEN)  { print "ERR open-items --status parked --json did not parse"; exit }
    print "OK"; print out
  }
'

DETAIL_AWK="$CLEAN_AWK$TOK_AWK"'
  BEGIN { np = 0; nr = 0; nt = 0; ORC = -1 }
  function esc(s,   i, n, c, o) {       # a card title (already clean) as JSON string content
    o = ""; n = length(s)
    for (i = 1; i <= n; i++) { c = substr(s, i, 1); if (c == "\\" || c == "\"") o = o "\\"; o = o c }
    return o
  }
  NR == FNR { T[++nt] = $0; next }
  /^\036RC / { ORC = $2 + 0; next }
  function fld(s, key,   p, q, v, o, k) {
    p = index(s, "\"" key "\":"); if (p == 0) return "null"
    q = p + length(key) + 3
    if (substr(s, q, 1) == "\"") { v = tok(s, q); if (key == "when" && tolower(v) ~ /^next session/) PIN = 1; return "\"" v "\"" }
    if (substr(s, q, 1) != "[") return "null"
    o = ""; k = 0; q++
    while (substr(s, q, 1) == "\"") {
      v = tok(s, q); if (key == "when" && tolower(v) ~ /^next session/) PIN = 1
      o = o (k++ ? " " : "") v; q = TEND + 1; if (substr(s, q, 1) == ",") q++
    }
    return "\"" o "\""
  }
  /^\{"id":"/ {
    id = tok($0, 7); rest = substr($0, TEND + 1)
    p = index(rest, "\"title\":\""); title = (p ? tok(rest, p + 8) : "")
    p = index(rest, "\"fields\":{"); f = (p ? substr(rest, p) : "")
    PIN = 0
    dw = fld(f, "done-when"); wh = fld(f, "when"); nx = fld(f, "next")
    k = PIN ? ++np : ++nr
    if (PIN) { PI[k] = id; PT[k] = title; PD[k] = dw; PW[k] = wh; PX[k] = nx }
    else     { RI[k] = id; RT[k] = title; RD[k] = dw; RW[k] = wh; RX[k] = nx }
  }
  END {
    if (ORC > 1)  { print "ERR open-items --json exit " ORC; exit }
    if (ORC < 0)  { print "ERR open-items --json did not finish"; exit }
    if (BROKEN)   { print "ERR open-items --json did not parse"; exit }
    if (np + nr != nt) { print "ERR open-items --json listed " (np + nr) " open, the card read " nt; exit }
    out = ""
    for (k = 1; k <= nt; k++) {
      if (k <= np) { pin = 1; id = PI[k]; t = PT[k]; dw = PD[k]; wh = PW[k]; nx = PX[k] }
      else { j = k - np; pin = 0; id = RI[j]; t = RT[j]; dw = RD[j]; wh = RW[j]; nx = RX[j] }
      got = T[k]; sub(/^   [^ ]+ /, "", got)
      if (esc(got) != (pin ? "[pinned] " : "") t) { print "ERR open-items --json disagrees with the card at item " k; exit }
      out = out (k > 1 ? "," : "") "{\"id\":\"" id "\",\"title\":\"" t "\",\"pinned\":" (pin ? "true" : "false") \
            ",\"done_when\":" dw ",\"when\":" wh ",\"next\":" nx "}"
    }
    print "OK"; print out
  }
'

# js <string>: REPLY = the string as a JSON literal. Pure bash, no fork, no jq, identical on
# bash 3.2 and 5.x: the pattern is quoted and the replacement is NOT (bash 3.2 keeps quotes in
# a quoted replacement literally), and patsub_replacement is off (5.2+ would treat & in a
# replacement as the match). Measured on /bin/bash 3.2.57 and bash 5.3 on 2026-09-27.
JS_BS='\'; JS_Q='"'; JS_CC=(); JS_CE=()
js_init(){      # printf -v into a scalar, then assign: bash 3.2 cannot printf -v an array element
  local i o c
  shopt -u patsub_replacement 2>/dev/null || true
  for ((i = 1; i < 32; i++)); do
    printf -v o '%03o' "$i"; printf -v c "\\$o"; JS_CC[$i]="$c"
    case "$i" in 9) c="${JS_BS}t" ;; 10) c="${JS_BS}n" ;; 13) c="${JS_BS}r" ;;
                 *) printf -v c '%su%04x' "$JS_BS" "$i" ;; esac
    JS_CE[$i]="$c"
  done
}
js(){
  local LC_ALL=C s="$1" i
  s="${s//"$JS_BS"/$JS_BS$JS_BS}"; s="${s//"$JS_Q"/$JS_BS$JS_Q}"
  case "$s" in *[[:cntrl:]]*)
    for ((i = 1; i < 32; i++)); do s="${s//"${JS_CC[$i]}"/${JS_CE[$i]}}"; done ;;
  esac
  REPLY="$JS_Q$s$JS_Q"
}
jsn(){ if [ -n "$1" ]; then js "$1"; else REPLY=null; fi; }   # empty -> null
# jsa <string>...: REPLY = a JSON array of the strings
jsa(){ local o="" x; for x in "$@"; do js "$x"; o="$o${o:+,}$REPLY"; done; REPLY="[$o]"; }
bool(){ if [ "$1" = 1 ]; then REPLY=true; else REPLY=false; fi; }
render_json(){
  local o="" i t x k name key cnt line titles out clean
  js "$C_NAME"; o="{\"schema\":1,\"project\":$REPLY"
  bool "$C_INREPO"; o="$o,\"in_repo\":$REPLY"
  [ -n "${PJ_NO_CARD:-}" ] && t=1 || t=0; bool "$t"; o="$o,\"no_card\":$REPLY"

  if [ -n "$C_WARN" ]; then
    js "$C_WARN"; t="{\"text\":$REPLY,\"records\":$C_WREC"
    jsn "$C_WENDED"; t="$t,\"ended\":$REPLY"; jsn "$C_WTR"; t="$t,\"transcript\":$REPLY}"
    o="$o,\"wrap_up_warning\":$t"
  else o="$o,\"wrap_up_warning\":null"; fi

  if [ "$C_INREPO" -eq 0 ]; then o="$o,\"items\":null"
  else
    t="{\"drawer\":\"$C_DSTATE\",\"open\":$C_N,\"pinned\":${C_NPIN:-0},\"parked\":$C_NPARKED,\"list\":["
    if [ -n "$C_LIST" ]; then t="$t$C_LIST"
    else                       # the detail read failed: the card's own titles, no ids
      for ((i = 0; i < ${#C_TITLES[@]}; i++)); do
        [ "$i" -gt 0 ] && t="$t,"
        x="${C_TITLES[$i]#   · }"; k=0
        case "$x" in '[pinned] '*) x="${x#\[pinned\] }"; k=1 ;; esac
        js "$x"; titles="$REPLY"; bool "$k"
        t="$t{\"id\":null,\"title\":$titles,\"pinned\":$REPLY,\"done_when\":null,\"when\":null,\"next\":null}"
      done
    fi
    o="$o,\"items\":$t],\"parked_list\":[$C_PLIST]}"
  fi

  # cross-project: the five header sections by name, then the inbox count and the notes
  t=""
  for key in watching:Watching checks_owed:'Checks owed' mandatory:Mandatory moved_out:'Moved out' ignored:'Ignored lines'; do
    name="${key%%:*}"; key="${key#*:}"; cnt=0; line=null; titles=""
    for ((k = 0; k < ${#C_XH[@]}; k++)); do
      case "${C_XH[$k]}" in "$key: "*) ;; *) continue ;; esac
      x="${C_XH[$k]#"$key: "}"; x="${x%%[!0-9]*}"; cnt="${x:-0}"
      js "${C_XH[$k]}"; line="$REPLY"
      for ((i = 0; i < ${#C_XT[@]}; i++)); do
        [ "${C_XS[$i]}" = "$k" ] || continue
        js "${C_XT[$i]#   · }"; titles="$titles${titles:+,}$REPLY"
      done
    done
    t="$t${t:+,}\"$name\":{\"count\":$cnt,\"line\":$line,\"titles\":[$titles]}"
  done
  cnt=0; out=()
  for x in ${C_XSINGLE[@]+"${C_XSINGLE[@]}"}; do
    case "$x" in 'Inbox: '*) x="${x#Inbox: }"; x="${x%%[!0-9]*}"; cnt="${x:-0}" ;; *) out+=("$x") ;; esac
  done
  jsa ${out[@]+"${out[@]}"}
  o="$o,\"cross\":{$t,\"inbox\":$cnt,\"notes\":$REPLY}"

  t=""
  for ((i = 0; i < ${#C_OWED_CMD[@]}; i++)); do
    js "${C_OWED_CMD[$i]}"; x="$REPLY"; js "${C_OWED_SINCE[$i]}"
    t="$t${t:+,}{\"command\":$x,\"since\":$REPLY}"
  done
  bool "$C_OWED_UNREADABLE"; o="$o,\"owed\":[$t],\"owed_unreadable\":$REPLY"

  if [ -n "$C_HANDOFF" ]; then
    x="$(stat -L -c %s "$C_HPATH" 2>/dev/null || stat -L -f %z "$C_HPATH" 2>/dev/null)"; case "$x" in ''|*[!0-9]*) x=null ;; esac
    js "$C_HMARK"; t="{\"marker\":$REPLY"; js "$C_HPATH"; t="$t,\"path\":$REPLY"
    js "$C_HSIZE"; t="$t,\"size\":$REPLY,\"bytes\":$x"; js "$C_HDATE"; t="$t,\"date\":$REPLY}"
    o="$o,\"handoff\":$t"
  else o="$o,\"handoff\":null"; fi

  jsa ${C_TRACKER_MARKS[@]+"${C_TRACKER_MARKS[@]}"}; o="$o,\"trackers\":$REPLY"
  o="$o,\"dot_claude_behind\":$C_BEHIND"
  if [ "$C_INREPO" -eq 0 ]; then o="$o,\"mods_api\":null"
  else bool "$C_MODS_MEASURED"; o="$o,\"mods_api\":{\"unseen\":$C_MODS_UNSEEN,\"measured\":$REPLY}"; fi

  # flags (F1 in the design): the card's OWN signals, each with the card's own line
  local fn=() ft=()
  [ -n "$C_WARN" ] && { fn+=(no-wrap-up); ft+=("$C_WARN"); }
  if [ "${#C_OWED[@]}" -eq 1 ]; then fn+=(owed); ft+=("${C_OWED[0]}")
  elif [ "${#C_OWED[@]}" -gt 1 ]; then fn+=(owed); ft+=("Owed: ${#C_OWED_CMD[@]} unfinished project wrap-up command(s); 'pj-wrap owed' lists them."); fi
  [ -n "$C_SYNC" ] && { fn+=(dot-claude-behind); ft+=("$C_SYNC"); }
  [ -n "$C_MODS" ] && { fn+=(mods-api); ft+=("$C_MODS"); }
  [ -n "$C_RCOPY" ] && { fn+=(rules-copy); ft+=("$C_RCOPY"); }
  t=""
  for ((i = 0; i < ${#fn[@]}; i++)); do js "${ft[$i]}"; t="$t${t:+,}{\"name\":\"${fn[$i]}\",\"text\":$REPLY}"; done
  o="$o,\"flags\":[$t]"

  # panel (D-20260927-A13): the pj-homes line, or automatic
  local sections=() unknown=() src=automatic
  if [ "$C_PANEL_N" -gt 0 ]; then
    src=pj-homes
    local words=(); IFS=$', \t' read -r -a words <<<"$C_PANEL_VAL"
    for x in ${words[@]+"${words[@]}"}; do
      [ -n "$x" ] || continue
      case " items parked handoff rulings flags mods-api " in
        *" $x "*) case " ${sections[*]-} " in *" $x "*) ;; *) sections+=("$x") ;; esac ;;
        *) x="$(printf '%s\n' "$x" | LC_ALL=C awk "$CLEAN_AWK"'{ print cap(clean($0), 40) }' 2>/dev/null)"
           case " ${unknown[*]-} " in *" $x "*) ;; *) [ -n "$x" ] && unknown+=("$x") ;; esac ;;
      esac
    done
  elif [ "$C_INREPO" -eq 1 ]; then
    [ "$C_N" -gt 0 ] && sections+=(items)
    [ "$C_NPARKED" -gt 0 ] && sections+=(parked)
    [ -n "$C_HANDOFF" ] && sections+=(handoff)
    [ "${#fn[@]}" -gt 0 ] && sections+=(flags)
    [ "$C_MODS_UNSEEN" -gt 0 ] && sections+=(mods-api)
  fi
  jsa ${sections[@]+"${sections[@]}"}; t="$REPLY"; jsa ${unknown[@]+"${unknown[@]}"}
  x=$(( C_PANEL_N > 1 ? C_PANEL_N - 1 : 0 ))
  o="$o,\"panel\":{\"sections\":$t,\"source\":\"$src\",\"unknown\":$REPLY,\"duplicates\":$x}"

  # Valid UTF-8 whatever a title held: iconv -c drops a byte that is not, and says so below.
  if command -v iconv >/dev/null 2>&1; then
    clean="$(printf '%s' "$o" | iconv -f UTF-8 -t UTF-8 -c 2>/dev/null)"
    if [ -n "$clean" ] && [ "$clean" != "$o" ]; then
      o="$clean"; err "json: bytes that were not UTF-8 were dropped from a string"
    fi
  fi
  jsa ${C_ERRORS[@]+"${C_ERRORS[@]}"}
  printf '%s,"errors":%s}\n' "$o" "$REPLY"
}

main(){
  local src out
  if [ "$MODE" = json ]; then
    # --json reads no stdin and ignores PJ_NO_CARD (no_card reports it). A catastrophic
    # failure still answers with an object that parses and says what happened. js_init comes
    # FIRST: gather's detail check calls js, and before js_init bash 5 still has
    # patsub_replacement on, which halves every backslash (found by the selftest).
    js_init 2>/dev/null
    out="$(gather 2>/dev/null; render_json 2>/dev/null)"
    case "$out" in
      '{"schema":1,'*'}') printf '%s\n' "$out" ;;
      *) printf '{"schema":1,"project":null,"in_repo":false,"no_card":false,"wrap_up_warning":null,"items":null,"cross":{"watching":{"count":0,"line":null,"titles":[]},"checks_owed":{"count":0,"line":null,"titles":[]},"mandatory":{"count":0,"line":null,"titles":[]},"moved_out":{"count":0,"line":null,"titles":[]},"ignored":{"count":0,"line":null,"titles":[]},"inbox":0,"notes":[]},"owed":[],"owed_unreadable":false,"handoff":null,"trackers":[],"dot_claude_behind":0,"mods_api":null,"flags":[],"panel":{"sections":[],"source":"automatic","unknown":[],"duplicates":0},"errors":["card: internal error, nothing could be gathered"]}\n' ;;
    esac
    exit 0
  fi
  # PJ_NO_CARD (F5a): a profile with `card: off` exports this, and pj exports it into the
  # session. It is how a profile drops the START CARD without dropping the HOOKS.
  # --safe-mode cannot make that distinction: it disables hooks, plugins, skills, output
  # styles, CLAUDE.md and auto memory in one switch, so using it to quieten the card
  # would also disarm enforce-secret-probe.sh, validate-bash.sh, enforce-uv, enforce-pnpm
  # and MemoryRootGuard. Ruled by Gavin at the F5a gate: scratch sessions keep the guards.
  [ -n "${PJ_NO_CARD:-}" ] && exit 0
  src="$(source_of_hook)"
  [ "$src" = "compact" ] && exit 0
  # pj's launch sweep (W-20260929-A155): one line, DATA, so cleaned and capped like a title
  C_TEMP=""
  case "$src" in
    startup|resume)
      [ -n "${PJ_TEMP_SWEPT:-}" ] && C_TEMP="$(printf '%s\n' "$PJ_TEMP_SWEPT" | head -1 | LC_ALL=C awk "$CLEAN_AWK"'{ print cap(clean($0), 240) }' 2>/dev/null)" ;;
  esac
  out="$(gather 2>/dev/null; render_text 2>/dev/null)" || exit 0
  [ -n "$out" ] && printf '%s\n' "$out"
  exit 0
}
main
