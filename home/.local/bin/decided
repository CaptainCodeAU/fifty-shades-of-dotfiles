#!/usr/bin/env bash
# decided -- has this already been settled? Query the decisions register by topic.
#
# Usage:
#   decided <words...>        every word must appear in one block (case-insensitive)
#   decided D-YYYYMMDD-LNN    one block by ID (L = machine letter); found outside scope, says
#                             where. The pre-2026-09-21 D-YYYYMMDD-NN resolves too.
#   decided --all <words...>  search every home on the machine, not just this project's
#   decided --list [--all]    titles only, with the home each block sits in
#   decided --status S        only blocks whose status is S (standing | deferred |
#                             superseded | withdrawn); with no words, every such block
#   decided --since YYYY-MM-DD  only blocks whose `decided:` date is on or after it
#                             (both filters combine with words, --all and --list)
#   decided --homes           the homes this call would search, and why
#   decided add "title" --topic "words" --holds-in "<doc>" (--global | --project)
#                             [--body "..."] [--ruled-by "..."] [--status standing]
#   decided withdraw <ID> "reason"      status -> withdrawn; the ID stays claimed
#   decided --selftest        prove every arm (runs decided-selftest)
#
# WHERE IT LOOKS (D-20260920-10). Default scope = this project's store + machine-wide.
#   machine-wide  ~/.claude/pj-global/decisions/   one file per block
#   this project  `decisions:` in .claude/pj-homes (repo: | drawer: | ~/), default
#                 repo:docs/decisions/, or drawer:decisions/ when `records: private`
#   --all         plus every drawer's decisions/ and the legacy single-file register
#   outside a git repo: machine-wide only, and it says so.
# A store it cannot read (not a folder of D-*.md files, not a file of "## D-" blocks)
# is named as "unsupported format, not searched", never silently skipped.
#
# Exit: 0 match/written  ·  1 no match (not an error)  ·  2 REFUSED (no readable home,
# bad args)  ·  3 written but NOT committed. A miss always prints the denominator: a
# miss is NOT the same as "not decided". Reasoning: docs/DECIDED.md in the dotfiles repo.

set -uo pipefail

# RECORDS, NEVER CLAUDE_CONFIG_DIR (F5a). $HOME/.claude is spelled out on purpose. A pj
# profile can move the SESSION's config dir; the rulings must not move with it, or a
# ruling recorded from a scratch session would be invisible to every other session and
# `decided` would answer "not decided" about something that was. Ruled by Gavin before
# F5a and re-confirmed at its gate. The env seams are TEST seams; nothing derives them
# from CLAUDE_CONFIG_DIR, and pj-health's `records-pinned` row FAILS if that changes.
GLOBAL_DIR="${DECIDED_GLOBAL_DIR:-$HOME/.claude/pj-global/decisions}"
LEGACY="${DECISIONS_FILE:-$HOME/.local/share/decisions/DECISIONS.md}"
PROJECTS="${OPEN_ITEMS_PROJECTS_DIR:-$HOME/.claude/projects}"
DOTCLAUDE="${OPEN_ITEMS_DOTCLAUDE:-$HOME/.claude}"

die_refused(){ printf 'decided: REFUSED -- %s\n' "$1" >&2; exit 2; }
loud(){ printf 'decided: %s\n' "$1" >&2; }
usage(){ sed -n '2,19p' "$0" | sed 's/^# \{0,1\}//'; }
today(){ date +%Y-%m-%d; }
realdir(){ (cd "$1" 2>/dev/null && pwd -P); }
tilde(){ printf '%s' "${1/#$HOME/\~}"; }

# ---------------------------------------------------------------- homes ----
# A home is "label<TAB>kind<TAB>path". kind: folder | file | missing | unsupported.
# Label is what the denominator prints; path is what gets read.
HOMES=()
NOTES=()          # one-line explanations printed with --homes and on a miss
kind_of(){        # kind_of <path> -> folder | file | missing | unsupported
  local p="$1"
  [ -e "$p" ] || { printf 'missing'; return; }
  if [ -d "$p" ]; then
    # a folder of D-*.md files, or an empty folder (a store just declared) -- readable
    if [ -n "$(find "$p" -maxdepth 1 -name 'D-*.md' -print -quit 2>/dev/null)" ] || [ -z "$(ls -A "$p" 2>/dev/null)" ]; then printf 'folder'; else printf 'unsupported'; fi
  elif [ -f "$p" ]; then
    case "$p" in *.md) grep -q '^## D-' "$p" 2>/dev/null && printf 'file' || printf 'unsupported' ;; *) printf 'unsupported' ;; esac
  else printf 'unsupported'; fi
}
add_home(){ HOMES+=("$1	$(kind_of "$3")	$3	$2"); }   # add_home <label> <marker-or-note> <path>

repo_top(){
  local g; g="$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null)" || return 1
  [ -n "$g" ] || return 1; dirname "$g"
}
decl_get(){ [ -f "$1" ] || return 0; sed -n "s/^$2:[[:space:]]*//p" "$1" | head -1 | sed 's/[[:space:]]*$//'; }
drawer_dir(){ local w; w="$(open-items --where 2>/dev/null)"; [ -n "$w" ] || return 1; dirname "$w"; }
resolve(){        # resolve <marked> <top> -> path, or rc 1 for an unknown marker
  case "$1" in
    repo:*)   printf '%s/%s' "$2" "${1#repo:}" ;;
    drawer:*) local d; d="$(drawer_dir)" || return 2; printf '%s/%s' "$d" "${1#drawer:}" ;;
    '~/'*)    printf '%s/%s' "$HOME" "${1#\~/}" ;;
    *)        return 1 ;;
  esac
}

# The project store: declaration, or the D-20260920-06 default.
PROJECT_STORE=""; PROJECT_MARK=""; PROJECT_NOTE=""
project_store(){
  local top="$1" decl mark rec p rc
  decl="$top/.claude/pj-homes"
  mark="$(decl_get "$decl" decisions)"
  if [ -z "$mark" ]; then
    rec="$(decl_get "$decl" records)"
    if [ "$rec" = private ]; then mark="drawer:decisions/"; else mark="repo:docs/decisions/"; fi
    [ -f "$decl" ] && PROJECT_NOTE="no decisions: line in .claude/pj-homes, default $mark" || PROJECT_NOTE="no .claude/pj-homes, default $mark"
  else PROJECT_NOTE="declared in .claude/pj-homes"; fi
  PROJECT_MARK="${mark%/}"
  p="$(resolve "$mark" "$top")"; rc=$?
  case "$rc" in
    1) PROJECT_NOTE="decisions: '$mark' has no known root marker (repo:, drawer:, ~/)"; return 1 ;;
    2) PROJECT_NOTE="decisions: '$mark' names the drawer and this project has no drawer yet"; return 1 ;;
  esac
  PROJECT_STORE="${p%/}"
}

build_scope(){    # build_scope <all:0|1>
  local all="$1" top w d seen=""
  add_home "machine-wide" "$(tilde "$GLOBAL_DIR")" "$GLOBAL_DIR"
  if top="$(repo_top)"; then
    if project_store "$top"; then
      add_home "project ($PROJECT_MARK)" "$PROJECT_NOTE" "$PROJECT_STORE"
      seen="$(realdir "$PROJECT_STORE" 2>/dev/null || printf '%s' "$PROJECT_STORE")"
    else
      NOTES+=("project store not searched: $PROJECT_NOTE")
    fi
  else
    NOTES+=("not inside a git repo: machine-wide only")
  fi
  if [ "$all" -eq 1 ]; then
    for w in "$PROJECTS"/*/memory/WORK/decisions; do
      [ -d "$w" ] || continue
      d="$(realdir "$w")"; [ "$d" = "$seen" ] && continue
      add_home "drawer $(basename "$(dirname "$(dirname "$(dirname "$w")")")")" "every drawer (--all)" "$w"
    done
    [ -e "$LEGACY" ] && add_home "legacy file" "$(tilde "$LEGACY")" "$LEGACY"
  fi
}

# blocks_of <path> <kind>: the raw block stream of one home
blocks_of(){
  local p="$1" k="$2" f
  case "$k" in
    folder) for f in "$p"/D-*.md; do [ -f "$f" ] && { cat "$f"; printf '\n'; }; done ;;
    file)   cat "$p" ;;
  esac
}
count_in(){ blocks_of "$1" "$2" | grep -c '^## D-' 2>/dev/null || true; }

# ---------------------------------------------------------------- filters ----
# --status / --since (W-20260923-A21). A filter is applied BEFORE the word search and
# the denominator counts both sides of it: "12 in scope, 2 passed". A filtered miss that
# only said "12 searched" would read the same whether the words missed or the filter
# emptied the pool, and those are different answers.
F_STATUS=""; F_SINCE=""
filtering(){ [ -n "$F_STATUS$F_SINCE" ]; }
filter_desc(){
  local d=""
  [ -n "$F_STATUS" ] && d="status $F_STATUS"
  [ -n "$F_SINCE" ] && d="${d:+$d, }decided since $F_SINCE"
  printf '%s' "$d"
}
# Status is the FIRST word after `status:` (a real block reads "superseded (the split
# ...)"). The date is the `decided:` line; a block without one falls back to the date in
# its ID, which is the day pj-id allocated it. A block with neither never passes --since.
filter_stream(){
  awk -v st="$F_STATUS" -v since="${F_SINCE//-/}" '
    function emit(b,   n, i, line, s, d, lines) {
      if (b == "") return
      s = ""; d = ""
      n = split(b, lines, "\n")
      for (i = 1; i <= n; i++) {
        line = lines[i]
        if (s == "" && line ~ /^status:/) { sub(/^status:[ \t]*/, "", line); split(line, w, /[ \t]+/); s = w[1] }
        else if (d == "" && line ~ /^decided:/) { sub(/^decided:[ \t]*/, "", line); d = substr(line, 1, 10); gsub(/-/, "", d) }
      }
      if (d !~ /^[0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]$/ && match(lines[1], /D-[0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]-/)) d = substr(lines[1], RSTART + 2, 8)
      if (st != "" && s != st) return
      if (since != "" && (d !~ /^[0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]$/ || d < since)) return
      printf "%s", b
    }
    /^## D-/ { emit(block); block = $0 "\n"; next }
    { if (block != "") block = block $0 "\n" }
    END { emit(block) }
  '
}
fblocks_of(){ if filtering; then blocks_of "$1" "$2" | filter_stream; else blocks_of "$1" "$2"; fi; }
fcount_in(){ fblocks_of "$1" "$2" | grep -c '^## D-' 2>/dev/null || true; }

# ---------------------------------------------------------------- search ----
# One awk pass per home. BSD awk: no \x escapes, so no record separator tricks.
# <qre>, when non-empty, is a SECOND header pattern tried after an exact ID miss: the P8a
# letter migration (2026-09-21) renamed every D-YYYYMMDD-NN to D-YYYYMMDD-LNN, and the old
# shape is cited ~370 times in documents that were never rewritten. A citation must not
# dangle, so an old ID falls through to its letter form (P8a gate Q1).
search_stream(){  # search_stream <mode:words|id> <query> [legacy-regex] -> hits, rc 0 hit / 1 miss
  awk -v mode="$1" -v q="$2" -v qre="${3:-}" '
    function test_and_print(b,   lower, ok, i, cnt, w, first) {
      if (b == "") return
      if (mode == "id") { first = substr(b, 1, index(b, "\n") - 1); ok = (index(first, "## " q " ") == 1)
                          if (!ok && qre != "") ok = (first ~ qre) }
      else {
        lower = tolower(b); ok = 1
        cnt = split(tolower(q), w, " ")
        for (i = 1; i <= cnt; i++) if (w[i] != "" && index(lower, w[i]) == 0) { ok = 0; break }
      }
      if (ok) { printf "%s", b; matched++ }
    }
    /^## D-/ { test_and_print(block); block = $0 "\n"; next }
    { if (block != "") block = block $0 "\n" }
    END { test_and_print(block); exit (matched > 0 ? 0 : 1) }
  '
}

denominator(){    # sets DEN="N decision(s) searched (label a, label b)", TOTAL and PASSED
  local h label kind path n m parts="" fparts="" ; TOTAL=0; PASSED=0
  for h in "${HOMES[@]}"; do
    IFS=$'\t' read -r label kind path _ <<<"$h"
    case "$kind" in folder|file)
      n="$(count_in "$path" "$kind")"; TOTAL=$((TOTAL+n)); parts="$parts, $label $n"
      if filtering; then m="$(fcount_in "$path" "$kind")"; PASSED=$((PASSED+m)); fparts="$fparts, $label $m"; fi ;;
    esac
  done
  if filtering; then
    DEN="$(printf '%s decision(s) in scope (%s); %s passed the filter [%s] and were searched (%s)' "$TOTAL" "${parts#, }" "$PASSED" "$(filter_desc)" "${fparts#, }")"
  else
    PASSED=$TOTAL
    DEN="$(printf '%s decision(s) searched (%s)' "$TOTAL" "${parts#, }")"
  fi
}
readable_homes(){ local h kind; for h in "${HOMES[@]}"; do IFS=$'\t' read -r _ kind _ _ <<<"$h"; case "$kind" in folder|file) return 0;; esac; done; return 1; }
print_home_notes(){
  local h label kind path note
  for h in "${HOMES[@]}"; do
    IFS=$'\t' read -r label kind path note <<<"$h"
    case "$kind" in
      unsupported) loud "$label: declared store in an unsupported format, not searched ($(tilde "$path"))" ;;
      missing)     loud "$label: not present, nothing to search ($(tilde "$path")); $note" ;;
    esac
  done
  for note in "${NOTES[@]}"; do loud "$note"; done
}

run_search(){     # run_search <all> <mode> <query>
  local all="$1" mode="$2" q="$3" h label kind path rc=1 hits den qre=""
  # A pre-P8a ID (no machine letter) also matches its migrated letter form. Announced when
  # it resolves, so nobody reads an old citation as a current shape.
  if [ "$mode" = id ]; then
    case "$q" in
      D-[0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]-[0-9][0-9])
        qre="^## ${q%-*}-[A-Z]${q##*-} "
        printf 'decided: note: %s is the pre-2026-09-21 shape (no machine letter); also looking for %s.\n' "$q" "${q%-*}-?${q##*-}" >&2 ;;
    esac
  fi
  build_scope "$all"
  readable_homes || { print_home_notes; die_refused "no readable register in scope (this is not 'no decisions')"; }
  denominator; den="$DEN"
  [ "$TOTAL" -gt 0 ] || { print_home_notes; die_refused "the homes in scope hold no decision blocks ($den) -- this is not 'no decisions'"; }
  for h in "${HOMES[@]}"; do
    IFS=$'\t' read -r label kind path _ <<<"$h"
    case "$kind" in folder|file) ;; *) continue ;; esac
    hits="$(fblocks_of "$path" "$kind" | search_stream "$mode" "$q" "$qre")" && { printf '%s' "$hits"; printf '  [in %s]\n\n' "$label"; rc=0; }
  done
  if [ "$rc" -eq 0 ]; then printf 'decided: matched in %s.\n' "$den"; print_home_notes; return 0; fi
  if filtering; then
    # Say WHICH side emptied: the filter, or the words inside what passed it.
    printf 'decided: NO decision recorded matching: %s [%s]\n' "${q:-(any words)}" "$(filter_desc)" >&2
    printf 'decided: %s -- and a miss is NOT the same as "not decided".\n' "$den" >&2
    [ "$PASSED" -eq 0 ] && printf 'decided: the FILTER passed nothing, so no words were tested; drop or widen it before reading this as an answer.\n' >&2
    print_home_notes
    return 1
  fi
  # an ID not in scope: look everywhere once and say where it is, so a citation never dangles
  if [ "$mode" = id ] && [ "$all" -eq 0 ]; then
    HOMES=(); NOTES=(); build_scope 1
    for h in "${HOMES[@]}"; do
      IFS=$'\t' read -r label kind path _ <<<"$h"
      case "$kind" in folder|file) ;; *) continue ;; esac
      hits="$(blocks_of "$path" "$kind" | search_stream id "$q" "$qre")" && { printf '%s' "$hits"; printf '  [in %s -- OUTSIDE this project'"'"'s default scope; seen because you asked by ID]\n\n' "$label"; rc=0; }
    done
    [ "$rc" -eq 0 ] && { denominator; printf 'decided: %s found outside the default scope (%s).\n' "$q" "$DEN"; return 0; }
  fi
  printf 'decided: NO decision recorded matching: %s\n' "$q" >&2
  printf 'decided: %s -- and a miss is NOT the same as "not decided".\n' "$den" >&2
  printf 'decided: it means nothing is written down, so decide it and add a block (decided add).\n' >&2
  print_home_notes
  return 1
}

list_all(){       # list_all <all>
  local h label kind path
  build_scope "$1"
  readable_homes || { print_home_notes; die_refused "no readable register in scope"; }
  for h in "${HOMES[@]}"; do
    IFS=$'\t' read -r label kind path _ <<<"$h"
    case "$kind" in folder|file) ;; *) continue ;; esac
    fblocks_of "$path" "$kind" | grep '^## D-' | sed "s/^## /  /; s/\$/   [$label]/"
  done
  denominator; printf '\ndecided: %s.\n' "$DEN"
  print_home_notes
  if filtering && [ "$PASSED" -eq 0 ]; then
    printf 'decided: the filter [%s] passed nothing; a filtered empty list is NOT "no decisions".\n' "$(filter_desc)" >&2
    return 1
  fi
  return 0
}
show_homes(){
  local h label kind path note
  build_scope "$1"
  for h in "${HOMES[@]}"; do IFS=$'\t' read -r label kind path note <<<"$h"; printf '%-28s %-12s %s   (%s)\n' "$label" "$kind" "$(tilde "$path")" "$note"; done
  for note in "${NOTES[@]}"; do printf '%s\n' "$note"; done
}

# ---------------------------------------------------------------- writes ----
slug(){ printf '%s' "$1" | tr '[:upper:]' '[:lower:]' | sed 's/[^a-z0-9]\{1,\}/-/g; s/^-//; s/-$//' | awk '{ s=$0; if (length(s) > 48) { s=substr(s,1,48); sub(/-[^-]*$/, "", s) } print s }'; }
all_d_stores(){   # every place a D ID could already exist on this machine
  local w; printf '%s\n' "$GLOBAL_DIR"; [ -n "$PROJECT_STORE" ] && printf '%s\n' "$PROJECT_STORE"
  for w in "$PROJECTS"/*/memory/WORK/decisions; do [ -d "$w" ] && printf '%s\n' "$w"; done
  [ -e "$LEGACY" ] && printf '%s\n' "$LEGACY"; return 0
}
commit_path(){    # commit_path <file> <msg> -> 0 committed | 3 not committed
  local f="$1" msg="$2" top real rel out rc try=0
  top="$(git -C "$DOTCLAUDE" rev-parse --show-toplevel 2>/dev/null)" || { loud "NOT COMMITTED, $(tilde "$DOTCLAUDE") is not a git repo"; return 3; }
  top="$(realdir "$top")"; real="$(realdir "$(dirname "$f")")/$(basename "$f")"
  case "$real" in "$top"/*) rel="${real#"$top"/}" ;; *) loud "NOT COMMITTED, outside dot-claude: $(tilde "$real"). Commit it in its own repo."; return 3 ;; esac
  while :; do
    out="$(git -C "$top" add -- "$rel" 2>&1 && git -C "$top" commit -q -m "$msg" -- "$rel" 2>&1)"; rc=$?
    [ "$rc" -eq 0 ] && { loud "committed in dot-claude: $rel"; return 0; }
    case "$out" in *index.lock*|*"Unable to create"*|*"could not lock"*) try=$((try+1)); [ "$try" -lt 20 ] && { sleep 0.3; continue; } ;; esac
    break
  done
  loud "COMMIT FAILED (rc=$rc) -- the file is on disk at $(tilde "$real")"; printf '%s\n' "$out" | sed 's/^/decided:   /' >&2; return 3
}

cmd_add(){
  local title="" topic="" holds="" body="" ruled="" status="standing" where="" home id f top stores=() s
  while [ $# -gt 0 ]; do
    case "$1" in
      --topic) topic="${2:-}"; shift 2 ;;
      --holds-in) holds="${2:-}"; shift 2 ;;
      --body) body="${2:-}"; shift 2 ;;
      --ruled-by) ruled="${2:-}"; shift 2 ;;
      --status) status="${2:-}"; shift 2 ;;
      --global) where=global; shift ;;
      --project) where=project; shift ;;
      --*) die_refused "add: unknown flag $1" ;;
      *) [ -z "$title" ] && title="$1" || die_refused "add: one title only (quote it)"; shift ;;
    esac
  done
  [ -n "$title" ] || die_refused "add: a title is required"
  [ -n "$topic" ] || die_refused "add: --topic is required (the words someone would type to find this)"
  [ -n "$holds" ] || die_refused "add: --holds-in is required (the document that carries the reasoning)"
  [ -n "$where" ] || die_refused "add: say --global (machine-wide) or --project (this project's store)"
  case "$status" in standing|deferred|superseded) ;; *) die_refused "add: --status must be standing, deferred or superseded" ;; esac
  if [ "$where" = global ]; then home="$GLOBAL_DIR"
  else
    top="$(repo_top)" || die_refused "add --project: not inside a git repo"
    project_store "$top" || die_refused "add --project: $PROJECT_NOTE"
    home="$PROJECT_STORE"
    case "$(kind_of "$home")" in folder|missing) ;; *) die_refused "add --project: the declared store is not a folder of blocks ($(tilde "$home"))" ;; esac
  fi
  mkdir -p "$home" || die_refused "add: cannot create $(tilde "$home")"
  while IFS= read -r s; do stores+=("$s"); done < <(all_d_stores)
  # ID allocation, race-safe: `set -C` (noclobber) makes the create FAIL if the file is
  # already there, so a collision with a concurrent `decided add` retries with a fresh id.
  #
  # W-20260921-A30, FIXED HERE. This loop used to be `while :; do ... && break; done` with
  # the error binned, and it HUNG FOREVER inside the Claude Bash sandbox: ~/.claude is
  # outside the sandbox's writable set, so the create never succeeded, pj-id handed back
  # the same id every time, and nothing printed. Ten minutes, no output, killed by hand.
  #
  # THE BUG WAS NOT THE DENIED WRITE. It was that a failed `: > "$f"` means EITHER "the
  # file already exists" OR "I am not allowed to write here", and the loop treated both
  # as the first. A property true in both worlds cannot decide between them -- so the
  # test below is `[ -e "$f" ]`, which IS different in the two cases: a collision leaves
  # a file there, a refusal does not.
  #
  # Sibling tools already refuse with a reason in one line (claude-hooks-sync,
  # claude-project-settings-render). A tool that refuses is a finding; a tool that hangs
  # is a session sitting still while the next person assumes the machine is busy.
  local tries=0
  while :; do
    id="$(pj-id next D "${stores[@]}")" || exit 2
    f="$home/$id-$(slug "$title").md"
    ( set -C; : > "$f" ) 2>/dev/null && break
    if [ ! -e "$f" ]; then
      die_refused "add: cannot create $(tilde "$f") -- the create was REFUSED, not a name collision (the path does not exist afterwards). Inside the Claude Bash sandbox ~/.claude is not writable; run this from a terminal. Nothing was changed."
    fi
    tries=$((tries + 1))
    if [ "$tries" -ge 50 ]; then
      die_refused "add: gave up after $tries id attempts, every one colliding under $(tilde "$home"). That should be impossible -- check pj-id next. Nothing was changed."
    fi
  done
  {
    printf '## %s -- %s\n\ntopic: %s\ndecided: %s\nstatus: %s\nholds-in: %s\n' "$id" "$title" "$topic" "$(today)" "$status" "$holds"
    [ -n "$ruled" ] && printf 'ruled-by: %s\n' "$ruled"
    [ -n "$body" ] && printf '\n%s\n' "$body"
  } > "$f"
  printf '%s\n' "$id"
  loud "written: $(tilde "$f")"
  commit_path "$f" "decided: add $id -- $title"
}

cmd_withdraw(){
  local id="${1:-}" reason="${2:-}" top h label kind path f tmp m
  local idre=""
  case "$id" in
    D-[0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]-[A-Z][0-9][0-9]) ;;
    D-[0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]-[0-9][0-9]) idre="^## ${id%-*}-[A-Z]${id##*-} " ;;   # pre-P8a shape
    *) die_refused "withdraw: give a D-YYYYMMDD-LNN id (the pre-2026-09-21 D-YYYYMMDD-NN is accepted too)" ;;
  esac
  [ -n "$reason" ] || die_refused "withdraw: a reason is required"
  build_scope 0
  # EXACT first, across every folder home.
  for h in "${HOMES[@]}"; do
    IFS=$'\t' read -r label kind path _ <<<"$h"
    [ "$kind" = folder ] || continue
    f="$(grep -l "^## $id " "$path"/D-*.md 2>/dev/null | head -1)"; [ -n "$f" ] && break
  done
  # Only then the pre-P8a fallback, and it must COLLECT every candidate before choosing.
  # A bare -NN can answer to one block per machine letter, so `| head -1` would withdraw
  # whichever home happened to be searched first and commit the edit without a word. The
  # letter scheme is what CREATES that ambiguity, so the tool that reads old IDs has to
  # refuse it, exactly as `open-items find_item` does.
  if [ -z "$f" ] && [ -n "$idre" ]; then
    local hits="" n
    for h in "${HOMES[@]}"; do
      IFS=$'\t' read -r label kind path _ <<<"$h"
      [ "$kind" = folder ] || continue
      while IFS= read -r m; do [ -n "$m" ] && hits="$hits$m"$'\n'; done < <(grep -lE "$idre" "$path"/D-*.md 2>/dev/null)
    done
    hits="${hits%$'\n'}"
    if [ -n "$hits" ]; then
      n="$(printf '%s\n' "$hits" | wc -l | tr -d ' ')"
      if [ "$n" -gt 1 ]; then
        die_refused "withdraw: the legacy ID $id matches $n decisions after the P8a letter migration ($(printf '%s\n' "$hits" | while IFS= read -r m; do printf '%s ' "$(sed -n '1s/^## \([^ ]*\).*/\1/p' "$m")"; done)). Name the full ID; nothing was changed."
      fi
      f="$hits"
      loud "note: $id is the pre-2026-09-21 shape; resolved to $(sed -n '1s/^## \([^ ]*\).*/\1/p' "$f")"
    fi
  fi
  [ -n "$f" ] || die_refused "withdraw: $id is not in a folder home in scope (legacy single-file blocks are not edited by this tool)"
  # Report and COMMIT under the ID the file actually carries. Writing the typed legacy ID
  # into the register's git history would record a withdrawal of an ID that no longer
  # exists, and a commit message is the one place nobody greps by topic later.
  id="$(sed -n '1s/^## \([^ ]*\).*/\1/p' "$f")"
  grep -q '^status: withdrawn' "$f" && die_refused "withdraw: $id is already withdrawn"
  tmp="$f.tmp"
  awk -v d="$(today)" -v r="$reason" '/^status: /{ print "status: withdrawn"; print "withdrawn: " d " -- " r; next } { print }' "$f" > "$tmp" && mv "$tmp" "$f"
  loud "withdrawn: $id ($(tilde "$f"))"
  commit_path "$f" "decided: withdraw $id -- $reason"
}

# ---------------------------------------------------------------- main ----
ALL=0
case "${1:-}" in
  --selftest) DECIDED="$0" exec "$(dirname "$0")/decided-selftest" ;;   # this copy, not PATH's
  --help|-h|"") usage; exit 0 ;;
esac
[ "${1:-}" = --all ] && { ALL=1; shift; }
# add and withdraw keep their own flags (add has its own --status); pull the query
# filters out of every other call, wherever they sit on the line.
case "${1:-}" in
  add|withdraw) ;;
  *)
    REST=()
    while [ $# -gt 0 ]; do
      case "$1" in
        --status)
          F_STATUS="${2:-}"; shift 2 2>/dev/null || shift
          case "$F_STATUS" in standing|deferred|superseded|withdrawn) ;; *) die_refused "--status must be standing, deferred, superseded or withdrawn (got '$F_STATUS')" ;; esac ;;
        --since)
          F_SINCE="${2:-}"; shift 2 2>/dev/null || shift
          case "$F_SINCE" in [0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]) ;; *) die_refused "--since takes YYYY-MM-DD (got '$F_SINCE')" ;; esac ;;
        *) REST+=("$1"); shift ;;
      esac
    done
    set -- ${REST[@]+"${REST[@]}"}
    if filtering; then
      case "${1:-}" in
        --homes) die_refused "--status and --since filter a search or --list, not --homes" ;;
        D-[0-9]*) [ $# -eq 1 ] && die_refused "--status and --since filter a search or --list; an ID lookup is exact, drop the filter" ;;
      esac
    fi ;;
esac
case "${1:-}" in
  --list) shift; [ "${1:-}" = --all ] && ALL=1; list_all "$ALL"; exit $? ;;
  --homes) shift; [ "${1:-}" = --all ] && ALL=1; show_homes "$ALL"; exit 0 ;;
  --all) ALL=1; shift ;;
  add) shift; cmd_add "$@"; exit $? ;;
  withdraw) shift; cmd_withdraw "$@"; exit $? ;;
  "") filtering || { usage; exit 0; } ;;   # a filter alone lists every block that passes it
esac
if [ $# -eq 1 ]; then case "$1" in
  D-[0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]-[A-Z][0-9][0-9]) run_search "$ALL" id "$1"; exit $? ;;
  D-[0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]-[0-9][0-9])      run_search "$ALL" id "$1"; exit $? ;;   # pre-P8a shape, resolved in run_search
esac; fi
run_search "$ALL" words "$*"; exit $?
