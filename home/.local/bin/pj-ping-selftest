#!/bin/sh
# pj-ping-selftest -- the old name of engage-ping-selftest (wean B13, goal 16). It runs
# engage-ping-selftest with the same arguments, streams and exit code. It retires with the
# pj-ping stub, into ~/RETIRED, never the Trash.
"${ENGAGE_TRAP_GO:-$HOME/.local/bin/engage-go}" trap log --ppid "$PPID" --stub --tool pj-ping-selftest -- "$@" </dev/null >/dev/null 2>&1

self="$0"
while [ -L "$self" ]; do
  t=$(readlink "$self")
  case "$t" in /*) self="$t" ;; *) self="$(dirname "$self")/$t" ;; esac
done
target="$(dirname "$self")/engage-ping-selftest"
[ -x "$target" ] || target=$(command -v engage-ping-selftest 2>/dev/null)
if [ -z "$target" ] || [ ! -x "$target" ] || [ "$target" -ef "$self" ]; then
  echo "pj-ping-selftest: engage-ping-selftest not found beside $self or on PATH" >&2
  exit 127
fi
exec "$target" "$@"
