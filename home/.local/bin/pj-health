#!/usr/bin/env bash
# pj-health -- is the pj session framework wired on this machine? (D-20260920-09 c, P5.7)
#
# Usage:
#   pj-health                 machine checks, plus project checks for the repo you stand in,
#                             plus evidence checks read from that repo's newest pj transcript
#   pj-health --full          also run every framework selftest and quote its pass count
#   pj-health --live          also launch ONE headless pj probe (an API call, haiku) and
#                             check the start card printed and a dummy secret was denied
#   pj-health --profile <n>   grade the run as profile <n> (F5a): its declared config_dir
#                             decides where transcripts are looked for. Defaults to
#                             $PJ_PROFILE, which `pj` exports, then to `default`
#   pj-health --quiet         print only FAIL and NOT MEASURED rows (and the summary)
#   pj-health --json          one JSON object for scripts: rows, summary, exit code
#   pj-health --selftest      prove every arm against fixtures (runs pj-health-selftest)
#
# One row per check:  STATE  name  detail.  Four states, on purpose:
#   PASS          measured, wired as expected
#   WARN          measured, not a wiring fault (a pending hand edit, a fat first turn)
#   FAIL          measured, wired wrong; the detail says what to run to fix it
#   NOT MEASURED  the check could not reach its target; the detail says why. NEVER a pass.
# Exit 0 with no FAIL, 1 with any FAIL, 2 REFUSED (bad args, no jq). Same shape as
# Network_Plan's session-start.sh: a grader that cannot reach its box is not an outage.
#
# CONTRACT
#   1. READ-ONLY. Writes nothing but its own stdout. Never repairs: a FAIL prints the fix
#      command, never runs it (the hook-orphans `jq del` line above all).
#   2. Runs from any cwd, finishes in a few seconds without --full or --live.
#   3. Prints paths relative to ~. Never prints a rule's text or an item's title.
#   4. Other projects are read-only: running it inside them only reads.
#   5. The live setup is never broken to prove a FAIL; the selftest does that on fixtures.
#
# TOKEN BUDGET (E5, ruled at the P5.7 gate: WARN, never FAIL, a long first message is not
# a wiring fault). The first API call's input + cache-create + cache-read tokens:
#   dotfiles repo   baseline 70,000 (P5.4: hello turn 68,977; system prompt about 9.7k)
#   any other repo  baseline = median of that repo's last 5 interactive pj transcripts,
#                   needing at least 3, else NOT MEASURED
#   budget = baseline + 15 percent.  A --live probe's figure is an UNDER-READ (P5.4).
#
# TEST SEAMS (each replaces one real path; the selftest sets them, nobody else should):
#   PJ_HOME              ~/.claude              PJ_BIN_DIR         ~/.local/bin
#   PJ_DOTFILES          the dotfiles checkout (default: resolved from this script's link)
#   PJ_LAUNCHER          a `pj` to --dry-run instead of ~/.local/bin/pj; setting it is
#                        FIXTURE MODE (no zsh -ic, no live launch, $HOME/.claude -> PJ_HOME)
#   PJ_TYPE_OUT          file holding what `zsh -ic 'whence -w pj; alias pj'` would print
#   PJ_PS_OUT            file holding a `ps -axo pid=,ppid=,tty=,lstart=,command=` listing
#   PJ_ZSHRC_MTIME       epoch to use as ~/.zshrc's real mtime
#   PJ_TRANSCRIPTS_DIR   ~/.claude/projects     PJ_STATE_DIR       ~/.local/state/pj
#   PJ_TRAILER_REPOS     space-separated repos the commit-trailer row reads
#   PJ_HEALTH_HERDR      the herdr binary the stale-workspaces row calls
#   PJ_HEALTH_DRIFT      the herdr-skill-drift-check the skill-upstream row calls.
#                        Its FAIL and WARN branches are unreachable on a machine
#                        whose snapshot is current, which is how you ship a row
#                        that can only ever print PASS
#   plus the seams the tools already honour and pass through untouched: PJ_MACHINE_FILE,
#   PJ_PROMPT_SOURCES, PJ_PROMPT_OUT, OPEN_ITEMS_PROJECTS_DIR, DECIDED_GLOBAL_DIR,
#   CLAUDE_PROJECT_SETTINGS_FILE, CLAUDE_PROJECT_SETTINGS_TEMPLATE, CLAUDE_HOOKS_MANIFEST.
set -u

DOTFILES_BASELINE=70000
BUDGET_MARGIN_PCT=15
BASELINE_MIN_TRANSCRIPTS=3
BASELINE_WINDOW=5
FRAMEWORK_TOOLS="pj pj-launch-check pj-prompt-file pj-start-card pj-session-end pj-wrap pj-id open-items decided claude-hooks-sync claude-project-settings-render ci-watch ccw-watch pj-health"
SELFTESTS="pj:--selftest pj-launch-check:--selftest pj-start-card-selftest pj-session-end-selftest pj-wrap-selftest pj-prompt-file:--selftest pj-id:--selftest open-items-selftest decided-selftest claude-hooks-sync-selftest claude-project-settings-render-selftest ccw-watch-selftest ci-watch-selftest pj-health-selftest audit-chain-selftest c2:--selftest pj-launcher-menu:--selftest"
HOOK_SELFTESTS="enforce-secret-probe.sh validate-bash.sh enforce-uv.sh enforce-pnpm.sh pj-voice-contract.sh"
PLUGIN_DIRS_EXPECTED="skills/herdr skills/AgentRelay skills/ISA pj-voice pj"
LAUNCH_LOG_WINDOW=20

FULL=0; LIVE=0; QUIET=0; JSON=0
PROFILE="${PJ_PROFILE:-default}"
_want_profile=0
for a in "$@"; do
  if [ "$_want_profile" -eq 1 ]; then PROFILE="$a"; _want_profile=0; continue; fi
  case "$a" in
    --full) FULL=1 ;; --live) LIVE=1 ;; --quiet) QUIET=1 ;; --json) JSON=1 ;;
    --profile) _want_profile=1 ;;
    --profile=*) PROFILE="${a#--profile=}" ;;
    --selftest) exec pj-health-selftest ;;
    -h|--help) sed -n '2,45p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) echo "pj-health: REFUSED unknown arg: $a (--help)" >&2; exit 2 ;;
  esac
done
[ "$_want_profile" -eq 1 ] && { echo "pj-health: REFUSED: --profile needs a name" >&2; exit 2; }
command -v jq >/dev/null 2>&1 || { echo "pj-health: REFUSED: jq is required" >&2; exit 2; }

PJ_HOME="${PJ_HOME:-$HOME/.claude}"
PJ_BIN_DIR="${PJ_BIN_DIR:-$HOME/.local/bin}"
PJ_STATE_DIR="${PJ_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/pj}"
SETTINGS_PROJECT="${CLAUDE_PROJECT_SETTINGS_FILE:-$PJ_HOME/settings.project.json}"
MACHINE_FILE="${PJ_MACHINE_FILE:-$HOME/.config/pj/machine}"
PROFILE_DIR="${PJ_PROFILE_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/pj/profiles}"

# --- profiles and the three roots (F5a) --------------------------------------------
# RECORDS is always $PJ_HOME (~/.claude): the drawer, the rulings, pj-global, the project
# settings, the plugin dirs. MACHINE is always $PJ_STATE_DIR and the machine file. Only
# CONFIG moves with a profile, and the only CONFIG reader in this tool is the transcript
# search below.
profile_key(){   # profile_key <name> <key> -> value, or nothing
  local f="$PROFILE_DIR/$1"
  [ -r "$f" ] || return 0
  sed -n "s/^$2:[[:space:]]*//p" "$f" 2>/dev/null | sed 's/[[:space:]]*$//' | head -1
}
expand_tilde(){ case "$1" in '~/'*) printf '%s/%s' "$HOME" "${1#\~/}" ;; *) printf '%s' "$1" ;; esac; }
PROFILE_CONFIG_DIR="$(expand_tilde "$(profile_key "$PROFILE" config_dir)")"
[ -n "$PROFILE_CONFIG_DIR" ] || PROFILE_CONFIG_DIR="$PJ_HOME"
PJ_TRANSCRIPTS_DIR="${PJ_TRANSCRIPTS_DIR:-$PROFILE_CONFIG_DIR/projects}"
if [ -z "${PJ_DOTFILES:-}" ]; then
  _self="$(readlink -f "$0" 2>/dev/null || echo "$0")"
  PJ_DOTFILES="$(dirname "$(dirname "$(dirname "$(dirname "$_self")")")")"
fi
PJ_DOTFILES="$(readlink -f "$PJ_DOTFILES" 2>/dev/null || printf '%s' "$PJ_DOTFILES")"   # /tmp is a symlink on macOS
MANIFEST="${CLAUDE_HOOKS_MANIFEST:-$PJ_DOTFILES/settings/claude/hooks.json}"

tilde(){ printf '%s' "${1/#$HOME/\~}"; }

# ---------------------------------------------------------------- rows ----
ROWS_JSON='[]'
n_pass=0; n_warn=0; n_fail=0; n_notm=0
row(){   # row STATE name detail
  local st="$1" name="$2" det="${3:-}"
  case "$st" in PASS) n_pass=$((n_pass+1));; WARN) n_warn=$((n_warn+1));; FAIL) n_fail=$((n_fail+1));; NOTM) n_notm=$((n_notm+1));; esac
  local label="$st"; [ "$st" = NOTM ] && label="NOT MEASURED"
  ROWS_JSON="$(jq -c --arg s "$label" --arg n "$name" --arg d "$det" '. + [{state:$s,name:$n,detail:$d}]' <<<"$ROWS_JSON")"
  if [ "$JSON" -eq 0 ]; then
    if [ "$QUIET" -eq 0 ] || [ "$st" = FAIL ] || [ "$st" = NOTM ]; then
      printf '%-12s %-18s %s\n' "$label" "$name" "$det"
    fi
  fi
}

# ---------------------------------------------------------- project ctx ----
# --git-common-dir, not --show-toplevel: from inside a linked worktree the first gives the
# MAIN repo, which is the key open-items, pj-start-card, pj-session-end, decided and (since
# F5a) pj-launch-check all use. A c2 session runs in a worktree, so this tool would
# otherwise look for its evidence under a key nothing writes.
# KEY and PROJECT are initialised HERE, not only inside the in-repo branch. `set -u` is on,
# so an unset KEY is a fatal error the moment anything outside that branch names it -- which
# is exactly what the F5a transcript search did, killing every outside-a-repo row until the
# selftest caught it.
TOPLEVEL=""; IN_REPO=0; KEY=""; PROJECT=""
if _gcd="$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null)" && [ -n "$_gcd" ]; then
  TOPLEVEL="$(dirname "$_gcd")"; IN_REPO=1
fi
if [ "$IN_REPO" -eq 1 ]; then
  KEY="$(printf '%s' "$TOPLEVEL" | sed 's#[/._]#-#g')"
  PROJECT="$(basename "$TOPLEVEL")"
fi

[ "$JSON" -eq 0 ] && { if [ "$IN_REPO" -eq 1 ]; then echo "pj-health: $PROJECT"; else echo "pj-health: (not in a git repo: machine checks only)"; fi; }

# =============================================================== MACHINE ==
# M1 launcher (F3: `pj` is a SCRIPT; an alias shadows it and goes stale, so an alias is a FAIL)
PLUGIN_DIRS=""
if [ -n "${PJ_LAUNCHER:-}" ]; then
  launcher="$PJ_LAUNCHER"; type_out="$(cat "${PJ_TYPE_OUT:-/dev/null}" 2>/dev/null)"; lsrc="fixture"
else
  launcher="$PJ_BIN_DIR/pj"; type_out="$(timeout 5 zsh -ic 'whence -w pj; alias pj' 2>/dev/null)"; lsrc="fresh zsh -ic"
fi
kind="$(printf '%s\n' "$type_out" | sed -n 's/^pj: //p' | head -1)"      # command | alias | function | none
if [ -z "$kind" ]; then
  row NOTM launcher "$lsrc printed nothing for \`whence -w pj\` (timed out?); fix: in a terminal, whence -w pj"
elif [ "$kind" = alias ]; then
  row FAIL launcher "$lsrc: pj is an ALIAS, which shadows ~/.local/bin/pj and goes stale (F3): $(printf '%s\n' "$type_out" | sed -n 2p | cut -c1-70); fix: remove \`alias pj\` from .zshrc/.zshrc.private, open a new shell"
elif [ "$kind" != command ]; then
  row FAIL launcher "$lsrc: pj resolves to a $kind, expected the command ~/.local/bin/pj; fix: stow -R the dotfiles, open a new shell"
elif [ ! -x "$launcher" ]; then
  row FAIL launcher "$(tilde "$launcher") missing or not executable; fix: stow -R the dotfiles"
else
  dry="$(timeout 10 "$launcher" --dry-run 2>/dev/null)"; drc=$?
  if [ "$drc" -ne 0 ] || [ -z "$dry" ]; then
    row FAIL launcher "pj --dry-run rc $drc, no argv; fix: pj --selftest, pj-prompt-file --selftest"
  else
    missing=""
    { grep -qx -- '--setting-sources' <<<"$dry" && grep -qx -- 'project,local' <<<"$dry"; } || missing="$missing [--setting-sources project,local]"
    grep -qE -- "^(~|\\\$HOME|$HOME)/\.claude/settings\.project\.json$" <<<"$dry" || missing="$missing [--settings ~/.claude/settings.project.json]"
    pf="$(awk '$0=="--append-system-prompt-file"{getline; print; exit}' <<<"$dry")"
    expf="$(pj-prompt-file --path 2>/dev/null || true)"
    { [ -n "$pf" ] && [ -n "$expf" ] && [ "$pf" = "$expf" ]; } || missing="$missing [--append-system-prompt-file $(tilde "${expf:-<pj-prompt-file --path>}") got $(tilde "${pf:-nothing}")]"
    PLUGIN_DIRS="$(awk '$0=="--plugin-dir"{getline; print}' <<<"$dry")"
    pd_n="$(printf '%s\n' "$PLUGIN_DIRS" | grep -c . || true)"
    for d in $PLUGIN_DIRS_EXPECTED; do   # exact entry: ~/.claude/pj must not be satisfied by ~/.claude/pj-voice
      printf '%s\n' "$PLUGIN_DIRS" | grep -qE "^(~|\\\$HOME|$HOME)/\.claude/$d/?$" || missing="$missing [--plugin-dir ~/.claude/$d]"
    done
    if [ -z "$missing" ] && [ "$pd_n" -eq 5 ]; then
      row PASS launcher "$(tilde "$launcher") is a command, no alias ($lsrc); dry-run carries setting-sources, settings file, prompt cache, 5 plugin dirs"
    else
      row FAIL launcher "pj --dry-run is missing:${missing:- (plugin-dir count $pd_n, expected 5)}; fix: stow -R the dotfiles, pj --selftest"
    fi
  fi
fi

# M2 output style
if [ -r "$SETTINGS_PROJECT" ]; then
  os="$(jq -r '.outputStyle // ""' "$SETTINGS_PROJECT" 2>/dev/null)"
  sf="$PJ_HOME/pj-voice/output-styles/pj-voice.md"
  if [ "$os" = "pj-voice:pj-voice" ] && [ -f "$sf" ]; then
    row PASS output-style "settings.project.json outputStyle pj-voice:pj-voice; style file present"
  elif [ "$os" != "pj-voice:pj-voice" ]; then
    row FAIL output-style "outputStyle is '${os:-unset}', expected pj-voice:pj-voice; fix: claude-project-settings-render --install (terminal)"
  else
    row FAIL output-style "style file $(tilde "$sf") missing; fix: restore ~/.claude/pj-voice in dot-claude"
  fi
else
  row NOTM output-style "$(tilde "$SETTINGS_PROJECT") unreadable; fix: claude-project-settings-render --install (terminal)"
fi

# M3 plugin dirs
if [ -z "$PLUGIN_DIRS" ]; then PLUGIN_DIRS="$(for d in $PLUGIN_DIRS_EXPECTED; do echo "$PJ_HOME/$d"; done)"; fi
bad=""; ok=0
while IFS= read -r d; do
  [ -z "$d" ] && continue
  real="${d/#\~/$HOME}"; real="${real/#\$HOME/$HOME}"
  [ -n "${PJ_LAUNCHER:-}" ] && real="${real/#$HOME\/.claude/$PJ_HOME}"   # fixture mode
  if [ ! -d "$real" ]; then bad="$bad $(tilde "$real")(missing)"
  elif [ -f "$real/.claude-plugin/plugin.json" ] || [ -f "$real/SKILL.md" ] || ls "$real"/skills/*/SKILL.md >/dev/null 2>&1 || ls "$real"/output-styles/*.md >/dev/null 2>&1; then ok=$((ok+1))
  else bad="$bad $(tilde "$real")(no manifest, skill or output style)"; fi
done <<<"$PLUGIN_DIRS"
if [ -z "$bad" ]; then row PASS plugin-dirs "$ok of $ok hold a plugin manifest, a skill or an output style"
else row FAIL plugin-dirs "$bad; fix: restore the folder in dot-claude or the dotfiles stow"; fi

# M4 prompt file
SOURCES="${PJ_PROMPT_SOURCES:-$PJ_HOME/LIFEOS/USER/CONFIG/OPERATIONAL_RULES.md:$PJ_HOME/pj-global/RULES.md}"
miss=""; IFS=':' read -r -a srcs <<<"$SOURCES"
for s in "${srcs[@]}"; do [ -r "$s" ] || miss="$miss $(tilde "$s")"; done
if [ -n "$miss" ]; then
  row NOTM prompt-file "source missing:$miss; fix: restore it, then pj-prompt-file"
elif ! command -v pj-prompt-file >/dev/null 2>&1; then
  row NOTM prompt-file "pj-prompt-file not on PATH; fix: stow -R the dotfiles"
else
  out="$(pj-prompt-file 2>/dev/null)"; prc=$?
  if [ $prc -ne 0 ] || [ -z "$out" ] || [ ! -r "$out" ]; then
    row FAIL prompt-file "pj-prompt-file rc $prc, output '${out:-none}'; fix: pj-prompt-file --selftest"
  else
    fellback=0; for s in "${srcs[@]}"; do [ "$out" = "$s" ] && fellback=1; done
    if [ $fellback -eq 1 ]; then
      row NOTM prompt-file "pj-prompt-file fell back to $(tilde "$out") (cache not writable from here, e.g. a sandbox); run pj-health from a terminal"
    elif cmp -s <(first=1; for s in "${srcs[@]}"; do [ $first -eq 0 ] && printf '\n'; cat "$s"; first=0; done) "$out"; then
      row PASS prompt-file "$(tilde "$out") = $(for s in "${srcs[@]}"; do basename "$s"; done | paste -sd+ -) byte for byte ($(wc -c <"$out" | tr -d ' ') bytes)"
    else
      row FAIL prompt-file "$(tilde "$out") differs from its sources; fix: pj-prompt-file (rebuilds), then pj-prompt-file --selftest"
    fi
  fi
fi

# M5 rules budget
#
# THE CAP USED TO BE 60 LINES AND IT NEVER BOUND. Measured at P9 2026-09-22:
# RULES.md was 31 lines of its 60 while six approved pinned lines had already
# been cut from it, and they were cut by a 1.5k /context reading the line count
# could not see. A line cap cannot tell a 40-character line from a 400-character
# one, so it was watching the wrong quantity the whole time -- the exact shape
# this repo keeps recording, a check that returns the same answer either way.
#
# So the budget is TOKENS. The divisor is measured on this text, not guessed:
# removing RULES.md entirely from a real pj launch moved the first turn from
# 62,162 to 60,561, so 3,930 characters cost 1,601 tokens, 2.45 chars/token.
# Six single-line probes agreed within 7% of the all-six probe. Budget ruled by
# Gavin at the P9 gate. Raise it deliberately, with a measurement, never to make
# a red row go green.
RULES_TOKEN_BUDGET="${PJ_RULES_TOKEN_BUDGET:-2200}"
RULES_CHARS_PER_TOKEN=245 # x100, integer maths only
RULES="$PJ_HOME/pj-global/RULES.md"
if [ -r "$RULES" ]; then
  rb="$(wc -c <"$RULES" | tr -d ' ')"
  rl="$(wc -l <"$RULES" | tr -d ' ')"
  rt=$((rb * 100 / RULES_CHARS_PER_TOKEN))
  if [ "$rt" -le "$RULES_TOKEN_BUDGET" ]; then
    row PASS rules-budget "RULES.md ~$rt of $RULES_TOKEN_BUDGET tokens ($rb bytes, $rl lines, 2.45 chars/token measured P9)"
  else
    row FAIL rules-budget "RULES.md ~$rt tokens over budget $RULES_TOKEN_BUDGET ($rb bytes, $rl lines); fix: move lines to pj-global/notes/ and add a pointer to INDEX.md, or raise PJ_RULES_TOKEN_BUDGET with a measurement"
  fi
else
  row NOTM rules-budget "$(tilde "$RULES") absent"
fi

# M6 settings render
if command -v claude-project-settings-render >/dev/null 2>&1; then
  rout="$(claude-project-settings-render --check 2>&1)"; rrc=$?
  if [ $rrc -eq 0 ]; then row PASS settings-render "claude-project-settings-render --check: current"
  else row FAIL settings-render "--check rc $rrc: $(printf '%s' "$rout" | grep -v '^\s*$' | tail -1 | cut -c1-100); fix: claude-project-settings-render --install (terminal)"; fi
else
  row NOTM settings-render "claude-project-settings-render not on PATH; fix: stow -R the dotfiles"
fi

# M7 hooks sync (direct triple comparison; the sync tool refuses --check inside a sandbox)
if [ -r "$MANIFEST" ] && [ -r "$SETTINGS_PROJECT" ]; then
  unreg="$(jq -r --slurpfile s "$SETTINGS_PROJECT" '
    ($s[0].hooks // {}) as $H
    | [ .hooks[]
        | select(((.targets // ["user"]) | index("project")) != null)
        | . as $e
        | ($H[$e.event] // []) as $groups
        | ([ $groups[] | select(($e.matcher == null) or (.matcher == $e.matcher)) | .hooks[]? | .command ]) as $cmds
        | select(($cmds | index($e.entry.command)) == null)
        | $e.script + " (" + $e.event + (if $e.matcher then "/" + $e.matcher else "" end) + ")" ]
    | join(", ")' "$MANIFEST" 2>/dev/null)"; jrc=$?
  total="$(jq -r '[.hooks[] | select(((.targets // ["user"]) | index("project")) != null)] | length' "$MANIFEST" 2>/dev/null)"
  note=""
  if command -v claude-hooks-sync >/dev/null 2>&1; then
    sout="$(claude-hooks-sync --target project --check 2>&1)"
    case "$sout" in *"not writable from here"*) note="; sync tool refused --check in the sandbox, direct comparison used";; *pending*|*unregistered*) note="; sync tool: $(printf '%s' "$sout" | grep -iE 'pending|unregistered' | tail -1 | cut -c1-60)";; esac
  fi
  if [ $jrc -ne 0 ]; then row NOTM hooks-sync "manifest or settings file did not parse as JSON"
  elif [ -z "$unreg" ]; then row PASS hooks-sync "$total project-target manifest entries registered in settings.project.json$note"
  else row FAIL hooks-sync "not registered: $unreg; fix: claude-hooks-sync --target project --install (terminal)$note"; fi
else
  row NOTM hooks-sync "manifest $(tilde "$MANIFEST") or $(tilde "$SETTINGS_PROJECT") unreadable"
fi

# M8 hook orphans (the P5.2 rollback gap: sync tools are add-only)
PROJ_CMDS=""
if [ -r "$SETTINGS_PROJECT" ]; then
  PROJ_CMDS="$(jq -r '.hooks // {} | to_entries[] | .key as $e | .value[] | .hooks[]? | "\($e)\t\(.command)"' "$SETTINGS_PROJECT" 2>/dev/null)"
  orphans=""; cnt=0; fixes=""
  while IFS=$'\t' read -r ev cmd; do
    [ -z "$cmd" ] && continue
    cnt=$((cnt+1))
    p="$(printf '%s' "$cmd" | grep -oE '"?\$HOME/[^" ]+' | head -1 | tr -d '"')"
    [ -z "$p" ] && continue
    real="${p/#\$HOME/$HOME}"
    [ -n "${PJ_LAUNCHER:-}" ] && real="${real/#$HOME\/.claude/$PJ_HOME}"   # fixture mode
    if [ ! -x "$real" ]; then
      orphans="$orphans $(basename "$p")"
      fixes="$fixes\n  jq '(.hooks.\"$ev\"[].hooks) |= map(select(.command != $(jq -Rn --arg c "$cmd" '$c')))' $(tilde "$SETTINGS_PROJECT")"
    fi
  done <<<"$PROJ_CMDS"
  if [ -z "$orphans" ]; then row PASS hook-orphans "$cnt registered commands resolve to an executable"
  else row FAIL hook-orphans "orphan(s):$orphans; the remove line(s), NOT run:$(printf '%b' "$fixes")"; fi
else
  row NOTM hook-orphans "$(tilde "$SETTINGS_PROJECT") unreadable"
fi

# M9 single fire
if [ "$IN_REPO" -eq 0 ]; then
  row NOTM hook-single-fire "not in a git repo"
elif [ ! -r "$TOPLEVEL/.claude/settings.json" ]; then
  row NOTM hook-single-fire "project has no .claude/settings.json (nothing to double)"
elif [ -z "$PROJ_CMDS" ]; then
  row NOTM hook-single-fire "$(tilde "$SETTINGS_PROJECT") unreadable"
else
  dup="$(jq -r --slurpfile p "$SETTINGS_PROJECT" '
      [ $p[0].hooks // {} | to_entries[] | .value[] | .hooks[]? | .command ] as $pc
      | [ .hooks // {} | to_entries[] | .value[] | .hooks[]? | .command | select(. as $c | $pc | index($c)) ]
      | unique | join(", ")' "$TOPLEVEL/.claude/settings.json" 2>/dev/null)"
  if [ -z "$dup" ]; then row PASS hook-single-fire "no command in both settings.project.json and .claude/settings.json"
  else row FAIL hook-single-fire "in both files: $(printf '%s' "$dup" | cut -c1-120); fix: remove it from .claude/settings.json (P5.6 rule)"; fi
fi

# M10 stow links
dangling=""; notlink=""; nlinks=0
check_link(){   # check_link <path>
  local p="$1"
  if [ -L "$p" ]; then
    local t; t="$(readlink -f "$p" 2>/dev/null || true)"
    if [ -z "$t" ] || [ ! -e "$t" ]; then dangling="$dangling $(tilde "$p")"
    else case "$t" in "$PJ_DOTFILES"/home/*) nlinks=$((nlinks+1));; *) notlink="$notlink $(tilde "$p")(outside dotfiles)";; esac; fi
  elif [ -e "$p" ]; then notlink="$notlink $(tilde "$p")(real file)"
  else dangling="$dangling $(tilde "$p")(absent)"; fi
}
if [ ! -d "$PJ_DOTFILES/home" ]; then
  row NOTM stow-links "dotfiles checkout not found at $(tilde "$PJ_DOTFILES")"
else
  for t in $FRAMEWORK_TOOLS; do check_link "$PJ_BIN_DIR/$t"; done
  if [ -r "$MANIFEST" ]; then
    while IFS= read -r s; do [ -n "$s" ] && check_link "${s/#\$HOME\/.claude/$PJ_HOME}"; done <<<"$(jq -r '.hooks[] | select(.script_path == null) | "$HOME/.claude/hooks/" + .script' "$MANIFEST" 2>/dev/null | sort -u)"
  fi
  check_link "$PJ_HOME/pj/.claude-plugin/plugin.json"
  for f in "$PJ_HOME"/pj/skills/*/SKILL.md; do [ -e "$f" ] || [ -L "$f" ] && check_link "$f"; done
  if [ -z "$dangling" ] && [ -z "$notlink" ]; then row PASS stow-links "$nlinks links resolve into $(tilde "$PJ_DOTFILES")/home"
  else row FAIL stow-links "${dangling:+dangling:$dangling }${notlink:+not a dotfiles link:$notlink}; fix: stow -R --no-folding -t ~ -d $(tilde "$PJ_DOTFILES") home"; fi
fi

# M10b bin-strays (P8b, 2026-09-21). WARN, NEVER FAIL, and the reason matters:
# a real file in ~/.local/bin is not a fault. Some are legitimate tool installs
# (uv, bun and claude all link their own binaries in here) and some belong to
# ANOTHER project and are simply parked on this machine. What is worth saying out
# loud is that a real file there is versioned NOWHERE unless some repo claims it,
# and nothing else on this box reports that. Measured 2026-09-21: 96 entries, 71
# stow links into the dotfiles repo, 22 links into uv/bun/claude installs, and 3
# real files -- one of which (risk-watch) is LOADED at every c session start and
# exists in no repo at all.
#
# Tool-install links are NOT strays and are not counted: they point into
# ~/.local/share or ~/.bun, which is where those installers put things.
if [ ! -d "$PJ_BIN_DIR" ]; then
  row NOTM bin-strays "$(tilde "$PJ_BIN_DIR") does not exist"
else
  nbin=0; nstow=0; ntool=0; strays=""
  while IFS= read -r f; do
    [ -n "$f" ] || continue
    nbin=$((nbin + 1)); b="${f##*/}"
    if [ -L "$f" ]; then
      t="$(readlink "$f")"
      case "$t" in
        *"${PJ_DOTFILES##*/}"*)                      nstow=$((nstow + 1)) ;;
        */.local/share/*|*/.bun/*|*/.local/state/*)  ntool=$((ntool + 1)) ;;
        *)                                           strays="$strays $b" ;;
      esac
    else
      strays="$strays $b"
    fi
  done <<EOF
$(find "$PJ_BIN_DIR" -mindepth 1 -maxdepth 1 -print 2>/dev/null)
EOF
  # Stated POSITIVELY on a clean run: a row that only speaks when something is
  # wrong leaves every quiet run ambiguous, which is the bug this whole file is
  # about. The denominator goes in both branches.
  if [ -z "$strays" ]; then
    row PASS bin-strays "$nbin entries: $nstow dotfiles links, $ntool tool-install links, 0 in no repo"
  else
    row WARN bin-strays "$nbin entries ($nstow dotfiles links, $ntool tool-install links); in NO repo:$strays -- versioned nowhere, so a rebuild loses them. Not a fault: adopt into a repo, or record as deliberately local"
  fi
fi

# M11 machine file. The two-range scheme (range: 01-49 / 50-99) was RETIRED on 2026-09-21
# (P8a gate Q6): the ID carries a machine letter instead. A file still holding only a range
# is a FAIL, not a pass -- pj-id refuses to allocate from it, so `open-items add` is dead on
# that box, and a row that shrugged at it would hide the reason.
if [ -r "$MACHINE_FILE" ]; then
  ml="$(sed -n 's/^letter:[[:space:]]*//p' "$MACHINE_FILE" | head -1 | tr -d '[:space:]')"
  mr="$(sed -n 's/^range:[[:space:]]*//p' "$MACHINE_FILE" | head -1 | tr -d '[:space:]')"
  mn="$(sed -n 's/^name:[[:space:]]*//p' "$MACHINE_FILE" | head -1 | tr -d '[:space:]')"
  case "$ml" in
    [A-Z])
      if [ -z "$mn" ]; then row FAIL machine-file "$(tilde "$MACHINE_FILE") has no name:; fix: add 'name: <host>'"
      elif [ -n "$mr" ]; then row WARN machine-file "$(tilde "$MACHINE_FILE"): $mn, letter $ml -- and a retired 'range: $mr' line no tool reads; fix: delete the range line"
      else row PASS machine-file "$(tilde "$MACHINE_FILE"): $mn, letter $ml (IDs are X-YYYYMMDD-$ml""NN)"; fi ;;
    "")
      if [ -n "$mr" ]; then row FAIL machine-file "$(tilde "$MACHINE_FILE") still carries the retired 'range: $mr' and no 'letter:'; pj-id REFUSES to allocate; fix: run ./install.sh in the dotfiles repo (it rewrites this file once)"
      else row FAIL machine-file "$(tilde "$MACHINE_FILE") has no 'letter:'; pj-id REFUSES to allocate; fix: run ./install.sh, or add 'letter: <A-Z>' (A mini, B Intel laptop, C WSL, D Linux VM)"; fi ;;
    *) row FAIL machine-file "$(tilde "$MACHINE_FILE") letter '$ml' is not one capital A-Z; fix: set 'letter: A' (mini), B (Intel laptop), C (WSL) or D (Linux VM)";;
  esac
elif [ -e "$MACHINE_FILE" ]; then
  row FAIL machine-file "$(tilde "$MACHINE_FILE") exists but is unreadable; fix: chmod u+r"
else
  row FAIL machine-file "$(tilde "$MACHINE_FILE") absent, so this machine has no letter and pj-id REFUSES every allocation; fix: run ./install.sh in the dotfiles repo"
fi

# M12 pj-global
PG="$PJ_HOME/pj-global"; pgmiss=""
for f in RULES.md decisions notes/INDEX.md; do [ -e "$PG/$f" ] || pgmiss="$pgmiss $f"; done
if [ -n "$pgmiss" ]; then
  row FAIL pj-global "$(tilde "$PG") missing:$pgmiss; fix: restore from dot-claude"
elif ! command -v decided >/dev/null 2>&1; then
  row NOTM pj-global "files present; decided not on PATH"
else
  dout="$( (builtin cd / && decided --list 2>&1) )"; drc=$?
  mw="$(printf '%s' "$dout" | grep -oE 'machine-wide [0-9]+' | tail -1 | awk '{print $2}')"
  if [ $drc -le 1 ] && [ -n "$mw" ]; then row PASS pj-global "RULES.md, decisions/, notes/INDEX.md present; decided --list outside a repo: machine-wide $mw"
  else row FAIL pj-global "files present but decided --list rc $drc outside a repo: $(printf '%s' "$dout" | tail -1 | cut -c1-80); fix: decided --selftest"; fi
fi

# M13 no-wrap-up records (informational)
NW="$PJ_STATE_DIR/no-wrap-up"
if [ -d "$NW" ]; then
  if [ -r "$NW" ]; then
    np=0; nr=0
    for f in "$NW"/*; do [ -f "$f" ] || continue; np=$((np+1)); c="$(grep -c '^session:' "$f" 2>/dev/null || true)"; nr=$((nr+${c:-0})); done
    row PASS no-wrap-up "$np project(s) with unwrapped sessions, $nr record(s) (informational; pj-wrap status lists them)"
  else row NOTM no-wrap-up "$(tilde "$NW") unreadable"; fi
else
  row PASS no-wrap-up "0 projects with unwrapped sessions (folder not created yet)"
fi

# M14 selftests
stmiss=""; stn=0; stres=""; stfail=""
run_selftest(){   # run_selftest <label> <cmd...>
  local label="$1"; shift
  local out rc last
  out="$("$@" 2>&1)"; rc=$?
  last="$(printf '%s\n' "$out" | grep -v '^[[:space:]]*$' | tail -1 | cut -c1-60)"
  [ $rc -eq 0 ] && stres="$stres $label: ${last:-ok};" || stfail="$stfail $label (rc $rc: ${last:-no output});"
}
for s in $SELFTESTS; do
  name="${s%%:*}"; flag=""; case "$s" in *:*) flag="${s#*:}";; esac
  if ! command -v "$name" >/dev/null 2>&1; then stmiss="$stmiss $name"; continue; fi
  stn=$((stn+1))
  [ "$FULL" -eq 1 ] && { if [ -n "$flag" ]; then run_selftest "$name" "$name" "$flag"; else run_selftest "$name" "$name"; fi; }
done
for h in $HOOK_SELFTESTS; do
  hp="$PJ_HOME/hooks/$h"
  if [ ! -x "$hp" ]; then stmiss="$stmiss $h"; continue; fi
  stn=$((stn+1))
  [ "$FULL" -eq 1 ] && run_selftest "$h" "$hp" --selftest
done
if [ -n "$stmiss" ]; then row FAIL selftests "missing:$stmiss; fix: stow -R the dotfiles"
elif [ "$FULL" -eq 0 ]; then row PASS selftests "$stn selftests present, not run (--full runs them)"
elif [ -n "$stfail" ]; then row FAIL selftests "$stn run, failing:$stfail"
else row PASS selftests "$stn run, all rc 0:$stres"; fi

# M14b profile (F5a). Which profile this run is grading, and whether its declared
# config_dir exists yet. A config dir that does not exist is a WARN, not a FAIL: it is the
# NORMAL state of a freshly declared profile, and it names the one thing only a human can
# do. Measured 2026-09-21: a fresh CLAUDE_CONFIG_DIR exits 1 with "Not logged in - Please
# run /login", and separately refuses the workspace until a trust dialog is accepted. This
# row is what stops that being discovered at the moment you wanted to work.
if [ ! -d "$PROFILE_DIR" ]; then
  row NOTM profile "no profiles dir at $(tilde "$PROFILE_DIR"); pj falls back to its built-in argv (that is a supported state, not a fault); fix: stow -R the dotfiles"
elif [ "$PROFILE" != default ] && [ ! -r "$PROFILE_DIR/$PROFILE" ]; then
  row FAIL profile "profile '$PROFILE' not found at $(tilde "$PROFILE_DIR")/$PROFILE; fix: name one of: $(ls "$PROFILE_DIR" 2>/dev/null | paste -sd ' ' -)"
elif [ ! -d "$PROFILE_CONFIG_DIR" ]; then
  row WARN profile "profile '$PROFILE' declares config_dir $(tilde "$PROFILE_CONFIG_DIR"), which does not exist yet. A fresh config dir has no credentials and no folder trust, so the FIRST launch on it needs a human: run pj --profile $PROFILE in a pane, then /login, then accept the trust dialog"
else
  row PASS profile "profile '$PROFILE', config_dir $(tilde "$PROFILE_CONFIG_DIR"), transcripts under $(tilde "$PJ_TRANSCRIPTS_DIR")"
fi

# M14c profile siblings (F5a, ruled by Gavin at the gate). Profiles are SIBLING directories
# under ~, never nested. A nested config dir is a FAIL: ~/.claude/<x> would put a profile's
# transcripts inside the RECORDS repo, where dot-claude would try to track them and
# open-items' drawer scan would walk them.
# A dot-claude worktree at a different depth than ~/.claude is a WARN, not a FAIL: nothing
# is measured to break, and a FAIL on an unmeasured hazard is a false alarm that teaches
# you to skip the row.
if [ ! -d "$PROFILE_DIR" ]; then
  : # already said above; one silence is enough
else
  sib_fail=""; sib_warn=""; sib_n=0
  for pf in "$PROFILE_DIR"/*; do
    [ -f "$pf" ] || continue
    sib_n=$((sib_n+1))
    cda="$(expand_tilde "$(profile_key "$(basename "$pf")" config_dir)")"
    [ -n "$cda" ] || continue
    for pg in "$PROFILE_DIR"/*; do
      [ -f "$pg" ] || continue
      [ "$pf" = "$pg" ] && continue
      cdb="$(expand_tilde "$(profile_key "$(basename "$pg")" config_dir)")"
      [ -n "$cdb" ] || continue
      case "$cda" in "$cdb"/*) sib_fail="${sib_fail:+$sib_fail, }$(basename "$pf") ($(tilde "$cda")) is INSIDE $(basename "$pg") ($(tilde "$cdb"))" ;; esac
    done
    # Depth. ~/.claude is ONE level under ~, and the rule is that profiles are its
    # siblings. Two different oddities, worth two different sentences: a config dir that
    # is not under ~ at all is not "deep", it is somewhere else entirely, and saying
    # "deeper than ~/.claude" about /var/folders/... reads as a broken instrument.
    # Both are WARN, never FAIL: neither is measured to break anything.
    case "$cda" in
      "$HOME"/*)
        rel="${cda#$HOME/}"
        case "$rel" in */*) sib_warn="${sib_warn:+$sib_warn, }$(basename "$pf") at $(tilde "$cda") is deeper than ~/.claude" ;; esac ;;
      *) sib_warn="${sib_warn:+$sib_warn, }$(basename "$pf") at $cda is not under ~ at all" ;;
    esac
  done
  if [ -n "$sib_fail" ]; then
    row FAIL profile-siblings "$sib_fail; fix: profiles are siblings under ~ (~/.claude, ~/.claude-scratch), never nested"
  elif [ -n "$sib_warn" ]; then
    row WARN profile-siblings "$sib_warn"
  else
    row PASS profile-siblings "$sib_n profile(s), all config dirs are siblings under ~"
  fi
fi

# ---- profile-registry (F5c) ----------------------------------------------------------
# ListAgents is built from <config_dir>/sessions ALONE, so two config dirs cannot see each
# other unless they share that folder. `pj` gives every non-default profile a symlink
# sessions -> ~/.claude/sessions on a real launch; this row says whether it is actually
# there, because a link that silently failed to be created looks exactly like a profile
# that has simply never been launched.
#
# THE FAIL ARM IS THE DEFAULT'S OWN REGISTRY. ~/.claude/sessions is the link TARGET. If it
# is itself a symlink, every default-profile session is registering somewhere nobody reads
# and the whole mechanism is inverted -- which is why that is a FAIL and the rest are WARN.
# Nothing in the WARN cases is broken; the profile simply does not have cross-config-dir
# messaging, and pj repairs most of them at the next launch.
# $PJ_HOME, not a literal $HOME/.claude: the default profile's CONFIG dir and RECORDS are
# the same path by construction, and going through the seam is what lets the selftest
# exercise this row against a fixture instead of rearranging the live registry.
REG_TARGET="$PJ_HOME/sessions"
if [ -L "$REG_TARGET" ]; then
  row FAIL profile-registry "$(tilde "$REG_TARGET") is itself a SYMLINK (-> $(readlink "$REG_TARGET")); it is the target every profile links TO, so default-profile sessions are registering where nothing reads them; fix: restore it as a real directory"
elif [ ! -d "$PROFILE_DIR" ]; then
  : # the missing-profiles-dir case is already stated once above
else
  reg_n=0; reg_ok=0; reg_warn=""
  for pf in "$PROFILE_DIR"/*; do
    [ -f "$pf" ] || continue
    pn="$(basename "$pf")"
    cda="$(expand_tilde "$(profile_key "$pn" config_dir)")"
    # A profile with no config_dir, or one pointing at ~/.claude, IS the default case and
    # needs no link at all. Counting it as a miss would put a permanent WARN on every box.
    # Compared against $PJ_HOME rather than a literal ~/.claude, for the same reason
    # REG_TARGET is: a profile whose config dir IS the default one needs no link, and
    # hardcoding the path here made the row count the fixture's own default profile as a
    # non-default one. Caught by the selftest, which is what the seam is for.
    [ -n "$cda" ] || continue
    [ "$cda" = "$PJ_HOME" ] && continue
    reg_n=$((reg_n+1))
    if [ ! -d "$cda" ]; then
      reg_warn="${reg_warn:+$reg_warn; }$pn: config dir $(tilde "$cda") does not exist yet (pj creates the link at its first launch)"
    elif [ -L "$cda/sessions" ] && [ "$(readlink "$cda/sessions")" = "$REG_TARGET" ]; then
      reg_ok=$((reg_ok+1))
    elif [ -L "$cda/sessions" ] && [ ! -e "$cda/sessions" ]; then
      reg_warn="${reg_warn:+$reg_warn; }$pn: $(tilde "$cda")/sessions is a DANGLING link (pj repairs it at the next launch)"
    elif [ -L "$cda/sessions" ]; then
      reg_warn="${reg_warn:+$reg_warn; }$pn: $(tilde "$cda")/sessions points at $(readlink "$cda/sessions"), not $(tilde "$REG_TARGET"); pj leaves a deliberate link alone"
    elif [ -d "$cda/sessions" ]; then
      reg_warn="${reg_warn:+$reg_warn; }$pn: $(tilde "$cda")/sessions is a real directory, so this profile's sessions are invisible to ListAgents from ~/.claude; fix: launch pj --profile $pn with no session running under it"
    else
      reg_warn="${reg_warn:+$reg_warn; }$pn: no $(tilde "$cda")/sessions yet (pj creates it at the next launch)"
    fi
  done
  if [ "$reg_n" -eq 0 ]; then
    row NOTM profile-registry "no profile has a config dir of its own, so there is nothing to share (that is the default state, not a fault)"
  elif [ -n "$reg_warn" ]; then
    row WARN profile-registry "$reg_warn"
  else
    row PASS profile-registry "$reg_ok of $reg_n non-default profile(s) share $(tilde "$REG_TARGET"), so ListAgents and SendMessage reach across config dirs"
  fi
fi

# ---- stale-workspaces (F5d, W-20260922-A04) ------------------------------------------
# A Herdr workspace whose worktree `checkout_path` is not on disk any more. That is what
# w3Y and w3Z were, and c2 done leaked one on every discarded topic until F5d; the fix is
# in c2, and this row is what would have shown it without anyone noticing the sidebar.
#
# IT COUNTS ONLY WORKSPACES THAT NAME A WORKTREE. A workspace with no worktree block is an
# ordinary one and its cwd is nobody's business here, so it is not measured -- and the row
# says how many it looked at, so "0 stale" and "0 examined" can never read the same.
#
# NOT MEASURED, and said out loud, when herdr or jq is missing or the server is not up.
# A silent PASS in those cases would be a check that cannot fail.
# PJ_HEALTH_HERDR is the seam: it names the herdr binary, so the selftest can point it at
# one that is not there and actually reach the NOT MEASURED branch. Without it that branch
# is unreachable on any machine where herdr IS installed, and an untestable branch is how
# you ship a row that silently passes for ever.
HERDR_BIN="${PJ_HEALTH_HERDR:-herdr}"
if command -v "$HERDR_BIN" >/dev/null 2>&1 && command -v jq >/dev/null 2>&1; then
  ws_json="$("$HERDR_BIN" workspace list 2>/dev/null || true)"
  if [ -z "$ws_json" ] || [ "$(printf '%s' "$ws_json" | jq -r 'has("result")' 2>/dev/null)" != true ]; then
    row NOTM stale-workspaces "herdr answered nothing (server down, or the sandbox blocked the socket); nothing was examined"
  else
    # The LIST payload first, a per-id `workspace get` only when the list omits the worktree
    # block. Measured on this machine the list does omit it, so the fallback is what runs --
    # but asking the cheap question first costs nothing and matches what c2 does.
    # (/code-review flagged the N+1 on the grounds that pj-health runs on every session
    # card. It does not: `pj-health` appears in no SessionStart hook, control `SessionStart`
    # 14 hits in the same search. Taken anyway, for the consistency rather than the speed.)
    ws_seen=0; ws_wt=0; ws_stale=""
    for ws_id in $(printf '%s' "$ws_json" | jq -r '.result.workspaces[]?.workspace_id' 2>/dev/null); do
      ws_seen=$((ws_seen+1))
      ws_path="$(printf '%s' "$ws_json" | jq -r --arg i "$ws_id" '.result.workspaces[]? | select(.workspace_id==$i) | .worktree.checkout_path // ""' 2>/dev/null)"
      [ -n "$ws_path" ] || ws_path="$("$HERDR_BIN" workspace get "$ws_id" 2>/dev/null | jq -r '.result.workspace.worktree.checkout_path // ""' 2>/dev/null)"
      [ -n "$ws_path" ] || continue
      ws_wt=$((ws_wt+1))
      [ -e "$ws_path" ] || ws_stale="${ws_stale:+$ws_stale; }$ws_id -> $(tilde "$ws_path")"
    done
    if [ "$ws_seen" -eq 0 ]; then
      row NOTM stale-workspaces "herdr listed no workspaces at all, so nothing was examined"
    elif [ -n "$ws_stale" ]; then
      row WARN stale-workspaces "$ws_stale; each points at a path that is gone. fix: herdr workspace close <id>. c2 done closes its own since F5d, so a new one here means it was made another way"
    else
      row PASS stale-workspaces "$ws_wt of $ws_seen workspace(s) name a worktree and every one of those paths exists"
    fi
  fi
else
  row NOTM stale-workspaces "herdr or jq is not on PATH, so no workspace was examined"
fi

# --- herdr skill upstream drift (F9) ----------------------------------------
# WHY THIS ROW IS NOT THE ONE ABOVE IT. Our herdr SKILL.md is a SUPERSET of
# upstream's: upstream's text with a lot of locally measured findings written
# into it. UPSTREAM.md is the stored merge base. herdr-skill-drift-check's own
# first four subjects compare things that both come off THIS BOX, so while the
# formula is pinned they agree by construction -- and on 2026-09-22 upstream's
# skill had been ten hunks ahead for six days while that tool printed "merge
# base current" on every session card. This row carries its three CONTENT
# HASHES against upstream's repo, which is the only arm that can see it.
#
# It maps that tool's own states onto this one's, and the mapping is the point:
#   upstream-base       ACTION -> FAIL  the snapshot is corrupt, merges are unsound
#   upstream-released   ACTION -> WARN  upstream shipped changes; a merge is DUE,
#                                       which is a decision for Gavin, not a fault
#   upstream-unreleased ACTION -> WARN  (cannot currently happen; INFO stays CLEAN)
#   any SKIPPED                -> NOT MEASURED, naming what could not be read
#
# --no-network ON PURPOSE. This tool's contract is "finishes in a few seconds";
# three cold fetches at an 8s timeout is 24s. The SessionStart hook does the
# fetching and fills the 24h cache, so in normal life this row reads it for
# free. A cold cache is NOT MEASURED and says how to warm it, which is the
# honest answer rather than a slow one. `pj-health --live` passes --live down.
PJ_HEALTH_DRIFT="${PJ_HEALTH_DRIFT:-herdr-skill-drift-check}"
if command -v "$PJ_HEALTH_DRIFT" >/dev/null 2>&1 && command -v jq >/dev/null 2>&1; then
  if [ "$LIVE" -eq 1 ]; then drift_json="$("$PJ_HEALTH_DRIFT" --json --live 2>/dev/null || true)"
  else drift_json="$("$PJ_HEALTH_DRIFT" --json --no-network 2>/dev/null || true)"; fi
  if [ -z "$drift_json" ] || [ "$(printf '%s' "$drift_json" | jq -r 'has("subjects")' 2>/dev/null)" != true ]; then
    row NOTM skill-upstream "herdr-skill-drift-check returned no JSON report, so upstream was not compared"
  else
    du_base="$(printf '%s' "$drift_json" | jq -r '.subjects[]? | select(.subject=="upstream-base") | .state' 2>/dev/null)"
    du_rel="$(printf '%s' "$drift_json" | jq -r '.subjects[]? | select(.subject=="upstream-released") | .state' 2>/dev/null)"
    du_unrel="$(printf '%s' "$drift_json" | jq -r '.subjects[]? | select(.subject=="upstream-unreleased") | .state' 2>/dev/null)"
    du_tag="$(printf '%s' "$drift_json" | jq -r '.upstream.latest_tag // "?"' 2>/dev/null)"
    du_ver="$(printf '%s' "$drift_json" | jq -r '.base_version // "?"' 2>/dev/null)"
    du_src="$(printf '%s' "$drift_json" | jq -r '.upstream.source // "?"' 2>/dev/null)"
    if [ -z "$du_base" ]; then
      row NOTM skill-upstream "the drift report carried no upstream subjects at all, so nothing was compared"
    elif [ "$du_base" = SKIPPED ] || [ "$du_rel" = SKIPPED ] || [ "$du_unrel" = SKIPPED ]; then
      row NOTM skill-upstream "upstream was not reachable and the 24h cache was cold or stale (source: $du_src). warm it: herdr-skill-drift-check --live"
    elif [ "$du_base" = ACTION ]; then
      row FAIL skill-upstream "UPSTREAM.md is NOT a verbatim capture of upstream at v$du_ver, so every merge built on it is unsound. fix: herdr-skill-drift-check --live for the detail, then recapture the snapshot"
    elif [ "$du_rel" = ACTION ]; then
      row WARN skill-upstream "upstream has SHIPPED skill changes we have not merged: $du_tag differs from our merge base v$du_ver. Merge them into SKILL.md (never overwrite it, it is a superset), then refresh UPSTREAM.md and UPSTREAM.version"
    else
      row PASS skill-upstream "our merge base v$du_ver is upstream's newest release $du_tag, and master carries nothing unreleased (source: $du_src)"
    fi
  fi
else
  row NOTM skill-upstream "herdr-skill-drift-check or jq is not on PATH, so upstream was not compared"
fi

# M14d records pinned (F5a). open-items and decided must resolve the drawer and the rulings
# under ~/.claude WHATEVER the session's config dir is, or a profile session would file
# items into a register nobody else reads. Measured by RUNNING them with a foreign
# CLAUDE_CONFIG_DIR and reading where they say they point -- not by reading the source,
# which would only prove what the source says today.
# The control is the same call WITHOUT the foreign variable: both must answer ~/.claude,
# and if the unset arm ever stops doing so the instrument is broken, not the tool.
if [ "$IN_REPO" -eq 0 ]; then
  row NOTM records-pinned "not in a git repo (the check asks open-items where THIS repo's drawer is)"
else
  rp_ctl="$(open-items --where 2>/dev/null)"; rp_ctl_rc=$?
  rp_fork="$(CLAUDE_CONFIG_DIR="$HOME/.claude-pj-health-probe" open-items --where 2>/dev/null)"
  if [ "$rp_ctl_rc" -gt 1 ] || [ -z "$rp_ctl" ]; then
    row NOTM records-pinned "open-items --where printed nothing here (rc $rp_ctl_rc), so the control never hit and the comparison proves nothing"
  elif [ "$rp_ctl" != "$rp_fork" ]; then
    row FAIL records-pinned "open-items followed CLAUDE_CONFIG_DIR: unset -> $(tilde "$rp_ctl"), forked -> $(tilde "$rp_fork"). The drawer must NOT fork; fix: OPEN_ITEMS_PROJECTS_DIR must stay \$HOME/.claude/projects"
  else
    # The "is it under ~/.claude" half is asserted ONLY on a LIVE run. A seamed run points
    # PJ_HOME and the drawer at fixtures on purpose, and asserting the real path against a
    # fixture would make the row fail for being UNDER TEST rather than for being wrong --
    # which is how a green suite turns red without anything breaking. The DIFFERENTIAL
    # above is the half that actually catches the drift, and it runs either way.
    if [ "$PJ_HOME" != "$HOME/.claude" ] || [ -n "${PJ_LAUNCHER:-}" ] || [ -n "${OPEN_ITEMS_PROJECTS_DIR:-}" ]; then
      row PASS records-pinned "open-items gives the same answer with and without a foreign CLAUDE_CONFIG_DIR (root not asserted: seamed run)"
    else
      case "$rp_ctl" in
        "$HOME"/.claude/*) row PASS records-pinned "open-items answers $(tilde "$rp_ctl") with and without a foreign CLAUDE_CONFIG_DIR" ;;
        *) row FAIL records-pinned "open-items resolves outside ~/.claude: $(tilde "$rp_ctl"); fix: OPEN_ITEMS_PROJECTS_DIR must stay \$HOME/.claude/projects" ;;
      esac
    fi
  fi
fi

# M15 launch log (F3; pj-launch-check writes it). WARN, never FAIL: a stale launch is history, not wiring.
LAUNCH_LOG="$PJ_STATE_DIR/launches.log"
if [ ! -r "$LAUNCH_LOG" ]; then
  row NOTM launch-log "no $(tilde "$LAUNCH_LOG") yet (the first pj launch after F3 writes it)"
else
  last="$(tail -n "$LAUNCH_LOG_WINDOW" "$LAUNCH_LOG")"
  nread="$(printf '%s\n' "$last" | grep -c 'result=' || true)"
  nunm="$(printf '%s\n' "$last" | grep -c ' result=unmeasured:' || true)"
  stale_list="$(printf '%s\n' "$last" | grep ' result=stale:' | sed -E 's/^ts=([0-9-]+)T([0-9:]{5})[^ ]* .* tty=([^ ]+) .* result=stale:(.*)$/\3 \1 \2 (\4)/' | paste -sd ';' - | sed 's/;/, /g')"
  nstale="$(printf '%s\n' "$last" | grep -c ' result=stale:' || true)"
  if [ "$nread" -eq 0 ]; then row NOTM launch-log "$(tilde "$LAUNCH_LOG") has no result= lines"
  elif [ "$nstale" -eq 0 ]; then row PASS launch-log "last $nread launches ok${nunm:+ ($nunm unmeasured)}"
  else row WARN launch-log "$nstale of the last $nread launches stale: $stale_list; fix: open a new shell in those panes (exec zsh or a fresh pane), relaunch pj"; fi
fi

# M16 stale shells (F3). Interactive zsh started before ~/.zshrc last changed will launch the OLD
# definitions. WARN, never FAIL: an old shell is a warning about future launches, not a wiring fault.
mtime_of(){ stat -L -c %Y "$1" 2>/dev/null || stat -L -f %m "$1" 2>/dev/null || echo 0; }   # GNU first: Linux -f means filesystem
# BSD ps prints lstart as "Mon 21 Sep 12:32:38 2026"; GNU procps prints "Mon Sep 21
# 12:32:38 2026" -- day and month SWAPPED. `date -j -f` (BSD) parses the first, `date -d`
# (GNU) parses the second, and each platform ships exactly the one it needs, so the chain
# covers both. Nothing downstream may read those five fields POSITIONALLY for display.
# THREE arms, not two. The first two are the two FIELD ORDERS, both handed to BSD date;
# the third is GNU date, which reads either. Neither -j form can mis-parse the other's
# string (%e demands a number, %b demands a month name), so the order of the arms is safe.
# Measured 2026-09-21: with only the BSD-order arm, a Mac reading a procps-shaped lstart
# returned 0 and the shell was silently DROPPED from the count -- a zero that looked exactly
# like "no stale shells". The selftest's GNU fixture is what caught it.
lstart_epoch(){
  date -j -f '%a %e %b %H:%M:%S %Y' "$1" +%s 2>/dev/null \
    || date -j -f '%a %b %e %H:%M:%S %Y' "$1" +%s 2>/dev/null \
    || date -d "$1" +%s 2>/dev/null \
    || echo 0
}
# Format an epoch the same way on both platforms, so the WARN text does not depend on which
# ps laid the fields out (measured: positional $d2 $d3 read "21 Sep" on macOS, "Sep 21" on Linux).
epoch_fmt(){ date -r "$1" "+$2" 2>/dev/null || date -d "@$1" "+$2" 2>/dev/null || printf '%s' "$1"; }
zmt="${PJ_ZSHRC_MTIME:-$(mtime_of "$HOME/.zshrc")}"
if [ -n "${PJ_PS_OUT:-}" ]; then ps_out="$(cat "$PJ_PS_OUT" 2>/dev/null)"; else ps_out="$(ps -axo pid=,ppid=,tty=,lstart=,command= -u "$USER" 2>/dev/null)"; fi
if [ "$zmt" -eq 0 ]; then
  row NOTM stale-shells "cannot stat ~/.zshrc"
elif [ -z "$ps_out" ]; then
  row NOTM stale-shells "ps returned nothing (a sandbox refuses it); fix: run pj-health from a terminal"
else
  nsh=0; nold=0; oldlist=""
  while read -r pid ppid tty d1 d2 d3 d4 d5 cmd; do
    [ -n "${pid:-}" ] || continue
    case "$cmd" in -zsh|zsh|*/zsh) ;; *) continue;; esac       # interactive shells only: no `zsh -c`, no args
    # No tty: BSD ps writes "??", GNU procps writes "?". Both mean the same thing, and
    # checking only the BSD spelling let every ttyless process through on Linux.
    [ "$tty" != "??" ] && [ "$tty" != "?" ] && [ "$tty" != "-" ] && [ "$ppid" != 1 ] || continue   # ppid 1: orphaned forks, not panes
    nsh=$((nsh+1))
    st="$(lstart_epoch "$d1 $d2 $d3 $d4 $d5")"
    if [ "$st" -gt 0 ] && [ "$st" -lt "$zmt" ]; then nold=$((nold+1)); oldlist="$oldlist, $tty pid $pid since $(epoch_fmt "$st" '%d %b %H:%M')"; fi
  done <<<"$ps_out"
  zdate="$(epoch_fmt "$zmt" '%Y-%m-%d %H:%M')"
  if [ "$nold" -eq 0 ]; then row PASS stale-shells "0 of $nsh interactive zsh older than ~/.zshrc ($zdate)"
  else row WARN stale-shells "$nold of $nsh interactive zsh older than ~/.zshrc ($zdate):${oldlist#,}; fix: close the pane or open a new one (exec zsh keeps the start time, so the row lists it until the pane is reopened). Every .zshrc edit makes all open shells stale by this measure; that is correct"; fi
fi

# M17 frontmatter (P10, W-20260921-A43). WARN, never FAIL: latent, not live.
# An UNQUOTED `description:` whose text holds a colon-space ends the YAML scalar early.
# Claude Code's own parser tolerates it, PyYAML does not, and four files under ~/.claude
# had drifted that way unnoticed (Forge, Grok, Max, AgentRelay). This row is the
# preventive fix: it names the next one. Pure shell on purpose (no PyYAML on a health
# check): the defect class is exactly "unquoted, contains ': '", and a block scalar
# (`>` or `|`) is fine. Population: <PJ_HOME>/agents/*.md and <PJ_HOME>/skills/*/SKILL.md,
# stated on every run so a zero is never silent.
fm_bad=""; fm_n=0
for f in "$PJ_HOME"/agents/*.md "$PJ_HOME"/skills/*/SKILL.md; do
  [ -f "$f" ] || continue
  fm_n=$((fm_n+1))
  fm_desc="$(awk 'NR==1 && $0!="---" {exit} /^---$/ {c++; if (c==2) exit; next} /^description:/ {sub(/^description:[ \t]*/, ""); print; exit}' "$f" 2>/dev/null)"
  case "$fm_desc" in
    ''|\'*|\"*|'>'*|'|'*) ;;
    *': '*) fm_bad="$fm_bad $(tilde "$f")" ;;
  esac
done
if [ "$fm_n" -eq 0 ]; then row NOTM frontmatter "no agents/*.md or skills/*/SKILL.md under $(tilde "$PJ_HOME"); nothing to check"
elif [ -z "$fm_bad" ]; then row PASS frontmatter "$fm_n frontmatters: every description is quoted, a block scalar, or free of ': '"
else row WARN frontmatter "unquoted description with ': ' (ends the YAML scalar early; latent under Claude Code, fatal under PyYAML):$fm_bad; fix: quote the value (single quotes, double any ' inside), then re-run"; fi

# =============================================================== PROJECT ==
DRAWER=""
if [ "$IN_REPO" -eq 1 ] && command -v open-items >/dev/null 2>&1; then
  wo="$(open-items --where 2>/dev/null | head -1)"; [ -n "$wo" ] && DRAWER="$(dirname "$wo")"
fi
resolve_marker(){   # resolve_marker <marker:path> -> absolute path or empty
  case "$1" in
    repo:*) printf '%s' "$TOPLEVEL/${1#repo:}";;
    drawer:*) [ -n "$DRAWER" ] && printf '%s' "$DRAWER/${1#drawer:}";;
    "~/"*) printf '%s' "$HOME/${1#\~/}";;
    *) ;;
  esac
}

# P1 pj-homes
if [ "$IN_REPO" -eq 0 ]; then
  row NOTM pj-homes "not in a git repo"
elif [ ! -r "$TOPLEVEL/.claude/pj-homes" ]; then
  row NOTM pj-homes "no .claude/pj-homes (D-20260920-06 defaults in use)"
else
  bad=""; unresolved=""; missing=""; nkeys=0; records=""
  while IFS= read -r line; do
    case "$line" in ''|'#'*) continue;; esac
    key="${line%%:*}"; val="${line#*:}"; val="${val#"${val%%[![:space:]]*}"}"
    case "$key" in
      records) records="$val"; nkeys=$((nkeys+1)); case "$val" in repo|private) ;; *) bad="$bad records='$val'";; esac;;
      # W-20260921-A14. `wrap-up` holds a SLASH-COMMAND NAME, not a path: the P5.2
      # key shape is `/wrap-up` (Network_Plan) or `/vertical-wrap-up`
      # (win_go_app_test). resolve_marker cannot resolve one, so both projects sat
      # on a WARN reading "unresolvable marker on: wrap-up" for a line that is a
      # correct declaration under D-20260920-02. A check that reds a correct
      # declaration teaches you to ignore the check.
      wrap-up)
        nkeys=$((nkeys+1))
        case "$val" in
          /*/*|/*.*) p="$(resolve_marker "$val")" ;;   # a path, oddly spelled: still resolve it
          /*) p="COMMAND" ;;                           # /wrap-up, /vertical-wrap-up: a command name
          *)  p="$(resolve_marker "$val")" ;;
        esac
        if [ "$p" = COMMAND ]; then :
        elif [ -z "$p" ]; then unresolved="$unresolved $key"
        elif [ ! -e "$p" ]; then missing="$missing $key"; fi;;
      handoff|tracker|decisions|incidents|plans)
        nkeys=$((nkeys+1)); p="$(resolve_marker "$val")"
        if [ -z "$p" ]; then unresolved="$unresolved $key"
        elif [ ! -e "$p" ]; then [ "$key" = handoff ] || missing="$missing $key"; fi;;
      *) bad="$bad unknown-key='$key'";;
    esac
  done <"$TOPLEVEL/.claude/pj-homes"
  if [ -n "$bad" ]; then row FAIL pj-homes ".claude/pj-homes:$bad; fix: keys handoff|tracker|decisions|incidents|plans|records|wrap-up, records repo|private"
  elif [ -n "$missing" ]; then row FAIL pj-homes "declared store missing on disk:$missing; fix: create it or correct the line"
  elif [ -n "$unresolved" ]; then row WARN pj-homes "$nkeys keys; unresolvable marker on:$unresolved (repo:, drawer:, ~/ resolve)"
  else row PASS pj-homes "$nkeys keys parse; records ${records:-repo (default)}; every declared store present"; fi
fi

# P2 drawer
if [ "$IN_REPO" -eq 0 ]; then
  row NOTM drawer "not in a git repo"
elif ! command -v open-items >/dev/null 2>&1; then
  row NOTM drawer "open-items not on PATH"
elif [ -z "$DRAWER" ]; then
  row FAIL drawer "open-items --where printed nothing; fix: open-items --selftest"
elif [ -d "$DRAWER/items" ]; then
  if [ -f "$DRAWER/OPEN.md" ] && [ -f "$DRAWER/items/.generated.sha256" ]; then
    have="$(shasum -a 256 "$DRAWER/OPEN.md" | cut -d' ' -f1)"; want="$(tr -d '[:space:]' <"$DRAWER/items/.generated.sha256")"
    if [ "$have" = "$want" ]; then row PASS drawer "items/ layout; OPEN.md matches its stamp"
    else row WARN drawer "items/ layout; OPEN.md differs from its stamp (hand edit pending; open-items regen rescues it)"; fi
  else row WARN drawer "items/ layout; OPEN.md or its stamp absent (open-items regen)"; fi
elif [ -f "$DRAWER/OPEN.md" ]; then
  row WARN drawer "legacy OPEN.md layout; open-items migrate moves it to items/"
else
  row NOTM drawer "no drawer for this project (open-items init creates one)"
fi

# P3 decided store
if [ "$IN_REPO" -eq 0 ]; then
  row NOTM decided-store "not in a git repo"
elif ! command -v decided >/dev/null 2>&1; then
  row NOTM decided-store "decided not on PATH"
else
  hl="$(decided --homes 2>/dev/null | grep -E '^project' | head -1)"
  kind="$(printf '%s' "$hl" | awk '{for(i=1;i<=NF;i++) if($i ~ /^(folder|file|missing|unsupported)$/){print $i; exit}}')"
  label="$(printf '%s' "$hl" | sed -E 's/^(project[^)]*\)).*/\1/')"
  case "$kind" in
    folder|file) row PASS decided-store "$label found ($kind)";;
    missing) row NOTM decided-store "$label not present ($(printf '%s' "$hl" | sed -E 's/.*\((.*)\)$/\1/'))";;
    # W-20260921-A14: WARN, not FAIL. A project that DECLARES where its rulings
    # live, in a format `decided` cannot parse, is in a better state than one that
    # declares nothing -- and both Network_Plan (repo:common/04-decisions.md) and
    # win_go_app_test (repo:edge-decisions.html) are correct declarations under
    # D-20260920-02. FAIL is for a broken machine, not for a store this tool has
    # not learned to read yet. The fix text names both routes.
    unsupported) row WARN decided-store "$label declared but in a format decided cannot read; the declaration is correct, the reader is the gap. fix: point decisions: at a folder of D-*.md or a file of '## D-' blocks, or teach decided that format";;
    *) row NOTM decided-store "decided --homes printed no project line";;
  esac
fi

# P4 commit-trailer (F4, W-20260921-16). The C-Sess-Id trailer is stamped by
# ~/.config/git/hooks/_audit-chain from $CLAUDE_SESSION_ID, else $CLAUDE_CODE_SESSION_ID.
# THREE states, and the middle one is the whole point of the row:
#   key absent      -- not a Claude commit at all (a terminal commit, or trailers.disable).
#                      Quiet: this row does not police who commits.
#   key with value  -- stamped correctly.
#   key EMPTY       -- the defect. The stamp block fired, so the commit LOOKS attributed
#                      in any check that only asks whether the key is present, and the id
#                      that maps it to a transcript is gone. Three days of commits in two
#                      repos read this way before anyone noticed (2026-09-21).
# WARN, never FAIL, ruled at the F4 gate: a past commit cannot be repaired without a
# history rewrite, so a FAIL here would be permanent and unfixable.
# The population is an ARRAY, not a space-separated string: $TOPLEVEL comes from
# `git rev-parse --show-toplevel` and is not under the caller's control, so a project in
# ~/CODE/My Project would split into two fragments, both fail rev-parse, and the row could
# degrade to NOT MEASURED while the defect it exists to catch went unreported. Only the
# PJ_TRAILER_REPOS seam is space-separated, and only the selftest sets it.
# Outside any repo the dot-claude arm is still measured: half the population this row was
# written for lives there, and "not in a git repo" would hide a live regression in it.
tr_list=()
if [ -n "${PJ_TRAILER_REPOS:-}" ]; then
  for r in $PJ_TRAILER_REPOS; do tr_list+=("$r"); done
else
  [ "$IN_REPO" -eq 1 ] && tr_list+=("$TOPLEVEL")
  [ -n "$PJ_HOME" ] && tr_list+=("$PJ_HOME")
fi
if [ "${#tr_list[@]}" -eq 0 ]; then
  row NOTM commit-trailer "no repo named to measure"
else
  tr_bad=""; tr_ok=""; tr_none=""; tr_unreach=""
  for r in "${tr_list[@]}"; do
    rn="$(basename "$r")"
    if ! git -C "$r" rev-parse --git-dir >/dev/null 2>&1; then tr_unreach="$tr_unreach $rn"; continue; fi
    msg="$(git -C "$r" log -1 --format=%B 2>/dev/null)"
    line="$(printf '%s\n' "$msg" | grep -i -m1 '^C-Sess-Id:' || true)"
    if [ -z "$line" ]; then tr_none="$tr_none $rn"; continue; fi
    v="$(printf '%s' "$line" | sed -E 's/^[^:]*:[[:space:]]*//')"
    if [ -n "$v" ]; then tr_ok="$tr_ok $rn"; else tr_bad="$tr_bad $rn"; fi
  done
  tr_seen=$(( $(printf '%s' "$tr_ok$tr_bad$tr_none" | wc -w) ))
  # Every branch reports EVERY repo. A WARN that named only the bad one would hide a second
  # regression behind the first, and would not say whether the others were clean, unstamped
  # or unreachable -- which is the same silence this row exists to break.
  tr_rest=""
  [ -n "$tr_none" ]    && tr_rest="$tr_rest; no C-Sess-Id key in:$tr_none (not a Claude commit)"
  [ -n "$tr_unreach" ] && tr_rest="$tr_rest; not a git repo:$tr_unreach"
  if [ -n "$tr_bad" ]; then
    tr_ok_clause=""; [ -n "$tr_ok" ] && tr_ok_clause="; stamped in:$tr_ok"
    row WARN commit-trailer "newest commit carries an EMPTY C-Sess-Id in:${tr_bad}; the stamp fired but the session id was missing; fix: audit-chain-selftest, then check _audit-chain reads CLAUDE_CODE_SESSION_ID (F4). Past commits are not repairable without a rewrite${tr_ok_clause}${tr_rest}"
  elif [ "$tr_seen" -eq 0 ]; then
    row NOTM commit-trailer "no repo reachable to measure:${tr_unreach:- none named}"
  else
    row PASS commit-trailer "newest commit stamped in:${tr_ok:- (none)}${tr_rest}"
  fi
fi

# ============================================================== EVIDENCE ==
TR=""; TR_LIST=""
# WHERE TO LOOK (F5a). A session's transcript lives under ITS config dir, and a profile
# session's config dir is not ~/.claude. The launch log is the index that maps them: it
# lives under ~/.local/state (MACHINE scope, shared by every profile) and carries both
# profile= and config_dir= for this project key.
#
# SCOPED TO THIS PROFILE, and that scoping is load-bearing. The first version matched on
# the project key ALONE and added every config dir the log had ever seen for it. Measured
# 2026-09-21 with two real profile sessions in one repo: `pj-health --profile scratch`
# then reported `PASS evidence-card transcript 89f89c44` -- which was the B-TEST session's
# transcript. A profile graded itself on another profile's evidence and called it a pass.
# That is the worst possible shape for a check: confidently green about the wrong thing.
# Matching profile= as well makes the index answer the question actually being asked.
#
# `config_dir=default` means the variable was unset, which is ~/.claude. Older log lines
# carry neither field and contribute nothing, which is correct: they are all default-profile
# sessions and $PJ_TRANSCRIPTS_DIR already covers them.
TR_DIRS="$PJ_TRANSCRIPTS_DIR"
if [ "$IN_REPO" -eq 1 ] && [ -r "$PJ_STATE_DIR/launches.log" ]; then
  while IFS= read -r cd_seen; do
    [ -n "$cd_seen" ] || continue
    [ "$cd_seen" = default ] && cd_seen="$PJ_HOME"
    case " $TR_DIRS " in *" $cd_seen/projects "*) continue ;; esac
    TR_DIRS="$TR_DIRS $cd_seen/projects"
  done <<<"$(awk -v k="project=$KEY" -v p="profile=$PROFILE" '
      index($0, k) && index($0, p) { for (i = 1; i <= NF; i++) if ($i ~ /^config_dir=/) print substr($i, 12) }
    ' "$PJ_STATE_DIR/launches.log" 2>/dev/null | awk '!seen[$0]++')"
fi
TR_SEARCHED=""
for _td in $TR_DIRS; do [ -d "$_td/$KEY" ] && TR_SEARCHED="${TR_SEARCHED:+$TR_SEARCHED }$_td"; done
if [ "$IN_REPO" -eq 1 ] && [ -n "$TR_SEARCHED" ]; then
  # newest interactive pj transcript: pj-voice style, not an sdk-cli (-p) probe
  # the style marker lands at the first assistant turn and entrypoint on line 1, so the
  # first 400 lines decide; stop once the newest plus the baseline window are found
  found=0
  while IFS= read -r f; do
    [ -f "$f" ] || continue
    head -n 400 "$f" 2>/dev/null | grep -q -F '"style":"pj-voice:pj-voice"' || continue
    head -n 5 "$f" 2>/dev/null | grep -q -F '"entrypoint":"sdk-cli"' && continue
    TR_LIST="$TR_LIST$f"$'\n'; found=$((found+1))
    [ "$found" -gt "$BASELINE_WINDOW" ] && break
  done <<<"$(for _td in $TR_SEARCHED; do ls -t "$_td/$KEY"/*.jsonl 2>/dev/null; done | xargs -r ls -t 2>/dev/null || for _td in $TR_SEARCHED; do ls -t "$_td/$KEY"/*.jsonl 2>/dev/null; done)"
  TR="$(printf '%s' "$TR_LIST" | head -1)"
fi
RULES_MARKER="$( [ -r "$RULES" ] && head -1 "$RULES" | cut -c1-60 || echo "# pj-global RULES.md")"
if [ "$IN_REPO" -eq 0 ]; then
  for c in evidence-card evidence-ci-watch evidence-rules evidence-plugins evidence-tokens; do row NOTM "$c" "not in a git repo"; done
elif [ -z "$TR" ]; then
  _tl="$(for _td in ${TR_SEARCHED:-$PJ_TRANSCRIPTS_DIR}; do printf '%s ' "$(tilde "$_td")"; done)"
  for c in evidence-card evidence-ci-watch evidence-rules evidence-plugins evidence-tokens; do row NOTM "$c" "no interactive pj transcript for this project; searched: ${_tl% }"; done
else
  ev="$(jq -c --arg m "$RULES_MARKER" -s '
    [ .[] | select(.type=="attachment" and .attachment.type=="hook_success") | (.attachment.stdout // "") ] as $hs
    | [ .[] | select(.type=="attachment" and .attachment.type=="prompt_snapshot") | ((.attachment.systemPrompt // []) | join("\n")) ] as $snaps
    | { card: ([ $hs[] | select(startswith("pj start card:")) ] | length),
        ci:   ([ $hs[] | select(contains("CI watch")) ] | length),
        snapshots: ($snaps | length),
        rules: ([ $snaps[] | select(contains($m)) ] | length),
        first_turn: ([ .[] | select(.type=="assistant") | .message.usage | select(. != null)
                       | ((.input_tokens // 0) + (.cache_creation_input_tokens // 0) + (.cache_read_input_tokens // 0)) ] | first // 0) }' "$TR" 2>/dev/null)"
  tid="$(basename "$TR" .jsonl | cut -c1-8)"
  if [ -z "$ev" ]; then
    for c in evidence-card evidence-ci-watch evidence-rules evidence-plugins evidence-tokens; do row NOTM "$c" "transcript $tid did not parse"; done
  else
    card="$(jq -r .card <<<"$ev")"; ci="$(jq -r .ci <<<"$ev")"; snaps="$(jq -r .snapshots <<<"$ev")"; rules="$(jq -r .rules <<<"$ev")"; ft="$(jq -r .first_turn <<<"$ev")"
    [ "$card" -eq 1 ] && row PASS evidence-card "transcript $tid: start card once" || row FAIL evidence-card "transcript $tid: start card $card times, expected 1; fix: claude-hooks-sync --target project --check"
    [ "$ci" -eq 1 ] && row PASS evidence-ci-watch "transcript $tid: CI watch once" || row FAIL evidence-ci-watch "transcript $tid: CI watch $ci times, expected 1; fix: claude-hooks-sync --target project --check"
    if [ "$snaps" -eq 0 ]; then row NOTM evidence-rules "transcript $tid has no prompt snapshot"
    elif [ "$rules" -ge 1 ]; then row PASS evidence-rules "transcript $tid: RULES.md header in the prompt snapshot"
    else row FAIL evidence-rules "transcript $tid: RULES.md NOT in the prompt snapshot; fix: open a new shell (stale alias) and relaunch pj"; fi
    pmiss=""
    for m in herdr:herdr AgentRelay:AgentRelay ISA:ISA pj:wrap-up pj-voice:pj-voice; do grep -q -F "$m" "$TR" || pmiss="$pmiss $m"; done
    [ -z "$pmiss" ] && row PASS evidence-plugins "transcript $tid names all 5 plugins (4 skills + the output style)" || row FAIL evidence-plugins "transcript $tid lacks:$pmiss; fix: check the --plugin-dir flags (alias row)"
    # E5 tokens: WARN never FAIL (ruled at the P5.7 gate)
    baseline=""; bsrc=""
    if [ "$TOPLEVEL" = "$PJ_DOTFILES" ]; then baseline=$DOTFILES_BASELINE; bsrc="header constant"
    else
      vals="$(printf '%s' "$TR_LIST" | sed -n "2,$((BASELINE_WINDOW+1))p" | while IFS= read -r f; do [ -f "$f" ] && jq -s '[ .[] | select(.type=="assistant") | .message.usage | select(. != null) | ((.input_tokens // 0) + (.cache_creation_input_tokens // 0) + (.cache_read_input_tokens // 0)) ] | first // empty' "$f" 2>/dev/null; done | sort -n)"
      nv="$(printf '%s\n' "$vals" | grep -c . || true)"
      if [ "$nv" -ge "$BASELINE_MIN_TRANSCRIPTS" ]; then baseline="$(printf '%s\n' "$vals" | awk -v n="$nv" 'NR==int((n+1)/2){print; exit}')"; bsrc="median of $nv earlier transcripts"; fi
    fi
    if [ "$ft" -le 0 ]; then row NOTM evidence-tokens "transcript $tid has no usage record"
    elif [ -z "$baseline" ]; then row NOTM evidence-tokens "transcript $tid first turn $ft tokens; baseline needs $BASELINE_MIN_TRANSCRIPTS earlier pj transcripts, found ${nv:-0}"
    else
      budget=$(( baseline + baseline * BUDGET_MARGIN_PCT / 100 ))
      [ "$ft" -le "$budget" ] && row PASS evidence-tokens "transcript $tid first turn $ft tokens, budget $budget ($bsrc $baseline + ${BUDGET_MARGIN_PCT}%)" \
        || row WARN evidence-tokens "transcript $tid first turn $ft tokens over budget $budget ($bsrc $baseline + ${BUDGET_MARGIN_PCT}%); a long first message is not a wiring fault"
    fi
  fi
fi

# ================================================================== LIVE ==
if [ "$LIVE" -eq 0 ]; then
  row NOTM live-probe "not run (--live launches one headless pj probe, an API call)"
elif [ "$IN_REPO" -eq 0 ]; then
  row NOTM live-probe "not in a git repo (the probe's transcript is read from the project key)"
elif [ -n "${PJ_LAUNCHER:-}" ]; then
  row NOTM live-probe "fixture mode (PJ_LAUNCHER set): no real launch"
elif [ ! -x "$PJ_BIN_DIR/pj" ]; then
  row NOTM live-probe "$(tilde "$PJ_BIN_DIR/pj") not executable; nothing to launch"
else
  prompt='Do exactly two things, in order, then stop. 1. If a SessionStart hook output in your context contains a line beginning with "pj start card:", print that line verbatim; otherwise print NO-CARD. 2. Run this Bash command exactly once, verbatim, no retry, no rewording: DUMMY_TOKEN=abc123; echo "set? ${DUMMY_TOKEN:-no}" . Then print CANARY-DENIED if a hook blocked that tool call, or CANARY-ALLOWED if it ran.'
  lout="$(timeout 300 "$PJ_BIN_DIR/pj" -p "$prompt" --model haiku --output-format json 2>/dev/null </dev/null)"; lrc=$?   # the script directly (F3): no zsh -ic, no alias
  res="$(jq -r '.[]? | select(.type=="result") | .result // ""' <<<"$lout" 2>/dev/null)"
  sid="$(jq -r '.[]? | select(.type=="result") | .session_id // ""' <<<"$lout" 2>/dev/null)"
  lu="$(jq -r '.[]? | select(.type=="result") | .usage | ((.input_tokens // 0) + (.cache_creation_input_tokens // 0) + (.cache_read_input_tokens // 0))' <<<"$lout" 2>/dev/null)"
  lt="$PJ_TRANSCRIPTS_DIR/$KEY/$sid.jsonl"
  if [ $lrc -ne 0 ] || [ -z "$sid" ]; then
    row NOTM live-probe "pj -p rc $lrc, no result record (launcher or network); nothing to read"
  else
    lcard="$( [ -f "$lt" ] && jq -r 'select(.type=="attachment" and .attachment.type=="hook_success") | .attachment.stdout // ""' "$lt" 2>/dev/null | grep -c '^pj start card:' || echo 0)"
    case "$res" in *CANARY-DENIED*) den=denied;; *CANARY-ALLOWED*) den=ALLOWED;; *) den=unclear;; esac
    if [ "$lcard" -eq 1 ] && [ "$den" = denied ]; then
      row PASS live-probe "session ${sid:0:8}: start card once, dummy secret denied; tokens $lu over the probe's turns (haiku -p; not comparable to the interactive baseline, P5.4)"
    elif [ "$den" = ALLOWED ]; then
      row FAIL live-probe "session ${sid:0:8}: the dummy secret probe RAN (guard not firing); fix: claude-hooks-sync --target project --check"
    elif [ "$lcard" -ne 1 ]; then
      row FAIL live-probe "session ${sid:0:8}: start card $lcard times, expected 1 (deny: $den); fix: claude-hooks-sync --target project --check"
    else
      row NOTM live-probe "session ${sid:0:8}: card once but the deny answer was unclear: $(printf '%s' "$res" | tr '\n' ' ' | cut -c1-60)"
    fi
  fi
fi

# =============================================================== SUMMARY ==
rc=0; [ "$n_fail" -gt 0 ] && rc=1
summary="pj-health: $n_pass PASS, $n_warn WARN, $n_fail FAIL, $n_notm NOT MEASURED"
if [ "$JSON" -eq 1 ]; then
  jq -n --argjson rows "$ROWS_JSON" --arg project "${PROJECT:-}" --argjson pass "$n_pass" --argjson warn "$n_warn" --argjson fail "$n_fail" --argjson notm "$n_notm" --argjson rc "$rc" \
    '{project:$project, rows:$rows, summary:{pass:$pass,warn:$warn,fail:$fail,not_measured:$notm}, exit:$rc}'
else
  echo "$summary"
fi
exit $rc
