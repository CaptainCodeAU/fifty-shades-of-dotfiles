#!/usr/bin/env bash
# claude-hooks-sync-selftest -- prove claude-hooks-sync does what it claims.
#
# Sibling of safe-rm-selftest / vulnlib-selftest / census-selftest: a tool that
# WRITES to a 44KB machine-critical file has to be able to demonstrate its own
# behaviour, not merely assert it.
#
# THE SEAM under test is the CLI, never the jq internals: given a settings file
# and a manifest, what does the exit code say, what does the report say, and what
# does settings.json contain afterwards. Rewriting the jq is free; these tests
# only move if the BEHAVIOUR moves.
#
# Every case runs against a throwaway tree under mktemp -d. The real
# ~/.claude/settings.json is never opened -- that is the whole point of the
# CLAUDE_SETTINGS_FILE / CLAUDE_HOOKS_DIR / CLAUDE_REQUIRES_ROOT overrides.
# It is also the only way to exercise the requires-gate on THIS Mac, which HAS
# ~/.claude/skills/herdr and would otherwise pass that gate every time and ship
# it untested.
#
# Usage: claude-hooks-sync-selftest        (exit 0 = all passed)

# Read this whole file before running any of it, so an edit saved mid-run cannot change
# the run (W-20260923-A57). A crash under it exits 127 (unbound var) or 1 (bash 3.2 syntax
# error); `selftest-whole-read --help` has the map. Do not move or reword these lines.
[ -n "${SELFTEST_WHOLE_READ-}" ] || SELFTEST_WHOLE_READ=1 exec "$BASH" -c 'shopt -u sourcepath; . "$0"' "$0" "$@"
unset SELFTEST_WHOLE_READ

set -uo pipefail

SELF_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
TOOL="${CLAUDE_HOOKS_SYNC_BIN:-$SELF_DIR/claude-hooks-sync}"

PASS=0
FAIL=0
WORK=""

# Fixtures are throwaway trees under $TMPDIR. `rm` here is the Trash-routed
# wrapper (the ~/.local/bin/rm PATH shim), which cannot always reach the Trash
# from a sandboxed temp dir -- it then prints a long complaint and leaves the
# directory in place. That is not a test failure, and its noise buries the
# results, so the outcome is deliberately ignored: $TMPDIR is reaped by the OS.
# Never reach for the real deleter here to make the message go away.
cleanup() {
    [[ -n "$WORK" && -d "$WORK" ]] || return 0
    rm -rf "$WORK" >/dev/null 2>&1 || true
    WORK=""
}
trap cleanup EXIT

ok()   { PASS=$(( PASS + 1 )); printf '  \033[32mPASS\033[0m  %s\n' "$1"; }
bad()  { FAIL=$(( FAIL + 1 )); printf '  \033[31mFAIL\033[0m  %s\n' "$1"
         [[ $# -gt 1 ]] && printf '        %s\n' "$2"; }

# ---------------------------------------------------------------------------
# Fixture: a throwaway ~/.claude tree plus a manifest.
#   $1 = "with-skill" | "no-skill"   (drives the requires gate)
#   $2 = "with-script" | "no-script" (drives the script-exists gate)
# Sets: HOOKS_DIR, SETTINGS, MANIFEST, REQ_ROOT
# ---------------------------------------------------------------------------
fixture() {
    local want_skill="$1" want_script="$2"
    # ALWAYS pass mktemp an explicit template. Bare `mktemp -d` on BSD/macOS
    # ignores $TMPDIR and uses the confstr default under /var/folders, which is
    # not writable in every context (a sandboxed agent shell, for one). Same
    # BSD-vs-GNU family as the stat -f / stat -c split.
    WORK="$(mktemp -d "${TMPDIR:-/tmp}/claude-hooks-sync-test.XXXXXX")" || WORK=""
    # A fixture that failed to build must ABORT, never continue. With WORK empty
    # every path below collapses to /home/... , every command fails, and the
    # comparisons then agree with each other and report PASS. That is the
    # all-cases-identical signature of a broken harness, and it is worth more
    # than the tests it would silently fake.
    if [[ -z "$WORK" || ! -d "$WORK" ]]; then
        printf '  \033[31mABORT\033[0m  cannot create a temp dir under %s -- no test can be trusted.\n' \
               "${TMPDIR:-/tmp}" >&2
        exit 2
    fi
    REQ_ROOT="$WORK/home"
    HOOKS_DIR="$REQ_ROOT/.claude/hooks"
    SETTINGS="$REQ_ROOT/.claude/settings.json"
    MANIFEST="$WORK/hooks.json"
    mkdir -p "$HOOKS_DIR"

    # A settings file shaped like the real one: two groups share matcher "Bash"
    # (a foreign one first, ours second) so the group-selection rule is exercised
    # exactly as it is on the real machine, not against a tidy fixture.
    cat > "$SETTINGS" <<'JSON'
{
  "model": "opus",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${PAI_DIR}/hooks/SecurityValidator.hook.ts"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/already-there.sh"
          }
        ]
      }
    ]
  },
  "theme": "dark"
}
JSON

    : > "$HOOKS_DIR/already-there.sh"
    [[ "$want_script" == "with-script" ]] && : > "$HOOKS_DIR/newcomer.sh"
    [[ "$want_skill"  == "with-skill"  ]] && mkdir -p "$REQ_ROOT/.claude/skills/herdr"

    cat > "$MANIFEST" <<'JSON'
{
  "hooks": [
    {
      "event": "PreToolUse",
      "matcher": "Bash",
      "script": "already-there.sh",
      "entry": { "type": "command", "command": "$HOME/.claude/hooks/already-there.sh" },
      "why": "fixture: already registered"
    },
    {
      "event": "PreToolUse",
      "matcher": "Bash",
      "script": "newcomer.sh",
      "entry": { "type": "command", "command": "$HOME/.claude/hooks/newcomer.sh" },
      "requires": [ "$HOME/.claude/skills/herdr" ],
      "why": "fixture: gated on a skill"
    }
  ]
}
JSON
}

run_tool() {
    CLAUDE_SETTINGS_FILE="$SETTINGS" \
    CLAUDE_HOOKS_DIR="$HOOKS_DIR" \
    CLAUDE_HOOKS_MANIFEST="$MANIFEST" \
    CLAUDE_REQUIRES_ROOT="$REQ_ROOT" \
    "$TOOL" "$@" 2>&1
}

# How many times is $1 registered under PreToolUse/Bash, across ALL groups?
count_cmd() {
    jq --arg c "$1" '[ .hooks.PreToolUse[]? | select(.matcher=="Bash")
                       | .hooks[]? | select(.command == $c) ] | length' "$SETTINGS"
}
n_bash_groups() { jq '[ .hooks.PreToolUse[]? | select(.matcher=="Bash") ] | length' "$SETTINGS"; }

echo "claude-hooks-sync selftest"
echo

if [[ ! -x "$TOOL" ]]; then
    bad "tool is executable at $TOOL" "not found or not executable"
    echo; echo "  $PASS passed, $FAIL failed"; exit 1
fi
if ! command -v jq >/dev/null 2>&1; then
    echo "  jq is required to run this selftest." >&2; exit 2
fi

# --- 1. --check reports the one pending entry, and exits 1 -------------------
fixture with-skill with-script
out=$(run_tool --check); rc=$?
if (( rc == 1 )); then ok "--check exits 1 when an entry is unregistered"
else bad "--check exits 1 when an entry is unregistered" "exit was $rc"; fi
if grep -q "newcomer.sh" <<<"$out"; then ok "--check names the pending hook"
else bad "--check names the pending hook" "$out"; fi

# --- 2. --check writes nothing ----------------------------------------------
before=$(shasum "$SETTINGS" | awk '{print $1}')
run_tool --check >/dev/null
after=$(shasum "$SETTINGS" | awk '{print $1}')
if [[ "$before" == "$after" ]]; then ok "--check leaves settings.json byte-identical"
else bad "--check leaves settings.json byte-identical" "hash changed"; fi
cleanup

# --- 3. --install adds the missing entry, exactly once -----------------------
fixture with-skill with-script
run_tool --install >/dev/null; rc=$?
if (( rc == 0 )); then ok "--install exits 0"
else bad "--install exits 0" "exit was $rc"; fi
if [[ "$(count_cmd '$HOME/.claude/hooks/newcomer.sh')" == "1" ]]; then
    ok "--install adds the missing entry exactly once"
else bad "--install adds the missing entry exactly once" "count=$(count_cmd '$HOME/.claude/hooks/newcomer.sh')"; fi

# --- 4. the already-registered entry is NOT duplicated ----------------------
if [[ "$(count_cmd '$HOME/.claude/hooks/already-there.sh')" == "1" ]]; then
    ok "an already-registered entry is not duplicated"
else bad "an already-registered entry is not duplicated" "count=$(count_cmd '$HOME/.claude/hooks/already-there.sh')"; fi

# --- 5. it reuses our group, does not spawn a third Bash group --------------
if [[ "$(n_bash_groups)" == "2" ]]; then ok "reuses our group; no new matcher group"
else bad "reuses our group; no new matcher group" "Bash groups=$(n_bash_groups)"; fi

# --- 6. the foreign PAI group is untouched ----------------------------------
if [[ "$(jq -r '.hooks.PreToolUse[0].hooks | length' "$SETTINGS")" == "1" ]]; then
    ok "the foreign group is left alone"
else bad "the foreign group is left alone" "PAI group was modified"; fi

# --- 7. unrelated top-level keys survive ------------------------------------
if [[ "$(jq -r '.model' "$SETTINGS")" == "opus" && "$(jq -r '.theme' "$SETTINGS")" == "dark" ]]; then
    ok "unrelated settings keys survive the merge"
else bad "unrelated settings keys survive the merge" "model/theme lost"; fi

# --- 8. result is still valid JSON ------------------------------------------
if jq empty "$SETTINGS" 2>/dev/null; then ok "settings.json is still valid JSON"
else bad "settings.json is still valid JSON" "jq empty failed"; fi

# --- 9. a backup was taken ---------------------------------------------------
if compgen -G "$SETTINGS.bak."* >/dev/null; then ok "a backup was written before the change"
else bad "a backup was written before the change" "no .bak.* file"; fi

# --- 9b. W-20260921-A18: backups are capped, oldest pruned -------------------
# Seven had accumulated beside the real settings.project.json by 2026-09-21 while
# the item that filed it said three: nobody counts a thing that only grows.
# Plant six OLDER backups by name (the suffix is YYYYmmdd_HHMMSS, so a reverse
# sort is newest-first and no stat call is needed), then force one real change
# and check what survives.
_bak_count(){ find "$(dirname "$SETTINGS")" -maxdepth 1 -name "$(basename "$SETTINGS").bak.*" -print 2>/dev/null | wc -l | tr -d ' '; }
for d in 20260101_000001 20260101_000002 20260101_000003 20260101_000004 20260101_000005 20260101_000006; do
    cp "$SETTINGS" "$SETTINGS.bak.$d"
done
planted=$(_bak_count)
if [[ "$planted" -ge 7 ]]; then ok "CONTROL: $planted backups planted, so the prune has something to bite on"
else bad "CONTROL: backups planted" "wanted >=7, got $planted"; fi
# A change the tool will actually make: drop one registered hook back out.
jq 'del(.hooks.PreToolUse)' "$SETTINGS" > "$SETTINGS.tmp9b" && command mv "$SETTINGS.tmp9b" "$SETTINGS"
out=$(run_tool --install); rc=$?
kept=$(_bak_count)
if [[ "$kept" -eq 3 ]]; then ok "backups capped at the default 3 (was $planted)"
else bad "backups capped at the default 3" "got $kept"; fi
# The two OLDEST planted names must be the ones gone, and the newest planted one
# must still be there -- otherwise "3 remain" is true of pruning the wrong end.
if [[ ! -e "$SETTINGS.bak.20260101_000001" && ! -e "$SETTINGS.bak.20260101_000002" ]]; then
    ok "the OLDEST backups are the ones pruned"
else bad "the OLDEST backups are the ones pruned" "20260101_000001/2 survived"; fi
case "$out" in *"pruned"*) ok "the prune is announced, not silent";; *) bad "the prune is announced, not silent" "no 'pruned' in output: $out";; esac
# KEEP_BACKUPS=0 disables the prune entirely.
for d in 20260101_000007 20260101_000008; do cp "$SETTINGS" "$SETTINGS.bak.$d"; done
before0=$(_bak_count)
jq 'del(.hooks.PreToolUse)' "$SETTINGS" > "$SETTINGS.tmp9c" && command mv "$SETTINGS.tmp9c" "$SETTINGS"
out=$(KEEP_BACKUPS=0 run_tool --install); rc=$?
after0=$(_bak_count)
if [[ "$after0" -ge "$before0" ]]; then ok "KEEP_BACKUPS=0 prunes nothing ($before0 -> $after0)"
else bad "KEEP_BACKUPS=0 prunes nothing" "$before0 -> $after0"; fi
# Put the fixture back the way arm 10 expects it: one settled --install, capped.
out=$(run_tool --install) || true

# --- 10. second run is a no-op, and byte-identical ---------------------------
before=$(shasum "$SETTINGS" | awk '{print $1}')
out=$(run_tool --install); rc=$?
after=$(shasum "$SETTINGS" | awk '{print $1}')
if (( rc == 0 )) && [[ "$before" == "$after" ]]; then
    ok "a second --install is a byte-identical no-op"
else bad "a second --install is a byte-identical no-op" "rc=$rc, hash changed=$([[ $before == $after ]] && echo no || echo yes)"; fi

# --- 11. no temp file left behind -------------------------------------------
strays=$(find "$(dirname "$SETTINGS")" -name '*.tmp*' -o -name '*.new' 2>/dev/null | wc -l | tr -d ' ')
if [[ "$strays" == "0" ]]; then ok "no temp file is left behind"
else bad "no temp file is left behind" "$strays stray file(s)"; fi
cleanup

# --- 12. THE GATE: requires missing -> entry skipped, and said so ------------
fixture no-skill with-script
out=$(run_tool --install); rc=$?
if [[ "$(count_cmd '$HOME/.claude/hooks/newcomer.sh')" == "0" ]]; then
    ok "requires-gate: entry is NOT registered when its requirement is absent"
else bad "requires-gate: entry is NOT registered when its requirement is absent" "it was added anyway"; fi
if grep -qi "skip" <<<"$out" && grep -q "skills/herdr" <<<"$out"; then
    ok "requires-gate: the reason is printed"
else bad "requires-gate: the reason is printed" "$out"; fi
if (( rc == 0 )); then ok "requires-gate: a gated skip is not an error"
else bad "requires-gate: a gated skip is not an error" "exit was $rc"; fi
cleanup

# --- 13. script missing on disk -> entry skipped ----------------------------
fixture with-skill no-script
out=$(run_tool --install)
if [[ "$(count_cmd '$HOME/.claude/hooks/newcomer.sh')" == "0" ]]; then
    ok "a hook whose script is absent is NOT registered"
else bad "a hook whose script is absent is NOT registered" "it was added anyway"; fi
cleanup

# --- 14. --dry-run writes nothing -------------------------------------------
fixture with-skill with-script
before=$(shasum "$SETTINGS" | awk '{print $1}')
run_tool --install --dry-run >/dev/null
after=$(shasum "$SETTINGS" | awk '{print $1}')
if [[ "$before" == "$after" ]]; then ok "--dry-run writes nothing"
else bad "--dry-run writes nothing" "settings.json changed"; fi
cleanup

# --- 15. malformed settings.json -> refuse, exit 2, write nothing -----------
fixture with-skill with-script
printf '{ "hooks": { oops' > "$SETTINGS"
before=$(shasum "$SETTINGS" | awk '{print $1}')
run_tool --install >/dev/null 2>&1; rc=$?
after=$(shasum "$SETTINGS" | awk '{print $1}')
if (( rc == 2 )); then ok "malformed settings.json exits 2"
else bad "malformed settings.json exits 2" "exit was $rc"; fi
if [[ "$before" == "$after" ]]; then ok "malformed settings.json is left untouched"
else bad "malformed settings.json is left untouched" "it was written to"; fi
cleanup

# --- 16. missing settings.json -> exit 2, no crash --------------------------
# MOVE it aside rather than delete it. A delete here goes through the
# Trash-routed rm, which can fail from a sandboxed temp dir and leave the file
# in place -- the tool then finds a perfectly good settings.json and exits 0,
# and the test reports a failure that is entirely the harness's own doing.
# Measured 2026-09-05. A move needs no Trash and states the intent exactly:
# "settings.json is not at this path".
fixture with-skill with-script
command mv "$SETTINGS" "$WORK/settings.json.moved-away"
run_tool --install >/dev/null 2>&1; rc=$?
if (( rc == 2 )); then ok "absent settings.json exits 2 without crashing"
else bad "absent settings.json exits 2 without crashing" "exit was $rc"; fi
cleanup

# ===========================================================================
# SessionStart: the ALARM class, which has a different shape to everything above
# ===========================================================================
# Every case up to here uses PreToolUse with a matcher and a script in
# ~/.claude/hooks/. The real SessionStart block looks nothing like that, and the
# three differences are exactly why ci-watch and ccw-watch could not be expressed
# in the manifest at all until 2026-09-06:
#
#   1. its group carries NO "matcher" key
#   2. the tools live in ~/.local/bin, not ~/.claude/hooks
#   3. the command is a self-gating one-liner, not a bare path
#
# The fixture below is copied from the real settings.json rather than tidied,
# because a tidy fixture is what let the duplicate-registration guard (case 4)
# pass while the same bug was live on the actual machine.
# ---------------------------------------------------------------------------
fixture_sessionstart() {
    local want_tool="$1"   # with-tool | no-tool
    WORK="$(mktemp -d "${TMPDIR:-/tmp}/claude-hooks-sync-ss.XXXXXX")" || WORK=""
    if [[ -z "$WORK" || ! -d "$WORK" ]]; then
        printf '  \033[31mABORT\033[0m  cannot create a temp dir under %s -- no test can be trusted.\n' \
               "${TMPDIR:-/tmp}" >&2
        exit 2
    fi
    REQ_ROOT="$WORK/home"
    HOOKS_DIR="$REQ_ROOT/.claude/hooks"
    SETTINGS="$REQ_ROOT/.claude/settings.json"
    MANIFEST="$WORK/hooks.json"
    mkdir -p "$HOOKS_DIR" "$REQ_ROOT/.local/bin"

    # Shape copied from the live file: a matcherless group holding a QUOTED
    # ~/.claude/hooks command and an already-live watcher, plus a sibling group
    # that does carry a matcher.
    cat > "$SETTINGS" <<'JSON'
{
  "model": "opus",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.claude/hooks/MemoryRootGuard.sh\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "test -x \"$HOME/.local/bin/live-watch\" && \"$HOME/.local/bin/live-watch\" || true",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/somewhere/foreign/herdr-agent-state.sh' session",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "theme": "dark"
}
JSON

    : > "$HOOKS_DIR/MemoryRootGuard.sh"
    if [[ "$want_tool" == "with-tool" ]]; then
        : > "$REQ_ROOT/.local/bin/live-watch"
        : > "$REQ_ROOT/.local/bin/new-watch"
    fi

    cat > "$MANIFEST" <<'JSON'
{
  "hooks": [
    {
      "event": "SessionStart",
      "script": "live-watch",
      "script_path": "$HOME/.local/bin/live-watch",
      "entry": {
        "type": "command",
        "command": "test -x \"$HOME/.local/bin/live-watch\" && \"$HOME/.local/bin/live-watch\" || true",
        "timeout": 30
      },
      "why": "fixture: already registered, byte-identical"
    },
    {
      "event": "SessionStart",
      "script": "new-watch",
      "script_path": "$HOME/.local/bin/new-watch",
      "entry": {
        "type": "command",
        "command": "test -x \"$HOME/.local/bin/new-watch\" && \"$HOME/.local/bin/new-watch\" || true",
        "timeout": 30
      },
      "why": "fixture: the pending one"
    }
  ]
}
JSON
}

# How many times does $1 appear anywhere under SessionStart, across ALL groups?
count_ss() {
    jq --arg c "$1" '[ .hooks.SessionStart[]? | .hooks[]?
                       | select(.command == $c) ] | length' "$SETTINGS"
}
n_ss_groups() { jq '.hooks.SessionStart | length' "$SETTINGS"; }

LIVE_CMD='test -x "$HOME/.local/bin/live-watch" && "$HOME/.local/bin/live-watch" || true'
NEW_CMD='test -x "$HOME/.local/bin/new-watch" && "$HOME/.local/bin/new-watch" || true'

# --- 17. BLOCKER 1: a tool outside ~/.claude/hooks is not skipped -----------
fixture_sessionstart with-tool
out=$(run_tool --check)
if ! grep -qi "not deployed" <<<"$out"; then
    ok "script_path: a hook tool in ~/.local/bin is not reported undeployed"
else bad "script_path: a hook tool in ~/.local/bin is not reported undeployed" "$out"; fi

# --- 18. BLOCKER 3: the byte-identical live entry reads as REGISTERED -------
# The duplication hazard in one assertion. If this fails, --install would add a
# second copy and the watcher would run twice at every session start.
if ! grep -q "live-watch" <<<"$out"; then
    ok "matcherless: an already-live command is NOT reported pending"
else bad "matcherless: an already-live command is NOT reported pending" "$out"; fi
if grep -q "new-watch" <<<"$out"; then
    ok "matcherless: the genuinely missing command IS reported pending"
else bad "matcherless: the genuinely missing command IS reported pending" "$out"; fi
cleanup

# --- 19. --install adds the pending one exactly once, duplicates nothing ----
fixture_sessionstart with-tool
run_tool --install >/dev/null; rc=$?
if (( rc == 0 )); then ok "SessionStart --install exits 0"
else bad "SessionStart --install exits 0" "exit was $rc"; fi
if [[ "$(count_ss "$LIVE_CMD")" == "1" ]]; then
    ok "the already-live watcher is still registered exactly ONCE"
else bad "the already-live watcher is still registered exactly ONCE" "count=$(count_ss "$LIVE_CMD") -- it would run that many times per session"; fi
if [[ "$(count_ss "$NEW_CMD")" == "1" ]]; then
    ok "the pending watcher was added exactly once"
else bad "the pending watcher was added exactly once" "count=$(count_ss "$NEW_CMD")"; fi

# --- 20. BLOCKER 2/4: it joined the existing group, made no new one ---------
if [[ "$(n_ss_groups)" == "2" ]]; then ok "no new SessionStart group was spawned"
else bad "no new SessionStart group was spawned" "groups=$(n_ss_groups)"; fi
if [[ "$(jq '.hooks.SessionStart[0] | has("matcher")' "$SETTINGS")" == "false" ]]; then
    ok "the matcherless group stayed matcherless"
else bad "the matcherless group stayed matcherless" "a matcher key was invented"; fi

# --- 21. the sibling group that DOES have a matcher is untouched ------------
if [[ "$(jq -r '.hooks.SessionStart[1].hooks | length' "$SETTINGS")" == "1" \
   && "$(jq -r '.hooks.SessionStart[1].matcher' "$SETTINGS")" == "*" ]]; then
    ok "the \"*\" sibling group is left alone"
else bad "the \"*\" sibling group is left alone" "it was modified"; fi

# --- 22. a second --install is still a byte-identical no-op -----------------
before=$(shasum "$SETTINGS" | awk '{print $1}')
run_tool --install >/dev/null
after=$(shasum "$SETTINGS" | awk '{print $1}')
if [[ "$before" == "$after" ]]; then ok "SessionStart: a second --install changes nothing"
else bad "SessionStart: a second --install changes nothing" "hash moved -- it is duplicating"; fi
cleanup

# --- 23. the script-exists gate still bites when the tool is absent ---------
fixture_sessionstart no-tool
out=$(run_tool --install); rc=$?
if [[ "$(count_ss "$NEW_CMD")" == "0" ]]; then
    ok "script_path gate: an absent tool is NOT registered"
else bad "script_path gate: an absent tool is NOT registered" "it was added anyway"; fi
if (( rc == 0 )); then ok "script_path gate: a skip is not an error"
else bad "script_path gate: a skip is not an error" "exit was $rc"; fi
cleanup

# ---------------------------------------------------------------------------
#  TARGETS -- which settings file an entry is registered into
#
#  WHY THIS SECTION EXISTS. The pj launcher passes --setting-sources
#  project,local, so ~/.claude/settings.json never loads and none of its
#  SessionStart hooks register. ci-watch is the escalating CI-red alarm, so under
#  the daily launcher the alarm was simply silent -- and silence is exactly what
#  a healthy alarm looks like, which is why it went unnoticed.
#
#  THE ARM THAT MATTERS IS THE NEGATIVE ONE. "ci-watch reached the project file"
#  passes just as well if the filter were ignored and EVERYTHING were written to
#  both files. Only "an entry with no targets key did NOT reach the project file"
#  can tell a working filter from no filter at all.
# ---------------------------------------------------------------------------
fixture_targets() {
    WORK="$(mktemp -d "${TMPDIR:-/tmp}/claude-hooks-sync-tg.XXXXXX")" || WORK=""
    if [[ -z "$WORK" || ! -d "$WORK" ]]; then
        printf '  \033[31mABORT\033[0m  cannot create a temp dir under %s.\n' "${TMPDIR:-/tmp}" >&2
        exit 2
    fi
    REQ_ROOT="$WORK/home"
    HOOKS_DIR="$REQ_ROOT/.claude/hooks"
    SETTINGS="$REQ_ROOT/.claude/settings.json"
    PROJ_SETTINGS="$REQ_ROOT/.claude/settings.project.json"
    MANIFEST="$WORK/hooks.json"
    mkdir -p "$HOOKS_DIR" "$REQ_ROOT/.local/bin"
    printf '{}\n' > "$SETTINGS"
    printf '{}\n' > "$PROJ_SETTINGS"
    : > "$REQ_ROOT/.local/bin/both-watch"
    : > "$REQ_ROOT/.local/bin/user-watch"

    cat > "$MANIFEST" <<'JSON'
{
  "hooks": [
    {
      "event": "SessionStart",
      "script": "both-watch",
      "script_path": "$HOME/.local/bin/both-watch",
      "targets": ["user", "project"],
      "entry": {
        "type": "command",
        "command": "test -x \"$HOME/.local/bin/both-watch\" && \"$HOME/.local/bin/both-watch\" || true",
        "timeout": 30
      },
      "why": "fixture: belongs in both settings files"
    },
    {
      "event": "SessionStart",
      "script": "user-watch",
      "script_path": "$HOME/.local/bin/user-watch",
      "entry": {
        "type": "command",
        "command": "test -x \"$HOME/.local/bin/user-watch\" && \"$HOME/.local/bin/user-watch\" || true",
        "timeout": 30
      },
      "why": "fixture: NO targets key, so user only"
    }
  ]
}
JSON
}

# Run against an explicit settings file and target.
run_target() {
    local t="$1" s="$2"; shift 2   # shift-lint: ok run_target helper, fixed arity, not a loop
    CLAUDE_SETTINGS_FILE="$s" \
    CLAUDE_HOOKS_DIR="$HOOKS_DIR" \
    CLAUDE_HOOKS_MANIFEST="$MANIFEST" \
    CLAUDE_REQUIRES_ROOT="$REQ_ROOT" \
    "$TOOL" --target "$t" "$@" 2>&1
}

count_in() {   # $1 = command substring, $2 = settings file
    jq --arg c "$1" '[ .hooks.SessionStart[]? | .hooks[]?
                       | select((.command // "") | contains($c)) ] | length' "$2"
}

BOTH_NAME="both-watch"
USER_NAME="user-watch"

# --- 24. an entry naming `project` reaches the project file -----------------
fixture_targets
run_target project "$PROJ_SETTINGS" --install >/dev/null
if [[ "$(count_in "$BOTH_NAME" "$PROJ_SETTINGS")" == "1" ]]; then
    ok "targets: an entry naming project is written to settings.project.json"
else bad "targets: an entry naming project is written to settings.project.json" \
         "got $(count_in "$BOTH_NAME" "$PROJ_SETTINGS")"; fi

# --- 25. THE NEGATIVE ARM: no targets key means user only -------------------
if [[ "$(count_in "$USER_NAME" "$PROJ_SETTINGS")" == "0" ]]; then
    ok "targets: an entry with NO targets key does NOT reach the project file"
else bad "targets: an entry with NO targets key does NOT reach the project file" \
         "it was written anyway -- the filter is not filtering"; fi

# --- 26. CONTROL: the user target still takes BOTH entries ------------------
# Without this, case 25 would pass just as well if the manifest were unreadable
# and NOTHING were ever registered anywhere.
run_target user "$SETTINGS" --install >/dev/null
if [[ "$(count_in "$BOTH_NAME" "$SETTINGS")" == "1" && "$(count_in "$USER_NAME" "$SETTINGS")" == "1" ]]; then
    ok "CONTROL: the user target registers both entries (the fixture is live)"
else bad "CONTROL: the user target registers both entries (the fixture is live)" \
         "both=$(count_in "$BOTH_NAME" "$SETTINGS") user=$(count_in "$USER_NAME" "$SETTINGS")"; fi

# --- 27. a second project install is a byte-identical no-op -----------------
before=$(shasum "$PROJ_SETTINGS" | awk '{print $1}')
run_target project "$PROJ_SETTINGS" --install >/dev/null
after=$(shasum "$PROJ_SETTINGS" | awk '{print $1}')
if [[ "$before" == "$after" ]]; then ok "targets: a second project --install changes nothing"
else bad "targets: a second project --install changes nothing" "hash moved -- it is duplicating"; fi

# --- 28. an unknown target refuses, and writes nothing ----------------------
before=$(shasum "$PROJ_SETTINGS" | awk '{print $1}')
out=$(run_target banana "$PROJ_SETTINGS" --install); rc=$?
after=$(shasum "$PROJ_SETTINGS" | awk '{print $1}')
if (( rc == 2 )); then ok "targets: an unknown --target exits 2"
else bad "targets: an unknown --target exits 2" "exit was $rc"; fi
if [[ "$before" == "$after" ]]; then ok "targets: an unknown --target writes nothing"
else bad "targets: an unknown --target writes nothing" "the file changed"; fi

# --- 29. the DEFAULT path is target-dependent, not just the env override ----
# Every case above passes CLAUDE_SETTINGS_FILE explicitly, so none of them would
# notice if --target project quietly fell back to settings.json. This one drops
# the override and checks where the tool goes on its own.
cleanup
fixture_targets
out=$(HOME="$REQ_ROOT" \
      CLAUDE_HOOKS_DIR="$HOOKS_DIR" \
      CLAUDE_HOOKS_MANIFEST="$MANIFEST" \
      CLAUDE_REQUIRES_ROOT="$REQ_ROOT" \
      "$TOOL" --target project --install 2>&1)
if [[ "$(count_in "$BOTH_NAME" "$PROJ_SETTINGS")" == "1" \
   && "$(count_in "$BOTH_NAME" "$SETTINGS")" == "0" ]]; then
    ok "targets: with no env override, project resolves to settings.project.json"
else bad "targets: with no env override, project resolves to settings.project.json" \
         "proj=$(count_in "$BOTH_NAME" "$PROJ_SETTINGS") user=$(count_in "$BOTH_NAME" "$SETTINGS")"; fi
cleanup

# --- 30. an override that is SET but EMPTY is refused, not silently replaced --
# `${CLAUDE_REQUIRES_ROOT:-$HOME}` reads "" as unset, so a selftest exporting an
# empty root would have the requires gate checked against the real ~ and pass
# while proving nothing (the renderer shipped that bug on 2026-09-19). Arm one:
# empty override exits 2 and writes nothing. Control: the same command with the
# override UNSET runs and registers, so the refusal is the guard and not a
# broken fixture.
fixture with-skill with-script
before=$(cat "$SETTINGS")
out=$(CLAUDE_SETTINGS_FILE="$SETTINGS" \
      CLAUDE_HOOKS_DIR="$HOOKS_DIR" \
      CLAUDE_HOOKS_MANIFEST="$MANIFEST" \
      CLAUDE_REQUIRES_ROOT="" \
      "$TOOL" --install 2>&1); rc=$?
after=$(cat "$SETTINGS")
if (( rc == 2 )) && [[ "$out" == *"CLAUDE_REQUIRES_ROOT is set but EMPTY"* ]]; then
    ok "empty override: CLAUDE_REQUIRES_ROOT=\"\" exits 2 and names the variable"
else bad "empty override: CLAUDE_REQUIRES_ROOT=\"\" exits 2 and names the variable" "exit was $rc: $out"; fi
if [[ "$before" == "$after" ]]; then ok "empty override: writes nothing"
else bad "empty override: writes nothing" "the settings file changed"; fi
out=$(CLAUDE_SETTINGS_FILE="$SETTINGS" \
      CLAUDE_HOOKS_DIR="$HOOKS_DIR" \
      CLAUDE_HOOKS_MANIFEST="$MANIFEST" \
      CLAUDE_REQUIRES_ROOT="$REQ_ROOT" \
      "$TOOL" --install 2>&1); rc=$?
if (( rc == 0 )) && [[ "$(cat "$SETTINGS")" != "$before" ]]; then
    ok "empty override control: a real CLAUDE_REQUIRES_ROOT runs and registers"
else bad "empty override control: a real CLAUDE_REQUIRES_ROOT runs and registers" "exit was $rc"; fi
cleanup

# ===========================================================================
# W-20260924-A76: class, legacy_commands (in-place upgrade), retired, and the
# command SHAPE of every real manifest entry. Gavin's rulings 2026-09-25: a
# missing guard denies; retiring is moving the entry to `retired`.
# ===========================================================================
LEG='test -x "$HOME/.claude/hooks/g.sh" && "$HOME/.claude/hooks/g.sh" || true'
NEWG='h="$HOME/.claude/hooks/g.sh"; if [ -x "$h" ]; then "$h"; else echo gone >&2; exit 2; fi'

# A throwaway tree whose manifest holds ONE entry, built by jq from $1 (a JSON
# object merged over a default guard entry). Settings get $2 as .hooks.
fixture_a76() {
    WORK="$(mktemp -d "${TMPDIR:-/tmp}/claude-hooks-sync-a76.XXXXXX")" || WORK=""
    if [[ -z "$WORK" || ! -d "$WORK" ]]; then
        printf '  \033[31mABORT\033[0m  cannot create a temp dir -- no test can be trusted.\n' >&2; exit 2
    fi
    REQ_ROOT="$WORK/home"; HOOKS_DIR="$REQ_ROOT/.claude/hooks"
    SETTINGS="$REQ_ROOT/.claude/settings.json"; MANIFEST="$WORK/hooks.json"
    mkdir -p "$HOOKS_DIR"; : > "$HOOKS_DIR/g.sh"; : > "$HOOKS_DIR/other.sh"
    jq -n --arg leg "$LEG" --arg new "$NEWG" --argjson over "$1" '
      { hooks: [ ({ event: "PreToolUse", matcher: "Bash", script: "g.sh", class: "guard",
                    entry: { type: "command", command: $new, timeout: 5 },
                    legacy_commands: [ $leg ], why: "fixture guard" } + $over) ],
        retired: [] }' > "$MANIFEST"
    jq -n --argjson h "$2" '{ model: "opus", hooks: $h, theme: "dark" }' > "$SETTINGS"
}
cmds_at() {   # cmds_at <event> <matcher|""> -> JSON array of commands, group order kept
    jq -c --arg e "$1" --arg m "$2" '[ .hooks[$e][]? | select($m == "" or .matcher == $m) | .hooks[]?.command ]' "$SETTINGS"
}
FOREIGN='{"type":"command","command":"${PAI_DIR}/hooks/SecurityValidator.hook.ts"}'
OTHER='{"type":"command","command":"$HOME/.claude/hooks/other.sh"}'
LEGH="$(jq -cn --arg c "$LEG" '{type:"command",command:$c,timeout:5}')"
NEWH="$(jq -cn --arg c "$NEWG" '{type:"command",command:$c,timeout:5}')"

# --- 31. the class rule refuses a guard whose command swallows its exit code --
fixture_a76 "$(jq -cn --arg c "$LEG" '{entry:{type:"command",command:$c}}')" "{\"PreToolUse\":[{\"matcher\":\"Bash\",\"hooks\":[$OTHER]}]}"
before=$(shasum "$SETTINGS"); out=$(run_tool --install); rc=$?
if (( rc == 2 )) && [[ "$out" == *"g.sh: class guard, but its command contains ||"* ]] && [[ "$before" == "$(shasum "$SETTINGS")" ]]; then
    ok "A76 class: a guard command with || is refused (exit 2, names it, writes nothing)"
else bad "A76 class: a guard command with || is refused (exit 2, names it, writes nothing)" "rc=$rc out=$out"; fi
# CONTROL: the same command as an ALARM is accepted, so the refusal is the class rule
jq '.hooks[0].class = "alarm"' "$MANIFEST" > "$MANIFEST.t" && command mv "$MANIFEST.t" "$MANIFEST"
out=$(run_tool --install); rc=$?
if (( rc == 0 )) && [[ "$(cmds_at PreToolUse Bash)" == *'|| true'* ]]; then
    ok "A76 class control: the same || command as an alarm is accepted and registered"
else bad "A76 class control: the same || command as an alarm is accepted and registered" "rc=$rc out=$out"; fi
cleanup

# --- 32. no class: enforce-* defaults to guard, anything else to alarm ------
fixture_a76 "$(jq -cn --arg c "$LEG" '{script:"enforce-x.sh", class:null, entry:{type:"command",command:$c}} | del(.class)')" '{}'
jq '.hooks[0] |= del(.class)' "$MANIFEST" > "$MANIFEST.t" && command mv "$MANIFEST.t" "$MANIFEST"
out=$(run_tool --check); rc=$?
if (( rc == 2 )) && [[ "$out" == *"enforce-x.sh: class guard"* ]]; then
    ok "A76 class: an unclassed enforce-* script defaults to guard (and is refused with ||)"
else bad "A76 class: an unclassed enforce-* script defaults to guard (and is refused with ||)" "rc=$rc out=$out"; fi
jq '.hooks[0].script = "g.sh"' "$MANIFEST" > "$MANIFEST.t" && command mv "$MANIFEST.t" "$MANIFEST"
out=$(run_tool --check); rc=$?
if (( rc != 2 )); then ok "A76 class control: an unclassed non-enforce script defaults to alarm (|| allowed)"
else bad "A76 class control: an unclassed non-enforce script defaults to alarm (|| allowed)" "rc=$rc out=$out"; fi
cleanup

# --- 33. an unknown class, and a guard off PreToolUse, are refused ----------
fixture_a76 '{"class":"guardd"}' '{}'
out=$(run_tool --check); rc=$?
if (( rc == 2 )) && [[ "$out" == *'unknown class "guardd"'* ]]; then ok "A76 class: an unknown class is refused"
else bad "A76 class: an unknown class is refused" "rc=$rc out=$out"; fi
cleanup
fixture_a76 '{"event":"UserPromptSubmit","matcher":null}' '{}'
jq '.hooks[0] |= del(.matcher)' "$MANIFEST" > "$MANIFEST.t" && command mv "$MANIFEST.t" "$MANIFEST"
out=$(run_tool --check); rc=$?
if (( rc == 2 )) && [[ "$out" == *"class guard on UserPromptSubmit"* ]]; then
    ok "A76 class: a guard on UserPromptSubmit is refused (only PreToolUse reads a deny)"
else bad "A76 class: a guard on UserPromptSubmit is refused (only PreToolUse reads a deny)" "rc=$rc out=$out"; fi
cleanup
# A quote or backslash in the path would break the hand-built HOOK MISSING JSON.
# Every other fixture in this file has a plain path and is accepted: that is the control.
for bad_path in 'g"q.sh' "g'q.sh" 'g\q.sh'; do
    fixture_a76 "$(jq -cn --arg p "\$HOME/.claude/hooks/$bad_path" '{script_path: $p}')" '{}'
    out=$(run_tool --check); rc=$?
    if (( rc == 2 )) && [[ "$out" == *"a quote or backslash in script or script_path"* ]]; then
        ok "A76 class: a script_path holding $bad_path is refused"
    else bad "A76 class: a script_path holding $bad_path is refused" "rc=$rc out=$out"; fi
    cleanup
done

# --- 34. THE UPGRADE: the old string is replaced in place, never duplicated ---
fixture_a76 '{}' "{\"PreToolUse\":[{\"matcher\":\"Bash\",\"hooks\":[$FOREIGN]},{\"matcher\":\"Bash\",\"hooks\":[$OTHER,$LEGH]},{\"matcher\":\"Grep\",\"hooks\":[$LEGH]}]}"
out=$(run_tool --check); rc=$?
if (( rc == 1 )) && [[ "$out" == *"1 need an upgrade"* && "$out" == *"needs upgrade"* ]]; then
    ok "A76 upgrade: --check reports the legacy line as needing an upgrade (exit 1)"
else bad "A76 upgrade: --check reports the legacy line as needing an upgrade (exit 1)" "rc=$rc out=$out"; fi
grep_before=$(cmds_at PreToolUse Grep)
out=$(run_tool --install); rc=$?
want=$(jq -cn --arg o '$HOME/.claude/hooks/other.sh' --arg n "$NEWG" '["${PAI_DIR}/hooks/SecurityValidator.hook.ts", $o, $n]')
if (( rc == 0 )) && [[ "$(cmds_at PreToolUse Bash)" == "$want" ]]; then
    ok "A76 upgrade: the legacy line became the new one AT THE SAME POSITION, once"
else bad "A76 upgrade: the legacy line became the new one AT THE SAME POSITION, once" "rc=$rc got $(cmds_at PreToolUse Bash)"; fi
if [[ "$(cmds_at PreToolUse Grep)" == "$grep_before" && "$grep_before" == *'|| true'* ]]; then
    ok "A76 upgrade: the same string under ANOTHER matcher is out of scope and untouched"
else bad "A76 upgrade: the same string under ANOTHER matcher is out of scope and untouched" "$(cmds_at PreToolUse Grep)"; fi
if [[ "$(jq -c '[.model, .theme, (.hooks.PreToolUse | length)]' "$SETTINGS")" == '["opus","dark",3]' ]]; then
    ok "A76 upgrade: unrelated keys and the group count are untouched"
else bad "A76 upgrade: unrelated keys and the group count are untouched" "$(jq -c '[.model, .theme, (.hooks.PreToolUse | length)]' "$SETTINGS")"; fi
before=$(shasum "$SETTINGS"); run_tool --install >/dev/null
if [[ "$before" == "$(shasum "$SETTINGS")" ]]; then ok "A76 upgrade: a second --install is a byte-identical no-op"
else bad "A76 upgrade: a second --install is a byte-identical no-op" "the file moved"; fi
out=$(run_tool --check); rc=$?
if (( rc == 0 )); then ok "A76 upgrade: --check is clean afterwards"
else bad "A76 upgrade: --check is clean afterwards" "rc=$rc out=$out"; fi
cleanup

# --- 35. new AND legacy both present: the legacy copy goes, the new stays once --
fixture_a76 '{}' "{\"PreToolUse\":[{\"matcher\":\"Bash\",\"hooks\":[$NEWH]},{\"matcher\":\"Bash\",\"hooks\":[$LEGH]},{\"matcher\":\"Bash\",\"hooks\":[]}]}"
out=$(run_tool --check); rc=$?
if (( rc == 1 )) && [[ "$out" == *"needs upgrade"* ]]; then
    ok "A76 upgrade: a legacy copy beside the new one still reads as needing an upgrade"
else bad "A76 upgrade: a legacy copy beside the new one still reads as needing an upgrade" "rc=$rc out=$out"; fi
run_tool --install >/dev/null
if [[ "$(cmds_at PreToolUse Bash)" == "$(jq -cn --arg n "$NEWG" '[$n]')" ]]; then
    ok "A76 upgrade: the swallowing copy is removed, the new command stays exactly once"
else bad "A76 upgrade: the swallowing copy is removed, the new command stays exactly once" "$(cmds_at PreToolUse Bash)"; fi
if [[ "$(jq '.hooks.PreToolUse | length' "$SETTINGS")" == 2 ]]; then
    ok "A76 upgrade: the group it emptied is dropped; a group that was ALREADY empty stays"
else bad "A76 upgrade: the group it emptied is dropped; a group that was ALREADY empty stays" "$(jq -c '.hooks.PreToolUse' "$SETTINGS")"; fi
cleanup

# --- 36. a matcherless SessionStart legacy line is upgraded in place --------
fixture_a76 "$(jq -cn --arg n "$NEWG" --arg l "$LEG" '{event:"SessionStart", class:"alarm", entry:{type:"command",command:($n|sub("; else"; " || true; else")),timeout:5}}')" \
            "{\"SessionStart\":[{\"hooks\":[$OTHER,$LEGH]}]}"
jq '.hooks[0] |= del(.matcher)' "$MANIFEST" > "$MANIFEST.t" && command mv "$MANIFEST.t" "$MANIFEST"
before_dry=$(shasum "$SETTINGS"); out=$(run_tool --install --dry-run)
if [[ "$before_dry" == "$(shasum "$SETTINGS")" && "$out" == *"would upgrade"* ]]; then
    ok "A76 upgrade: --dry-run names the upgrade and writes nothing"
else bad "A76 upgrade: --dry-run names the upgrade and writes nothing" "$out"; fi
run_tool --install >/dev/null
got=$(jq -c '[.hooks.SessionStart[] | [has("matcher"), [.hooks[].command | contains("|| true; else")]]]' "$SETTINGS")
if [[ "$got" == '[[false,[false,true]]]' ]]; then
    ok "A76 upgrade: a matcherless SessionStart line is replaced in place, group stays matcherless"
else bad "A76 upgrade: a matcherless SessionStart line is replaced in place, group stays matcherless" "$got"; fi
cleanup

# --- 37. RETIRED: removed from BOTH targets, whatever its targets said ------
fixture_a76 '{}' "{\"PreToolUse\":[{\"matcher\":\"Bash\",\"hooks\":[$OTHER,$NEWH]},{\"matcher\":\"Bash\",\"hooks\":[$LEGH]},{\"matcher\":\"Bash\",\"hooks\":[]}]}"
jq '.retired = [ .hooks[0] + {targets: ["project"]} ] | .hooks = []' "$MANIFEST" > "$MANIFEST.t" && command mv "$MANIFEST.t" "$MANIFEST"
command cp "$SETTINGS" "$WORK/project.json"
command rm -f "$HOOKS_DIR/g.sh" 2>/dev/null; command mv "$HOOKS_DIR/g.sh" "$WORK/g.sh.gone" 2>/dev/null
out=$(run_tool --check); rc=$?
if (( rc == 1 )) && [[ "$out" == *"retired hook(s) still registered"* ]]; then
    ok "A76 retired: --check reports a retired hook still registered (exit 1)"
else bad "A76 retired: --check reports a retired hook still registered (exit 1)" "rc=$rc out=$out"; fi
for tgt in user project; do
    f="$SETTINGS"; [[ "$tgt" == project ]] && f="$WORK/project.json"
    CLAUDE_SETTINGS_FILE="$f" CLAUDE_HOOKS_DIR="$HOOKS_DIR" CLAUDE_HOOKS_MANIFEST="$MANIFEST" \
        CLAUDE_REQUIRES_ROOT="$REQ_ROOT" "$TOOL" --target "$tgt" --install >/dev/null 2>&1
    got=$(jq -c '[.hooks.PreToolUse[] | [.hooks[]?.command]]' "$f")
    if [[ "$got" == '[["$HOME/.claude/hooks/other.sh"],[]]' ]]; then
        ok "A76 retired: $tgt target loses the new AND the legacy line; unrelated line and pre-empty group stay"
    else bad "A76 retired: $tgt target loses the new AND the legacy line; unrelated line and pre-empty group stay" "$got"; fi
done
before=$(shasum "$SETTINGS"); run_tool --install >/dev/null
if [[ "$before" == "$(shasum "$SETTINGS")" ]]; then ok "A76 retired: a second --install is a byte-identical no-op"
else bad "A76 retired: a second --install is a byte-identical no-op" "the file moved"; fi
cleanup

# --- 38. THE REAL MANIFEST: every entry classed, and the class rule accepts it --
REAL_MANIFEST="${CLAUDE_HOOKS_REAL_MANIFEST:-}"
if [[ -z "$REAL_MANIFEST" ]]; then
    _self="$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || true)"
    [[ -n "$_self" ]] && REAL_MANIFEST="$(dirname "$(dirname "$(dirname "$(dirname "$_self")")")")/settings/claude/hooks.json"
fi
if [[ ! -f "$REAL_MANIFEST" ]]; then
    bad "A76 real manifest found beside this selftest" "not at ${REAL_MANIFEST:-<unresolved>}; set CLAUDE_HOOKS_REAL_MANIFEST"
else
    unclassed=$(jq -r '[.hooks[] | select(has("class") | not) | .script] | join(" ")' "$REAL_MANIFEST")
    if [[ -z "$unclassed" ]]; then ok "A76 real manifest: every entry names its class"
    else bad "A76 real manifest: every entry names its class" "unclassed: $unclassed"; fi
    fixture with-skill with-script
    out=$(CLAUDE_SETTINGS_FILE="$SETTINGS" CLAUDE_HOOKS_DIR="$HOOKS_DIR" CLAUDE_HOOKS_MANIFEST="$REAL_MANIFEST" \
          CLAUDE_REQUIRES_ROOT="$REQ_ROOT" "$TOOL" --target project --check 2>&1); rc=$?
    if (( rc != 2 )); then ok "A76 real manifest: the class rule accepts it (check exit $rc, not 2)"
    else bad "A76 real manifest: the class rule accepts it" "$out"; fi
    # CONTROL: put the old swallowing shape back on one real guard; now it must refuse
    jq '(.hooks[] | select(.class == "guard") | .entry.command) |= (. + " || true")' "$REAL_MANIFEST" > "$WORK/mut.json"
    out=$(CLAUDE_SETTINGS_FILE="$SETTINGS" CLAUDE_HOOKS_DIR="$HOOKS_DIR" CLAUDE_HOOKS_MANIFEST="$WORK/mut.json" \
          CLAUDE_REQUIRES_ROOT="$REQ_ROOT" "$TOOL" --target project --check 2>&1); rc=$?
    if (( rc == 2 )); then ok "A76 real manifest control: the same manifest with || on its guards is refused"
    else bad "A76 real manifest control: the same manifest with || on its guards is refused" "rc=$rc"; fi
    cleanup
fi

# --- 39. THE SHAPE of every real entry, run under each shell hooks may get ---
# Claude Code runs a hook command through a shell: /bin/bash 3.2 on this Mac
# (measured 2026-09-25), often dash as /bin/sh on Linux. For each entry: the
# script present and exiting 0, 2 and 7; then absent; then not executable.
#   guard, advisory: the exit code passes through untouched
#   alarm:           exit 0 whatever the script says
#   absent / not executable:
#     guard   exit 0, stdout one JSON object: PreToolUse permissionDecision "deny",
#             reason starting "HOOK MISSING, DENYING: <script>" (the mechanism every
#             guard here uses; exit 2 is not measured here, conductor 2026-09-25)
#     others  exit 0, stdout one JSON object whose systemMessage starts
#             "HOOK MISSING: <script>" (and names the event unless SessionEnd)
shape_run() {   # shape_run <manifest> -> sets SP SF SHELLS
    local m="$1" root n i cls s cmd sp f sh code out err rc want args
    SP=0; SF=0; SHELLS=""
    root="$(mktemp -d "${TMPDIR:-/tmp}/claude-hooks-shape.XXXXXX")" || { SF=1; return; }
    WORK="$root"
    for sh in /bin/bash /bin/sh /bin/dash /usr/bin/dash; do [[ -x "$sh" ]] && SHELLS="$SHELLS $sh"; done
    n=$(jq '.hooks | length' "$m")
    for (( i = 0; i < n; i++ )); do
        cls=$(jq -r ".hooks[$i].class" "$m"); s=$(jq -r ".hooks[$i].script" "$m")
        cmd=$(jq -r ".hooks[$i].entry.command" "$m"); ev=$(jq -r ".hooks[$i].event" "$m")
        sp=$(jq -r --arg s "$s" ".hooks[$i].script_path // (\"\$HOME/.claude/hooks/\" + \$s)" "$m")
        f="${sp/\$HOME/$root}"; mkdir -p "$(dirname "$f")"
        args=$(printf '%s' "$cmd" | sed -n 's/.*then "\$h"\( [^;|]*\)\{0,1\}\( || true\)\{0,1\}; else.*/\1/p')
        for sh in $SHELLS; do
            for code in 0 2 7; do
                printf '#!/bin/sh\ncat >/dev/null\necho "ran:$*"\nexit %s\n' "$code" > "$f"; chmod +x "$f"
                out=$(printf '{"x":1}' | HOME="$root" "$sh" -c "$cmd" 2>/dev/null); rc=$?
                want=$code; [[ "$cls" == alarm ]] && want=0
                if [[ "$rc" == "$want" && "$out" == "ran:${args# }" ]]; then SP=$((SP+1))
                else SF=$((SF+1)); printf '        %s %s present exit %s: rc=%s out=%s\n' "$s" "$sh" "$code" "$rc" "$out"; fi
            done
            for mode in absent noexec; do
                if [[ "$mode" == absent ]]; then command mv "$f" "$f.gone"; else command mv "$f.gone" "$f"; chmod -x "$f"; fi
                out=$(printf '{"x":1}' | HOME="$root" "$sh" -c "$cmd" 2>"$root/err"); rc=$?; err=$(cat "$root/err")
                if [[ "$cls" == guard ]]; then
                    if [[ "$rc" == 0 && -z "$err" ]] && printf '%s' "$out" | jq -e --arg s "$s" '
                            .hookSpecificOutput.hookEventName == "PreToolUse"
                            and .hookSpecificOutput.permissionDecision == "deny"
                            and (.hookSpecificOutput.permissionDecisionReason | startswith("HOOK MISSING, DENYING: " + $s + " "))' >/dev/null 2>&1; then
                        SP=$((SP+1))
                    else SF=$((SF+1)); printf '        %s %s %s: rc=%s out=%s err=%s\n' "$s" "$sh" "$mode" "$rc" "${out:0:60}" "${err:0:40}"; fi
                elif [[ "$rc" == 0 ]] && printf '%s' "$out" | jq -e --arg s "$s" --arg ev "$ev" '
                        (.systemMessage | startswith("HOOK MISSING: " + $s + " "))
                        and (if $ev == "SessionEnd" then true
                             else .hookSpecificOutput.hookEventName == $ev
                                  and (.hookSpecificOutput.additionalContext | startswith("HOOK MISSING")) end)' >/dev/null 2>&1; then
                    SP=$((SP+1))
                else SF=$((SF+1)); printf '        %s %s %s: rc=%s out=%s\n' "$s" "$sh" "$mode" "$rc" "${out:0:60}"; fi
            done
            command mv "$f" "$f.old.$RANDOM"
        done
    done
    cleanup
}
if [[ -f "$REAL_MANIFEST" ]]; then
    shape_run "$REAL_MANIFEST"
    n_real=$(jq '.hooks | length' "$REAL_MANIFEST")
    if (( SF == 0 && SP > 0 )); then
        ok "A76 shape: all $n_real real entries behave by class under$SHELLS ($SP cases)"
    else bad "A76 shape: all $n_real real entries behave by class under$SHELLS" "$SP passed, $SF failed"; fi
    case "$SHELLS" in *bash*) ;; *) bad "A76 shape: /bin/bash was among the shells" "shells:$SHELLS" ;; esac
    # CONTROL: the SAME harness on each entry's OLD command (legacy_commands[0]) must
    # fail -- the swallowed exit 2 and the silent absence are exactly what it tests.
    jq '.hooks |= map(.entry.command = .legacy_commands[0])' "$REAL_MANIFEST" > "${TMPDIR:-/tmp}/a76-legacy-$$.json"
    shape_run "${TMPDIR:-/tmp}/a76-legacy-$$.json" >/dev/null
    command mv "${TMPDIR:-/tmp}/a76-legacy-$$.json" "${TMPDIR:-/tmp}/a76-legacy-$$.json.done" 2>/dev/null
    if (( SF > 0 )); then ok "A76 shape control: the old commands FAIL the same harness ($SF cases)"
    else bad "A76 shape control: the old commands FAIL the same harness" "the harness cannot fail"; fi
fi

echo
echo "  $PASS passed, $FAIL failed"
(( FAIL == 0 ))
