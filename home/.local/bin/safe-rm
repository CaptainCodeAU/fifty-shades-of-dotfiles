#!/usr/bin/env sh
# safe-rm -- delete by moving to the system Trash. It never unlinks anything.
#
# WHY THIS EXISTS
# ---------------
# ~/.zshrc defines rm()/rmdir() wrappers that route deletions to the Trash, but a shell
# function only exists in an INTERACTIVE zsh. Every script in this repo runs under
# `#!/usr/bin/env bash` or as a hook, never loads .zshrc, and therefore calls the real
# /bin/rm. install.sh in particular deletes a user's EXISTING dotfiles when it resolves a
# stow conflict -- permanently, with no recovery, today. That is the gap this closes: the
# protection has to live in a command on PATH, not in a shell function, so that callers
# outside an interactive shell get it too.
#
# SCOPE (deliberate, decided 2026-08-10; superseded in practice 2026-09-04 -- read on)
# --------------------------------------------------------------------------------------
# Use safe-rm for anything the caller did NOT create itself in a temp directory: the user's
# files, installed artifacts, generated trees inside their projects. Do NOT use it for a
# script's own mktemp scratch -- routing that here would drop a scratch directory into the
# Trash on every SessionStart hook run, and a Trash full of machine noise is one nobody
# reads, which defeats the point of having a recoverable delete at all.
#
# THAT RULE IS NO LONGER ENFORCEABLE, and the resolution went the other way. ~/.local/bin/rm
# now shims every bare `rm` on PATH straight to here, and a shim cannot tell a script's
# scratch from a user's files. The operator chose total coverage over a quiet Trash on
# 2026-09-04, with the cost measured first. So a script that writes `rm -rf "$tmp"` WILL fill
# the Trash, and that is now expected rather than a bug.
#
# DO NOT "fix" that by reaching for /bin/rm. CLAUDE.md makes it BINDING that no agent, script
# or hook calls the real deleter in any form -- /bin/rm, /bin/rm -P, unlink, find -delete,
# SAFE_RM_OFF=1. Those exist for a human's deliberate choice only. A script that wants its
# scratch gone quietly should put it under $TMPDIR and simply leave it: the OS reaps that
# directory, no delete call needed. If a temp dir genuinely must be removed inside a script,
# route it here like everything else and let the Trash carry the noise.
# See docs/DELETION_SAFETY.md.
#
# USAGE
#   safe-rm [-q|--quiet] [rm-style flags, accepted and ignored] [--] TARGET...
#
# rm-style flags (-r, -f, -rf, -i, ...) are accepted so existing call sites convert with a
# one-word edit, and ignored because the Trash tools do not need them. There is deliberately
# NO force/permanent mode: if you want one, you want /bin/rm, and you should have to say so.
#
# A target that does not exist is skipped silently (rm -f semantics). A DANGLING SYMLINK is
# still trashed -- it exists as a link even though its target does not.
#
# If no trash tool is installed, this FAILS (exit 1) and deletes nothing. It never falls
# back to rm; a silent downgrade from "recoverable" to "permanent" is the one behaviour this
# command must not have.

set -u

quiet=0
no_more_flags=0
# POSIX sh has no arrays. Collect targets positionally: shift the option args off the front,
# then re-append each target to the end of "$@" so what remains is exactly the target list.
argc=$#
i=0
while [ "$i" -lt "$argc" ]; do
	arg="$1"
	shift
	i=$((i + 1))
	if [ "$no_more_flags" -eq 0 ]; then
		case "$arg" in
			--) no_more_flags=1; continue ;;
			-q|--quiet) quiet=1; continue ;;
			-*) continue ;;   # rm-style flag: accepted, ignored
		esac
	fi
	set -- "$@" "$arg"
done

if [ $# -eq 0 ]; then
	echo "safe-rm: no targets given" >&2
	echo "usage: safe-rm [-q] [--] TARGET..." >&2
	exit 1
fi

# Resolve a trash tool once. macOS: `trash` (-> ~/.Trash, Finder "Put Back").
# Linux/WSL: `trash-put` from trash-cli (-> XDG trash, restore with trash-restore).
if command -v trash >/dev/null 2>&1; then
	trash_cmd=trash
	restore_hint="recover: Finder -> Put Back"
elif command -v trash-put >/dev/null 2>&1; then
	trash_cmd=trash-put
	restore_hint="recover: trash-restore"
else
	echo "safe-rm: no trash tool found -- refusing to delete anything." >&2
	echo "         macOS: brew install trash    Linux: apt install trash-cli" >&2
	echo "         (safe-rm never falls back to rm: that would turn a recoverable" >&2
	echo "          delete into a permanent one without saying so.)" >&2
	exit 1
fi
command -v trash-restore >/dev/null 2>&1 && restore_hint="recover: trash-restore"

# Skip targets that are not there. -e is false for a dangling symlink, so test -L too.
#
# A target whose name starts with `-` is ALSO rewritten to ./NAME here. The trash tools have
# no `--` convention -- we strip ours above, and passing it through would not have helped --
# so a leading dash arrives as an OPTION. Worse, macOS `trash` exits 0 on an argument it does
# not recognise, printing only "# Un-recognized argument". Measured 2026-09-04:
#
#   $ safe-rm -- -v real.txt
#   🗑️  Trashed: -v real.txt      <- reported success, exit 0
#   $ ls
#   -v                            <- still there; only real.txt was trashed
#
# That is precisely the behaviour this command exists to not have. ./-v names the same file
# in a form no argument parser can mistake for a flag.
existing=0
argc=$#
i=0
while [ "$i" -lt "$argc" ]; do
	t="$1"
	shift
	i=$((i + 1))

	# Match /bin/rm's rule: "." and ".." may not be removed. The trash tools have no such
	# rule, and the consequence was the worst failure this script has had. Measured
	# 2026-09-04, before this check:
	#
	#   $ cd victim && rm -rf .
	#   safe-rm: trash reported success but these still exist: .
	#            They are UNCHANGED. Nothing was deleted permanently.
	#   $ ls ..
	#                                  <- victim/ was GONE, secret.txt with it
	#
	# The whole tree moved to the Trash while the message said nothing had happened. The
	# survivor re-check below cannot catch this one: `[ -e . ]` re-resolves against the
	# process's cwd every time, so it stays true after the directory itself has moved. A
	# SUCCESS REPORTING REFUSAL is worse than the reverse -- nobody goes hunting in the
	# Trash for a file they were just told was never touched, and a calling script reads
	# the exit 1 as "cleanup failed" and may retry.
	#
	# This is reachable without a typo: `find . -type d -exec rm -rf {} +` hands over a
	# literal `.` as its first operand.
	#
	# Trailing slashes are stripped first so `./`, `../`, `foo/.` and `foo/..` are caught
	# as well as the bare forms.
	s="$t"
	while [ "$s" != "/" ] && [ "${s%/}" != "$s" ]; do s="${s%/}"; done
	case "$s" in
		. | .. | */. | */..)
			echo "safe-rm: \"$t\": \".\" and \"..\" may not be removed" >&2
			exit 1
			;;
		/)
			# Defence in depth, and deliberately NOT tested against /bin/rm's own
			# behaviour: refusing costs nothing, and being wrong about this one costs
			# the machine.
			echo "safe-rm: \"/\": refusing to trash the root directory" >&2
			exit 1
			;;
	esac

	# --- Catastrophic-target guard --------------------------------------------------------
	# `rm -rf ~` is refused by NOTHING on macOS. Not /bin/rm, and until 2026-09-04 not this
	# script either. It would move an entire home directory to the Trash -- and on a disk
	# with little free space it would not even fit, leaving a half-moved home AND a full
	# disk, which is worse than either alone.
	#
	# THE PRINCIPLE IS CONTAINERS, NOT CONTENTS. This refuses the directory itself;
	# `rm -rf ~/Downloads/*` still works exactly as before, because each child is its own
	# target and none of them is on the list. That is deliberate: a guard that blocks
	# ordinary work is one people learn to route around, and a routed-around guard protects
	# nothing. The only thing being taken away is the ability to remove a whole container in
	# one stroke, which is never what you meant.
	#
	# The comparison runs on the RESOLVED path rather than the string, so a relative path
	# that happens to land on $HOME, `rm -rf ../../..`, and a directory symlink followed
	# with a trailing slash are all caught. A symlink itself is NOT resolved -- removing a
	# link is harmless and must keep working -- hence the `! -L` test.
	#
	# Deliberate override for a human who really means it: SAFE_RM_OFF=1 (permanent, no
	# Trash). No second knob, on purpose: one documented door is easier to reason about
	# than two.
	# TWO paths get classified, and both are needed.
	#
	#   ap  the literal target made absolute, symlinks NOT resolved. This exists because on
	#       macOS /etc, /var and /tmp ARE SYMLINKS (-> private/etc and friends). An earlier
	#       version skipped the whole guard for symlinks, reasoning that removing a link is
	#       harmless -- true for a link you made, catastrophically false for /etc. Caught by
	#       this script's own selftest: the stub trash logged a call for /etc, /var and /tmp
	#       while the summary line claimed nothing had been refused.
	#   rp  the fully resolved directory. Catches a relative path that lands somewhere
	#       protected, and a directory symlink followed with a trailing slash.
	#
	# A link you made yourself is still removable: its own absolute path is not on the list,
	# and it is not resolved.
	case "$s" in
		/*) ap="$s" ;;
		*)  ap="${PWD}/$s" ;;
	esac
	rp=""
	if [ -d "$t" ] && [ ! -L "$t" ]; then
		rp=$(CDPATH= cd -P -- "$t" 2>/dev/null && pwd -P) || rp=""
	fi
	for cand in "$ap" "$rp"; do
		[ -n "$cand" ] || continue
		protected=""
		case "$cand" in
			/ | /Applications | /Library | /System | /Users | /Volumes | /bin | /cores \
			| /dev | /etc | /home | /media | /mnt | /Network | /opt | /private | /root \
			| /sbin | /srv | /tmp | /usr | /var)
				protected="a system directory" ;;
			/Users/*/* | /home/*/*) : ;;          # inside a home dir: ordinary work
			/Users/* | /home/*) protected="somebody's entire home directory" ;;
			/Volumes/*/* | /media/*/* | /mnt/*/*) : ;;   # inside a volume: ordinary work
			/Volumes/* | /media/* | /mnt/*) protected="an entire mounted volume" ;;
		esac
		if [ -z "$protected" ] && [ -n "${HOME:-}" ]; then
			hp=$(CDPATH= cd -P -- "$HOME" 2>/dev/null && pwd -P) || hp=""
			if [ -n "$hp" ]; then
				case "$cand" in
					"$hp")
						protected="your home directory" ;;
					"$hp"/Library | "$hp"/Documents | "$hp"/Desktop | "$hp"/Downloads \
					| "$hp"/Pictures | "$hp"/Movies | "$hp"/Music | "$hp"/Public \
					| "$hp"/.ssh | "$hp"/.gnupg)
						protected="a top-level folder of your home directory" ;;
				esac
			fi
		fi
		if [ -n "$protected" ]; then
			echo "safe-rm: \"$t\" -> ${cand}" >&2
			echo "         Refusing -- that is ${protected}." >&2
			echo "         To empty it instead, target the contents: ${cand}/*" >&2
			echo "         To override deliberately: SAFE_RM_OFF=1 rm ...  (PERMANENT, no Trash)" >&2
			exit 1
		fi
	done

	if [ -e "$t" ] || [ -L "$t" ]; then
		case "$t" in
			-*) t="./$t" ;;
		esac
		set -- "$@" "$t"
		existing=$((existing + 1))
	else
		# Neither test stats. That is USUALLY "does not exist", which rm -f skips in
		# silence, and that is the documented behaviour. But it is ALSO exactly what you
		# get when the file is really there and a parent directory is not searchable.
		# Measured 2026-09-04, with `locked` at mode 000:
		#
		#   $ safe-rm visible.txt locked/hidden.txt
		#   🗑️  Trashed: visible.txt          <- exit 0
		#   $ ls locked/
		#   hidden.txt                        <- never attempted, never mentioned
		#
		# /bin/rm says "Permission denied" and fails. We cannot tell absent from
		# unseeable, so refuse rather than resolve the ambiguity toward false success:
		# a file that cannot be seen must never be reported as deleted.
		d="${t%/*}"
		[ "$d" = "$t" ] && d="."
		[ -z "$d" ] && d="/"
		if [ -d "$d" ] && [ ! -x "$d" ]; then
			echo "safe-rm: \"$t\": cannot tell whether this exists -- \"$d\" is not searchable." >&2
			echo "         Refusing. Nothing was trashed on this call." >&2
			exit 1
		fi
	fi
done

[ "$existing" -eq 0 ] && exit 0

# --- Sweep guard: no emptying these folders in one command -----------------------------
# The container guard above refuses `rm -rf ~/Downloads`. This refuses `rm -rf ~/Downloads/*`,
# which is the same loss by a different route.
#
# THE GLOB NEVER REACHES THIS SCRIPT. The shell expands `~/Downloads/*` before safe-rm is
# executed, so what arrives is a plain list of children -- there is no `*` to match on. The
# sweep therefore has to be recognised from its SHAPE: two or more direct children of a
# guarded directory named in a single call.
#
# Two is the threshold because one is how you delete a file on purpose. `rm ~/Downloads/x.dmg`
# keeps working, and so does `rm -rf ~/CODE/oneproject`; what stops is taking several at once,
# which is the shape of a sweep and almost never the shape of an intention. Deleting them one
# at a time still works, and that is fine -- the point is to remove the single stroke, not to
# make the files immortal.
#
# Parents are compared as literal absolute strings rather than resolved with a subshell per
# target: this runs on every call, including `rm -rf node_modules` with tens of thousands of
# operands, and a fork per operand is not affordable. A deliberately obfuscated relative path
# could slip past this particular check; the container guard above still holds, and this is a
# guard against a slip, not against an adversary at your keyboard.
# BOTH spellings of home go on the list, and that is not belt-and-braces -- it is a bug fix.
# Operand parents are computed as literal strings (see above), so comparing them against a
# RESOLVED home silently never matches whenever the path crosses a symlink. Measured: with a
# home under $TMPDIR, `$HOME` is /var/folders/... while `pwd -P` gives /private/var/folders/...
# because /var is a symlink on macOS, and every sweep sailed through. Same class of mistake as
# the /etc one in the container guard, found the same way -- by testing rather than reasoning.
sweep_dirs=""
if [ -n "${HOME:-}" ]; then
	hr="${HOME%/}"
	hp=$(CDPATH= cd -P -- "$HOME" 2>/dev/null && pwd -P) || hp=""
	for hbase in "$hr" "$hp"; do
		[ -n "$hbase" ] || continue
		sweep_dirs="${sweep_dirs}${hbase}/Downloads
${hbase}/Desktop
${hbase}/Documents
${hbase}/CODE
"
	done
fi

if [ -n "$sweep_dirs" ]; then
	# One pass over the operands, collecting each one's literal parent directory.
	parents=""
	argc=$#
	i=0
	while [ "$i" -lt "$argc" ]; do
		t="$1"
		shift
		i=$((i + 1))
		set -- "$@" "$t"
		case "$t" in
			/*) atp="$t" ;;
			*)  atp="${PWD}/$t" ;;
		esac
		while [ "$atp" != "/" ] && [ "${atp%/}" != "$atp" ]; do atp="${atp%/}"; done
		p="${atp%/*}"
		[ -z "$p" ] && p="/"
		parents="${parents}${p}
"
	done

	OLDIFS=$IFS
	IFS='
'
	for g in $sweep_dirs; do
		IFS=$OLDIFS
		[ -n "$g" ] || continue
		n=$(printf '%s' "$parents" | grep -c -x -F -- "$g" 2>/dev/null) || n=0
		if [ "$n" -ge 2 ]; then
			echo "safe-rm: refusing to remove ${n} items at once from ${g}" >&2
			echo "         That folder is protected against being emptied in one command." >&2
			echo "         Delete them individually if you mean it, or move the folder aside." >&2
			echo "         To override deliberately: SAFE_RM_OFF=1 rm ...  (PERMANENT, no Trash)" >&2
			exit 1
		fi
		IFS='
'
	done
	IFS=$OLDIFS
fi

# THE EXIT CODE IS ADVISORY ONLY. Every report below comes from re-checking the targets,
# never from what the trash tool claimed, because it has now been measured lying in BOTH
# directions:
#
#   exit 0 but did nothing   -- an argument it did not recognise (a leading dash) is
#                               skipped with "# Un-recognized argument" and status 0.
#   exit non-zero but DID    -- `trash` does not stop at the first error (that is what its
#     delete something          --stopOnError flag is for), so a failure on operand two
#                               says nothing about operand one.
#
# The second case is why the old `else` branch here is gone. It printed a flat "nothing was
# deleted", which was measurably false for two ordinary shapes:
#
#   safe-rm f ./f                  -> "nothing was deleted", f WAS trashed
#   safe-rm -r build build/cache   -> "nothing was deleted", build/ WAS trashed
#
# Both are everyday: a glob overlapping an explicit argument (`rm *.log app.log`), and a
# directory named alongside something inside it. Telling someone their file is untouched
# when it is in the Trash is the same danger as the reverse -- they never go looking.
"$trash_cmd" "$@"
trc=$?

gone=""
still=""
argc=$#
i=0
while [ "$i" -lt "$argc" ]; do
	t="$1"
	shift
	i=$((i + 1))
	set -- "$@" "$t"
	if [ -e "$t" ] || [ -L "$t" ]; then
		still="${still} ${t}"
	else
		gone="${gone} ${t}"
	fi
done

if [ -n "$still" ]; then
	[ -n "$gone" ] && echo "safe-rm: PARTIAL -- these WERE trashed:${gone}" >&2
	# Deliberately worded as "still exist", NOT "were not deleted". Those are different
	# claims and only the first one has been verified. A path can exist again because the
	# trash call did nothing, or because something RECREATED it in the moment afterwards --
	# a daemon re-binding its socket does exactly this, and there are three such sockets on
	# this machine. Measured: with a trash that removes then recreates, safe-rm reported
	# "still exist", which is true, where "were NOT deleted" would have been false.
	#
	# Telling the two apart would mean recording each target's inode before the call and
	# comparing after. That is doable and was considered; it was rejected because it adds
	# a stat-per-target and a BSD/GNU portability branch to the one script that must stay
	# obviously correct, in exchange for sharpening a message that is already true. If this
	# ever needs to be exact, that is the way to do it.
	echo "safe-rm: these paths still exist after the trash call:${still}" >&2
	echo "         Either they were not moved, or something recreated them. If a path was" >&2
	echo "         recreated, the original is in the Trash. Nothing was deleted permanently." >&2
	echo "         (${trash_cmd} exit ${trc})" >&2
	exit 1
fi

[ "$quiet" -eq 1 ] || echo "🗑️  Trashed: $*  (${restore_hint})"
exit 0
