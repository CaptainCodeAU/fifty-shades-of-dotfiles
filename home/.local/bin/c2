#!/usr/bin/env bash
# c2 -- the throwaway pj session: a scratch worktree, its own config dir, two guards (F5a).
#
# Usage:
#   c2 start <topic>          make the worktree and launch pj --profile scratch inside it.
#                             Prints the peer NAME the session will get (asked of pj, not
#                             rebuilt here) so you can SendMessage it by hand; accepts the
#                             folder-trust dialog for you (D-20260922-A01; that carve-out
#                             is c2 worktrees and the scratch config dir ONLY, never any
#                             other dialog); and runs `direnv allow` in the worktree when
#                             its .envrc is byte-identical to the main repo's already
#                             allowed one. A DIFFERING .envrc prints the diff and STOPS.
#   c2 done  <topic>          tear it down, but ONLY if both guards pass. Also closes the
#                             herdr workspace hwt made for it, which until F5d was left
#                             behind pointing at a path that no longer existed.
#   c2 done  <topic> --discard   tear it down anyway, losing whatever the guards found
#   c2 list                   the scratch worktrees of the repo you are standing in, with
#                             each one's live peer name, session id and pid when a session
#                             is running in it
#   c2 --selftest             prove every arm against throwaway fixtures
#
# Exit: 0 done  ·  1 nothing to do (not an error)  ·  2 REFUSED
#
# WHERE THE WORKTREE GOES  <repo>/.worktree/scratch/<topic>, on branch scratch/<topic>.
# That is D-20260914-A01 applied literally -- "every worktree goes to <repo>/.worktree/
# <branch> via the hwt wrapper", never ~/.herdr/worktrees and never the sidebar button.
# The F5a brief said `.worktree/scratch-<topic>`; the ruling's own shape is used instead,
# so the branch name and the folder name stay the same string.
#
# HOW IT IS CREATED  `hwt` by default, which is the wrapper the ruling names and which
# makes the worktree herdr-tracked. `--no-herdr` uses plain `git worktree add` at the
# IDENTICAL path. Both satisfy the ruling, which is about where a worktree lives rather
# than which tool digs the hole; the flag exists because hwt needs the herdr server up
# and a scratch checkout should not depend on a daemon. c2 says which route it took.
#
# THE PROFILE  `scratch`: plugins none, card off, HOOKS ON, config_dir ~/.claude-scratch.
# Ruled by Gavin at the F5a gate. NOT --safe-mode, which would also disarm
# enforce-secret-probe.sh, validate-bash.sh, enforce-uv, enforce-pnpm and
# MemoryRootGuard -- a throwaway session is where you are LEAST careful, so it is the
# last place to turn the guards off.
#
# THE FIRST RUN NEEDS A HUMAN. ~/.claude-scratch is a fresh config dir. Measured
# 2026-09-21: a fresh config dir exits 1 with "Not logged in - Please run /login", and
# separately refuses the workspace until a trust dialog is accepted. c2 says so up front
# rather than letting the launch fail in a pane. `pj-health --profile scratch` carries the
# same warning as a row.
#
# THE LEARNINGS FOLDER  ~/Scratch/<project>/, created by `start` when absent. It is
# OUTSIDE the worktree on purpose: everything inside the worktree is what `done` is
# allowed to destroy, so anything worth keeping has to leave first.
#
# THE TWO GUARDS on `done`, both refusing rather than asking:
#   1. UNCOPIED WORK   any uncommitted change in the worktree -- tracked-modified,
#      staged, or untracked-and-not-ignored. Those files exist nowhere else.
#   2. UNMERGED COMMITS  commits on scratch/<topic> that no other branch contains.
#      Reachability is asked of every local branch and every remote-tracking ref, so a
#      topic merged into a release branch rather than the base counts as merged.
# --discard skips both. It is the only way to lose work here and it has to be typed.
#
# IT NEVER PUSHES. Not on start, not on done, not with --discard. A scratch branch that
# deserves a remote deserves a real branch first.
#
# NO `rm` ANYWHERE. Teardown is `git worktree remove` and `git branch -D`, so the
# deletion-safety rule's banned list is never reached and nothing routes around the Trash
# shim. The directory does go for good, which is exactly why the guards come first.
#
# Seams (the selftest sets them, nobody else should):
#   C2_SCRATCH_HOME   the learnings root (default ~/Scratch)
#   C2_LAUNCH         printed instead of launching, so `start` can be tested headlessly
#   C2_HWT            the hwt to call (default: hwt on PATH)
set -uo pipefail

SCRATCH_HOME="${C2_SCRATCH_HOME:-$HOME/Scratch}"
HWT="${C2_HWT:-hwt}"
PROFILE=scratch

refuse(){ printf 'c2: REFUSED -- %s\n' "$1" >&2; exit 2; }
say(){ printf 'c2: %s\n' "$1"; }
usage(){ sed -n '2,18p' "$0" | sed 's/^# \{0,1\}//'; }
tilde(){ printf '%s' "${1/#$HOME/\~}"; }

# The MAIN worktree, whichever worktree you are standing in (--git-common-dir, the same
# key open-items, pj-start-card, pj-session-end, decided and pj-launch-check all use).
main_repo(){
  local gcd
  gcd="$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null)" || return 1
  [ -n "$gcd" ] || return 1
  dirname "$gcd"
}

wt_path(){ printf '%s/.worktree/scratch/%s' "$1" "$2"; }
branch_of(){ printf 'scratch/%s' "$1"; }

# ------------------------------------------------- the folder-trust watcher ----
# D-20260922-A01, ruled by Gavin 2026-09-22: a session MAY accept the folder-trust
# dialog itself, via Herdr, for c2 worktrees and for any folder opened under the scratch
# config dir. Every OTHER trust or security dialog still stops and waits for him.
#
# The carve-out is narrow on purpose. A c2 worktree is a checkout of a repo he already
# trusts under the default config dir, and ~/.claude-scratch is the disposable profile,
# so accepting here grants nothing he has not already granted elsewhere. It does NOT
# extend to the default config dir, to a folder he has never opened, or to any other
# prompt.
#
# WHY A BACKGROUND WATCHER. `start` ends in `exec pj`, which REPLACES this process, so
# there is nobody left to watch. The watcher is therefore forked before the exec and
# talks to the pane c2 is itself running in ($HERDR_PANE_ID).
#
# THE DECISION IS A PURE FUNCTION so it can be tested without a pane, a herdr server or a
# live dialog. trust_keys_for prints the keys to send and NOTHING when it is not certain:
# silence means Gavin gets asked, which is the safe direction for a wrong reading.
TRUST_DIALOG='Yes, I trust this folder'
TRUST_CURSOR_NO='❯ No, exit'
TRUST_CURSOR_YES='❯ Yes, I trust this folder'

# trust_keys_for <pane text> -> one key per line, or nothing at all.
trust_keys_for(){
  local t="$1"
  case "$t" in *"$TRUST_DIALOG"*) ;; *) return 0 ;; esac
  # The cursor marker is what separates a live dialog from the same words quoted in a
  # transcript, a doc or this script's own help. Without it, nothing is sent.
  case "$t" in
    *"$TRUST_CURSOR_YES"*) printf 'enter\n' ;;
    *"$TRUST_CURSOR_NO"*)  printf 'down\nenter\n' ;;
  esac
  return 0
}

# trust_watch <pane_id> -- waits for the dialog, accepts it once, and verifies it went.
#
# A BOUNDED POLL, NOT `pane wait-output`, AND THAT IS A CORRECTION. The first version of
# this used `herdr pane wait-output --match "Yes, I trust this folder"`, and it failed the
# first time it met a real dialog. `wait-output` searches the whole recent snapshot, so it
# matched the SAME WORDS left in the scrollback by an earlier session and returned in one
# second -- before the new dialog had rendered. The single read that followed saw no cursor
# marker, trust_keys_for correctly sent nothing, and the watcher exited while the dialog sat
# there waiting. The herdr skill warns about exactly this, the brief for this stage repeats
# it, and it still went in.
#
# The event system cannot help here, because "these words are on screen" is true in the
# stale case and the live case alike -- the same all-cases-identical fault this repo keeps
# writing up. What separates them is the CURSOR MARKER, which only a live dialog has, and
# that has to be re-read over time rather than waited on once. So: read the visible pane
# every C2_TRUST_POLL_S seconds until the deadline, and act the moment a marker appears.
#
# Polling is the right shape here and not a shortcut around the no-polling rule: there is
# no event to subscribe to that distinguishes the two cases.
#
# It accepts ONCE. A dialog still up afterwards is one this was wrong about, and hammering
# Enter into a live session is the damage the guard exists to avoid.
trust_watch(){
  local pane="$1" txt keys k deadline now poll
  [ "${HERDR_ENV:-}" = 1 ] || return 0
  [ -n "$pane" ] || return 0
  command -v herdr >/dev/null 2>&1 || return 0
  poll="${C2_TRUST_POLL_S:-2}"
  now="$(date +%s)"
  deadline=$(( now + ${C2_TRUST_TIMEOUT_MS:-120000} / 1000 ))
  keys=""
  while [ "$(date +%s)" -lt "$deadline" ]; do
    txt="$(herdr pane read "$pane" --source visible --lines 400 2>/dev/null || true)"
    keys="$(trust_keys_for "$txt")"
    [ -n "$keys" ] && break
    sleep "$poll"
  done
  [ -n "$keys" ] || return 0
  while IFS= read -r k; do
    [ -n "$k" ] && herdr pane send-keys "$pane" "$k" >/dev/null 2>&1
  done <<EOF
$keys
EOF
  sleep 1
  txt="$(herdr pane read "$pane" --source visible --lines 400 2>/dev/null || true)"
  case "$txt" in
    *"$TRUST_CURSOR_NO"*|*"$TRUST_CURSOR_YES"*)
      printf 'c2: the folder-trust dialog is still up after one accept attempt; it is yours to answer.\n' >&2 ;;
  esac
  return 0
}

# ------------------------------------------- the peer name and the session id ----
# F5c gate Q3: Gavin asked to be told how to address the session by hand.
#
# THE NAME IS KNOWN IN ADVANCE AND THE SESSION ID IS NOT, so they are printed in two
# different places rather than pretended to be one. The session id only exists once Claude
# Code has started, so `c2 list` reads it live out of the registry.
#
# F5d 2026-09-22: c2 no longer BUILDS the name. It used to pick a random suffix, export it
# as PJ_NAME_SUFFIX and rebuild pj's formula here, which meant two copies of one rule that
# could drift apart in silence. pj now derives the whole name from the repo, the profile
# and the cwd, and the suffix is gone entirely (the collision fear behind it was measured
# false -- see build_session_name in pj). So c2 ASKS pj what the name will be, with the
# same cwd and profile the launch will use, and prints the answer. One rule, one place.
#
# `pj --dry-run-env` is that question. It touches nothing: no keychain, no ssh-agent, no
# registry link, no launch (pj selftest arm 20j holds it to that).
peer_name_for(){  # <cwd> -> the name the launch will get, or empty if pj cannot say
  #
  # READ PJ_SESSION_NAME, NOT CLAUDE_CODE_SESSION_NAME. pj emits the first on every launch
  # and the second only when it computed the name itself, so asking for the second returns
  # nothing whenever a name is already in the environment -- which is ALWAYS the case here,
  # because c2 is usually run from inside a pj session and pj exports the name into it.
  # Measured 2026-09-22: c2 printed "pj could not say" for exactly that reason.
  local out
  out="$( builtin cd "$1" 2>/dev/null && PJ_PROFILE="$PROFILE" pj --dry-run-env 2>/dev/null )" || true
  printf '%s\n' "$out" | sed -n 's/^PJ_SESSION_NAME=//p' | head -1
}

# --------------------------------------------------------------- direnv ----
# envrc_gate <main repo> <worktree> -- rc 0 to carry on, rc 1 to STOP the launch.
#
# THE PROBLEM, measured live 2026-09-22 with a real c2 worktree and a control in the same
# command: the worktree's `.envrc` is BYTE-IDENTICAL to the main repo's (it is a tracked
# file, so git simply checks the same blob out) and direnv blocks it anyway. Main repo
# `Found RC allowed 0`, worktree `Found RC allowed 1`, same second.
#
# WHY, and this is the whole of it: direnv's allow token is a file under
# ~/.local/share/direnv/allow named `sha256(<absolute path> + "\n" + <file content>)`.
# Reproduced exactly against the live token for this repo, with a different-path control
# that produced a different digest. So the PATH is inside the hash: identical content at a
# new path is a file direnv has never been shown, which is correct of direnv and merely
# inconvenient here.
#
# THE RULE (Gavin, 2026-09-22): allow it only when it is byte-identical to the main repo's
# ALREADY-ALLOWED one -- that is the same trust he has already given, moved to a new path.
# Anything else prints the diff and stops, because a scratch branch quietly changing what
# executes on every cd is exactly the thing worth stopping for. At `c2 start` time the two
# are always identical, so in practice this is silent; it earns its keep later.
#
# Every other case is a NOTE and not a stop: no .envrc at all, no .envrc in the main repo,
# no direnv binary, or a main-repo .envrc that is not itself allowed. None of those is a
# change c2 should make on its own, and none of them is a reason to refuse a worktree.
# envrc_allowed <dir> -> rc 0 when direnv would load that dir's .envrc.
#
# CAPTURE FIRST, THEN TEST, AND THIS IS NOT STYLE. The first version was
#   ( cd "$1" && direnv status ) | grep -qE '^Found RC allowed 0$'
# and this script runs `set -uo pipefail`. `grep -q` exits the instant it matches, which
# SIGPIPEs direnv; direnv dies 141; pipefail makes the PIPELINE 141; and an ALLOWED repo
# therefore reads as not-allowed. Reproduced deterministically with a long producer
# (`yes "Found RC allowed 0" | grep -q ...` -> 141, three for three); against direnv's short
# output it is a race, which is why it fired exactly once in the live proof and then would
# not reproduce. Found by /code-review, after this file had already recorded that occurrence
# as "unexplained". It was explained all along, one line up from where I was looking.
#
# The repo's own rule, at c2's guard-2 comment: capture the output, then test the string.
envrc_allowed(){
  local out
  out="$( builtin cd "$1" 2>/dev/null && direnv status 2>/dev/null )" || true
  case $'\n'"$out"$'\n' in
    *$'\nFound RC allowed 0\n'*) return 0 ;;
  esac
  return 1
}

# envrc_state <dir> -> the one line direnv gives, for quoting in a NOTE. Never pipes.
envrc_state(){
  local out line
  out="$( builtin cd "$1" 2>/dev/null && direnv status 2>&1 )" || true
  while IFS= read -r line; do
    case "$line" in "Found RC allowed "*) printf '%s' "$line"; return 0 ;; esac
  done <<<"$out"
  printf 'no "Found RC allowed" line at all'
}
envrc_gate(){
  local repo="$1" wt="$2" a="$1/.envrc" b="$2/.envrc"
  [ -e "$b" ] || return 0                       # nothing to allow
  if ! command -v direnv >/dev/null 2>&1; then
    say "NOTE: $(tilde "$b") exists and direnv is not installed; nothing to do."
    return 0
  fi
  if [ ! -e "$a" ]; then
    say "NOTE: the worktree has a .envrc and $(tilde "$repo") does not, so there is no allowed original to compare it with. Run 'direnv allow' there yourself if you want it."
    return 0
  fi
  if ! cmp -s "$a" "$b"; then
    printf 'c2: REFUSED -- the worktree .envrc is NOT the one you allowed:\n' >&2
    diff -u "$a" "$b" 2>/dev/null | sed 's/^/    /' >&2
    printf '  nothing was launched. Read it, then either fix it or run: direnv allow %s\n' "$(tilde "$wt")" >&2
    return 1
  fi
  if ! envrc_allowed "$repo"; then
    # QUOTE WHAT DIRENV SAID, rather than only our reading of it. Measured 2026-09-22: this
    # branch fired once against a main repo that WAS allowed, and did not reproduce -- the
    # same command run twice afterwards, once from a script and once from the same Herdr
    # pane, both read `Found RC allowed 0`. One unexplained reading is not a reason to
    # weaken the check, but a check that cannot say what it saw is a reason to fix the
    # check. The failure mode is already the safe one: a note, never a stop.
    say "NOTE: $(tilde "$a") is byte-identical but direnv does not report it as allowed, so there is no trust to carry over. Run 'direnv allow' in $(tilde "$repo") first. direnv said: $(envrc_state "$repo")"
    return 0
  fi
  if ( builtin cd "$wt" && direnv allow . >/dev/null 2>&1 ) && envrc_allowed "$wt"; then
    say "direnv: allowed the worktree .envrc (byte-identical to the one already allowed in $(basename "$repo"))"
  else
    # The allow ran and the worktree still does not read as allowed, or the allow itself
    # failed. Either way SAY SO: silence here would leave you to discover it on the first
    # cd, which is exactly the noise this gate exists to remove.
    say "NOTE: direnv allow did not take in $(tilde "$wt") -- direnv says: $(envrc_state "$wt"). Run it yourself if you want the .envrc loaded."
  fi
  return 0
}

# registry_row <worktree path> -> "name<TAB>sessionId<TAB>pid", empty when not running.
# Reads ~/.claude/sessions, which since F5c is also where a scratch session registers
# (its own config dir's sessions/ is a symlink to it).
registry_row(){
  local wt="$1" f
  for f in "$HOME/.claude/sessions"/*.json; do
    [ -e "$f" ] || continue
    jq -r --arg wt "$wt" 'select(.cwd == $wt) | [.name // "-", .sessionId // "-", (.pid|tostring)] | @tsv' "$f" 2>/dev/null
  done
}

# ---------------------------------------------------------------- start ----
cmd_start(){
  local topic="${1:-}" use_hwt=1 a
  shift || true
  for a in "$@"; do case "$a" in --no-herdr) use_hwt=0 ;; *) refuse "start: unknown flag $a" ;; esac; done
  [ -n "$topic" ] || refuse "start: name a topic (c2 start <topic>)"
  case "$topic" in */*|.*|*' '*) refuse "start: a topic is one plain word, no slashes, dots or spaces (got '$topic')" ;; esac

  local repo wt br proj
  repo="$(main_repo)" || refuse "start: not inside a git repository"
  wt="$(wt_path "$repo" "$topic")"; br="$(branch_of "$topic")"; proj="$(basename "$repo")"
  [ -e "$wt" ] && refuse "start: $(tilde "$wt") already exists; c2 done $topic first, or pick another topic"
  git -C "$repo" show-ref --verify --quiet "refs/heads/$br" && refuse "start: branch $br already exists; c2 done $topic first, or pick another topic"

  mkdir -p "$SCRATCH_HOME/$proj" 2>/dev/null || refuse "start: cannot create $(tilde "$SCRATCH_HOME/$proj")"

  local how
  if [ "$use_hwt" -eq 1 ] && command -v "$HWT" >/dev/null 2>&1; then
    if (builtin cd "$repo" && "$HWT" "$br" >/dev/null 2>&1); then how="hwt (herdr-tracked)"; fi
  fi
  if [ -z "${how:-}" ]; then
    git -C "$repo" worktree add -q -b "$br" "$wt" >/dev/null 2>&1 \
      || refuse "start: could not create the worktree at $(tilde "$wt")"
    how="git worktree add"
    [ "$use_hwt" -eq 1 ] && how="$how (hwt unavailable or refused; the path is identical)"
  fi
  [ -d "$wt" ] || refuse "start: $how reported success but $(tilde "$wt") is not there"

  say "worktree $(tilde "$wt") on branch $br, via $how"
  say "learnings folder $(tilde "$SCRATCH_HOME/$proj") -- anything worth keeping goes THERE, not in the worktree"
  local cfg; cfg="$(sed -n 's/^config_dir:[[:space:]]*//p' "${XDG_CONFIG_HOME:-$HOME/.config}/pj/profiles/$PROFILE" 2>/dev/null | head -1)"
  case "$cfg" in '~/'*) cfg="$HOME/${cfg#\~/}" ;; esac
  if [ -n "$cfg" ] && [ ! -d "$cfg" ]; then
    say "FIRST RUN ON THIS PROFILE: $(tilde "$cfg") does not exist yet, so Claude Code will ask you to /login and to trust this folder. Both are one-time and only you can do them."
  fi
  # THE TRANSCRIPT HAS TO LAND UNDER THE MAIN REPO'S KEY, and Claude Code will not do that
  # on its own. Measured 2026-09-21 with a real c2 session: every pj tool keys the project
  # by `git rev-parse --git-common-dir` (the MAIN repo), but Claude Code derives
  # projects/<name> from the WORKING DIRECTORY, so the session's transcript landed under
  # ...-f5a-probe--worktree-scratch-t1 while the launch log recorded ...-f5a-probe. The two
  # disagreed, and pj-health could not find the session's own evidence.
  #
  # CLAUDE_CODE_PROJECT_DIR_NAME exists for exactly this: "Set together with
  # CLAUDE_CONFIG_DIR to choose the projects/ directory name Claude Code stores that
  # session's transcripts and auto memory under, in place of one derived from the working
  # directory path" (Claude Code docs; needs v2.1.234 or later). It is IGNORED unless
  # CLAUDE_CONFIG_DIR is also set, and read only from the launch environment -- never from
  # a settings env block -- so here is the only place it can be set.
  #
  # The encoding is the harness's own: every / . _ in the absolute path becomes a dash,
  # which is the same one open-items, pj-start-card and pj-launch-check use for the key.
  #
  # IT IS CAPPED AT 64 CHARACTERS, AND A LONGER NAME IS IGNORED IN SILENCE. Measured
  # 2026-09-21 by bisection against Claude Code 2.1.278, one live probe per length:
  # 62 and 64 honoured, 65, 66, 70, 78, 88, 99 and 149 all ignored with no warning, no
  # error and a normal exit -- the transcript simply lands under the cwd-derived name
  # instead. The cap is in no documentation this session could find. A leading dash is
  # fine (tested separately), so length is the whole of it.
  #
  # So this is MEASURED, not assumed, and when it will not fit c2 SAYS SO. Silence here
  # would mean pj-health quietly failing to find a c2 session's evidence forever, which is
  # the same silent-divergence shape the launch log exists to prevent. Most real keys fit:
  # ~/CODE/CaptainCodeAU/Network_Plan is 48 characters, this dotfiles repo 59. A repo under
  # a deep scratch path does not, and that is exactly when you want to be told.
  local key keylen
  key="$(printf '%s' "$repo" | sed 's#[/._]#-#g')"
  keylen=${#key}
  if [ "$keylen" -gt 64 ]; then
    say "NOTE: this project's key is $keylen characters and CLAUDE_CODE_PROJECT_DIR_NAME is capped at 64, so the transcript will land under the WORKTREE's own key, not $(basename "$repo")'s. pj-health --profile $PROFILE will not find this session's evidence. Everything else (the drawer, the rulings, the commit trailer) is unaffected."
    key=""
  fi
  # direnv (F5d gate Q3(a), ruled by Gavin 2026-09-22). Must run BEFORE the name is printed
  # and before the launch, because a differing .envrc STOPS the launch.
  envrc_gate "$repo" "$wt" || exit 2

  # The peer name pj will give this session, asked of pj rather than rebuilt here.
  local pname; pname="$(peer_name_for "$wt")"
  if [ -n "$pname" ]; then
    say "peer name $pname  --  SendMessage to=\"$pname\" reaches it from any session"
  else
    say "peer name: pj could not say (pj --dry-run-env printed none); c2 list shows it once the session is up"
  fi
  say "its session id appears once Claude Code is up: c2 list"

  if [ -n "${C2_LAUNCH:-}" ]; then
    printf '%s\n' "$C2_LAUNCH cwd=$wt profile=$PROFILE project_dir_name=${key:-<too-long:$keylen>} peer_name=${pname:-<unknown>}"
    return 0
  fi
  # The trust watcher goes into the background BEFORE the exec, because the exec replaces
  # this process. It is a no-op outside herdr and a no-op when no dialog appears.
  ( trust_watch "${HERDR_PANE_ID:-}" & ) >/dev/null 2>&1
  if [ -n "$key" ]; then
    (builtin cd "$wt" && CLAUDE_CODE_PROJECT_DIR_NAME="$key" exec pj --profile "$PROFILE")
  else
    (builtin cd "$wt" && exec pj --profile "$PROFILE")
  fi
}

# ----------------------------------------------------------------- done ----
# uncopied_work <wt> -> prints the porcelain lines, empty when the worktree is clean
uncopied_work(){ git -C "$1" status --porcelain 2>/dev/null; }

# unmerged_commits <repo> <branch> -> the sha/subject lines that live ONLY on <branch>
#
# The exclusion list is built EXPLICITLY, one full refname at a time, rather than with
# `--not --exclude=<pat> --branches`. Measured 2026-09-21: that form silently returned
# nothing for a genuinely unmerged commit, because --exclude patterns are matched against
# the glob that FOLLOWS them (refs/heads/<name>, not the full refname as typed), so the
# branch was never actually excluded from --branches and every one of its own commits was
# subtracted from itself. Guard 2 passed a worktree that was about to lose real work, and
# only the selftest's arm 4 caught it. An explicit list cannot mean something other than
# what it says.
unmerged_commits(){
  local repo="$1" br="$2" others
  git -C "$repo" show-ref --verify --quiet "refs/heads/$br" || return 0
  others="$(git -C "$repo" for-each-ref --format='%(refname)' refs/heads refs/remotes 2>/dev/null | grep -v "^refs/heads/$br\$" || true)"
  # No other ref at all: every commit on the branch is unique to it, which is what
  # `git log <br> --not` with an empty list already reports.
  # shellcheck disable=SC2086
  git -C "$repo" log --oneline "$br" --not $others 2>/dev/null
}

cmd_done(){
  local topic="${1:-}" discard=0 a
  shift || true
  for a in "$@"; do case "$a" in --discard) discard=1 ;; *) refuse "done: unknown flag $a" ;; esac; done
  [ -n "$topic" ] || refuse "done: name a topic (c2 done <topic>)"

  local repo wt br
  repo="$(main_repo)" || refuse "done: not inside a git repository"
  wt="$(wt_path "$repo" "$topic")"; br="$(branch_of "$topic")"
  if [ ! -e "$wt" ] && ! git -C "$repo" show-ref --verify --quiet "refs/heads/$br"; then
    say "nothing to do: no worktree at $(tilde "$wt") and no branch $br"
    return 1
  fi

  if [ "$discard" -eq 0 ]; then
    local dirty="" unmerged=""
    [ -d "$wt" ] && dirty="$(uncopied_work "$wt")"
    unmerged="$(unmerged_commits "$repo" "$br")"
    if [ -n "$dirty" ] || [ -n "$unmerged" ]; then
      printf 'c2: REFUSED -- %s still holds work that exists nowhere else:\n' "$br" >&2
      if [ -n "$dirty" ]; then
        printf '  uncopied files (%s):\n' "$(printf '%s\n' "$dirty" | wc -l | tr -d ' ')" >&2
        printf '%s\n' "$dirty" | sed 's/^/    /' >&2
        printf '  copy them to %s first.\n' "$(tilde "$SCRATCH_HOME/$(basename "$repo")")" >&2
      fi
      if [ -n "$unmerged" ]; then
        printf '  unmerged commits (%s), on no other branch:\n' "$(printf '%s\n' "$unmerged" | wc -l | tr -d ' ')" >&2
        printf '%s\n' "$unmerged" | sed 's/^/    /' >&2
        printf '  merge or cherry-pick them first.\n' >&2
      fi
      printf '  c2 done %s --discard throws all of it away. Nothing was changed.\n' "$topic" >&2
      exit 2
    fi
  fi

  if [ -d "$wt" ]; then
    git -C "$repo" worktree remove --force "$wt" >/dev/null 2>&1 \
      || refuse "done: could not remove the worktree at $(tilde "$wt")"
    say "removed worktree $(tilde "$wt")"
  fi
  git -C "$repo" worktree prune >/dev/null 2>&1
  if git -C "$repo" show-ref --verify --quiet "refs/heads/$br"; then
    git -C "$repo" branch -D "$br" >/dev/null 2>&1 || refuse "done: could not delete branch $br"
    say "deleted branch $br"
  fi
  close_herdr_workspace "$wt"
  prune_empty_worktree_dirs "$repo"
  [ "$discard" -eq 1 ] && say "--discard: the guards were not run"
  return 0
}

# prune_empty_worktree_dirs <main repo> -- take away the two scaffold directories
# `c2 start` created, but ONLY while they are empty.
#
# WHAT IT FIXES. `c2 start` makes `<repo>/.worktree/scratch/<topic>`, so it creates two
# parent directories on the way. `c2 done` removed the topic and left both behind, and
# F5d's report carried "`<repo>/.worktree/scratch/` is left as an empty directory" in its
# stopped-on list rather than as a fix. Asked for by Gavin after the F8a gate.
#
# WHY `rmdir` AND NOTHING ELSE. `rmdir` cannot lose data: it refuses a non-empty directory,
# and that refusal IS the guard, so no emptiness test has to be trusted and no recursive
# delete is ever reached. It is the same argument `pj`'s ensure_registry_link makes for the
# one destructive call it allows itself. `rm -r` here would be a real hazard -- a worktree
# the prune had not yet noticed, a topic somebody re-created a second earlier -- and the
# deletion rules would need a human for it.
#
# AND ON THIS MACHINE `rmdir` IS TRASH-ROUTED TOO, measured 2026-09-22: removing the live
# repo's leftover pair printed `Trashed: ... (recover: Finder -> Put Back)` for both. So even
# the empty-directory removal is recoverable rather than permanent. That is a property of
# the local shim, not of `rmdir`, so the argument above is what this code rests on -- this
# paragraph is the belt, not the braces.
#
# THE PARENT TOO, and it is one step beyond what was asked, named rather than hidden: an
# empty `<repo>/.worktree/` is the identical complaint one level up, and it is only ever
# reached when `scratch/` itself has just gone. Either removal failing is fine and silent.
#
# IT SAYS WHAT IT DID, POSITIVELY. "removed nothing because another topic is still live"
# and "removed nothing because the code never ran" are the same silence, and this repo
# writes that failure up often enough that a cleanup which cannot be observed is not worth
# having. So the kept case is stated too, with the reason.
prune_empty_worktree_dirs(){
  local repo="$1" scratch parent left
  [ -n "$repo" ] || return 0
  scratch="$repo/.worktree/scratch"
  parent="$repo/.worktree"
  [ -d "$scratch" ] || return 0
  if rmdir "$scratch" 2>/dev/null; then
    say "removed the now-empty $(tilde "$scratch")"
    if [ -d "$parent" ] && rmdir "$parent" 2>/dev/null; then
      say "removed the now-empty $(tilde "$parent")"
    fi
  else
    # Non-empty: another topic is still checked out. Name how many, so the line is a fact
    # rather than a shrug.
    left="$(find "$scratch" -mindepth 1 -maxdepth 1 -print 2>/dev/null | wc -l | tr -d ' ')"
    say "kept $(tilde "$scratch"): $left other topic(s) still there"
  fi
  return 0
}

# close_herdr_workspace <the worktree path just removed>
#
# THE LEAK THIS CLOSES, and it is the whole of W-20260922-A04. `c2 start` makes the
# worktree through `hwt`, which is `herdr worktree create`, and that creates a HERDR
# WORKSPACE alongside the git worktree. `c2 done` removed the worktree and the branch and
# never touched the workspace, so every discarded scratch topic left a dead entry in the
# sidebar pointing at a path that no longer exists.
#
# Measured 2026-09-22 by doing exactly that: `c2 start f5denvrc` then `c2 done f5denvrc
# --discard` left workspace w44, `checkout_path` set to the deleted worktree. w3Y and w3Z,
# the two the item was filed about, are the same thing from an earlier stage. So this is a
# bug in c2 and not a cleanup job, and fixing it here closes the class.
#
# IT CLOSES ONLY WHAT IT CAN NAME. The workspace is matched on `worktree.checkout_path`
# being exactly the path just removed -- never on the label, which is the repo name and is
# shared by every workspace of that repo including the one you are sitting in. Anything
# else is left alone, which is the herdr rule about not closing what you did not create.
#
# A MISS IS REPORTED, NOT SWALLOWED. "herdr has no workspace for this worktree" and "herdr
# stored checkout_path in a different spelling than the path we removed" (a resolved
# /private/... against /tmp/..., a trailing slash, a symlinked repo root) are the same
# silence, and the second one silently re-opens the leak this function exists to close.
# So a miss says how many workspaces were examined and how many named a worktree at all --
# the same denominator discipline pj-health's stale-workspaces row uses, for the same
# reason. Raised by /code-review.
close_herdr_workspace(){
  local gone="$1" ws="" seen=0 named=0 id p list
  [ -n "$gone" ] || return 0
  command -v herdr >/dev/null 2>&1 || return 0
  command -v jq    >/dev/null 2>&1 || return 0
  list="$(herdr workspace list 2>/dev/null || true)"
  [ -n "$list" ] || return 0
  # Compare against the RESOLVED path too, since herdr stores what it was handed.
  local gone_r; gone_r="$(cd "$(dirname "$gone")" 2>/dev/null && printf '%s/%s' "$(pwd -P)" "$(basename "$gone")")" || gone_r="$gone"
  for id in $(printf '%s' "$list" | jq -r '.result.workspaces[]?.workspace_id' 2>/dev/null); do
    seen=$((seen+1))
    p="$(printf '%s' "$list" | jq -r --arg i "$id" '.result.workspaces[]? | select(.workspace_id==$i) | .worktree.checkout_path // ""' 2>/dev/null)"
    # `workspace list` is a summary and may omit the worktree block; ask directly when it
    # does, rather than reading its silence as "this workspace names no worktree".
    [ -n "$p" ] || p="$(herdr workspace get "$id" 2>/dev/null | jq -r '.result.workspace.worktree.checkout_path // ""' 2>/dev/null)"
    [ -n "$p" ] || continue
    named=$((named+1))
    if [ "$p" = "$gone" ] || [ "$p" = "$gone_r" ]; then ws="$id"; break; fi
  done
  if [ -z "$ws" ]; then
    say "NOTE: no herdr workspace named this worktree ($named of $seen examined named one at all), so none was closed. If one is left in your sidebar: herdr workspace list, then herdr workspace close <id>."
    return 0
  fi
  if herdr workspace close "$ws" >/dev/null 2>&1; then
    say "closed herdr workspace $ws (it pointed at the worktree just removed)"
  else
    say "NOTE: herdr workspace $ws still points at $(tilde "$gone"), which is gone. Close it with: herdr workspace close $ws"
  fi
  return 0
}

# ----------------------------------------------------------------- list ----
cmd_list(){
  local repo; repo="$(main_repo)" || refuse "list: not inside a git repository"
  local n=0 line p
  while IFS= read -r line; do
    case "$line" in worktree\ *) p="${line#worktree }" ;; *) continue ;; esac
    case "$p" in "$repo"/.worktree/scratch/*)
      n=$((n+1))
      # The live session, if one is running in that worktree. Read from the registry
      # rather than remembered, so a session that has since exited simply is not shown.
      local row name sid pid
      row="$(registry_row "$p")"
      if [ -n "$row" ]; then
        name="$(printf '%s' "$row" | cut -f1)"; sid="$(printf '%s' "$row" | cut -f2)"; pid="$(printf '%s' "$row" | cut -f3)"
        printf '%-40s %-24s %s\n' "$(tilde "$p")" "scratch/${p##*/}" "live: $name  session $sid  pid $pid"
      else
        printf '%-40s %-24s %s\n' "$(tilde "$p")" "scratch/${p##*/}" "no session running"
      fi ;;
    esac
  done <<<"$(git -C "$repo" worktree list --porcelain 2>/dev/null)"
  [ "$n" -eq 0 ] && { say "no scratch worktrees in $(basename "$repo")"; return 1; }
  return 0
}

# ------------------------------------------------------------- selftest ----
selftest(){
  local root pass=0 fail=0 out rc repo
  ok(){ pass=$((pass+1)); printf '  ok   %s\n' "$1"; }
  bad(){ fail=$((fail+1)); printf '  FAIL %s\n       got: %s\n' "$1" "$2"; }
  root="$(mktemp -d "${TMPDIR:-/tmp}/c2-selftest.XXXXXX")" || exit 1
  printf 'c2 selftest in %s\n' "$root"
  repo="$root/repo"
  git init -q "$repo" >/dev/null 2>&1
  git -C "$repo" config user.email t@e; git -C "$repo" config user.name t
  printf 'base\n' > "$repo/f.txt"; git -C "$repo" add f.txt; git -C "$repo" commit -qm base
  export C2_SCRATCH_HOME="$root/Scratch" C2_LAUNCH="WOULD-LAUNCH" C2_HWT="$root/no-such-hwt"

  run(){ OUT="$( (builtin cd "${RUNDIR:-$repo}" && "$SELF" "$@" 2>&1) )"; RC=$?; }
  SELF="$(cd "$(dirname "$0")" && pwd)/$(basename "$0")"

  # 1. start makes the worktree at the RULED path and does not launch under the seam
  run start t1
  [ "$RC" -eq 0 ] && ok "1 start exits 0" || bad "1 start rc" "$RC: $OUT"
  [ -d "$repo/.worktree/scratch/t1" ] && ok "1 worktree at <repo>/.worktree/scratch/<topic> (D-20260914-A01)" || bad "1 path" "$(ls -R "$repo/.worktree" 2>&1)"
  git -C "$repo" show-ref --verify --quiet refs/heads/scratch/t1 && ok "1 branch scratch/t1 exists" || bad "1 branch" "missing"
  case "$OUT" in *WOULD-LAUNCH*) ok "1 the launch is reached (seam printed instead)";; *) bad "1 launch" "$OUT";; esac
  # 1b. the transcript key handed to Claude Code is the MAIN repo's, not the worktree's.
  #     Without this the session's transcript lands under a key no pj tool ever looks in.
  # $OUT is saved and restored around this block: arm 1d runs its own start/done pair,
  # which overwrites OUT, and arm 1's remaining checks read it afterwards. Caught by the
  # suite itself -- "1 route" failed on arm 1d's output rather than arm 1's.
  local OUT_ARM1="$OUT"
  local mainkey wtkey
  mainkey="$(printf '%s' "$(cd "$repo" && pwd -P)" | sed 's#[/._]#-#g')"
  wtkey="$(printf '%s' "$(cd "$repo/.worktree/scratch/t1" && pwd -P)" | sed 's#[/._]#-#g')"
  if [ "${#mainkey}" -le 64 ]; then
    case "$OUT" in *"project_dir_name=$mainkey"*) ok "1b the transcript key is the MAIN repo's, not the worktree's";; *) bad "1b project_dir_name" "$OUT";; esac
  else
    # The 64-character cap. A fixture under $TMPDIR often exceeds it, and when it does the
    # right behaviour is to SAY so rather than pass a name that will be ignored in silence.
    case "$OUT" in
      *"project_dir_name=<too-long:${#mainkey}>"*) ok "1b a key over 64 chars is not passed (it would be ignored in silence)";;
      *) bad "1b over-long key" "$OUT";;
    esac
    case "$OUT" in *"capped at 64"*) ok "1b and the over-long key is announced, not swallowed";; *) bad "1b no notice" "$OUT";; esac
  fi
  # 1c. CONTROL: the two keys really are different, so arm 1b could have failed
  [ "$mainkey" != "$wtkey" ] && ok "1c control: the worktree's own key differs from the main key" || bad "1c control" "the keys are identical, so arm 1b proves nothing"
  # 1d. BOTH SIDES of the cap, on a fixture built to sit under it. Without this, arm 1b
  #     only ever exercises whichever side this machine's TMPDIR happens to land on.
  local shortrepo="$root/s"
  if [ "${#shortrepo}" -le 60 ]; then
    git init -q "$shortrepo" >/dev/null 2>&1
    git -C "$shortrepo" -c user.email=t@e -c user.name=t commit -q --allow-empty -m init >/dev/null 2>&1
    RUNDIR="$shortrepo" run start s1
    local shortkey; shortkey="$(printf '%s' "$(cd "$shortrepo" && pwd -P)" | sed 's#[/._]#-#g')"
    if [ "${#shortkey}" -le 64 ]; then
      case "$OUT" in *"project_dir_name=$shortkey"*) ok "1d a key under the cap IS passed (the other side of arm 1b)";; *) bad "1d short key" "$OUT";; esac
    else
      printf '  info 1d the short fixture key is still %s chars here; both-sides arm skipped\n' "${#shortkey}"
    fi
    RUNDIR="$shortrepo" run done s1 --discard
  fi
  unset RUNDIR
  OUT="$OUT_ARM1"
  [ -d "$root/Scratch/repo" ] && ok "1 learnings folder created outside the worktree" || bad "1 scratch home" "missing"
  case "$OUT" in *"git worktree add"*) ok "1 says which route it took when hwt is absent";; *) bad "1 route" "$OUT";; esac

  # 2. a second start on the same topic REFUSES rather than clobbering
  run start t1
  [ "$RC" -eq 2 ] && ok "2 a repeated start REFUSES rc 2" || bad "2 repeat" "rc=$RC $OUT"

  # 3. GUARD 1: an uncommitted file refuses, names the file, and changes NOTHING
  printf 'unsaved\n' > "$repo/.worktree/scratch/t1/new.txt"
  run done t1
  [ "$RC" -eq 2 ] && ok "3 done REFUSES rc 2 while an uncopied file exists" || bad "3 dirty rc" "rc=$RC $OUT"
  case "$OUT" in *new.txt*) ok "3 the refusal names the file";; *) bad "3 names" "$OUT";; esac
  [ -d "$repo/.worktree/scratch/t1" ] && ok "3 the worktree is still there after the refusal" || bad "3 destroyed" "gone"

  # 4. GUARD 2: commit it, and the unmerged commit refuses on its own
  git -C "$repo/.worktree/scratch/t1" add new.txt
  git -C "$repo/.worktree/scratch/t1" -c user.email=t@e -c user.name=t commit -qm "scratch work"
  run done t1
  [ "$RC" -eq 2 ] && ok "4 done REFUSES rc 2 on an unmerged commit" || bad "4 unmerged rc" "rc=$RC $OUT"
  case "$OUT" in *"scratch work"*) ok "4 the refusal names the commit";; *) bad "4 commit named" "$OUT";; esac
  case "$OUT" in *"--discard"*) ok "4 the refusal names the only way through";; *) bad "4 discard hint" "$OUT";; esac
  [ -d "$repo/.worktree/scratch/t1" ] && ok "4 still nothing destroyed" || bad "4 destroyed" "gone"

  # 5. --discard tears it down: worktree AND branch
  run done t1 --discard
  [ "$RC" -eq 0 ] && ok "5 --discard exits 0" || bad "5 discard rc" "rc=$RC $OUT"
  [ ! -d "$repo/.worktree/scratch/t1" ] && ok "5 worktree gone" || bad "5 worktree" "still there"
  git -C "$repo" show-ref --verify --quiet refs/heads/scratch/t1 && bad "5 branch" "still there" || ok "5 branch gone"
  case "$OUT" in *"the guards were not run"*) ok "5 --discard says the guards were skipped";; *) bad "5 discard notice" "$OUT";; esac

  # 6. THE POSITIVE ARM, and the one that matters most: a CLEAN, MERGED topic needs no
  #    --discard. Without it, arms 3 and 4 pass just as well on a `done` that always
  #    refuses -- "it refused" is true in both worlds.
  run start t2
  printf 'kept\n' > "$repo/.worktree/scratch/t2/kept.txt"
  git -C "$repo/.worktree/scratch/t2" add kept.txt
  git -C "$repo/.worktree/scratch/t2" -c user.email=t@e -c user.name=t commit -qm "worth keeping"
  git -C "$repo" merge -q --no-ff -m merge scratch/t2 >/dev/null 2>&1
  run done t2
  [ "$RC" -eq 0 ] && ok "6 control: a clean, merged topic tears down with NO --discard" || bad "6 clean teardown" "rc=$RC $OUT"
  [ ! -d "$repo/.worktree/scratch/t2" ] && ok "6 its worktree is gone" || bad "6 worktree" "still there"
  git -C "$repo" show-ref --verify --quiet refs/heads/scratch/t2 && bad "6 branch" "still there" || ok "6 branch gone"
  # CAPTURE FIRST, then test. NOT `git log ... | grep -q`: `set -o pipefail` is on, and
  # `grep -q` exits the moment it matches, so git takes a SIGPIPE and the PIPELINE reports
  # failure even though the match succeeded. Measured 2026-09-21 -- this arm reported "the
  # commit is gone" about a commit that was sitting in the log the whole time. Same family
  # as the rule about never reading $? after a pipe.
  out="$(git -C "$repo" log --oneline --all 2>/dev/null || true)"
  case "$out" in *"worth keeping"*) ok "6 the merged work survived the teardown";; *) bad "6 work lost" "the commit is gone";; esac

  # 7. list, and the empty case
  run start t3
  run list
  case "$OUT" in *scratch/t3*) ok "7 list names a live scratch worktree";; *) bad "7 list" "$OUT";; esac
  run done t3 --discard
  run list
  [ "$RC" -eq 1 ] && ok "7 list exits 1 when there are none (not an error)" || bad "7 empty list" "rc=$RC $OUT"

  # 8. done on a topic that never existed: rc 1, says so, destroys nothing
  run done nosuch
  [ "$RC" -eq 1 ] && ok "8 done on an unknown topic exits 1, not 2" || bad "8 unknown" "rc=$RC $OUT"

  # 9. refusals: bad topic shapes, unknown flags, outside a repo
  local b
  for b in 'a/b' '.hidden' 'two words'; do
    run start "$b"
    [ "$RC" -eq 2 ] && ok "9 topic '$b' REFUSED" || bad "9 topic '$b'" "rc=$RC"
  done
  run start t9 --bogus
  [ "$RC" -eq 2 ] && ok "9 an unknown start flag REFUSES" || bad "9 flag" "rc=$RC"
  RUNDIR="$root" run list
  [ "$RC" -eq 2 ] && ok "9 outside a git repo REFUSES" || bad "9 outside repo" "rc=$RC $OUT"
  unset RUNDIR

  # 10. it NEVER pushes. A remote is added and must stay empty through a full cycle.
  git init -q --bare "$root/origin.git" >/dev/null 2>&1
  git -C "$repo" remote add origin "$root/origin.git" >/dev/null 2>&1
  run start t10
  printf 'x\n' > "$repo/.worktree/scratch/t10/x.txt"
  git -C "$repo/.worktree/scratch/t10" add x.txt
  git -C "$repo/.worktree/scratch/t10" -c user.email=t@e -c user.name=t commit -qm x
  run done t10 --discard
  out="$(git -C "$root/origin.git" for-each-ref --format='%(refname)' 2>/dev/null)"
  [ -z "$out" ] && ok "10 a full start/done cycle pushed nothing (the remote is still empty)" || bad "10 pushed" "$out"
  # 10b. CONTROL: the remote CAN receive, so arm 10's emptiness means "c2 did not push"
  #      rather than "nothing here can push". core.hooksPath is emptied for this one
  #      command: this machine has a GLOBAL pre-push hook (pnpm-audit-hook) that fails
  #      inside the Bash sandbox because uv's cache is unwritable there, and measured
  #      2026-09-21 it blocks every push. Leaving it in would make the control fail for a
  #      reason that has nothing to do with the remote, which is a broken instrument
  #      reading as a finding.
  git -C "$repo" -c core.hooksPath=/dev/null push -q origin HEAD:refs/heads/control-probe >/dev/null 2>&1
  out="$(git -C "$root/origin.git" for-each-ref --format='%(refname)' 2>/dev/null)"
  case "$out" in *control-probe*) ok "10b control: the remote accepts a push, so arm 10's empty result is real";; *) bad "10b control" "the remote refused even a deliberate push: arm 10 proves nothing";; esac

  # 11. no `rm` in the OPERATIONAL half of this script, so the deletion-safety rule's
  #     banned list is unreachable. The scan stops at the selftest marker: the first
  #     version of this arm searched the whole file and matched ITS OWN grep pattern,
  #     which is the self-referential form of reading a count you produced yourself.
  local oper="$root/c2-operational.txt"
  sed -n '1,/^# ---* selftest ---*$/p' "$SELF" > "$oper"
  if grep -nE '(^|[;&|( ])(/bin/rm|rm )' "$oper" | grep -vE '^[0-9]+:[[:space:]]*#' | grep -q .; then
    bad "11 an rm call is present in the operational half" "$(grep -nE '(^|[;&|( ])(/bin/rm|rm )' "$oper" | grep -vE '^[0-9]+:[[:space:]]*#' | head -3)"
  else
    ok "11 no rm call in the operational half (teardown is git worktree remove + git branch -D)"
  fi
  # CONTROL: the scan really did read the operational half, and that half really does
  # contain the teardown. Without this, an empty $oper would pass arm 11 silently.
  [ -s "$oper" ] && grep -q 'git worktree remove' "$oper" \
    && ok "11 control: the scanned text is non-empty and holds the teardown call" \
    || bad "11 control" "the scanned text was empty or lacked git worktree remove, so arm 11's absence proves nothing"

  # 12. the folder-trust decision (D-20260922-A01). A PURE function, so every arm runs
  #     without a pane, a herdr server or a live dialog.
  local dlg_no dlg_yes no_dlg prose k
  dlg_no="$(printf '%s\n%s\n%s\n' ' Quick safety check: Is this a project you created or one you trust?' ' ❯ No, exit' '   Yes, I trust this folder')"
  dlg_yes="$(printf '%s\n%s\n%s\n' ' Quick safety check: Is this a project you created or one you trust?' '   No, exit' ' ❯ Yes, I trust this folder')"
  no_dlg="$(printf '%s\n' 'claude> ready. 0 tokens')"
  # The false-positive fixture: the exact dialog WORDS with no cursor marker, which is what
  # a transcript, a doc, or this script's own --help looks like in a pane.
  prose="$(printf '%s\n' 'the watcher matches on Yes, I trust this folder before it sends anything')"
  k="$(trust_keys_for "$dlg_no")"
  [ "$k" = "$(printf 'down\nenter')" ] && ok "12a dialog with the cursor on No -> down, enter" || bad "12a" "got [$k]"
  k="$(trust_keys_for "$dlg_yes")"
  [ "$k" = "enter" ] && ok "12b dialog already on Yes -> enter only" || bad "12b" "got [$k]"
  k="$(trust_keys_for "$no_dlg")"
  [ -z "$k" ] && ok "12c no dialog -> sends NOTHING" || bad "12c sent keys with no dialog" "got [$k]"
  k="$(trust_keys_for "$prose")"
  [ -z "$k" ] && ok "12d the dialog WORDS without a cursor marker -> sends NOTHING" || bad "12d false positive" "got [$k]"
  # 12e CONTROL: 12c and 12d are absences, and an absence proves nothing on its own. This
  #     says the same function, called the same way in the same breath, DOES produce keys.
  [ -n "$(trust_keys_for "$dlg_no")" ] && ok "12e control: the function does emit keys for a real dialog" \
    || bad "12e control" "the function emits nothing for anything, so 12c and 12d prove nothing"
  # 12f trust_watch is inert outside herdr. A fake `herdr` on PATH records any call, so
  #     "it did nothing" is measured rather than assumed.
  local fakebin="$root/fakebin"; mkdir -p "$fakebin"
  printf '#!/bin/sh\necho called >> "%s/herdr-calls"\n' "$root" > "$fakebin/herdr"; chmod +x "$fakebin/herdr"
  ( PATH="$fakebin:$PATH"; unset HERDR_ENV; trust_watch "w9:p9" ) >/dev/null 2>&1
  [ ! -e "$root/herdr-calls" ] && ok "12f trust_watch calls nothing when HERDR_ENV is unset" || bad "12f called herdr" "$(cat "$root/herdr-calls")"
  ( PATH="$fakebin:$PATH"; HERDR_ENV=1 trust_watch "" ) >/dev/null 2>&1
  [ ! -e "$root/herdr-calls" ] && ok "12f trust_watch calls nothing without a pane id" || bad "12f called herdr" "$(cat "$root/herdr-calls")"
  # 12g CONTROL for 12f: the fake herdr really does record when it IS run, so the two
  #     absences above are evidence rather than a broken probe.
  ( PATH="$fakebin:$PATH"; herdr anything ) >/dev/null 2>&1
  [ -e "$root/herdr-calls" ] && ok "12g control: the fake herdr records a call when one happens" \
    || bad "12g control" "the probe cannot detect a call at all, so 12f proves nothing"

  # 12h THE ARM THAT WOULD HAVE CAUGHT THE REAL BUG. The first trust_watch used
  #     `herdr pane wait-output --match "Yes, I trust this folder"` and returned in one
  #     second on words left in the SCROLLBACK by an earlier session, read the pane once
  #     before the new dialog had rendered, saw no cursor marker, and gave up while the
  #     dialog sat there. Every unit arm above passed on that version, because they all
  #     test the DECISION and the bug was in the WAITING.
  #     So this arm makes the dialog arrive LATE: a fake herdr returns ordinary pane text
  #     on the first read and the dialog only on the second. A watcher that decides once
  #     sends nothing; a watcher that keeps looking sends down+enter.
  local lb="$root/latebin"; mkdir -p "$lb"
  printf '%s\n%s\n%s\n' ' Quick safety check: Is this a project you created or one you trust?' ' ❯ No, exit' '   Yes, I trust this folder' > "$root/late-dialog.txt"
  cat > "$lb/herdr" <<LATE
#!/bin/sh
R="$root"
if [ "\$1" = pane ] && [ "\$2" = read ]; then
  n=\$(cat "\$R/readn" 2>/dev/null || echo 0); n=\$((n+1)); printf '%s\n' "\$n" > "\$R/readn"
  if [ "\$n" -eq 2 ]; then cat "\$R/late-dialog.txt"; else printf 'claude> ready\n'; fi
  exit 0
fi
if [ "\$1" = pane ] && [ "\$2" = send-keys ]; then printf '%s\n' "\$4" >> "\$R/late-keys"; exit 0; fi
exit 0
LATE
  chmod +x "$lb/herdr"
  ( PATH="$lb:$PATH"; HERDR_ENV=1 C2_TRUST_POLL_S=0 C2_TRUST_TIMEOUT_MS=20000 trust_watch "w1:p1" ) >/dev/null 2>&1
  if [ -f "$root/late-keys" ] && [ "$(tr '\n' ' ' < "$root/late-keys")" = "down enter " ]; then
    ok "12h a dialog that arrives on the SECOND read is still accepted (down, enter)"
  else
    bad "12h the watcher gave up before the dialog arrived" "late-keys: $(cat "$root/late-keys" 2>/dev/null | tr '\n' ' ')"
  fi
  # 12i CONTROL for 12h: with the SAME fake but no dialog ever, nothing is sent. Without
  #     it, 12h passes on a watcher that fires down+enter at anything.
  printf '5\n' > "$root/readn"   # past the one read that yields a dialog
  ( PATH="$lb:$PATH"; HERDR_ENV=1 C2_TRUST_POLL_S=0 C2_TRUST_TIMEOUT_MS=3000 trust_watch "w1:p1" ) >/dev/null 2>&1
  [ "$(tr '\n' ' ' < "$root/late-keys" 2>/dev/null)" = "down enter " ] \
    && ok "12i control: with no dialog ever, the same watcher sends nothing more" \
    || bad "12i control" "keys changed with no dialog: $(cat "$root/late-keys" 2>/dev/null | tr '\n' ' ')"
  # 12j the internal --trust-watch entry point refuses without a pane id.
  run --trust-watch
  [ "$RC" -eq 2 ] && ok "12j --trust-watch with no pane id REFUSES rc 2" || bad "12j" "rc=$RC $OUT"

  # 13. start prints the peer NAME, and it is pj's name rather than one c2 invented
  #     (F5c gate Q3, reshaped by F5d gate Q1: no suffix, and c2 ASKS pj).
  run start t13
  case "$OUT" in *"peer name repo-scratch-t13"*) ok "13 start prints the peer name pj will give the session";; *) bad "13 peer name" "$OUT";; esac
  case "$OUT" in *'SendMessage to="repo-scratch-t13"'*) ok "13 and the exact SendMessage line to use";; *) bad "13 sendmessage line" "$OUT";; esac
  case "$OUT" in *"peer_name=repo-scratch-t13"*) ok "13 the name reaches the launch (seam shows it)";; *) bad "13 launch name" "$OUT";; esac
  # 13b THE ANTI-DRIFT ARM, and the reason c2 stopped building the name itself: what c2
  #     prints must be what pj would export, character for character. A second copy of the
  #     formula here would pass arm 13 and still disagree with the launch.
  #     AND "pj IS NOT INSTALLED" IS NOT THE SAME AS "pj ANSWERED NOTHING". The first
  #     version reported ok for an empty $pjname whatever the reason, so a pj that was
  #     present and BROKEN passed the anti-drift arm -- and pj was in fact broken for
  #     exactly this input at the time (it aborted rc 1 whenever CLAUDE_CODE_SESSION_NAME
  #     was already set, which it is inside any pj session). Skipping and passing are
  #     different outcomes and they get different branches. Raised by /code-review.
  local pjname pjout pjrc
  if ! command -v pj >/dev/null 2>&1; then
    ok "13b pj is not on PATH here, so the drift arm is SKIPPED (not passed)"
  else
    pjout="$( builtin cd "$repo/.worktree/scratch/t13" 2>/dev/null \
              && PJ_PROFILE=scratch pj --dry-run-env 2>/dev/null )"; pjrc=$?
    pjname="$(printf '%s\n' "$pjout" | sed -n 's/^CLAUDE_CODE_SESSION_NAME=//p' | head -1)"
    if [ "$pjrc" -ne 0 ]; then
      bad "13b pj is installed but exited $pjrc" "$(printf '%s' "$pjout" | head -c 200)"
    elif [ -z "$pjname" ]; then
      bad "13b pj answered with no name at all" "$(printf '%s' "$pjout" | head -c 200)"
    else
      case "$OUT" in *"peer_name=$pjname"*) ok "13b c2's printed name IS pj's, asked of pj not rebuilt";; *) bad "13b name drift" "c2 said ${OUT##*peer_name=} / pj says $pjname";; esac
    fi
  fi
  # 13c NO SUFFIX. The random hex is gone, and this is the arm that keeps it gone: the
  #     collision fear that justified it was measured false (see pj build_session_name).
  case "$OUT" in *"peer_name=repo-scratch-t13-"*) bad "13c a suffix came back" "$OUT";; *) ok "13c the name carries no random suffix";; esac
  run done t13 --discard

  # 14. envrc_gate (F5d gate Q3a). A pure function of two files plus direnv, so every arm
  #     runs without a worktree, a direnv allow or a launch.
  local ea="$root/ea"; mkdir -p "$ea/main" "$ea/wt"
  # 14a no .envrc in the worktree -> silent rc 0, whatever the main repo holds.
  #     CAPTURE THE STATUS FIRST: by the time `bad` runs in an `a && b || c` chain, `$?` is
  #     the status of the TEST, always 1, not of the thing under test. The first version
  #     would have reported rc=1 for a gate that returned 2 or 127. Raised by /code-review.
  printf 'export A=1\n' > "$ea/main/.envrc"
  envrc_gate "$ea/main" "$ea/wt" >/dev/null 2>&1; RC=$?
  [ "$RC" -eq 0 ] && ok "14a no worktree .envrc -> rc 0, nothing said" || bad "14a" "rc=$RC"
  # 14b IDENTICAL but the main repo's is not allowed -> rc 0 and a NOTE, never a stop.
  #     (No fixture can be direnv-allowed, so this is the branch the selftest reaches.)
  printf 'export A=1\n' > "$ea/wt/.envrc"
  OUT="$(envrc_gate "$ea/main" "$ea/wt" 2>&1)"; RC=$?
  if command -v direnv >/dev/null 2>&1; then
    [ "$RC" -eq 0 ] && ok "14b identical but unallowed original -> rc 0 (carry on)" || bad "14b" "rc=$RC $OUT"
    case "$OUT" in *"does not report it as allowed"*) ok "14b and it says WHY, rather than going quiet";; *) bad "14b note" "$OUT";; esac
    # 14b' and it QUOTES direnv, rather than only its own reading of direnv. This arm exists
    #      because that branch fired once in a live run against a repo that WAS allowed and
    #      did not reproduce; a check that cannot say what it saw cannot be diagnosed.
    case "$OUT" in *"direnv said: Found RC allowed"*) ok "14b' and quotes what direnv actually said";; *) bad "14b' no quote" "$OUT";; esac
  else
    [ "$RC" -eq 0 ] && ok "14b no direnv installed -> rc 0 (carry on)" || bad "14b" "rc=$RC $OUT"
  fi
  # 14c DIFFERS -> rc 1, the diff on stderr, and the launch stops. The arm that matters.
  printf 'export A=2\n' > "$ea/wt/.envrc"
  OUT="$(envrc_gate "$ea/main" "$ea/wt" 2>&1)"; RC=$?
  [ "$RC" -eq 1 ] && ok "14c a differing .envrc STOPS the launch (rc 1)" || bad "14c" "rc=$RC $OUT"
  case "$OUT" in *REFUSED*) ok "14c and it refuses by name";; *) bad "14c refusal" "$OUT";; esac
  case "$OUT" in *"export A=2"*) ok "14c and prints the diff, so you can read what changed";; *) bad "14c diff" "$OUT";; esac
  # 14d no .envrc in the MAIN repo -> rc 0 and a NOTE. Nothing to compare is not a fault.
  #
  #     MOVE IT, AND CHECK IT MOVED. `rm` here is the Trash shim; inside the sandbox it
  #     refuses on these fixtures (afpAccessDenied, trash exit 5) and leaves the file. This
  #     arm then measures the IDENTICAL-files path instead, which also returns rc 0, so it
  #     passed in both worlds. Caught by reading the selftest's own trash error rather than
  #     by the arm, which is the point. `mv` always works; the assertion proves it did.
  mkdir -p "$ea/discard"
  command mv -f "$ea/main/.envrc" "$ea/discard/main-envrc" 2>/dev/null || true
  printf 'export A=1\n' > "$ea/wt/.envrc"
  if [ -e "$ea/main/.envrc" ]; then
    bad "14d setup" "the main .envrc is still there, so this arm would measure the wrong branch"
  else
    ok "14d setup: the main .envrc really is gone (checked, not assumed)"
    OUT="$(envrc_gate "$ea/main" "$ea/wt" 2>&1)"; RC=$?
    [ "$RC" -eq 0 ] && ok "14d no original to compare -> rc 0 (carry on)" || bad "14d" "rc=$RC $OUT"
    case "$OUT" in *"no allowed original"*) ok "14d and says there is no original to compare with";; *) bad "14d note" "$OUT";; esac
  fi
  # 14e CONTROL for 14a: the gate really does read the files, so 14a's rc 0 means "nothing
  #     to do" rather than "this function never looks at anything". 14c is the proof.
  [ "$RC" -eq 0 ] && ok "14e control: 14c rc 1 vs 14a/14d rc 0 -- the gate separates the cases" || bad "14e control" "every arm returned the same rc"

  # 15. close_herdr_workspace (F5d gate Q4). A fake herdr answers workspace list, so the
  #     matching rule is tested without a herdr server or a real workspace.
  local hb="$root/herdrbin"; mkdir -p "$hb"
  #     EVERY ARM GETS ITS OWN RECORDER FILE, through WS_CLOSED. The first version reused
  #     one path and cleared it with `rm -f`; inside the sandbox `rm` is the Trash shim and
  #     CAN REFUSE, leaving the file, and arms 15b and 15c then read 15a's recording as
  #     their own finding. /code-review measured exactly that: both failed with
  #     "got: closed wB". A fresh filename cannot go stale.
  cat > "$hb/herdr" <<HFAKE
#!/bin/sh
if [ "\$1" = workspace ] && [ "\$2" = list ]; then
  printf '%s\n' '{"result":{"workspaces":[{"workspace_id":"wA","label":"repo"},{"workspace_id":"wB","label":"repo","worktree":{"checkout_path":"GONEPATH"}}]}}'
  exit 0
fi
if [ "\$1" = workspace ] && [ "\$2" = get ]; then
  printf '%s\n' '{"result":{"workspace":{}}}'; exit 0
fi
if [ "\$1" = workspace ] && [ "\$2" = close ]; then
  printf '%s\n' "closed \$3" >> "\${WS_CLOSED:-/dev/null}"; exit 0
fi
exit 0
HFAKE
  chmod +x "$hb/herdr"
  # 15a the workspace whose checkout_path IS the removed path is closed, by id
  OUT="$( PATH="$hb:$PATH"; WS_CLOSED="$root/ws.15a"; export WS_CLOSED; close_herdr_workspace "GONEPATH" 2>&1 )"
  [ "$(cat "$root/ws.15a" 2>/dev/null)" = "closed wB" ] && ok "15a the workspace pointing at the removed worktree is closed" || bad "15a" "$(cat "$root/ws.15a" 2>/dev/null)"
  case "$OUT" in *"closed herdr workspace wB"*) ok "15a and it says so, rather than closing something silently";; *) bad "15a said" "$OUT";; esac
  # 15b THE NEGATIVE ARM: a path that matches nothing closes NOTHING. wA shares the label
  #     with wB, so a rule that matched on the label would close the wrong workspace here.
  OUT="$( PATH="$hb:$PATH"; WS_CLOSED="$root/ws.15b"; export WS_CLOSED; close_herdr_workspace "SOMEOTHERPATH" 2>&1 )"
  [ ! -e "$root/ws.15b" ] && ok "15b an unmatched path closes nothing (label is never matched on)" || bad "15b closed the wrong one" "$(cat "$root/ws.15b")"
  # 15b' and a miss SAYS SO, with its denominators, rather than going quiet -- silence here
  #      and "herdr spelled the path differently" are the same thing, and the second one
  #      silently re-opens the leak.
  case "$OUT" in *"1 of 2 examined"*) ok "15b' a miss reports how many were examined and how many named a worktree";; *) bad "15b' silent miss" "$OUT";; esac
  # 15c an empty path closes nothing, and says nothing either (there is nothing to report)
  OUT="$( PATH="$hb:$PATH"; WS_CLOSED="$root/ws.15c"; export WS_CLOSED; close_herdr_workspace "" 2>&1 )"
  [ ! -e "$root/ws.15c" ] && ok "15c an empty path closes nothing" || bad "15c" "$(cat "$root/ws.15c")"
  # 15d herdr ABSENT -> silent no-op, rc 0
  ( PATH="$root/emptybin"; WS_CLOSED="$root/ws.15d"; export WS_CLOSED; close_herdr_workspace "GONEPATH" ) >/dev/null 2>&1; RC=$?
  [ "$RC" -eq 0 ] && [ ! -e "$root/ws.15d" ] && ok "15d no herdr on PATH -> silent no-op, rc 0" || bad "15d" "rc=$RC"
  # 15e CONTROL for 15b-15d: the fake really does record when a close happens, so those
  #     three absent files mean "nothing was closed" rather than "the recorder is broken".
  [ -e "$root/ws.15a" ] && ok "15e control: the recorder fires when a close really happens" || bad "15e control" "15a recorded nothing, so 15b-15d prove nothing"

  # ---- 16: the empty scaffold directories `c2 start` leaves behind --------------------
  # Asked for by Gavin after the F8a gate. A FRESH repo per arm, never a cleared one: a
  # `rm` here is the Trash shim and can refuse, leaving a stale fixture to be read as a
  # finding (the trap CLAUDE.md records for decided-selftest, and the one that bit arm 22
  # of pj --selftest).
  local r16 r16b
  r16="$root/repo16"
  git init -q "$r16" >/dev/null 2>&1
  git -C "$r16" config user.email t@e; git -C "$r16" config user.name t
  printf 'base\n' > "$r16/f.txt"; git -C "$r16" add f.txt; git -C "$r16" commit -qm base
  # 16a THE POSITIVE ARM: one topic, done, and both scaffold dirs go
  OUT="$( (builtin cd "$r16" && "$SELF" start s1 2>&1) )"; RC=$?
  [ -d "$r16/.worktree/scratch/s1" ] && ok "16a fixture: start made the worktree" || bad "16a fixture" "rc=$RC $OUT"
  OUT="$( (builtin cd "$r16" && "$SELF" done s1 --discard 2>&1) )"; RC=$?
  [ "$RC" -eq 0 ] && ok "16a done exits 0" || bad "16a done rc" "$RC: $OUT"
  [ ! -d "$r16/.worktree/scratch" ] && ok "16a the empty <repo>/.worktree/scratch/ is removed" || bad "16a scratch left" "$(ls -la "$r16/.worktree" 2>&1)"
  [ ! -d "$r16/.worktree" ] && ok "16a and the empty <repo>/.worktree/ with it" || bad "16a parent left" "$(ls -la "$r16/.worktree" 2>&1)"
  case "$OUT" in *"removed the now-empty"*) ok "16a it says what it removed";; *) bad "16a silent" "$OUT";; esac
  # 16b THE NEGATIVE ARM, and the one that matters: with a SECOND topic still checked out,
  #     nothing is removed. Without this, 16a passes just as well for an `rm -r`.
  r16b="$root/repo16b"
  git init -q "$r16b" >/dev/null 2>&1
  git -C "$r16b" config user.email t@e; git -C "$r16b" config user.name t
  printf 'base\n' > "$r16b/f.txt"; git -C "$r16b" add f.txt; git -C "$r16b" commit -qm base
  ( builtin cd "$r16b" && "$SELF" start k1 >/dev/null 2>&1 )
  ( builtin cd "$r16b" && "$SELF" start k2 >/dev/null 2>&1 )
  [ -d "$r16b/.worktree/scratch/k1" ] && [ -d "$r16b/.worktree/scratch/k2" ] && ok "16b fixture: two topics checked out" || bad "16b fixture" "$(ls "$r16b/.worktree/scratch" 2>&1)"
  OUT="$( (builtin cd "$r16b" && "$SELF" done k1 --discard 2>&1) )"
  [ -d "$r16b/.worktree/scratch" ] && ok "16b a live sibling topic keeps <repo>/.worktree/scratch/" || bad "16b removed an in-use dir" "$OUT"
  [ -d "$r16b/.worktree/scratch/k2" ] && ok "16b and the sibling worktree is untouched" || bad "16b sibling gone" "$(ls "$r16b/.worktree/scratch" 2>&1)"
  case "$OUT" in *"kept"*"1 other topic(s) still there"*) ok "16b it states the denominator rather than going quiet";; *) bad "16b silent keep" "$OUT";; esac
  # 16c the function is a no-op when there is no .worktree at all, rc 0 (a repo that never
  #     ran `c2 start`), so `done` on a branch-only leftover cannot fail here
  prune_empty_worktree_dirs "$root/repo" >/dev/null 2>&1; RC=$?
  [ "$RC" -eq 0 ] && ok "16c no .worktree/scratch at all -> rc 0, no output" || bad "16c" "rc=$RC"
  # 16d CONTROL for 16c: the same function DOES act when there is something to act on, so
  #     16c's silence means "nothing to do" and not "the function is broken".
  mkdir -p "$root/ctl16/.worktree/scratch"
  OUT="$( prune_empty_worktree_dirs "$root/ctl16" 2>&1 )"
  [ ! -d "$root/ctl16/.worktree/scratch" ] && ok "16d control: the function really removes an empty scratch dir" || bad "16d control" "$OUT"

  printf 'c2 selftest: %d passed, %d failed\n' "$pass" "$fail"
  [ "$fail" -eq 0 ]
}

case "${1:-}" in
  --help|-h|"") usage; exit 0 ;;
  --selftest) selftest; exit $? ;;
  # INTERNAL, and deliberately not in --help: `start` forks this in the background, and
  # having it reachable is what let the watcher be proven against a REAL dialog in a REAL
  # pane rather than only against fixture text. The first version passed every unit arm
  # and still failed the first live dialog it met, so "the pure function is tested" is not
  # the same claim as "the watcher works".
  --trust-watch) shift; [ -n "${1:-}" ] || refuse "--trust-watch needs a pane id"; trust_watch "$1"; exit $? ;;
  start) shift; cmd_start "$@"; exit $? ;;
  done)  shift; cmd_done  "$@"; exit $? ;;
  list)  shift; cmd_list  "$@"; exit $? ;;
  *) refuse "unknown command $1 (start | done | list | --selftest)" ;;
esac
