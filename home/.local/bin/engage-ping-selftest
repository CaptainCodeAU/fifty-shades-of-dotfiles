# ---- 15. Each iMessage twice, one second apart (B13 part 1b) --------------------------
# Gavin, 20 Oct 2026: "To send the iMessage twice for it to reach me, otherwise I won't get a
# notification for it". Old pj-ping's own gap: send, sleep 1, send again. The upper bound is
# 2.5 s, not 1.5, so a loaded Mac does not fail a correct pair.
twice() { # twice <label> <args...>: exactly 2 imsg, identical, 1.0 to 2.5 s apart
  local label="$1"; shift
  arm "twice-$label"
  run "$@"
  local t1 t2 g
  t1=$(nth imsg 1); t2=$(nth imsg 2)
  g=$(awk '$2 == "imsg" { if (!a) a = $1; else { printf "%.3f", $1 - a; exit } }' "$PJ_PING_FAKE_LOG")
  if [ "$(nof imsg)" -eq 2 ] && [ -n "$t1" ] && [ "$t1" = "$t2" ] && perl -e "exit !(${g:-0} >= 1.0 && ${g:-0} < 2.5)"; then
    ok "15 $label: the imsg twice, the same text, ${g} s apart"
  else bad "15 $label twice" "imsg=$(nof imsg) gap=$g"; fi
}
twice question question "q"
twice waiting waiting "w" --you "x"
twice decision waiting "w" --decision --you "x"
twice alarm alarm "a" --you "x"
twice stopped alarm "a" --stopped --you "x"
twice test test "t"
arm twice-done
run done "d"
[ "$(nof imsg)" -eq 0 ] && ok "15 done, ntfy took it (204): no imsg" || bad "15 done 204" "imsg=$(nof imsg)"
arm twice-fallback
ENGAGE_PING_FAKE_HTTP=403 run done "d"
[ "$(nof imsg)" -eq 2 ] && [ "$(nth imsg 1)" = "$(nth imsg 2)" ] && grep -q 'fallback=imsg:0,0$' "$LOG" \
  && ok "15 done refused (403): the fallback imsg twice, logged fallback=imsg:0,0" || bad "15 fallback twice" "imsg=$(nof imsg) $(cat "$LOG")"
arm twice-q403
ENGAGE_PING_FAKE_HTTP=403 run question "q"
[ "$(nof imsg)" -eq 2 ] && ok "15 a question refused (403): its own 2, no third or fourth" || bad "15 question 403" "imsg=$(nof imsg)"
arm twice-fail
PJ_PING_FAKE_IMSG_RC=3 run question "q"
[ "$RC" -eq 1 ] && [ "$(nof imsg)" -eq 2 ] && grep -q 'imsg=3,3 ' "$LOG" && ok "15 a failing imsg: both still tried, imsg=3,3, exit 1" || bad "15 failing pair" "rc=$RC imsg=$(nof imsg) $(cat "$LOG")"

# ---- 16. Inside the Bash sandbox: refused by name, and logged (#3640) -----------------
# On 22 Oct 2026 a ping inside the sandbox said only "a send failed" and logged nothing.
# A file where a folder should be makes a log path that cannot be written.
: >"$ROOT/a-file"
arm sbx
SANDBOX_RUNTIME=1 run question "q"
[ "$RC" -eq 3 ] && [ "$(ncalls)" -eq 0 ] && [ -z "$OUT" ] && grep -q 'REFUSED' <<<"$ERR" && grep -q 'sandbox' <<<"$ERR" \
  && ok "16 SANDBOX_RUNTIME=1: exit 3, no sound, imsg or curl, REFUSED and the sandbox named on stderr" || bad "16 refused" "rc=$RC calls=$(calls) out=$OUT err=$ERR"
grep -q "	question	st-sess	refused	sandbox\$" "$LOG" && [ "$(wc -l <"$LOG" | tr -d ' ')" -eq 1 ] && [ ! -e "$PEND" ] && grep -qF "$LOG" <<<"$ERR" \
  && ok "16 the refusal is one line in the log, stderr names the log, no pending file" || bad "16 refusal logged" "$(cat "$LOG" 2>&1) pend=$(cat "$PEND" 2>&1)"
arm sbx-ctl
SANDBOX_RUNTIME=0 run question "q"
[ "$RC" -eq 0 ] && [ "$(calls)" = "afplay afplay afplay afplay imsg imsg curl " ] && ! grep -q refused "$LOG" \
  && ok "16 control: SANDBOX_RUNTIME=0 sends as usual" || bad "16 control" "rc=$RC calls=$(calls) $(cat "$LOG")"
arm sbx-detach
SANDBOX_RUNTIME=1 run done "d" --detach; sleep 0.5; settle
[ "$RC" -eq 3 ] && [ "$(ncalls)" -eq 0 ] && grep -q 'refused	sandbox$' "$LOG" \
  && ok "16 --detach in the sandbox: refused the same, nothing forked off" || bad "16 detach" "rc=$RC calls=$(calls) $(cat "$LOG" 2>&1)"
arm sbx-pend
SANDBOX_RUNTIME=1 PJ_PING_LOG="$ROOT/a-file/p.log" run waiting "w" --you "x"
[ "$RC" -eq 3 ] && [ "$(ncalls)" -eq 0 ] && grep -q '	waiting	st-sess	refused	sandbox$' "$PEND" && grep -qF "$PEND" <<<"$ERR" \
  && ok "16 log not writable: the refusal goes in the pending file, named on stderr" || bad "16 pending" "rc=$RC pend=$(cat "$PEND" 2>&1) err=$ERR"
ENGAGE_PING_NOW="$NOW2" run done "d"
[ "$RC" -eq 0 ] && [ ! -e "$PEND" ] && [ "$(awk -F'\t' '{print $5}' "$LOG" | tr '\n' ' ')" = "refused queued sent " ] \
  && grep -q "^[^	]*	$T1	waiting	st-sess	refused	sandbox\$" "$LOG" \
  && ok "16 the next run outside the sandbox moves the refusal into the log first, then its own lines" || bad "16 fold" "rc=$RC pend=$(cat "$PEND" 2>&1) log=$(cat "$LOG" 2>&1)"
run done "d"
[ "$(grep -c refused "$LOG")" -eq 1 ] && ok "16 a run after that adds no second copy" || bad "16 fold once" "$(cat "$LOG")"
arm sbx-keep
mkdir -p "$(dirname "$PEND")"; printf 'x\tt\tdone\ts\trefused\tsandbox\n' >"$PEND"
PJ_PING_LOG="$ROOT/a-file/p.log" run done "d"
[ "$RC" -eq 1 ] && grep -q 'refused	sandbox$' "$PEND" && ok "16 log not writable outside the sandbox: the pending line stays for later" || bad "16 keep" "rc=$RC pend=$(cat "$PEND" 2>&1)"
arm sbx-none
SANDBOX_RUNTIME=1 PJ_PING_LOG="$ROOT/a-file/p.log" ENGAGE_PING_PENDING="$ROOT/a-file/r.log" run done "d"
[ "$RC" -eq 3 ] && [ "$(ncalls)" -eq 0 ] && grep -q 'could not be logged' <<<"$ERR" \
  && ok "16 neither writable: still refused, exit 3, and stderr says it could not be logged" || bad "16 none" "rc=$RC err=$ERR"

printf 'engage-ping-selftest: %d passed, %d failed\n' "$PASS" "$FAIL"
[ "$FAIL" -eq 0 ]
