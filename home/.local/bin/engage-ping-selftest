run alarm "a"; r2=$RC; e2=$ERR
[ "$r1$r2" = "22" ] && printf '%s%s' "$e1" "$e2" | grep -q -- '--you' && [ "$(ncalls)" -eq 0 ] \
  && ok "13 waiting and alarm without --you exit 2, naming --you, nothing sent" || bad "13 --you required" "rc=$r1$r2 err=$e1 $e2"
run waiting "w" --action "do y"
