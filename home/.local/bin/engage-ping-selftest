#!/usr/bin/env bash
# engage-ping-selftest -- proves every arm of engage-ping with FAKE afplay, imsg, curl and
# engage-go. It never calls the real ones: every arm pins PJ_PING_AFPLAY, PJ_PING_IMSG,
# ENGAGE_PING_CURL and ENGAGE_TRAP_GO to fakes (or to a missing path), the fakes are also
# first on PATH, and the session files, the ntfy setting and the clock are fixtures. So no
# arm sends a message, plays a sound, reaches a gateway or writes engage's mousetrap log.
#
# THE CLAIM UNDER TEST (wean B13, goal 16; Gavin's plan ENGAGE-PING.html, e-conductor Q28 (v2)):
# one message, sent once, in labelled lines (what happened, what it means, what Gavin can do,
# the time), with no id; each kind on its own routes (sounds, iMessage, ntfy), the sounds started
# in the background so nothing waits for them (Q89); a refused or
# switched-off ntfy send goes by iMessage instead; the log holds the time, never the text.
# The pj-ping and pj-ping-selftest stubs that forwarded to it, and their section 14 here, were
# retired on 22 Oct 2026 (Gavin, dotfiles-main Q5: 1): no call for two days.
#
# Every "nothing happened" arm is twinned with an arm in the same harness that hears a call.
#
# PJ_PING_TOOL=<path> tests another copy (an absolute path: the suite changes folder).
# Exit: 0 all passed | 1 a case failed | 2 could not run (invalid trial).

# Read this whole file before running any of it, so an edit saved mid-run cannot change
# the run (W-20260923-A57). A crash under it exits 127 (unbound var) or 1 (bash 3.2 syntax
# error); `selftest-whole-read --help` has the map. Do not move or reword these lines.
[ -n "${SELFTEST_WHOLE_READ-}" ] || SELFTEST_WHOLE_READ=1 exec "$BASH" -c 'shopt -u sourcepath; . "$0"' "$0" "$@"
unset SELFTEST_WHOLE_READ

set -uo pipefail

TOOL="${PJ_PING_TOOL:-$(dirname "$0")/engage-ping}"
[ -x "$TOOL" ] || { printf 'selftest: cannot find engage-ping at %s\n' "$TOOL" >&2; exit 2; }
TOOL="$(builtin cd "$(dirname "$TOOL")" && pwd -P)/$(basename "$TOOL")"
# The shipped setting: home/.config/engage-ping/ntfy.conf, two folders up from home/.local/bin.
SHIPPED="$(dirname "$0")/../../.config/engage-ping/ntfy.conf"
ROOT="$(mktemp -d "${TMPDIR:-/tmp}/engage-ping-selftest.XXXXXX")" || {
  printf 'selftest: mktemp failed -- INVALID TRIAL, not a pass\n' >&2; exit 2; }
ROOT="$(builtin cd "$ROOT" && pwd -P)"
FAKE="$ROOT/bin"; mkdir -p "$FAKE" "$ROOT/conf" "$ROOT/sessions" "$ROOT/elsewhere"
# The session file's folder is a fixture repo, st-proj; the calls run from $ROOT/elsewhere,
# a plain folder, so a text that says st-proj proves the project came from the session file.
mkdir -p "$ROOT/st-proj" "$ROOT/other-proj" && git -C "$ROOT/st-proj" init -q 2>/dev/null \
  && git -C "$ROOT/other-proj" init -q 2>/dev/null && builtin cd "$ROOT/elsewhere" || {
  printf 'selftest: could not set up the fixture repos -- INVALID TRIAL, not a pass\n' >&2; exit 2; }
printf 'engage-ping-selftest -- testing %s in %s\n' "$TOOL" "$ROOT"

PASS=0; FAIL=0
ok() { PASS=$((PASS + 1)); printf '  ok   %s\n' "$1"; }
bad() { FAIL=$((FAIL + 1)); printf '  FAIL %s\n       got: %s\n' "$1" "$(printf '%s' "$2" | tr '\n' '|' | cut -c1-700)"; }
now() { perl -MTime::HiRes=time -e 'printf "%.3f", time'; }

# Fakes write one line per call: "<hi-res epoch> <tool> <payload>", newlines shown as \n.
# afplay sleeps $ENGAGE_PING_FAKE_SLEEP (default 0); imsg exits $PJ_PING_FAKE_IMSG_RC;
# curl prints $ENGAGE_PING_FAKE_HTTP (default 204) as the HTTP code and logs the URL, each
# -H header and the body; engage-go writes its arguments to $ENGAGE_PING_FAKE_TRAP.
cat >"$FAKE/afplay" <<'EOF'
#!/bin/bash
printf '%s afplay %s\n' "$(perl -MTime::HiRes=time -e 'printf "%.3f", time')" "${1##*/}" >>"$PJ_PING_FAKE_LOG"
sleep "${ENGAGE_PING_FAKE_SLEEP:-0}"
EOF
cat >"$FAKE/imsg" <<'EOF'
#!/bin/bash
printf '%s imsg %s\n' "$(perl -MTime::HiRes=time -e 'printf "%.3f", time')" "$(perl -e '$_ = shift; s/\n/\\n/g; print' "$*")" >>"$PJ_PING_FAKE_LOG"
exit "${PJ_PING_FAKE_IMSG_RC:-0}"
EOF
cat >"$FAKE/curl" <<'EOF'
#!/bin/bash
url="" hs="" body="" stdin=0
while [ $# -gt 0 ]; do
  case "$1" in
    -H) hs="$hs H[${2:-}]"; shift 2 || set -- ;;
    --data-binary|-d|--data) if [ "${2:-}" = "@-" ]; then stdin=1; else body="${2:-}"; fi; shift 2 || set -- ;;
    -o|-w|--max-time|-X) shift 2 || set -- ;;
    -*) shift ;;
    *) url="$1"; shift ;;
  esac
done
[ "$stdin" -eq 1 ] && body="$(cat; printf x)" && body="${body%x}"
printf '%s curl %s%s B[%s]\n' "$(perl -MTime::HiRes=time -e 'printf "%.3f", time')" "$url" "$hs" "$(perl -e '$_ = shift; s/\n/\\n/g; print' "$body")" >>"$PJ_PING_FAKE_LOG"
printf '%s' "${ENGAGE_PING_FAKE_HTTP:-204}"
EOF
cat >"$FAKE/engage-go" <<'EOF'
#!/bin/bash
printf '%s\n' "$*" >>"$ENGAGE_PING_FAKE_TRAP"
EOF
chmod +x "$FAKE/afplay" "$FAKE/imsg" "$FAKE/curl" "$FAKE/engage-go"

# Fixture session files: 4242.json is the session by CLAUDE_PID; other.json is found only by
# its sessionId. Each names a cwd in a fixture repo.
printf '{"pid":4242,"sessionId":"sess-uuid-1","cwd":"%s","name":"st-sess"}\n' "$ROOT/st-proj" >"$ROOT/sessions/4242.json"
printf '{"pid":5151,"sessionId":"sess-uuid-2","cwd":"%s","name":"st-other"}\n' "$ROOT/other-proj" >"$ROOT/sessions/other.json"
# Fixture settings. The gateway is written with a trailing / on purpose (arm 6).
GW="http://gw.invalid:1"
printf '# fixture\non: yes\ngateway: %s/\n' "$GW" >"$ROOT/conf/on.conf"
printf 'on: no\ngateway: %s\n' "$GW" >"$ROOT/conf/off.conf"
printf 'on: yes\n' >"$ROOT/conf/on-nogw.conf"
printf '# fixture gateway.local\ngateway: %s\n' "$GW" >"$ROOT/conf/gateway.local"

# The clock: 22:56:56 UTC 18 Oct 2026 is 9:56:56 AM 19 Oct in Melbourne (AEDT, +11).
NOW1=1792364216; T1="9:56:56 AM 19 Oct"
# 03:04:05 UTC 5 Oct 2026 is 2:04:05 PM 5 Oct: no leading zero on the hour or the day.
NOW2=1791169445; T2="2:04:05 PM 5 Oct"

export PATH="$FAKE:$PATH" PJ_PING_AFPLAY="$FAKE/afplay" PJ_PING_IMSG="$FAKE/imsg" ENGAGE_PING_CURL="$FAKE/curl"
export ENGAGE_TRAP_GO="$FAKE/engage-go" ENGAGE_PING_FAKE_TRAP="$ROOT/trap.log"
export IMSG_TO="selftest@example.invalid" ENGAGE_PING_SESSIONS="$ROOT/sessions"
# This suite may run inside a session or a worker: every name it could pick up is pinned here.
# SANDBOX_RUNTIME too: inside the Bash sandbox it is 1, and every arm but section 16's would
# then be refused (#3640).
unset PJ_NO_PING PJ_PING_LOG PJ_PING_FAKE_IMSG_RC PJ_LAUNCHED_BY CLAUDE_CODE_SESSION_NAME PJ_SESSION_NAME \
  ENGAGE_PING_FAKE_HTTP ENGAGE_PING_FAKE_SLEEP HERDR_PANE_ID PJ_PING_BIN ENGAGE_PING_BIN SANDBOX_RUNTIME

# arm <name>: fresh state, logs and the default pins for one arm.
arm() {
  export PJ_PING_STATE_DIR="$ROOT/state-$1" PJ_PING_FAKE_LOG="$ROOT/fake-$1.log"
  export ENGAGE_PING_NTFY_CONF="$ROOT/conf/on.conf" ENGAGE_PING_GATEWAY_CONF="$ROOT/conf/no-such-file"
  export ENGAGE_PING_NOW="$NOW1" CLAUDE_PID=4242 CLAUDE_CODE_SESSION_ID=sess-uuid-1
  export ENGAGE_PING_PENDING="$ROOT/pending-$1/refused.log"
  unset ENGAGE_PING_FAKE_HTTP PJ_PING_FAKE_IMSG_RC
  LOG="$PJ_PING_STATE_DIR/ping.log"; PEND="$ENGAGE_PING_PENDING"
  : >"$PJ_PING_FAKE_LOG"
}
# settle: the sounds play in the background (Q89), so wait until the fake log stops growing
# (0.3 s with no new line, at most 6 s; 0.15 s until B13 part 1b, widened for a loaded Mac)
# before an arm reads it.
settle() {
  local i=0 prev=-1 n
  while :; do
    n=$(wc -l <"$PJ_PING_FAKE_LOG" 2>/dev/null | tr -d ' ')
    [ "$n" = "$prev" ] && break
    prev=$n; sleep 0.3; i=$((i + 1)); [ $i -gt 20 ] && break
  done
}
# run <args...>: sets OUT (stdout), ERR (stderr), RC and the elapsed time in T, then settles
run() {
  local t0; t0=$(now)
  OUT="$("$TOOL" "$@" 2>"$ROOT/err")"; RC=$?
  ERR="$(cat "$ROOT/err")"
  T=$(perl -e "printf '%.3f', $(now) - $t0")
  settle
}
wait_lines() { # wait_lines <file> <n>: up to 8 s
  local i=0
  while [ "$(wc -l <"$1" 2>/dev/null | tr -d ' ')" -lt "$2" ] && [ $i -lt 80 ]; do sleep 0.1; i=$((i + 1)); done
}
# the tools: every sound first, then the other calls in the order they were made. The sounds
# run in the background (Q89), so where they fall among the others is not fixed.
calls() { { awk '$2 == "afplay" {print $2}' "$PJ_PING_FAKE_LOG"; awk '$2 != "afplay" {print $2}' "$PJ_PING_FAKE_LOG"; } | tr '\n' ' '; }
ncalls() { wc -l <"$PJ_PING_FAKE_LOG" | tr -d ' '; }
nof() { awk -v t="$1" '$2 == t' "$PJ_PING_FAKE_LOG" | wc -l | tr -d ' '; }  # nof <tool>
nth() { awk -v t="$1" -v n="$2" '$2 == t { c++; if (c == n) { sub(/^[^ ]+ [^ ]+ /, ""); print; exit } }' "$PJ_PING_FAKE_LOG"; }
sounds() { awk '$2 == "afplay" {print $3}' "$PJ_PING_FAKE_LOG" | tr '\n' ' '; }

Q=$'\xe2\x9d\x93'; OKI=$'\xe2\x9c\x85'; WI=$'\xe2\x8f\xb3'; TI=$'\xf0\x9f\xa7\xaa'
OR=$'\xf0\x9f\x9f\xa0'; RD=$'\xf0\x9f\x94\xb4'; ROBOT=$'\xf0\x9f\xa4\x96'; DOT=$'\xc2\xb7'
WHERE="st-proj $DOT st-sess"
NL='\n'   # what the fakes write for a newline

# ---- 1. One text, sent once ----------------------------------------------------------
arm one
run question "Pick a delivery route"
[ "$(calls)" = "afplay afplay afplay afplay imsg imsg curl " ] && [ "$RC" -eq 0 ] \
  && ok "1 a question: 4 sounds started, its imsg twice (B13 part 1b), then 1 curl" || bad "1 one text, once" "rc=$RC calls=$(calls) err=$ERR"

# ---- 2. The text, for each kind -------------------------------------------------------
# Gavin, dotfiles-main 22 Oct 2026 (Q7 (v5), Q8: 3, Q10: 2, Q11: 1): the title is the project,
# the icon and the summary; the lines under it are labelled; the session and the time come
# last; nothing is said twice.
arm lines
run question "Pick a delivery route"
want="st-proj $Q Pick a delivery route${NL}Do: answer the question box.${NL}Session: st-sess${NL}Time: $T1"
[ "$(nth imsg 1)" = "$want" ] && ok "2 question: project first, the default Do line, the session and time last" || bad "2 question text" "$(nth imsg 1)"
arm lines2
run question "Pick a delivery route" --detail "Two routes; B is faster." --ref Q26
want="st-proj $Q Pick a delivery route${NL}Ask: Two routes; B is faster.${NL}Do: answer the question box.${NL}Ref: Q26${NL}Session: st-sess${NL}Time: $T1"
[ "$(nth imsg 1)" = "$want" ] && ok "2 a question's --detail is its Ask line; --ref is a Ref line when opened" || bad "2 ref and detail" "$(nth imsg 1)"
arm lines3
run waiting "Blocked on sudo" --you "run the sudo step in the dotfiles tab"
want="st-proj $WI Blocked on sudo${NL}Do: run the sudo step in the dotfiles tab${NL}Session: st-sess${NL}Time: $T1"
[ "$(nth imsg 1)" = "$want" ] && ok "2 waiting: the hourglass, its --you as the Do line" || bad "2 waiting text" "$(nth imsg 1)"
arm lines4
run waiting "Q26 is open" --decision --you "answer Q26"
case "$(nth imsg 1)" in "st-proj $Q Q26 is open${NL}"*) ok "2 waiting --decision: the question mark" ;; *) bad "2 decision title" "$(nth imsg 1)" ;; esac
arm lines5
run alarm "The relay stopped" --you "look at mlbox"
case "$(nth imsg 1)" in "st-proj $OR The relay stopped${NL}"*) ok "2 alarm: the orange dot" ;; *) bad "2 alarm title" "$(nth imsg 1)" ;; esac
arm lines6
run alarm "The relay stopped" --stopped --you "look at mlbox"
case "$(nth imsg 1)" in "st-proj $RD The relay stopped${NL}"*) ok "2 alarm --stopped: the red dot" ;; *) bad "2 stopped title" "$(nth imsg 1)" ;; esac
arm lines7
run test "Ping route"
want="st-proj $TI Ping route${NL}Do: tell st-sess when you see it.${NL}Session: st-sess${NL}Time: $T1"
[ "$(nth imsg 1)" = "$want" ] && ok "2 test: its default Do line names the session" || bad "2 test text" "$(nth imsg 1)"
arm lines8
run done "Built B13"
want="$GW/unsorted H[X-Title: st-proj $OKI Built B13] H[X-Priority: 2] B[Session: st-sess${NL}Time: $T1]"
[ "$(nth curl 1)" = "$want" ] && ok "2 done, by ntfy: the title in X-Title, no Do line, the body under it" || bad "2 done text" "$(nth curl 1)"
arm lines9
ENGAGE_PING_NOW="$NOW2" run question "Afternoon"
case "$(nth imsg 1)" in *"${NL}Time: $T2") ok "2 the time is 12-hour Melbourne, no leading zeros ($T2)" ;; *) bad "2 afternoon time" "$(nth imsg 1)" ;; esac
arm lines10
run question "Pick" --detail "d" --ref Q1
t=$(nth curl 1 | perl -ne 'print $1 if /H\[X-Title: (.*?)\]/'); b=$(nth curl 1 | perl -ne 'print $1 if /B\[(.*)\]$/')
[ -n "$t" ] && [ "$(nth imsg 1)" = "$t${NL}$b" ] && ok "2 the iMessage is the ntfy title, a newline, then the ntfy body" || bad "2 imsg and ntfy differ" "imsg=$(nth imsg 1) title=$t body=$b"

# ---- 2b. The labelled lines, the opened part and Next ---------------------------------
arm full
run done "engage-ping fixed" --line "Was: a" --line "Now: b" --line "Proof: c" --more "Told: d" --more "Record: e" --next "the wean check" --held "nothing"
want="st-proj $OKI engage-ping fixed${NL}Was: a${NL}Now: b${NL}Proof: c${NL}Told: d${NL}Record: e${NL}Session: st-sess${NL}Time: $T1${NL}${NL}Next: the wean check${NL}Held up: nothing"
[ "$RC" -eq 0 ] && [ "$(nth curl 1)" = "$GW/unsorted H[X-Title: st-proj $OKI engage-ping fixed] H[X-Priority: 2] B[${want#*"${NL}"}]" ] \
  && ok "2b 3 --line, 2 --more, the session and time, a blank line, then Next and Held up last" || bad "2b full layout" "rc=$RC $(nth curl 1)"
arm order
run waiting "w" --you "x" --detail "d" --line "L: 1"
case "$(nth imsg 1)" in "st-proj $WI w${NL}L: 1${NL}Note: d${NL}Do: x${NL}Session: "*) ok "2b order: each --line, then --detail as Note, then --you as Do" ;; *) bad "2b order" "$(nth imsg 1)" ;; esac
arm overflow
run waiting "w" --line "A: 1" --line "B: 2" --line "C: 3" --you "x"
case "$(nth imsg 1)" in "st-proj $WI w${NL}A: 1${NL}B: 2${NL}C: 3${NL}Do: x${NL}Session: st-sess${NL}"*) ok "2b a 4th preview line goes first in the opened part, not lost" ;; *) bad "2b overflow" "$(nth imsg 1)" ;; esac
grep -q '4 preview lines' <<<"$ERR" && ok "2b ... and stderr says only 3 show" || bad "2b overflow note" "err=$ERR"
arm heldonly
run done "d" --held "the push"
case "$(nth curl 1)" in *"B[Session: st-sess${NL}Time: $T1${NL}${NL}Held up: the push]") ok "2b --held alone: the blank line, then Held up" ;; *) bad "2b held only" "$(nth curl 1)" ;; esac
arm nonext
run done "d" --line "A: 1" --more "B: 2"
c=$(nth curl 1)
case "$c" in *"${NL}${NL}"*) bad "2b a blank line with no Next or Held up" "$c" ;; *"B[A: 1${NL}B: 2${NL}Session: st-sess${NL}Time: $T1]") ok "2b control: no --next or --held, no blank line" ;; *) bad "2b no-next body" "$c" ;; esac
arm linebad
run done "d" --line "A" --line "B" --line "C" --line "D"; r1=$RC
run done "d" $(for i in 1 2 3 4 5 6 7 8 9; do printf -- '--more m%s ' "$i"; done); r2=$RC
run done "d" --line "   "; r3=$RC
run done "d" --next ""; r4=$RC
run done "d" --line; r5=$RC
run done "d" --held $'\t'; r6=$RC
run done "d" --more " "; r7=$RC
[ "$r1$r2$r3$r4$r5$r6$r7" = "2222222" ] && [ "$(ncalls)" -eq 0 ] \
  && ok "2b 4 --line, 9 --more, a blank --line, --next, --held or --more, or a missing value: exit 2, nothing sent" || bad "2b bad lines" "rc=$r1$r2$r3$r4$r5$r6$r7 calls=$(ncalls)"
arm linemax
run done "d" --line "A: 1" --line "B: 2" --line "C: 3" $(for i in 1 2 3 4 5 6 7 8; do printf -- '--more m%s ' "$i"; done)
[ "$RC" -eq 0 ] && [ "$(nof curl)" -eq 1 ] && ok "2b control: 3 --line and 8 --more are sent" || bad "2b max lines" "rc=$RC err=$ERR"
arm lineclean
run done "d" --line $'Was:\033[2J a\nb '"ghp_$(printf 'A%.0s' $(seq 36))" --next $'x\ny'
case "$(nth curl 1)" in *"B[Was: [2J a b [redacted]${NL}"*"${NL}Next: x y]") ok "2b --line and --next are cleaned: no control character, no newline, no token" ;; *) bad "2b line cleaning" "$(nth curl 1)" ;; esac

# ---- 2c. Notes when a message does not fit the lock screen: still sent -----------------
arm fit
run done "a summary far too long for the title"
[ "$RC" -eq 0 ] && [ "$(nof curl)" -eq 1 ] && grep -q 'the title is 47 characters wide' <<<"$ERR" \
  && ok "2c a 47-character title: sent, exit 0, and stderr names its width" || bad "2c long title" "rc=$RC err=$ERR"
arm fit2
run done "short" --line "A: $(printf 'x%.0s' $(seq 38))" --line "B: $(printf 'x%.0s' $(seq 37))"
grep -q 'preview line 1 is 41 characters' <<<"$ERR" && ! grep -q 'preview line 2' <<<"$ERR" \
  && ok "2c a 41-character preview line gets a note; a 40-character one does not" || bad "2c line width" "err=$ERR"
arm fit3
run done "engage-ping fixed" --line "Was: sandbox runs failed, no log."
[ -z "$ERR" ] && ok "2c control: a message that fits prints nothing on stderr" || bad "2c fits" "err=$ERR"
arm fit4
run done "$(printf '\xc3\xa9%.0s' $(seq 14))"
[ -z "$ERR" ] && ok "2c the width counts characters, not bytes: 14 accented letters fit" || bad "2c bytes" "err=$ERR"

# ---- 3. No id anywhere; stdout is the time ---------------------------------------------
arm noid
run test "No codes"
[ "$OUT" = "$T1" ] && ok "3 stdout is the time ($OUT)" || bad "3 stdout" "out=$OUT"
case "$(cat "$PJ_PING_FAKE_LOG")$OUT" in *'#'*) bad "3 a # reached a text, a header or stdout" "$(cat "$PJ_PING_FAKE_LOG")" ;; *) ok "3 no # id in any text, header or stdout" ;; esac

# ---- 4. The routing table -------------------------------------------------------------
route() { # route <label> <want sounds> <want imsg count> <want priority> <args...>
  local label="$1" ws="$2" wi="$3" wp="$4"; shift 4 || return 2
  arm "route-$label"
  run "$@"
  local p; p=$(nth curl 1 | perl -ne 'print $1 if /H\[X-Priority: (\d)\]/')
  if [ "$RC" -eq 0 ] && [ "$(sounds)" = "$ws" ] && [ "$(nof imsg)" = "$wi" ] && [ "$p" = "$wp" ]; then
    ok "4 $label: sounds '$ws', $wi imsg, ntfy priority $wp"
  else bad "4 $label routes" "rc=$RC sounds=$(sounds) imsg=$(nof imsg) prio=$p err=$ERR"; fi
}
route question "Ping.aiff Glass.aiff Glass.aiff Glass.aiff " 2 4 question "q"
route waiting  "Ping.aiff Glass.aiff Glass.aiff Glass.aiff " 2 4 waiting "w" --you "x"
route decision "Ping.aiff Glass.aiff Glass.aiff Glass.aiff " 2 4 waiting "w" --decision --you "x"
route alarm    "Ping.aiff Glass.aiff Glass.aiff Glass.aiff " 2 4 alarm "a" --you "x"
route stopped  "Ping.aiff Glass.aiff Glass.aiff Glass.aiff " 2 5 alarm "a" --stopped --you "x"
route done     "Ping.aiff " 0 2 done "d"
route test     "Ping.aiff " 2 1 test "t"

# ---- 5. The test's ntfy form ----------------------------------------------------------
arm robot
run test "Ping route"
want="$GW/unsorted H[X-Title: $ROBOT AGENT $DOT engage-ping self-test] H[X-Priority: 1] H[X-Tags: robot] B[test, ignore${NL}$WHERE${NL}$T1]"
[ "$(nth curl 1)" = "$want" ] && ok "5 a test posts the robot form: title, priority 1, robot tag, test, ignore" || bad "5 robot form" "$(nth curl 1)"
: >"$ROOT/real-calls"
for k in "question q" "done d" "waiting w --you x" "alarm a --you x"; do
  arm robot-ctl; run $k; nth curl 1 >>"$ROOT/real-calls"
done
if [ "$(wc -l <"$ROOT/real-calls" | tr -d ' ')" -eq 4 ] && ! grep -q -e "$ROBOT" -e 'X-Tags' "$ROOT/real-calls"; then
  ok "5 control: 4 real kinds posted, none with the robot or an X-Tags header"
else bad "5 real kinds carry the robot" "$(cat "$ROOT/real-calls")"; fi

# ---- 6. The topic ---------------------------------------------------------------------
arm topic
run done "d" --topic agents
case "$(nth curl 1)" in "$GW/agents "*) ok "6 --topic agents posts to <gateway>/agents (the trailing / stripped)" ;; *) bad "6 topic agents" "$(nth curl 1)" ;; esac
arm topic2
run done "d"
case "$(nth curl 1)" in "$GW/unsorted "*) ok "6 no --topic posts to <gateway>/unsorted" ;; *) bad "6 default topic" "$(nth curl 1)" ;; esac
arm topic3
printf 'on: yes\ngateway: %s\n' "$GW" >"$ROOT/conf/on-noslash.conf"
ENGAGE_PING_NTFY_CONF="$ROOT/conf/on-noslash.conf" run done "d" --topic agents
case "$(nth curl 1)" in "$GW/agents "*) ok "6 a gateway with no trailing / posts to the same URL" ;; *) bad "6 no slash" "$(nth curl 1)" ;; esac
arm topic4
run done "d" --topic "a/b"; r1=$RC
run done "d" --topic "a b"; r2=$RC
run done "d" --topic "$(printf 'a%.0s' $(seq 33))"; r3=$RC
run done "d" --topic "$(printf 'a%.0s' $(seq 32))"; r4=$RC
[ "$r1$r2$r3" = "222" ] && [ "$r4" -eq 0 ] && [ "$(nof curl)" -eq 1 ] \
  && ok "6 a bad topic (a/b, a space, 33 characters) exits 2 with nothing sent; 32 characters posts (control)" \
  || bad "6 bad topics" "rc=$r1$r2$r3 32-char rc=$r4 curls=$(nof curl)"

# ---- 7. A refused send ----------------------------------------------------------------
for code in 403 502 000; do
  arm "refused-$code"
  ENGAGE_PING_FAKE_HTTP="$code" run done "Built B13"
  if [ "$RC" -eq 0 ] && [ "$(calls)" = "afplay curl imsg imsg " ] && [ "$(nth imsg 1)" = "st-proj $OKI Built B13${NL}Session: st-sess${NL}Time: $T1" ] \
     && grep -q "ntfy=unsorted:$code fallback=imsg:0,0" "$LOG"; then
    ok "7 ntfy answers $code: a done goes by imsg instead, twice, logged fallback=imsg:0,0"
  else bad "7 refused $code" "rc=$RC calls=$(calls) log=$(cat "$LOG" 2>/dev/null)"; fi
done
arm refused-q
ENGAGE_PING_FAKE_HTTP=403 run question "q"
[ "$(nof imsg)" -eq 2 ] && ! grep -q fallback "$LOG" && ok "7 a question refused with 403 sends only its own two imsg, no fallback" || bad "7 question fallback" "imsg=$(nof imsg) $(cat "$LOG")"
arm refused-ok
run done "d"
[ "$(nof imsg)" -eq 0 ] && grep -q 'ntfy=unsorted:204$' "$LOG" && ok "7 control: 204 sends no fallback" || bad "7 204 control" "imsg=$(nof imsg) $(cat "$LOG")"
arm nocurl
ENGAGE_PING_CURL="$ROOT/no-such-curl" run done "d"
if [ "$RC" -eq 1 ] && [ "$(calls)" = "afplay imsg imsg " ] && grep -q 'curl missing' "$LOG" && printf '%s' "$ERR" | grep -q 'curl missing'; then
  ok "7 curl missing counts as refused: the imsg instead (twice), named in the log and on stderr, exit 1"
else bad "7 curl missing" "rc=$RC calls=$(calls) err=$ERR log=$(cat "$LOG" 2>/dev/null)"; fi

# ---- 8. The setting off ---------------------------------------------------------------
offcase() { # offcase <label> <env assignments...>
  local label="$1"; shift
  arm "off-$label"
  env "$@" "$TOOL" done "d" >/dev/null 2>&1; settle
  env "$@" "$TOOL" question "q" >/dev/null 2>&1; settle
  if [ "$(nof curl)" -eq 0 ] && [ "$(calls)" = "afplay afplay afplay afplay afplay imsg imsg imsg imsg " ]; then
    ok "8 $label: no curl at all; the done and the question each go by imsg, twice"
  else bad "8 $label" "calls=$(calls)"; fi
}
offcase "on: no" ENGAGE_PING_NTFY_CONF="$ROOT/conf/off.conf"
offcase "no setting file" ENGAGE_PING_NTFY_CONF="$ROOT/conf/no-such-file"
offcase "no gateway line anywhere" ENGAGE_PING_NTFY_CONF="$ROOT/conf/on-nogw.conf"
if [ -f "$SHIPPED" ]; then
  # B13 part 3 (Gavin, 20 Oct 2026): the shipped file says on: yes. Every other arm pins the
  # gateway to a missing file, so the shipped file is tested here with and without one.
  grep -Eqx 'on:[[:space:]]*yes' "$SHIPPED" && ok "8 the shipped ntfy.conf says on: yes" || bad "8 the shipped ntfy.conf is not on" "$(cat "$SHIPPED")"
  arm shipped-on
  ENGAGE_PING_NTFY_CONF="$SHIPPED" ENGAGE_PING_GATEWAY_CONF="$ROOT/conf/gateway.local" run done "d"
  [ "$(nof curl)" -eq 1 ] && [ "$(nof imsg)" -eq 0 ] && ok "8 the shipped file with a gateway: one post, no imsg" || bad "8 shipped file with a gateway" "calls=$(calls)"
  arm shipped-nogw
  ENGAGE_PING_NTFY_CONF="$SHIPPED" ENGAGE_PING_GATEWAY_CONF="$ROOT/conf/no-such-file" run done "d"
  [ "$(nof curl)" -eq 0 ] && [ "$(nof imsg)" -eq 2 ] && ok "8 the shipped file with no gateway stays off: no curl, the imsg twice" || bad "8 shipped file with no gateway" "calls=$(calls)"
  grep -Eq '^[[:space:]]*gateway:' "$SHIPPED" \
    && bad "8 the shipped ntfy.conf holds a gateway: line" "$(cat "$SHIPPED")" || ok "8 the shipped ntfy.conf holds no gateway: line (Q31: the address lives in dot-private)"
else bad "8 INVALID TRIAL: the shipped ntfy.conf is missing" "$SHIPPED"; fi
arm gwlocal
ENGAGE_PING_NTFY_CONF="$ROOT/conf/on-nogw.conf" ENGAGE_PING_GATEWAY_CONF="$ROOT/conf/gateway.local" run done "d"
case "$(nth curl 1)" in "$GW/unsorted "*) ok "8 control: on: yes, the gateway only in gateway.local -> it posts" ;; *) bad "8 gateway.local control" "calls=$(calls)" ;; esac

# ---- 9. The session name and the project ----------------------------------------------
arm sess
run test "t"
case "$(nth imsg 1)" in "st-proj $TI t${NL}"*"${NL}Session: st-sess${NL}"*) ok "9 by CLAUDE_PID's session file; the project from its cwd, not the calling folder" ;; *) bad "9 by pid" "$(nth imsg 1)" ;; esac
arm sess2
CLAUDE_PID=9999 CLAUDE_CODE_SESSION_ID=sess-uuid-2 run test "t"
case "$(nth imsg 1)" in "other-proj $TI t${NL}"*"${NL}Session: st-other${NL}"*) ok "9 no file for CLAUDE_PID: found by sessionId" ;; *) bad "9 by session id" "$(nth imsg 1)" ;; esac
arm sess3
CLAUDE_PID=9999 CLAUDE_CODE_SESSION_ID=nope CLAUDE_CODE_SESSION_NAME=named run test "t"
case "$(nth imsg 1)" in "elsewhere $TI t${NL}Do: tell named when you see it.${NL}Session: named${NL}"*) ok "9 no session file: CLAUDE_CODE_SESSION_NAME, the project from the folder" ;; *) bad "9 by env name" "$(nth imsg 1)" ;; esac
arm sess4
CLAUDE_PID=9999 CLAUDE_CODE_SESSION_ID=nope PJ_SESSION_NAME=pjname run question "q"
case "$(nth imsg 1)" in "elsewhere $Q q${NL}"*"${NL}Session: pjname${NL}"*) ok "9 then PJ_SESSION_NAME" ;; *) bad "9 by PJ_SESSION_NAME" "$(nth imsg 1)" ;; esac
arm sess5
CLAUDE_PID=9999 CLAUDE_CODE_SESSION_ID=nope run question "q"
want="elsewhere $Q q${NL}Do: answer the question box.${NL}Time: $T1"
[ "$(nth imsg 1)" = "$want" ] && ok "9 no name at all: no Session line; the project from the folder" || bad "9 no name" "$(nth imsg 1)"
arm sess6
CLAUDE_PID=9999 CLAUDE_CODE_SESSION_ID=nope run test "t"
case "$(nth imsg 1)" in *"${NL}Do: tell the session when you see it.${NL}"*) ok "9 no name: the plain test default" ;; *) bad "9 test default" "$(nth imsg 1)" ;; esac
mkdir -p "$ROOT/st-proj/.claude" && printf 'session-alias: stp\n' >"$ROOT/st-proj/.claude/pj-homes"
arm sess7
run test "t"
case "$(nth imsg 1)" in "stp $TI t${NL}"*) ok "9 the session's repo's session-alias names the project" ;; *) bad "9 alias" "$(nth imsg 1)" ;; esac
command mv -f "$ROOT/st-proj/.claude/pj-homes" "$ROOT/pj-homes.used"   # moved aside, never deleted

# ---- 10. Cleaning and caps ------------------------------------------------------------
arm clean
tok="ghp_$(printf 'A%.0s' $(seq 36))"
run question $'Hi\033[31mRED\xe2\x80\xaeevil\tx '"$tok" --detail $'line one\nline two\x07 '"$tok" --you $'do\x01 it\nnow' --ref $'Q2\n6'
m=$(nth imsg 1)
if printf '%s' "$m" | perl -CSD -ne 'exit(/[\x00-\x1F\x7F-\x9F\x{202A}-\x{202E}]/ ? 1 : 0)'; then ok "10 no control or bidi character reaches the text"; else bad "10 control chars" "$m"; fi
case "$m" in *ghp_*) bad "10 a token reached the text" "$m" ;; *) ok "10 token shapes become [redacted]" ;; esac
want="st-proj $Q Hi [31mRED evil x [redacted]${NL}Ask: line one line two [redacted]${NL}Do: do it now${NL}Ref: Q2 6${NL}Session: st-sess${NL}Time: $T1"
[ "$m" = "$want" ] && ok "10 a newline inside a part becomes a space: no part adds a line" || bad "10 parts stay on their lines" "$m"
arm caps
run question "$(printf 's%.0s' $(seq 200))" --detail "$(printf 'd%.0s' $(seq 400))" --you "$(printf 'y%.0s' $(seq 300))" --ref "$(printf 'r%.0s' $(seq 50))"
m=$(nth imsg 1)
s=$(printf '%s' "$m" | perl -ne 'print $1 if /^st-proj \S+ (s+)\\n/'); d=$(printf '%s' "$m" | perl -ne 'print $1 if /Ask: (d+)\\n/')
y=$(printf '%s' "$m" | perl -ne 'print $1 if /Do: (y+)\\n/'); r=$(printf '%s' "$m" | perl -ne 'print $1 if /Ref: (r+)\\n/')
[ "${#s}${#d}${#y}${#r}" = "8030016020" ] && ok "10 caps: summary 80, detail 300, you 160, ref 20" || bad "10 caps" "summary ${#s}, detail ${#d}, you ${#y}, ref ${#r}"
cat >"$ROOT/sessions/4242.json" <<EOF
{"pid":4242,"sessionId":"sess-uuid-1","cwd":"$ROOT/st-proj","name":"evil\u001b[2Jsess$(printf 'z%.0s' $(seq 60))"}
EOF
arm clean-sess
run test "t"
w=$(nth imsg 1 | perl -ne 'print $1 if /\\nSession: (.*?)\\n/')
[ "${#w}" -eq 40 ] && ! printf '%s' "$w" | perl -ne 'exit(/[\x00-\x1F]/ ? 0 : 1)' && ok "10 a session name from the file is cleaned and capped at 40" || bad "10 session cleaning" "$(nth imsg 1)"
printf '{"pid":4242,"sessionId":"sess-uuid-1","cwd":"%s","name":"st-sess"}\n' "$ROOT/st-proj" >"$ROOT/sessions/4242.json"

# ---- 11. The log ----------------------------------------------------------------------
arm log
run question "Secret summary words" --detail "secret detail words" --you "secret you words" --ref Q99
iso=$(perl -MPOSIX -e 'print strftime("%Y-%m-%dT%H:%M:%S%z", localtime(shift))' "$NOW1")
q=$(awk -F'\t' '$5 == "queued"' "$LOG"); s=$(awk -F'\t' '$5 == "sent"' "$LOG")
[ "$(wc -l <"$LOG" | tr -d ' ')" -eq 2 ] && [ "$q" = "$iso	$T1	question	st-sess	queued	-" ] \
  && ok "11 two lines; queued: the message's ISO time, its text time, kind, session, nothing missing" || bad "11 queued line" "$(cat "$LOG")"
[ "$s" = "$iso	$T1	question	st-sess	sent	sound=started imsg=0,0 ntfy=unsorted:204" ] \
  && ok "11 sent: the same two times, then the sounds started, imsg and ntfy" || bad "11 sent line" "$(cat "$LOG")"
grep -q -e secret -e Q99 "$LOG" && bad "11 the log carries text" "$(cat "$LOG")" || ok "11 never the summary, detail, you or ref"
arm log-off
ENGAGE_PING_NTFY_CONF="$ROOT/conf/off.conf" run done "d"
grep -q '	sent	sound=started imsg=- ntfy=off fallback=imsg:0,0$' "$LOG" && ok "11 the setting off: ntfy=off, and the imsg that took its place" || bad "11 off line" "$(cat "$LOG")"

# ---- 12. Kept from today --------------------------------------------------------------
arm kill
OUT="$(PJ_NO_PING=1 "$TOOL" question "q" 2>/dev/null)"; RC=$?
sleep 0.5
[ "$RC" -eq 0 ] && [ -z "$OUT" ] && [ "$(ncalls)" -eq 0 ] && [ ! -e "$LOG" ] \
  && ok "12 PJ_NO_PING=1: exit 0, no time, nothing called, nothing logged" || bad "12 kill switch" "rc=$RC out=$OUT calls=$(ncalls)"
arm launched
OUT="$(PJ_LAUNCHED_BY=conductor-x "$TOOL" question "q" 2>/dev/null)"; RC=$?
OUT2="$(PJ_LAUNCHED_BY=conductor-x "$TOOL" done "d" --detach 2>/dev/null)"
sleep 1
[ "$RC" -eq 0 ] && [ -z "$OUT$OUT2" ] && [ "$(ncalls)" -eq 0 ] && [ "$(grep -c 'silent	launched-by=conductor-x' "$LOG" 2>/dev/null)" -eq 2 ] \
  && ok "12 PING-1: PJ_LAUNCHED_BY set -> nothing called, one silent line each, naming the launcher" || bad "12 PING-1" "rc=$RC calls=$(ncalls) log=$(cat "$LOG" 2>/dev/null)"
arm notlaunched
OUT="$(PJ_LAUNCHED_BY= "$TOOL" question "q" 2>/dev/null)"
[ "$(ncalls)" -gt 0 ] && ok "12 control: PJ_LAUNCHED_BY empty -> the message goes out" || bad "12 PING-1 control" "calls=$(ncalls)"
arm detach
ENGAGE_PING_FAKE_SLEEP=0.3 run question "q" --detach
[ "$RC" -eq 0 ] && [ "$OUT" = "$T1" ] && perl -e "exit !($T < 0.6)" \
  && ok "12 --detach prints the time and returns in ${T}s, while 4 sounds take 1.2 s" || bad "12 detach return" "rc=$RC out=$OUT t=$T"
wait_lines "$PJ_PING_FAKE_LOG" 7; wait_lines "$LOG" 2
[ "$(calls)" = "afplay afplay afplay afplay imsg imsg curl " ] && grep -q '	sent	sound=started imsg=0,0 ntfy=unsorted:204$' "$LOG" \
  && ok "12 the detached worker sends everything and logs it" || bad "12 detached worker" "calls=$(calls) log=$(cat "$LOG" 2>/dev/null)"
arm refuse
run nonsense "x"; r1=$RC
run question "   "; r2=$RC
run question "x" --bogus; r3=$RC
run question; r4=$RC
run question "x" --you "  "; r5=$RC
run question "x" --detail; r6=$RC
sleep 0.5
[ "$r1$r2$r3$r4$r5$r6" = "222222" ] && [ "$(ncalls)" -eq 0 ] && [ ! -e "$LOG" ] \
  && ok "12 bad kind, blank summary, unknown option, no summary, blank or missing value -> exit 2, nothing called or logged" \
  || bad "12 refusals" "rcs=$r1$r2$r3$r4$r5$r6 calls=$(ncalls)"
run question "-starts with a dash"
case "$(nth imsg 1)" in "st-proj $Q -starts with a dash${NL}"*) ok "12 control: a summary starting with a dash is a summary" ;; *) bad "12 dash summary" "rc=$RC $(nth imsg 1)" ;; esac
arm noaf
PJ_PING_AFPLAY="$ROOT/missing/afplay" run question "q"
[ "$RC" -eq 1 ] && [ "$(calls)" = "imsg imsg curl " ] && grep -q 'queued	afplay missing;' "$LOG" && ok "12 afplay missing: the rest goes, named, exit 1" || bad "12 afplay missing" "rc=$RC calls=$(calls) $(cat "$LOG")"
arm noim
PJ_PING_IMSG="$ROOT/missing/imsg" run question "q"
[ "$RC" -eq 1 ] && [ "$(calls)" = "afplay afplay afplay afplay curl " ] && grep -q 'queued	imsg missing;' "$LOG" && ok "12 imsg missing: the rest goes, named, exit 1" || bad "12 imsg missing" "rc=$RC calls=$(calls) $(cat "$LOG")"
arm noto
( unset IMSG_TO; "$TOOL" question "q" >/dev/null 2>"$ROOT/err" ); RC=$?; settle
[ "$RC" -eq 1 ] && [ "$(nof imsg)" -eq 0 ] && grep -q 'IMSG_TO unset' "$LOG" && grep -q 'IMSG_TO unset' "$ROOT/err" \
  && ok "12 IMSG_TO unset: no imsg, named in the log and on stderr, exit 1" || bad "12 IMSG_TO" "rc=$RC calls=$(calls) $(cat "$LOG")"
arm imfail
PJ_PING_FAKE_IMSG_RC=3 run question "q"
[ "$RC" -eq 1 ] && grep -q 'sent	sound=started imsg=3,3 ntfy=unsorted:204$' "$LOG" && ok "12 imsg failing: both still tried, exit 1, rc 3,3 logged, ntfy still tried" || bad "12 imsg fail" "rc=$RC $(cat "$LOG")"
FH="$ROOT/b12a-home"; FA="$ROOT/b12a-account"; mkdir -p "$FH" "$FA"
arm statedir
OUT="$(env -u PJ_PING_STATE_DIR -u XDG_STATE_HOME HOME="$FH" ENGAGE_ACCOUNT_ROOT="$FA" "$TOOL" question "default folder" 2>"$ROOT/err")"; RC=$?
[ "$RC" -eq 0 ] && [ -s "$FA/engine-room/pj-state/ping.log" ] && [ ! -e "$FH/.local/state/pj" ] \
  && ok "12 no state variable: ping.log lands in engage's pj-state, nothing under ~/.local/state/pj" || bad "12 state folder" "rc=$RC err=$(cat "$ROOT/err")"
arm logpath
PJ_PING_LOG="$ROOT/elsewhere-log/p.log" run done "d"
grep -q '	done	' "$ROOT/elsewhere-log/p.log" 2>/dev/null && [ ! -e "$LOG" ] && ok "12 PJ_PING_LOG moves the log" || bad "12 PJ_PING_LOG" "$(ls "$ROOT/elsewhere-log" 2>&1)"

# ---- 13. --you, --action, --decision, --stopped ----------------------------------------
