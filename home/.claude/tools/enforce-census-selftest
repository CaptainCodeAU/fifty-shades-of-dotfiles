# A search that only LOCATES, or a flag that is not the search's own. Quiet.
LOCATES = [
    ("m01 rg -n foo file",        "rg -n foo file"),
    ("m02 rg foo",                "rg foo"),
    ("m03 rg -o without a count", "rg -o foo x"),
    ("m04 bash -c script that only locates", "bash -c 'rg foo'"),
    ("m05 zsh -c script that only locates", "zsh -c 'rg foo x'"),
    ("m06 pattern -c after --",   "rg -- -c x"),
    ("m07 grep pattern -c after --", f"{G} -- -c x"),
    ("m08 fd",                    "fd foo"),
