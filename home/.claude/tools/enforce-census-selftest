# The brief's required edge cases (D-20260925-A02). A search that COUNTS or LISTS fires.
COUNTS_OR_LISTS = [
    ("n01 rg -c",                 "rg -c foo x"),
    ("n02 grep -c",               f"{G} -c foo x"),
    ("n03 git grep -c",           f"git {G} -c foo"),
    ("n04 rg -l",                 "rg -l foo"),
    ("n05 rg --count-matches",    "rg --count-matches foo x"),
    ("n06 rg piped into wc -l",   "rg foo | wc -l"),
    ("n07 grep -rl",              f"{G} -rl foo ."),
    # -q FIRES, by choice: `grep -q foo || echo absent` is a yes/no whose "no" is an
