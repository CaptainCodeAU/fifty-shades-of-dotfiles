LOCATE_FORMS = [
    ("q01 plain grep",            f"{G} -rn foo ."),
    ("q02 git grep",              f"git {G} foo"),
    ("q03 piped grep",            f"ls | {G} foo"),
    ("q04 absolute path",         f"/usr/bin/{G} foo x.txt"),
    ("q05 under xargs",           f"xargs {G} foo"),
    ("q06 under sudo",            f"sudo {G} foo /etc/hosts"),
    ("q07 egrep",                 f"e{G} -i foo x"),
    ("q08 zgrep",                 f"z{G} foo x.gz"),
    ("q09 ugrep",                 f"u{G} -w foo ."),
    ("q10 pcregrep",              f"pcre{G} foo x"),
    ("q11 after &&",              f"ls && {G} foo ."),
    ("q13 after ;",               f"cat a.txt ; ls ; {G} foo b.txt"),
    ("q14 grep on line 3",        f"cat a.txt\nls -la\n{G} foo b.txt"),
    ("q16 rg absolute path",      "/usr/bin/rg foo ."),
    ("q17 rg on line 3",          "cat a.txt\nls -la\nrg foo b.txt"),
    ("q18 search on a heredoc line", f"{G} foo <<EOF\nbody text\nEOF"),
    ("q19 herestring",            'rg foo <<< "some text"'),
