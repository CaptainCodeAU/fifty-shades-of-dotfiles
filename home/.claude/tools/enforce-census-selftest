# Commands where NO SEARCH RUNS. A reminder here is noise, and noise is how the
# reminder stops being read at all -- the hook's own stated reason for existing.
MUST_BE_SILENT = [
    ("s01 prose in dquotes",      f'echo "the word tele{G} as prose only"'),
    ("s02 prose in squotes",      f"echo 'ls | {G} foo'"),
    ("s03 after a comment",       f"cat CHANGELOG.md # mentions {G}"),
    ("s04 directory NAME",        f"mkdir {G}-vs-census-decision"),
    ("s05 FILENAME",              f"touch notes-about-{G}.md"),
    ("s06 quoted -c argument",    f'bash -c "echo {G}"'),
    ("s07 no word boundary",      f"ls {G}per.txt"),
    ("s08 rg prose in dquotes",   'echo "the large rg thing"'),
    ("s09 rg prose in squotes",   "echo 'rg is only inside single quotes'"),
    ("s10 rg after a comment",    "cat CHANGELOG.md # mentions rg"),
    ("s11 no search word at all", 'echo "no search word here at all"'),
    ("s12 merge is not rg",       "git merge --no-ff feature/large-target"),
    # The commit that fixed the grep branch fired the reminder on ITSELF: written with
    # `git commit -F - <<EOF`, its message body carried a line starting "rg survived
    # that because...", and a newline is a command start. A heredoc body is data.
    ("s13 rg at heredoc line start",
     "git commit -F - <<'EOF'\nrg survived that because its anchor rejects it\nEOF"),
    ("s14 grep at heredoc line start",
     f"git commit -F - <<'EOF'\n{G} is mentioned at line start here\nEOF"),
    ("s15 unquoted heredoc tag",   "cat <<EOF\nrg here in the body\nEOF"),
    ("s16 dash heredoc, indented terminator",
     f"cat <<-END\n\t{G} here in the body\n\tEND"),
    ("s17 find -execdir with no grep at all",
     "find . -name '*.txt' -execdir echo {} \\;"),
]


def main():
    hook = HOOK
    argv = sys.argv[1:]
    if argv and argv[0] == "--hook":
        if len(argv) < 2:
            print(f"{RED}--hook needs a path{OFF}", file=sys.stderr)
            return 2
        hook = Path(argv[1]).expanduser().resolve()

    if not hook.is_file():
        print(f"{RED}✗ hook not found: {hook}{OFF}", file=sys.stderr)
        return 2
    if not shutil.which("jq"):
        print(f"{RED}✗ jq is not on PATH; the hook cannot read a payload without it{OFF}",
              file=sys.stderr)
        return 2

    print(f"{DIM}hook: {hook}{OFF}")
    print(f"{DIM}run by: {' '.join(interpreter(hook))} (its shebang, as settings.json runs it){OFF}\n")

    tmp = Path(tempfile.mkdtemp(prefix="enforce-census-selftest-"))
    try:
        # ── harness control: the suite must prove it can observe anything at all ────
        ok_fire, name, _ = bash(hook, tmp, f"{G} -rc NEEDLE .")
        ok_quiet, _, _ = bash(hook, tmp, "echo hello world")
        if not ok_fire or ok_quiet:
            print(f"{RED}✗ HARNESS CONTROL FAILED -- no checks were run.{OFF}")
            print(f"  a counting `{G} -rc` fired: {ok_fire} (must be True)")
            print(f"  a plain `echo` fired:    {ok_quiet} (must be False)")
            print(f"{YELLOW}  A green board from here would be meaningless. Likely causes: the hook\n"
                  f"  crashed, jq is broken, or a project-level grep-census-reminder.sh stood it\n"
                  f"  down. Fix the instrument before trusting any result from it.{OFF}")
            return 2
        print(f"{DIM}harness control ok -- a counting search fires (named \"{name}\"), "
              f"an echo does not{OFF}\n")

        print("MUST FIRE (a search really runs and counts; silence here is a missed reminder)")
        for label, cmd in MUST_FIRE:
            did, name, _ = bash(hook, tmp, cmd)
            check(label, did, "stayed silent on a real counting search")

        print("\nLOCATE FORMS OF THE SAME CASES (fired before D-20260925-A02; quiet now)")
        for label, cmd in LOCATE_FORMS:
            did, name, _ = bash(hook, tmp, cmd)
            check(label, not did, f'fired as "{name}" on a plain locate')

        print("\nCOUNTS OR LISTS (the brief's edge cases; must fire)")
        for label, cmd in COUNTS_OR_LISTS:
            did, name, _ = bash(hook, tmp, cmd)
            check(label, did, "stayed silent on a count or a list")

        print("\nLOCATES, OR A FLAG THAT IS NOT THE SEARCH'S OWN (must be quiet)")
        for label, cmd in LOCATES:
            did, name, _ = bash(hook, tmp, cmd)
            check(label, not did, f'fired as "{name}"')

        print("\nMUST BE SILENT (no search runs; a reminder here is wallpaper)")
        for label, cmd in MUST_BE_SILENT:
            did, name, _ = bash(hook, tmp, cmd)
            check(label, not did, f'fired as "{name}" with no search in the command')

        print("\nBRANCHES BESIDE THE COMMAND TEST")
        did, name, _ = fired(hook, tmp, {"tool_name": "Grep", "tool_input": {"pattern": "foo"}})
        check("b01 built-in Grep tool fires without a .command",
              did and name == "Grep-tool search", f'named "{name}"')

        did, _, _ = bash(hook, tmp, "uv run python3 $HOME/.claude/tools/census.py --control x foo")
        check("b02 stands down while census is already running", not did,
              "reminded a session that was already corroborating")

        did, name, _ = bash(hook, tmp, f"u{G} -wc foo .")
        check("b03 names the binary that actually ran", did and name == f"u{G}",
              f'named "{name}"')

        did, name, _ = bash(hook, tmp, "rg -c foo x")
        check("b04 rg is named ripgrep, not grep", did and name == "ripgrep",
              f'named "{name}"')

        # ── the stripper that was dead code, asserted directly ─────────────────────
        did, _, _ = bash(hook, tmp, f"echo 'a' ; echo 'ls | {G} -c b'")
        check("b05 single-quoted spans are really removed", not did,
              "the single-quote stripper is doing nothing again")

        # ── the Grep tool: its default output_mode LISTS files, `count` counts ──────
        for label, mode, want in (
            ("g01 Grep tool output_mode count fires", "count", True),
            ("g02 Grep tool output_mode files_with_matches fires", "files_with_matches", True),
            ("g03 Grep tool output_mode content is quiet", "content", False),
        ):
            did, _, _ = fired(hook, tmp, {"tool_name": "Grep",
                                          "tool_input": {"pattern": "foo", "output_mode": mode}})
            check(label, did == want, f"fired={did}")

        # ── STAND-DOWNS, each against a control that fires in the same setting ─────
        # b02 above has no search in it at all, so it passes whether or not the census
        # stand-down works. p01 puts a real count beside census.
        did_c, _, _ = bash(hook, tmp, "rg -c foo x")
        did, _, _ = bash(hook, tmp,
                         "rg -c foo x && uv run python3 $HOME/.claude/tools/census.py --control x foo")
        check("p01 census stand-down holds with a counting rg beside it",
              did_c and not did, f"control fired={did_c}, with census fired={did}")

        proj_on = tmp / "proj-with-own-reminder"
        (proj_on / ".claude" / "hooks").mkdir(parents=True)
        (proj_on / ".claude" / "hooks" / "grep-census-reminder.sh").write_text("# stub\n")
        proj_off = tmp / "proj-without"
        proj_off.mkdir()
        did_c, _, _ = bash(hook, tmp, "rg -c foo x", project_dir=proj_off)
        did, _, _ = bash(hook, tmp, "rg -c foo x", project_dir=proj_on)
        check("p02 project-level stand-down holds (control project fires)",
              did_c and not did, f"control fired={did_c}, own-reminder project fired={did}")

        # ── the WORDING: unit and case (Gavin, 2026-09-25: print both counts) ──────
        _, _, out = bash(hook, tmp, "rg -c foo x")
        text = note(out)
        check("t01 reminder names the trigger", "(-c)" in text, text.splitlines()[:1])
        check("t02 reminder says census counts OCCURRENCES, not lines",
              "OCCURRENCES" in text and "LINES" in text, "unit missing")
        check("t03 reminder says census ignores case and shows the case-sensitive count",
              "ignores case by default" in text and "case-sensitive count" in text,
              "case behaviour missing")

        # ── the SHIFTED CONTROL (A48 item 6, Gavin 2026-09-25: option A) ───────────
        # `census.py --control $CTL T1 T2` with CTL empty: zsh drops the word, T1 becomes the
        # control and census answers exit 0. Census cannot see it (argv is byte-identical to a
        # legitimate call); this hook sees the TYPED text, so it warns here.
        C = "uv run python3 $HOME/.claude/tools/census.py"
        for label, cmd, want in (
            ("c01 unquoted --control $VAR warns", f"{C} --control $CTL foo", True),
            ("c02 unquoted --control ${VAR} warns", f"{C} --control ${{CTL}} foo", True),
            ("c03 warns on a later line of a multi-line command",
             f"cd /tmp\n{C} --under home --control $CTL foo", True),
            ("c04 double-quoted \"$VAR\" is safe (census refuses an empty control)",
             f'{C} --control "$CTL" foo', False),
            ("c05 single-quoted '$VAR' is a literal, quiet", f"{C} --control '$CTL' foo", False),
            ("c06 --control=$VAR is safe (empty becomes --control=, refused)",
             f"{C} --control=$CTL foo", False),
            ("c07 a literal control is quiet", f"{C} --control stow foo", False),
            ("c08 another tool's --control $VAR is not census's", "mytool --control $CTL foo",
             False),
        ):
            did, _, out = bash(hook, tmp, cmd)
            check(label, did == want, f"fired={did}")
        _, _, out = bash(hook, tmp, f"{C} --control $CTL foo")
        text = note(out)
        check("c09 the warning names the accident and the fix",
              "unquoted" in text.lower() and '"$' in text and "becomes the control" in text,
              text.splitlines()[:1])

        # ── an UNREADABLE payload (W-20260924-A76, D-20260925-A03) ─────────────────
        # Truncated JSON or a moved command key read as an empty command, and an empty
        # command exited 0: silence, the failure this hook shouts about for a missing jq.
        # Now the same shout, when the raw text mentions a search. Advisory throughout:
        # exit 0 and no permissionDecision in every arm.
        def raw(text, path=None):
            env = dict(os.environ)
            env.pop("CLAUDE_PROJECT_DIR", None)
            if path is not None:
                env["PATH"] = path
            p = subprocess.run(interpreter(hook) + [str(hook)], input=text,
                               capture_output=True, text=True, cwd=str(tmp), env=env)
            return p.returncode, p.stdout.strip()

        def broken(rc, out):
            return rc == 0 and "permissionDecision" not in out and \
                note(out).startswith("🔴 THE CENSUS REMINDER IS BROKEN")

        def bash_payload(cmd):
            return json.dumps({"tool_name": "Bash", "tool_input": {"command": cmd}})

        def moved(cmd):
            return json.dumps({"tool_name": "Bash", "tool_input": {"cmd": cmd}})

        # A PATH with the plain tools and no jq, checked, so the no-jq arms cannot pass
        # by testing a PATH that still holds one.
        nojq = tmp / "nojq-bin"
        nojq.mkdir()
        for t in ("cat", "sed", "awk", "git"):
            w = shutil.which(t)
            if w:
                (nojq / t).symlink_to(w)
        check("u00 the no-jq PATH really holds no jq", not (nojq / "jq").exists()
              and shutil.which("jq", path=str(nojq)) is None, "a jq is reachable")

        for label, text, path, want in (
            ("u01 truncated JSON, a counting grep: shouts", bash_payload(f"{G} -c foo x")[:-5], None, True),
            ("u02 truncated JSON, an rg: shouts", bash_payload("rg -l foo .")[:-5], None, True),
            ("u03 truncated JSON, no search: quiet", bash_payload("ls -la /tmp")[:-5], None, False),
            ("u04 truncated, rg on line 2 (a JSON newline escape): shouts",
             bash_payload("ls\nrg -c foo x")[:-5], None, True),
            ("u05 truncated, rg only inside words (large, argv): quiet",
             bash_payload("echo large argv target")[:-5], None, False),
            ("u06 command under a moved key, a grep: shouts", moved(f"{G} -c foo x"), None, True),
            ("u07 command under a moved key, no search: quiet", moved("ls -la"), None, False),
            ("u08 PATH without jq, a grep: shouts (unchanged)", bash_payload(f"{G} -c foo x"), str(nojq), True),
            # Kept on purpose: the missing-jq shout has always been unconditional. A lost jq
            # breaks the reminder in every project, so it says so on every call.
            ("u09 PATH without jq, no search: shouts too (unchanged, deliberate)",
             bash_payload("ls -la"), str(nojq), True),
        ):
            rc, out = raw(text, path)
            got = broken(rc, out)
            silent = rc == 0 and out == ""
            check(label, got if want else silent, f"rc={rc} out={out[:160]!r}")

        # The moved-key branch must not mistake the Grep tool (no command, by design) for drift.
        did, name, out = fired(hook, tmp, {"tool_name": "Grep", "tool_input": {"pattern": "foo"}})
        check("u10 a readable Grep-tool payload gets the normal reminder, not the broken one",
              did and name == "Grep-tool search" and "IS BROKEN" not in out, f'named "{name}"')
        did, name, out = bash(hook, tmp, f"{G} -c foo x")
        check("u11 a readable counting grep gets the normal reminder, not the broken one",
              did and "IS BROKEN" not in out and "permissionDecision" not in out, out[:160])

        # ── the interpreter: the suite runs what settings.json runs ────────────────
        check("h01 hook is run by its shebang interpreter",
              interpreter(hook)[0].startswith("/"), f"ran {interpreter(hook)}")
    finally:
        shutil.rmtree(tmp, ignore_errors=True)

    print()
    if failures:
        print(f"{RED}✗ {len(failures)} of {checks} check(s) FAILED:{OFF} " + ", ".join(failures))
        return 1
    print(f"{GREEN}✓ all {checks} checks passed{OFF} {DIM}-- the reminder fires on every "
          f"search that counts or lists, and on nothing else{OFF}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
