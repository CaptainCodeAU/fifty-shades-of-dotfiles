#!/usr/bin/env python3
r"""enforce-census-selftest -- prove the census reminder fires on searches and ONLY on searches.

Sibling of census-selftest. That one guards the tool; this one guards the hook that
points at the tool. Every check is a REGRESSION TEST for a defect that was live in
enforce-census.sh and was measured, not imagined.

WHY THIS FILE EXISTS AT ALL. The `grep` branch shipped for months as a bare substring
test against the RAW command -- `case "$cmd" in *grep*)`. It fired on prose, on
comments, on directory names and on filenames, while the `rg` branch beside it had a
command-position guard the whole time. Nothing caught it because nothing tested it;
the rg guard was verified by hand at the moment it was written and never again. A
truth table run once is not a test. This is the test.

    1  prose     grep inside a double-quoted string fired the reminder
    2  squote    grep inside a single-quoted string fired it
    3  comment   grep after a `#` fired it
    4  dirname   `mkdir grep-vs-census-decision` fired it -- no search ran
    5  filename  `touch notes-about-grep.md` fired it -- no search ran
    6  quotedarg `bash -c "echo grep"` fired it
    7  substring `ls grepper.txt` fired it -- no word boundary anywhere
    8  stripper  the single-quote stripper was dead code and removed nothing
    9  naming    every member of the family announced itself as plain "grep"

THE HARNESS PROVES ITSELF FIRST. Before any assertion runs, two positive controls check
that the hook can be invoked at all: a plain `grep -rn` MUST fire and a plain `echo`
MUST stay silent. Without them a hook that crashed, or one silenced by a project-level
stand-down, reports a full green board of "silent" passes -- which is the precise shape
of the failure this whole toolkit exists to prevent.

The stand-down is the live danger, not a hypothetical: enforce-census.sh exits 0 when
the repo root holds .claude/hooks/grep-census-reminder.sh. Run this suite from inside
such a project and every silent-case would pass for the wrong reason. So the hook is
always invoked from a temp directory that is not a git repo, with CLAUDE_PROJECT_DIR
unset, and the controls catch it anyway if that ever stops being enough.

    uv run python3 ~/.claude/tools/enforce-census-selftest
    uv run python3 ~/.claude/tools/enforce-census-selftest --hook /path/to/old/copy

The second form is how the suite was proven able to FAIL. Measured 2026-09-04:

    against the fixed enforce-census.sh    34 checks, 0 failures
    against the pre-fix copy                9 failures, each naming its defect

A suite that has only ever been green is an unproven instrument, in exactly the way a
grep that has only ever returned zero is. Both halves were run before this was committed.
"""

import json
import os
import shutil
import subprocess
import sys
import tempfile
from pathlib import Path

HOOK = Path.home() / ".claude" / "hooks" / "enforce-census.sh"

GREEN, RED, YELLOW, DIM, OFF = "\033[0;32m", "\033[1;31m", "\033[0;33m", "\033[2m", "\033[0m"
if not sys.stdout.isatty() or os.environ.get("NO_COLOR"):
    GREEN = RED = YELLOW = DIM = OFF = ""

failures = []

G = "grep"  # assembled nowhere clever on purpose; the cases below must read literally


def fired(hook, cwd, payload):
    """Feed one PreToolUse payload to the hook. Returns (fired?, tool named, stdout)."""
    env = dict(os.environ)
    env.pop("CLAUDE_PROJECT_DIR", None)
    p = subprocess.run(
        ["bash", str(hook)],
        input=json.dumps(payload),
        capture_output=True, text=True, cwd=str(cwd), env=env,
    )
    out = p.stdout.strip()
    if not out:
        return False, "", out
    try:
        note = json.loads(out)["hookSpecificOutput"]["additionalContext"]
    except Exception:
        return True, "<unparseable>", out
    head = note.splitlines()[0] if note else ""
    name = ""
    if head.startswith("⚠️ A ") and " is about to run" in head:
        name = head.split("⚠️ A ", 1)[1].split(" is about to run", 1)[0]
    return True, name, out


def bash(hook, cwd, cmd):
    return fired(hook, cwd, {"tool_name": "Bash", "tool_input": {"command": cmd}})


def check(label, ok, detail=""):
    tag = f"{GREEN}ok  {OFF}" if ok else f"{RED}FAIL{OFF}"
    print(f"  {tag} {label}" + (f" {DIM}-- {detail}{OFF}" if detail and not ok else ""))
    if not ok:
        failures.append(label.split()[0])


# Commands where a search REALLY RUNS. Silence here is a missed reminder.
MUST_FIRE = [
    ("f01 plain grep",            f"{G} -rn foo ."),
    ("f02 git grep",              f"git {G} foo"),
    ("f03 piped grep",            f"ls | {G} foo"),
    ("f04 absolute path",         f"/usr/bin/{G} foo x.txt"),
    ("f05 under xargs",           f"xargs {G} foo"),
    ("f06 under sudo",            f"sudo {G} foo /etc/hosts"),
    ("f07 egrep",                 f"e{G} -i foo x"),
    ("f08 zgrep",                 f"z{G} foo x.gz"),
    ("f09 ugrep",                 f"u{G} -w foo ."),
    ("f10 pcregrep",              f"pcre{G} foo x"),
    ("f11 after &&",              f"ls && {G} foo ."),
    ("f12 in $( )",               f"echo $({G} -c foo x)"),
    ("f13 after ;",               f"cat a.txt ; ls ; {G} foo b.txt"),
    ("f14 grep on line 3",        f"cat a.txt\nls -la\n{G} foo b.txt"),
    ("f15 rg",                    "rg -c foo README.md"),
    ("f16 rg absolute path",      "/usr/bin/rg foo ."),
    ("f17 rg on line 3",          "cat a.txt\nls -la\nrg foo b.txt"),
]

# Commands where NO SEARCH RUNS. A reminder here is noise, and noise is how the
# reminder stops being read at all -- the hook's own stated reason for existing.
MUST_BE_SILENT = [
    ("s01 prose in dquotes",      f'echo "the word tele{G} as prose only"'),
    ("s02 prose in squotes",      f"echo 'ls | {G} foo'"),
    ("s03 after a comment",       f"cat CHANGELOG.md # mentions {G}"),
    ("s04 directory NAME",        f"mkdir {G}-vs-census-decision"),
    ("s05 FILENAME",              f"touch notes-about-{G}.md"),
    ("s06 quoted -c argument",    f'bash -c "echo {G}"'),
    ("s07 no word boundary",      f"ls {G}per.txt"),
    ("s08 rg prose in dquotes",   'echo "the large rg thing"'),
    ("s09 rg prose in squotes",   "echo 'rg is only inside single quotes'"),
    ("s10 rg after a comment",    "cat CHANGELOG.md # mentions rg"),
    ("s11 no search word at all", 'echo "no search word here at all"'),
    ("s12 merge is not rg",       "git merge --no-ff feature/large-target"),
]


def main():
    hook = HOOK
    argv = sys.argv[1:]
    if argv and argv[0] == "--hook":
        if len(argv) < 2:
            print(f"{RED}--hook needs a path{OFF}", file=sys.stderr)
            return 2
        hook = Path(argv[1]).expanduser().resolve()

    if not hook.is_file():
        print(f"{RED}✗ hook not found: {hook}{OFF}", file=sys.stderr)
        return 2
    if not shutil.which("jq"):
        print(f"{RED}✗ jq is not on PATH; the hook cannot read a payload without it{OFF}",
              file=sys.stderr)
        return 2

    print(f"{DIM}hook: {hook}{OFF}\n")

    tmp = Path(tempfile.mkdtemp(prefix="enforce-census-selftest-"))
    try:
        # ── harness control: the suite must prove it can observe anything at all ────
        ok_fire, name, _ = bash(hook, tmp, f"{G} -rn NEEDLE .")
        ok_quiet, _, _ = bash(hook, tmp, "echo hello world")
        if not ok_fire or ok_quiet:
            print(f"{RED}✗ HARNESS CONTROL FAILED -- no checks were run.{OFF}")
            print(f"  a plain `{G} -rn` fired: {ok_fire} (must be True)")
            print(f"  a plain `echo` fired:    {ok_quiet} (must be False)")
            print(f"{YELLOW}  A green board from here would be meaningless. Likely causes: the hook\n"
                  f"  crashed, jq is broken, or a project-level grep-census-reminder.sh stood it\n"
                  f"  down. Fix the instrument before trusting any result from it.{OFF}")
            return 2
        print(f"{DIM}harness control ok -- a real search fires (named \"{name}\"), "
              f"an echo does not{OFF}\n")

        print("MUST FIRE (a search really runs; silence here is a missed reminder)")
        for label, cmd in MUST_FIRE:
            did, name, _ = bash(hook, tmp, cmd)
            check(label, did, "stayed silent on a real search")

        print("\nMUST BE SILENT (no search runs; a reminder here is wallpaper)")
        for label, cmd in MUST_BE_SILENT:
            did, name, _ = bash(hook, tmp, cmd)
            check(label, not did, f'fired as "{name}" with no search in the command')

        print("\nBRANCHES BESIDE THE COMMAND TEST")
        did, name, _ = fired(hook, tmp, {"tool_name": "Grep", "tool_input": {"pattern": "foo"}})
        check("b01 built-in Grep tool fires without a .command",
              did and name == "Grep-tool search", f'named "{name}"')

        did, _, _ = bash(hook, tmp, "uv run python3 $HOME/.claude/tools/census.py --control x foo")
        check("b02 stands down while census is already running", not did,
              "reminded a session that was already corroborating")

        did, name, _ = bash(hook, tmp, f"u{G} -w foo .")
        check("b03 names the binary that actually ran", did and name == f"u{G}",
              f'named "{name}"')

        did, name, _ = bash(hook, tmp, "rg -c foo x")
        check("b04 rg is named ripgrep, not grep", did and name == "ripgrep",
              f'named "{name}"')

        # ── the stripper that was dead code, asserted directly ─────────────────────
        did, _, _ = bash(hook, tmp, f"echo 'a' ; echo 'ls | {G} b'")
        check("b05 single-quoted spans are really removed", not did,
              "the single-quote stripper is doing nothing again")
    finally:
        shutil.rmtree(tmp, ignore_errors=True)

    print()
    if failures:
        print(f"{RED}✗ {len(failures)} check(s) FAILED:{OFF} " + ", ".join(failures))
        return 1
    print(f"{GREEN}✓ all checks passed{OFF} {DIM}-- the reminder fires on every search "
          f"and on nothing else{OFF}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
