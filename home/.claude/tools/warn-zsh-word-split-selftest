def arms(hook):
    """Every arm as (label, ok, detail). Order is stable; ids are the first word."""
    out = []
    jq_ctx = None
    advisory = []

    def record(rc, raw, parsed):
        advisory.append((rc, raw, parsed))

    for label, cmd, var in MUST_WARN:
        rc, raw, parsed = bash(hook, cmd)
        record(rc, raw, parsed)
        text = note(parsed)
        ok = warns(text) and (var is None or f"${var}" in text)
        out.append((label, ok, text[:140] or "(quiet)"))
        if label.startswith("w01"):
            jq_ctx = text

    for label, cmd in MUST_BE_QUIET:
        rc, raw, parsed = bash(hook, cmd)
        record(rc, raw, parsed)
        out.append((label, raw == "" and rc == 0, note(parsed)[:140] or raw[:140]))

    utf8 = {"LC_ALL": "en_US.UTF-8", "LANG": "en_US.UTF-8"}
    rc, raw, parsed = run(hook, json.dumps({"tool_name": "Bash", "tool_input": {"command":
                          'v="a b"; echo "── $v ── ✓"; ls $v'}}), extra_env=utf8)
    out.append(("u01 multi-byte text in a UTF-8 locale: still read, still warns",
                warns(note(parsed)) and "$v" in note(parsed), raw[:160]))
    rc, raw, parsed = run(hook, json.dumps({"tool_name": "Bash", "tool_input": {"command":
                          'v="a b"; echo "── ✓ ──" "$v"'}}), extra_env=utf8)
    out.append(("u02 multi-byte text, quoted use: quiet", rc == 0 and raw == "", raw[:160]))

    text = jq_ctx or ""
    out.append(("m01 the message names the variable and every fix",
                 all(s in text for s in ("$c", "${=c}", "${(f)c}", '"$c"', "array")), text[:200]))
    out.append(("m02 the message never claims the tool skips .zshrc",
                 bool(text) and ".zshrc" not in text, text[:200]))
    rc, raw, parsed = bash(hook, 'a="x y"; b=$(ls); ls $a $b')
    t = note(parsed)
    out.append(("m03 two variables, both named", "$a" in t and "$b" in t, t[:200]))

    # Payloads the hook cannot read: missing tools, empty, truncated, moved key.
    nojq = fakebin("nojq", ["cat", "awk"])
    noawk = fakebin("noawk", ["cat", "jq"])
    payload = json.dumps({"tool_name": "Bash", "tool_input": {"command": INCIDENT}})
    rc, raw, parsed = run(hook, payload, path=nojq)
    out.append(("p01 jq missing: shouts BROKEN, exit 0", rc == 0 and broken(note(parsed)), raw[:160]))
    rc, raw, parsed = run(hook, payload, path=noawk)
    out.append(("p02 awk missing: shouts BROKEN, exit 0", rc == 0 and broken(note(parsed)), raw[:160]))
    rc, raw, parsed = run(hook, "")
    out.append(("p03 empty payload: quiet, exit 0", rc == 0 and raw == "", raw[:160]))
    rc, raw, parsed = run(hook, payload[: len(payload) // 2])
    out.append(("p04 truncated payload naming a $var: shouts BROKEN", rc == 0 and broken(note(parsed)), raw[:160]))
    rc, raw, parsed = run(hook, '{"tool_name":"Bash","tool_input":{"command":"echo hi')
    out.append(("p05 truncated payload with no $var: quiet", rc == 0 and raw == "", raw[:160]))
    rc, raw, parsed = run(hook, json.dumps({"tool_name": "Bash", "tool_input": {"cmd": INCIDENT}}))
    out.append(("p06 command under a moved key: shouts BROKEN", rc == 0 and broken(note(parsed)), raw[:160]))
    bad = [r for r in advisory if r[0] != 0 or (r[2] and (
        "permissionDecision" in json.dumps(r[2]) or "updatedInput" in json.dumps(r[2])
        or r[2].get("suppressOutput") is not True))]
    out.append(("p07 every answer is advisory: exit 0, no decision, no rewrite, suppressOutput",
                not bad, str(bad[:1])[:200]))
    out.append(("h01 hook is run by its shebang interpreter", interpreter(hook)[0].startswith("/"),
                str(interpreter(hook))))
    return out


