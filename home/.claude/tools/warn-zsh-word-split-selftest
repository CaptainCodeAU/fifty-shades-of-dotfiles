def interpreter(hook):
    first = Path(hook).read_text(errors="replace").splitlines()[:1]
    if first and first[0].startswith("#!"):
        return first[0][2:].split()
    return ["bash"]


def run(hook, stdin, path=None, extra_env=None):
    """Feed raw stdin to the hook. Returns (rc, stdout, parsed-or-None)."""
    env = dict(os.environ)
    if path is not None:
        env["PATH"] = path
    if extra_env:
        env.update(extra_env)
    try:
        p = subprocess.run(interpreter(hook) + [str(hook)], input=stdin, capture_output=True,
                           text=True, cwd=str(TMP), env=env, timeout=20)
    except (OSError, subprocess.TimeoutExpired) as e:   # a hook that cannot run is a red arm
        return 127, f"<did not run: {e}>", None
    out = p.stdout.strip()
    try:
        parsed = json.loads(out) if out else None
    except Exception:
        parsed = {"unparseable": out}
    return p.returncode, out, parsed


def bash(hook, cmd):
    return run(hook, json.dumps({"tool_name": "Bash", "tool_input": {"command": cmd}}))


def note(parsed):
    try:
        return parsed["hookSpecificOutput"]["additionalContext"]
    except Exception:
        return ""


def warns(text):
    return text.startswith("⚠️ zsh word-split:")


def broken(text):
    return "THE ZSH WORD-SPLIT WARNING IS BROKEN" in text


def fakebin(name, tools):
    """A PATH holding only the named tools (symlinked), to take jq or awk away."""
    d = TMP / name
    d.mkdir(exist_ok=True)
    for t in tools:
        src = shutil.which(t)
        if src and not (d / t).exists():
            (d / t).symlink_to(src)
    return str(d)


