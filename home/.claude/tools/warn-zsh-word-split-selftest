def report(results):
    fails = []
    for label, ok, detail in results:
        tag = f"{GREEN}ok  {OFF}" if ok else f"{RED}FAIL{OFF}"
        print(f"  {tag} {label}" + (f" {DIM}-- {detail}{OFF}" if not ok else ""))
        if not ok:
            fails.append(label.split()[0])
    return fails


def controls(hook):
    _, _, parsed = bash(hook, INCIDENT)
    c1 = warns(note(parsed))
    rc, raw, _ = bash(hook, "echo hi")
    c2 = rc == 0 and raw == ""
    print(f"  {'ok  ' if c1 else 'FAIL'} c01 control: the incident warns")
    print(f"  {'ok  ' if c2 else 'FAIL'} c02 control: echo hi is quiet")
    return c1 and c2


def mutants(hook):
    src = Path(hook).read_text()
    base = {label.split()[0]: ok for label, ok, _ in arms(hook)}
    if not all(base.values()):
        print(f"{RED}the unmutated hook fails its own arms; mutants mean nothing until it is green{OFF}")
        return 1
    killed_by = {k: [] for k in base}
    problems = []
    for mid, what, reps in MUTANTS:
        text = src
        for old, new in reps:
            n = text.count(old)
            if n != 1:
                problems.append(f"{mid} anchor found {n} times: {old[:60]!r}")
                break
            text = text.replace(old, new)
        else:
            m = TMP / f"mutant-{mid}.sh"
            m.write_text(text)
            m.chmod(0o755)
            red = [label.split()[0] for label, ok, _ in arms(m) if not ok]
            for k in red:
                killed_by[k].append(mid)
            print(f"  {mid} {what:58s} {RED if red else ''}{len(red):2d} red{OFF} "
                  f"{DIM}{' '.join(red[:8])}{' ...' if len(red) > 8 else ''}{OFF}")
            if not red:
                problems.append(f"{mid} ({what}) survived: no arm caught it")
    for k, ms in killed_by.items():
        if not ms:
            problems.append(f"arm {k} never went red on any mutant: it cannot fail")
    print()
    if problems:
        for p in problems:
            print(f"  {RED}FAIL{OFF} {p}")
        print(f"{RED}✗ {len(problems)} mutant problem(s){OFF}")
        return 1
    print(f"{GREEN}✓ {len(MUTANTS)} mutants each caught; all {len(killed_by)} arms go red on at "
          f"least one{OFF}")
    return 0


def main():
    args = sys.argv[1:]
    hook = HOOK
    if "--hook" in args:
        hook = Path(args[args.index("--hook") + 1]).resolve()
    if not hook.is_file():
        print(f"{RED}no hook at {hook}{OFF}")
        return 2
    try:
        print(f"hook: {hook}\n\nCONTROLS (the harness proves itself first)")
        if not controls(hook):
            print(f"{RED}✗ controls failed: the hook cannot be told apart from a silent one{OFF}")
            return 1
        if "--mutants" in args:
            print("\nMUTANTS (each arm must go red on a broken copy)")
            return mutants(hook)
        print("\nARMS")
        results = arms(hook)
        fails = report(results)
        print()
        if fails:
            print(f"{RED}✗ {len(fails)} of {len(results)} check(s) FAILED:{OFF} " + ", ".join(fails))
            return 1
        print(f"{GREEN}✓ all {len(results)} checks passed{OFF} {DIM}-- it warns on the shapes "
              f"that go wrong in zsh, and on nothing else{OFF}")
        return 0
    finally:
        shutil.rmtree(TMP, ignore_errors=True)


if __name__ == "__main__":
    sys.exit(main())
