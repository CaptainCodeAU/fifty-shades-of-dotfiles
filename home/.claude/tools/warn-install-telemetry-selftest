def interpreter(hook):
    first = Path(hook).read_text(errors="replace").splitlines()[:1]
    if first and first[0].startswith("#!"):
        return first[0][2:].split()
    return ["bash"]


def run(hook, stdin, path=None, extra_env=None):
    """Feed raw stdin to the hook. Returns (rc, stdout, parsed-or-None)."""
    env = dict(os.environ)
    env.pop("CONV_SHSCAN", None)
    if path is not None:
        env["PATH"] = path
    if extra_env:
        env.update(extra_env)
    try:
        p = subprocess.run(interpreter(hook) + [str(hook)], input=stdin, capture_output=True,
                           text=True, cwd=str(TMP), env=env, timeout=20)
    except (OSError, subprocess.TimeoutExpired) as e:   # a hook that cannot run is a red arm
        return 127, f"<did not run: {e}>", None
    out = p.stdout.strip()
    try:
        parsed = json.loads(out) if out else None
    except Exception:
        parsed = {"unparseable": out}
    return p.returncode, out, parsed


def payload(cmd, event="PostToolUse"):
    return json.dumps({"hook_event_name": event, "tool_name": "Bash", "tool_input": {"command": cmd},
                       "tool_response": {"stdout": "", "stderr": "", "interrupted": False}})


def bash(hook, cmd, event="PostToolUse", **kw):
    return run(hook, payload(cmd, event), **kw)


def note(parsed):
    try:
        return parsed["hookSpecificOutput"]["additionalContext"]
    except Exception:
        return ""


def evname(parsed):
    try:
        return parsed["hookSpecificOutput"]["hookEventName"]
    except Exception:
        return ""


def warns(text):
    return text.startswith("⚠️ install telemetry:")


def broken(text):
    return "THE INSTALL TELEMETRY REMINDER IS BROKEN" in text


def fakebin(name, tools):
    """A PATH holding only the named tools (symlinked), to take jq or awk away."""
    d = TMP / name
    d.mkdir(exist_ok=True)
    for t in tools:
        src = shutil.which(t)
        if src and not (d / t).exists():
            (d / t).symlink_to(src)
    return str(d)


def arms(hook):
    """Every arm as (label, ok, detail). Order is stable; ids are the first word."""
    out = []
    advisory = []

    for label, cmd, must, mustnot in MUST_WARN:
        rc, raw, parsed = bash(hook, cmd)
        advisory.append((rc, raw, parsed))
        text = note(parsed)
        ok = warns(text) and all(s in text for s in must) and not any(s in text for s in mustnot)
        out.append((label, ok, text[:160] or raw[:160] or "(quiet)"))

    for label, cmd in MUST_BE_QUIET:
        rc, raw, parsed = bash(hook, cmd)
        advisory.append((rc, raw, parsed))
        out.append((label, raw == "" and rc == 0, note(parsed)[:160] or raw[:160]))

    # The message.
    rc, raw, parsed = bash(hook, "pnpm add -g typescript")
    t = note(parsed)
    out.append(("m01 the message names the tool, says OWN config, read back, and that an env var does not count",
                all(s in t for s in ("typescript (pnpm -g)", "OWN config", "read back", "brew analytics off",
                                     "environment variable alone does not count")), t[:220]))
    out.append(("m02 PostToolUse: answers as PostToolUse, says installed",
                evname(parsed) == "PostToolUse" and "this command installed" in t, raw[:160]))
    rc, raw, parsed = bash(hook, "brew install jq", event="PreToolUse")
    out.append(("m03 PreToolUse payload: answers as PreToolUse, says installs",
                evname(parsed) == "PreToolUse" and "this command installs jq" in note(parsed), raw[:160]))
    rc, raw, parsed = bash(hook, "brew install jq", event="PostToolUseFailure")
    out.append(("m04 PostToolUseFailure payload: answers under that name",
                evname(parsed) == "PostToolUseFailure" and warns(note(parsed)), raw[:160]))
    rc, raw, parsed = bash(hook, "brew install jq; brew install jq")
    out.append(("m05 the same install twice is named once", note(parsed).count("jq (brew)") == 1, note(parsed)[:160]))

    utf8 = {"LC_ALL": "en_US.UTF-8", "LANG": "en_US.UTF-8"}
    rc, raw, parsed = run(hook, payload('echo "── install ✓ ──"; brew install jq'), extra_env=utf8)
    out.append(("u01 multi-byte text in a UTF-8 locale: still read, still warns",
                warns(note(parsed)) and "jq (brew)" in note(parsed), raw[:160]))

    # Payloads and instruments the hook cannot use.
    nojq = fakebin("nojq", ["cat", "awk", "dirname"])
    noawk = fakebin("noawk", ["cat", "jq", "dirname"])
    pl = payload("brew install jq")
    rc, raw, parsed = run(hook, pl, path=nojq)
    out.append(("p01 jq missing: shouts BROKEN, exit 0", rc == 0 and broken(note(parsed)), raw[:160]))
    rc, raw, parsed = run(hook, pl, path=noawk)
    out.append(("p02 awk missing: shouts BROKEN, exit 0", rc == 0 and broken(note(parsed)), raw[:160]))
    rc, raw, parsed = run(hook, "")
    out.append(("p03 empty payload: quiet, exit 0", rc == 0 and raw == "", raw[:160]))
    rc, raw, parsed = run(hook, pl[: pl.index("jq") + 2])
    out.append(("p04 truncated payload naming an install: shouts BROKEN", rc == 0 and broken(note(parsed)), raw[:160]))
    rc, raw, parsed = run(hook, '{"tool_name":"Bash","tool_input":{"command":"echo hi')
    out.append(("p05 truncated payload with no install word: quiet", rc == 0 and raw == "", raw[:160]))
    rc, raw, parsed = run(hook, json.dumps({"tool_name": "Bash", "tool_input": {"cmd": "brew install jq"}}))
    out.append(("p06 command under a moved key: shouts BROKEN", rc == 0 and broken(note(parsed)), raw[:160]))
    rc, raw, parsed = run(hook, pl, extra_env={"CONV_SHSCAN": str(TMP / "no-such-scanner.awk")})
    out.append(("p07 scanner missing: shouts BROKEN", rc == 0 and broken(note(parsed)), raw[:160]))
    badscan = TMP / "bad-scanner.awk"
    badscan.write_text("END { this is not awk (\n")
    rc, raw, parsed = run(hook, pl, extra_env={"CONV_SHSCAN": str(badscan)})
    out.append(("p08 scanner fails: shouts BROKEN", rc == 0 and broken(note(parsed)), raw[:160]))
    oddscan = TMP / "odd-scanner.awk"
    oddscan.write_text('END { print "DENY"; print "conv-shscan: unknown CONV_MODE" }\n')
    rc, raw, parsed = run(hook, pl, extra_env={"CONV_SHSCAN": str(oddscan)})
    out.append(("p10 scanner answers in an unknown form: shouts BROKEN", rc == 0 and broken(note(parsed)), raw[:160]))
    bad = [r for r in advisory if r[0] != 0 or (r[2] and (
        "permissionDecision" in json.dumps(r[2]) or "updatedInput" in json.dumps(r[2])
        or r[2].get("suppressOutput") is not True))]
    out.append(("p09 every answer is advisory: exit 0, no decision, no rewrite, suppressOutput",
                not bad, str(bad[:1])[:200]))
    out.append(("h01 hook is run by its shebang interpreter", interpreter(hook)[0].startswith("/"),
                str(interpreter(hook))))
    return out


