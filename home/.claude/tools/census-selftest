#!/usr/bin/env python3
r"""census-selftest — prove census.py still refuses to answer confidently and wrongly.

Every check here is a REGRESSION TEST for a defect that was live in census.py and was
measured, not imagined. Five were reported by another project's agent; two were found
while re-measuring their report.

    1  colour   ANSI in piped output made `census … | grep '^  name'` return 0
    2  control  a literal control passed while a regex pattern silently returned 0
    3  mode     literal + case-insensitive were never printed
    4  case     311 vs 289 hits for the same word, with nothing saying which ran
    5  hidden   142 ignored files never searched and never mentioned
    6  prefix   `--exclude d` swallowed docs/, dist/ and data/ together
    7  binary   an mp3 was scanned and contributed a hit nobody could triage

THE HARNESS PROVES ITSELF FIRST. Before any assertion runs, a positive control checks
that census can be invoked at all and produces a known non-zero count. Without it a
broken runner reports seven passes, or seven failures, and both are meaningless — the
exact failure census exists to prevent, in the tool that tests census.

    uv run python3 ~/.claude/tools/census-selftest
"""

import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
from pathlib import Path

CENSUS = Path(__file__).resolve().parent / "census.py"
ANSI = re.compile(r"\x1b\[[0-9;]*m")

GREEN, RED, YELLOW, DIM, OFF = "\033[0;32m", "\033[1;31m", "\033[0;33m", "\033[2m", "\033[0m"
if not sys.stdout.isatty() or os.environ.get("NO_COLOR"):
    GREEN = RED = YELLOW = DIM = OFF = ""

failures = []


def run(root, *args, env=None):
    """Invoke census. Returns (returncode, stdout+stderr as written, plain text)."""
    e = dict(os.environ)
    e.pop("NO_COLOR", None)
    if env:
        e.update(env)
    r = subprocess.run(
        [sys.executable, str(CENSUS), "--root", str(root), *args],
        capture_output=True, text=True, env=e,
    )
    raw = r.stdout + r.stderr
    return r.returncode, raw, ANSI.sub("", raw)


def check(name, ok, detail=""):
    if ok:
        print(f"  {GREEN}PASS{OFF}  {name}")
    else:
        print(f"  {RED}FAIL{OFF}  {name}{DIM}{('  — ' + detail) if detail else ''}{OFF}")
        failures.append(name)
    return ok


def corpus(base):
    """A tree with one file of every shape the checks need."""
    for d in ("docs", "dist", "data", "sub"):
        (base / d).mkdir(parents=True, exist_ok=True)
    (base / "docs" / "a.md").write_text("CONTROL NEEDLE and .zshrc here\n")
    (base / "data" / "c.txt").write_text("NEEDLE .zshrc\n")
    (base / "sub" / "d.txt").write_text("CONTROL NEEDLE needle\n")   # casing differs
    (base / "keep.txt").write_text("CONTROL NEEDLE\n")
    # dist/ is in SKIP_DIRS, so walk mode prunes this one. It must still be COUNTED as
    # unsearched — a retired token hiding in build/ is the incident that made this matter.
    (base / "dist" / "pruned.js").write_text("CONTROL NEEDLE\n")
    (base / "blob.bin").write_bytes(b"\x00\x01NEEDLE\x00binary\xff\xfe")
    # A name that exists only as a FILENAME, and a UTF-16 file: both were unsearchable.
    (base / "NEEDLE_named_only.cfg").write_text("CONTROL but not the token itself\n")
    (base / "utf16.txt").write_bytes("CONTROL NEEDLE in utf16\n".encode("utf-16"))
    return base


def jrun(root, *args):
    """census --json. Returns (rc, doc or None, why) so a non-JSON answer FAILS an arm
    instead of raising and taking every later arm down with it."""
    rc, raw, _ = run(root, "--json", *args)
    try:
        return rc, json.loads(raw), ""
    except Exception as e:
        return rc, None, f"rc={rc} not JSON: {e}: {raw[:200]!r}"


def pat(doc, p):
    """The patterns[] entry for `p`, or {} when the run produced none."""
    for r in (doc or {}).get("patterns", []):
        if r.get("pattern") == p:
            return r
    return {}


def binary_dropped(doc):
    """How many files the binary filter dropped, from --json; None when it did not run."""
    for f in ((doc or {}).get("population") or {}).get("filters", []):
        if f.get("flag") == "binary":
            return f.get("files")
    return 0 if doc else None


def a48_fixture(base):
    """The A48 shapes (COMPARISON.md sections 3, 5, 6 and the side check), one file each.

    Every wide-text file is written TWICE where a real tool can make it: once by iconv,
    the encoder the A48 harness used, and once by Python with the BOM stated byte for
    byte, so neither the tool's defaults nor this file's model of them decides the arm.
    Returns (repo, clean, problems): `problems` lists every fixture property that did
    not come out as intended, and each arm that leans on one fails with it named.
    """
    repo, clean = base / "repo", base / "clean"
    outside, outside2 = base / "outside", base / "outside2"
    for d in (repo, clean, outside, outside2):
        d.mkdir(parents=True)
    problems = []

    (repo / "case.txt").write_text("CONTROL DONE done Done\nDONE\nEQUALTOK EQUALTOK\n")
    (repo / "lines.txt").write_text("CONTROL a48occ a48occ a48occ\n")
    (repo / "a48named_only.cfg").write_text("CONTROL but not the token itself\n")

    def u16le(s):
        return s.encode("utf-16-le")
    (repo / "u16le_bom.txt").write_bytes(b"\xff\xfe" + u16le("CONTROL a48u16le\n"))
    (repo / "u32le_bom.txt").write_bytes(
        b"\xff\xfe\x00\x00" + "CONTROL a48u32le\n".encode("utf-32-le"))
    for name, to, tok, want_bom in (
            ("u16_iconv.txt", "UTF-16", "a48u16iconv", True),
            ("u32_iconv.txt", "UTF-32", "a48u32iconv", True),
            ("u16_nobom.txt", "UTF-16LE", "a48nobom", False)):
        try:
            out = subprocess.run(["iconv", "-f", "UTF-8", "-t", to],
                                 input=f"CONTROL {tok}\n".encode(),
                                 capture_output=True, check=True).stdout
        except Exception as e:
            problems.append(f"iconv -t {to} failed: {e}")
            continue
        (repo / name).write_bytes(out)
        has_bom = out[:4] in (b"\xff\xfe\x00\x00", b"\x00\x00\xfe\xff") \
            or out[:2] in (b"\xff\xfe", b"\xfe\xff")
        if has_bom != want_bom:
            problems.append(f"{name}: iconv -t {to} BOM present={has_bom}, wanted {want_bom}")

    # A REAL binary that happens to open with FF FE: this interpreter's own executable,
    # which exists wherever the suite can run. The token is appended as UTF-16LE on an
    # even offset, so a rule that wrongly read the file as UTF-16 would FIND it.
    blob = Path(sys.executable).resolve().read_bytes()[:65536]
    blob = b"\xff\xfe" + blob + (b"\x00" if len(blob) % 2 else b"")
    (repo / "ffbin.bin").write_bytes(blob + u16le(" a48ffbin CONTROL\n"))
    # Each half of the rule in isolation, beside a twin that differs by one code unit:
    #   iso_nul  decodes strictly but holds U+0000       -> only the NUL-char test drops it
    #   iso_sur  holds no U+0000 but a lone low surrogate -> only strict decoding drops it
    #   iso_ok   the same text with neither               -> text, found by default
    (repo / "iso_nul.bin").write_bytes(
        b"\xff\xfe" + u16le("CONTROL a48isonul ") + b"\x00\x00" + u16le("tail\n"))
    (repo / "iso_sur.bin").write_bytes(
        b"\xff\xfe" + u16le("CONTROL a48isosur ") + b"\x00\xdc" + u16le("tail\n"))
    (repo / "iso_ok.txt").write_bytes(b"\xff\xfe" + u16le("CONTROL a48isook tail\n"))
    try:
        s = (repo / "iso_nul.bin").read_bytes()[2:].decode("utf-16-le")
        if "\x00" not in s:
            problems.append("iso_nul.bin: carries no U+0000")
    except UnicodeDecodeError:
        problems.append("iso_nul.bin: does not decode strictly, so it isolates nothing")
    try:
        (repo / "iso_sur.bin").read_bytes()[2:].decode("utf-16-le")
        problems.append("iso_sur.bin: decodes strictly, so it isolates nothing")
    except UnicodeDecodeError:
        pass
    if "\x00" in (repo / "iso_sur.bin").read_bytes()[2:].decode("utf-16-le", "replace"):
        problems.append("iso_sur.bin: carries a U+0000, so it isolates nothing")

    # Links: a tracked symlinked DIRECTORY, an untracked one, and a tracked FILE link.
    (outside / "inner.txt").write_text("CONTROL a48behind\n")
    (outside2 / "x.txt").write_text("CONTROL a48untrackedbehind\n")
    (base / "outfile.txt").write_text("CONTROL a48filelink\n")
    os.symlink("../outside", repo / "linkdir")
    os.symlink("../outfile.txt", repo / "filelink.txt")
    (clean / "only.txt").write_text("CONTROL a48clean\n")
    for d in (repo, clean):
        for cmd in (["init", "-q"], ["add", "-A"]):
            subprocess.run(["git", "-C", str(d), *cmd], check=True, capture_output=True)
    # Created AFTER `git add -A`, so it stays untracked and not ignored.
    os.symlink("../outside2", repo / "untrackedlink")
    return repo, clean, problems


def a48_arms(base, walk_root):
    """Arms 23-28: the census improvements ruled in D-20260925-A02 (A48).

    Each arm is written to FAIL on the census before the ruling (commit 01055a9) and
    pass after it, except those marked `guard`, which pin a property both must keep.
    """
    try:
        repo, clean, problems = a48_fixture(base)
    except Exception as e:
        check("23-28 fixture: the A48 fixture could be built", False,
              f"{e.__class__.__name__}: {e}")
        return
    check("23-28 fixture: every fixture property came out as intended",
          not problems, "; ".join(problems))
    C = ("--control", "CONTROL")

    # ── 23 · case: the exact-case count rides beside the default one ─────────────────
    # A48 section 5: census said 37 for DONE where every other tool said 12 or 14, and
    # nothing on the row said why. Ruled 2026-09-25: keep the default, print both.
    rc, _, plain = run(repo, *C, "DONE", "EQUALTOK")
    m = re.search(r"^\s*DONE\s+(\d+)\s+exact-case\s+(\d+)\s*$", plain, re.M)
    check("23a case: a row shows both counts when they DIFFER (4, exact-case 2)",
          rc == 0 and bool(m) and (m.group(1), m.group(2)) == ("4", "2"),
          f"rc={rc} row={m and m.group(0)!r}")
    m = re.search(r"^\s*EQUALTOK\s+(\d+)\s+exact-case\s+(\d+)\s*$", plain, re.M)
    check("23b case: a row shows both counts when they are EQUAL (2, exact-case 2)",
          bool(m) and (m.group(1), m.group(2)) == ("2", "2"),
          "an equal pair must still print both, or a missing column reads as equal")
    check("23c case: the header says what the second column is",
          "second column: the exact-case count" in plain,
          "a bare second number needs --help to decode")
    check("23d case: a per-file row carries both counts",
          re.search(r"^\s*4 / 2\s+case\.txt\s*$", plain, re.M) is not None)
    check("23e case: the TOTAL row carries both",
          re.search(r"^\s*TOTAL\s+6\s+exact-case\s+4\s", plain, re.M) is not None)
    rc, _, plain = run(repo, "--case-sensitive", *C, "DONE")
    check("23f case (guard): --case-sensitive shows ONE count and no second column",
          rc == 0 and re.search(r"^\s*DONE\s+2\s*$", plain, re.M) is not None
          and "exact-case" not in plain and "second column" not in plain,
          f"rc={rc}")
    rc, d, why = jrun(repo, *C, "DONE", "EQUALTOK")
    p = pat(d, "DONE")
    check("23g case: --json carries total_case_sensitive per pattern, per file, overall",
          d is not None and p.get("total") == 4 and p.get("total_case_sensitive") == 2
          and p.get("files_case_sensitive") == {"case.txt": 2}
          and d.get("total") == 6 and d.get("total_case_sensitive") == 4,
          why or f"pattern={p} total={d.get('total')}/{d.get('total_case_sensitive')}")
    rc, d, why = jrun(repo, "--case-sensitive", *C, "DONE")
    p = pat(d, "DONE")
    check("23h case: --json under --case-sensitive gives one count, second fields null",
          d is not None and p.get("total") == 2 and p.get("total_case_sensitive") is None
          and "total_case_sensitive" in p and p.get("files_case_sensitive") is None
          and d.get("total_case_sensitive") is None and "total_case_sensitive" in d,
          why or f"pattern={p}")

    # ── 24 · the unit is stated: OCCURRENCES, not lines ───────────────────────────────
    rc, _, plain = run(repo, *C, "a48occ")
    check("24a unit: the header says OCCURRENCES, not lines",
          rc == 0 and "unit: OCCURRENCES, not lines" in plain)
    check("24b unit (guard): the stated unit is TRUE - 3 on one line counts 3",
          re.search(r"^\s*a48occ\s+3\s", plain, re.M) is not None,
          "the header would be lying")
    rc, d, why = jrun(repo, *C, "a48occ")
    check("24c unit: --json says unit=occurrences, top level and in matching",
          d is not None and d.get("unit") == "occurrences"
          and d["population"]["matching"].get("unit") == "occurrences", why)
    rc, _, plain = run(repo, "--control", "ABSENT-TOKEN", "a48occ")
    check("24d unit: stated on the CONTROL FAILED path too",
          rc == 2 and "unit: OCCURRENCES" in plain, f"rc={rc}")

    # ── 25 · UTF-16/32 with a BOM is text; everything else with a NUL stays binary ───
    # A48 section 3: rg and ugrep read a BOM'd UTF-16 file by default; census dropped it
    # on the NUL sniff before its decoder, which could read it, ever saw it.
    rc, d, why = jrun(repo, *C, "a48u16le", "a48u16iconv", "a48u32le", "a48u32iconv",
                      "a48nobom", "a48ffbin", "a48isonul", "a48isosur", "a48isook")
    tot = lambda t: pat(d, t).get("total")
    check("25a bom: UTF-16LE with a BOM is found by default (no --binary)",
          tot("a48u16le") == 1, why or f"got {tot('a48u16le')}")
    check("25b bom: iconv's UTF-16 (BOM included) is found by default",
          tot("a48u16iconv") == 1, why or f"got {tot('a48u16iconv')}")
    check("25c bom: UTF-32LE with a BOM is found, not misread as UTF-16",
          tot("a48u32le") == 1, why or f"got {tot('a48u32le')}")
    check("25d bom: iconv's UTF-32 (BOM included) is found by default",
          tot("a48u32iconv") == 1, why or f"got {tot('a48u32iconv')}")
    check("25e bom (guard): UTF-16 WITHOUT a BOM is still not read",
          tot("a48nobom") == 0, why or f"got {tot('a48nobom')}")
    check("25f bom (guard): a real binary opening with FF FE is NOT read as text",
          tot("a48ffbin") == 0, why or f"got {tot('a48ffbin')}")
    check("25g bom (guard): a U+0000 inside BOM'd text keeps it binary",
          tot("a48isonul") == 0, why or f"got {tot('a48isonul')}")
    check("25h bom (guard): a lone surrogate inside BOM'd text keeps it binary",
          tot("a48isosur") == 0, why or f"got {tot('a48isosur')}")
    check("25i bom: the one-unit-different twin of 25g/25h IS text",
          tot("a48isook") == 1, why or f"got {tot('a48isook')}")
    check("25j bom: exactly the 4 non-text files are dropped as binary, no more",
          binary_dropped(d) == 4, f"binary dropped={binary_dropped(d)}")
    # The drop is STATED, per file: --under one file, and the binary line counts it.
    for f in ("u16_nobom.txt", "ffbin.bin"):
        rc, _, plain = run(repo, "--under", f, *C, "a48nobom")
        check(f"25k bom (guard): {f} is dropped AND the drop is printed",
              rc == 2 and "binary (NUL byte in first 8 KB) → 1 file(s) dropped" in plain,
              f"rc={rc}")
    _, _, plain = run(repo, *C, "a48u16le")
    check("25l bom: the text report names the BOM'd file like any other",
          re.search(r"^\s*1 / 1\s+u16le_bom\.txt\s*$", plain, re.M) is not None)

    # ── 26 · git mode names a symlinked DIRECTORY instead of calling it unreadable ────
    # A48 P-git-linked-census: the link was listed by ls-files, failed to open, and was
    # reported as `unreadable (could not be opened) -> 1 file(s) dropped`, unnamed.
    rc, _, plain = run(repo, *C, "a48behind")
    check("26a gitlink: a tracked symlinked directory is NAMED in git mode",
          rc == 0 and "via GIT" in plain and "NOT FOLLOWED: 1 symlinked directory" in plain
          and re.search(r"^\s+linkdir\s*$", plain, re.M) is not None, f"rc={rc}")
    check("26b gitlink: it is no longer reported as unreadable",
          "unreadable" not in plain)
    check("26c gitlink (guard): the tree behind it is still not counted",
          re.search(r"^\s*a48behind\s+0\s", plain, re.M) is not None)
    rc, d, why = jrun(repo, *C, "a48behind")
    check("26d gitlink: --json lists it in git mode (was null)",
          d is not None and d["population"]["unfollowed_symlinked_dirs"] == ["linkdir"],
          why or f"value={d['population'].get('unfollowed_symlinked_dirs')}")
    rc, _, plain = run(clean, *C, "a48clean")
    rc2, d, why = jrun(clean, *C, "a48clean")
    check("26e gitlink: a link-free git repo says so POSITIVELY, text and JSON",
          rc == 0 and "not followed: 0 symlinked directories" in plain
          and d is not None and d["population"]["unfollowed_symlinked_dirs"] == [],
          why or f"rc={rc}")
    rc, d, why = jrun(repo, *C, "a48untrackedbehind")
    ok_default = d is not None and d["population"]["unfollowed_symlinked_dirs"] == ["linkdir"]
    rc, d, why2 = jrun(repo, "--include-ignored", *C, "a48untrackedbehind")
    check("26f gitlink: an UNTRACKED symlinked dir is named under --include-ignored "
          "(and only there)",
          ok_default and d is not None
          and d["population"]["unfollowed_symlinked_dirs"] == ["linkdir", "untrackedlink"],
          why or why2 or f"value={d and d['population'].get('unfollowed_symlinked_dirs')}")
    rc, _, plain = run(repo, "--include-ignored", *C, "a48behind")
    check("26g gitlink: the text names the untracked one too",
          "NOT FOLLOWED: 2 symlinked directories" in plain and "untrackedlink" in plain)
    rc, d, why = jrun(repo, *C, "a48filelink")
    check("26h gitlink (guard): a FILE symlink is still followed in git mode",
          pat(d, "a48filelink").get("total") == 1, why or f"got {pat(d, 'a48filelink')}")
    rc, _, plain = run(repo, "--under", "linkdir", *C, "a48behind")
    check("26i gitlink: --under the link names it, and does not call the filter a typo",
          "--under linkdir → 1 file(s) kept" in plain and "NOT FOLLOWED" in plain
          and "check the spelling" not in plain, f"rc={rc}")
    doc = ""
    try:
        import importlib.util
        spec = importlib.util.spec_from_file_location("census_doc", CENSUS)
        mod = importlib.util.module_from_spec(spec)
        spec.loader.exec_module(mod)
        doc = mod.__doc__ or ""
    except Exception as e:
        doc = f"<not importable: {e}>"
    check("26j gitlink: the docstring no longer says git mode follows every symlink",
          "In GIT mode, symlinks are followed" not in doc
          and "In GIT mode, FILE symlinks are followed" in doc)

    # ── 27 · --json carries the filename-only warning the text prints ─────────────────
    # A48 raw/side-census-fn-text-vs-json.txt: text warned, JSON gave a bare 0.
    rc, d, why = jrun(repo, *C, "a48named_only", "DONE", "a48nowhere")
    check("27a fnjson: a zero whose name sits in a PATH lists that path in --json",
          pat(d, "a48named_only").get("named_in_paths") == ["a48named_only.cfg"],
          why or f"got {pat(d, 'a48named_only')}")
    check("27b fnjson: null when the count was not zero (the check did not run)",
          "named_in_paths" in pat(d, "DONE") and pat(d, "DONE")["named_in_paths"] is None,
          f"got {pat(d, 'DONE')}")
    check("27c fnjson: [] when it ran and no path holds the name",
          pat(d, "a48nowhere").get("named_in_paths") == [],
          f"got {pat(d, 'a48nowhere')}")
    rc, d, why = jrun(repo, "--case-sensitive", *C, "A48NAMED_ONLY")
    check("27d fnjson: the path check honours --case-sensitive in --json too",
          pat(d, "A48NAMED_ONLY").get("named_in_paths") == [],
          why or f"got {pat(d, 'A48NAMED_ONLY')}")
    rc, d, why = jrun(walk_root, "--walk", *C, "NEEDLE_named_only")
    check("27e fnjson: walk mode carries it as well",
          pat(d, "NEEDLE_named_only").get("named_in_paths") == ["NEEDLE_named_only.cfg"],
          why or f"got {pat(d, 'NEEDLE_named_only')}")

    # ── 28 · text and --json agree on EVERY new field, from the same invocation ───────
    args = ("--include-ignored", *C, "DONE", "EQUALTOK", "a48named_only", "a48u16le")
    rc, _, plain = run(repo, *args)
    rc2, d, why = jrun(repo, *args)
    rows = {m.group(1): (int(m.group(2)), int(m.group(3))) for m in re.finditer(
        r"^\s{2}(\S+)\s+(\d+)\s+exact-case\s+(\d+)\s*$", plain, re.M)}
    jrows = {r.get("pattern"): (r.get("total"), r.get("total_case_sensitive"))
             for r in (d or {}).get("patterns", [])}
    check("28a agree: every row's two counts match --json",
          rc == 0 and d is not None and len(jrows) == 4 and rows == jrows,
          why or f"text={rows} json={jrows}")
    m = re.search(r"^\s*TOTAL\s+(\d+)\s+exact-case\s+(\d+)\s", plain, re.M)
    check("28b agree: TOTAL and its exact-case twin match --json",
          bool(m) and d is not None
          and (int(m.group(1)), int(m.group(2))) == (d.get("total"),
                                                     d.get("total_case_sensitive")),
          f"text={m and m.groups()} json={d and (d.get('total'), d.get('total_case_sensitive'))}")
    m = re.search(r"NOT FOLLOWED: \d+ symlinked director(?:y|ies)[^\n]*\n\s+([^\n]+)\n",
                  plain)
    text_links = [s.strip() for s in m.group(1).split(",")] if m else None
    # Pinned to the expected list, not just to each other: the pre-A48 census printed no
    # line (None) and JSON null (None), and None == None passed this arm on that copy.
    check("28c agree: the unfollowed directories match --json",
          d is not None and text_links == ["linkdir", "untrackedlink"]
          and text_links == d["population"]["unfollowed_symlinked_dirs"],
          f"text={text_links} json={d and d['population']['unfollowed_symlinked_dirs']}")
    m = re.search(r"PATH\(S\):\n((?:\s{10}\S[^\n]*\n)+)", plain)
    text_named = [s.strip() for s in m.group(1).splitlines()] if m else None
    check("28d agree: the filename-only paths match --json",
          text_named == pat(d, "a48named_only").get("named_in_paths"),
          f"text={text_named} json={pat(d, 'a48named_only').get('named_in_paths')}")
    check("28e agree: both state the unit",
          "unit: OCCURRENCES" in plain and d is not None and d.get("unit") == "occurrences")


def main() -> int:
    if not CENSUS.is_file():
        print(f"{RED}census.py not found next to this script at {CENSUS}{OFF}")
        return 2

    tmp = Path(tempfile.mkdtemp(prefix="census-selftest-"))
    # Check 21 needs a root containing a symlink, and check 21c needs one containing
    # NONE. They cannot share a tree: the first version nested the link fixture inside
    # the corpus and 21c failed, correctly, because the corpus was no longer link-free.
    # Two roots, so neither arm can contaminate the other.
    tmp_link = Path(tempfile.mkdtemp(prefix="census-selftest-link-"))
    # Arms 23-28 (A48) get their own base too, for the same reason: they add files,
    # links and a git repo that would move counts the older arms assert on.
    tmp_a48 = Path(tempfile.mkdtemp(prefix="census-selftest-a48-"))
    try:
        root = corpus(tmp)
        W = ("--walk", "--control", "CONTROL")

        # ── HARNESS CONTROL — no assertion runs until census is proven callable ──────
        rc, _, plain = run(root, *W, "NEEDLE")
        m = re.search(r"^\s*NEEDLE\s+(\d+)(?:\s+exact-case\s+\d+)?\s*$", plain, re.M)
        if rc != 0 or not m or int(m.group(1)) == 0:
            print(f"{RED}✗ HARNESS CONTROL FAILED — census did not produce a known "
                  f"non-zero count (rc={rc}).{OFF}")
            print(f"  {DIM}No checks were run. A suite that cannot produce a PASS cannot\n"
                  f"  produce a meaningful FAIL either.{OFF}\n{plain}")
            return 2
        print(f"{GREEN}✓ harness{OFF} {DIM}census callable, NEEDLE → {m.group(1)} "
              f"hit(s) — the runner works{OFF}\n")

        # ── 1 · colour never reaches a pipe, and NO_COLOR/--no-color are honoured ────
        # Every check demands rc == 0. "No ANSI" is trivially true of a run that
        # crashed and printed nothing — a version lacking --no-color entirely would
        # otherwise PASS 1c by rejecting the flag.
        rc, raw, _ = run(root, *W, "NEEDLE")
        check("1a colour: no ANSI when stdout is a pipe", rc == 0 and "\x1b[" not in raw)
        rc, raw, _ = run(root, *W, "NEEDLE", env={"NO_COLOR": "1"})
        check("1b colour: NO_COLOR honoured", rc == 0 and "\x1b[" not in raw)
        rc, raw, _ = run(root, "--no-color", *W, "NEEDLE")
        check("1c colour: --no-color accepted and honoured",
              rc == 0 and "\x1b[" not in raw, f"rc={rc}")
        rc, _, plain = run(root, *W, "NEEDLE")
        check("1d colour: a result row survives a naive grep",
              rc == 0 and any(l.startswith("  NEEDLE") for l in plain.splitlines()))

        # ── 2 · a zero caused by literal escaping is called out, not reported clean ──
        _, _, plain = run(root, *W, r"\.zshrc")
        zero = re.search(r"^\s*\\\.zshrc\s+0(?:\s+exact-case\s+\d+)?\s*$", plain, re.M)
        check("2a control: literal-mode zero is flagged, not silent",
              bool(zero) and "literal mode" in plain and "--regex" in plain,
              "a regex pattern returned 0 with no warning")
        _, _, plain = run(root, "--regex", *W, r"\.zshrc")
        m = re.search(r"^\s*\\\.zshrc\s+(\d+)(?:\s+exact-case\s+\d+)?\s*$", plain, re.M)
        check("2b control: --regex finds what literal mode could not",
              bool(m) and int(m.group(1)) == 2, "expected 2 hits for .zshrc")
        _, _, plain = run(root, *W, "NEEDLE")
        check("2c control: a clean run stays quiet about literal mode",
              "literal mode —" not in plain, "the notice fires when it should not")

        # ── 3+4 · both silent defaults are stated on every run ───────────────────────
        _, _, plain = run(root, *W, "NEEDLE")
        check("3 mode: matching mode printed by default",
              "matching: literal, case-insensitive" in plain)
        _, _, plain = run(root, "--regex", "--case-sensitive", *W, "NEEDLE")
        check("4a case: --case-sensitive reflected in the header",
              "matching: regex, case-sensitive" in plain)
        _, _, ins = run(root, *W, "needle")
        _, _, sen = run(root, "--case-sensitive", *W, "needle")
        gi = re.search(r"^\s*needle\s+(\d+)(?:\s+exact-case\s+\d+)?\s*$", ins, re.M)
        gs = re.search(r"^\s*needle\s+(\d+)\s*$", sen, re.M)
        check("4b case: the two modes really do differ",
              bool(gi) and bool(gs) and int(gi.group(1)) > int(gs.group(1)),
              f"insensitive={gi and gi.group(1)} sensitive={gs and gs.group(1)}")

        # ── 5 · git mode names the files it never opened ─────────────────────────────
        git = Path(tempfile.mkdtemp(prefix="census-selftest-git-"))
        try:
            corpus(git)
            (git / ".gitignore").write_text("secret/\n")
            (git / "secret").mkdir()
            (git / "secret" / "hidden.txt").write_text("CONTROL NEEDLE\n")
            for cmd in (["init", "-q"], ["add", "-A"]):
                subprocess.run(["git", "-C", str(git), *cmd], check=True,
                               capture_output=True)
            _, _, plain = run(git, "--control", "CONTROL", "NEEDLE")
            check("5a hidden: git mode reports ignored files it never searched",
                  re.search(r"NOT searched: [1-9]\d* ignored", plain) is not None)
            check("5b hidden: the ignored file is genuinely absent from the count",
                  "secret/hidden.txt" not in plain)
            # 14 · and --include-ignored can actually reach it. Reporting the blind spot
            # was only half a fix; the rename incident needed to SEARCH those files.
            rc, _, plain = run(git, "--include-ignored", "--control", "CONTROL", "NEEDLE")
            check("14a reach: --include-ignored searches the ignored file",
                  rc == 0 and "secret/hidden.txt" in plain,
                  "the ignored file is still unreachable")
            check("14b reach: the header stops claiming those files were NOT searched",
                  "ALSO searched:" in plain and "NOT searched: 1 ignored" not in plain)
            _, _, plain = run(git, "--control", "CONTROL", "NEEDLE")
            check("14c reach: the default run points at the flag",
                  "--include-ignored" in plain, "the blind spot names no way out")

            # 17 · the three scopes PARTITION the repo, so tracked + ignored == all.
            # Asserted as arithmetic rather than prose: if the two searches ever start
            # to overlap or to miss a file between them, this is what notices.
            def pop_and_total(*extra):
                _, _, t = run(git, *extra, "--control", "NEEDLE", "NEEDLE")
                pm = re.search(r"population: (\d+) file", t)
                tm = re.search(r"^\s*TOTAL\s+(\d+)", t, re.M)
                return (int(pm.group(1)) if pm else None,
                        int(tm.group(1)) if tm else None)
            d_pop, d_tot = pop_and_total()
            i_pop, i_tot = pop_and_total("--ignored-only")
            a_pop, a_tot = pop_and_total("--include-ignored")
            check("17a scope: --ignored-only searches a non-empty complement",
                  i_pop is not None and i_pop > 0, f"population={i_pop}")
            check("17b scope: populations add — tracked + ignored == all",
                  None not in (d_pop, i_pop, a_pop) and d_pop + i_pop == a_pop,
                  f"{d_pop} + {i_pop} != {a_pop}")
            check("17c scope: hit counts add too",
                  None not in (d_tot, i_tot, a_tot) and d_tot + i_tot == a_tot,
                  f"{d_tot} + {i_tot} != {a_tot}")
            _, _, plain = run(git, "--ignored-only", "--control", "NEEDLE", "NEEDLE")
            check("17d scope: --ignored-only says the tracked files were NOT searched",
                  "SCOPE: the hidden files ONLY" in plain)
            rc, _, plain = run(git, "--ignored-only", "--include-ignored",
                               "--control", "NEEDLE", "NEEDLE")
            check("17e scope: the two scope flags are mutually exclusive",
                  rc != 0 and "not allowed with" in plain, f"rc={rc}")
        finally:
            shutil.rmtree(git, ignore_errors=True)

        # ── 6 · filters match path boundaries, and their effect is visible ───────────
        _, _, full = run(root, *W, "NEEDLE")
        _, _, part = run(root, "--exclude", "docs", *W, "NEEDLE")
        _, _, typo = run(root, "--exclude", "d", *W, "NEEDLE")
        pop = lambda t: int(re.search(r"population: (\d+) file", t).group(1))
        check("6a prefix: --exclude docs drops exactly docs/",
              pop(part) == pop(full) - 1, f"{pop(full)} → {pop(part)}")
        check("6b prefix: --exclude d does NOT swallow docs/ data/",
              pop(typo) == pop(full), f"{pop(full)} → {pop(typo)}")
        check("6c prefix: a filter matching nothing says so",
              "matched nothing" in typo)
        check("6d prefix: a filter that worked reports its count",
              "--exclude docs → 1 file(s) dropped" in part)

        # ── 7 · binaries are counted out, and named ──────────────────────────────────
        rc, _, plain = run(root, *W, "NEEDLE")
        check("7a binary: binary files excluded by default",
              rc == 0 and "blob.bin" not in plain and "binary" in plain)
        rc, _, plain = run(root, "--binary", *W, "NEEDLE")
        check("7b binary: --binary accepted and puts them back",
              rc == 0 and "blob.bin" in plain, f"rc={rc}")

        # ── 9 · an empty control is refused, not honoured ────────────────────────────
        rc, _, plain = run(root, "--walk", "--control", "", "NEEDLE")
        check("9a empty: --control '' exits 2", rc == 2, f"rc={rc}")
        check("9b empty: no count is printed for an empty control",
              "TOTAL" not in plain and "the instrument works" not in plain)
        # Assert the REASON, not just the exit code: the old census also exited 2 here,
        # by searching for three literal spaces and finding none. Same number, wrong
        # cause — a check that cannot tell those apart is not testing this fix.
        rc, _, plain = run(root, "--walk", "--control", "   ", "NEEDLE")
        check("9c empty: a whitespace-only control is refused AS EMPTY",
              rc == 2 and "is empty" in plain,
              "exited 2 for some other reason (e.g. it searched for spaces and missed)")
        rc, _, _ = run(root, "--walk", "--control", "CONTROL", "")
        check("9d empty: an empty PATTERN exits 2", rc == 2, f"rc={rc}")

        # ── 10 · a control that can match the empty string is refused ───────────────
        for ctl in ("x*", "a?", "^", "(?:)"):
            rc, _, _ = run(root, "--walk", "--regex", "--control", ctl, "NEEDLE")
            check(f"10a zero-width: --regex --control {ctl!r} exits 2", rc == 2, f"rc={rc}")
        rc, _, _ = run(root, "--walk", "--regex", "--control", "CONTR.L", "NEEDLE")
        check("10b zero-width: a real regex control is still accepted", rc == 0, f"rc={rc}")

        # ── 11 · an invalid regex refuses the WHOLE run, printing no numbers ────────
        rc, _, plain = run(root, "--walk", "--regex", "--control", "CONTROL", "NEEDLE", "(")
        check("11a badregex: exits 2", rc == 2, f"rc={rc}")
        # Match the TOTAL *row*, not the word: census's own refusal message contains
        # "no TOTAL under them", and a bare substring test failed on its own prose.
        check("11b badregex: no result row and no TOTAL row is printed",
              not re.search(r"^\s*TOTAL\s+\d", plain, re.M)
              and not re.search(r"^\s*NEEDLE\s+\d", plain, re.M),
              "partial numbers leaked before the refusal")
        check("11c badregex: no traceback", "Traceback" not in plain)
        rc, _, _ = run(root, "--walk", "--regex", "--control", "(", "NEEDLE")
        check("11d badregex: an invalid CONTROL exits 2 too", rc == 2, f"rc={rc}")

        # ── 12 · a FAILED control still shows the population that caused it ─────────
        rc, _, plain = run(root, "--walk", "--control", "ABSENT-TOKEN", "NEEDLE")
        check("12a diagnose: control failure still exits 2", rc == 2, f"rc={rc}")
        check("12b diagnose: the population is printed on the failure path",
              re.search(r"population: \d+ file\(s\) via", plain) is not None,
              "the failure told you nothing about what was searched")
        check("12c diagnose: the matching mode is printed on the failure path",
              "matching: literal" in plain)
        check("12d diagnose: dropped binaries are named on the failure path",
              "binary" in plain, "the binary filter was hidden exactly when it mattered")

        # ── 13 · walk mode counts what SKIP_DIRS cost, it does not merely name them ─
        # corpus() puts NEEDLE in dist/b.js, which walk mode prunes.
        _, _, plain = run(root, "--walk", "--control", "CONTROL", "NEEDLE")
        m = re.search(r"NOT searched: (\d+) file\(s\) inside skipped directories", plain)
        check("13a skipped: walk mode prints a COUNT of pruned files",
              m is not None, "only the directory names were shown")
        check("13b skipped: the count is non-zero when a skipped dir has files",
              bool(m) and int(m.group(1)) >= 1, f"got {m and m.group(1)}")

        # ── 14d · walk mode: --include-ignored descends into SKIP_DIRS ──────────────
        _, _, plain = run(root, "--walk", "--include-ignored", "--control", "CONTROL", "NEEDLE")
        check("14d reach: --include-ignored reaches dist/pruned.js in walk mode",
              "dist/pruned.js" in plain, "SKIP_DIRS still unreachable")

        # ── 15 · a redundant --exclude is not accused of being a typo ───────────────
        _, _, plain = run(root, "--walk", "--control", "CONTROL",
                          "--exclude", "docs", "--exclude", "docs", "NEEDLE")
        check("15a wolf: a repeated --exclude is called redundant, not misspelled",
              "redundant, not a typo" in plain and plain.count("check the spelling") == 0,
              "the second copy cried wolf")
        _, _, plain = run(root, "--walk", "--control", "CONTROL",
                          "--exclude", "nosuchdir", "NEEDLE")
        check("15b wolf: a REAL typo still shouts",
              "check the spelling" in plain, "the warning went missing entirely")

        # ── 16 · every option explains itself, in the place people actually look ────
        # Structural, not per-flag: nine of eleven options once shipped with no help at
        # all. Assert the property so the NEXT flag cannot ship bare either.
        # A missing build_parser() must FAIL, not raise: an exception here would abort
        # the suite and take every later check with it, and an aborted suite reports
        # nothing at all — the silence-as-health failure this whole tool is against.
        bare, why = None, ""
        try:
            import importlib.util
            spec = importlib.util.spec_from_file_location("census_mod", CENSUS)
            mod = importlib.util.module_from_spec(spec)
            spec.loader.exec_module(mod)
            parser = mod.build_parser()
            bare = [a.dest for a in parser._actions
                    if a.dest != "help" and not (a.help or "").strip()]
        except Exception as e:
            why = f"parser not introspectable: {e.__class__.__name__}: {e}"
        check("16a help: every option and positional carries help text",
              bare is not None and not bare, why or f"no help on: {bare}")
        _, _, helptext = run(root, "--help")
        check("16b help: --help carries the control's promise, not just flag names",
              "does NOT prove" in helptext, "the reasoning never reaches --help")
        check("16c help: --help lists what gets refused",
              "refused" in helptext and "empty string" in helptext)

        # ── 18 · --json: machine output, including for every refusal ────────────────
        rc, raw, _ = run(root, "--walk", "--json", "--control", "CONTROL", "NEEDLE")
        try:
            doc = json.loads(raw)
        except Exception as e:
            doc = None
            check("18a json: a successful run emits parseable JSON", False, str(e))
        if doc is not None:
            check("18a json: a successful run emits parseable JSON", rc == 0 and doc["ok"])
            check("18b json: no ANSI ever, even on a tty-less pipe", "\x1b[" not in raw)
            check("18c json: carries the control, the population and the total",
                  doc["control"]["hits"] > 0
                  and doc["population"]["searched"] > 0
                  and "total" in doc)
            check("18d json: the text and the JSON agree on the total",
                  str(doc["total"]) in run(root, "--walk", "--control", "CONTROL",
                                           "NEEDLE")[2])
        # A refusal a script cannot parse sends it back to scraping prose.
        # Full argument lists, not a clever rule for appending PATTERN. The first
        # version guessed, passed no pattern for the empty-control case, and measured
        # argparse's usage error instead of the refusal it meant to test.
        for args, reason in [
            (("--control", "", "NEEDLE"), "empty_control"),
            (("--control", "CONTROL", ""), "empty_pattern"),
            (("--regex", "--control", "x*", "NEEDLE"), "zero_width_control"),
            (("--regex", "--control", "CONTROL", "("), "invalid_regex"),
            (("--control", "ABSENT-TOKEN", "NEEDLE"), "control_failed"),
            (("--control", "CONTROL"), "bad_arguments"),
        ]:
            rc, raw, _ = run(root, "--walk", "--json", *args)
            try:
                d = json.loads(raw)
                ok = rc == 2 and d.get("ok") is False and d.get("refused") == reason
                why = "" if ok else f"rc={rc} doc={d}"
            except Exception as e:
                ok, why = False, f"not JSON: {e}"
            check(f"18e json: refusal {reason} is parseable JSON with exit 2", ok, why)

        # ── 19 · a first-time reader is told the option list exists ─────────────────
        # Measured: a fresh session solved a hidden-file case with census and never ran
        # --help. It learned the one flag it needed from the population line; nothing
        # told it the others were there.
        _, _, plain = run(root, "--walk", "--control", "CONTROL", "NEEDLE")
        check("19a discover: a successful run points at --help",
              "--help" in plain, "no route to the option list")
        _, _, plain = run(root, "--walk", "--control", "ABSENT-TOKEN", "NEEDLE")
        check("19b discover: a refusal points at --help too",
              "--help" in plain, "stuck, with no route to the options")
        rc, raw, _ = run(root, "--walk", "--json", "--control", "CONTROL", "NEEDLE")
        check("19c discover: the pointer never contaminates --json",
              rc == 0 and "--help" not in raw, "prose leaked into the JSON")

        # ── 20 · edge cases found by attacking the tool a second time ───────────────
        _, _, plain = run(root, "--walk", "--control", "CONTROL", "NEEDLE_named_only")
        check("20a paths: a zero warns when the name lives in a PATH",
              "PATH(S)" in plain and "NEEDLE_named_only.cfg" in plain,
              "a filename-only survivor was reported as a clean zero")
        _, _, plain = run(root, "--walk", "--case-sensitive", "--control", "CONTROL",
                          "needle_named_only")
        check("20b paths: the path check honours --case-sensitive",
              "PATH(S)" not in plain, "it matched despite case-sensitive mode")
        _, _, plain = run(root, "--walk", "--binary", "--control", "CONTROL", "NEEDLE")
        check("20c utf16: --binary can actually read a UTF-16 file",
              "utf16.txt" in plain, "--binary promised to search it and found nothing")

        # ── 21 · a tree behind a symlinked directory is NAMED, not silently absent ──
        # Measured 2026-09-19. `find <dir> -type f` returns ZERO files when <dir> is a
        # symlink, control included, and os.walk does the same for a symlinked subdir:
        #     os.walk(root)                   -> 1 file, the needle invisible
        #     os.walk(root, followlinks=True) -> 2 files
        # A session read that zero off `find ~/.claude/LIFEOS/USER -type f` and only its
        # control exposed it. The link is still not followed — followlinks=True loops
        # forever on a self-referential link — so the guarantee is that the omission is
        # STATED. The fixture is the measurement, built the same way it was measured.
        # It gets its own root: adding a link to corpus() would move counts other arms
        # assert on, and an arm that edits its neighbours' fixtures is its own defect.
        link_base = tmp_link
        (link_base / "real" / "inner").mkdir(parents=True, exist_ok=True)
        (link_base / "real" / "inner" / "hidden.txt").write_text("CONTROL NEEDLE hidden\n")
        (link_base / "root").mkdir(parents=True, exist_ok=True)
        (link_base / "root" / "plain.txt").write_text("CONTROL NEEDLE in plain sight\n")
        os.symlink(link_base / "real", link_base / "root" / "linkdir")
        link_root, link_target = link_base / "root", link_base / "real"

        rc, _, plain = run(link_root, *W, "NEEDLE")
        check("21a symlink: the tree behind the link is outside the population",
              rc == 0 and "population: 1 file(s) via WALK" in plain,
              "expected plain.txt alone to be searched")
        check("21b symlink: the directory it never entered is NAMED",
              "NOT FOLLOWED: 1 symlinked director" in plain and "linkdir" in plain,
              "a whole subtree was omitted with nothing said")
        # Positive statement of completeness, the peek rule: a warning that fires only
        # when something is hidden leaves every quiet run ambiguous, which is the bug.
        _, _, plain = run(root, *W, "NEEDLE")
        check("21c symlink: a link-free walk says so POSITIVELY",
              "not followed: 0 symlinked directories" in plain,
              "silence cannot distinguish 'no links' from 'never checked'")
        # The advice the message gives has to actually work.
        rc, _, plain = run(link_target, *W, "NEEDLE")
        check("21d symlink: the target IS searchable as its own --root",
              rc == 0 and "hidden.txt" in plain,
              "the re-run instruction printed above does not find the file")
        # The machine reader gets the same fact, as a list. Never a count: the files
        # behind a link were never enumerated, so any number would be invented.
        rc, raw, _ = run(link_root, "--walk", "--json", "--control", "CONTROL", "NEEDLE")
        try:
            d = json.loads(raw)
            ok = (rc == 0
                  and d["population"]["unfollowed_symlinked_dirs"] == ["linkdir"])
            why = "" if ok else f"rc={rc} value={d.get('population', {}).get('unfollowed_symlinked_dirs')}"
        except Exception as e:
            ok, why = False, f"not JSON: {e}"
        check("21e symlink: --json carries the unfollowed directories as a list", ok, why)
        rc, raw, _ = run(root, "--walk", "--json", "--control", "CONTROL", "NEEDLE")
        try:
            d = json.loads(raw)
            ok = rc == 0 and d["population"]["unfollowed_symlinked_dirs"] == []
            why = "" if ok else f"rc={rc} value={d.get('population', {}).get('unfollowed_symlinked_dirs')}"
        except Exception as e:
            ok, why = False, f"not JSON: {e}"
        check("21f symlink: --json says [] rather than nothing when none were hidden",
              ok, why)

        # ── 22 · an ABSOLUTE --under/--exclude is honoured, or refused by name ────────
        # Measured 2026-09-24 (A24): `--under <repo>/home` had its leading slash stripped,
        # matched 0 files, and only the control caught it. The same call with `--under
        # home` found 170. On this Mac mkdtemp hands back /var/... while --root resolves to
        # /private/var/..., so the unresolved spelling is the one a person actually types.
        _, _, full = run(root, *W, "NEEDLE")
        _, _, rel = run(root, "--under", "docs", *W, "NEEDLE")
        check("22a abspath: the relative control arm keeps docs/ alone",
              "--under docs → 1 file(s) kept" in rel and pop(rel) == 1,
              "the relative form broke, so the absolute arms below prove nothing")
        rc, _, plain = run(root, "--under", str(root / "docs"), *W, "NEEDLE")
        check("22b abspath: an absolute path inside --root keeps what the relative one does",
              rc == 0 and "--under docs → 1 file(s) kept" in plain,
              f"rc={rc}; the leading slash is still being stripped")
        rc, _, plain = run(root, "--under", str(root.resolve() / "docs") + "/", *W, "NEEDLE")
        check("22c abspath: the symlink-resolved spelling, trailing slash and all, works too",
              rc == 0 and "--under docs → 1 file(s) kept" in plain, f"rc={rc}")
        rc, _, plain = run(root, "--exclude", str(root / "docs"), *W, "NEEDLE")
        check("22d abspath: --exclude takes an absolute path the same way",
              rc == 0 and "--exclude docs → 1 file(s) dropped" in plain, f"rc={rc}")
        rc, _, plain = run(root, "--under", str(root), *W, "NEEDLE")
        check("22e abspath: --under the root itself keeps the whole population",
              rc == 0 and pop(plain) == pop(full), f"rc={rc}")
        rc, _, plain = run(root, "--under", str(tmp_link), *W, "NEEDLE")
        check("22f abspath: a path OUTSIDE --root is refused by name with exit 2",
              rc == 2 and "outside --root" in plain and str(tmp_link) in plain,
              f"rc={rc}")
        check("22g abspath: the refusal prints no numbers",
              not re.search(r"^\s*(TOTAL|NEEDLE)\s+\d", plain, re.M))
        rc, _, plain = run(root, "--under", "../elsewhere", *W, "NEEDLE")
        check("22h abspath: a RELATIVE path that climbs out of --root is refused too",
              rc == 2 and "outside --root" in plain, f"rc={rc}")
        rc, raw, _ = run(root, "--json", "--exclude", str(tmp_link), *W, "NEEDLE")
        try:
            d = json.loads(raw)
            ok = (rc == 2 and d.get("refused") == "filter_outside_root"
                  and d["outside"][0]["flag"] == "--exclude")
            why = "" if ok else f"rc={rc} doc={d}"
        except Exception as e:
            ok, why = False, f"not JSON: {e}"
        check("22i abspath: --json names the refusal and the flag", ok, why)
        # Normalising makes "" mean ".", the whole root. `--under "$UNSET"` would then
        # WIDEN a search while looking like a narrow one: census's founding accident again.
        rc, _, plain = run(root, "--under", "", *W, "NEEDLE")
        check("22j abspath: an EMPTY filter is refused, not read as the whole root",
              rc == 2 and "is empty" in plain, f"rc={rc}")

        # An exception inside the A48 arms must FAIL, not abort: an aborted suite skips
        # every arm after it (8a-8c included) and reports nothing about them. Measured on
        # this suite's first run against the pre-A48 census: a KeyError did exactly that.
        try:
            a48_arms(tmp_a48, root)
        except Exception as e:
            check("23-28 aborted: the A48 arms raised instead of reporting", False,
                  f"{e.__class__.__name__}: {e}")

        # ── the original guarantee must still hold ──────────────────────────────────
        rc, _, plain = run(root, "--walk", "--control", "ABSENT-TOKEN", "NEEDLE")
        check("8a control still refuses: exit 2 when the control misses", rc == 2)
        check("8b control still refuses: no numbers are printed",
              "CONTROL FAILED" in plain and "TOTAL" not in plain)
        rc, _, _ = run(root / "does-not-exist", *W, "NEEDLE")
        check("8c control still refuses: a bad --root exits 2", rc == 2)
    finally:
        shutil.rmtree(tmp, ignore_errors=True)
        shutil.rmtree(tmp_link, ignore_errors=True)
        shutil.rmtree(tmp_a48, ignore_errors=True)

    print()
    if failures:
        print(f"{RED}✗ {len(failures)} check(s) FAILED:{OFF} " + ", ".join(failures))
        return 1
    print(f"{GREEN}✓ all checks passed{OFF} {DIM}— census still refuses to answer "
          f"confidently when it cannot answer correctly{OFF}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
