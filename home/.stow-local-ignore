# Stow default ignores (must be re-declared when using .stow-local-ignore)
\.git
\.gitignore
\.gitmodules

# macOS metadata — Finder creates these in every directory it touches.
# Without this, stow tries to symlink them into ~/ and conflicts with
# the real .DS_Store files macOS maintains there.
\.DS_Store
\._.*
\.Spotlight-V100
\.Trashes

# Python bytecode. The PEP 723 scripts in home/.local/bin/ leave __pycache__
# behind when run, and .gitignore:64's `!home/.local/bin/*` re-includes it, so
# without this stow creates ~/.local/bin/__pycache__/ and symlinks every .pyc
# into it. Confirmed by dry run 2026-08-01: MKDIR .local/bin/__pycache__ plus a
# LINK per .pyc. Nothing should ever be deployed from a bytecode cache.
__pycache__
.*\.pyc
