# ~/.zsh_claude_launch -- engage's Claude Code launch: its blocks, and its launch function.
#
# TWO PARTS (split 2026-10-13):
#   1. BLOCKS, every one named __cl_*: each does one piece of launch work. Each carries its id
#      from the launcher-pieces list (L1 to L11). No other launcher reads this file; one that
#      wants a piece keeps its own copy.
#   2. ENGAGE'S OWN, named anything but __cl_*: __engage_screen (the only piece that reads
#      an engage variable) and __claude_launch, the list engage runs. Sourced by the `engage`
#      launcher (~/CODE/CaptainCodeAU/engage, every engage session); ~/.zsh_engage (loaded by
#      ~/.zshrc) also sources this file but calls nothing in it. Its other caller, the `ci`
#      alias, was removed on 2026-10-14 (Gavin), so this whole file goes with engage.
#
# HOW A BLOCK HANDS A SETTING TO CLAUDE: the launch function declares `local -a __cl_env`,
# a block hands NAME=value to __cl_add, which appends it there (zsh's dynamic scope lets a
# called function see its caller's locals), and the launcher exports the list for claude
# alone (engage: __cl_run_with_env, in a subshell). __cl_add refuses when __cl_env
# is not a local of the caller, so a block typed at a prompt cannot leave a value (the NVD
# key) in your shell.
# SOURCING THIS FILE ONLY DEFINES FUNCTIONS: it sets no variable, prints nothing and runs
# nothing, so a launcher that sources it inherits nothing it did not ask for. Keep it that
# way: every interactive shell sources it through ~/.zsh_engage.
#
# It lived inside .zshrc until F3 (2026-09-21), when it moved here so a launcher SCRIPT
# (pj then, engage since pj retired on 4-5 Oct 2026) can source one small file instead of
# all of .zshrc, and so there is ONE definition of the launch steps. Edit it here, never
# copy it back into .zshrc.
#
# Nothing LifeOS-specific lives here. Paths under ~ only; the two keychain reads are
# inside their blocks and their values are never printed.
#
# Every variable in the launch chain below is checked against Claude Code's env-var
# reference and the installed program (docs/CLAUDE_LAUNCH_ENV.md). Three that Claude Code
# no longer reads were removed on 2026-10-06, each after a live A/B test in a herdr pane:
# CLAUDE_CODE_HIDE_ACCOUNT_INFO, ENABLE_EXPERIMENTAL_MCP_CLI and ENABLE_TOOL_SEARCH=1.
#
# Listed in zsh-helper-namespace-check's FILES (D-20260917-06): every function here is named
# __double_underscore so Claude Code's shell snapshot keeps it.

# ===========================================================================================
# PART 1: SHARED BLOCKS
# ===========================================================================================

# The one way a block adds a setting: NAME=value words appended to the caller's local
# __cl_env. Refuses (rc 1, message on stderr, nothing appended) when __cl_env is missing,
# global, or not a plain array, i.e. when no launch function declared it with local -a.
__cl_add() {
  if [[ ${(t)__cl_env-} != array-local* ]]; then
    print -ru2 -- "__cl_add: no local __cl_env here; call launch blocks from a launch function (local -a __cl_env first)."
    return 1
  fi
  __cl_env+=("$@")
}

# L1, last commit files. Print what the last commit touched, on screen, before Claude takes
# over the terminal. Note: it runs the hook script from the old home, ~/.claude/hooks.
# WHY HERE AND NOT IN A HOOK: hooks/LastCommitFiles.sh is wired to SessionStart and feeds the
# AGENT, but Claude Code stores SessionStart stdout as a context ATTACHMENT and never prints it,
# and it spawns hooks with NO controlling terminal, so the hook cannot write to /dev/tty either.
# Both measured 2026-09-15: a probe inside the hook logged `w_test=yes real_write=FAIL`, i.e.
# `[ -w /dev/tty ]` passes while the open() fails. The shell, unlike the hook, owns the terminal.
# Writing to /dev/tty rather than stdout is deliberate: it can never pollute a pipe, so a
# piped `claude -p` launch stays clean with no flag sniffing. Fails silently when there is no tty.
__cl_last_commit() {
  if [[ -x "$HOME/.claude/hooks/LastCommitFiles.sh" ]]; then
    { "$HOME/.claude/hooks/LastCommitFiles.sh" </dev/null > /dev/tty; } 2>/dev/null || true
  fi
}

# L2 + L3, GitHub token check. Refresh the read-only GH API status cache that the welcome
# banner reads. Background, 6h-gated; never blocks the launch.
# The read-only GitHub API token (macOS Keychain) is used ONLY by the status-cache curl
# below; it is NOT exported to the Claude session (GH_TOKEN removed 2026-09-18, see the note
# at __cl_run_with_env) and it is local to this block. Empty on non-macOS; the refresh then
# skips. Never run `gh auth login`.
__cl_github_status() {
  local gh_token="$(security find-generic-password -a "$USER" -s github-api-readonly -w 2>/dev/null)"
  if [[ -n "$gh_token" ]]; then
    local _ghc="${XDG_CACHE_HOME:-$HOME/.cache}/dotfiles/gh_api_status" _ghn=$(date +%s) _ghl=0
    # GNU `stat -c` FIRST, then BSD `-f`. The order is load-bearing, not style: on
    # Linux `-f` means --file-system, so a BSD-first chain SUCCEEDS with a multi-line
    # `File: "..."` block, never reaches the fallback, and feeds non-numeric garbage to
    # the arithmetic below. Unreachable on Linux today ($gh_token only exists via the
    # macOS Keychain), but every SessionStart hook orders it this way after that exact
    # bug bit -- see .claude/hooks/zed-version-check.sh for the full account.
    [[ -f "$_ghc" ]] && _ghl=$(stat -c %Y "$_ghc" 2>/dev/null || stat -f %m "$_ghc" 2>/dev/null || echo 0)
    if (( _ghn - _ghl > 21600 )); then
      ( mkdir -p "${_ghc:h}"
        _h=$(curl -s -o /dev/null -D - -H "Authorization: Bearer $gh_token" https://api.github.com/rate_limit 2>/dev/null)
        _c=$(printf '%s' "$_h" | awk 'NR==1{print $2}' | tr -d '\r')
        _e=$(printf '%s' "$_h" | awk 'tolower($0) ~ /^(x-)?github-authentication-token-expiration:/{sub(/^[^:]*: /,"");print}' | tr -d '\r')
        if [[ "$_c" == 200 ]]; then _s=alive; elif [[ -n "$_c" ]]; then _s=dead; else _s=unknown; fi
        printf 'status=%s\nchecked=%s\nexpires=%s\n' "$_s" "$_ghn" "$_e" > "$_ghc" ) &!
    fi
  fi
  return 0
}

# L4, NVD key. NVD API key (macOS Keychain) -> $NVD_API_KEY for this Claude session. UNLIKE
# $GH_TOKEN this is NOT a credential: it grants no access to anything and only lifts NVD's
# anonymous rate limit from 5 to 50 requests/30s, which is what makes a 231-formula Homebrew
# sweep ~2min instead of ~20min. Free + instantly regenerable at
# https://nvd.nist.gov/developers/request-an-api-key.
# toolchain-cve-check ALSO reads this same Keychain entry directly, so a manual run outside a
# Claude session is authenticated too; this export just saves it the `security` call. Empty on
# non-macOS -> the sweep degrades to slow, never wrong (the variable is still set, empty).
__cl_nvd_key() {
  local nvd_key="$(security find-generic-password -a "$USER" -s nvd-api-key -w 2>/dev/null)"
  __cl_add "NVD_API_KEY=$nvd_key"
}

# L7 + L8, telemetry exception. Clears DISABLE_TELEMETRY and DO_NOT_TRACK for the claude
# process ONLY (the global shell stays opt-out for every other tool) so GrowthBook feature
# flags evaluate and Remote Control can start. OTEL metrics (CLAUDE_CODE_ENABLE_TELEMETRY=0)
# and error reporting stay off. Clearing DISABLE_TELEMETRY re-enables the "How is Claude
# doing?" survey, so CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY=1 travels with it (added 2026-10-06).
# For engage: pairs with remoteControlAtStartup:true, which engage sessions read from ~/.claude.json
# (an older-version value Claude Code still honours: engage loads no user settings.json
# and its template does not set the key); also requires a full-scope token from
# `claude auth login`.
__cl_telemetry_exception() {
  __cl_add DISABLE_TELEMETRY= DO_NOT_TRACK= CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY=1
}

# L9, no freeze. A terminal that stops reading (paused pane, stalled SSH) cannot freeze
# Claude. Added 2026-10-06.
__cl_no_freeze() {
  __cl_add CLAUDE_CODE_NONBLOCKING_STDOUT=1
}

# L10, auto background. Long subagents move to the background. Added 2026-10-06.
__cl_auto_background() {
  __cl_add CLAUDE_AUTO_BACKGROUND_TASKS=1
}

# L11, 10-minute reminder. Reminds Claude every 10 minutes (600 s) to check background work
# still running. Added 2026-10-06.
__cl_checkin_reminder() {
  __cl_add CLAUDE_CODE_WORKER_CHECKIN_SCHEDULE=600
}

# L5, private SSH agent: a WRAPPER, so it goes last and takes the command to run.
# Isolated ephemeral SSH agent per Claude Code session.
# Spins up a dedicated ssh-agent in a subshell so the GitHub key is never
# loaded into macOS's system-wide launchd agent. The agent (and key) die
# when Claude Code exits; a 12h timeout is a safety net for SIGKILL.
# No key file: the command runs with no agent.
# Its one local is named __cl_key, not key: a local is still in scope while claude runs, and
# it would hide an inherited exported variable of the same name from claude.
__cl_ssh_agent() {
  local __cl_key="$HOME/.ssh/captaincodeau"
  if [[ -f "$__cl_key" ]]; then
    (
      eval "$(ssh-agent -s -t 43200)" >/dev/null
      trap 'ssh-agent -k >/dev/null 2>&1' EXIT INT TERM HUP
      # --apple-use-keychain reads the passphrase from the login keychain instead of
      # prompting. It is REQUIRED here and the ssh_config UseKeychain setting does NOT
      # cover it: `UseKeychain yes` lives in a `Host git-cc` block, and `ssh-add` on a
      # FILE PATH has no host context, so no Host block ever applies to it. Measured
      # 2026-09-18 in a live pane: plain `ssh-add` prompted for the passphrase even
      # with the keychain populated and the config in place, while the flagged form
      # returned rc=0 silently and loaded the key. Two earlier "verifications" missed
      # this because they tested `ssh -G git-cc` (connections, not ssh-add) and
      # `--apple-load-keychain` (a different command).
      # The fallback keeps this portable: the flag is macOS-only, so a non-macOS box
      # fails the first form and runs the original.
      ssh-add --apple-use-keychain "$__cl_key" 2>/dev/null || ssh-add "$__cl_key"
      "$@"
    )
  else
    "$@"
  fi
}

# The runner: export the settings the blocks collected in __cl_env, then run the command.
# Always in a subshell, so nothing is exported into the calling shell (a launcher may run in
# your interactive shell). The count guard matters: `export` with no names PRINTS every exported
# variable, so an empty list must never reach it. `builtin` so an alias or function named
# export cannot silently drop the settings.
# The subshell (not `env`) keeps shell functions callable: a caller may hand over a function
# (in an interactive shell, `claude` is the claude() pane guard from .zshrc), and `env` cannot
# run a function.
# GH_TOKEN REMOVED 2026-09-18 from the launch chain. It used to be injected as
# GH_TOKEN="$gh_token" beside the settings below. Why it went: every session started with a
# GitHub key in its environment, where any command could read it and any transcript could
# record it. That is the route by which tokens reached transcripts from June 2026. All
# consumers now fetch their own credential and fail closed (toolchain-cve-check, ci-watch,
# zed-version-check, and LifeOS's five), so nothing needed it here. Ordering rule
# D-20260917-03 was satisfied: the keyring was repointed at the narrow PAT and the old broad
# token revoked BEFORE the line was removed. Do not add a token to __cl_env.
__cl_run_with_env() {
  (
    (( ${+__cl_env} )) && (( ${#__cl_env} )) && builtin export "${__cl_env[@]}"
    "$@"
  )
}

# ===========================================================================================
# PART 2: ENGAGE'S OWN
# ===========================================================================================

# L6, the screen switch (engage only: it reads PJ_RENDERER, an engage variable).
# The classic-renderer lock (CLAUDE_CODE_DISABLE_ALTERNATE_SCREEN): 1 by default, from
# Gavin's June 2026 rejection of fullscreen's mouse capture. engage lifts it by exporting
# PJ_RENDERER=fullscreen, which it does for every session unless the profile, --classic or
# /classic asks for classic (D-20260927-A11; engage exports PJ_RENDERER on every launch, so it
# is never inherited). A caller that never sets it stays locked. W-20260923-A12: the lock outranks
# /tui and NO_FLICKER, so a docked Mods pane needed a way past it.
__engage_screen() {
  local alt_off=1
  [[ "${PJ_RENDERER-}" == fullscreen ]] && alt_off=0
  __cl_add "CLAUDE_CODE_DISABLE_ALTERNATE_SCREEN=$alt_off"
}

# engage's list: every piece, in the order the single function ran them before
# the split. Takes the claude command line as its arguments.
__claude_launch() {
  local -a __cl_env=()
  __cl_last_commit           # L1
  __cl_github_status         # L2 + L3
  __cl_nvd_key               # L4
  __engage_screen            # L6
  __cl_telemetry_exception   # L7 + L8
  __cl_no_freeze             # L9
  __cl_auto_background       # L10
  __cl_checkin_reminder      # L11
  __cl_ssh_agent __cl_run_with_env "$@"   # L5, then claude
}
