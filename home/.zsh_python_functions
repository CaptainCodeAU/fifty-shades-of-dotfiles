    echo "--------------------------------------------------"

    return 0
}


# INTERNAL HELPER: Displays user-friendly hints based on pyproject.toml content.
# It intelligently formats an example command based on the calling function's name.
# Usage: _display_pyproject_hints <calling_command_name>
_display_pyproject_hints() {
    if [[ ! -f "pyproject.toml" ]]; then return 1; fi

    # The command to feature in the example usage text
    local command_name=${1:-"your_command"}

    # Use robust awk commands to parse pyproject.toml
    local detected_py_req=$(awk '/requires-python/ { match($0, /[0-9]+\.[0-9]+/); if (RSTART) print substr($0, RSTART, RLENGTH) }' pyproject.toml)
    local detected_extras_str=$(awk '/^\[project\.optional-dependencies\]/{f=1;next} /^\[/{f=0} f && /^[a-zA-Z]/{gsub(/[ \t]*=.*/, ""); gsub(/^[ \t]*/, ""); print}' pyproject.toml)
    local -a detected_extras=("${(@f)detected_extras_str}")
    detected_extras=(${detected_extras:#})
    local detected_dep_groups_str=$(awk '/^\[dependency-groups\]/{f=1;next} /^\[/{f=0} f && /^[a-zA-Z]/{gsub(/[ \t]*=.*/, ""); gsub(/^[ \t]*/, ""); print}' pyproject.toml)
    local -a detected_dep_groups=("${(@f)detected_dep_groups_str}")
    detected_dep_groups=(${detected_dep_groups:#})

    # Only display hints if there is something to show
    if [[ -n "$detected_py_req" || ${#detected_extras[@]} -gt 0 || ${#detected_dep_groups[@]} -gt 0 ]]; then
        echo "${info}Hint: Based on your pyproject.toml:${done}"

        # Only display the python version hint if the calling function is python_setup
        if [[ "$command_name" == "python_setup" && -n "$detected_py_req" ]]; then
            echo "${info}      - Python version suggested: ${ok}${detected_py_req}${done}"
        fi

        # Display the available extras if any are found
        if (( ${#detected_extras[@]} > 0 )); then
            echo "${info}      - Available extras found: ${ok}[${detected_extras[*]}]${info}.${done}"
        fi

        # Display dependency groups (informational — not installable as extras)
        if (( ${#detected_dep_groups[@]} > 0 )); then
            echo "${info}      - Dependency groups found: ${ok}[${detected_dep_groups[*]}]${info} (not installable as extras).${done}"
        fi

        # Construct an intelligent example command
        local -a example_cmd_parts=("$command_name")
        # Only add the python version to the example if the command is python_setup
        [[ "$command_name" == "python_setup" && -n "$detected_py_req" ]] && example_cmd_parts+=("$detected_py_req")
        # Add all available extras to the example so users see multi-arg syntax
        if (( ${#detected_extras[@]} > 0 )); then
            example_cmd_parts+=("${detected_extras[@]}")
        elif [[ "$command_name" == "uv_tool"* ]]; then
            example_cmd_parts+=("--no-extras")
        fi
        echo "${info}      Example command: ${example}${example_cmd_parts[*]}${done}"

        # For uv_tool functions with extras, also show --no-extras as an alternative
        if [[ "$command_name" == "uv_tool"* ]] && (( ${#detected_extras[@]} > 0 )); then
            echo "${info}      To install with no extras, run: ${example}$command_name --no-extras${done}"
        fi

        # Surface --frozen here too: it is invisible in the argument list otherwise,
        # and it is the flag you want when a hook or cron job runs the command.
        if [[ "$command_name" == "uv_tool_"(install|reinstall)"_current_project" ]]; then
            local pinned_mode
            pinned_mode=$(_uv_tool_pinned_mode 2>/dev/null)
            if [[ -n "$pinned_mode" ]]; then
                echo "${info}      - 📌 Pinned by pyproject.toml to: ${ok}${pinned_mode}${info} installs (applied automatically).${done}"
            else
                echo "${info}      For a snapshot that ignores later edits, add: ${example}--frozen${done}"
            fi
        fi
    fi
}


# Function to set up an existing Python project using uv
# Usage: python_setup <PYTHON_VERSION> [extra1] [extra2] ...
# e.g., python_setup 3.12 cli
python_setup() {
    # --- 1. Argument Validation & User Guidance ---
    if [ "$#" -lt 1 ]; then
        echo "${err}Error: Python version is required.${done}" >&2
        echo "Usage: python_setup <PYTHON_VERSION> [extra1] [extra2] ..." >&2; echo

        # Hint 1: Check for .python-version file
        if [[ -f ".python-version" ]]; then
            local pv_version=$(tr -d '[:space:]' < .python-version)
            if [[ -n "$pv_version" ]]; then
                echo "${info}Hint: Found .python-version file specifying '${ok}${pv_version}${info}'.${done}"
                echo "${info}      Try running: ${example}python_setup ${pv_version}${done}"; echo
            fi
        fi
        # Hint 2: Call the centralized helper for pyproject.toml hints
        _display_pyproject_hints "python_setup"

        return 1
    fi

    # --- Proceed with standard execution if arguments are provided ---
    local req_python_version=$1
    local user_extras=("${@:2}")
    local project_name=$(basename "$PWD")
    local python_interpreter_path=""

    # --- 2. Prerequisite Checks ---
    if ! command -v uv &> /dev/null; then
        echo "${err}Error: 'uv' command not found. Please install uv first.${done}" >&2
        return 1
    fi

    if [[ -z "$PYTHON_VERSION_PATTERN" ]]; then
        PYTHON_VERSION_PATTERN="$PYTHON_VERSION_PATTERN_FALLBACK"
        echo "${warn}Warning: PYTHON_VERSION_PATTERN not defined. Using fallback: ${PYTHON_VERSION_PATTERN}${done}" >&2
    fi
    if [[ ! "${req_python_version}" =~ ${PYTHON_VERSION_PATTERN} ]]; then
        echo "${err}Error: Invalid or unsupported Python version format: '${req_python_version}'.${done}" >&2
        echo "${err}Supported range is roughly: ${PYTHON_MIN_VERSION:-3.8}-${PYTHON_MAX_VERSION:-3.14}${done}" >&2
        return 1
    fi

    python_interpreter_path=$(get_uv_python_path "${req_python_version}")
    if [[ $? -ne 0 ]]; then return 1; fi
    echo "Using Python interpreter: $python_interpreter_path"

    # --- 3. Initial Setup and Banner ---
    echo "--------------------------------------------------"
    echo "${info}Setting up existing Python project: ${ok}${project_name}${done}"
    echo "${info}Using Python: ${ok}${req_python_version}${info} ($python_interpreter_path)${done}"
    if (( ${#user_extras[@]} > 0 )); then
        echo "${info}Requesting optional dependencies (extras): ${ok}${user_extras[*]}${done}"
    fi
    echo "--------------------------------------------------"

    # --- 4. Virtual Environment Creation ---
    if [[ -d ".venv" ]]; then
        echo "Removing existing .venv directory..."
        rm -rf ".venv"
    fi
    echo "Creating virtual environment (.venv)..."
    if ! uv venv --prompt "$(basename "$PWD")" -p "$python_interpreter_path"; then
        echo "${err}Error: Failed to create virtual environment.${done}" >&2
        return 1
    fi

    # --- 5. Supporting File Creation ---
    echo "--------------------------------------------------"
    echo "Ensuring supporting project files exist..."
    create_readme "$project_name" "$req_python_version"
    create_gitignore
    update_vscode_settings
    if [[ ! -f ".env" ]]; then
        if [[ -f ".env.example" ]]; then
            echo "Creating .env from .env.example template..."
            cp .env.example .env
        else
            echo "Creating a new, empty .env file..."
            echo "# Environment variables for $project_name" > .env
        fi
    else
        echo ".env file already exists. Skipping creation."
    fi

    # --- 6. Dependency Installation ---
    echo "--------------------------------------------------"
    echo "Preparing to install dependencies..."
    local install_cmd=""
    if [[ -f "pyproject.toml" ]]; then
        local -a install_features
        if grep -q '\[project.optional-dependencies.dev\]' pyproject.toml; then
            install_features+=("dev")
        fi
        if (( ${#user_extras[@]} > 0 )); then
            install_features+=("${user_extras[@]}")
        fi
        install_features=("${(@u)install_features}")
        if (( ${#install_features[@]} > 0 )); then
            local features_str=$(printf ",%s" "${install_features[@]}")
            features_str=${features_str:1}
            install_cmd="uv pip install --prerelease=allow -e '.[${features_str}]'"
            echo "${info}   Installing project with extras: [${features_str}]${done}"
            echo "   Executing: ${example}${install_cmd}${done}"
        else
            install_cmd="uv pip install --prerelease=allow -e ."
            echo "${info}   Installing project with no optional extras.${done}"
            echo "   Executing: ${example}${install_cmd}${done}"
        fi
    elif [[ -f "requirements.txt" ]]; then
        install_cmd="uv pip sync requirements.txt"
        echo "${info}   Found requirements.txt. Executing: ${example}${install_cmd}${done}"
    fi
    if [[ -n "$install_cmd" ]]; then
        if ! eval "$install_cmd"; then
            echo "${err}Error: Failed to install dependencies.${done}" >&2
            return 1
        fi
    else
        echo "${warn}Warning: No pyproject.toml or requirements.txt found. Skipping dependency installation.${done}" >&2
    fi

    # --- 7. Direnv Integration ---
    echo "--------------------------------------------------"
    echo "Ensuring .envrc for direnv exists..."
    if command -v direnv &> /dev/null; then
        if [[ ! -f ".envrc" ]]; then
            echo "export VIRTUAL_ENV_PROMPT=\"($(basename \"\$PWD\"))\"" > .envrc
            echo "source .venv/bin/activate" >> .envrc
            echo "Running: direnv allow ."
            direnv allow .
        else
            echo "Refreshing direnv trust: direnv allow ."
            direnv allow .
        fi
    fi

    # --- 8. Final Summary ---
    echo "--------------------------------------------------"
    echo "${ok}✅ Project '${project_name}' setup complete!${done}"
    _display_project_scripts
    echo "--------------------------------------------------"
    return 0
}


# Function to clean up Python project artifacts.
# This version provides detailed, technically informative output during the
# manual teardown of the shell environment and file system.
python_delete() {
    echo "--------------------------------------------------"
    echo "${info}Python Project Teardown Initiated...${done}"
    echo "--------------------------------------------------"

    # --- PART 1: Manual Environment Teardown ---
    if [[ -n "$VIRTUAL_ENV" ]]; then
        echo "${info}Found active virtual environment. Proceeding with manual cleanup:${done}"

        # Store critical values before they are unset
        local venv_path="$VIRTUAL_ENV"
        local venv_prompt="$VIRTUAL_ENV_PROMPT"
        local venv_bin_path="${venv_path}/bin:"

        # 1. Unset the custom prompt variable
        echo "  - Unsetting VIRTUAL_ENV_PROMPT (was: '${warn}${venv_prompt}${done}')"
        unset VIRTUAL_ENV_PROMPT

        # 2. Unset the standard venv variable
        echo "  - Unsetting VIRTUAL_ENV (was: '${warn}${venv_path}${done}')"
        unset VIRTUAL_ENV

        # 3. Manually remove the venv path from the main PATH variable.
        if [[ "$PATH" == "$venv_bin_path"* ]]; then
            echo "  - Removing prefix from \$PATH: '${warn}${venv_bin_path}${done}'"
            export PATH="${PATH#$venv_bin_path}"
            echo "${ok}  ✔ Environment variables and PATH have been cleaned.${done}"
        else
            echo "${err}  - Venv path not found at the start of \$PATH. Cannot clean automatically.${done}"
        fi
    else
        echo "${info}No active virtual environment detected. Skipping environment cleanup.${done}"
    fi


    # --- PART 2: File Deletion ---
    echo "${info}Searching for and deleting project files...${done}"
    # uv.lock is NOT in this list. create_gitignore now commits it deliberately (it is
    # what makes `uv sync` reproducible), so deleting it here would delete a TRACKED
    # file and show up as a git deletion -- teardown of generated artifacts should not
    # touch source of record. Recreate it with `uv lock` if you really want it gone.
    local items_to_remove=(
        ".venv"
        ".envrc"
        ".pytest_cache"
        ".coverage"
        "htmlcov"
        "dist"
        "build"
    )

    local deleted_something=false
    for item in "${items_to_remove[@]}"; do
        if [[ -e "$item" ]]; then
            echo "  - Deleting: ${item}"
            rm -rf "$item"
            deleted_something=true
        fi
    done

    # Clean cache files quietly and efficiently. `xargs` execs a BINARY, so it never sees
    # the rm() shell function -- piping to `rm` here permanently unlinked directories out of
    # the user's project tree. safe-rm is a real command on PATH, so xargs can reach it.
    find . -type d -name "__pycache__" -print0 | xargs -0 safe-rm -q 2>/dev/null


    # --- PART 3: Final Visual Cleanup ---
    if command -v p10k &>/dev/null; then
        echo "${info}Reloading Powerlevel10k prompt for visual consistency...${done}"
        # p10k reload
    fi


    # --- PART 4: Final Summary ---
    echo "--------------------------------------------------"
    if [[ "$deleted_something" = true ]]; then
        echo "${ok}✅ Teardown complete.${done}"
    else
        echo "${info}ℹ️ No project files found to delete.${done}"
    fi
    echo "--------------------------------------------------"
}


# INTERNAL HELPER: parse the flags/extras shared by the uv_tool_* project functions.
# Recognises --frozen / --editable / --no-extras ANYWHERE in the argument list (the
# old code only honoured --no-extras when it was $1, so `... dev --no-extras` silently
# tried to install the extra literally named "--no-extras").
# Sets four globals for the caller: _UVT_FROZEN, _UVT_NO_EXTRAS, _UVT_EXTRAS and
# _UVT_MODE_EXPLICIT (true when --frozen or --editable was actually typed, which is
# what lets a pyproject.toml pin apply only when the caller stayed silent).
# An unrecognised --flag is a hard error rather than being passed through as an extra,
# so a typo fails loudly instead of producing '.[--frozn]'.
# Usage: _uv_tool_parse_flags "$@" || return 1
_uv_tool_parse_flags() {
    typeset -g _UVT_FROZEN=false
    typeset -g _UVT_NO_EXTRAS=false
    typeset -g _UVT_MODE_EXPLICIT=false
    typeset -ga _UVT_EXTRAS=()
    local arg
    for arg in "$@"; do
        case "$arg" in
            --frozen)    _UVT_FROZEN=true;  _UVT_MODE_EXPLICIT=true ;;
            --editable)  _UVT_FROZEN=false; _UVT_MODE_EXPLICIT=true ;;
            --no-extras) _UVT_NO_EXTRAS=true ;;
            --)          ;;
            -*)
                echo "${err}❌ Unknown flag: ${arg}${done}" >&2
                echo "${info}   Valid flags: ${example}--frozen${info} | ${example}--editable${info} | ${example}--no-extras${done}" >&2
                return 1
                ;;
            *)           _UVT_EXTRAS+=("$arg") ;;
        esac
    done
    [[ "$_UVT_NO_EXTRAS" == true ]] && _UVT_EXTRAS=()
    return 0
}

# INTERNAL HELPER: read a project's declared install mode from pyproject.toml.
# Echoes "frozen", "editable", or nothing when unpinned.
#
#   [tool.uv-tool]
#   install-mode = "frozen"
#
# This puts the requirement with the PROJECT that needs it instead of with whoever
# last typed a command. A project whose command is run by something outside the
# developer's control -- a git hook, a cron job, a background capture -- is broken by
# an editable install the moment a file is half-saved, and it should not depend on
# remembering a flag, or survive only until the next `uv tool uninstall`.
#
# NOTE: uv itself does NOT read this key. It is honoured only by the
# uv_tool_*_current_project functions in this file. An explicit --editable still wins,
# with a warning, so the pin is a safe default rather than a lock.
_uv_tool_pinned_mode() {
    [[ -f pyproject.toml ]] || return 0
    local mode
    mode=$(awk '
        /^[[:space:]]*\[tool\.uv-tool\][[:space:]]*$/ { f=1; next }
        /^[[:space:]]*\[/                             { f=0 }
        f && /^[[:space:]]*install-mode[[:space:]]*=/ {
            sub(/^[^=]*=[[:space:]]*/, "")
            sub(/[[:space:]]*#.*$/, "")
            gsub(/[",'"'"'[:space:]]/, "")
            print; exit
        }' pyproject.toml)
    case "${mode:l}" in
        frozen|editable) echo "${mode:l}" ;;
        "")              ;;
        *)
            echo "${warn}⚠️  Ignoring unknown [tool.uv-tool] install-mode: '${mode}' (expected 'frozen' or 'editable').${done}" >&2
            ;;
    esac
    return 0
}

# INTERNAL HELPER: resolve the effective mode from the pin + what the caller typed.
# Sets _UVT_FROZEN, and reports when the two disagree.
_uv_tool_apply_pin() {
    local pinned
    pinned=$(_uv_tool_pinned_mode)
    [[ -n "$pinned" ]] || return 0

    if [[ "$_UVT_MODE_EXPLICIT" != true ]]; then
        # Caller said nothing -- the project decides.
        [[ "$pinned" == frozen ]] && _UVT_FROZEN=true || _UVT_FROZEN=false
        echo "${info}📌 pyproject.toml pins this project to ${ok}${pinned}${info} installs.${done}"
        return 0
    fi

    local asked=editable
    [[ "$_UVT_FROZEN" == true ]] && asked=frozen
    if [[ "$asked" != "$pinned" ]]; then
        echo "${warn}⚠️  OVERRIDE: pyproject.toml pins this project to ${pinned}, installing ${asked} anyway.${done}"
        [[ "$pinned" == frozen ]] && \
            echo "${warn}   The pin exists because something outside this shell runs this command.${done}"
    fi
    return 0
}

# INTERNAL HELPER: normalise a package name the way the packaging ecosystem does.
# PEP 503: lowercase, and collapse every run of - _ . into a single hyphen.
#   my.tool -> my-tool     My_Tool -> my-tool     a..__--b -> a-b
#
# THIS EXISTS BECAUSE COMPARING THE RAW pyproject NAME IS WRONG, IN BOTH DIRECTIONS.
# `uv tool list` prints the NORMALISED name, never what pyproject.toml says. A project
# declaring `name = "my.tool"` is listed as `my-tool` -- measured 2026-09-07 against a
# real install. So:
#   - An exact compare against the raw name FAILS to find a tool that IS installed.
#     Shipped in cd0ae9f, caught in review the same day. uv_tool_check_current_project
#     printed "Not Found" and returned 1 for a live, working install.
#   - The `grep -iE "^${name}"` it replaced only worked here BY ACCIDENT: the dot in
#     `my.tool` is a regex wildcard, so it happened to match the hyphen in `my-tool`
#     while also matching `myXtool`. Right answer, wrong reason -- which is why the
#     fix is to normalise, not to put the regex back.
# Normalise BOTH sides and compare as strings. Idempotent, so normalising an
# already-normalised name is harmless.
#
# `localoptions extendedglob` is deliberate: `##` (one-or-more) needs EXTENDED_GLOB, and
# .zshrc sets it globally -- but a function that only works because of a caller's setopt
# breaks in `zsh -f`, in hooks, and in scripts. Verified working with EXTENDED_GLOB off.
_uv_tool_normalize_name() {
    setopt localoptions extendedglob
    local n="${1:l}"
    print -r -- "${n//[._-]##/-}"
}

# INTERNAL HELPER: report HOW a uv tool environment was installed.
# Echoes exactly one word: editable | frozen | registry | unknown
#
# Reads PEP 610 direct_url.json inside the tool env, which is the authoritative
# record of the install:
#   {"url":"file:///…","dir_info":{"editable":true}}  -> editable  (live link to the checkout)
#   {"url":"file:///…","dir_info":{}}                 -> frozen    (snapshot copied into the env)
#   file absent                                       -> registry  (installed from PyPI)
#
# Do NOT sniff for *.pth files instead: uv writes `_editable_impl_<pkg>.pth` for some
# projects and `<pkg>.pth` for others, and EVERY env carries an unrelated
# `_virtualenv.pth`, so that heuristic misclassifies in both directions.
# Usage: _uv_tool_install_mode <tool_env_path> <project_name>
_uv_tool_install_mode() {
    local tool_env=$1 pkg=$2
    [[ -n "$tool_env" && -d "$tool_env" ]] || { echo unknown; return 1; }

    local site
    site=$(find "$tool_env/lib" -maxdepth 2 -type d -name site-packages 2>/dev/null | head -n 1)
    [[ -n "$site" ]] || { echo unknown; return 1; }

    # dist-info dirs use the PEP 503 name with its hyphens turned into underscores, so
    # normalise FIRST and swap after. The old `${${pkg:l}//[-.]/_}` substituted character
    # by character and never collapsed runs, so `my..tool` produced `my__tool` while the
    # real directory is `my_tool-0.3.0.dist-info` -- measured 2026-09-07 against a real
    # install. The targeted find then missed, and the function fell through to the
    # fallback below: `unknown` at best, and in an env with a git/URL dep, the DEP's mode
    # reported as the project's.
    local norm=${$(_uv_tool_normalize_name "$pkg")//-/_}
    local du
    du=$(find "$site" -maxdepth 2 -path "*/${norm}-*.dist-info/direct_url.json" 2>/dev/null | head -n 1)
    # Fall back to any direct_url.json -- but only when there is exactly ONE.
    #
    # The old comment claimed deps "installed from PyPI never have one", and used that to
    # conclude the single match must be the project itself. That is true only of INDEX
    # installs. PEP 610 writes direct_url.json for every direct reference, including
    # `vcs_info` (a git dep) and `archive_info` (a URL dep), so a tool installed with
    # `--with git+https://...` has two, and picking the first would report the DEP's mode
    # as the project's. Measured 2026-09-07: no tool env on this machine has more than
    # one, so this was latent rather than live -- which is exactly when to fix it.
    #
    # Ambiguity resolves to `unknown`, never to a guess. A wrong editable/frozen answer
    # is the failure this whole function exists to prevent; "I could not tell" is not.
    if [[ -z "$du" ]]; then
        local -a all_du
        all_du=(${(f)"$(find "$site" -maxdepth 2 -name direct_url.json 2>/dev/null)"})
        if (( ${#all_du} > 1 )); then
            echo unknown
            return 1
        elif (( ${#all_du} == 1 )); then
            # ONE match is not proof it is OURS. A project installed from the index has no
            # direct_url.json at all, so `uv tool install some-pypi-pkg --with git+https://…`
            # leaves exactly one -- the GIT DEP'S -- and reading it reports `frozen` for an
            # install that is genuinely `registry`. That is the same misattribution the >1
            # branch above rejects, and an earlier version of this comment wrongly claimed
            # the single case was covered.
            #
            # So check the owning dist-info actually normalises to our package. This is NOT
            # the targeted find repeated: that one matches the directory name literally,
            # while this tolerates a differently-spelled separator run and still refuses a
            # different package. No match means the project really has no direct_url.json,
            # which IS registry -- fall through with $du empty and let the branch below say so.
            local du_dir=${all_du[1]:h:t}                 # <name>-<version>.dist-info
            local du_pkg=${${du_dir%.dist-info}%-*}       # strip .dist-info, then the version
            [[ "$(_uv_tool_normalize_name "$du_pkg")" == "$(_uv_tool_normalize_name "$pkg")" ]] \
                && du="${all_du[1]}"
        fi
    fi

    if [[ -z "$du" ]]; then
        echo registry
    elif grep -q '"editable"[[:space:]]*:[[:space:]]*true' "$du"; then
        echo editable
    else
        echo frozen
    fi
    return 0
}

# Install current project as user-level CLI via uv tool, with optional extras.
#
# Two install modes -- the difference is load-bearing, so it is reported everywhere:
#   default    editable snapshot: the installed command imports straight from this
#              checkout, so code edits take effect immediately.
#   --frozen   real copy into the tool env: the installed command is pinned to the
#              code as it was AT INSTALL TIME. Editing this checkout no longer changes
#              what the installed command runs until you reinstall. Use this whenever
#              something outside your control runs the command (a hook, a cron job, a
#              background capture), where a half-saved file would otherwise break it.
#
# Usage: uv_tool_install_current_project [--frozen] [extra1] [extra2] ...
#        uv_tool_install_current_project [--frozen] --no-extras
uv_tool_install_current_project() {
    # --- 1. User Guidance for no arguments ---
    if [ "$#" -eq 0 ]; then
        echo "${err}Error: No extras specified for installation.${done}" >&2
        echo "This function installs the project with optional features." >&2; echo

        # Call the centralized helper for pyproject.toml hints
        _display_pyproject_hints "uv_tool_install_current_project"
        return 1
    fi

    # --- 2. Standard Execution ---
    if [[ ! -f pyproject.toml ]]; then
        echo "${err}❌ Error: 'pyproject.toml' not found.${done}" >&2; return 1;
    fi
    if [[ -z "$VIRTUAL_ENV" ]]; then
        echo "${err}❌ Error: No active virtual environment. Activate a venv to specify the Python version.${done}" >&2; return 1;
    fi

    _uv_tool_parse_flags "$@" || return 1
    _uv_tool_apply_pin
    local -a user_extras=("${_UVT_EXTRAS[@]}")
    local frozen="$_UVT_FROZEN"
    local project_name=$(awk -F'"' '/^name *=/ {gsub(/[[:space:]]/, "", $0); print $2; exit}' pyproject.toml)
    local python_interpreter="$VIRTUAL_ENV/bin/python"

    local install_source="."
    if (( ${#user_extras[@]} > 0 )); then
        local features_str=$(printf ",%s" "${user_extras[@]}")
        features_str=${features_str:1} # Remove leading comma
        install_source=".[${features_str}]"
    fi

    # --editable is the default; --frozen simply omits it, which makes uv copy the
    # project into the tool env instead of linking back to this checkout.
    local -a mode_flag=(--editable)
    local mode_label="editable"
    if [[ "$frozen" == true ]]; then
        mode_flag=()
        mode_label="frozen"
    fi

    echo "${info}🔗 Installing '$project_name' from source '${ok}${install_source}${info}' as a CLI via uv tool (${ok}${mode_label}${info})...${done}"
    echo "${info}   Using Python from active venv: $python_interpreter ($($python_interpreter --version))${done}"

    # --python takes the venv's interpreter PATH, not a "3.14"-style version request.
    # This used to pass major.minor, cut from the venv's own --version output. uv then
    # RE-RESOLVED that string against its own discovery order and could land somewhere
    # else entirely: measured 2026-09-07 on this Mac, `uv python find 3.14` returns the
    # uv-managed 3.14.3 while the venv here was built from Homebrew's 3.14.7. So the
    # line above announced one interpreter and the install used another -- a message
    # that reassures you about something it did not do. A path cannot be re-resolved.
    if uv tool install --force "${mode_flag[@]}" --python "$python_interpreter" "$install_source"; then
        echo "${ok}✅ '$project_name' CLI installed successfully (${mode_label} mode).${done}"
        if [[ "$frozen" == true ]]; then
            echo "${warn}   ⚠️  FROZEN: editing this checkout no longer changes what '$project_name' runs.${done}"
            echo "${warn}      Re-run ${example}uv_tool_reinstall_current_project --frozen ${user_extras[*]}${warn} to pick up changes.${done}"
        else
            echo "${info}   💡 Code changes are reflected immediately. Reinstall only needed if pyproject.toml entry points change.${done}"
        fi
        echo "--------------------------------------------------"
        uv_tool_check_current_project
        # EXPLICIT, because uv_tool_check_current_project returns 1 for "not installed"
        # and it is the LAST command in this branch -- so its status became the status of
        # a successful install. `uv_tool_install_current_project dev && deploy` then
        # printed the green tick and never ran deploy. This repo already forbids the
        # mirror image of this (a refusal that reports success, which is why every
        # pip/python/npm hijack in .zshrc returns 1); a success that reports failure is
        # the same defect pointing the other way.
        return 0
    else
        echo "${err}❌ Failed to install '$project_name' via uv tool. Please check errors above.${done}"
        return 1
    fi
}


# Reinstall the CLI for the current project from local source, with optional extras.
# With uv tool, this is a single --force --reinstall operation (no uninstall-then-install needed).
#
# For an EDITABLE install, reinstalling is typically only needed when pyproject.toml
# entry points change. For a --frozen install it is needed after EVERY change you want
# the installed command to see -- that is the whole point of freezing, and the reason
# the mode is printed on every install and by uv_tool_check_current_project.
#
# NOTE: the mode is not sticky. Omitting --frozen here reinstalls as editable even if
# the current install is frozen, so pass the same flag you installed with.
#
# Usage: uv_tool_reinstall_current_project [--frozen] [extra1] [extra2] ...
uv_tool_reinstall_current_project() {
    # --- 1. User Guidance for no arguments ---
    if [ "$#" -eq 0 ]; then
        echo "${err}Error: No extras specified for reinstallation.${done}" >&2
        echo "This function reinstalls the project with optional features." >&2; echo

        # Call the centralized helper for pyproject.toml hints
        _display_pyproject_hints "uv_tool_reinstall_current_project"
        return 1
    fi

    # --- 2. Standard Execution ---
    if [[ ! -f pyproject.toml ]]; then
        echo "${err}❌ Error: 'pyproject.toml' not found.${done}" >&2; return 1;
    fi
    if [[ -z "$VIRTUAL_ENV" ]]; then
        echo "${err}❌ Error: No active virtual environment. Activate a venv to specify the Python version.${done}" >&2; return 1;
    fi

    # --- 3. Argument and Variable Setup ---
    _uv_tool_parse_flags "$@" || return 1
    _uv_tool_apply_pin
    local -a user_extras=("${_UVT_EXTRAS[@]}")
    local frozen="$_UVT_FROZEN"
    local project_name=$(awk -F'"' '/^name *=/ {gsub(/[[:space:]]/, "", $0); print $2; exit}' pyproject.toml)
    local python_interpreter="$VIRTUAL_ENV/bin/python"

    local install_source="."
    if (( ${#user_extras[@]} > 0 )); then
        local features_str=$(printf ",%s" "${user_extras[@]}")
        features_str=${features_str:1}
        install_source=".[${features_str}]"
    fi

    local -a mode_flag=(--editable)
    local mode_label="editable"
    if [[ "$frozen" == true ]]; then
        mode_flag=()
        mode_label="frozen"
    fi

    # Warn when this reinstall would silently flip the mode out from under the caller.
    #
    # PEP 503 normalised, like every other name lookup in this file. `${project_name//_/-}`
    # handled underscores but not dots, so for a project named `my..tool` this found
    # nothing, prev_mode was never read, and a frozen -> editable reinstall printed NO
    # warning at all -- measured 2026-09-07. A silent mode flip is precisely what this
    # block exists to prevent, so its own name matching failing quietly was the worst
    # possible way for it to break.
    local prev_env prev_mode prev_norm
    prev_norm=$(_uv_tool_normalize_name "$project_name")
    prev_env=$(uv tool list --show-paths 2>/dev/null | awk -v p="$prev_norm" \
        '{ n=tolower($1); gsub(/[._-]+/,"-",n); if (n==p) { if (match($0, /\(([^)]*)\)$/)) print substr($0, RSTART+1, RLENGTH-2); exit } }')
    if [[ -n "$prev_env" ]]; then
        prev_mode=$(_uv_tool_install_mode "$prev_env" "$project_name")
        if [[ "$prev_mode" == editable || "$prev_mode" == frozen ]] && [[ "$prev_mode" != "$mode_label" ]]; then
            echo "${warn}⚠️  Mode change: currently ${prev_mode}, this reinstall makes it ${mode_label}.${done}"
        fi
    fi

    echo "${info}♻️  Reinstalling '$project_name' from source '${ok}${install_source}${info}' via uv tool (${ok}${mode_label}${info})...${done}"
    echo "${info}   Using Python from active venv: $python_interpreter ($($python_interpreter --version))${done}"

    # uv tool install --force --reinstall handles this in a single step
    # (no need for the old uninstall-then-install dance that pipx required)
    # --python is the venv's interpreter PATH -- see the note in
    # uv_tool_install_current_project for why a major.minor string was wrong here.
    if uv tool install --force --reinstall "${mode_flag[@]}" --python "$python_interpreter" "$install_source"; then
        echo "${ok}✅ '$project_name' CLI reinstalled successfully (${mode_label} mode).${done}"
        if [[ "$frozen" == true ]]; then
            echo "${warn}   ⚠️  FROZEN: this snapshot is what runs until the next --frozen reinstall.${done}"
        fi
        echo "--------------------------------------------------"
        uv_tool_check_current_project
        # Explicit -- see the matching note in uv_tool_install_current_project.
        return 0
    else
        echo "${err}❌ Failed to reinstall '$project_name' via uv tool. Please check errors above.${done}"
        return 1
    fi
}


# Uninstall the CLI for the current project
uv_tool_uninstall_current_project() {
    if [[ ! -f pyproject.toml ]]; then
        echo "${err}❌ Error: 'pyproject.toml' not found in the current directory.${done}" >&2
        echo "${err}   Cannot determine project name to uninstall.${done}" >&2
        return 1
    fi

    local project_name
    project_name=$(awk -F'"' '/^name *=/ {gsub(/[[:space:]]/, "", $0); print $2; exit}' pyproject.toml)

    echo "${info}🗑️  Attempting to uninstall '$project_name' via uv tool...${done}"
    if uv tool uninstall "$project_name"; then
        echo "${ok}✅ '$project_name' CLI has been successfully uninstalled.${done}"
    else
        # The command returns a non-zero exit code if it fails, which includes the case where the package isn't installed.
        echo "${warn}⚠️  Could not uninstall '$project_name'. It may not have been installed.${done}"
        # Returning 0 here because "not installed" is not a critical script failure.
        return 0
    fi
}


# Check if the current project is installed as a user-level CLI via uv tool.
# Returns 0 (true) if found, 1 (false) if not found.
# If found, prints the location of the executable(s).
# Uses 'uv tool list --show-paths' for introspection.
uv_tool_check_current_project() {
    # --- Prerequisite Checks ---
    if ! command -v uv &> /dev/null; then
        echo "${err}❌ Error: 'uv' command not found.${done}" >&2
        return 1
    fi
    if [[ ! -f pyproject.toml ]]; then
        echo "${err}❌ Error: 'pyproject.toml' not found in the current directory.${done}" >&2
        return 1
    fi

    # --- Extract Project Name ---
    local project_name
    project_name=$(awk -F'"' '/^name *=/ {gsub(/[[:space:]]/, "", $0); print $2; exit}' pyproject.toml)

    if [[ -z "$project_name" ]]; then
        echo "${err}❌ Error: Could not determine project name from pyproject.toml.${done}" >&2
        return 1
    fi

    # --- Query uv tool list and Check for the Project ---
    # uv tool list --show-paths output format:
    #   package_name v1.2.3 (/path/to/tool/env/)
    #   - executable_name (/path/to/bin/executable_name)
    local tool_output
    tool_output=$(uv tool list --show-paths 2>/dev/null)

    # Normalise the project name the way uv prints it (PEP 503 -- see
    # _uv_tool_normalize_name). `tr '_' '-'` was not enough: it leaves the dot in
    # `my.tool` alone, while uv lists that project as `my-tool`.
    local project_name_normalized=$(_uv_tool_normalize_name "$project_name")

    # Check if the project appears in the tool list.
    #
    # FIELD COMPARE, not grep -E: the project name came out of pyproject.toml and was
    # being interpolated straight into a regex, where its characters kept their regex
    # meaning -- so `my.tool` also matched a line for `myXtool`. Both sides are
    # normalised here, so the comparison is exact without being literal.
    local tool_line
    tool_line=$(echo "$tool_output" | awk -v p="$project_name_normalized" \
        '{ n=tolower($1); gsub(/[._-]+/,"-",n); if (n==p) { print; exit } }')

    if [[ -n "$tool_line" ]]; then
        echo "${ok}✅ Found: Project '$project_name' is installed via uv tool.${done}"

        # Extract version from the tool line (format: "name vX.Y.Z (/path/)")
        local tool_version
        tool_version=$(echo "$tool_line" | awk '{print $2}')

        if [[ -n "$tool_version" ]]; then
            echo "${info}   Version: ${ok}${tool_version}${done}"
        fi

        # Editable vs frozen is the single most consequential fact about this install
        # and uv tool list does not report it, so surface it here -- unmissably, with
        # its consequence spelled out. A frozen install that LOOKS live is exactly how
        # an afternoon gets burned editing code that nothing is running.
        local tool_env install_mode
        tool_env=$(echo "$tool_line" | sed -n 's/.*(\(.*\))$/\1/p')
        install_mode=$(_uv_tool_install_mode "$tool_env" "$project_name")
        case "$install_mode" in
            editable)
                echo "${info}   Mode:    ${ok}EDITABLE${info} - tracks this checkout; edits take effect immediately.${done}"
                ;;
            frozen)
                echo "${info}   Mode:    ${warn}FROZEN${info} - a snapshot copy.${done}"
                echo "${warn}            ⚠️  Editing this checkout does NOT change what runs.${done}"
                echo "${warn}            Run ${example}uv_tool_reinstall_current_project --frozen${warn} to update it.${done}"
                ;;
            registry)
                echo "${info}   Mode:    ${warn}REGISTRY${info} - installed from PyPI, not from this checkout.${done}"
                ;;
            *)
                echo "${info}   Mode:    ${warn}unknown${info} (could not read direct_url.json in the tool env).${done}"
                ;;
        esac

        # Extract executable paths (lines starting with "- " after the tool line)
        local -a executables
        local found_tool=false
        while IFS= read -r line; do
            if [[ "$found_tool" == true ]]; then
                if [[ "$line" == -\ * ]]; then
                    # Extract the executable name and path
                    local exec_entry=$(echo "$line" | sed 's/^- //')
                    executables+=("$exec_entry")
                else
                    # No longer in this tool's executables section
                    break
                fi
            fi
            # Match the tool line to start collecting executables. First whitespace field,
            # NORMALISED then compared as a string -- same reasoning as the tool_line lookup
            # above, and the same two bugs were both here: the old regex could start
            # collecting another tool's binaries, and a raw compare missed a dotted name
            # entirely. An executable row starts with "- ", which normalises to "-" and can
            # never equal a project name, so those rows cannot false-match.
            local line_name=$(_uv_tool_normalize_name "${line%%[[:space:]]*}")
            if [[ "$line_name" == "$project_name_normalized" ]]; then
                found_tool=true
            fi
        done <<< "$tool_output"

        if (( ${#executables[@]} > 0 )); then
            echo "${info}   Executable(s):${done}"
            for exec_entry in "${executables[@]}"; do
                echo "   - ${example}${exec_entry}${done}"
            done
        else
            echo "${warn}   Warning: Package is installed but no executables were found.${done}"
        fi
        return 0 # Represents "true"
    else
        echo "${info}ℹ️ Not Found: Project '$project_name' is not currently installed via uv tool.${done}"
        echo "${info}   To install it, run: ${example}uv_tool_install_current_project${done}"
        return 1 # Represents "false"
    fi
}


# Report how a uv tool was installed -- machine readable, for scripts.
# Echoes exactly one word on stdout and nothing else:
#   editable | frozen | registry | not-installed | unknown
# Exit status is 0 when a mode was determined, 1 when it was not.
#
# This is the SUPPORTED entry point for the PEP 610 check -- use it rather than
# re-implementing the lookup. direct_url.json sits FOUR levels down, at
#   <tool_env>/lib/python*/site-packages/<normalised-name>-*.dist-info/direct_url.json
# (the name is lowercased with hyphens and dots turned into underscores, and the
# dist-info directory is version-stamped). A shallow glob matches nothing, and
# "no match" reads as "no editable flag" and therefore as frozen -- reporting a live
# install as a snapshot, silently, which is the exact mistake this check exists to
# prevent. Non-shell callers should replicate the full path pattern above.
#
# Usage: uv_tool_mode           # the project in $PWD (needs pyproject.toml)
#        uv_tool_mode <name>    # a named uv tool
#
# Example:
#   if [[ "$(uv_tool_mode)" != frozen ]]; then echo "refusing to run: not frozen"; fi
uv_tool_mode() {
    local pkg=$1
    if [[ -z "$pkg" ]]; then
        [[ -f pyproject.toml ]] || { echo unknown; return 1; }
        pkg=$(awk -F'"' '/^name *=/ {gsub(/[[:space:]]/, "", $0); print $2; exit}' pyproject.toml)
    fi
    [[ -n "$pkg" ]] || { echo unknown; return 1; }

    # uv tool list reports the PEP 503 name; pyproject may use underscores OR dots.
    # `${pkg//_/-}` handled only underscores, so `uv_tool_mode` reported `not-installed`
    # for a live `my.tool` -- measured 2026-09-07, and pre-dating the cd0ae9f change that
    # cited this function as its model. Normalise both sides, same as everywhere else.
    local alt tool_line tool_env
    alt=$(_uv_tool_normalize_name "$pkg")
    tool_line=$(uv tool list --show-paths 2>/dev/null | awk -v p="$alt" \
        '{ n=tolower($1); gsub(/[._-]+/,"-",n); if (n==p) { print; exit } }')
    [[ -n "$tool_line" ]] || { echo not-installed; return 1; }

    tool_env=$(echo "$tool_line" | sed -n 's/.*(\(.*\))$/\1/p')
    _uv_tool_install_mode "$tool_env" "$pkg"
}


# ==============================================================================
# Zsh Completions for uv_tool project functions
# ==============================================================================

# Completion function that parses [project.optional-dependencies] from pyproject.toml
# and offers extras as completions, plus the --no-extras flag.
_uv_tool_project_extras() {
    local -a extras
    extras=(
        "--no-extras:Install with no optional extras"
        "--frozen:Snapshot copy -- installed command ignores later edits to this checkout"
        "--editable:Live link to this checkout (the default)"
    )

    if [[ -f "pyproject.toml" ]]; then
        local extras_list
        extras_list=$(awk '/^\[project\.optional-dependencies\]/{f=1;next} /^\[/{f=0} f && /^[a-zA-Z]/{gsub(/[ \t]*=.*/, ""); gsub(/^[ \t]*/, ""); print}' pyproject.toml)
        local -a parsed_extras=("${(@f)extras_list}")
        for extra in "${parsed_extras[@]}"; do
            [[ -n "$extra" ]] && extras+=("${extra}:Install with '${extra}' optional dependencies")
        done
    fi

    _describe 'extras' extras
}

# Register completions for the uv_tool project functions
compdef _uv_tool_project_extras uv_tool_install_current_project
compdef _uv_tool_project_extras uv_tool_reinstall_current_project
