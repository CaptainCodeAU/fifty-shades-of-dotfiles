# ~/.zsh_welcome
# ==============================================================================
#  Unified Welcome & Environment Overview Script
# ==============================================================================
# Cross-platform welcome message for macOS, Linux, and WSL.
#
# VERBOSITY CONTROL (set in ~/.zshrc or ~/.zshrc.private):
#   ZSH_WELCOME          - Environment overview: "full", "minimal", or "none"
#   ZSH_WELCOME_QUICKREF - Quick reference: "full", "minimal", "none"
#   ZSH_WELCOME_DISK_WARN - Disk warning threshold percentage (default: 90)
#
# DEFAULT: "full". Override per-machine via ~/.zshrc.private with
#   export ZSH_WELCOME=minimal   # terse single-line status
#   export ZSH_WELCOME=none      # no overview at all
#
# Date Created: 16/01/2025
# ==============================================================================

# ------------------------------------------------------------------------------
# Verbosity Resolution
# ------------------------------------------------------------------------------
_resolve_welcome_verbosity() {
    # Explicit setting wins; otherwise default to full. SSH/tmux no longer
    # force minimal — those are places you typically want MORE info, not less.
    if [[ -n "$ZSH_WELCOME" ]]; then
        echo "$ZSH_WELCOME"
    else
        echo "full"
    fi
}

# Store resolved verbosity
_WELCOME_VERBOSITY=$(_resolve_welcome_verbosity)
: ${ZSH_WELCOME_QUICKREF:="full"}
: ${ZSH_WELCOME_DISK_WARN:=90}

# ------------------------------------------------------------------------------
# Helper: Get Disk Usage
# ------------------------------------------------------------------------------
_get_disk_usage() {
    local usage_pct free_space

    if [[ "$IS_MAC" == "true" ]]; then
        # macOS: use df on root volume
        usage_pct=$(df -h / | awk 'NR==2 {gsub(/%/,""); print $5}')
        free_space=$(df -h / | awk 'NR==2 {print $4}')
    else
        # Linux/WSL: use df on home directory
        usage_pct=$(df -h ~ | awk 'NR==2 {gsub(/%/,""); print $5}')
        free_space=$(df -h ~ | awk 'NR==2 {print $4}')
    fi

    echo "${usage_pct}:${free_space}"
}

# ------------------------------------------------------------------------------
# Helper: Check GPU Availability (WSL/Linux only)
# ------------------------------------------------------------------------------
_check_gpu() {
    if command -v nvidia-smi &>/dev/null && nvidia-smi &>/dev/null; then
        echo "available"
    else
        echo "none"
    fi
}

# ------------------------------------------------------------------------------
# Helper: GitHub agent-forwarding drift check (consumer boxes)
# ------------------------------------------------------------------------------
# Boxes that reach GitHub via SSH agent forwarding hold NO local github key, so
# `ssh -G github.com` must resolve `identitiesonly no` for the forwarded key to be
# offered. If a ~/.ssh/config.local edit drops github.com from the override, ssh
# silently falls back to `Host * IdentitiesOnly yes` and every push fails with
# "Permission denied (publickey)" even though the forwarded agent holds the key.
# Three layers below: _compute_github_forward_drift does the raw `ssh -G` config
# resolution; _github_config_status caches that on ssh-config mtimes (the banner
# pays ~2 stats, not a subprocess, in steady state, yet recomputes the instant a
# config file changes); _check_github_forward_drift adds a LIVE forwarded-agent-key
# check on top -- because config can read OK while the agent carries no key, which
# is exactly a "config fine but Permission denied (publickey)" push.
# _compute_ returns: ok | broken | n/a
_compute_github_forward_drift() {
    command -v ssh &>/dev/null || { echo "n/a"; return; }
    local cfg io f expanded
    cfg=$(ssh -G github.com 2>/dev/null) || { echo "n/a"; return; }
    io=$(printf '%s\n' "$cfg" | awk '$1=="identitiesonly"{print $2; exit}')
    [[ -z "$io" ]] && { echo "n/a"; return; }
    # identitiesonly no -> forwarded (or any) keys are offered -> healthy
    [[ "$io" == "no" ]] && { echo "ok"; return; }
    # identitiesonly yes -> only named IdentityFiles are offered; healthy ONLY if a
    # real local key file exists (a box with its own local key). Otherwise the
    # forwarded key is suppressed -> broken.
    while IFS= read -r f; do
        expanded=${f/#\~/$HOME}
        [[ -f "$expanded" ]] && { echo "ok"; return; }
    done < <(printf '%s\n' "$cfg" | awk '$1=="identityfile"{print $2}')
    echo "broken"
}

# Cached CONFIG status: mtime-keyed on the two ssh config files that `ssh -G` reads
# (following the config symlink to its stowed target). A drift edit bumps
# config.local's mtime and invalidates the cache immediately, so the banner never
# shows a stale OK after a real regression. Steady state = a couple of stats + one
# file read, no subprocess (matches the "file-read over CLI in the banner" pref).
_github_config_status() {
    command -v ssh &>/dev/null || { echo "n/a"; return; }
    local cache_dir="${XDG_CACHE_HOME:-$HOME/.cache}/dotfiles"
    local cache="$cache_dir/github_forward_status"
    local f m sig=""
    for f in "$HOME/.ssh/config" "$HOME/.ssh/config.local"; do
        m=$(stat -L -c %Y "$f" 2>/dev/null || stat -L -f %m "$f" 2>/dev/null)
        sig="${sig}:${m}"
    done
    if [[ -r "$cache" ]]; then
        local cached_sig cached_result
        IFS='|' read -r cached_sig cached_result < "$cache"
        [[ "$cached_sig" == "$sig" ]] && { echo "$cached_result"; return; }
    fi
    local result
    result=$(_compute_github_forward_drift)
    [[ -d "$cache_dir" ]] || mkdir -p "$cache_dir" 2>/dev/null
    print -r -- "${sig}|${result}" > "$cache" 2>/dev/null
    echo "$result"
}

# Full push-readiness: config must be OK (cached) AND a key must actually be
# reachable in the forwarded agent. The agent half is LIVE, never cached -- agent
# state is volatile (a key can vanish without touching any config file) and
# `ssh-add -l` is a cheap agent round-trip. Config alone can read OK while the
# forwarded agent is empty; that is precisely a "config fine but publickey denied"
# push, which the config-only check silently reported as OK.
# Returns: ok | broken | nokey | noagent | n/a
_check_github_forward_drift() {
    local cfg
    cfg=$(_github_config_status)
    [[ "$cfg" != "ok" ]] && { echo "$cfg"; return; }          # broken (config drift) or n/a
    command -v ssh-add &>/dev/null || { echo "ok"; return; }  # cannot inspect agent -> trust config
    ssh-add -l >/dev/null 2>&1
    case $? in
        0) echo "ok" ;;       # forwarded agent holds a key -> push will work
        1) echo "nokey" ;;    # agent reachable but empty -> push fails despite good config
        *) echo "noagent" ;;  # no agent socket / dead forward
    esac
}

# ------------------------------------------------------------------------------
# Full Welcome Display
# ------------------------------------------------------------------------------
_show_welcome_full() {
    echo

    # --- OS Header ---
    if [[ "$IS_MAC" == "true" ]]; then
        echo "${info}🛡️  macOS Environment Overview:${done}"
        echo "    macOS: $(sw_vers -productVersion 2>/dev/null || echo 'Unknown') (${MAC_ARCH:-$(uname -m)})"
    elif [[ "$IS_WSL" == "true" ]]; then
        echo "${info}🛡️  WSL Environment Overview:${done}"
        local distro="Linux"
        command -v lsb_release &>/dev/null && distro=$(lsb_release -ds 2>/dev/null)
        echo "    Distro: ${distro} | Kernel: $(uname -r)"
    else
        echo "${info}🛡️  Linux Environment Overview:${done}"
        local distro="Linux"
        command -v lsb_release &>/dev/null && distro=$(lsb_release -ds 2>/dev/null)
        echo "    Distro: ${distro} | Kernel: $(uname -r)"
    fi

    # --- Shell Versions ---
    local bash_ver
    bash_ver=$(bash --version 2>/dev/null | awk 'NR==1{print $4}' | cut -d'(' -f1)
    echo "    Shell: zsh ${ZSH_VERSION} | bash ${bash_ver}"

    # --- Disk Space ---
    local disk_info=$(_get_disk_usage)
    local disk_pct="${disk_info%%:*}"
    local disk_free="${disk_info##*:}"

    if [[ "$disk_pct" -ge "$ZSH_WELCOME_DISK_WARN" ]]; then
        echo "    Disk: ${warn}${disk_pct}% used${done} (${disk_free} free) ⚠️"
    else
        echo "    Disk: ${disk_pct}% used (${disk_free} free)"
    fi

    # --- uv (Python) ---
    if command -v uv &>/dev/null; then
        local uv_version=$(uv --version 2>/dev/null | awk '{print $2}')
        local uv_python_path=""
        if command -v get_uv_python_path &>/dev/null; then
            uv_python_path=$(get_uv_python_path "${PYTHON_DEFAULT_VERSION}" 2>/dev/null)
        fi
        if [[ -n "$uv_python_path" && -x "$uv_python_path" ]]; then
            local uv_python_version=$("$uv_python_path" --version 2>/dev/null)
            echo "    uv: ${ok}${uv_version}${done} (Python ${PYTHON_DEFAULT_VERSION}: ${uv_python_version})"
        else
            echo "    uv: ${ok}${uv_version}${done} (Python ${PYTHON_DEFAULT_VERSION}: ${warn}not installed${done})"
        fi
    else
        echo "    uv: ${err}Not Found${done}"
    fi

    # --- Node.js ---
    if command -v nvm &>/dev/null; then
        local active_node=$(nvm current 2>/dev/null)
        if [[ "$active_node" == "none" || -z "$active_node" ]]; then
            local default_node=$(nvm version default 2>/dev/null)
            echo "    Node: ${warn}None active${done} (default: ${default_node:-N/A})"
        else
            # Flag end-of-life Node majors (below NODE_MIN_MAJOR — no security patches).
            local node_major=${active_node#v}; node_major=${node_major%%.*}
            if [[ "$node_major" =~ ^[0-9]+$ ]] && [[ -n "$NODE_MIN_MAJOR" ]] \
                 && (( node_major < NODE_MIN_MAJOR )); then
                echo "    Node: ${err}${active_node}${done} ${err}(EOL — below Node ${NODE_MIN_MAJOR}; run nvm install --lts)${done}"
            else
                echo "    Node: ${ok}${active_node}${done}"
            fi
        fi
    else
        echo "    Node: ${err}nvm not found${done}"
    fi

    # --- nvm (version floor; nvm <= 0.40.4 is vulnerable to CVE-2026-10796) ---
    if command -v nvm &>/dev/null; then
        local nvm_ver=$(nvm --version 2>/dev/null)
        if [[ -z "$nvm_ver" ]]; then
            echo "    nvm:  ${warn}unknown${done}"
        elif typeset -f _semver_cmp &>/dev/null && [[ -n "$NVM_MIN_VERSION" ]] \
               && [[ "$(_semver_cmp "$nvm_ver" "$NVM_MIN_VERSION")" == "-1" ]]; then
            echo "    nvm:  ${err}${nvm_ver}${done} ${err}↑${NVM_MIN_VERSION} (below min — CVE-2026-10796; run_onboarding)${done}"
        else
            echo "    nvm:  ${ok}${nvm_ver}${done}"
        fi
    fi

    # --- Homebrew-managed-runtime tripwire (exception-based; silent when clean) ---
    # brew node shadows the Node we manage via nvm and usually arrives as a transitive
    # dep of a brew-packaged npm CLI (how it crept in via markdownlint-cli + repomix).
    # Flag it so it never sits silently. python is intentionally NOT flagged (brew
    # python is a common legit dependency -> too noisy). Fast opt/ glob check; no slow
    # `brew` call in the banner.
    if [[ -d /opt/homebrew || -d /usr/local/Homebrew || -d /home/linuxbrew ]]; then
        local _hb="${HOMEBREW_PREFIX:-/opt/homebrew}"
        local -a _brew_node=( "$_hb"/opt/node(N) "$_hb"/opt/node@*(N) )
        if (( ${#_brew_node} )); then
            echo "    nvm:  ${warn}! Homebrew 'node' is also installed${done} — it can shadow nvm's Node on PATH."
            echo "          ${info}cause: brew uses --installed node · remove: brew uninstall <formula> && brew autoremove${done}"
        fi
    fi

    # --- pnpm ---
    if command -v pnpm &>/dev/null; then
        local pnpm_ver=$(pnpm -v 2>/dev/null || echo 'N/A')
        local pnpm_display="${ok}${pnpm_ver}${done}"
        # Soft staleness nudge -- helpers defined in .zsh_onboarding (loaded earlier).
        if [[ "$pnpm_ver" != "N/A" ]] && typeset -f _pnpm_get_latest &>/dev/null; then
            local pnpm_latest pnpm_raw pnpm_elig_bin
            pnpm_latest=$(_pnpm_get_latest 2>/dev/null)   # latest eligible (age-gated)
            pnpm_raw=$(_pnpm_get_raw_latest 2>/dev/null)  # registry dist-tag latest
            # Cached binary status of the eligible version (no network in the prompt).
            pnpm_elig_bin=$(typeset -f _pnpm_get_eligible_binary &>/dev/null && _pnpm_get_eligible_binary 2>/dev/null)
            if [[ -n "$pnpm_latest" \
                  && "$(_pnpm_vercmp "$pnpm_ver" "$pnpm_latest")" == "-1" ]]; then
                # Behind an installable version -- actionable nag.
                if [[ "$pnpm_elig_bin" == "missing" ]]; then
                    # Newest eligible version was published WITHOUT a native binary
                    # (upstream pnpm 11.12/11.13-class release bug). Do NOT nag to run
                    # pnpm_update -- it would (correctly) refuse. Inform instead.
                    pnpm_display="${ok}${pnpm_ver}${done} ${warn}(update to ${pnpm_latest} held: published without a binary -- upstream pnpm bug)${done}"
                elif [[ "$(_pnpm_vercmp "$pnpm_ver" "$PNPM_MIN_VERSION")" == "-1" ]]; then
                    pnpm_display="${err}${pnpm_ver}${done} ${err}↑${pnpm_latest} (below min ${PNPM_MIN_VERSION} -- run pnpm_update)${done}"
                else
                    pnpm_display="${warn}${pnpm_ver}${done} ${warn}↑${pnpm_latest} (run pnpm_update)${done}"
                fi
            elif [[ -n "$pnpm_raw" && "$pnpm_raw" != "$pnpm_ver" \
                    && "$(_pnpm_vercmp "$pnpm_ver" "$pnpm_raw")" == "-1" ]]; then
                # At the latest eligible, but a newer version is held by the age gate.
                pnpm_display="${ok}${pnpm_ver}${done} ${info}(latest eligible; ${pnpm_raw} pending release-age gate)${done}"
            fi
        fi
        # Supply-chain settings from ~/.config/pnpm/config.yaml (pnpm 11+ only).
        # Direct file read — faster than `pnpm config get` and shows what's
        # configured globally, ignoring per-project pnpm-workspace.yaml overrides.
        local pnpm_settings=""
        if [[ "$pnpm_ver" != "N/A" ]] && [[ "${pnpm_ver%%.*}" -ge 11 ]]; then
            # Look at the path pnpm actually reads. On macOS that's
            # ~/Library/Preferences/pnpm/; on Linux/WSL that's ~/.config/pnpm/.
            # Source: pnpm.mjs getConfigDir().
            local cfg
            if [[ "$IS_MAC" == "true" && -f "$HOME/Library/Preferences/pnpm/config.yaml" ]]; then
                cfg="$HOME/Library/Preferences/pnpm/config.yaml"
            else
                cfg="${XDG_CONFIG_HOME:-$HOME/.config}/pnpm/config.yaml"
            fi
            if [[ -f "$cfg" ]]; then
                local min_age block_exotic age_human=""
                # Match camelCase (required) or kebab-case (repo may have either).
                min_age=$(grep -E '^(minimum-release-age|minimumReleaseAge):' "$cfg" 2>/dev/null | awk '{print $2}' | head -1)
                block_exotic=$(grep -E '^(block-exotic-subdeps|blockExoticSubdeps):' "$cfg" 2>/dev/null | awk '{print $2}' | head -1)
                # Convert minutes to most-significant human unit.
                if [[ -n "$min_age" ]]; then
                    if   (( min_age == 0 ));    then age_human="off"
                    elif (( min_age < 60 ));    then age_human="${min_age}m"
                    elif (( min_age % 1440 == 0 )); then age_human="$((min_age / 1440))d"
                    elif (( min_age % 60 == 0 ));   then age_human="$((min_age / 60))h"
                    else age_human="${min_age}m"
                    fi
                fi
                local -a parts=()
                [[ -n "$age_human" ]]     && parts+=("minReleaseAge: ${age_human}")
                [[ -n "$block_exotic" ]] && parts+=("blockExoticSubdeps: ${block_exotic}")
                (( ${#parts[@]} > 0 )) && pnpm_settings=" ${info}(${(j:, :)parts})${done}"
            fi
        fi
        echo "    pnpm: ${pnpm_display}${pnpm_settings}"
    else
        echo "    pnpm: ${err}Not Found${done}"
    fi

    # --- bun (version floor for the ~/.bunfig.toml minimumReleaseAge cooldown) ---
    if command -v bun &>/dev/null; then
        local bun_ver=$(bun --version 2>/dev/null || echo 'N/A')
        if [[ "$bun_ver" != "N/A" ]] && typeset -f _semver_cmp &>/dev/null && [[ -n "$BUN_MIN_VERSION" ]] \
             && [[ "$(_semver_cmp "$bun_ver" "$BUN_MIN_VERSION")" == "-1" ]]; then
            echo "    bun:  ${err}${bun_ver}${done} ${err}↑${BUN_MIN_VERSION} (below min — .bunfig.toml cooldown ignored; run_onboarding)${done}"
        else
            echo "    bun:  ${ok}${bun_ver}${done}"
        fi
    else
        echo "    bun:  ${err}Not Found${done}"
    fi

    # --- herdr (release cooldown enforcement differs by install method) ---
    # macOS: herdr comes from Homebrew, so the 3-day cooldown is enforced by
    # the Homebrew PIN -- an unpinned herdr means a routine `brew upgrade` can
    # adopt a same-day release. Cheap to check: the pin is a symlink under
    # $HOMEBREW_PREFIX, so no `brew` subprocess is needed.
    # Linux/WSL: herdr comes from install.sh's own sha256-pinned GitHub-release
    # download (HERDR_VERSION in install.sh) -- there is no Homebrew formula
    # and no separate on/off pin to flip; being installed via that path IS the
    # pin. Checking the Homebrew marker there was always false, so every
    # WSL/Linux shell start printed a false "NOT pinned" warning even on a
    # correctly-pinned box (fixed 2026-08-19, confirmed live on mlbox-ubuntu).
    # Mirrors herdr-cooldown-check's install_method() split, which already
    # skips the Homebrew pin check entirely for direct installs.
    # Silent when herdr is absent (it is optional).
    if command -v herdr &>/dev/null; then
        local herdr_ver=$(herdr --version 2>/dev/null | awk '{print $NF}' || echo 'N/A')
        if [[ "$OSTYPE" == darwin* ]]; then
            if [[ -e "${HOMEBREW_PREFIX:-/opt/homebrew}/var/homebrew/pinned/herdr" ]]; then
                echo "    herdr: ${ok}${herdr_ver}${done} ${info}(pinned — cooldown enforced)${done}"
            else
                echo "    herdr: ${err}${herdr_ver} — NOT pinned; 'brew upgrade' would bypass the cooldown (run: brew pin herdr)${done}"
            fi
        else
            echo "    herdr: ${ok}${herdr_ver}${done} ${info}(direct install — pinned via install.sh checksum lock)${done}"
        fi
    fi

    # --- Deploy parity (EXCEPTION-ONLY: silent unless something is undeployed) ---
    # A tracked home/ file with no symlink in ~/ is invisible until the day you
    # reach for it -- which, for the guard scripts in home/.local/bin, is exactly
    # the day it matters. herdr-cooldown-check sat undeployed for three days in
    # 2026-07 and nothing said a word: the shell reports "command not found" for
    # a command nobody had typed yet, and the old drift probe only looked for
    # DANGLING links, never absent ones.
    #
    # Repo path is resolved from the ~/.zshrc symlink (:A follows it) rather than
    # hardcoded, so this works on the dev Mac and on consumer boxes alike.
    # Measured at ~5ms -- the same order as the `herdr --version` call above --
    # so no cache is warranted; a cached answer could also go stale across the
    # very `install.sh` run that fixes it.
    #
    # SILENT WHEN CLEAN, by design. A line that prints "all good" every single
    # session is a line that stops being read.
    local _dotrc="${HOME}/.zshrc" _dotrepo
    if [[ -L "$_dotrc" ]]; then
        _dotrepo="${${_dotrc:A}:h:h}"
        if [[ -d "$_dotrepo/.git" ]]; then
            local _undeployed
            _undeployed=$(git -C "$_dotrepo" ls-files home 2>/dev/null | sed 's#^home/##' | while read rel; do
                case "$rel" in
                    .gitignore|*/.gitignore|.gitmodules|*/.gitmodules) continue ;;
                    .DS_Store|*/.DS_Store|.stow-local-ignore|*/.stow-local-ignore) continue ;;
                    */__pycache__/*|*.pyc) continue ;;
                esac
                [[ -e "$HOME/$rel" || -L "$HOME/$rel" ]] || echo "$rel"
            done)
            if [[ -n "$_undeployed" ]]; then
                local _n=$(echo "$_undeployed" | wc -l | tr -d ' ')
                echo "    deploy: ${err}${_n} tracked file(s) NOT linked into ~/ — run ./install.sh --stow-only${done}"
                echo "$_undeployed" | head -3 | sed "s|^|      ${err}✗${done} ~/|"
                (( _n > 3 )) && echo "      ${info}...and $(( _n - 3 )) more (./install.sh --check lists all)${done}"
            fi
        fi
    fi

    # --- Installed-package CVEs (EXCEPTION-ONLY: silent unless something is wrong) ---
    # `vuln-scan --fast` is built for exactly this spot. The ordinary case -- nothing
    # installed or upgraded since last login -- is one `brew list` and one SQLite
    # read with NO network, so it costs a few hundred milliseconds and prints
    # nothing. When packages HAVE changed it checks up to a dozen inline (a few
    # seconds, and it says so first, because an unexplained pause in a login shell
    # reads as a hang). A bigger backlog is detached to the background rather than
    # blocking the prompt, which is what makes a cold database survivable: the very
    # first run has 231 packages and would otherwise freeze the terminal for a
    # quarter of an hour.
    #
    # SILENT WHEN CLEAN, like the deploy-parity check above. It speaks only for an
    # ACTIONABLE finding (CVSS >= 7.0 or unrated) -- gated on vuln-scan's OWN exit
    # code (1 == actionable, 0 otherwise), not a text search.
    #
    # A grep for the word "EXPOSED" used to gate this instead, and was wrong two
    # ways (confirmed live 2026-08-19): that word is ALSO the label of the
    # sub-threshold "EXPOSED, BELOW ACTION THRESHOLD" bucket, which vuln-scan
    # deliberately keeps OUT of its own alarm. So the grep (a) matched that
    # sub-threshold bucket while a genuine ACTION NEEDED finding sat elsewhere in
    # the same output and never made it past `head -8` -- python@3.14 CVSS 8.7
    # simply never appeared here -- and (b) would have shown NOTHING for an
    # actionable-only result with no below-threshold items: a silent false
    # all-clear, the one failure this whole tool exists to prevent.
    #
    # Reads --json + jq instead of scraping the pretty-printed table: structured
    # data means no regex guessing at column widths, and every actionable package
    # is listed (never "+N more" -- ACTION NEEDED is rare by definition, CVSS >=
    # 7.0 only, so there is no real volume to hide). Only the worst/first CVE per
    # PACKAGE is shown when a single package carries several; that narrower
    # truncation is deliberately kept, matching vuln-scan's own cap elsewhere.
    # The "how do I get more" pointer lives in Quick Reference now, not repeated
    # here every time.
    if command -v vuln-scan >/dev/null 2>&1; then
        local _vjson _vstatus
        _vjson=$(NO_COLOR=1 vuln-scan --fast --no-progress --json 2>/dev/null)
        _vstatus=$?
        if [[ -n "$_vjson" ]]; then
            if (( _vstatus == 1 )); then
                if command -v jq >/dev/null 2>&1; then
                    local _rows _i=0 _score _name _cve
                    _rows=$(printf '%s' "$_vjson" | jq -r '
                        .actionable
                        | sort_by(-(.score // 999))
                        | .[]
                        | [ (if .score then (((.score * 10 | round) / 10) | tostring) else "?" end),
                            .name,
                            ((.cves[0] // "?")
                             + (if (.cves | length) > 1 then ", +\((.cves | length) - 1) more" else "" end)) ]
                        | @tsv')
                    while IFS=$'\t' read -r _score _name _cve; do
                        if (( _i == 0 )); then
                            printf "    ${err}cve:${done} %-4s  %-16s  %s\n" "$_score" "$_name" "$_cve"
                        else
                            printf "%9s%-4s  %-16s  %s\n" "" "$_score" "$_name" "$_cve"
                        fi
                        (( _i++ ))
                    done <<< "$_rows"
                else
                    # No jq -- a real actionable finding must never go silent just
                    # because the detail formatting can't run.
                    echo "    cve: ${err}package(s) need action -- run \`vuln-scan\` (jq missing, can't list detail here)${done}"
                fi
            else
                local _deferred
                _deferred=$(printf '%s' "$_vjson" | jq -r '.stats.deferred // 0' 2>/dev/null)
                if [[ -n "$_deferred" && "$_deferred" != "0" && "$_deferred" != "null" ]]; then
                    local _spawned
                    _spawned=$(printf '%s' "$_vjson" | jq -r '.stats.spawned // false' 2>/dev/null)
                    if [[ "$_spawned" == "true" ]]; then
                        echo "    cve: ${_deferred} package(s) need checking -- running in the background"
                    else
                        echo "    cve: ${_deferred} package(s) pending; a scan is already running"
                    fi
                fi
            fi
        fi
    fi

    # --- GitHub API token (read-only) ---
    # The status cache is written in the BACKGROUND by _claude_launch during
    # Claude sessions (the only place $GH_TOKEN exists). The banner only reads
    # it here - fast, and no token access in plain shells.
    local gh_cache="${XDG_CACHE_HOME:-$HOME/.cache}/dotfiles/gh_api_status"
    if [[ -f "$gh_cache" ]]; then
        local _gst=$(grep '^status=' "$gh_cache" 2>/dev/null | cut -d= -f2)
        local _gexp=$(grep '^expires=' "$gh_cache" 2>/dev/null | cut -d= -f2-)
        local _gdate="${_gexp%% *}" _gdisp
        if [[ "$_gst" == "alive" ]]; then
            local _gdays=""
            if [[ -n "$_gdate" ]]; then
                local _ge=$(date -j -f "%Y-%m-%d" "$_gdate" +%s 2>/dev/null || echo 0)
                (( _ge > 0 )) && _gdays=$(( (_ge - $(date +%s)) / 86400 ))
            fi
            if [[ -n "$_gdays" ]] && (( _gdays < 0 )); then
                _gdisp="${err}expired ${_gdate}${done}"
            elif [[ -n "$_gdays" ]] && (( _gdays <= 30 )); then
                _gdisp="${warn}read-only OK (exp ${_gdate}, ${_gdays}d left)${done}"
            elif [[ -n "$_gdate" ]]; then
                _gdisp="${ok}read-only OK${done} ${info}(exp ${_gdate})${done}"
            else
                _gdisp="${ok}read-only OK${done}"
            fi
        elif [[ "$_gst" == "dead" ]]; then
            _gdisp="${err}token rejected - rotate it${done}"
        else
            _gdisp="${warn}status unknown${done}"
        fi
        echo "    GH API: ${_gdisp}"
    else
        echo "    GH API: ${info}pending (launch Claude once)${done}"
    fi

    # --- Docker ---
    if command -v docker &>/dev/null; then
        local docker_running=false
        docker ps &>/dev/null 2>&1 && docker_running=true

        local engine_ver
        if [[ "$docker_running" == true ]]; then
            engine_ver=$(docker version --format '{{.Server.Version}}' 2>/dev/null || echo 'N/A')
            echo "    Docker Engine: ${ok}${engine_ver} (Running)${done}"
        else
            engine_ver=$(docker version --format '{{.Client.Version}}' 2>/dev/null)
            if [[ -z "$engine_ver" ]]; then
                engine_ver=$(docker --version 2>/dev/null | awk '{print $3}' | tr -d ',')
            fi
            : ${engine_ver:=N/A}
            if [[ "$IS_MAC" == "true" ]]; then
                echo "    Docker Engine: ${warn}${engine_ver} (Not Running)${done}"
            else
                echo "    Docker Engine: ${warn}${engine_ver} (Not Running)${done} (try: sudo usermod -aG docker \$USER)"
            fi
        fi

        if [[ "$IS_MAC" == "true" && -d "/Applications/Docker.app" ]]; then
            local desktop_ver
            desktop_ver=$(defaults read /Applications/Docker.app/Contents/Info.plist CFBundleShortVersionString 2>/dev/null || echo 'N/A')
            echo "    Docker Desktop: ${ok}${desktop_ver}${done}"
        fi
    else
        echo "    Docker Engine: ${err}Not Installed${done}"
    fi

    # --- Package manager ---
    if [[ "$IS_MAC" == "true" ]]; then
        if command -v brew &>/dev/null; then
            echo "    Homebrew: ${ok}OK${done}"
        else
            echo "    Homebrew: ${err}Not Found${done}"
        fi
    elif [[ "$IS_WSL" == "true" || "$IS_LINUX" == "true" ]]; then
        if   command -v apt    &>/dev/null; then echo "    Package mgr: ${ok}apt${done}"
        elif command -v dnf    &>/dev/null; then echo "    Package mgr: ${ok}dnf${done}"
        elif command -v pacman &>/dev/null; then echo "    Package mgr: ${ok}pacman${done}"
        elif command -v zypper &>/dev/null; then echo "    Package mgr: ${ok}zypper${done}"
        else echo "    Package mgr: ${warn}none detected${done}"
        fi
    fi

    # --- GPU (WSL/Linux only) ---
    if [[ "$IS_WSL" == "true" || "$IS_LINUX" == "true" ]]; then
        local gpu_status=$(_check_gpu)
        if [[ "$gpu_status" == "available" ]]; then
            echo "    GPU: ${ok}NVIDIA Available${done}"
        else
            echo "    GPU: ${warn}Not Detected${done}"
        fi
    fi

    # --- GitHub agent-forwarding health (consumer boxes only) ---
    # The Mac uses git-cc: URL rewrites with a local key, so bare github.com
    # resolution does not apply there; only consumer boxes push to bare
    # git@github.com over a forwarded key and need `identitiesonly no`.
    if [[ "$IS_MAC" != "true" ]]; then
        case "$(_check_github_forward_drift)" in
            ok)
                echo "    SSH github: ${ok}OK${done} ${info}(forwarded key present, identitiesonly no)${done}" ;;
            broken)
                echo "    SSH github: ${err}BROKEN${done} ${warn}(identitiesonly=yes; forwarded pushes fail)${done}"
                echo "    ${warn}  -> fix: restore 'Host github.com git-cc' in ~/.ssh/config.local${done}" ;;
            nokey)
                echo "    SSH github: ${err}NO KEY${done} ${warn}(config OK but forwarded agent is empty; pushes fail)${done}"
                echo "    ${warn}  -> on the Mac: ssh-add ~/.ssh/captaincodeau, then reconnect${done}" ;;
            noagent)
                echo "    SSH github: ${warn}no agent forwarded${done} ${info}(ForwardAgent inactive this session)${done}" ;;
        esac
    fi
}

# ------------------------------------------------------------------------------
# Minimal Welcome Display (Single Line)
# ------------------------------------------------------------------------------
_show_welcome_minimal() {
    local parts=()

    # OS
    if [[ "$IS_MAC" == "true" ]]; then
        parts+=("macOS ${MAC_ARCH:-$(uname -m)}")
    elif [[ "$IS_WSL" == "true" ]]; then
        parts+=("WSL")
    else
        parts+=("Linux")
    fi

    # Disk
    local disk_info=$(_get_disk_usage)
    local disk_pct="${disk_info%%:*}"
    if [[ "$disk_pct" -ge "$ZSH_WELCOME_DISK_WARN" ]]; then
        parts+=("${warn}Disk ${disk_pct}%${done}")
    else
        parts+=("Disk ${disk_pct}%")
    fi

    # uv
    if command -v uv &>/dev/null; then
        parts+=("${ok}uv ✓${done}")
    else
        parts+=("${err}uv ✗${done}")
    fi

    # Node
    if command -v nvm &>/dev/null; then
        local node_ver=$(nvm current 2>/dev/null)
        if [[ -n "$node_ver" && "$node_ver" != "none" ]]; then
            parts+=("${ok}Node ${node_ver%%.*}${done}")
        else
            parts+=("${warn}Node -${done}")
        fi
    else
        parts+=("${err}Node ✗${done}")
    fi

    # Docker
    if command -v docker &>/dev/null && docker ps &>/dev/null 2>&1; then
        parts+=("${ok}Docker ✓${done}")
    else
        parts+=("${warn}Docker -${done}")
    fi

    # Homebrew (Mac only)
    if [[ "$IS_MAC" == "true" ]]; then
        if command -v brew &>/dev/null; then
            parts+=("${ok}Brew ✓${done}")
        fi
    fi

    # GPU (WSL/Linux only)
    if [[ "$IS_WSL" == "true" || "$IS_LINUX" == "true" ]]; then
        if [[ "$(_check_gpu)" == "available" ]]; then
            parts+=("${ok}GPU ✓${done}")
        fi
    fi

    # GitHub forwarding health (consumer boxes; surface any non-OK state)
    if [[ "$IS_MAC" != "true" ]]; then
        case "$(_check_github_forward_drift)" in
            broken|nokey|noagent) parts+=("${err}github SSH ✗${done}") ;;
        esac
    fi

    echo "🛡️  ${(j: | :)parts}"
}

# ------------------------------------------------------------------------------
# Quick Reference — Full
# ------------------------------------------------------------------------------
_show_quickref_full() {
    echo
    echo "${info}🚀  Quick Reference:${done}"
    echo "    Python:  python_new_project, python_setup, python_delete"
    echo "    uv CLI:  uv_tool_install_current_project, uv_tool_check_current_project"
    echo "    Node:    node_new_project, node_setup, node_clean"
    echo "    Git/Docker: lg, lzd | Docker: docker_help | Tmux: tdev, gs, gstatus"
    echo "    Media:   yt --help"
    echo "    Security: vuln-scan (cve detail) | briefing: ~/.local/state/dotfiles/vuln-briefing.md"
}

# ------------------------------------------------------------------------------
# Quick Reference — Minimal (Compact 2 Lines)
# ------------------------------------------------------------------------------
_show_quickref_minimal() {
    echo
    echo "${info}💡 Python: python_new_project | Node: node_new_project | Docker: docker_help${done}"
    echo "   Tmux: tdev, gs | Git/Docker: lg, lzd | Media: yt --help"
}

# ------------------------------------------------------------------------------
# Main Execution
# ------------------------------------------------------------------------------

# Show welcome based on verbosity
case "$_WELCOME_VERBOSITY" in
    full)
        _show_welcome_full
        ;;
    minimal)
        _show_welcome_minimal
        ;;
    none|"")
        # No welcome output
        ;;
esac

# Show quick reference based on its own verbosity setting
# (Only show if welcome is not 'none' — if user wants no welcome, probably wants no quickref either)
if [[ "$_WELCOME_VERBOSITY" != "none" ]]; then
    case "$ZSH_WELCOME_QUICKREF" in
        full)
            _show_quickref_full
            ;;
        minimal)
            _show_quickref_minimal
            ;;
        none|"")
            # No quick reference output
            ;;
    esac
fi

# Add blank line for spacing (only if we showed something)
if [[ "$_WELCOME_VERBOSITY" != "none" ]]; then
    echo
fi

# ------------------------------------------------------------------------------
# uv Python Install Prompt
# ------------------------------------------------------------------------------
# Only prompt if:
# 1. Welcome verbosity is 'full' (not in SSH/tmux quick mode)
# 2. Shell is interactive
# 3. Python version is actually missing
if [[ "$_WELCOME_VERBOSITY" == "full" ]]; then
    if command -v get_uv_python_path &>/dev/null && ! get_uv_python_path "${PYTHON_DEFAULT_VERSION}" &>/dev/null; then
        echo "${warn}⚠️  Default Python (${PYTHON_DEFAULT_VERSION}) not found in 'uv' cache.${done}"
        if [[ -t 1 ]]; then
            read "REPLY?    👉 Would you like to run 'uv python install python@${PYTHON_DEFAULT_VERSION}' now? [y/N] "
            case "$REPLY" in
                [yY][eE][sS]|[yY])
                    uv python install "python@${PYTHON_DEFAULT_VERSION}"
                    ;;
                *)
                    echo "${warn}    Skipping 'uv' Python installation.${done}"
                    ;;
            esac
        fi
    fi
fi

# Cleanup internal variables
unset _WELCOME_VERBOSITY
