#!/usr/bin/env bash
# zed-version-check-selftest -- controls for the watched-ISSUES section of the Zed
# SessionStart hook (zed-version-check.sh).
#
# WHY THIS EXISTS
# ---------------
# The issue watch (added 2026-09-23 for zed#13300) has one job: stay quiet while the
# issue is unchanged, and speak up when it moves or closes. A watcher that is quiet in
# both worlds looks exactly like one that works, so every arm below asserts the WORDS
# the hook prints, and the "changed" arm must print something the "open" arm does not.
#
# FIXTURES ARE REAL. tests/fixtures/zed/issue-<n>.json are saved GitHub API responses
# (`curl https://api.github.com/repos/zed-industries/zed/issues/<n>`), captured
# 2026-09-23: #13300 open, #40418 closed. The "changed" arm reuses the real open
# fixture and varies the RECORDED date instead, so no fixture is hand-typed.
#
# HERMETIC. TMPDIR points at a scratch dir holding a fresh release cache, so the
# version check never reaches the network, and ZED_CHECK_FIXTURE_DIR makes the issue
# lookup read fixtures only. Every arm runs under each bash found: macOS /bin/bash 3.2
# and the PATH bash (5.x here), because an empty array under `set -u` kills 3.2 only.
#
# USAGE
#   zed-version-check-selftest        run everything, print a summary, exit 0 only if all pass
#   zed-version-check-selftest -v     also print each case's full output
#   ZED_CHECK_HOOK=<path> zed-version-check-selftest   test another copy (mutation check)

# Read this whole file before running any of it, so an edit saved mid-run cannot change
# the run (W-20260923-A57). A crash under it exits 127 (unbound var) or 1 (bash 3.2 syntax
# error); `selftest-whole-read --help` has the map. Do not move or reword these lines.
[ -n "${SELFTEST_WHOLE_READ-}" ] || SELFTEST_WHOLE_READ=1 exec "$BASH" -c 'shopt -u sourcepath; . "$0"' "$0" "$@"
unset SELFTEST_WHOLE_READ

set -uo pipefail

VERBOSE=0
[ "${1:-}" = "-v" ] && VERBOSE=1

here=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
HOOK="${ZED_CHECK_HOOK:-$here/zed-version-check.sh}"
FIX="$here/tests/fixtures/zed"
REPO=$(CDPATH= cd -- "$here/../.." && pwd)
[ -f "$HOOK" ] || { echo "zed-version-check-selftest: hook not found: $HOOK" >&2; exit 1; }
[ -f "$FIX/issue-13300.json" ] && [ -f "$FIX/issue-40418.json" ] \
  || { echo "zed-version-check-selftest: fixtures missing under $FIX" >&2; exit 1; }
command -v jq >/dev/null 2>&1 || { echo "zed-version-check-selftest: jq is required" >&2; exit 1; }

BASHES=()
[ -x /bin/bash ] && BASHES+=("/bin/bash")
pb=$(command -v bash 2>/dev/null || true)
[ -n "$pb" ] && [ "$pb" != "/bin/bash" ] && BASHES+=("$pb")

PASS=0
FAILED=()
WORK=$(mktemp -d "${TMPDIR:-/tmp}/zvc-selftest.XXXXXX") || exit 1

# run_case <bash> <watched-issues or __DEFAULT__> -> sets OUT, RC
run_case() {
  local b="$1" list="$2" t
  t=$(mktemp -d "$WORK/case.XXXXXX")
  printf '1.21.0\n' >"$t/zed-preview-latest.cache"
  if [ "$list" = "__DEFAULT__" ]; then
    OUT=$(env -u ZED_CHECK_WATCHED_ISSUES TMPDIR="$t" CLAUDE_PROJECT_DIR="$REPO" \
      ZED_CHECK_FIXTURE_DIR="$FIX" "$b" "$HOOK" 2>&1); RC=$?
  else
    OUT=$(TMPDIR="$t" CLAUDE_PROJECT_DIR="$REPO" ZED_CHECK_FIXTURE_DIR="$FIX" \
      ZED_CHECK_WATCHED_ISSUES="$list" "$b" "$HOOK" 2>&1); RC=$?
  fi
}

# check <name> <must-contain> <must-not-contain or ""> -- asserts on the last run
check() {
  local name="$1" want="$2" deny="$3" ok=1
  [ "$RC" -eq 0 ] || ok=0
  printf '%s' "$OUT" | grep -qF -- "$want" || ok=0
  if [ -n "$deny" ] && printf '%s' "$OUT" | grep -qF -- "$deny"; then ok=0; fi
  if [ "$ok" -eq 1 ]; then
    PASS=$((PASS + 1)); echo "  ok    $name"
  else
    FAILED+=("$name"); echo "  FAIL  $name (rc=$RC; wanted \"$want\"${deny:+, forbade \"$deny\"})"
  fi
  [ "$VERBOSE" -eq 1 ] && printf '%s\n\n' "$OUT"
  return 0
}

for B in "${BASHES[@]}"; do
  v=$("$B" -c 'echo $BASH_VERSION')
  echo "bash $v ($B)"

  run_case "$B" "13300|2026-06-08|fixture label"
  check "[$v] open arm: unchanged issue is quiet" \
    "⏳ zed#13300 open, last activity 2026-06-08 (unchanged since recorded)" "UPDATED"

  run_case "$B" "13300|2026-05-01|fixture label"
  check "[$v] changed arm: moved updated date flags" \
    "🔔 zed#13300 UPDATED: last activity 2026-06-08, recorded 2026-05-01" "unchanged since recorded"
  check "[$v] changed arm: tells the assistant the new date" \
    "set #13300's recorded date in" ""

  run_case "$B" "40418|2025-12-18|fixture label"
  check "[$v] closed arm: closed issue flags" "✖ zed#40418 CLOSED (no reason given" "unchanged since recorded"

  run_case "$B" "99999999|2026-01-01|fixture label"
  check "[$v] missing fixture reports unavailable, not open" "zed#99999999 status unavailable (offline)" "open, last activity"

  run_case "$B" ""
  check "[$v] empty list survives set -u and says so" "(none watched -- add \"<number>|<YYYY-MM-DD>|<label>\"" ""

  run_case "$B" "__DEFAULT__"
  check "[$v] committed WATCHED_ISSUES baseline matches the real #13300 fixture" \
    "⏳ zed#13300 open, last activity 2026-06-08 (unchanged since recorded)" "UPDATED"
done

# Leave the scratch dir for inspection only on failure; it lives under $TMPDIR.
echo
if [ "${#FAILED[@]}" -eq 0 ]; then
  echo "zed-version-check-selftest: $PASS passed, 0 failed, ${#BASHES[@]} bash(es)"
  exit 0
fi
echo "zed-version-check-selftest: $PASS passed, ${#FAILED[@]} FAILED (work dir: $WORK)"
exit 1
