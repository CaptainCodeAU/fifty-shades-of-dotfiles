# .envrc for direnv integration
# This file triggers the direnvrc hooks

# Essential venv activation (must be included)
# Only set VIRTUAL_ENV_PROMPT and activate if venv actually exists
if [[ -d ".venv" ]]; then
    export VIRTUAL_ENV_PROMPT="($(basename "$PWD"))"
    source .venv/bin/activate
elif [[ -d "venv" ]]; then
    export VIRTUAL_ENV_PROMPT="($(basename "$PWD"))"
    source venv/bin/activate
fi

# Clear the "direnv: loading..." line
printf "\033[A\033[2K"

echo ""
echo "┌───────────────────────────────────────────────────────────────────────┐"
echo -e "│                   \033[35m🐚 fifty-shades-of-dotfiles\033[0m                         │"
echo "└───────────────────────────────────────────────────────────────────────┘"
echo "│"
echo "│  📦 Install / Update:"
echo "│  ────────────────────"
echo -e "│     \033[3;33m./install.sh\033[0m             # Interactive install (stow dotfiles)"
echo -e "│     \033[3;33m./install.sh --check\033[0m     # Check prerequisites only"
echo -e "│     \033[3;33m./install.sh --update\033[0m    # Pull latest + restow"
echo -e "│     \033[3;33m./install.sh --dry-run\033[0m   # Preview, change nothing"
echo -e "│     \033[3;33m./install.sh --uninstall\033[0m # Remove all symlinks"
echo "│"
echo "│  🔒 Security / Currency:"
echo "│  ───────────────────────"
echo -e "│     \033[3;33mtoolchain-cve-check\033[0m      # pnpm+nvm floors vs live CVEs"
echo -e "│     \033[3;33mpnpm-audit-tree\033[0m          # Recursive supply-chain audit"
echo -e "│     \033[3;33mnvm-verify-node\033[0m          # Verify Node download signatures"
echo -e "│     \033[3;33mci-watch\033[0m                 # CI dashboard (sticky until green)"
echo "│"
echo "│  🧰 Repo Scripts:"
echo "│  ────────────────"
echo -e "│     \033[3;33mgit-leak-scan\033[0m            # Pre-commit identity/secret gate"
echo -e "│     \033[3;33mmd-hardbreak\033[0m             # Zed markdown hard-breaks / gaps"
echo -e "│     \033[3;33msysinfo\033[0m · \033[3;33mdirdiff\033[0m · \033[3;33mwatch-history-sync\033[0m"
echo "│"
echo "│  ℹ️  Info:"
echo "│  ────────"
echo -e "│     Repo:   \033[36m$(basename "$PWD")\033[0m"
echo -e "│     Branch: \033[36m$(git branch --show-current 2>/dev/null || echo '-')\033[0m"
echo "│"
echo "└───────────────────────────────────────────────────────────────────────┘"
echo ""
echo "│  ℹ️  Environment Info:"
echo "│  ─────────────────────"
echo -e "│     Machine: \033[36m$(hostname)\033[0m"
echo -e "│     Kernel:  \033[36m$(uname -r)\033[0m"
echo -e "│     Shell:   \033[36m$SHELL\033[0m"
echo "│"
echo "│  📁 VSCode Settings Check:"
echo "│  ─────────────────────────"
if [[ "$(uname -s)" == "Darwin" ]]; then
    # macOS - check local app settings
    if grep -q "titleBar.activeBackground" "$HOME/Library/Application Support/Code/User/settings.json" 2>/dev/null; then
        echo -e "│     VSCode:  \033[32m✓ Configured\033[0m"
    else
        echo -e "│     VSCode:  \033[33m✗ Not configured\033[0m"
    fi
    if grep -q "titleBar.activeBackground" "$HOME/Library/Application Support/Cursor/User/settings.json" 2>/dev/null; then
        echo -e "│     Cursor:  \033[32m✓ Configured\033[0m"
    else
        echo -e "│     Cursor:  \033[33m✗ Not configured\033[0m"
    fi
else
    # Linux/WSL - check remote server settings
    if [[ -f "$HOME/.vscode-server/data/Machine/settings.json" ]]; then
        echo -e "│     VSCode:  \033[32m✓ Found\033[0m"
    else
        echo -e "│     VSCode:  \033[33m✗ Not found\033[0m"
    fi
    if [[ -f "$HOME/.cursor-server/data/Machine/settings.json" ]]; then
        echo -e "│     Cursor:  \033[32m✓ Found\033[0m"
    else
        echo -e "│     Cursor:  \033[33m✗ Not found\033[0m"
    fi
fi
echo "│"
echo "└───────────────────────────────────────────────────────────────────────┘"
echo ""
